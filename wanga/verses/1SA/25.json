    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi na Abigaili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli nafwa; abaIsiraeli bosi nabo nibakhung'aana, nibamwikhuula, nibamuyabila munzuye eRama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi yarula, nakholomokha natsia mushitsiimi shiaParani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho omundu undi eMaoni, owa emianduchie chiali eKarameli; omundu oyo yali omukhongo muno, khandi yali nende amakondi ebikhumila bitaru, nende tsimbusi eshikhumila shilala; ne yali natetanga amakondike obwoya eKarameli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.2",
            "verseOrgIds": [
              "1SA.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eliira liomundu oyo liali Nabali, neliira liomukhasiwe mbu Abigaili; nomukhasi oyo yali owobuchesi obulayi, khandi oweshiiso; ne omusaatsawe yali omuraasi, khandi omubii mukosi aka yakholanga; yali oweshilibwa shiaKalebu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.3",
            "verseOrgIds": [
              "1SA.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yahulila olwa yali mushitsiimi mbu Nabali atetanga amakondike obwoya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.4",
            "verseOrgIds": [
              "1SA.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi naruma abasooliili ekhumi, Daudi nababiila abasoliili abo ari Mutikulushe mutsie eKarameli, mutsie ewaNabali, mumushiesilie; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.5",
            "verseOrgIds": [
              "1SA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mumusunjile muri Omulembe kube khwiwe, khandi omulembe khunzuyo, khandi omulembe khubiosi ebia oli ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.6",
            "verseOrgIds": [
              "1SA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano embuliile shinga olwa oli nende abandu abatetanga amakondi obwoya; abaayibo khwabeelenje ninabo, nikhurabakholela libii liosi, kata eshindu shiosi shishiabakorakhwo, tsindaalo tsiosi etsia bali eKarameli tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.7",
            "verseOrgIds": [
              "1SA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeba abasooliilibo, nabo bakhuboolele; khulwako chama abasooliili banje banyoole obukoosia mumonitsio; okhuba khwitsile khunyanga yelisabo; kho chama, ekhusaaya, oheelesie abasumbabo shiosi shiosi eshili mumukhonokwo, khandi khumwanawo Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.8",
            "verseOrgIds": [
              "1SA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abasooliili baDaudi boolayo, bamusunjila Nabali amakhuwa ako kosi khuliira liaDaudi, mana nibaholeela. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.9",
            "verseOrgIds": [
              "1SA.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nabali nakalusia abasumba baDaudi, nasunga mbu Daudi uno niwina? Kata omwana waYese niye wina? Mundaalo tsino baliho abasumba abanji abeelukhanga buli mundu okhurula khumwamiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.10",
            "verseOrgIds": [
              "1SA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho embukule omukaate kwanje, nende amatsi kanje, nende inyama eya enziriile abo abandeelanga amakondi kanje obwoya, nimbaheelesia abandu aba endamanyile ewa barulile ta? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.11",
            "verseOrgIds": [
              "1SA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abasooliili baDaudi bashiukhana nibakalukha, niboolayo, nibamuboolela amakhuwa ako kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.12",
            "verseOrgIds": [
              "1SA.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nasunjila abandube ari Mwibohe buli mundu olukangalwe; nibeeboha buli mundu olukangalwe; Daudi yesi niyeeboha olukangalwe; abandu shinga ebikhumi bine nibatikulukha nibalonda munyuma waDaudi; nabandi ebikhumi bibili nibeekhala nemiandu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulala khubasooliili balia yamuboolela Abigaili, omukhasi waNabali, ari Lola, Daudi yarumile abarume okhurula mushitsiimi yaho okhushiesia omwami weefwe; naye nabayiibila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.14",
            "verseOrgIds": [
              "1SA.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu abo bakhukholela bulayi muno, kata shikhwanyoola libii liosi, kata eshindu shieefwe shiosi okhukhukorakhwo tawe, olwa khwalinji nikhulondokhana ninabo, nikhuli mubulimo; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.15",
            "verseOrgIds": [
              "1SA.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "balinji shinga olukoba khwifwe mushilo khandi mushiteere, eshise shiosi eshia khwali halala ninabo nikhwayanga amakondi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.16",
            "verseOrgIds": [
              "1SA.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano omanye kano, noyililisia eshia witsa okhukhola; okhuba amabii karecheekhwe khumwami weefwe, khandi khunzuye yosi; okhuba nomundu omumayaanu oweshifwabwi, owa omundu aranyala okhusungana ninaye ta.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Abigaili yaanguyilisia nabukula emikaate ebikhumi bibili, nende tsisiongo tsibili tsieidivai, nende amakondi karaano akali nikakasiibwe pe, nende emichelo chiraano chieimele inziyile, nende ebisakanya eshikhumi bietsinzabibu tsinyumu, nende amabumbi kamakhuyu ebikhumi bibili, nabituukha khutsisishili. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.18",
            "verseOrgIds": [
              "1SA.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunjila abakholibe ari Nyimilile mutsie; ne lole, ndalamulonda. Ne shiyamuboolelakhwo omusaatsawe Nabali ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.19",
            "verseOrgIds": [
              "1SA.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali naniinile khusishiliye, nakholomokha mumbaka weshikulu, Daudi nende abandube nibeetsa nibachoomana ninaye; naye omukhasi nababukaanila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.20",
            "verseOrgIds": [
              "1SA.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yali nasunjile mbu Toto mwene, kabeelenje akabutswa olwa enindilenje biosi ebia omundu oyo ali ninabio mushitsiimi, mbu eshindu shiosi nishirakora ta khubiosi ebili ebibie; naye yarunjile obubii khubulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.21",
            "verseOrgIds": [
              "1SA.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye yakholele Daudi ario, nende okhushilaho, nimba nindekha khubali abebe omundu weshisaatsa kata mulala olwa nabushie mukamba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.22",
            "verseOrgIds": [
              "1SA.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.22",
            "verseOrgIds": [
              "1SA.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Abigaili yalola Dzudi, yatetekhana niyeekha okhurula khusishiliye, nasikama nabunamia obwenibwe imbeli waDaudi, niyeenama hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.23",
            "verseOrgIds": [
              "1SA.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasikama hamakuluke, nasunga mbu Khwisie, omwami, obumayaanu buno bube khwisie; ne chama isie omukholiwo esunjekhwo nohulila, nawe orechelesie amakhuwa komukholiwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.24",
            "verseOrgIds": [
              "1SA.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya, omwami wanje, mbu oleshe okhupaarakhwo khumundu oyo emumayaanu oweshifwabwi, mbu Nabali, shichila shinga eliiralie olwa lili, nindio afwana ario; Nabali nilio eliiralie, khandi obuyingwa ali ninabwo; nebutswa isie omukholiwo shindaluutsi abasooliili bomwami wanje, aba warumile, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.25",
            "verseOrgIds": [
              "1SA.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, omwami, shinga OMWAMI olwa abeetsangaho mwoyo, khandi iwe shinga olwa oli mwoyo, olwa OMWAMI akhwikaliile khushiuku shiamabanga, khandi khukhwimalila omwene eshikwoli, kho bulaano abasukubo, nende abo abeenyela omwami wanje Daudi amabii, babe shinga Nabali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.26",
            "verseOrgIds": [
              "1SA.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, eshihaanwa shino eshia omukholiwo akhuleereele, omwami wanje, shiheelwe abasooliili abalondanga khumwami wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.27",
            "verseOrgIds": [
              "1SA.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya mbu oleshele obuyiiri bwomukholiwo; okhuba OMWAMI shialachweya okhumukholela omwami wanje Daudi inzu iralilu, shichila omwami wanje alasanilanga OMWAMI amaheke; nobubii shibulanyoolekhakhwo mwiwe tsindaalotsio tsiosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.28",
            "verseOrgIds": [
              "1SA.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata olwa omundu yakhaba narulile okhukhulonda, nokhuyima obulamubwo, khane obulamu bwomwami wanje bulabeetsanga nibuboyilwe mwiboho liabali mwoyo, mubulindi bwOMWAMI Nyasayewo; ne obulamu bwabasukubo, bwo bwosi alabukhuyunga nabulasa, shinga okhurula mushikalo shieimburusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.29",
            "verseOrgIds": [
              "1SA.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa OMWAMI alaba nakholeele amalayi kosi aka yasunjiile khwiwe, omwami wanje, nakhureeleho obe omukhulundu khuIsiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.30",
            "verseOrgIds": [
              "1SA.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho lino shililaba eshiisichirasio khwiwe, kata eshisinyo khumwoyo kwomwami wanje tawe, mbu weebeenia amabanga harali eshifune ta, kata okhwimalila omwene eshikwoli; ne olwa OMWAMI alaba nakhukholeele amalayi, omwami wanje, kho witsulile omukholiwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.31",
            "verseOrgIds": [
              "1SA.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.31",
            "verseOrgIds": [
              "1SA.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Abigaili ari OMWAMI, Nyasaye waIsiraeli, oukhurumile leelo mbu umbukaanile, aheebwe oluyali; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.32",
            "verseOrgIds": [
              "1SA.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "oburechelefubwo nabwo buheebwe ikhabi, nawe omwene oheebwe ikhabi, olwa umboniye inyanga yino mushiuku shiamabanga, nobureemalila omwene eshikwoli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.33",
            "verseOrgIds": [
              "1SA.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba toto mwene, shinga OMWAMI, Nyasaye waIsiraeli, olwa abeetsangaho mwoyo, oyo ounzikaliile oburakhukholela libii ta, noba noraanguyilisiye niwitsa okhumbukaanila tawe, toto mwene, nibwakhashieele mutsuli, Nabali shiyakhatong'ile nomundu weshisaatsa kata mulala tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.34",
            "verseOrgIds": [
              "1SA.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yabukula mumukhonokwe ebienebio ebia yali namuleereelenamusunjila ari Tikulukha otsie ingowo nomulembe; lola, embuliile omwoyokwo, nifuchiilila aka usabile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abigaili niyoola ewaNabali yali; ne lola, yali nateeshile lisabo munzuye, shinga lisabo liomuruchi; nomwoyo kwaNabali kwali omutsatsahafu, okhuba yali nameelile muno; khulwako omukhasiwe shiyamuboolela likhuwa, kata lituutu kata likhongo ta, okhuula olwa bwashia mutsuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.36",
            "verseOrgIds": [
              "1SA.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mutsuli olwa Nabali yali nameeluluushe, omukhasiwe namuboolela amakhuwa ako, omwoyokwe nikufwa, naba shielichina. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.37",
            "verseOrgIds": [
              "1SA.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwetsindaalo shinga ekhumi, OMWAMI yamuupa Nabali, mana nafwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Daudi yahulila shinga Nabali olwa yali nafwile, yasunga mbu OMWAMI aheebwe e oluyali, oufunaanile amakhuwa kokhuseywa khwanje mumukhono kwaNabali, niyeekalila omusumbawe oburakhola obubii ta; amabii aka Nabali yakhola, OMWAMI akakalusiye khumurwe kukwe omwene. Mana Daudi naruma abandu mbu a bamusererele Abigaili. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abasumba baDaudi bali niboolile ewa Abigaili eKarameli bamusunjila bari Daudi akhurumile khwiwe, khukhuyile ewuwe omuteeshele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabuukha, nabunamia obwenibwe hasi, nasunga ari Lole omukholi weenywe nomutiitikhan i okhwosia ebilenje biabasumba bomwami wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.41",
            "verseOrgIds": [
              "1SA.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigaili niyaanguyilisia, narula, naniina khusishili ne yali nende abakhaana baraano abakholibe aba yatsia ninabo; naye nalonda munyuma wabarume baDaudi, naba omukhasiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Daudi naleera Ahinoamu oweYezereeli yesi; nabateeshia bombi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Saulo yali niyamubashila Palati waLaishi oweGalimu, omwanawe omukhaana Mikali, owali omukhasi waDaudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
            "verseOrgIds": [
              "1SA.25.44"
            ]
          }
        }
      ]
    }
