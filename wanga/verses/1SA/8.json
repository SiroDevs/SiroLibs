{
  "id": "1SA.8",
  "number": "8",
  "bookId": "1SA",
  "reference": "1 Samweli 8",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1SA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaIsiraeli basaba omuruchi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Samweli yali nakofuule, yakhola abaanabe okhuba abayaasii muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eliira liomwanawe owambeli niye Yoeli; neliira liomwanawe wakhabili niye Abiya; bali abayaasii eBeeri-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaanabe shibalonda munjilatsie ta, habula bashiama nibalonda inganga yobubatsa, nibabukula ebiomufuusi, nibashiamia obukhalachi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakofu bosi baIsiraeli bakhung'aana halala, nibamutsiila Samweli eRama; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibamusunjila bari Lola, iwe okofuule, ne abaanabo shibeechendelesia munjilatsio tawe; bulaano okhureeleho omuruchi akhuruche, shinga amahanga kandi kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa likhuwa elo shiliachamisia Samweli ta, olwa baboola mbu Okhuheelesie omuruchi akhuruche. Samweli nasaaya OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye OMWAMI namusunjila Samweli mbu Hulila omwoyo kwabandu abo mukosi aka bakhusunjila; okhuba shibakhulobile iwe ta, habula bandobile isie, mbu endeshe okhuba omuruchi wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga ebikhole biabwe biosi olwa bili, ebia balinji nibakholanga okhurula khunyanga eyo eya ndabatikulusia okhurula eMisiri okhuula olwa leelo, olwa bandekhanga isie nibakhalabanila abanyasaye bandi, nolwa bakhukholela nawe wesi bario. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khobulaano hulila omwoyo kwabwe; habula mbu obachesiyia habwene nobamanyia omuruchi oulabatuka, shinga olwa yeetsa okhufwana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli naboolela abandu abo abali nibamusabile omuruchi, amakhuwa kosi kOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Nindio omuruchi owitsa okhumuruka yeetsa okhufwana; mbu alabukula abaana beenywe abasiani nabara khumilimochie, khulwa amakaarike, nende abachendela khufarasi, nende okhwilukhanga nibeemilila amakaarike; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi aleeyahulila mubo abandi babe abaseesia babasikari eshikhumila, khandi abaseesia bamakhumi karaano; nabandi alabarakhwo okhulima emikundachie, kata okhuchesa lichesalie, kata okhukhola ebimanulwabie biokhulasanila, nende ebimanulwa biamakaarike. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi alabukula abaana beenywe abakhaana babe abakholi bemisaala chieshing'aari, nende abateeshi bebiliibwa, nende abateeshi bemikaate. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi alabukula emikunda chieenywe, nende emikunda chieenywe chiemitsabibu, nende emikunda chieenywe chiemitseituni, echio echishila obulayi, nabaheelesia abakholibe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi alamuroosinjia eshitonye shielikhumi shieimwo yeenywe nende shiemitsabibu chieenywe, nabaheelesia abakalibe, khandi nende abakholibe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi alabukula abakholi beenywe abeshisaatsa nende abeshikhasi, nende emiruko chieenywe echishila obulayi, nende tsisishili tsieenywe, natsira khumilimo chichie omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alamuroosia eshitonye shielikhumi shiokhubiayo bieenywe; ne mulaba abasumbabe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulikhupa tsimbungu khunyanga eyo, khulwa omuruchi weenywe owa muliba nimweelobolela; ne OMWAMI shialimukalusiamwo khunyanga eyo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandu bakhaya okhuhulila omwoyo kwaSamweli; nibasunga bari Tawe; habula khwenya okhuba nende omuruchi oukhuruka; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.19",
            "verseOrgIds": [
              "1SA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana nineefwe fwesi khufwanane nende amahanga kosi; khandi mbu omuruchi weefwe akhuruche, nakhwimilila nakhuseerela amahe keefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli yahulila amakhuwa kosi kabandu abo, nakarumbula khandi mumarwi kOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Samweli mbu Hulila omwoyo kwabwe, obeemeshele omuruchi. Naye Samweli nasunjila abandu baIsiraeli ari Mutsie buli mundu mwitaalalie.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    }
  ],
