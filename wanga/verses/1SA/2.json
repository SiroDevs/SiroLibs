        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwimbo lwaHana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana naye niyeekongoya, nasunga mbu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.1",
            "verseOrgIds": [
              "1SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.10",
            "verseOrgIds": [
              "1SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Elikana natsia eRama ebunangowe. Ne omwana yakhalabanila OMWAMI, nali imbeli waEli omukuhani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakhuwa kOMWAMI akarumbulwa okhufukula inzu yaEli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.11",
            "verseOrgIds": [
              "1SA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baEli bali abamayaanu abeshifwabwi; shibamumanya OMWAMI ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neshiima shiabakuhani eshia bakholelanga abandu shieshino, mbu olwa omundu yalinji niyakhamala omusango, omukhalabani womukuhani yeetsanga, inyama nishiyiitsanga, nali nende amakhango kameeno kataru mumukhonokwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nafumira munyungu, kata mushifulia, kata muyamuunyu, kata muyambeba; biosi ebia amakhango karusinjiamwo, omukuhani yabukulanga omwene. Nindio bakholanga eShiilo khubaIsiraeli bosi abeetsangayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa balinji nibashili okhusamba amasinya, omukhalabani womukuhani yeetsanga asunjila omundu ouba namalile omusango, ari Mbe inyama eyokhusambila omukuhani; shuchila shiyeenya omuhe inyama indeeshe ta, habula imbisi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu oyo naba namukalusia ari Lekha basambe amasinya mbelio, kho mana obukule shinga olwa wenya; naye yamukalusinjia ari Tawe, okhuula olwa umba bulaano; ne noramba ta, ekhunuula. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwonooni bwabasiani abo nibuba obukhongo muno mumoni tsiOMWAMI; shichila abandu abo bafwolanga ebihaanwa biOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Samweli yakhalabananga imbeli w nali omuyia, niyeeboyile efoti yeikitani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.18",
            "verseOrgIds": [
              "1SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nyina yamunabilanga ikanzu induutu namuleerela omuyika buli muyika, olwa yeetsanga nende omusaatsawe okhumala omusango kwomuyika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.19",
            "verseOrgIds": [
              "1SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Eli yabasabilanga Elikana nende omukhasiwe ikhabi, nasunga mbu OMWAMI akhuheelesie olwibulo khumukhasi uno, khulwa eshihaanwa eshia yaheebwe, nashikalusilia OMWAMI. Mana bamalanga beenyoshe, nibakalukha ebunango wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.20",
            "verseOrgIds": [
              "1SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namukoonya Hana, naye yahelanga niyeebula abaana, abasiani bataru nende abakhaana babili. Naye omwana Samvieli yali nakhulilanga imbeli wOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
            "verseOrgIds": [
              "1SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Eli yali nali omukofu muno; ne yahulilanga kosi aka abaanabe bali nibakholelanga abaIsiraeli bosi; khandi shinga olwa bakonanga nende abakhasi abatitikhananga hamuliango weliheema liomukhung'aano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.22",
            "verseOrgIds": [
              "1SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabareeba ari Mukholanga murio mbushiina? Shichila embuuliIanga khubandu bosi akebikhole bieenywe ebibii. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.23",
            "verseOrgIds": [
              "1SA.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tawe, abaana banje; okhuba shikali amakhuwa amalayi aka embulilanga abandu bOMWAMI nibatswania ebulafu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.24",
            "verseOrgIds": [
              "1SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu undi naba niyoonoonela owashie, Nyasaye niye oulabakabukhasilia; ne omundu naba niyoonoonela OMWAMI, ali heena omukayili? Nebutswa shibahulila omwoyo kwasaabwe ta; okhuba OMWAMI yali niyeerecheeshe okhubeera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omwana Samweli yatasa okhukhula, nachamwa nende OMWAMI, khandi nende abandu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho omundu undi waNyasaye namwitsila Eli, namusunjila mbu OMWAMI aboola ari nanwa, mbu Isie shmdeebisulila abeinzu yakuukawo, olwa bali nibali eMisiri nibakholelanga abeinzu yaFarao shinga abasumba? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamulobola mumbia tsiosi tsiaIsiareli, mbu abe omukuhani wanje, okhuniinanga hashimalilo shianje shiemisango, nokhusamba amalesi kelibuuliesi, nokhuchinga efoti mumoni tsianje; ndaheelesia abeinzuyakuukawo ebihaanwa biosi ebisambe biabaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nishiina eshichila nimuhenga omusango kwanje khandi eshihaanwa shianje, ebia ndalaka mushimenyo shianje, nokhumookoola, noheelesinjia abaanabo oluyali okhushila isie, mbu mukhomeelela ebihaanwa ebishila obulayi mubiosi ebiabandu banje Isiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila OMWAMI, Nyasaye waIsiraeli, aboola mbu Ndali ndasunga toto mbu abeinzuyo, nende abeshilibwa shieenywe, mwakheechendelesie imbeli wanje obushia nobushia; ne bulaano OMWAMI aboola mbu Ako kabe eyo; okhuba abambeelesinjia isie oluyali, nasi siesi embaheelesia oluyali; nabafwola isie, nabo bakhachaywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, tsindaalo tsiitsanga olwa ndalakhalaka omukhono kwamaaniko, nende omukhono kwamaani keshilibwa shieenywe, okhuula olwa arabamwo omusaakhulu yesi munzuyo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumatinyuko olashienelela obuyinda bwosi obwa abaIsiraeli baliheebwa; ne shialibamwo omusaakhulu yesi munzuyo ebisoni nebisoni tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omunduwo owa ndarakhakhalache okhurula khushimalilo shianje shiemisango ta, yakhakhuchonyilie elala tsimoni nende okhulila, nende okhukhuhendia omwoyo; netsinzibulo tsiosi tsieinzuyo bakhafwe khulwa tsinganga tsiabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi shino eshiitsa okhwitsila abaanabo babili, Hofuni nende Finehasi, shilaba eshilolelo khwiwe; mbu balifwa bombi khunyanga ndala. ",
          "type": "text",
