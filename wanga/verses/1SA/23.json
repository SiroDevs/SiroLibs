{
  "id": "1SA.23",
  "number": "23",
  "bookId": "1SA",
  "reference": "1 Samweli 23",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AkaDaudi eKeila, khandi mushitsiimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuboolela Daudi, bari Lola, abaFilisiti baseeranga abaKeila, nibayaaya tsinze. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana Daudi yareeba OMWAMI, ari Enzie ekhupe abaFilisiti bano noho? OMWAMI namusunjila Daudi mbu Tsia, okhupe abaFilisiti, ohonie Keila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu baDaudi nibamusunjila bari Lola, khushiriitsanga nikhuli hano muYuda; ne shikhwakharia okhushila nikhuba nikhutsia eKeila okhuseera amahe kabaFilisiti? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nareeba OMWAMI khandi. OMWAMI namukalusiamwo nasunga mbu Rula, okholomoshe otsie eKeila; okhuba enzitsa okhuhaana abaFilisiti mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi nende abandube nibatsia eKeila, nibaseera abaFilisiti, nibayaaya emiruko chiabwe, nibabeera obwiri obukhongo. Nindio Daudi yahonia abamenyanga muKeila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Abiatsari waAhimelekhu yeelushila ewaDaudi eKeila, yeetsa nali nende efoti mumukhono. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo naboolelwa mbu Daudi yoolile eKeila. Saulo nasunga mbu Nyasaye amuhaanile mumukhono kwanje; okhuba yeekaliilwe, olwa yeenjiile mwitaala elili nende ebilibwa nende emiyinjiilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nalachilisia abandu bosi batsie mwihe, mbu bakholomoshe batsia eKeila, beekalile Daudi nabandube. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yamanya shinga Saulo olwa amurecheshelanga amabii; namusunjila Abiatsari omukuhani ari Yitsa hano nende efoti tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nasunga mbu E OMWAMI, Nyasaye waIsiraeli, omusumbawo ahuliile toto mbu Saulo yeenya okhwitsa eKeila, mbu amulule litaala khulwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abeenetaala liaKeila beetsa okhumbaana mumakhonoke noho? Saulo yeetsa okhwitsa, shinga omusumbawo olwa ahuliile, noho? E OMWAMI, Nyasaye walsiraeli, elchusaaya mbu omubuulile omusumbawo. Naye OMWAMI na sunga mbu Nayeetse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nasunga mbu Abeenetaala liaKeila beetsa okhukhuhaan; isie nende abandu banje mumakhono kaSaulo OMWAMI nasunga mbu Nabamuhaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nende abandube, abali shinga ebikhum bisasaba, babuukha nibarula eKeila, nibatsi hosi hosi aha banyala okhutsia. Saulo naboole lwa mbu Daudi yeeluushe Keila; naye nalekh okhutsiayo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yamenya mushitsiimi mutsingoba, nahonga mushialo shiebikulu mushitsiimi shiaZifu. Naye Saulo yamukhaabanga khatsotselo, habula Nyasaye shiyamuhaana mumukhonokwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yalola shinga Saulo olwa yali narulile okhwenya obulamubwe; ne Daudi yali nali mushitsiimi shiaZifu, eHoreshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yonatsani omwana waSaulo yarula, natsiila Daudi eHoreshi, namutinyisia muMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila ari Oraria tawe; okhuba omukhono kwapapa, Saulo, shikulakhunyoola tawe; nawe witsa okhuba omuruchi waIsiraeli, nasi ndalaba owokhubili khwiwe; nakeenako Saulo, papa, akamanyile bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo babili nibalia omuuma imbeli wOMWAMI; naye Daudi namenya eHoreshi, ne Yonatsani natsia ebunangowe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaZifu nibeetsa ewaSaulo eGibea, nibasunga bari Daudi shiyayeebisa eweefwe mungoba etsili eHoreshi, mushikulushiaHakhila, eshili khumukhono omusaatsa weYeshimoni? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, e omuruchi, okholomoshe shinga omwoyokwo olwa kwenya okhukholomokha; ne nakube omulimo kweefwe okhumuhaana mumukhono kwomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo nasunga mbu OMWAMI amuheelesie ikhabi; okhuba mumbeeleele tsimbabasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chame mutsie, mumanyile elala obwatoto bwamakhuwa, nimumanya nende okhulola habunduwe ewa ayinyanga okhuba, khandi mbu niwina owamuluutsi ebweneyo; okhuba emboolelungwa mbu akholelanga mubuchesichesi muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mwayilisie, mumanye bulayi obwibiso bwosi ewa yeebisanga, mana mungalushile khandi nimuli nende obwatoto; nasi ndakhatsie nineenywe, ne naba naliho mushibala eshio, ndalamurunilisia mubikhumila biosi biaYuda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibarula, nibamuranjilila Saulo okhutsia eZifu; nebutswa Daudi nende abandube bali nibali mushitsiimi shiaMaoni, muAraba elubeka Iwesautsi weYeshimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nende abandube nibatsia okhumukhaaba. Abandu nibamuboolela Daudi, naye niyeeshela khulwanda, namenya mushitsiimi shiaMaoni. Nolwa Saulo yahulilakhwo, yalondachilila Daudi mushitsiimi shiaMaoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo yatsia mushikulu elubeka lundi, naye Daudi nende abandube elubeka lundi; ne Daudi yaanguhanga okhwilukha, khulwa okhumuria Saulo; okhuba Saulo nende abandube bali nibabotokhaane Daudi nende abandube tsimbeka tsiosi mbu babahambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omurume undi yamwitsila Saulo, nasunga ari Khola bwangu, witse; shichila abaFilisiti beenjiile mushialo nibashiyaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Saulo yakalukha narula mukhulondachilila Daudi, natsia okhuseera abaFilisiti; niko akachila nibakulikha habundu tsana mbu Olwanda Lwobwihonokoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
