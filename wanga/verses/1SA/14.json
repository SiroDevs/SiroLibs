  "reference": "1 Samweli 14",
  "verseCount": 52,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "1SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho inyanga yindi Yonatsani omwana waSaulo yasunjila omusooliili owali namuchinjilanga ebimanulwabie, ari Chendakhwambushe khutsie ewabasikaari abaFilisiti, injelekha yilia. Nebutswa shiyaboolela samwana tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.1",
            "verseOrgIds": [
              "1SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo yali namenyanga khulubeka Iweshihesi shiaGibea, hasi womukomamanga okuli eMigironi; abandu aba yali ninabo bali shinga ebikhumi bisasaba; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.2",
            "verseOrgIds": [
              "1SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Ahiya waAhitubu omusiani wabwe Ikhabodi waFinehasi, omwana waEli, omukuhani wOMWAMI eShiilo, nachinjile efoti. Ne abandu shibamanya mbu Yonatsani urulile ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.3",
            "verseOrgIds": [
              "1SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne hakari mumbaka eya Yonatsani yali niyeenya okhwambushilamwo khubasikaari abaFilisiti, lwaliho oluchengulukhol Iwolwanda elubeka, khandi oluchengulukho Iwolwanda elubeka lundi; eliira liolundi nilwo Bozezi, neliira lioiundi nilwo Sene. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.4",
            "verseOrgIds": [
              "1SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluchengulukho lundi lwasinjila enotsi, imbeli waMikhamashi, nolundi esautsi imbeli waGeba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.5",
            "verseOrgIds": [
              "1SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yonatsani nasunjila omusooliili owamuchinjila ebimanulwabie ari Chenda khwambushe, khutsie khubasikaari abasinde bano; haundi OMWAMI alakhukholela; okhuba shibulaho eshimukaya OMWAMI okhuhonia, kata nende abanji kata nende abatiiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.6",
            "verseOrgIds": [
              "1SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuchinji webimanulwabie namusunjila ari Khola kosi akali mumwoyokwo; lola, isie endi ninawe, omwoyo kwanje nimulala nende okukwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.7",
            "verseOrgIds": [
              "1SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yonatsani nasunga mbu Lola, khulaambukha khubatsiile abandu abo, khwilolosie khubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.8",
            "verseOrgIds": [
              "1SA.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaba nibakhusunjila bari Lindekhwo yaho, khumwitsile; mana khulasinjilaho habundu weefwe khurio, nikhuratikulukha okhubatsiila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.9",
            "verseOrgIds": [
              "1SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa nibaba nibasunga bari Tikulushe ewa khuli yino; mana khulatikulukha; okhuba OMWAMI ubahaanile mumakhono keefwe; nako kalaba eshilolelo khwifwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.10",
            "verseOrgIds": [
              "1SA.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bombi nibeelolosia imbeli wabasikaari abaFilisiti; nabo nibasunga mbu Mbabo, abaHeburania kho barula mumeena ewa babeele nibeebisile. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.11",
            "verseOrgIds": [
              "1SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasikaari abo nibakalusia Yonatsani nende omuchinji webimanulwabie nibasunga bari Tikulushe ewa khuli yino, khumumanyie likhuwa. Yonatsani nasunjila omuchinji webimanulwabie ari Tikulukha niunonda munyuma wanje; okhuba OMWAMI ubahaanile mumukhono kwaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.12",
            "verseOrgIds": [
              "1SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yonatsani naniinila amakhono namakulu, emuchinji webimanulwabie namulonda inyuma; abandu nibakwisibwa imbeli waYonatsani; omuchinji webimanulwabie naye nabeera munyumawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.13",
            "verseOrgIds": [
              "1SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obwiri obwambeli obwa Yonatsani nende omuchinji webimanulwabie bakhola, bwali bwabandu shinga amakhumi kabili, habundu ahahela shinga inusu ya eka ndala yomukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.14",
            "verseOrgIds": [
              "1SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyibaho indenga mukambi, nende mumikunda, nende mubandu bosi; abomwihe nende abamululi nabo bosi nibatechela; eshialo nashio nishirenga; kho indenga niyibaho ikhongo muno.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.15",
            "verseOrgIds": [
              "1SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abalindi baSaulo eGibea yaBenyamini nibahenga; ne lola, omukanda okwo nikusabulukhana, nibabiring'ana eyi nende eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.16",
            "verseOrgIds": [
              "1SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nasunjila abandu aba yali ninabo, ari Bale bulaano, mulole niwina ourulile mwifwe. Nolwa bali nibabalile, lole, Yonatsani nende omuchinji webimanulwabie bali nibabulaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.17",
            "verseOrgIds": [
              "1SA.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasunjila Ahiya ari Leera hano lisanduku liaNyasaye. Okhuba lisanduku liaNyasaye mundaalo etsio lialinjiho halala nende abaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.18",
            "verseOrgIds": [
              "1SA.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Saulo yali nasungananga nende omukuhani, indiri eyali mukambi yabaFilisiti yatsiililila butswa niyiimeeta; Saulo nasunjila omukuhani ari Kalusia omukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.19",
            "verseOrgIds": [
              "1SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Saulo nende abzndu bosi aba yali ninabo bali nibakhung'aanile halala, nibatsia mwihe; ne lola, olukanga lwabuli mundu lwayinga owashie, nibubaho obukoyaani obunji. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.20",
            "verseOrgIds": [
              "1SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaHeburania abalinjiho halala nende abaFilisiti okhurula khale, abatikulukha ninabo nibatsia mukambi, nabo nibashiukhana okhuba nende abaIsiraeli aba Saulo nende Yonatsani bali ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.21",
            "verseOrgIds": [
              "1SA.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bario abandu bosi baIsiraeli abali nibeebisa mushialo shiebikulu shiaEfuraimu, olwa bahulila shinga abaFilisiti olwa beelukhanga, nabo khandi nibabalonda nibabarakhwo obutsobi mwihe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.22",
            "verseOrgIds": [
              "1SA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa OMWAMI yahonia Isiraeli inyanga eyo; lihe nilibirila eBetsaweni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.23",
            "verseOrgIds": [
              "1SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu baIsiraeli bali nibali mumatinyu inyanga eyo; okhuba Saulo yatsubia abandu eshiitsubo, nasunga ari Abe mushilaamo shiobubii omundu yesi ouliakhwo eshiliibwa shiosi okhuula nabwile, nimalile eshikwoli khubasuku banje. Kho yabulaho omundu yesi owakoonyeelelakhwo khubiliibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.24",
            "verseOrgIds": [
              "1SA.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi beenjila mumutsuru; ne mwalimwo obuushi hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.25",
            "verseOrgIds": [
              "1SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abandu bali nibeenjiile mumutsuru, lola, obuushi bwali niburoonyanga; ne yabulaho omundu yesi owara omukhonokwe khumunwaokhuba abandu bali nibariile eshiitsubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.26",
            "verseOrgIds": [
              "1SA.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Yonatsani shiyahulila ta olwa samwana yatsubia abandu; kho yanyiila omurwe kweindabushi eya yali ninayo mumukhono, nachiina mushicheyo shiobuushi, nayila omukhonokwe khumunwa; tsimonitsie natsio nitsiamuukha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.27",
            "verseOrgIds": [
              "1SA.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oundi mubandu nakalusia nasunga mbu So yatsubiye abandu obutinyu muno, nasunga mbu Abe mushilaamo shiobubii omundu yesi ouliakhwo eshiliibwa inyanga yino. Ne abandu abo kho bali nibatorile po. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.28",
            "verseOrgIds": [
              "1SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yonatsani nasunga mbu Papa anyasiye eshialo; lole tsimoni tsianje shinga olwa tsiamuushile, shichila engoonyeleelekhwo khubuushi buno. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.29",
            "verseOrgIds": [
              "1SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikakhashilile muno, abandu nibaba nibaliile bulia leelo khubiyaayo biabasuku babwe ebia banyoolile? Okhuba bulaano shibubeeleho obwiri obukhongo mubaFilisiti ta.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.30",
            "verseOrgIds": [
              "1SA.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabarootsa abaFilisiti inyanga evo okhurula eMikhamashi okhuula eAyaloni; abandu nabo bali nibatorile muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nibakwa khubiyaayo, nibabukula amakondi, nende tsing'ombe, nende ebimoosi, nibabiirila hasi yaho; abandu nibabilia halala nende amalasile. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibaboolela Saulo bari Lola, abandu boonoonelanga OMWAMI, olwa baliitsanga halala nende amalasile. Naye nasunga mbu Mukholile akobukhobani, muselenjesilie lichina likhongo ewa endi inyanga yino. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.33",
            "verseOrgIds": [
              "1SA.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Salo nasunga mbu Musalanile mubandu, nimubasunjila muri Mundeerele hano buli mundu ing'ombeye khandi buli mundu likondilie, mubiirile hano, nimulia; nimuroonoonela OMWAMI nimulia halala nende amalasile ta. Abandu bosi nibeetsa, buli mundu nende ing'ombeye eshilo shieneshio, nibatsiirila ebweneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.34",
            "verseOrgIds": [
              "1SA.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo niyoombashila OMWAMI eshimalilo shiemisango; shieneshio nishio eshimalilo shiambeli eshia yoombashila OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.35",
            "verseOrgIds": [
              "1SA.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nasunga mbu Chende khukholomoshe khulonde abaFilisiti mushilo, khubayaaye okhuula olwa nabushie, nikhuralekha omundu yesi khubo tawe. Nibasunga bari Okhole shiosi eshia oluutsi. Nebutswa omukuhani yasunga mbu Khumusitile Nyasaye ahambi hano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.36",
            "verseOrgIds": [
              "1SA.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasaba obuchesiyi ewaNyasaye, ari Ekholomoshe enonde abaFilisiti noho? Witsa okhubahaana mumukhono kwaIsiraeli? Naye naramukalusiamwo inyanga eyo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.37",
            "verseOrgIds": [
              "1SA.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nasunga mbu Musite ahambi, inywe abamakuru bosi babandu; mumanye nimulola omwa eshionoono shino shibeele inyanga yino. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.38",
            "verseOrgIds": [
              "1SA.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga olwa OMWAMI ali mwoyo, ye ouhoninjia Isiraeli, kata mshili muYonatsani omwana wanje, okhuula olwa afwa. Ne yabu laho omundu yesi mubandu bosi owamukalusia mwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.39",
            "verseOrgIds": [
              "1SA.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nasunjila Isiraeli yosi ari Inywe mube elubeka lulala, nasi nende Yonatsani omwa na wanje khube elubeka lundi. Abandu nabo ni basunjila Saulo bari Okhole aka oluutsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.40",
            "verseOrgIds": [
              "1SA.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana Saulo nasunga ari E OMWAMI, Nyasaye wa Isiraeli, mbushiina noramukalusiyemwo omusu mbawo inyanga yino ta? Eshiukul shino nishib nishili mwisie kata muYonatsani omwana wanje, e OMWAMI, Nyasaye waIsiraeli, ohaane Urimu ne eshiuku shino nishiba nishili mubandub Isiraeli, ohaane Tsumimu. Mana Yonatsar nende Saulo nibabukulwa; abandu nabo niba hona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.41",
            "verseOrgIds": [
              "1SA.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasunga mbu Khupa ikha hakal wanje nende Yonatsani omwana wanje. Nay Yonatsani yabukulwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.42",
            "verseOrgIds": [
              "1SA.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo nasunjila Yonatsani ari Umboolele elia okholile. Yonatsani namuboolela, nasunga mbu Toto mwene, engoonyeleele khubuushi nende omurwe kweindabushi eya embeele ninayo mumukhono kwanje; kho ngako, ekhoyile okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.43",
            "verseOrgIds": [
              "1SA.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasunga mbu Nyasaye akhole ario, nende okhushilaho; okhufwa olafwa, Yonatsani ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.44",
            "verseOrgIds": [
              "1SA.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1SA 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nabo nibasunjila Saulo bari Ne Yonatsani yeetsa okhufwa, noho, owaleera obuhonia buno obukhongo muIsiraeli? Shikanyalikha nahatuutu ta; shinga olwa OMWAMI ali mwoyo, kata olwoya lulala olwokhumurwekwe shilwitsa okhukwa hasi tawe; shichila akholile halala nende Nyasaye inyanga yino. Nilwo olwa abandu bamununula Yonatsani, oburafwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.45",
            "verseOrgIds": [
              "1SA.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo natikulukha nalekha okhulonda abaFilisiti; abaFilisiti nabo nibatsia ewabwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1SA 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.46",
            "verseOrgIds": [
              "1SA.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1SA 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Saulo yali naliile obwami khuIsiraeli, yaseera abasukube tsimbeka tsiosi; mbu Moabi, nende abaAmoni, nende Edomu, nende abaruchi baZoba, nende abaFilisiti; ne hosi hosi ewa yashiukhananga, yabahulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.47",
            "verseOrgIds": [
              "1SA.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola neitswoni, narootsa abaAmaleki, nahonia Isiraeli mumakhono kabwe ababayaayanga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1SA 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.48",
            "verseOrgIds": [
              "1SA.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1SA 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baSaulo abasiani mbabano; mbu Yonatsani, nende Ishiwi, nende Malikhishua; nameera kabaanabe abakhaana babili mbabano, mbu eliira liowambeli niye Merabu, neliira liomutuutu niye Mikali; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.49",
            "verseOrgIds": [
              "1SA.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1SA 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "neliira liomukhasi waSaulo niye Ahinoamu, omukhaana waAhimaazi; khandi eliira liomuseesia welihelie niye Abineri, omwana waNeri, samwana Saulo undi; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.50",
            "verseOrgIds": [
              "1SA.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Kishi, samwana Saulo, nende Neri samwana Abineri, nibo abaana baAbieli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1SA 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.51",
            "verseOrgIds": [
              "1SA.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1SA 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lialiho lihe lilulu liabaFilisiti mundaalo tsiosi tsiaSaulo; nolwa Saulo yalolanga ekha muNdakano yaKhale yoluYunani. Omundu yesi omululu owamaani, kata oweitswoni, yamubukulanga abe ninaye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.52",
            "verseOrgIds": [
              "1SA.14.52"
            ]
          }
        }
      ]
    }
