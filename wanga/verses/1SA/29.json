    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaFilisiti bakanakania khukaDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaFilisiti bakhung'aasia amahe kabwe kosi eAfeki; abaIsiraeli nabo nibakhoma ikambi yabwe hasebele eyili muYezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.1",
            "verseOrgIds": [
              "1SA.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaami babaFilisiti nabo nibalondana, ebikhumi ebikhumi, khandi ebikhumila ebikhumila; naye Daudi nende abandube nibabalondakhwo inyuma wabwe halala nende Akhishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.2",
            "verseOrgIds": [
              "1SA.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakhulundu babaFilisiti nibasunga bari AbaHeburania bano bali barie hano? Naye Akhishi nasunjila abakhulundu babaFilisiti ari Uno shiali niye Daudi, omusumba waSaulo omuruchi waIsiraeli, owabeelenje ninasi tsindaalo tsino kata emiyika chino, nindanyoola eshiuku shiosi khuye ta, okhurula khunyanga olwa yeelul ha niyanzitsila okhuula olwa Ieelo? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.3",
            "verseOrgIds": [
              "1SA.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abakhulundu babaFilisiti bamusinyishila; abakhulundu babaFilisiti nibamusunjila bari Kalusia omundu oyo, akalushe ewuwe ewa wamura; aleshe okhutsia nineefwe mwihehaundi mwihe yakheekhola omusuku khwifwe; okhuba uno yakhamutsiila omwamiwe muli injila shiina mbu asasanibwe ninaye? Shichiakhaba emirwe chiabandu bano? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.4",
            "verseOrgIds": [
              "1SA.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uno shiali niye Daudi, owa boongulilananga mukhushina khwabwe, nibasunga bari",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.5",
            "verseOrgIds": [
              "1SA.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Akhishi namulanga Daudi, namusunjila mbu Shinga OMWAMI olwa abeetsangaho mwoyo, wabeelenje omukololofu, khandi okhusamulakhwo nende okhuchelelakhwo halala ninasi mwihe khwabeelenje okhulayi mumoni tsianje; okhuba shindanyoolakhwo obubii mwiwe ta, okhurula khunyanga olwa wanzitsila okhuula olwa leelo; habula abaami shibakhuchamile tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.6",
            "verseOrgIds": [
              "1SA.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano okalushe, otsie nomulembe, oleshe okhusinyisia abaami bano abaFilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.7",
            "verseOrgIds": [
              "1SA.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Akhishi ari Ne eshia ekholile nishiina? Kata nishiina eshia oluutsi khumusumbawo tsindaalo tsiosi olwa ndabeelenje imbeliwo okhuula olwa leelo, eshiakhachila nindafuchiililwa okhutsia okhuseera abasuku bomwami wanje omuruchi ta? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.8",
            "verseOrgIds": [
              "1SA.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Akhishi nakalusia namusunjila Daudi ari Emanyile shinga olwa oli omulayi mumoni tsianje, shinga malaika waNyasaye; habula abakhulundu babaFilisiti bano bakaanile bari Shialatikulukha okhutsia nineefwe mukhuseera ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.9",
            "verseOrgIds": [
              "1SA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano ohuune mumabwibwi, halala nende abasumba bomwamiwo aba witsile ninabo; ne nibwakhashia, nimwakhabuukha, muhweho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.10",
            "verseOrgIds": [
              "1SA.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yahuuna, nende abandube, okhwinyokha mumabwibwi, okhukalukha mushibala shiabaFilisiti. Nabo abaFilisiti nibatikulukha nibatsia eYezereeli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.29.11",
            "verseOrgIds": [
              "1SA.29.11"
            ]
          }
        }
      ]
    }
  ],
