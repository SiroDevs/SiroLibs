            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.1",
            "verseOrgIds": [
              "EZK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, choomia tsimonitsio okhuhenga enaYerusalemu, niwilwatsa nohenjile habandu ahatakatifu, nolakulila eshialo shiaIsiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.2",
            "verseOrgIds": [
              "EZK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nosunjila eshialo shiaIsiraeli ori Kano niko aka OMWAMI aboola; mbu Lola, ekhufukula; endi okhutsomola olukanga lwanje muluula, ne ndalakhalaka khwiwe abalunjishi nababii bombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.3",
            "verseOrgIds": [
              "EZK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa endi okhukhalaka khwiwe abalunjishi nababii, niko akachila olukanga lwanje lularula muluula, niluseera abandu bosi, okhurula esautsi okhuula enotsi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.4",
            "verseOrgIds": [
              "EZK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana abandu bosi balamanya mbu isie OMWAMI enzomoole olukanga lwanje muluula; kata shilulakalukhamwo khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yisia amahuumo, mwana womundui yisia amahuumo nobululu, omwoyokwo nikutubuushe, imbeli wetsimoni tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa balakhureeba bari Mbushiina niwisia amahuumo? Oba-kalusie mbu Khulwa amakhuwa aka embuliile; okhuba kali okhwitsa; ne buli mwoyo kulayengukha, amakhono kosi nikatubukha, buli roho niyihweelela, amasikamo kosi nikakwa shinga amatsi. Lola, kali okhwitsa, ne kaleekhola, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.8",
            "verseOrgIds": [
              "EZK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, rumbula nosunga ori Kano niko aka OMWAMI aboola; mbu Sunga ori",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.9",
            "verseOrgIds": [
              "EZK.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.13",
            "verseOrgIds": [
              "EZK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho iwe, mwana womundu, rumbula, nokhupa tsikhofi; olukanga Iwitse khabili, kata okhuula khataru, olukanga Iwobwiri; olukanga olukhongo Iwobwiri olubafumbiile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.14",
            "verseOrgIds": [
              "EZK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereele olukanga habilibwa biabwe biosi, mbu emioyo chiyengushe, nibeesichirala muno. Woowe! Lukwile oluhenu, niluruutwa khulwa obwiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.15",
            "verseOrgIds": [
              "EZK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiyiakale khumukhono musaatsa nokhumukhasi, aha tsimonitsio tsiachoomiibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.16",
            "verseOrgIds": [
              "EZK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi siesi ndalakhupa tsikhofi, nihutsulusia obululu bwanje; isie OMWAMI nisie ouboolile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.17",
            "verseOrgIds": [
              "EZK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, raho tsinjila tsibili etsia olukanga Iwomuruchi waBabeli lunyala okhulondakhwo; natsio tsibili tsibe etsirula khushialo shilala. Mana raho eshiolelo; oshircho khubuchaachilo bweinjila eyitsia mwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oreho injila khulwa olukanga okhuula eRaba ewabaana baAmoni, nende okhuula khuYuda naYerusalemu eliolukhoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omuruchi waBabeli asinjiile hamasanganjila, khumirwe chietsinjila etsio tsibili, okhulakula. Areesia ebisele, nareeba omuterafi, nahenjelesia eshini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikha yaYerusalemu yimukwira khumukhono musaatsa; kho yaho niho aha alachinjila amakhu, naraho emiyini echiokhutuya ebilibwa, okhuswala ebituuli netsingoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kalababeela obulakusi obukhaya mumoni tsiabwe; bayeetsuba ebiitsubo; ne abeetsusia akobumayaanu bwabwe, mbu bahambwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako kano niko aka Omwami NYASAYE aboola; mbu Shichila mwachilile obumayaanu bweenywe nibwitsulilwa, obukhayi bweenywe nibufuunulwa, mana mubikhole bieenywe biosi ebionoono bieenywe biloleshelanga; mbu shichila mumalile okhwitsulilwa, mulahambwa imbambe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.24",
            "verseOrgIds": [
              "EZK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, omubii iwe owoonoonekha, omukhulundu waIsiraeli owa induukhoyo yulile, eshise shiobukuumwi obuhelelesia, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.25",
            "verseOrgIds": [
              "EZK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kano niko aka Omwami NYASAYE aboola; mbu Rusiaho eshilemba rungula olusimbi; shikalabeetsanga kario khandi ta; chinguula eshili hasi, niwisia eshili hekulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.26",
            "verseOrgIds": [
              "EZK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalikulukho, amalikulukho, amalikulukho! Ndalalikwisia amalikulukho akaraliho khale ta, okhuula olwa aleetsa oulikhoyeele; mana ndalamuheelesia ye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyaasii khubaAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, lakula, nosunga ori Kano niko aka Omwami NYASAYE aboola khukabaana baAmoni, nende khumanyeko kabwe; oboole mbu Olukanga, olukanga lutsomoolwe khulwa obwiri; luruutilwe mbu lung'inang'ine, niluhenukha shinga oluhenu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa bakhulolela akobukhaya, olwa bakhulakulila akobubeeyi; lulareebwa khwikosi liababii abo abayonooneshe, aba induukho yabwe yulile, eshise shiobukuumwi obuhelelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olukalusie muluula lwalwo. Habundu yaho ewa walonjelwa, mushialo eshiaweebulilwamwo, neyo ewa ndalakhuyaasilia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalakhutsushiilila obusinyishi bwanje; ndalakhufuurila omulilo kwoburima bwanje; ndalakhuhaana mumakhono kabandu abali eshinasolo, abali abasitsa mukhumulula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olakwa butswa tsikhwi tsiomulilo; amabangako kalanyooleshela mushialo hakari; shioleetsulilwa khandi ta; isie OMWAMI nisie ouboolile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
            "verseOrgIds": [
              "EZK.21.32"
            ]
          }
