            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.1",
            "verseOrgIds": [
              "EZK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, choomia tsimonitsio okhuhenga tsingulu tsiaIsiraeli, orumbule amakhuwa kanje tsingulu tsialsiraeli, orumbule amakhuwa kanje notsifukula, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ori Inywe tsingulu tsiaIsiraeli, hulile likhuwa liOmwami NYASAYE; kano niko niko aka Omwami NYASAYE aboolela tsingulu nende ebikulu, emialo nende amabanda; mbu Lole, isie, isie omwene, ndalaleera olukanga khwinywe, nimulula habundu weenywe hachinguukhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.3",
            "verseOrgIds": [
              "EZK.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebimalilo bieenywe biemisango biloonoonibwa, nabio ebimalilo bieenywe biamalesi kelibuuliesi bilasasaakwa; ndalasukuna abeerwa beenywe imbeli wemindu echia mwinamilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.4",
            "verseOrgIds": [
              "EZK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalakonia emilambo chiabaana baIsiraeli imbeli wemindu echia beenamilanga, nisalaasia amakumba keenywe habimalilo bieenywe tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.5",
            "verseOrgIds": [
              "EZK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubimenyo bieenywe biosi amataala kalakwisibwa amakunda, habundu hosi ahachinguukhu nihoonoonibwa, emindu chieenywe echia mwinamilanga nichisasaakwa nichiakama, ebimalilo bieenywe biamalesi kelibuuliesi nibiremwa, ebikhole bieenywe biosi nibisiliisibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.6",
            "verseOrgIds": [
              "EZK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeerwa beenywe balakwitsanga hakari weenywe; neenyu mulamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.7",
            "verseOrgIds": [
              "EZK.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ndalamuleshela omusikalo, okhuba mulabakhwo nabandi abeehonokokha mulukanga hakari wamahanga, olwa mulaba nimusalaanile mubialo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.8",
            "verseOrgIds": [
              "EZK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaleehonokokha khwinywe baIanzitsulilanga mumahanga ako ewa balayilwa mubuhambe, shinga olwa ndafunaka emioyo chiabwe echibula obwisiikwa, echiarulakhwo, nimbofusia tsimoni etsitsia mubuheyi bwokhulonda emindu echia beenamilanga; ne baleesinya abeene mumoni tsiabwe khulwa tsimbii etsia bakhola mubisinyo biabwe biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.9",
            "verseOrgIds": [
              "EZK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne balamanya mbu isie nisie OMWAMI; kata shindasunga amakhaya, mbu ndakhabakhupia khushibii shino ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.10",
            "verseOrgIds": [
              "EZK.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Khupa tsikofi, wikhong'onde, nosunga mbu Woowe! Khulwa ebisinyo ebibii bieinzu yaIsiraeli; okhuba balakwa khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouba nali ehale alafwa khulwa oluumbe; ouba nali ahambi alakwa khulwa olukanga; ne ouba natong'a nalindungwa alafwa khulwa inzala; nindio ndaloosia obululu bwanje khubo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulamanya mbu isie nisie OMWAMI, olwa abeerwa babwe balanyoolekha nibali hakari wemindu chiabwe echia beenamilanga, echifumbila ebimalilo biabwe, nokhubuli shikulu eshirambi, nokhubutenje bwetsingulu, nomushiinikha shiabuli musaala omutendeemu, nomushiinikha shiabuli muruba omutendeemu, habandu ewa balinji nibatuumilia emindu chiabwe tsana chiosi isakakha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.13",
            "verseOrgIds": [
              "EZK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndalanyiila omukhono kwanje khubo, ninzonoonia eshialo nishikwisia likunda, okhurula khushitsiimi okhuula khuRibila, mubimenyo biabwe biosi. Mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.14",
            "verseOrgIds": [
              "EZK.6.14"
            ]
          }
        }
      ]
    }
