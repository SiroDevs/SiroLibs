    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyarusiaho niyambila mulwanyi Iwelwanyi, enanotsi, niyanzusia khubisika ebiahengana nolwanyi Iweihekalu, nibihengaane nende omuumbakho enanotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburambi bwomuumbakho enotsibwali amakhono eshikhumi, nobuchiikha amakhono amakhumi kara ano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbeli wobwiyangu tsana obwamakhono amakhumi kabili obwolwanyi Iwomukari, ahahengana nobwelu bwamachina bwolwanyi Iwelwanyi, haliho ahokhubirila ahahengana nahandi hario, khubwelu bwakhataru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbeli webisika yaliho injila hakari, eya obuchiikha bwayo bwali amakhono ekhumi noburambi amakhono eshikhumi; emiliango chiabio chiahenga enotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ebisika biahekulu biali ebinyelelekhwo, shichila ahokhubirila habi bukulangakhwo obwiyangu obushila obwabukulwa khubweli bwahasi nobwomukari mumuumbakho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila bianzwa obwelu butaru, nibirali netsisiilo shinga tsisiilo etsiomulwanyi ta; ne khulwako ebiahekulu biasunduukha okhushila obwelu bwahasi nobwahakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaliho omushingachi elwanyi, okwarondokhana nende ebisika, enalwanyi Iwelwanyi, okhuhengana nebisika, ne oburambi bwakwo bwahela amakhono amakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ebisika ebiomulwanyi Iwelwanyi, oburambi bwabio bwahela amakhono amakhumi karaano; nabio ebiahengana neihekalu biahela amakhono eshikhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi webisika ebio bwaliho obwinjililo ebukwe, noli owinjilamwo okhurula mulwanyi Iwelwanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "khubuchaachilo bwomushingachi kwelwanyi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elubeka Iwesautsi, ahahengana nende olwanyi Iweihekalu nende omuumbakho, bialiho ebisika ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebiali nende injila imbeli wabio, shinga ebisika ebielubeka Iwenotsi; biahelana ninabio oburambi nobuchiikha, nibili nobwinjililo bwosi burio, nokhukasibwa khwosi, nemiliango. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi webisika biesautsi bwaliho obwinjililo ebukwe, noli owinjilila khunjila tsana; ne ahahengana ninabio kwaliho omushingachi okukabukhasiaho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyamboolela mbu Ebisika bienotsi nebisika biesautsi ebihengana nende olwanyi Iweihekalu nibio ebisika ebitakatifu, ewa abakuhani abasitanga ahambi khuMWAMI balaliilanga khubindu ebili ebitakatifu muno. Neyo ewa balabiikhanga ebindu ebili ebitakatifu muno, mbu omsusango kweimele, nomusango kwobwonooni, nomusango kweshiuku; okhuba habundu yaho nahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abakuhani baba nibeenjila habundu ahatakatifu, baleshe okhurulamwo batsie mulwanyi lwelwanyi nibarabiishileyo ebii fwalo biabwe biobukhalabani, okhuba nebitakati fu; beefwale ebiifwalo bindi nibarashiasita aha mbi khukabandu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namalile okhuchela ihekalu mukari wayo, yarusilia mushilibwa eshihenga enabukwe, nachichela tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yachela elubeka Iwebukwe nelitundu liokhuchela, mbu kosi amatundu ebikhumi biraano akelitundu elo eliokhuchela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nashiukhana nachela elubeka Iwenotsi, mbu kosi amatundu ebikhumi biraano akelitundu elo eliokhuchela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nashiukhana nachela elubeka Iwesautsi, mbu amatundu ebikhumi biraano akelitundu elo eliokhuchela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nashiukhana khulubeka lwamumbo nachela, mbu amatundu ebikhumi biraano akelitundu elo eliokhuchela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yachichela tsimbeka tsiosi; ne olukoba olwachibotokhana lwahela amakhono ebikhumi biraano oburambi, nobuchiikha amakhono ebikhumi biraano, okhwahukhasia ebili ebitakatifu nebirali ebitakatifu ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
