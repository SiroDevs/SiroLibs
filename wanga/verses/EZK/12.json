          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, lia ebiliibwabio nokhutechela, nonywa amatsiko nokhurenga nende obuhendi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nosunjila abandu beshialo ori Kano niko aka Omwami NYASAYE aboola khukabamenyanga muYerusalemu nomushialo shiaIsiraeli; mbu balaliitsanga ebiliibwa biabwe nobuhendi, nibanywa amatsi kabwe noburii obukhongo, okhuba eshialo shiabwe shialekhwa eshikhaya, aharali biosi ebibeetsangamwo ta, khulwa amahababa ka abo bosi abamenyamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amataala akamenyungwamwo nako kalakwisibwa likunda, eshialo shiosi nishiba eshikhaya; mana mulamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
