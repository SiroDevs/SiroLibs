    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo khuyamuunyu eyiyia niyipapachila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Khandi mumuyika kwashienda, mumwesi kwekhumi nikuli ekhumi, likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.1",
            "verseOrgIds": [
              "EZK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, handiika eliira lieinyanga yino, eyene neyene; omuruchi waBabeli wakheekalila Yerusalemu inyanga yino. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.2",
            "verseOrgIds": [
              "EZK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochelele abeinzu yino yeinduli oluchelo, nobasunjila ori Kano niko aka Omwami NYASAYE aboola; mbu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.3",
            "verseOrgIds": [
              "EZK.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.5",
            "verseOrgIds": [
              "EZK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho kano niko aka Omwami NYASAYE aboola; mbu Woowe khwitookho lieshitsayi, khuyamuunyu eyilimwo tsindebelende, eya tsindebelende tsiayo tsiranyala okhurulamwo ta! Rusia eyilimwo, eshitonye eshitonye; okhwela khuleshe okhubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.6",
            "verseOrgIds": [
              "EZK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba amabanga aka yeebeenia kali hakariwe; yakara khulwanda olukhaya; shiyakatsukha khwiloba okhukabukakhwo olufu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi, okhubuusia obululu nokhumala eshikwoli, ereele amabanga aka yeebeenia khulwanda olukhaya, kaleshe okhufuunikhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka Omwami NYASAYE aboola; mbu Woowe khwitookho lieshitsayi! Nasi ndalameeta eshituuli shibe eshikhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sunda tsikhwi, meeta omulilo, teekha inyama muno, lunga bulayi; amakumba nako kasambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ochikalusie khumaanda niyili ikhaya, mbu yiyiye, omukasa kwayo kusambwe, eshifwabwi shiamwo shisalulusibwe, tsindebelendenatsio tsisambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.11",
            "verseOrgIds": [
              "EZK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeechoonyiye butswa; tsindebelende tsiayo tsinyinji shitsirusibungwamwo nomulilo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.12",
            "verseOrgIds": [
              "EZK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindebelende tsana nobwilaasiibwo obweshifwabwi; okhuba ndakhusiiya nawe norasiiyikha ta, kho shiolasiiywa eshifwabwishio khandi ta, okhuula olwa ndalaba nihutsulusiliye obululu bwanje khwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.13",
            "verseOrgIds": [
              "EZK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie OMWAMI nisie ouboolile; kaleekhola, nasi ndalakakhola; shindalakalukha inyuma, kata okhubeelelela, kata okhwikalukhasia ta; tsinjilatsio shinga olwa tsili, nebikholebio shinga olwa bili, nindio ndalakhuyaasia, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwamukha Ezekieli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.14",
            "verseOrgIds": [
              "EZK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.15",
            "verseOrgIds": [
              "EZK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, lola, endi okhumubukula oyo owa oheelanga muno, neikhupa; nebutswa shioleekhuula kata okhulila kata okhuroonyia amasika ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.16",
            "verseOrgIds": [
              "EZK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yisia amahuumo butswa noholeelile; orakasilia omufuwo amasika ta; wibohe eshilembashio, niwifwala ebilaaro; ne orafuunikha omunwakwo, kata okhulia ebiliibwa biamasika ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
              "EZK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nisungana nabandu musenya; ne khubwile omukhasi wanje nafwa; ne nibushia mukamba nikhola shinga olwa ndali nindachilwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
            "verseOrgIds": [
              "EZK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu nibareeba mbu Shiokhakhuboolelakhwo eshisina shiamakhuwa kano khwifwe, eshichila nokholanga orio? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
            "verseOrgIds": [
              "EZK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbasunjila mbu Likhuwa liOMWAMI linzitsiile, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
            "verseOrgIds": [
              "EZK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sunjila abeinzu yaIsiraeli ori Kano niko aka Omwami NYASAYE aboola; mbu Lola, enzitsa okhwonoonia habundu wanje ahatakatifu, ing'oono yene yobunyali bweenywe, ahanyonya tsimoni tsieenywe naha omwoyo kweenywe kwikomba; nabo abaana beenywe abasiani nabakhaana, aba mwaleshile inyuma, balakwisibwa nolukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu mulakhola shinga isie olwa ekholile; shimulafuunikha eminwa chieenywe kata okhulia ebiliibwa biamasika ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebilemba bilaba khumirwe chieenywe, nebilaaro mubilenje bieenywe; shimuleekhuula kata okhulila ta; ne mulahweelelela mubumayaanu bweenywe, nimubinda abeene khubeene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.23",
            "verseOrgIds": [
              "EZK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nolwa Ezekieli alamubeela eshilolelo; aka akholile kosi shinga olwa kali, nolwa mulakhola; olwa kano kalaba nikeetsile, mana mulamanya mbu isie nisie Omwami NYASAYE.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.24",
            "verseOrgIds": [
              "EZK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, khunyanga eyo olwa ndalababukulakhwo habundu wabwe hamaani, ing'oono yabwe eyibasangaasia, ahanyonya tsimoni tsiabwe naha omwoyo kweenywe kwikomba, khandi nende abaana babwe abasiani nabakhaana, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.25",
            "verseOrgIds": [
              "EZK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "khunyanga eyo omundu owihonokooshe alakhwitsila, nakhuupila omunwa ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.26",
            "verseOrgIds": [
              "EZK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga eyo omunwakwo kuleekushila omundu tsana owihonokooshe; olaboola, noraba omusilu khandi ta; kho olababeela eshilolelo; mana ba amanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.27",
            "verseOrgIds": [
              "EZK.24.27"
            ]
          }
        }
      ]
    }
