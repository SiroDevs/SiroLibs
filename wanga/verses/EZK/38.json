            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.1",
            "verseOrgIds": [
              "EZK.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, shiukhana ohenje Gogu, oweshialo shiaMagogu, omukhulundu waRoshi, Meshekhu, naTubali; omufukule nolakula, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.2",
            "verseOrgIds": [
              "EZK.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomusunjila mbu Kano niko aka Omwami NYASAYE aboola; mbu Lola, ekhufukula, iwe Gogu omukhulundu waRoshi, Meshekhu, naTubali; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.3",
            "verseOrgIds": [
              "EZK.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndalakhushiukhasia, nira amahana museyatsio, nikhurusia, halala nende lihelio liosi, tsifarasi nende abachendela khutsio, bosi nibeefwalile ebimanulwa biosi, omukanda omukhongo kwabetsingabo netsikuutwa, bosi nibali netsinganga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.4",
            "verseOrgIds": [
              "EZK.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaPeresia nabaEtiopia nabaPuti halala ninabo, bosi nibali netsingabo netsikuutwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.5",
            "verseOrgIds": [
              "EZK.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomeri netsing'andatsie tsioisi; Betsi-togama okhurula khushihesi shienotsi, netsing'andatsie tsiosi; mbu tsimbia tsinyinji halala ninawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.6",
            "verseOrgIds": [
              "EZK.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obe niwirecheeshe, toto, wirecheshe bulayi iwe nemikanda chio chiosi echiba nichikhung'aanile ewa oli; nawe obe omulindi wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.7",
            "verseOrgIds": [
              "EZK.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwetsindaalo tsinyinji olilakwa; mana mumiyika chiolunyuma oliula mushialo eshiakalusibwa okhurula mubusoolo, ewa bakhung'aasilibwa okhurula mumbia tsinyinji, khungulu tsiaIsiraeli etsialinji tsikhaya tsindaalo tsiosi; barusibwa mumbia tsiabandu, ne balamenya shisale, bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.8",
            "verseOrgIds": [
              "EZK.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olatikulukha; oleetsa shinga imbumbuyeka; olafwana shinga lileesi elifuunikha eshialo, iwe omwene netsing'andatsio, netsimbia tsinyinji halala ninawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.9",
            "verseOrgIds": [
              "EZK.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Khunyanga yeneyo amakhuwa kaleenjila mumwoyokwo, mana olakulukunza tsiyemi tsimbii. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.10",
            "verseOrgIds": [
              "EZK.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olasunga mbu Ndalatikulukha ninzia khushialo shiamataala akabula tsingoba; ndalabarulila, ninzia khubandu abali mubuholeelefu, abamenyanga shisale, bosi nibamenya nibarali netsingoba ta, kata emiyinjiilo kata tsinzichi tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.11",
            "verseOrgIds": [
              "EZK.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuyaaya ebiyaayo, nokhubukula ebioluyiitsi; okhuchinga omukhono okhuseera amakunda aka bulaano kamenywamwo; nokhuseera abandu abakhung'aanile okhurula mumahanga kosi, abanyoola emiruko nemiandu, abamenya mushialo hakari bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.12",
            "verseOrgIds": [
              "EZK.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheba, naDedani, nabandu bobukhala abeTarashishi, netsitalanyi tsimbuukha tsieyo, balakhureeba mbu Kho witsile okhuyaaya ebiyaayo? Okhung'aasiye omukandakwo okhubukula ebioluyiitsi? Okhuchinga tsifeetsa netsitsahaabu, nokhuyila emiruko nemiandu, okhuyaaya ebiyaayo ebinji, noho?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.13",
            "verseOrgIds": [
              "EZK.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, mwana womundu, lakula nosunjila Gogu ori Kano niko aka Omwami NYASAYE aboola; mbu Khunyanga eyo olwa abandu banje Isiraeli baliba nibamenyanga shisale, iwe shiolibuukha ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.14",
            "verseOrgIds": [
              "EZK.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwitsa norula ewuwo, okhurula khushihesi enotsi, iwe, netsimbia tsinyinji halala ninawe, bosi nibachendela khutsifarasi, omukanda omukhongo, lihe liamaani, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.15",
            "verseOrgIds": [
              "EZK.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olitikulukha okhuseera abandu banje Isiraeli, shinga lileesi elifuunikha eshialo; ne mundaalo tsiolunyuma ndalakhuleera okhuseera eshialo shianje, mbu mana amahanga kamanye, olwa ndalalolosia obutakatifu bwanje mwiwe, iwe Gogu, imbeli wetsimoni tsiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.16",
            "verseOrgIds": [
              "EZK.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.16",
            "verseOrgIds": [
              "EZK.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Niwe omundu tsana owa ndasungakhwo khale mubasumba banje abanabii baIsiraeli, abalinji nibalakula mundaalo etsio, emiyika eminji, mbu ndakhakhuleera okhubaseera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.17",
            "verseOrgIds": [
              "EZK.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga tsana, olwa Gogu aleetsa okhuseera eshialo shiaIsiraeli, obululu bwanje bulaakha muno, Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.18",
            "verseOrgIds": [
              "EZK.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndaboola mumbalikha yanje nomukhwakha khwoburima bwanje, mbu Toto mwene, khunduukho eyo khulabaho okhurenga okhukhongo mushialo shiaIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.19",
            "verseOrgIds": [
              "EZK.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa tsinyeeni etsiomunyanza, namanyonyi akomwikulu, netsisolo etsiomubulimo, nebimoolanga biosi ebimoola khushialo, nabandu bosi abali khushialo, balarenga khukhubaho khwanje; tsingulu tsilakwisibwa, tsinjengulukho tsilakwa, ne buli lukoba lwosi lulakwisibwa hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.20",
            "verseOrgIds": [
              "EZK.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalalanjisia amariisia ketsimbia tsiosi okhumuyinga Gogu, ne olukanga lwabuli mundu lulayinga owashie; nolwa Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.21",
            "verseOrgIds": [
              "EZK.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamukhalachila eshiina shioluumbe nende amatsayi; ndalasundula if ula inyinji khuye, nokhung'andatsie, nokhutsimbia tsinyinji etsia ali ninatsio, halala nende amachina amakhongo kelikulu, nomulilo, namalesi keshibiriti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.22",
            "verseOrgIds": [
              "EZK.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalalolosia obukhongo bwanje nobutakatifu bwanje, nindimanyisia mumoni tsiamahanga amanji, mana balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.23",
            "verseOrgIds": [
              "EZK.38.23"
            ]
          }
        }
      ]
    }
