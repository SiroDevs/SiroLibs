      },
      "items": [
        {
          "text": "Eshihesi nishiula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.1",
            "verseOrgIds": [
              "EZK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, kano niko aka Omwami NYASAYE aboolela eshialo shiaIsiraeli; mbu Eshihesi; mbu eshihesi shiulile khutsikoona tsine tsiosi tsieshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.2",
            "verseOrgIds": [
              "EZK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano eshihesi shili khwiwe, nasi ndalaruma oburima bwanje khwiwe, nikhuyaasia, tsinjilatsio shinga olwa tsili; khandi ndalakhukuuma khulwa ebisinyobio biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.3",
            "verseOrgIds": [
              "EZK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata imoni yanje shiyilakhubeelelelela, kata shindalakhubeela tsimbabasi ta; nebutswa ndaIakhukuuma khulwa tsinjilatsio, ebisinyobio nabio ebili hakari mwiwe; mana mulamanya mbu isie nieie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.4",
            "verseOrgIds": [
              "EZK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Liraba lilonda khumaraba kandi; lola, liitsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.5",
            "verseOrgIds": [
              "EZK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshihesi shiulile, eshihesi tsana shiulile; shisisimuushe okhukhufukula; lola, shiitsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.6",
            "verseOrgIds": [
              "EZK.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imongo yulile khwiwe, iwe oumenyanga mushialo; eshise shiulile, induukho yili ahambi; inyanga yeindiri, eyirali eyetsingalakala ta khutsingulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.7",
            "verseOrgIds": [
              "EZK.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano enzitsa okhukhusundulila obululu bwanje, ninzusia oburima bwanje khwiwe, nikhuyaasia tsinjilatsio shinga olwa tsili; ne ndalakhukuuma khulwa ebisinyobio biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.8",
            "verseOrgIds": [
              "EZK.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata imoni yanje shiyilabeelelela, kata shindalakhubeela tsimbabasi ta; ne ndalakhukuuma tsinjilatsio shinga olwa tsili, ebisinyobio nabio nibili hakari mwiwe; mana mulamanya mbu isie nisie OMWAMI, khandi mbu ekhupanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.9",
            "verseOrgIds": [
              "EZK.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.9",
            "verseOrgIds": [
              "EZK.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, induukho njieyo; lola, yisita ahambi; imongoyo yirulile; ebiela bisebuushe; obwichinjimisii bukaniishe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.10",
            "verseOrgIds": [
              "EZK.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahababa kakhulile nikaba indabushi yobubii; ne okhurula khubo ta, kata okhurula khubunji bwabwe kata khubuyinda bwabwe; kata shibulabaho obushilaasii mubo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.11",
            "verseOrgIds": [
              "EZK.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshise shiulile, induukho yisita ahambi. Omukuli aleshe okhwikhoya, kata omukusii okhwikhuula ta; okhuba oburima buli khubunji bwabwe bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omukusii shialakalushila eshieneshio eshia akusiye, olwa bashili mwoyo bombi, ta; okhuba libisulo lili khubunji bwabwe bwosi; shililakalukhasibwa ta; khulwa obumayaanu bwabwe abulaho ouleetinyia omwene ta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakhupile itarumbeta, nibarechekha ebindu biosi; nebutswa abulaho outsie mwihe; okhuba oburima bwanje buli khubunji bwabwe bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.14",
            "verseOrgIds": [
              "EZK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elwanyi, olukanga luliho; mukari, oluumbe neinzala bilimwo; ouli mumukunda alafwa khulwa olukanga; ne ouli mwitaala, inzala noluumbe bilamumalilana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.15",
            "verseOrgIds": [
              "EZK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaleehonokokha khubo balaba khutsingulu shinga amahusi akomwibanda nibeekhuula bosi, buli mundu khubumayaanubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhono kosi kalatubukha, amasikamo kosi nikakwa shinga amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleeboha tsingubo tsiamakunia, ne indenga yilabafuunikha; tsisoni tsilaba mumoni mwabwe mwosi, nokhumirwe nibali mulubeko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.18",
            "verseOrgIds": [
              "EZK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balasukuna tsifeetsa tsiabwe khunjila, kata tsitsahaabu tsiabwe tsilaba shinga eshiobukaali; tsifeetsa tsiabwe netsitsahaabu tsiabwe shitsilanyala okhubahonia khunduukho yoburima bwOMWAMI, kata shitsilanyala okhubeekusia kata okhwitsusia tsinda tsiabwe ta. Okhuba nitsio etsialinji eshiisichirasio shiobumayaanu bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.19",
            "verseOrgIds": [
              "EZK.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshiisiaho shiashio shieing'oono bashikalula obwikhulumamii; nibashikhola ebifwanani biebisinyo biabwe nebiemisilo chiabwe; ne niko akachila ndashibakwisilia eshiobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.20",
            "verseOrgIds": [
              "EZK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalashihaana mumakhono kabasuku shibe eshioluyiitsi shiabwe, kata khubabii beshialo shibe eshiyaayo; nabo balashionoonia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.21",
            "verseOrgIds": [
              "EZK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalashiukhana nimbarusiakhwo tsimoni, nabo baloonoonia habundu wanje ahakoosii; kata abanyaka baleenjilamwo nibahoonoonia.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.22",
            "verseOrgIds": [
              "EZK.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.22",
            "verseOrgIds": [
              "EZK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yiraanya omunyololo; okhuba eshialo shiitsuulemwo ebikhole ebibii biamabanga; litookho niliitsulamwo amahababa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.23",
            "verseOrgIds": [
              "EZK.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwako ndalaleera abandu abokhubamahanga abashila obubii, okhulia tsinzu tsiabwe; ndalaakamia obwichinjimisii bwabamaani; ne habundu wabwe ahatakatifu haloonoonibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.24",
            "verseOrgIds": [
              "EZK.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indengusia yiitsanga; balakhaaba omulembe, ne shikulabaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.25",
            "verseOrgIds": [
              "EZK.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaraba kalalonda khumaraba kandi; akaboolwa kalalonda khukaboolwa; balakhaaba libisulo khumunabii; nebutswa amalako kalasishila khumukuhani, nobuchesiyii khubakofu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.26",
            "verseOrgIds": [
              "EZK.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi yeekhuula; omukhulundu afwimbwakhwo okhufwamwoyo; nabo abandu beshialo, amakhono kabwe katubukha. Ndalabakholela akahela tsinjila tsiabwe, nimbayaasia shinga olwa kabakhoyela; nabo balamanya mbu isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.27",
            "verseOrgIds": [
              "EZK.7.27"
            ]
          }
        }
      ]
    }
  ],
