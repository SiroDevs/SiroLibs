      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 48:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Ameera ketsimbia tsana ngakano; mbu okhuchaachila enotsi, khunjila yeHetsiloni, okhuula khubwinjililo bweHamatsi, nokhuula eHazarienoni, khulwakho lweDamasiko enotsi, haHamatsi, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Dani, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.1",
            "verseOrgIds": [
              "EZK.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaDani, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Asheri, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.2",
            "verseOrgIds": [
              "EZK.48.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 48:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaAsheri, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Nafutali, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.3",
            "verseOrgIds": [
              "EZK.48.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 48:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaNafutali, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Manase, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.4",
            "verseOrgIds": [
              "EZK.48.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 48:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaManase, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Efuraimu, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.5",
            "verseOrgIds": [
              "EZK.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaEfuraimu, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Reubeni, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.6",
            "verseOrgIds": [
              "EZK.48.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaReubeni, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Yuda, omukabo mulala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 48:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.7",
            "verseOrgIds": [
              "EZK.48.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaYuda, okhurula khulubeka Iwebukwe okhuula mumbo, halabeho habundu aha mulaahula, ahachelwa obuchiikha amakhono ebikhumila amakhumi kabili nabiraano, oburambi nibuhelana nende mulala okwokhumikabo tsana, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo; naho habundu ahatakatifu halabe hakari waho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 48:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.8",
            "verseOrgIds": [
              "EZK.48.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 48:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitonye eshiahule tsana eshia mulaahulila OMWAMI shilachelwe oburambi bwashio amakhono ebikhumila amakhumi kabili nabiraano, nobuchiikha ebikhumila amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.9",
            "verseOrgIds": [
              "EZK.48.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 48:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitonye eshiahule eshitakatifu shilabe khulwa abakuhani; shilachelwe elubeka Iwenotsi amakhono ebikhumila amakhumi kabili nabiraano, mumbo ebikhumila ekhumi obuchiikha, ebukwe ebikhumila ekhumi obuchiikha, esautsi ebikhumila amakhumi kabili nabiraano oburambi; naho habundu ahatakatifu hOMWAMI halaba hakari washio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.10",
            "verseOrgIds": [
              "EZK.48.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 48:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilabe khulwa abakuhani abaahule, abokhubaana baZadoki, abalindanga aka ndabaleshela; abalekha okhushiama olwa abaana baIsiraeli bashiama, shinga abaLawi olwa bashiama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilababeela eshitonye eshiahule eshirula khushitonye eshiahule shieshialo, mbu eshindu eshitakatifu muno eshirondokhaane nolwakho lwabaLawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 48:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi aharondokhaane nolwakho lwabakuhani, abaLawi nabo balabe neshitonye eshichelwa oburambi amakhono ebikhumila amakhumi kabili nabiraano nobuchiikha ebikhumila ekhumi; oburambi bwosi bulabe ebikhumila amakhumi kabili nabiraano, nobuchiikha ebikhumila ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.13",
            "verseOrgIds": [
              "EZK.48.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barakhashikusia kata okhushikulaasia ta; kata ebirongole bieliloba lino elishila obulayi, birakhabira bitsie khuwundi ta; okhuba nebitakatifu khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 48:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.14",
            "verseOrgIds": [
              "EZK.48.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 48:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitonye eshitong'a, eshiobuchiikha ebikhumila biraano noburambi ebikhumila amakhumi kabili nabiraano, eshio shilabe khulwa amakhuwa akarali amatakatifu ta; mbu khulwa litookho, nende ebimenyo, nende obwayilo; nalio litookho lilabe hakari washio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.15",
            "verseOrgIds": [
              "EZK.48.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 48:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilachelwe liri nanwa; mbu elubeka Iwenotsi amakhono ebikhumila bine ebikhumi biraano, elubeka Iwesautsi ebikhumila bine ebikhumi biraano, elubeka Iwebukwe ebikhumila bine ebikhumi biraano, nelubeka lwamumbo ebikhumila bine ebikhumi biraano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.16",
            "verseOrgIds": [
              "EZK.48.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 48:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litookho lilabe nobwayilo bwalio; enanotsi amakhono ebikhumi bibili namakhumi karaano, enasautsi ebikhumi bibili namakhumi karaano, enabukwe ebikhumi bibili namakhumi karaano, namumbo ebikhumbi bibili namakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.17",
            "verseOrgIds": [
              "EZK.48.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 48:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabwo oburambi obushitong'a, okhuleng'aasia neshitonye eshiahule eshitakatifu, bulachelwe amakhono ebikhumila ekhumi enabukwe nende ebikhumila ekhumi mumbo, oburondokhananeshitonye eshiahule eshitakatifu; nebirulamwo nabio bilabeetsenje ebiliibwa biabakholi abomwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.18",
            "verseOrgIds": [
              "EZK.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 48:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakholi abomwitookho, abarulanga mumbia tsiosi tsiaIsiraeli, nibo abalashilime. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.19",
            "verseOrgIds": [
              "EZK.48.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitonye eshiahule shios; shilachelwe amakhono ebikhumila amakhumi kabili nabiraano elubeka nebikhumila amakhumi kabili nabiraano elubeka, tsimbeka tsiosi tsine, mbu eshitonye eshiahule eshitakatifu halala nende omwandu kwelitookho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 48:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.20",
            "verseOrgIds": [
              "EZK.48.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 48:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshitong'a shiosi shilabe shiomwami weshialo, elubeka eyi nende eyi Iweshitonye eshiahule eshitakatifu, nolwomwandu kwelitookho; shilarondokhane namakhono ebikhumila amakhumi kabili nabiraano tsana akeshitonye eshiahule okhuula khulwakho Iwebukwe, nende enamumbo okhurondokhana namakhono ebikhumila amakhumi kabili nabiraano okhuula khulwakho lwamumbo, nishileng'aana nemikabo tsana; nishiba shiomwami weshialo; ne eshitonye eshitakatifu neihekalu bilabe hakari washio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.21",
            "verseOrgIds": [
              "EZK.48.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omwandu kwabaLawi nomwandu kwelitookho chilabe hakari wa echio echili chiomwami weshialo, echili hakari wolwakho lwaYuda nolwakho lwaBenyamini, echili chiomwami weshialo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 48:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.22",
            "verseOrgIds": [
              "EZK.48.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 48:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aketsimbia etsishitonga ngakano; mbu okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Benyamini, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaBenyamini okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Simeoni, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaSimeoni, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Isakhari, omukabo mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aharondokhana nolwakho lwaIsakhari, okhurula khulubeka Iwebukwe okhuula khulubeka lwamumbo, mbu Zabuloni, omukabo mulala. ",
          "type": "text",
