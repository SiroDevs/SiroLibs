    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyambila habwelu, nachela emisiilo, mbu amakhono kasasaba obukali bwachio, elubeka eyi nende eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwinjililo nabwo bwahela amakhono ekhumi obubambalifu bwabwo; amasiisi kobwinjililo elubeka eyi nende eyi kahel; amakhono karaano karaano; nachela nende oburambi bwene, mbu amakhono amakhumi kane, nobuchiikha amakhono amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeenjila mushisika eshiomukari, nachela buli kusiilo kwobwinjililo, mbu amakhono kabili; nobwinjililo bwene, amakhono kasasaba; namasiisi kobwinjililo elubeka eyi nende eyi, amakhono musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachela nende oburambi bwene, mbu amakhono amakhumi kabili, nibuchiikha amakhono amakhumi kabili, hambeli muhekalu; niyasunjila mbu Hano niho habundu ahashila obutakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachela lisiisi lieihekalu, mbu amakhono kasasaba; nende ebisika bielubeka, obuchiikha bwabio amakhono kane, nibibotokhana ihekalu tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisika bielubeka tsana bianzwa obwelu butaru, obundi hekulu khubundi, ebisika amakhumi kataru khubuli bwelu. Tsialiho tsinungo heesiisi lieihekalu, okhuleeta ebisika tsana bielubeka, tsimbeka tsiosi, bileshe okhuleetelelwa khwisiisi lieihekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisika bielubeka nabio biameetekhanga obuchiikha bwabio, buli bwelu bwahekalu nibushila obwemwalo, shinga tsinungo tsana olwa tsiameetekhanga, obwelu buli bwelu, muhekalu tsimbeka tsiosi; ne hahekalu elubeka kaliho amaniinilo akatsia hekului wakhanyala okhuniina okhurula khubwelu bwahasi okhuula khubwahekulu nobirila mubwelu bwahakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalola mbu ihekalu yabotokhasibwa omukuru omwichingu; omuse kwebisika tsana bielubeka kwahela litundu lilamba, mbu amakhono amarambi kasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obubambalifu bwelisiisi lielwanyi liebisika bielubeka bwahela amakhono karaano; ne eshitonye shiomukuru tsana eshiasikala habisika bielubeka bieihekalu shiahela amakhono karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elwanyi webisika ebio bwaliho obwiyanga bwamakhono amakhumi kabili, obubotokhana ihekalu tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiliango chiebisika bielubeka biahenga omukuru okwali nikutong'ile omukhaya, omuliango mulala nikuhenga enotsi, omuliango kundi nikuhenga esautsi; nakwo omukuru okwali nikutong'ile omukhaya kwahela amakhono karaano tsimbeka tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuumbakho okwali imbeli wolwanyi elubeka lwamumbo kwahela amakhono amakhumi musaafu obuchiikha; lisiisi liomuumbakho tsana liahela amakhono karaano obubambalifu tsimbeka tsiosi, oburambi bwayo nibuhela amakhono amakhumi shienda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachela ihekalu yene, mbu amakhono eshikhumi oburambi bwayo; nolwanyi Iweihekalu, nomuumbakho tsana, halala nelisiisi liakwo, amakhono eshikhumi oburambi bwabio; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobuchiikha bweihekalu elubeka Iwebukwe, halala nolwanyi lwayo, amakhono eshikhumi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachela oburambi bwomuumbakho okwali imbeli wolwanyi Iweihekalu elubeka lwamumbo, nelisiisi liakwo eyi nende eyi, amakhono eshikhumi. Obwelu bweihekelu yene, neshisika eshiomukari, neshirookoola shiolwanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nahabwelu obwomubilibwa, nebianzwi tsana ebisunduukha mwisiisi, nelisiisi tsimbeka tsiosi khubwelu obwo butaru, ahahengana nobwelu obwomubilibwa biosi biafuunikhwa tsimbaho tsimbeka tsiosi, okhurula hasi okhuula khubianzwi; nabio ebianzwi nibiikalwa netsikhanda; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula khumuliango hekulu wakwo, nokhuula khushisika shiomukari, nende elwanyi washio. Lisiisi liosi lieshisika shiomukari nende habwelu, liabaatswakhwo ebifwanani ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "biabakerubi nende emishindu, mbu omushindu hakari womukerubi nomukerubi undi. Buli mukerubi yali mumoni shikhabili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumoni mwomundu mwahenga omushindu elubeka eyi, ne mumoni mweitalanyi imbuukha nimuhenga omushindu elubeka eyi. Nindio biabaatswa khuhekalu yosi tsimbeka tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhurula hasi okhuula hekulu womuliango, abakerubi nemishindu biabaatswa birio khwisiisi lieihekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiyindi bieihekalu biali bietsikoona tsine; ne noshili okhuula habundu ahatakatifu, shialiho eshindu eshialolekha ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.21",
            "verseOrgIds": [
              "EZK.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga eshimalilo shiemisango eshietsimbaho, eshiahela amakhono kataru, obuchinguukhu bwashio, noburambi amakhono kabili, nobuchiikha amakhono kabili. Tsikoona tsiayo, neshitonye shiahasi, netsimbeka tsiashio, biali bietsimbaho. Niyasunjila mbu Yino niyo imeesa eyibeetsanga imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.22",
            "verseOrgIds": [
              "EZK.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihekalu yene nahabundu ahatakatifu biombi biali nemiliango echiakholwa shikhabili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
              "EZK.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu emiliango tsana chiali netsinzichi tsibili tsibili tsinzichi tsibili etsishiukhananga; tsinzichi tsibili khulwa omuliango mulala, netsinzichi tsibili khulwa omuliango kundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsinzichi tsieihekalu etsio tsiabaatswakhwo abakerubi nemishindu, shinga ehiabaatswa khwisiisi liosi; ne shialiho eshitsafu shietsimbaho khushirookoola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialiho ebianzwi ebiisunduukha mwisiisi nende ebifwanani biemishindu elubeka eyi nende eyi, khumbeka tsieshirookoola, nokhubisika bielubeka bieihekalu, nokhushitsafu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
              "EZK.41.26"
            ]
          }
        }
      ]
    }
  ],
