    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyasunjila mbu Mwana womundu, sinjila, nasi ndalasungana ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.1",
            "verseOrgIds": [
              "EZK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yasunjila, Roho niyeenjila mwisie, niyasinjisia; nimuhulila oyo owasungana ninasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.2",
            "verseOrgIds": [
              "EZK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyamboolela mbu Mwana womundu, ekhuruma khubaana baIsiraeli, khubamahanga akeinduli, akakholela induli; bo nabakuuka babwe bakhayanga kata okhuula khunyanga yino eyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.3",
            "verseOrgIds": [
              "EZK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abolwibulo luno nabo babula oburii, nibali abemirwe emiumu; ne nibo aba ekhurumakhwo; olabasunjilanga mbu Kano niko aka Omwami NYASASE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.4",
            "verseOrgIds": [
              "EZK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo, kata nibaba nibafuchiilila okhuhulila kata nibakhaya, okhuba neinzu yeinduli, okhuunanya balamanya mbu omunabii yabeelenje hakari mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.5",
            "verseOrgIds": [
              "EZK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, orabariitsanga kata okhuria amakhuwa kabwe ta; kata olwa oli mumarakalu namahwa, niwikhaale mumakatia; oraria amakhuwa kabwe, kata okhufwa omwoyo khulwa okhulolekha khwabwe ta, kata olwa baba abeinzu yeinduli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olababoolelanga amakhuwa kanje, kata nibaba nibafuchiilila okhuhulila kata nibakhaya; okhuba nabeinduli muno.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
