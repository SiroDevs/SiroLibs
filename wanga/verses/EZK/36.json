      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Khunyanga olwa ndalamusiiya obumayaanu bweenywe bwosi, ndalachila amataala kamenywemwo, amakunda nako nikoombakhwamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.33",
            "verseOrgIds": [
              "EZK.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo eshiali eshikhaya shilalimwa, eshialinji eshikhaya kuru mumoni tsiababiri bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.34",
            "verseOrgIds": [
              "EZK.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo balasunga mbu Eshialo shino eshialinji eshikhaya shieekalula shiba shinga omukunda kwaEdeni; nako amataala akakwa amakunda, amakhaya kuru, akalikululwa, kaswalilwa tsingoba nikamenywamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.35",
            "verseOrgIds": [
              "EZK.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amahanga ako akasikaale, akamubotokhana, kalamanya mbu isie OMWAMI enyumbaashe buli hosi ahalikululwa, niraaka ahali ahakhaya; isie OMWAMI nisie ouboolile; ne ndalakhola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.36",
            "verseOrgIds": [
              "EZK.36.36"
            ]
          }
        }
      ]
    },
