    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isiraeli yilekalusibwa habwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana womundu, lakulila tsingulu tsiaIsiraeli, nosunga ori Inywe tsingulu tsiaIsiraeli, hulile likhuwa liOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.1",
            "verseOrgIds": [
              "EZK.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Okhuba omusuku wakhufukula nasunga mbu Ngako! Khandi mbu Khuliile habundu hosi aheechingu hakhale! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.2",
            "verseOrgIds": [
              "EZK.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako olakule, nosunga ori Kano niko aka Omwami NYASAYE aboola; mbu Shichila lole, shichila bamukwisia likunda, nibamutubanjila tsimbeka tsiosi, mbu mukwe omwandu khumahanga akasikaale, nimurumbukha mumbakha tsiabandu, mukhufuma okhubii; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.3",
            "verseOrgIds": [
              "EZK.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwako, inywe tsingulu tsiaIsiraeli, hulile likhuwa liOmwami NYASAYE; kano niko aka Omwami NYASAYE aboolela tsingulu nebikulu; aboolela emichela namabanda; aboolela ebitsiimi ebikhaya namakunda akalekhwa, mbu biosi ebikwile eshioluyiitsi neshiokhutseshelelwa mumahanga akasikaale, akamubotokhaane; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.4",
            "verseOrgIds": [
              "EZK.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akaakachila kano niko aka Omwami NYASAYE aboola; mbu Toto mwene, mukhuyia khweimbalikha yanje ndaboolile nifukula amahanga akasikaale, nifukula nende Edomu yosi, abeebukuliile eshialo shianje shibe omwandu kwabwe, nokhwikhoya muno khwomumwoyo nende okhuleka okhunji, okhushikwisia eshioluyiitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.5",
            "verseOrgIds": [
              "EZK.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khulwako rumbula akeshialo shiaIsiraeli, nosunjila tsingulu nebikulu, nemichela namabanda, ori Kano niko aka Omwami NYASAYE aboola; mbu Lole, ndaboolile mumbalikha yanje nomubululu bwanje shichila mweetuukha tsisoni tsiamahanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.6",
            "verseOrgIds": [
              "EZK.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne niko akachila kano niko aka Omwami NYASAYE aboola; mbu Toto mwene, amahanga akamubotokhana akeene kaleetuukha tsisoni tsiako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.7",
            "verseOrgIds": [
              "EZK.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa inywe, tsingulu tsiaIsiraeli, mularusia tsisaka tsieenywe, nimwama ebiamo bieenywe, khulwa abandu banje Isiraeli, shichila beetsanga, bali ahambi okhuula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.8",
            "verseOrgIds": [
              "EZK.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lole, endi khulweenywe; ndalamushiukhanila, neenyu mulalimwa nimuraakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.9",
            "verseOrgIds": [
              "EZK.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndaleenjiyia abandu khwinywe, mbu inzu yosi yaIsiraeli, yosi pe; amataala nako kalamenywamwo, amakunda nikoombakhwamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.10",
            "verseOrgIds": [
              "EZK.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaleenjiyia khwinywe abandu; balameetekha nibeebulana; nende emiruko chirio. Khandi ndalachila nimumenywamwo shinga khale; kata ndalamukholela amalayi akashila akali akambeli; mana mulamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.11",
            "verseOrgIds": [
              "EZK.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, ndalachila abandu nibamuchendakhwo, mbu abandu banje Isiraeli; balakhulia, nawe olaba obulaame bwabwe; kau shibalafwilwa abaana khululwo khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.12",
            "verseOrgIds": [
              "EZK.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Shichila bakhusunjila mbu Iwe eshialo, oli omumalabandu; ochilanga lihanga lieenywe nilifwilwa abaana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.13",
            "verseOrgIds": [
              "EZK.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila shiolaba omumalabandu khandi, kata okhuchila lihanga lieenywe nilifwilwa abaana khandi ta, Omwami NYASAYE aboola; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.14",
            "verseOrgIds": [
              "EZK.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shindalakhuhulilisia khandi aketsisoni tsiamahanga, kata shioleetuukha okhuseywa khwabandu khandi, kata okhwisichirasia lihanga lieenywe khandi ta; Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.15",
            "verseOrgIds": [
              "EZK.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.16",
            "verseOrgIds": [
              "EZK.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, olwa abeinzu yaIsiraeli bali nibamenyanga mushialo shiabwe, bashionoonia khulwa injila yabwe nebikhole biabwe; inyila yabwe imbeli wanje yeenga shinga obukaali bwomukhasi ouli mwibilu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.17",
            "verseOrgIds": [
              "EZK.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila ndabasundulila obululu bwanje, khulwa amatsayi aka bali nibasunduule khushialo, khandi shichila bashionoonia nemindu chiabwe tsana echia beenamilanga; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.18",
            "verseOrgIds": [
              "EZK.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbasalaasia mumahanga, nabo nibakabulwa mubialo; injila yabwe nebikhole biabwe shinga olwa biali, nindio ndabayaasia endio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.19",
            "verseOrgIds": [
              "EZK.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa boola mumahanga tsana, ewa batsiitsanga hosi hosi, boonooniliayo eliira lianje litakatifu; okhuba abandu basunga khukabwe, mbu Bano nibo abandu bOMWAMI, abarula mushialoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.20",
            "verseOrgIds": [
              "EZK.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndabeeleelela eliira lianje litakatifu, elia abeinzu yaIsiraeli bali nibalionoonilia mumahanga ewa batsiitsanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.21",
            "verseOrgIds": [
              "EZK.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, obasunjile abeinzu yaIsiraeli ori Kano niko aka Omwanli NYASAYE aboola; mbu Shikholanga kano khulweenywe ta, inywe abeinzu yaIsiraeli, habula khulwa eliira lianje litakatifu, elia mwoonoonilia mumahanga ewa mwatsiitsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.22",
            "verseOrgIds": [
              "EZK.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalalolosia obutakatifu bweliira lianje likhongo, eliayoonoonilibwa mumahanga, elia mwoonoonilia hakari wako; nako amahanga kalamanya mbu isie nisie OMWAMI, olwa ndalalolosia obutakatifu bwanje mwinywe imbeli wetsimoni tsiabwe; nilwo olwa Omwami NYASAYE aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.23",
            "verseOrgIds": [
              "EZK.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndalamuyinia mumahanga, nimukhung'aasia okhurula mubialo biosi, nimwinjisia mushialo shieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.24",
            "verseOrgIds": [
              "EZK.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamwohela amatsi amalafu, neenyu mulasiiyikha; ndalamurusiakhwo eshifwabwi shieenywe shiosi, nemindu tsana echia mwinamilanga, nimusiiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.25",
            "verseOrgIds": [
              "EZK.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamuheelesia omwoyo omuyia, nira mwinywe roho imbia; ndalayinia omwoyo kwelichina okuli munyama yemibili chieenywe, nimuheelesia omwoyo kweinyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.26",
            "verseOrgIds": [
              "EZK.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalara roho wanje mukari mwinywe, nimuchesia mumalako kanje; mulalindanga akobukhalachi bwanje nimukakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.27",
            "verseOrgIds": [
              "EZK.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulamenya mushialo eshia ndaheelesia abakuuka beenywe; mulaba abandu banje, nasi ndalaba Nyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.28",
            "verseOrgIds": [
              "EZK.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamuhonia mubukaali bweenywe bwosi; ndalalanga imele yiitse, ninjiinjiyia, oburamurakhwo inzala ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.29",
            "verseOrgIds": [
              "EZK.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaleenjiyia ebiamo ebiokhumisaala, namameeto akemikunda, mbu muleshenje okhuseywa khulwa inzala mumahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.30",
            "verseOrgIds": [
              "EZK.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana muleetsulila tsinjila tsieenywe tsimbii, nebikhole bieenywe ebiralinji ebilayi ta; muleesinya abeene mumoni tsieenywe khulwa obumayaanu bweenywe nokhulwa ebisinyo bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.31",
            "verseOrgIds": [
              "EZK.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami NYASAYE nasunga mbu Ne mumanye mbu shikholanga kano khulweenywe ta. Mufwimbwe omurwe nimukoyaasibwa khulwa tsinjila tsieenywe, inywe abeinzu yaIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.36.32",
            "verseOrgIds": [
              "EZK.36.32"
            ]
          }
        }
      ]
    },
