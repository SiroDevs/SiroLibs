              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwekhumi nalulala, mumwesi kwakhataru nikuli lulala, likhuwa liOMWAMI nilinzitsila, liri ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.1",
            "verseOrgIds": [
              "EZK.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana womundu, sunjila Farao omuruchi waMisiri nomukanda kwosi kwabandube ori",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.2",
            "verseOrgIds": [
              "EZK.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka Omwami NYASAYE aboola; mub Okhuba kwachinguukha muburambi bwakwo, nikuusia obutenje bwakwo mumaleesi, omwoyo kwakwo nikwichinjimisia khulwa oburambi bwakwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndalakuhaana mumukhono kwowamaani mumahanga; ye alakukholela akakhoyeele obumayaanu bwakwo; isie engwibalile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasuku, abamariisia mumahanga, balakurema nibakulekha; tsisaka tsiakwo tsilalakakha mubikulu nomumabanda kosi, amasaka nako nikakona nikafunakwa khumichela chiosi chieshialo; natsio tsimbia tsiosi tsiabandu abomushialo tsilarula mushiinikha shiakwo nitsikulekha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanyonyi kosi akokhwikulu kaIamenya khushirundu shiakwo, natsio tsisolo etsiomubulimo tsilaba khutsisaka tsiakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalaba kario mbu mana omusaala kwosi kwosi okuli hamatsi kuleshe okhuchinguukha oburambi bwakwo, kata okhwinjisia obutenje bwakwo mumaleesi, kata mbu omusaala kwosi okunyweetsanga amatsi kuleshe okhusinjila khuburambi bwakwo; okhuba chiosi chiahaanwa khuluumbe, khushialo shiahasi, mubandu nabandu, halala nabeenabo abeekha muBuko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Omwami NYASAYE aboola; mbu Khunyanga olwa kuleekha kutsie eMakombe ndalachila eshitungu shikulilila amasika, ninzikalila emialo eminji, nisinjisia emichela eminji nikhola Lebanoni eshiilima khulwakwo, nemisaala chiosi chiebulafu nichihweleelela khulwakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.15",
            "verseOrgIds": [
              "EZK.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalachila amahanga nikatechela khubuyoka bwokhukwa khwakwo olwa ndalakukwisia eMakombe nabeenabo bosi abeekha nibatsia muBuko; nachio emisaala chiosi chieEdeni, emilobole emilayi chieLebanoni, mbu chiosi echinyweetsanga amatsi, nichilemibwa omwoyo mushialo shiahasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.16",
            "verseOrgIds": [
              "EZK.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi baleekha nibatsia eMakombe ninakwo, khubeenabo abeerwa nolukanga; kata nende abo abali nibamenyanga mushiinikhashie hakari wamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niwina owa ofwanana ninaye muluyali nomubukhongo mumisaala chieEdeni? Nebutswa oleesibwa hasi halala nemisaala chieEdeni, khushialo shiahasi. Olakona hakari wabasinde, halala nende abo abeerwa nolukanga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
    }
