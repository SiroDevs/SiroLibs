          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka Omwami NYASAYE aboola; mbu Olwa ndalakhukwisia likunda, shinga amataala akaramenywamwo ta; olwa ndalayembia amatsi akolusiba khwiwe, amatsi amanji nikakhufuunikha; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwenaho ndalakhwisia halala nende abo abeekha mubuko, khubandu bakhale, nikhumenyia mushialo musi bwene, mumakunda kakhale muno, halala nende abo abeekha mubuko, mbu oleshe okhumenywamwo kata okhuba neing'oono mushialo shiabali mwoyo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalakhukwisia owamariisia, kata shiolabaho khandi ta; kata nokhaabwa orie, shiolanyoolekha khandi ta, Omwami NYASAYE aboola.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
