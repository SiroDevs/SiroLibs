      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omunabii yafwimbuliwa ing'oono yoluyali lwaNyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kataru, mumwesi kwakhane nikuli kharaano, olwa ndali nindi mubandu abaarwa hamwalo kwaKhebari, likulu lieekukha, nasi nindola amabisulo kaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yakharaano eyomumwesi okwo, mumuyika kwakharaano kwobwarwi bwomuruchi Yehoyakhini, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "likhuwa liOMWAMI lianzitsila isie, Ezekieli omukuhani, omwana waBuzi, mushialo shiabaKalidayo, hamwalo kwaKhebari; ebweneyo niyo ewa omukhono kwOMWAMI kwabeela khwisie.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ndahenga, lola, omuyeka kweimbumbuyeka ngwokwo, nikurula enotsi, nelileesi likhongo, nomulilo okulabukhanga, nokhwakha tsimbeka tsiosi; nokhurula hakari mukwo, okhwengana okhung'inang'ina khwomukasa okhurula hakari mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana okhurula hakari mukwo nimurulamwo okhufwana khwebili-mwoyo bine. Okhulolekha khwabio khwali khuri nanwa, mbu biali khwikondo liomundu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shilala shiali nende mumoni mwashio eshikhane, khandi buli shilala shiali netsimbaha tsine. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebilenje biabio biali ebikololofu; lilaaro lieene lieshilenje lieengana lilaaro lieshilenje shieshimoosi; nibing'inang'ina shinga omukasa okwaruutwa muno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi wetsimbaha tsiabio, tsimbeka tsiabio tsiosi tsine, biali namakhono shinga akomundu; ebio bine biali nende mumoni mwabio netsimbaha tsiabio biri nanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu tsimbaha tsiabio tsioongana, olundi khulundi; shibiashiukhana nibitsia ta; nebutswa buli shilala shiachooma imbeli eshilunji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumoni mwabio mwafwana shinga omwomundu imbeli; ebio bine biali nende mumoni mweitalanyi khulubeka Iwomukhono musaatsa; ebio bine biali nende mumoni mweing'ombe khumukhono mukhasi; khandi ebio bine biali nende mumoni mweinditsu emukongo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa biali mumoni; tsimbaha tsiabio natsio tsiali nitsibambuushe ikulu; tsimbaha tsibili etsia buli shilala tsioongana, netsindi tsibili tsiafuunikha emibili chiabio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biali nibitsiitsanga imbeli, buli shilala shilunji; ewa roho yenya okhutsia, biatsia birio; kata shibiashiukhanakhwo nibitsia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne hakari webilimwoyo tsana, shialiho eshialolekha shinga amaanda komulilo akaang'alaale, shinga okhulolekha khwebitseso; nishitsia eyi nende eyi hakari webilimwoyo tsana; nakwo omulilo nikwakha muno; nokhurula mumulilo mwarulamwo tsimbenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio ebili-mwoyo bieelukhanga nibikalukha shinga oluhenu niluhenukha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa ndali nihenga ebili-mwoyo tsana, ndalola omukurutumu mulala khushialo ahambi nende ebili-mwoyo, mbu mulala khulwa buli shilala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhulolekha khwemikurutumu nokhukasibwa khwachio, chiafwana shinga okhung'inang'ina khweitarashishi; echio chine chiali nokhufwana khulala; okhulolekha khwachio okhukasibwa khwachio khwafwana shinga omukurutumu hakari mumukurutumu kundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa chiatsia, chiatsiitsanga khulubeka olwomumbeka tsiachio tsine; ne chiashiukhana nichitsia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echio chine chiali netsirimu tsiachio; ninzihenga, nindola mbu tsirimu etsio tsieetsula tsimoni tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ebilimwoyo ebio biatsia, emikurutumu nachio nichitsia halala ninabio; kata olwa ebilimwoyo biachinguulwa okhurula khwiloba, emikurutumu nachio chiachinguulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewa roho yenya okhutsia, nabio nibitsianachio emikurutumu niehichinguulwa elubeka lwabio; shichila roho yebili-mwoyo tsana yali mumikurutumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa bilia biatsia, chilia nachio nichitsia; olwa bilia bieema, chilia nachio nichiema; olwa bilia biachinguulwa okhurula khwiloba, emikurutumu nachio nichichinguulwa elubeka lwabio; shichila roho yebilimwoyo tsana yali mumikurutumu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikulu wemirwe chiebilimwoyo khwaliho okhufwana khweshilama eshibambukhu muno, shinga obukondo obung'inang'inu bweibarafu, eshiamariisia, eshibambulwa khumirwe chiabio ikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasi weshilama tsana tsimbaha tsiabio tsiakololosibwa, olundi niluchooma khulundi; buli shiala shiali netsimbaha tsibili etsiafuunikha omubili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa biatsia, ndahulila amayoosi ketsimbaha tsiabio, shinga amayoosi kamatsi amanji, shinga okhukukuma khwa Oyo Ounyala Biosi, amayoosi keindiri shinga amayoosi kelihe; ne olwa bieema, bieesia tsimbahatsiabio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwoyo kundi nikurula ikulu weshilama tsana eshiali ikulu wemirwe chiabio; ne olwa bieema, bieesia tsimbaha tsiabio.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne hekulu weshialo eshiali ikulu wemirwe chiabio, khwaliho okhufwana khweshifumbi, shinga okhulolekha khwelichina lieisapiri; ne khukhufwana khweshifumbi tsana khwalikhwo eshilolekha shinga okhufwana khwomundu, hekulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindola okhurula khushialolekha shinga eshishienjeshie nokhutsia ikulu, okhufwana khwokhung'inang'ina khwomukasa, nokhulolekha khwomulilo mukari netsimbeka tsiosi; khandi okhurula khushialolekha shinga eshishienjeshie nokhutsia hasi, nindola eshifwana shinga okhu-lolekha khwomulilo; ne khwaliho okhwakha tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
