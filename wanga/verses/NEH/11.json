          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "eZenoa, eAdulamu, namataala kalio; eLakhishi nemikunda chialio; eAzeka nebisoma bialio. Kho nibakhupa tsikambi okhurula eBeerisheba okhuula khwibanda liaHinomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
