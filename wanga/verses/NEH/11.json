    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abamenyanga muYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abakhulundu babandu bamenyanga eYerusalemu; nabo abandu abarali abakhulundu ta nibakhupa ikha, mbu mulala khwikhumi aleerwe okhumenya eYerusalemu litookho litakatifu, abandi shienda khwikhumi nibamenya mumataala. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nibabasabila ikhabi abeenabo abeehaana okhumenya eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bano nibo abeemilisibolukongo, abamenya eYerusalemu; ne mumataala kaYuda, buli mundu yamenya mundalotsie mumataala kabwe, mbu Isiraeli, nabakuhani, nabaLawi, nabasumba abomuhekalu, nabaana babasumba baSulemani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abandi abokhubaana baYuda nabokhubaana baBenyamini nabo nibamenya eYerusalemu; khubaana baYuda; Atsaya waUzia waZakaria waAmaria waShefatia waMahalaleli, owokhubaana baFaresi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Maaseya waBarukhi waKolihoze waHazaya waAdaya waYoyaribu waZakaria, omwana womuShela. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baFaresi bosi abamenya eYerusalemu bali ebikhumi bine amakhumi kasasaba namunaane, abandu beitswoni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baBenyamini mbabano; mbu Salu waMeshulamu waYoedi waPedaya waKolaya waMaaseya waItsieli waYeshaya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabamulonda, mbu Gabai, Salai, ebikhumi shienda amakhumi kabili namunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoeli waZikhiri yali omunyapara wabwe; Yuda waHasenua nali owakhabili khwitookho.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubakuhani; Yedaya waYoyaribu, Yakhini, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seraya waHilikia waMeshulamu waZadoki waMerayotsi waAhitubu, owasinjilila inzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana babwe abakhola emilimo echiomunzu, ebikhumi munaane amakhumi kabili nababili; na Adaya waYerohamu waPelalia waAmuz waZakaria waPashuri waMalikhiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende abaana babwe, abeemilisi bebilibwa, ebikhumi bibili amakhumi kane nababili; na Amashisai waAzareli waAhizai waMeshilemotsi waImeri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana babwe, abalulu beitswoni, eshikhumi amakhumi kabili namunaane; ne omunyapara wabwe yali Zabudieli waHagedolimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "NokhubaLawi; Shemaya waHashubu waAzirikamu waHashabia waBuni; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "naShabetsai naYozabadi, abokhubeemilisi babaLawi, abasir njilila emilimo chielwanyi chienanzu yaNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naMatania waMika waZabudi waAsafu, owali omwimilisi owokhureleesia akokhuupa orio mukhasaaya, naBakibukia owakhabili mubaana babwe; nende Abuda waShamua waGalali waYedutsuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaLawi bosi abomwitookho litakatifu bali ebikhumi bibili amakhumi munaane nabane.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abalindi bebilibwa, mbu Akubu, naTalimoni, nabaana babwe, abalindanga ebilibwa, bali eshikhumi amakhumi musaafu nababili. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandi baIsiraeli, nababakuhani, nabaLawi, bali mumataala kaYuda, buli mundu mubulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abasumba abomuhekalu bali nibamenya eOfeli; nabo Ziha naGishipa basinjilila abasumba abomuhekalu abo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omunyapara wabaLawi eYerusalemu yali Uzi waBani waHashabia waMatania waMika, owokhubaana baAsafu, abeembi, khumakhuwa keinzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lialiho lilako eliarula khumuruchi khukabwe, nomukabo okwamanyikha okwabeembi, khulwa obuha bwabuli nyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Petsahia waMeshezabeli, owokhubaana baZera waYuda, yachendanga nomuruchi mumakhuwa kosi akali kabandu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abamenyanga elwanyi weYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumakhuwa kamataala nemikunda chiako, abandi abokhubaana baYuda bamenya eKiriatsi-araba nomubisoma bialio, neDiboni nebisoma bialio, neYekabuZeeli namataala kalio, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eYeswa, eMolada, neBetsi-peleti; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eHazari-shuali, ne Beerisheba, nebisoma bialio; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
