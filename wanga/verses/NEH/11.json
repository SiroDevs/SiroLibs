          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baBenyamini nibamenya eGeba, nokhurula yaho notsia imbeli, eMikhimashi neAiya, nende eBeteli nebisoma bialio; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
