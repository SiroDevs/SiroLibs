              "type": "text"
            }
          ]
        },
        {
          "text": "nende eEni-rimoni, neZora, neYarimutsi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
