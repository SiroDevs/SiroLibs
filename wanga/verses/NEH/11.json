          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "eHazori, eRama, eGitaimu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
