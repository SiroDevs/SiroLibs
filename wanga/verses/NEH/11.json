            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eZikilagi, neMekona, nebisoma bialio; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
