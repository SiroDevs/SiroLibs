            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano khulwako, Nyasaye weefwe, iwe Nyasaye omukhongo, owobunyali, owamariisia, owusinjia indakanoyo nobuheeli oburalilu, amatinyu ako kosi kaleshe okhulolekha shinga amatuutu butswa imbeliwo ta, ako akakhukwiliile ifwe, nabaruchi beefwe, nabakhulundu beefwe, nabakuhani beefwe, nabanabii beefwe, nabakuuka beefwe, kata khubandubo bosi, okhurula khundaalo tsiabaruchi baAshuru okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.32",
            "verseOrgIds": [
              "NEH.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa obeetsanga omulunjishi mukosi akakhukwiliile; okhuba iwe okholanga akobwatoto, habula ifwe khwakhola obubii; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.33",
            "verseOrgIds": [
              "NEH.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata abaruchi beefwe, nabakhulundu beefwe, nabakuhani beefwe, kata abakuuka beefwe, shibalindanga amalakoko, kata okhuhulila amalakoko noburumbusibwo obwa warumbula nobachesiyia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.34",
            "verseOrgIds": [
              "NEH.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shibakhukhalabanila muburuchi bwabwe ta, kata mubulayibwo obunji obwa wabaheelesia, kata mushialo eshikhongo eshinulu eshia wara imbeli wabwe, kata shibayeekalukhasia okhurula khubikhole biabwe ebibii tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.35",
            "verseOrgIds": [
              "NEH.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, khuli abasumba leelo; nashio eshialo eshia waheelesia abakuuka beefwe mbu baliitsenje ebiamo biashio nobulayi bwashio, lola, khuli butswa abasumba mushio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.36",
            "verseOrgIds": [
              "NEH.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashio shibaleerelanga amameeto muno abaruchi abo abo wara hekulu weefwe khulwa ebionoono bieefwe; kata bali nobunyali khumibili chieefwe chiosi, nokhumiruko chieefwe, shinga olwa bachama; neefu khuli mumatinyu muno.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.37",
            "verseOrgIds": [
              "NEH.9.37"
            ]
          }
        }
      ]
    },
