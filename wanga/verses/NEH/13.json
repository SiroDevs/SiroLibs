        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Nehemia yakasia habwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yeneyo nibasooma akomushitabu shiaMusa, abandu nibahulila; nibanyoola nikahandiikwamwo mbu omuAmoni yesi kata omuMoabu, shiyakheenjilakhwo mumukhung'aano kwaNyasaye ta, obushia nobushia; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.1",
            "verseOrgIds": [
              "NEH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila shibayaakaanila abaana baIsiraeli nende ebiekhulia namatsi ta, habula barunga Baalamu okhubalaka eshilaka munwa; nebutswa Nyasaye weefwe yakalula eshilaka munwa shibe ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.2",
            "verseOrgIds": [
              "NEH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibahuliile amalako, beela muIsiraeli zbo bosi abeebulwa nabasuku.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.3",
            "verseOrgIds": [
              "NEH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ako olwa kali nikashili okhwikhola, Eliashibu omukuhani, owali niyareebwaho okhusiDjilila ebisika bieinzu yaNyasaye weefwe, ne nali omwikho waTobia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.4",
            "verseOrgIds": [
              "NEH.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "yali niyamukasilia Tobia eshisika eshikhongo, ewa khale balinji nibareetsangamwo imele yemisango, nobubaane, nebimanulwa, nebitonye bielikhumi bieimele, nebieidivai, nebiamafura, ebiaheebwa abaLawi nabeembi nabalindi bebilibwa, khulwa lilako, nende tsisadaka tsiabakuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.5",
            "verseOrgIds": [
              "NEH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo etsio isie shindali nindi eYerusalemu ta; okhuba mumyika kwamakhumi kataru nakhabili kwaAritashashita, omuruchi waBabeli, ndatsia ewomuruchi; mana olunyuma lwetsindaalo tsindi ndamusaba omuruchi omunwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.6",
            "verseOrgIds": [
              "NEH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninzitsa eYerusalemu, ninyoola amabii aka Eliashibu yali nakholile khulwa Tobia, olwa yamukasilia eshisika munyanyi tsieinzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.7",
            "verseOrgIds": [
              "NEH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi nisinyikha muno, nisukuna elwanyi ebiomunzu biosi biaTobia, okhurula mushisika. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.8",
            "verseOrgIds": [
              "NEH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nindachilisia, nabo nibasiiya ebisika tsana, nasi ningalusiamwo ebimanulwa bieinzu yaNyasaye, nende imele yemisango nobubaane.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.9",
            "verseOrgIds": [
              "NEH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndanyoola mbu emikabo chiabaLawi shichiali nichibakabilungwa ta; ne khulwako abaLawi nabeembi abakhola emilimo bali nibeeluushe buli mundu enamukundakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.10",
            "verseOrgIds": [
              "NEH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyingana nende aboburuchi, nimbareeba mbu Inzu yaNyasaye yalekhwo mbushiina? Nimbakhung'aasia halala, nimbara mumasinji kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.11",
            "verseOrgIds": [
              "NEH.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaYuda bosi nibaleera ebitonye bielikhumi bieimele nebieidivai nebiamafura mumabiishilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.12",
            "verseOrgIds": [
              "NEH.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niraho ababiishi okhusinjilila amabiishilo; mbu Shelamia omukuhani, naZadoki omuhandiichi, ne khubaLawi, Pedaya; nomubeeli wabwe Hanani waZakuri waMatania; okhuba bo bamanyikha mbu nabeesiikwa; ne emilimo chiabwe chiali okhukabilanga abaana babwe emikabo chiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.13",
            "verseOrgIds": [
              "NEH.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wanje, chama unzitsulile khwikhuwa lino, kata orasiliisia ebikhole bianje ebilayi, ebia ekholeele inzu yaNyasaye wanje, nende obukhalabani bwayo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio ndalola muYuda abandi nibaswalilanga mushitiinyilo shieidivai khusabato, nibachinganga ebinywa nibabituukha khutsisi-hili; kata nende idivai, netsinzabibu namakhuyu, nemisiiko chietsimbia tsiosi, echia baleeranga eYerusalemu khunyanga yasabato; nimbarumbulila akobuchesiyii khunyanga yene eyabakusiliakhwo ebiokhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.15",
            "verseOrgIds": [
              "NEH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata bali nibamenyangamwo abeTiro, abaleeranga tsinyeeni nende emiandu chietsimbia tsinyinji, nibabikusia abaana baYuda, nomuYerusalemu, khusabato. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.16",
            "verseOrgIds": [
              "NEH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyingana nende abamakuru baYuda, nimbasunjila mbu Nibii shiina lino elia mukhola, nimwonoonia inyanga yasabato? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.17",
            "verseOrgIds": [
              "NEH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuuka beenywe shibakholanga bario, Nyasaye weefwe naleera amabii kano khwifwe khandi khwitookho lino? Neenyu mumeetanga okhuleerela Isiraeli oburima nimwonoonia isabato.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.18",
            "verseOrgIds": [
              "NEH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.18",
            "verseOrgIds": [
              "NEH.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa bwachaaka okhwila hashilibwa shieYerusalemu, mungoloobe eyiranjilila isabato, ndalaka mbu eshilibwa shiikalwe, nindaka mbu shireekulwa ta okhuula olwa isabato yakhaba niyihweele; kata abandi abokhubasumba banje ndabaraho okhusinjilila ebilibwa, mbu omusiiko kwosi kwosi kuleshenje okhwinjisibwa khunyanga yasabato ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.19",
            "verseOrgIds": [
              "NEH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abeinganga nabahooni bemiandu chietsimbia tsiosi nibakona butswa elwanyi weYerusalemu lulala khabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.20",
            "verseOrgIds": [
              "NEH.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimbarumbulila akobuchesiyii, nimbasunjila mbu Mbushiina nimukonanga halukoba? Nimuba nimukhola murio khandi ndalamuhamba. Nokhurula khushise eshio shibamala beetsekhwo khusabato khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.21",
            "verseOrgIds": [
              "NEH.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindaka abaLawi mbu beesiiye, beetse balinde ebilibwa, okhwahula inyanga yasabato. Nyasaye wanje, chama unzitsulile khwikhuwa lino liosi, niumbonia khulwa obunji bwobuheelibwo oburalilu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.22",
            "verseOrgIds": [
              "NEH.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mundaalo etsio ndalola abaYahudi abali nibaleera abakhasi baAshidodi, nabaAmoni, nabaMoabu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "inusu yabaana babwe nibaboolanga olulimi lwaAshidodi, nibaramanya okhuboola oluYahudi ta, habula olulimi lulala olwomumahanga ako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyingana ninabo, nimbalaka eshilaka munwa, nikhupa abandi khubo, nimbeeha liswi, nimbeetsubia khuNyasaye, mbu Shimulabashila abasiani babwe abakhaana beenywe, kata okhukhweesia abasiani beenywe abakhaana babwe, kata inywe abeene okhubakhwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani omuruchi waIsiraeli shiyayoonoonela mumakhuwa kano? Mumahanga amanji shiyaliho omuruchi undi owingana ye ta; kata yaheelwa naNyasayewe, Nyasaye namwemekha abe omuruchi ouruka Isiraeli yosi; nebutswa kata ye, abakhasi abasuku bachila niyoonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khumuhulilenje, khukhole libii lino likhongo, okhukhaya Nyasaye weefwe nikhuleeranga abakhasi abasuku noho?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
