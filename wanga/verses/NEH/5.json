          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhuhosia khulwa injelesio nikaakamibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho abandu nabakhasi babwe bachaaka okhuupa tsimbungu khumakhuwa kabaYahudi abaana babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba baliho ababoola mbu Ifwe nabaana beefwe abasiani nabakhaana khuli abanji; khunyoolenje imele, khuliitsenje nikhuba mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi baliho ababoola mbu Khusinganga emikunda chieefwe chibe omusingo, nemikunda chiemitsabibu, netsinzu tsieefwe, mbu khukule imele, khulwa inzala eyiliho. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi baliho ababoola mbu Khwiholile amapeesa khumusingo kwemikunda chieefwe, nemikunda chiemitsabibu, mbu khurunje aka omuruchi zkhuroosia. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa emibili chieefwe chiingana emibili chiabaana beefwe, abaana aba khweebula beengana abaana babwe; nebutswa lole, khusandinjia abaana beefwe abasiani nabakhaana, babe abasumba ababohe; kata abandi abokhubakhaana beefwe bamalile okhwinjisibwa mubusandibwi obwo; ne khubula obunyali okhukayinjila; shichila abandu bandi bali nemikunda chieefwe nemikunda chiemitsabibu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi olwa ndahulila tsimbungu tsiabwe nende amakhuwa ako, ndali noburima muno. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyililisia omwene sienyene, nimbeemaalila abam lkuru naboburuchi, nimbaboolela mbu Mubanzanga buli mundu omwana wabwe tsinjelesio. Nikhung'aasia omukhung'aano omukhongo okhubafukula. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbaboolela mbu Ifwe khwakholilenje shinga olwa khunyala, okhununula abaana beefwe abaYahudi abakusibwa mubamahanga. Ne inywe mukusinjia abaana beenywe, mbu bakhukusibwe ifwe! Nabo nibaholeela tsi, nibaraba nelikhuwa liosi elia baboola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimeeta nimboola mbu Eshia mukhola shineshilayi ta; shimukhoyile okhuchendanga nimuria Nyasaye, khulwa amanyeko kabasuku beefwe abamahanga? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa isie nabaana beefwe nabasumba banje khubakhoonyanga namapeesa neimele. Chame khuleshe amakhuwa kano ketsinjelesio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chame mubalkalusilie leelo luno emikunda chiabwe, nemikunda chiemitsabibu, nemikunda chiemitseituni, netsinzu tsiabwe, halala neshitonye shieshikhumi shiamapeesa, neshieimele, neshieidivai, neshiamafura, eshia mubabanzanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakalusia mbu Khulabikalusia, kata shikhulabanzakhwo eshindu ta; khulakhola khurio, shinga olwa oboolile. Mana ninanga abakuhani, nimbeetsubia eshiitsubo, mbu bakhakhola shinga olwa basuubisiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nibungulula tsingubo tsianje, nimboola mbu Nyasaye alabungulula ario okhurula munzuye nokhurula mubunyakhanibwe, buli mundu ouroosia obusuubisiebwe buno ta; abungululwe ario, atong'e omukhaya. Abomukhung'aano bosi nibzsunga mbu Amina; nibamupaaka OMWAMI. Abandu nibakhola akobusuubisie bwabwe shinga olwa bwali.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi okhurula khunyanga olwa ndeemekhwa okhuba kafuna wabwe mushialo shiaYuda, okhurula khumuyika kwamakhumi kabili okhuula khumuyika kwamakhumi kataru nakhabili kwaAritashashita omuruchi, mbu emiyika chiosi ekhumi nachibili, isie nabaana beefwe shikhwaliakhwo ebiliibwa ebikabilungwa kafuna ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abakafuna bakhale abaranjilila bali nibamiinanga abandu, nibabukulanga khubo ebiokhulia nende idivai, khandi nende tsishekeli amakhumi kzne tsieifeetsa; toto, kata nende abasumba babwe bali nibaamihanga khubandu; nebutswa isie shindakholakhwo endio ta, khulwa okhuria Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, khandi ndalumilila okhukhola emilimo chiolukoba tsana, kata shikhwakulakhwo liloba liosi ta; nabo abasumba banje bosi bakhung'aanangayo khumilimo echio. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abandu abokhubaYahudi naboburuchi eshikhumi namakhumi karaano bali nibaliitsanga khumeesa yanje, halala nende abandi balia abakhwitsilanga nibarula mumahanga akakhubotokhana. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio ebiakasilibungwa inyanga ndala biali ing'ombe ndala namakondi amalobole kasasaba; khandi ndakasilibungwa tsingokho, ne lulala mubuli tsindaalo ekhumi, emisiikolo chieidivai yetsimbia tsiosi. Ne kata kario, shindaIaka mbu embeebwe ebiliibwa ebiakabilungwa omukafuna ta, shichila obunyakhani bwasitohela abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye wanje, chama witsulile kosi aka ndakholeele abandu bano, niukholela amalayi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    }
  ],
