      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo isebele yilabaho eyikushiile abeinzu yaDaudi nabamenyanga muYerusalemu, okhubalabia obwonooni nobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.1",
            "verseOrgIds": [
              "ZEC.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunduukho eyo, OMWAMI omwene mahe aboola, ndalaakamia ameera kebifwanani ebiinamilungwa mushialo, kata shikaleetsulilwa khandi ta; khandi ndalarusia mushialo abanabii nende omwoyo kwobukaali. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi naba nachaaka okhulakula, samwana nende nyina abamwibula balamusunjila mbu Okhoyile okhufwa; okhuba oboolanga akobubeeyi muliira liOMWAMI; mana samwana nende nyina abamwibula balamufumira, olwa alakula. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khunduukho eyo, abanabii, buli mulala khubo, alafwimbilwa libisolie omurwe olwa alakula kata shibaleefwala ingubo yobwoya khulwa okhukaatia abandu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa alasunga mbu Isie shindi omunabii ta; endi omulimi womukunda; okhuba liloba libeetsanga omukabo kwanje okhurula khulusooliili lwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omundu alamureeba mbu Ne tsimbala tsino etsili khumubilikwo tsikhali tsirie? Naye alakalusia mbu Etsio nitsio etsia ndafumirwa munzu yabeetsa banje.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhuupwa khwomwayi wOMWAMI",
          "type": "text"
        }
      ]
    }
  ],
