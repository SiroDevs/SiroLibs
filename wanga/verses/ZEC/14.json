    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yerusalemu nende amahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, induukho yindi yOMWAMI yiitsanga, olwa ebia wayaaywa bilakabulilwa hakariwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndalakhung'aasia amahanga kosi okhuseera Yerusalemu lihe; litookho lilabukulwa, netsinzu okhuyaaywa, nabakhasi okhwonoonibwa; inusu yabomwitookho balaatisibwamwo nabo abandu abalaba nibatong'a shibalaakamiiibwa elala mwitookho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI alarula naseera amahanga ako, shinga olwa aseeranga khunyanga yelihe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo ebilenjebie bilasinjila khushikulu shiEmitseituni, eshili hambeli weYerusalemu, ebukwe; nashio eshikulu shiEmitseituni shilaatishila hakari, okhurula ebukwe okhuula mumbo, nilibaho libanda libambalifu; mana eshitonye shieshikulu shileesunda enanotsi, neshindi enasautsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalio libanda lietsingulu tsianje lileekalwa; okhuba libanda lietsingulu lilashitiilakhwo elubeka; neenyu muleelukha shinga olwa mweelukha okhurenga khweshialo mundaalo tsiaUzia omuruchi waYuda; mana OMWAMI Nyasaye weenywe aleetsa, nabatakatifu bosi halala ninaye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo shibulabaho obushindu kata isakitu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khunduukho eyo eshiteere shilaba shilala, eshitsiililila; OMWAMI washimanya; eshiteere nende eshilo ta; okhuba khubwile obulafu bulabaho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khunduukho eyo amatsi amalamu kalarula muYerusalemu; inusu yako kalachooma enanyanza yebukwe, neinusu yako enanyanza yamumbo; kalaba kario murootso khandi mushiubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye OMWAMI alaba omuruchi ouruka eshialo shiosi pe; khunduukho eyo OMWAMI alaba mulala, neliiralie elala. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shiosi shilakwa omuhololookhwe, okhurula eGeba okhuula eRimoni, elubeka Iwesautsi weYerusalemu. Ne Yerusalemu lilatong'a nilichinguushile, habundu walio, okhurula khushilibwa shiaBenyamini okhuula habundu heshilibwa shiambeli, nokhuula khushilibwa shieikoona, khandi okhurula khumunaara kwaHananeli okhuula khubitiinyilo bieidivai biomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu balamenyamwo, ne akeshilaamo shiobubii shikalabakhwoho khandi ta; ne Yerusalemu lilamenya shisale.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oluumbe olwa OMWAMI alakhupa ninaIwo tsimbia tsiosi tsiabandu abaseeranga Yerusalemu ndwoluno; mbu inyama yemibili chiabwe yilabola bubola nibashisinjiile, netsimoni tsiabwe okhubolela mubiikochi mukari, netsinimi okhubolela mumunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.12",
            "verseOrgIds": [
              "ZEC.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunduukho eyo obukoyaasii obukhongo oburula khuMWAMI bulabaho hakari wabwe; buli mundu alatiila owashie omukhono, khandi buli mundu alachinguula omukhono okhuupa owashie; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.13",
            "verseOrgIds": [
              "ZEC.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kata Yuda alaseera Yerusalemu. Obuyinda bwamahanga kosi akabotokhanaho bulakhung'aasibwa halala, mbu itsahaabu, neifeetsa, nebiifwalo, ebinji muno. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.14",
            "verseOrgIds": [
              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oluumbe olufwana lurio lulaba khutsifarasi, nokhutsinyumbu, nokhutsingamia, nokhutsisishili, nokhumiruko chiosi echilaba nichili mukambi etsio.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana buli mundu ouba natong'ile khubamahanga ako akaseera Yerusalemu, alatikulukhanga omuyika buli muyika natsia okhumwinamila Omuruchi, OMWAMI omwene mahe, nokhulia lisabo liamatili. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.16",
            "verseOrgIds": [
              "ZEC.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshilibwa shiosi eshiokhushialo eshiratikulukha shitsie eYerusalemu okhwinamila Omuruchi, OMWAMI omwene mahe, ifula shiyilabakwila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata eshilibwa shiaMisiri nishiba nishiratikulukha shiuleyo ta, oluumbe tsana lulaba khubo olwa OMWAMI yakhupa ninalwo amahanga ako akaratikulukhanga okhulia lisabo liamatili ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukuumwi bwaMisiri bulaba burio, nobukuumwi bwamahanga kosi akaratikulukhanga okhulia lisabo liamatili ta.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunduukho eyo amakhuwa kalasaarwa khunyimba tsietsifarasi, mbu INDAKATIFU YOMWAMI; kata tsinyungu etsiomunzu yOMWAMI tsilaba shinga tsindaabo etsibeetsanga imbeli weshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli nyungu muYerusalemu nomuYuda yilaba indakatifu khuMWAMI omwene mahe; nabo bosi abamalanga emisango baleetsa nibatsibukulakhwo, nibateeshelamwo; kata khunduukho eyo shialabamwo omundu yesi oweinganga munzu yOMWAMI omwene mahe khandi ta.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.21",
            "verseOrgIds": [
              "ZEC.14.21"
            ]
          }
        }
      ]
    }
  ],
