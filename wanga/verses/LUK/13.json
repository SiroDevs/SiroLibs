          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khushise shieneshio abaFarisayo bandi nibeetsa, nibamusunjila bari Rula, ohweho; okhuba Herode yeenya okhukhwira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabakalusia mbu Tsie muboolele libwe mwenoyo, muri Lola, erusia amadimoni nende okhuhonia abalwale leelo, nende mukamba, ne khulwakhataru ekholwa omulamba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ekhoyile okhutsiililila leelo nende mukamba nende mukamba kwokhubili; okhuba shikanyalikha omunabii okhufwila elwanyi weYerusalemu ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        }
      ]
    },
