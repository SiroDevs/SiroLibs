    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwibulwa khwaYesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mundaalo etsio lilako liarula khuKaisari Augusito, mbu abomushialo shiosi bahandiikwe ameera kabwe khulwanzilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.1",
            "verseOrgIds": [
              "LUK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luno nilwo olwanzilo olwambeli olwakholwa olwa Kirenio yali Kafuna waSiria. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.2",
            "verseOrgIds": [
              "LUK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bosi nibatsia okhuhandiikwa, buli mundu mwitaala liewabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.3",
            "verseOrgIds": [
              "LUK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu yesi natikulukha narula eGalilaya, okhurula mwitaala liaNazareti, natsia ebuYahudi, mwitookho liaDaudi, elilangwa mbu Betselehemu, okhuba yali owolwibulo lwaDaudi mushilibwashie; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.4",
            "verseOrgIds": [
              "LUK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuhandiikwa halala nende Mariamu omukhasiwe owa yali nakhweetsanga, ne yali nali inda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.5",
            "verseOrgIds": [
              "LUK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibali ebweneyo, inzibula niyimunyoola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.6",
            "verseOrgIds": [
              "LUK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeebula omwanawe omusiani omwikulanda; namukanyila mungubo tsiomwana omutoro, namwalisia mulwelo; okhuba obwiyangu bwabulaho munzu yabacheni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaayi nende abamalaika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.7",
            "verseOrgIds": [
              "LUK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mushibala shieneshio bali nibaliyo abaayi bandi, abali nibamenyanga mubwayilo, nibasimikhana okhulinda ebiayo biabwe mushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.8",
            "verseOrgIds": [
              "LUK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wOmwami nafutukha aha bali, oluyali IwOmwami nilubaashila tsimbeka tsiosi; nabo nibaria muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.9",
            "verseOrgIds": [
              "LUK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika oyo nabasunjila ari Muraria ta; shichila lole, emuleerela amakhuwa amalayi akokhwikhoya okhukali okhulaba khubandu bosi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.10",
            "verseOrgIds": [
              "LUK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila leelo luno, mwitookho liaDaudi, Omuhonia amwibuliilwe, niye Kristo Omwami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.11",
            "verseOrgIds": [
              "LUK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shino shilamubeela eshilolelo; mbu mulanyoola akhaana nikhakanyilwe mungubo tsiomwana omutoro, nikhakonile mulwelo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.12",
            "verseOrgIds": [
              "LUK.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho nibeetsukhana omukanda omukhongo kwelihe liabomwikulu nikuli halala nende malaika oyo, nikwitsoomia Nyasaye, nikuboola kuri",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.13",
            "verseOrgIds": [
              "LUK.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.14",
            "verseOrgIds": [
              "LUK.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa abamalaika bali nibeenyooshe nibatsiile mwikulu, abaayi nibasungana, bari Bire khutsie eBetselehemu, khulole likhuwa lino eliikholile, elia Omwami akhutnanyiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.15",
            "verseOrgIds": [
              "LUK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaanguha nibatsia, nibanyoola Mariamu nende Yusufu yesi, nende akhaana nikhakonile mulwelo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.16",
            "verseOrgIds": [
              "LUK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibaluutsi, barumbula amakhuwa aka basunjiilwe khumwana oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.17",
            "verseOrgIds": [
              "LUK.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi abakahulila nibachenya khumakhuwa aka baboolelwa nende abaayi abo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.18",
            "verseOrgIds": [
              "LUK.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Mariamu nabiikha amakhuwa ako kosi, nakayililisinjia mumwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.19",
            "verseOrgIds": [
              "LUK.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaayi nabo nibakalukha, nibafuminjia Nyasaye nibamwitsoomia khulwako kosi aka bali nibahuliile nende okhulola, shinga olwa bali nibabooleelwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhushebwa khwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.20",
            "verseOrgIds": [
              "LUK.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsindaalo olwa tsiahwa munaane mbu bamushebe, bamukulikha eliira mbu YESU, shinga malaika olwa yamukulikha narashiabelekhwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhuyilwa khwaYesu muHekalu, nakalukha eGalilaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo etsiokhusiywa khwabwe olwa tsiahwa, amalako kaMusa shinga olwa yali, batikulukha ninaye nibamuyila eYerusalemu, okhumusinjisia imbeli wOmwami; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa kahandiikwa mumalako kOmwami, mbu Buli shisaatsa eshiikula inda shilangwe mbu eshitakatifu shiOmwami, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende okhumala omusango shinga olwa kaboolwa mumalako kOmwami, mbu amahuusi kabili, kata emisosole chibili chiamakuuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, muYerusalemu ebweneyo yaliyo omusaatsa undi, oweliiralie mbu Simeoni; omundu oyo yali omulunjishi owariitsanga Nyasaye, nalindiililanga obulemibwi bwaIsiraeli; ne Roho Omutakatifu yali muye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali niyafwimbulilwa nende Roho Omutakatifu mbu shialalola okhufwa narashialola Kristo wOmwami tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeenjila muhekalu niyeebaalilwa nende Roho; nolwa abeebuli bomwana oyo Yesu bamuleera mbu bamukholele akeshiima shiomumalako shinga olwa shili, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho yamubukula mumakhono, namwitsoomia Nyasaye, naboola mbu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.28",
            "verseOrgIds": [
              "LUK.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.32",
            "verseOrgIds": [
              "LUK.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne samwana nende nyina bali nibachenyanga khumakhuwa ako akasungwa khuye; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.33",
            "verseOrgIds": [
              "LUK.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana Simeoni nabasabila ikhabi, nasunjila Mariamu nyinamwana ari Lola, uno areelweho khulwa okhukwa nokhubuukha khwabanji abokhubaIsiraeli; khandi khulwa eshilolelo eshiambakhanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.34",
            "verseOrgIds": [
              "LUK.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "toto, nawe omwene, olukanga lulafumira omwoyokwo; mbu mana amayililisio akomumioyo eminji kabisushe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
            "verseOrgIds": [
              "LUK.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.35",
            "verseOrgIds": [
              "LUK.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho oundi mbu Ana, omukhasi omunabii, omukhaana waFanueli, owomuluyia lwaAsheri; ne yali omushiele omuyindifu muno, owali niyamenya nomusaatsawe emiyika musaafu okhurula khubushisilabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "naba omulekhwa emiyika amakhumi munaane nachine. Shiyali narulanga muhekalu ta; ne yeenamilanga Omwami nahonganga inzala khandi akhanji, nende okhusaaya eshilo nende eshiteere. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
              "LUK.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyoolaho khushise shieneshio, namwishiela Nyasaye, nababoolela amakhuwa khuye bosi abalindiililanga obununulwi bwaYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
            "verseOrgIds": [
              "LUK.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa bali nibamalilisiye amakhuwa kosi akalakwa mumalako kOmwami, bakalukha eGalilaya, nibatsia mwitaala liabwe eNazareti.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omwana yakhula, naba owamaani, niyeetsulamwo obuchesi, obukoosie bwaNyasaye nibuba khuye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusiani Yesu nali muHekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
            "verseOrgIds": [
              "LUK.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli muyika abeebulibe batsiitsanga eYerusalemu khwisabo liaPasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.41",
            "verseOrgIds": [
              "LUK.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olwa yali owemiyika ekhumi nachibili, batikulukha nibatsia, shinga eshiima shielisabo olwa shialinji; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.42",
            "verseOrgIds": [
              "LUK.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa bali nibamalile tsindaalo, nibachelelanga, omuyia Yesu yatong'a inyuma eYerusalemu; abeebulibe nibaramanya ta; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.43",
            "verseOrgIds": [
              "LUK.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa bakaala mbu ali mubachendi bashie, batsiililila oluchendo Iweshiteere eshilamba; mana nibamukhaaba mubeekho babwe nende mubashiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.44",
            "verseOrgIds": [
              "LUK.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa baramunyoola ta, bakalukha eYerusalemu nibamukhaabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.45",
            "verseOrgIds": [
              "LUK.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwetsindaalo tsitaru bamunyoola nali muhekalu, niyeekhaale hakari wabeechesia, nahulilanga akabwe, nabareebanga amareebo; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.46",
            "verseOrgIds": [
              "LUK.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "bosi abamuhulila nibahumanila oburechelefubwe nende amakalusioke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.47",
            "verseOrgIds": [
              "LUK.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bamulola, bahuka; nyina namureeba ari Mwana wanje, wakhukholeele orie? Lola, so ninasi khukhukhaabilenje nikhuhenda muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.48",
            "verseOrgIds": [
              "LUK.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila ari Mukhaabilenje murie? Shimumanyile mbu ekhoyile okhubeetsanga munzu yaPapa? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibaramanya eshisina shielikhuwa elia yababoolela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yakholomokha ninabo, niboola eNazareti; naye yali nabahulilanga; ne nyinamwana yabiikha amakhuwa ako kosi mumwoyokwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        }
      ]
    },
