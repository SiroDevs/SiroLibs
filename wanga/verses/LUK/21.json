          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli nyanga yeechesinjia muhekalu; ne buli shilo yarulanga nakona mushikulu eshilangwa mbu eshikulu shiEmitseituni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
