          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa abandu bosi bali nibabatisiibwe, Yesu yesi nabatisiibwe, nalaamanga, likulu lieekukha, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Roho Omutakatifu niyeekha namuyeelakhwo mukhufwana khwomubili kwelihuusi, omwoyo nikurula mwikulu, nikuboola kuri Niwe Omwana wanje omuheelwa. Mwiwe nimwo omwa enjamisilibungwa muno.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aketsinzibulo tsiabakukanyene Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
