          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "waYoshua, waEliezeri, waYorimu, waMatsati, waLawi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.29",
            "verseOrgIds": [
              "LUK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
