          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "waMaatsi, waMatatsia, waSemeini, waYoseki, waYuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
