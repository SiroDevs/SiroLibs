          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "waYoana, waResa, waZerubabeli, waShealitieli, waNeri, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.27",
            "verseOrgIds": [
              "LUK.3.27"
            ]
          }
        },
