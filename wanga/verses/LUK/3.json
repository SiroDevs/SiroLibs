          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu omwene, olwa yachaaka okhwechesia, yali owemiyika shinga amakhumi kataru, abandu nibakaalanga mbu nomwana waYusufu, waHeli, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
