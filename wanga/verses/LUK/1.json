    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kano kahandiichilwa Tseofilo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa kali mbu abanji beebukuliile emilimo echiokhwanza amakhuwa khukeenako akoosibwa mwifwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.1",
            "verseOrgIds": [
              "LUK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa abeenabo bakhutoonyela abalinji abaloli bako nende abakhalabani belikhuwa okhurula khukhuchaaka; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.2",
            "verseOrgIds": [
              "LUK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ninasi siesi enduutsi mbu nobulayi okhukhuhandiichila nikhwanzila amakhuwa shinga olwa kalondananga, omukhulundu Tseofilo; okhuba engarunilisiye kosi habwene okhurula khukhuchaaka; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.3",
            "verseOrgIds": [
              "LUK.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana omanyile elala obwatoto bwamakhuwa aka weechesibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhwibulwa khwaYohana Omubatini kaboolwa khale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.4",
            "verseOrgIds": [
              "LUK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiaHerode, omuruchi webuYahudi, yali naliho omukuhani undi oweliiralie Zakaria, owali owobwayi bwAbia; ne yali nende omukhasiwe owokhubakhaana baHaruni, eliiralie mbu Elisabeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.5",
            "verseOrgIds": [
              "LUK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bombi bali abalumjishi imbeli waNyasaye, nibeechendelesia mumalako kosi nende ameebaalo kosi kaNyasaye, nibabula eshikha shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.6",
            "verseOrgIds": [
              "LUK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bali nibabula omwana, shichila Elisabeti yali omukumba; nabo bombi bali nihakofula.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.7",
            "verseOrgIds": [
              "LUK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa yali nakholanga akobukuhani imbeli waNyasaye, nalondanga okhusimikhana khwobwayi bwabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.8",
            "verseOrgIds": [
              "LUK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshiima shiobukuhani shinga olwa shiali, ikha niyimukwila okhwinjila muhekalu yOmwami okhusamba amalesi kelibuuliesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.9",
            "verseOrgIds": [
              "LUK.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukanda kwosi kwabandu kwali nikusaayila elwanyi khushise shiamalesi kelibuuliesi ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.10",
            "verseOrgIds": [
              "LUK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana malaika wOmwami yamuloleshela nasinjiile khulubeka Iwomukhono musaatsa weshimalilo shiamalesi kelibuuliesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.11",
            "verseOrgIds": [
              "LUK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Zakaria olwa yamulola, ikholo niyimurimukha, oburii nibumuhamba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.12",
            "verseOrgIds": [
              "LUK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne malaika namusunjila ari Oraria ta, Zakaria; okhuba okhusaayakhwo khuhuliilwe, naye omukhasiwo Elisabeti aliibula omwana omusiani, nawe olimukulikha eliira mbu Yohana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.13",
            "verseOrgIds": [
              "LUK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oliikhoya notsatsahala; ikhandi abanji baliikhoyela okhwibulwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.14",
            "verseOrgIds": [
              "LUK.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila aliba omukhongo imbeli wOmwami; shialinywakhwo idivai yosi, kata eshimeesinjia, lawe; ne Roho Omutakatifu aliitsula muye, kata okhurula olwa aliibulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.15",
            "verseOrgIds": [
              "LUK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabanji abokhubaana baIsiraeli, alibashiukhasia khuMwami Nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.16",
            "verseOrgIds": [
              "LUK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliranjilila imbeliwe muroho yaEliya nomubunyalibwe, okhushiukhasilia abaana emioyo chiabasaabwe, nokhushiukhasia abakhayi mumachesi kabalunjishi; okhurecheshela Omwami lihanga liabandu abeekhwaniye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.17",
            "verseOrgIds": [
              "LUK.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.17",
            "verseOrgIds": [
              "LUK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zakaria namureeba malaika ari Nengamanyile khuli shiina amakhuwa ako? Shichila endi omusaakhulu, naye omukhasi wanje wakofula muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.18",
            "verseOrgIds": [
              "LUK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika nakalusia, namuboolela mbu Nisie Gaburieli, ousinjilanga imbeli waNyasaye; ne erumilwe okhusungana ninawe, nokhukhuleerela amakhuwa kano amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.19",
            "verseOrgIds": [
              "LUK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, olasiIuhala, noranyala okhuboola ta, okhuula khunyanga olwa amakhuwa kano kaliikhola, okhuba shiosuubiliile amakhuwa kanje ta, nako kaliusibwa munduukho yako.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.20",
            "verseOrgIds": [
              "LUK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu bali nibamulindiililanga Zakaria, nibahuka shinga olwa ashindile muhekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.21",
            "verseOrgIds": [
              "LUK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yarulamwo, shiyanyala okhuboolana ninabo ta; nibamanya mbu uluutsi libisulo muhekalu; ne yabasimilanga butswa namakhono, namenya nali omusilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.22",
            "verseOrgIds": [
              "LUK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa tsindaalo tsiobukhalabanibwe tsiali nitsihweele, yeenyokha natsia ebunangowe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.23",
            "verseOrgIds": [
              "LUK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyuma lwetsindaalo etsio, Elisabeti omukhasiwe yahela inda; niyeebisa emiesi chiraano, naboola ari ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.24",
            "verseOrgIds": [
              "LUK.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami yakholeele ario mundaalo etsia yahenjile, okhumbiniakhwo tsisoni mubandu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhwibulwa khwaYesu kaboolwa khale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.25",
            "verseOrgIds": [
              "LUK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mumwesi kwakhasasaba, Nyasaye yaruma malaika Gaburieli khwitaala lindi lieGalilaya elilangwa mbu Nazareti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.26",
            "verseOrgIds": [
              "LUK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ewomukhaana omushisila owali nakhweebungwa nende omusaatsa oweliiralie Yusufu, owomushilibwa shiaDaudi; neliira liomukhaana oyo niMariamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.27",
            "verseOrgIds": [
              "LUK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeenjila ewa yali, nasunga mbu Mulembe, iwe oukoosiibwe muno; Omwami ali ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.28",
            "verseOrgIds": [
              "LUK.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ikholo yamurimukha muno khulwa amakhuwa ako, nakanakania mumwoyokwe, mbu lishiesii lino lili lirie? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.29",
            "verseOrgIds": [
              "LUK.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika oyo namusunjila ari Oraria tawe, Mariamu; okhuba Nyasaye akhukoosiye muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.30",
            "verseOrgIds": [
              "LUK.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, olabelekha inda, niwibula omwana omusiani, nomukulikha eliira mbu YESU. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.31",
            "verseOrgIds": [
              "LUK.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliba omukhongo khandi alilangwa mbu Omwana waOyo Ouli Ikulu Muno; ne Omwami Nyasaye alimuheelesia eshifumbi shioburuchi eshiaDaudi kuukanyene; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.32",
            "verseOrgIds": [
              "LUK.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne aliruka inzu yaYakobo ebisoni nebisoni; akata oburuchibwe shibuliba neshihesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.33",
            "verseOrgIds": [
              "LUK.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariamu namureeba malaika ari Kano kaleekhola karie, olwa endashiamanya omusaatsa ta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.34",
            "verseOrgIds": [
              "LUK.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye malaika nakalusia, namusunjila mbu Roho Omutakatifu alakhwitsila, obunyali bwa Oyo Ouli Ikulu Muno nabwo bulakhufwimba; niko akachila eshieneshio eshiitsa okhwibulwa shilalangwa mbu eshitakatifu mbu Omwana waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.35",
            "verseOrgIds": [
              "LUK.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, omwikho weenywe Elisabeti yesi yabelekha inda yomwana omusiani mubushielebwe; ne kuno nikwo omwesi kwakhasasaba khumwenoyo oulangwa mbu omukumba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.36",
            "verseOrgIds": [
              "LUK.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila khuNyasaye libulaho likhuwa liosi eliranyalikha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.37",
            "verseOrgIds": [
              "LUK.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariamu naboola mbu Lola, endi omutitiikhani wOmwami; kalambeela shinga olwa osunjile. Mana malaika namulekha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwa Mariamu yatsia obucheni ewaElisabeti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.38",
            "verseOrgIds": [
              "LUK.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mundaalo tsienetsio Mariamu yarula natsia bwangu mushibala shiomubikulu, okhuula khwitaala lindi liebuYahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.39",
            "verseOrgIds": [
              "LUK.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeenjila munzu yaZakaria, nashiesia Elisabeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.40",
            "verseOrgIds": [
              "LUK.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Elisabeti yahulila amashiesii kaMariamu, omwana yakhupa munda; Roho Omutakatifu niyeetsula muElisabeti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.41",
            "verseOrgIds": [
              "LUK.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye nachinga omwoyo, nayiiba, nasunga mbu Oli oweikhabi mubakhasi, khandi noweikhabi oyo owa witsa okhwibula. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.42",
            "verseOrgIds": [
              "LUK.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lino linzitsiile lirie, nyinamwana Omwami wanje okhunzitsila? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.43",
            "verseOrgIds": [
              "LUK.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lola, olwa omwoyo kwamashiesiiko kwakhahuliilikha mumarwi kanje, omwana yakhoopa munda yanje, khulwa okhwikhoya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.44",
            "verseOrgIds": [
              "LUK.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi noweikhabi ousubiile; shichila amakhuwa kOmwami aka yabooleelwe kaliusibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.45",
            "verseOrgIds": [
              "LUK.1.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwimbo Iwobwitsoomii lwaMariamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 1:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.55",
            "verseOrgIds": [
              "LUK.1.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariamu namenya ninaye eshise shiemiesi shinga chitaru, mana nakalukha ewuwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwibulwa khwaYohana Omubatisii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 1:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho induukho yaElisabeti eyokhwibula niyula; niyeebula omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.57",
            "verseOrgIds": [
              "LUK.1.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamenyanibe nende abeekhobe nibahulila shinga Omwami olwa yali niyamubambusilia tsimbabasitsie; mana nibeekhoyela halala ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 1:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane nibeetsa okhumusheba omwana; ne bali nibeenya okhumukulikha eliira khuliira liasamwana, mbu Zakaria. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 1:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nyinamwana nakalusia, nasunga mbu 'A, tawe; ne alalangwa mbu Yohana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.60",
            "verseOrgIds": [
              "LUK.1.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 1:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila bari Abulaho mubeekho beenywe bosi oulangungwa eliira elo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.61",
            "verseOrgIds": [
              "LUK.1.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 1:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusimila samwana amakhono mbu aboole eliira elia yeenya akulikhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.62",
            "verseOrgIds": [
              "LUK.1.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "LUK 1:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasaba akhabaho akhokhuhandiikakhwo, nahandiika ari Eliiralie niye Yohana. Nibachenya bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.63",
            "verseOrgIds": [
              "LUK.1.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "LUK 1:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho omunwakwe nikwikukha, olulimilwe niluboholokha, nachaaka okhuboola, namwitsoomia Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.64",
            "verseOrgIds": [
              "LUK.1.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "LUK 1:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburii nibubahamba bosi abamenyanga mumbali etsio; amasungo ako kosi nikatswana mungongo tsiosi tsiebikulu biebuYahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.65",
            "verseOrgIds": [
              "LUK.1.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abakahulila nibakabiikha mumioyo chiabwe, bari Omwana uno aliba owambia shiina? Shichila omukhono kwOmwami kwali khuye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi bwaZakaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho Omutakatifu niyeetsula muZakaria samwana, naye nalakula, naboola mbu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "79",
            "style": "v",
            "sid": "LUK 1:79"
          },
          "items": [
            {
              "text": "79",
              "type": "text"
            }
