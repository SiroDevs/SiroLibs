        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo lwelikondi eliakora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasololi bobushuru nende aboonooni bosi bali nibamusitilanga ahambi okhuhulila akeke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaFarisayo nende abahandiichi bosi nibabuuluula, bari Omundu uno yeenjisinjia aboonooni, khandi alia ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naboopela oluchelo luno, ari ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimundu shiina mwinywe ouba nali nende amakondi eshikhumi, elala khuko nilikorile, ne naralekha kalia amakhumi shienda nashienda mushitsiimi, walondachilila lienelo elikorile, okhuula olwa alinyoola? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa aba nalinyoolile, alireetsanga khumabeka, niyeekhoya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoola hango, alanga abeetsabe nende abamenyanibe halala, nabasunjila ari Mwikhoye ninasi, okhuba enyoolile likondi lianje elibeele nilikorile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela mbu nilwo olwa khulabaho okhwikhoya mwikulu khulwa omwonooni mulala owikalukhasia, okhushila abandu abalunjishi amakhumi shienda nashienda abaratakha okhwikalukhasia ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo Iweishilingi eyakora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nimukhasi shiina ouba nali nende tsishilingi ekhumi, ndala khutsio niyimukorakhwo, ne narahambia itaha wachieya inzu nakhaaba butinyu okhuula olwa achinyoola? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa aba nachinyoolile, alanga abeetsabe nende abamenyanibe halala, nasunga ari Mwikhoye ninasi, okhuba enyoolile ishilingi eyibeele niyingorilekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela mbu nindio okhwikhoya khubeetsangaho ewa abamalaika baNyasaye bali khulwa omwonooni mulala owikalukhasia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo Iwomusiani owakora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Yaliho omusaatsa owali nende abaanabe abasiani babili; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "omushe namusunjila samwana ari Papa, umbeelesie omukabo okwokhumianduchio okwitsa okhungwila. Naye nabakabila biosi ebia yakheekhoonyeelenje. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.12",
            "verseOrgIds": [
              "LUK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwetsindaalo tsinduutu omushe oyo yakhung'aasia biosi, nabuusia oluchendo okhutsia mushialo shiehale; ne ebweneyo yasalaasia emianduchie mubikhole biobwilaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nachimalile chiosi, inzala ikhongo niyiinjila mushialo eshio; naye nachaaka okhutamba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yatsia niyeeyunga khumundu undi weshialo eshio; naye namuruma mubwayilo okhwaya tsimbiitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yeekombanga okhwikura khumakhoba aka tsimbiitsi tsiali nitsiliitsanga; ne yabulaho owamuheelesia eshindu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.16",
            "verseOrgIds": [
              "LUK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yalaba tsimoni, yaboola mbu Abakholi bapapa nabanji butswa abali nebiliibwa ebibahela nibishilaana, nasi nifwilanga hano inzala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalarula nimutsiila papa, nimusunjila mbu Papa, ndayoonoona imbeli welikulu nende mumonitsio; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "shingwanile okhulangwa omwanawo khandi ta; ukhole embe shinga mulala owokhubakholibo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho narula, natsia ewasamwana. Ne olwa yali nashili ehale, samwana yamulola, eshisa nishimuhamba, niyeelukha, nakwa mwikosilie, namutsunzuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.20",
            "verseOrgIds": [
              "LUK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwanawe namusunjila mbu Papa, ndayoonoona imbeli welikulu nende mumonitsio; shingwanile okhulangwa omwanawo khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.21",
            "verseOrgIds": [
              "LUK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa samwana nasunjila abasumbabe ari Khole bwangu, muleere ikanzu indayi, mumufwale; mana mure ingaka khumukhonokwe, nende ebilaaro mubilenje; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muleere eshimoosi shilia eshianesibwa, mushiire, khulie nikhutsatsahala; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba omwana wanje uno yali nafwile, ne ulamuushe; yali niyakora, ne unyooleeshe. Nibachaaka okhutsatsahala.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwanawe omukhulundu yali nali mumukunda. Ne olwa yeetsa nasita ahambi neinzu, yahulila obukhana nende okhushina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nalanga mulala khubakholi, nareeba mbu kakhali karie? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namuboolela mbu Omusiani weenywe witsile; mana so wirile eshimoosi shilia eshianesibwa, shichila amunyoolile nali omuIamba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.27",
            "verseOrgIds": [
              "LUK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasinyikha, naloba okhwinjila; mana samwana niyeetsa namusaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakalusia nasunjila samwana ari Lola, emiyika chino eminji ekhukhalabanilanga, kata shikhayile lilakolio kata elala tawe; nebutswa shiwayambeelesiakhwo eshimeeme, mbu enzatsahale halala nende abeetsa banje, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne uno omwanawo olwa yeetsile owahululila mubatamba ebia wakheekhoonyeelenje, omwiriile eshimoosi shilia eshianesibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
