      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yareebwa khukobunyali obwa yaheebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yindi mundaalo etsio olwa yali niyeechesinjia abandu muhekalu, niyee wstsanga injiili, abakhulundu bsbakuhani nende abahandiichi halala nende abakofu nibamunyoolelesia; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.1",
            "verseOrgIds": [
              "LUK.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaboola, nibamureeba bari Okhuboolele, mbu nobunyali shiina obuchilanga nokhola amakhuwa kano? Kata owakhuheelesia obunyali buno niye wina? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.2",
            "verseOrgIds": [
              "LUK.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabakalusia, naboola ari Nasi emureeba inywe likhuwa, mumboolele; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.3",
            "verseOrgIds": [
              "LUK.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu obubatisii bwaYohana, bwarula mwikulu nohomba mubandu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.4",
            "verseOrgIds": [
              "LUK.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibaboolelana abeene nabeene, bari Nikhuba nikhusunga mbu bwarula mwikulu, alareeba mbu Ne mbushiina nimuramusuubila ta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.5",
            "verseOrgIds": [
              "LUK.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikhuba nikhusunga mbu bwarula mubandu, abandu bosi balakhulasa namachina; shichila bamanya mbu Yohana nomunabii. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.6",
            "verseOrgIds": [
              "LUK.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakalusia mbu Shikhumanyile ewa bwarula ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.7",
            "verseOrgIds": [
              "LUK.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu naye nabasunjila mbu Kata siesi shimuboolela mbu nobunyali shiina obuchilanga nikhola amakhuwa kano tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.8",
            "verseOrgIds": [
              "LUK.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo lwabalimili bemitsabibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.8",
            "verseOrgIds": [
              "LUK.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachaaka okhuupila abandu omenelo luno; mbu Omundu undi yaraaka omukunda kwemitsabibu, nakuhosia abalimili, natsia mushialo shindi, namenyayo tsindaalo tsinyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa induukho yoola, yaruma omusumba undi khubalimili abo mbu bamuheelesie khubiamo ebiomumukunda kwemitsabibu; ne abalimili abo nibamunywekha, nibamwilusia amakhono amakhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.10",
            "verseOrgIds": [
              "LUK.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naruma omusumba undi khandi, naye yesi nibamunywekha, nibamuhambia tsisoni, nibamwilusia amakhono amakhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.11",
            "verseOrgIds": [
              "LUK.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naruma owakhataru khandi; naye yesi nibamufumira, nibamusukuna elwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.12",
            "verseOrgIds": [
              "LUK.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami omwene mukunda kwemitsabibu naboola ari Nekhole endie? Ndalaruma omwana wanje omuheelwa; haundi ye balamuria, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.13",
            "verseOrgIds": [
              "LUK.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abalimili abo bamulola, baboolelana abeene nabeene, bari Uno niye owobulaame; khumwire, mbu mana obulaame bube obweefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.14",
            "verseOrgIds": [
              "LUK.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyinia mumukunda kwemitsabibu, nibamwira. Kho bulaano omwami omwene mukunda alabakholela shiina? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.15",
            "verseOrgIds": [
              "LUK.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbula, aleetsa namalilana abalimili abo, naheelesia abandi omukunda okwo. Ne olwa bahulila, baboola bari 'A, kaleshe okhuba kario ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
            "verseOrgIds": [
              "LUK.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
            "verseOrgIds": [
              "LUK.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabahenga, nasunga mbu Kho kali karie akahandiikwa, mbu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu oukwa khwichina elo alarabukha ebitonye ebitonye; ne omundu yesi owa lilakwakhwo, lilamutubulila elala.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.18",
            "verseOrgIds": [
              "LUK.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.18",
            "verseOrgIds": [
              "LUK.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abahandiichi nende abakhulundu babakuhani bakhaaba okhumuhamba khushise shieneshio; ne bali nibariitsanga abandu; shichila balola shinga olwa yali nakhupile oluchelo olwo khubo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhurunga obushuru bwaKaisari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyichila, nibaruma abaluuri abeefwayafwayia okhuba shinga abalunjishi, mbu batiile okhuboolakhwe, mana bamuhaane khuburuchi nende khubunyali bwaKafuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.20",
            "verseOrgIds": [
              "LUK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamureeba bari Omwechesia, khumanyile shinga olwa oboolanga nende okhwibaala habwene, norafuchiilila eshiimo shiomundu yesi ta, ne mbu wibaalanga injila yaNyasaye mubwatoto; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.21",
            "verseOrgIds": [
              "LUK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ifwe okhurunga obushuru khuKaisari nomusilo nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yalola obuchesichesi bwabwe, nababoolela mbu ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manyiekhwo itinari. Yili nobukondo bwawina nelihandiiko liawina? Nibakalusia mbu NebiaKaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela mbu Kho ebili ebiaKaisari, mumurunjenje Kaisari; nebili ebiaNyasaye, mumurunjenje Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakhaywa okhutiila okhuboolakhwe okhwo imbeli wabandu; nibahuka muno khwikalusiolie; nibaholeela butswa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lireebo eliokhubulamushi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi abokhubaSadukayo nibeetsa, abo ababoolanga mbu bubulaho obulamushi; nibamureeba ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
            "verseOrgIds": [
              "LUK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bari Omwechesia, Musa yakhuhandiichila ari Omusiani wabwe omundu naba nafwa, ne nali nomukhasi, ne nabula abaana, omusiani wabwe akhoyile okhukalusia omukhasi oyo, amubuusilie omwana wabwe omurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.28",
            "verseOrgIds": [
              "LUK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bali nibaliho abasiani musaafu abomunzu ndala; owambeli yaleera omukhasi, ne nafwa, nabula abaana; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.29",
            "verseOrgIds": [
              "LUK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana owakhabili; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.30",
            "verseOrgIds": [
              "LUK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana owakhataru namukalusia; kata abo bosi musaafu bario shibalekhakhwo abaana ta, ne nibafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.31",
            "verseOrgIds": [
              "LUK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyumakhwo omukhasi yesi nafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.32",
            "verseOrgIds": [
              "LUK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mukhulamukha aliba omukhasi wawina khubo? Shichila bosi musaafu bali nibamuteeshia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu nabasunjila mbu Abaana abomushialo shino bateeshinjia nibateeshibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa abo abanyoolekha nibakwanile okhuula mushibala shilia, nende khubulamushi bwokhurula mukhufwa, shibateeshinjia kata okhuteeshibwa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shibanyala okhufwa khandi ta; shichila baleng'aasibwa nende abamalaika, nibaba abaana baNyasaye, okhuba nabaana bobulamushi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.36",
            "verseOrgIds": [
              "LUK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne likhuwa liabafu okhulamusibwa, kata Musa yamanyia haShitsakha, olwa yakulikha Omwami mbu Nyasaye waAburahamu, khandi Nyasaye waIsaka, khandi Ngasaye waYakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano shiali ye Nyasaye wabafu ta, habula wabali mwoyo; shichila bosi babeetsanga mwoyo khuye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi khubahandiichi nibamukalusia bari Omwechesia, oboolile bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shibatsaalikha okhumureeba lireebo lindi khandi ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lireebo eliokhuMwana waDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabareeba ari Baboolanga barie mbu Kristo watsana nomwana waDaudi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila Daudi omwene yaboola mushitabo shieTsitsabuli, ari",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.42",
            "verseOrgIds": [
              "LUK.20.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.43",
            "verseOrgIds": [
              "LUK.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi amulanganga mbu Omwami; ne yakhaba arie omwanawe?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yafukula Abahandiichi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.44",
            "verseOrgIds": [
              "LUK.20.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 20:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yaboolela abeechibe, abandu bosi nibahulila. Ari ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.45",
            "verseOrgIds": [
              "LUK.20.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 20:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirecheshe khulwa abahandiichi abachamanga okhuchendachenda nibeefwalile ebiifwalo ebirambi, nibaheela okhushiesibwa muluyia, nebifumbi ebiambeli mutsisinagogi, nobwikhalo obukhulundu mumasabo; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 20:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaliitsanga tsinzu tsiabakhasi abalekhwa, ne khulwa obukaati basaaya amasaayo amarambi; abeenabo nibo aba eshiina shilifwila eshikhongo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
      ]
