{
  "id": "LUK.16",
  "number": "16",
  "bookId": "LUK",
  "reference": "Luka 16",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "LUK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo Iwomunyapara omushiamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olundi yabasunjila abeechibe ari Yaliho omusaatsa undi omuyinda owali nali nende omunyapara; omwenoyo namoonywa ewuwe mbu amalanga butswa emianduchie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.1",
            "verseOrgIds": [
              "LUK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namulanga, namureeba ari Kano kakhali karie aka embulilanga khwiwe? Umbasilie ebiobunyaparabwo, shichila shionyala okhuba omunyapara khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.2",
            "verseOrgIds": [
              "LUK.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyapara oyo nasunga mumwoyokwe ari Nekhole endie, olwa omwami wanje ambiniyekhwo obunyapara? Shindakhanyala okhulima ta; okhusabanga ebindu nokhwetsisoni khwisie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.3",
            "verseOrgIds": [
              "LUK.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emanyile eshia ekhoyile okhukhola, mbu olwa emba nimbinibwakhwo obunyapara, mana banzinjisie munzu tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.4",
            "verseOrgIds": [
              "LUK.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalanga abeekobi bomwamiwe, mulala mulala, nareeba owambeli ari Likobilio khumwami wanje lili lirie? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.5",
            "verseOrgIds": [
              "LUK.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakalusia mbu Tsibaatsil eshikhumi tsiamafura. Namusunjila mbu Bukula lihandiikolio, wikhale bwangu ohandiiche amakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.6",
            "verseOrgIds": [
              "LUK.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nareeba oundi ari Nawe, likobi lilio lili lirie? Naye ari, Tsikoro eshikhumi tsieingano. Namuboolela mbu Bukula lihandiikolio, ohandiiche amakhumi munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.7",
            "verseOrgIds": [
              "LUK.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwamiwe namupaaka omunyapara oyo omushiamu, shichila yakholile akobuchesi; okhuba abaana beshialo shino mulwibulo lwabwe abeene nabachesi okhushila abaana bomubasu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.8",
            "verseOrgIds": [
              "LUK.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi emusunjila mbu mwikhoonyele obuyinda obushiamu okhwinyoolela abeene abeetsa, mbu olwa bulaba nibuhweele, mana bamwinjisie mubimenyo biobumeli.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.9",
            "verseOrgIds": [
              "LUK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouli omwisiikwa mumakhuwa amatuutu, khandi nomwisiikwa mumakhongo; ne ouli omushiamu mumakhuwa amatuutu, khandi nomushiamu mumakhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.10",
            "verseOrgIds": [
              "LUK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimuba nimurabeelenje abeesiikwa mubuyinda obushiamu ta, ali heena owakhamwechekhakhwo obuyinda bwatoto? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.11",
            "verseOrgIds": [
              "LUK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nimuba nimurabeelenje abeesiikwa khubindu biabeene ta, ali heena owakhamuheelesia ebiakhaba bieenywe abeene?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.12",
            "verseOrgIds": [
              "LUK.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.12",
            "verseOrgIds": [
              "LUK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulaho omusumba yesi ounyala okhukhalabanila abaami babili ta; shichila alachwang'a mulala khubo namuheela oundi; kata mbu alahambana nende mulala khubo namuchaya oundi. Shimunyala okhukhalabanila Nyasaye khandi nende emiandu ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akamalako nende Obwami bwaNyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaFarisayo, abali nibaheelanga amapeesa muno, nibahulila amakhuwa ako; nibamuleka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila ari Inywe ninywe abeeha obulunjishi mumoni tsiabandu; ne Nyasaye wamanya emioyo chieenywe; shichila eshiheebwa oluyali mubandu, neshisinyo mumoni tsiaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamalako nende abanabii kalinjiho okhuula khuYohana; okhurula mundaalo etsio injiili yobwami bwaNyasaye yilwatsungwa, ne buli mundu yeenjilangamwo namahababa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne neshiangu likulu nende eshibala okhuhwaho, okhushila akharoonyelesi khalala khamalako okhukwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yesu yeechesia khukokltulekhana khwomusaatsa nomukhasiwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli mundu owilusia omukhasiwe nateeshia oundi, aheeya; noyo outeeshia omukhasi ouba niyeelusiibwe nomusaatsawe yesi aheeya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omuyinda nende Lazaro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali naliho omusaatsa undi omuyinda, ne yali niyeefwalanga tsingubo tsieisambarau nende ikitani indorotoro, naliitsanga eshiami buli nyanga nende obusangaali. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.19",
            "verseOrgIds": [
              "LUK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omumanani undi oweliiralie mbu Lazaro yali niyaalisibongwa hashilibwashie, owa amakonzo kamala omubilikwe pe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.20",
            "verseOrgIds": [
              "LUK.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeekomba okhwikura khumbungulusi etsiabungulukhanga okhurula khumeesa yomuyinda oyo; ne kata tsimbwa tsieetsanga nitsikhomba amakonzoke. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.21",
            "verseOrgIds": [
              "LUK.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omumanani oyo nafwa, nachingwa nende abamalaika nayilwa khushilifu shiaAburahamu; mana omuyinda yesi yafwa nayabilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.22",
            "verseOrgIds": [
              "LUK.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nali eMakombe, nanyasibungwa muno, yachinguula tsimoni, nalola Aburahamu nali ehale, nende Lazaro nali khushilifushie. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.23",
            "verseOrgIds": [
              "LUK.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalanjisia, nasunga mbu Papa Aburahamu, umbeele tsimbabasi, orume Lazaro mbu yeene obutsunzu bwolwala mumatsi, anyisie olulimi lwanje; okhuba esaalilanga muno mulumemu luno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.24",
            "verseOrgIds": [
              "LUK.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Aburahamu nakalusia ari Mwana wanje, yitsulila mbu iwe mundaalo tsiobulamubwo wanyoolanga amalayiko, ne Lazaro ario yanyoolanga amabii; ne bulaano, hano, ye alemibwa omwoyo, nawe oli mubusaalili. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.25",
            "verseOrgIds": [
              "LUK.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne halala nende ako, hakari weefwe ninawe liliho libanda lietsinjengulukho eliareebwaho, mbu abeenya okhurula hano bamutsiile ewa muli baranyala ta, khandi mbu oundi yesi oweyo aleshe okhwambukha okhukhwitsila ifwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.26",
            "verseOrgIds": [
              "LUK.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila mbu Ekhusaaya, papa chama omurume ebunango weefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.27",
            "verseOrgIds": [
              "LUK.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila endikhwo nende abaana beefwe baraano; mbu abarumbulile akobuloli, nabo baleshe okhwitsa habundu hano hamanyasio. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.28",
            "verseOrgIds": [
              "LUK.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yamusunjila ari Bali ninabo Musa nende abanabii; babahulilenje bo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.29",
            "verseOrgIds": [
              "LUK.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari 'A, tawe, papa Aburahamu; nebutswa oundi naba nabatsiila okhurula mubafu, baleekalukhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
              "LUK.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila mbu Nibaba nibarahulilanga Musa nende abanabii, shibalafuchiilila ta, kata olwa omundu alamukha okhurula mubafu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.31",
            "verseOrgIds": [
              "LUK.16.31"
            ]
          }
        }
      ]
    }
