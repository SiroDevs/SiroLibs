{
  "id": "LUK.11",
  "number": "11",
  "bookId": "LUK",
  "reference": "Luka 11",
  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "LUK 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yesuyeechesia khukobusaayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nasaayilanga habundu wundi, ne niyakhalekha, oundi owokhubeechibe yamusunjila ari Omwami, okhwechesie okhusaaya, shinga Yohana olwa yeechesia abeechibe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.1",
            "verseOrgIds": [
              "LUK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila mbu Olwa musaaya musunjenje muri: Seefwe, Eliiralio liriibwe, Obwamibwo bwitse. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.2",
            "verseOrgIds": [
              "LUK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuheelesie inyanga shia inyanga ebiliibwa bieefwe bieinyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.3",
            "verseOrgIds": [
              "LUK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhuleshela ebionoono bieefwe, shichila nineefwe khuleshelanga buli mundu ouli nelikobi khwifwe. Norakhuyila mukhuteemwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.4",
            "verseOrgIds": [
              "LUK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila ari Niwina khwinywe ouba nali nende omwitsa, mana natsia ewuwe mushilo hakari, namusunjila ari Owashianje, ukhoonyekhwo nemikaate chitaru; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.5",
            "verseOrgIds": [
              "LUK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba omwitsa wanje undi yeetsile ewanje narula khuluchendo, nasi shindikhwo nende eshia emurenjeshela ta; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.6",
            "verseOrgIds": [
              "LUK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye nakalusia, nali munzu, naboola mbu Lekha okhunyasia; omuliango kumalile okhwikalwa, neefu khukonanga nabaana banje; shinyala okhubuukha ekhuheelesie ta? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.7",
            "verseOrgIds": [
              "LUK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela mbu naba narakhabuukha wamuheelesiakhwo khulwa obwitsa ta, khane khulwa obulumilifubwe alabuukha namuheelesia chiosi echia yeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.8",
            "verseOrgIds": [
              "LUK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi emusunjila mbu sabe, mulaheebwakhaabe, mulanyoola; khong'onde, muleekulilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.9",
            "verseOrgIds": [
              "LUK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba buli mundu ousaba aheeba; noukhaaba, anyoola; noukhong'onda, aleekulilwa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.10",
            "verseOrgIds": [
              "LUK.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.10",
            "verseOrgIds": [
              "LUK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata niwina khwinywe owakhaba nali omwibuli, omwanawe namusaba omukaate, wamuheelesia lichina? Kata inyeeni, naye mushilenje shieinyeeni wamuheelesia inzokha? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.11",
            "verseOrgIds": [
              "LUK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata naba nasaba libuyu, yakhamuheelesia likatia noho? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.12",
            "verseOrgIds": [
              "LUK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho inywe abali ababii olwa mumanyile okhubaheelesia abaana beenywe ebihaanwa ebilayi, Seenywe owomwikulu shialashila muno okhubaheelesia Roho Omutakatifu abo abamusaba?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.13",
            "verseOrgIds": [
              "LUK.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu nende Beelezebuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.13",
            "verseOrgIds": [
              "LUK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali narusinjia lidimoni lindi lisilu; ne olwa lidimoni liali nilirulile, omundu oyo omusilu yaboola; abemikanda nabo nibachenya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.14",
            "verseOrgIds": [
              "LUK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandi khubo basunga mbu Arusinjia amadimoni khulwa obunyali bwaBeelezebuli omwami wamadimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.15",
            "verseOrgIds": [
              "LUK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi nibamuteema, nibamusaba eshilolelo eshirula mwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.16",
            "verseOrgIds": [
              "LUK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa yamanya amapaaro kabwe, nabasunjila ari Buli buruchi obubeetsanga nibwahukhaane obwene khubwene, bukwitsanga amakunda, inzu nayo yikwitsanga khunzu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.17",
            "verseOrgIds": [
              "LUK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Setani yesi naba nabeetsanga niyaahukhaane omwene khumwene, oburuchibwe bulanyala burie okhusinjila? Shichila musunganga mbu erusinjia amadimoni khulwa obunyali bwaBeelezebuli. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.18",
            "verseOrgIds": [
              "LUK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isie nimba nirusinjia amadimoni khulwa obunyali bwaBeelezebuli, kho abaana beenywe bakarusinjia khulwa obunyali bwawina? Khulwako bo balamukabukhasilia amakhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.19",
            "verseOrgIds": [
              "LUK.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isie nimba nirusinjia amadimoni khulwa olwala lwaNyasaye, kho Obwami bwaNyasaye bumuulilekhwo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.20",
            "verseOrgIds": [
              "LUK.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.20",
            "verseOrgIds": [
              "LUK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu wamaani owimanuule ebimanulwabie olwa alindanga litaalalie, emianduchie chiba shisale; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.21",
            "verseOrgIds": [
              "LUK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne omundu undi oumushila amaani olwa amwitsila namuhula, amunuula ebimanulwabie biosi ebia yali nasuubililanga, nakabula ebiyaayobie.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.22",
            "verseOrgIds": [
              "LUK.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.22",
            "verseOrgIds": [
              "LUK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouraba ninasi halala ta, yafukulanga; nourakhung'aasia ninasi ta, asalaasinjia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.23",
            "verseOrgIds": [
              "LUK.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukalukha khwaroho weshifwabwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.23",
            "verseOrgIds": [
              "LUK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne roho weshifwabwi olwa aba narulile mumundu, abiranga aha amatsi kabula, nakhaaba aha ahuluushila; ne naranyoolile ta, amalanga aboole ari Lekha engalushe munzu yanje omwa ndarula. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.24",
            "verseOrgIds": [
              "LUK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoolamwo, anyoola niyeyilwe niying'oonilwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.25",
            "verseOrgIds": [
              "LUK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana atsia yeenda abaroho bandi musaafu abamushila obubii, beenjila bamenyamwo; mana obumaliilishi bwomundu oyo buba obubii okhushila shinga olwa yabeelenje.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.26",
            "verseOrgIds": [
              "LUK.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikhabi yatoto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.26",
            "verseOrgIds": [
              "LUK.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yaboola amakhuwa ako, omukhasi undi mumukanda yachinguula omwoyo, namusunjila ari Nebieikhabi inda eyakhwibula, nende tsimbeele etsia wanuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.27",
            "verseOrgIds": [
              "LUK.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, mbu Ne elishila elo, nabeikhabi abo abahulilanga amakhuwa kaNyasaye nibakalinda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.28",
            "verseOrgIds": [
              "LUK.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwibulo olwnayaanu olwenya eshilolelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.28",
            "verseOrgIds": [
              "LUK.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa emikanda chiali nichikhung'aananga ewa yali, yachaaka okhuboola mbu Olwibulo luno nolwibulo olumayaanu; Iwenyanga eshilolelo; ne shilulaheebwakhwo eshilolelo shiosi ta, habula eshilolelo shiaYona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.29",
            "verseOrgIds": [
              "LUK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga Yona olwa yeekhola eshilolelo khubaNinewe, nolwa Omwana wOmundu alaba eshilolelo khubolwibulo luno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.30",
            "verseOrgIds": [
              "LUK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi omukhasi oyo owesautsi alibuukha mumuse halala nende abandu abolwibulo luno, nabakhalachila eshiina; shichila ye yarula khundulo weshibala okhuhulila obuchesi bwaSulemani; ne lole, oushila Sulemani ali hano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.31",
            "verseOrgIds": [
              "LUK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaNinewe balisinjila mumuse halala nende abolwibulo luno, nibalukhalachila eshiina; shichila bo beekalukhasilia obwilwatsii bwaYona; ne lole, oushila Yona ali hano.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.32",
            "verseOrgIds": [
              "LUK.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulaho omundu ouhambia itaha, mana wachira hasi mungulu, kata okhuchifuunikhakhwo eshimwelo, habula okhuchira khushichibi shiayo, mbu mana abeenjilanga balole obulafu bwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.33",
            "verseOrgIds": [
              "LUK.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itaha yomubilikwo niyo imoniyo; kho imoniyo niyiba habwene, omubilikwo kwosi nakwo kuba nikwitsuulemwo obulafu; ne niyiba imbii, omubilikwo nakwo kuba nikwitsuulemwo eshiilima.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itaha yomubili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.34",
            "verseOrgIds": [
              "LUK.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ohenje bulayi, obulafu obuli mwiwe buleshe okhuba eshiilima. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.35",
            "verseOrgIds": [
              "LUK.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, omubilikwo kwosi nikuba nikwitsuulemwo obulafu, nikubula nende eshitonye shiosi eshilimwo eshiilimD, kulaba nikwitsuulemwo obulafu bwonyene, shinga olwa itaha yakhanga niyikhulangaalila.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yafukula abaFarisayo nabakhulundu bamalako",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.36",
            "verseOrgIds": [
              "LUK.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa yali naboolanga, omuFarisayo undi yamulanga okhulia ebiliibwa ewuwe; naye niyeenjila, niyeekhala habiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.37",
            "verseOrgIds": [
              "LUK.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omuFarisayo oyo yalola, yahuka okhuba shiaranjiliile okhusaaba narashialia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.38",
            "verseOrgIds": [
              "LUK.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami namusunjila ari Mbula, inywe abaFarisayo mulabinjia eshikombe nende eshikaye emukongo wabio, ne mukari mweenywe mubeetsanga nimwisuulemwo obunuuli nende obumayaanu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.39",
            "verseOrgIds": [
              "LUK.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasilu inywe, oyo owalonga ebielwanyi shiali ye owalonga nende ebiomukari nabio niina? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.40",
            "verseOrgIds": [
              "LUK.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa muhaanenje ebieshisa khubienebio ebili mukari; ne lole, ebindu biosi bilamubeelanRa ebisiiye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.41",
            "verseOrgIds": [
              "LUK.11.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.41",
            "verseOrgIds": [
              "LUK.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne woowe, inywe abaFarisayo! Shichila mwahulanga eshitonye shielikhumi shiokhuminanaa, nende likhubi, nende buli eliani, nimumaayia obukhalachi bwatoto nende obuheeli bwaNyasaye; niko aka mwali nimukhoyeele okhukhola, oburalekha okhukhola akeene kalia ta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.42",
            "verseOrgIds": [
              "LUK.11.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.42",
            "verseOrgIds": [
              "LUK.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe, inywe abaFarisayo! Shichila muheelanga ebifumbi ebiambeli mutsisinagogi, nokhushiesibwa muluyia.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.43",
            "verseOrgIds": [
              "LUK.11.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.43",
            "verseOrgIds": [
              "LUK.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe khwinywe! Shichila mwingana ebilindwa ebiralolekha ta, abandu abachendanga hekulu khubio nibaramanya tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.44",
            "verseOrgIds": [
              "LUK.11.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.44",
            "verseOrgIds": [
              "LUK.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mulala khubakhulundu bamalako nakalusia namusunjila ari Omwechesia, nosunga orio okhunyekanga nineefwe fwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.45",
            "verseOrgIds": [
              "LUK.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Woowe kata khwinywe abakhulundu amalako! Shichila mutuukhanga abandu emisiiko echirachinjikha bulayi ta, neenyu abeene shimutiilangakhwo khumisiiko echio kata nende olwala lulala tawe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.46",
            "verseOrgIds": [
              "LUK.11.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.46",
            "verseOrgIds": [
              "LUK.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe khwinywe! Shichila muumbakhanga ebilindwa biabanabii, ne abakuuka beenywe nibo ababeera. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.47",
            "verseOrgIds": [
              "LUK.11.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 11:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho muli abaloli, khandi muchamanga ebikhole biabakuuka beenywe; shichila bo nibo ababeera, neenyu muumbakhanga ebilindwa biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.48",
            "verseOrgIds": [
              "LUK.11.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 11:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila obuchesi bwaNyasaye bwaboola mbu Ndalabarumila abanabii nende abarume; nabandi khubo balabeera nibabeelusia; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.49",
            "verseOrgIds": [
              "LUK.11.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 11:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana amabanga kabanabii bosi akeebeena okhurula khumusuule kabanzwe khubolwibul o luno ",
          "type": "text",
