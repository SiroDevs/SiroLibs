        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Omwami Ounyala-biosi aboola. Kho abaheelwa banje, olwa khwasuubisibwa amakhuwa ako, khwisiiye abeene mushifwabwi shiosi shiomubili nende eshiaroho, nikhuusilia elala obutakatifu mukhuria Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yasangaalila obwikalukhasii kweikanisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhwiyanjiyilie mumioyo chieenywe. Ifwe shikhwamukholela omundu yesi akarali habwene ta; shikhwamwonoonia omundu yesi ta; shikhwakatsa omundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.2",
            "verseOrgIds": [
              "2CO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimboola likhuwa lino shinga oumukhalachila eshiina ta; mbula, shinga olwa ndamuboolela khale, mbu mubeetsanga mumioyo chieefwe, kata okhufwila halala kata okhubeela mwoyo halala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.3",
            "verseOrgIds": [
              "2CO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzaalikha okhumusunjilanga katong'ane, nindiyitsiala muno khulweenywe; enziitsuulemwo obuhabinwi; mubusandi bweefwe bwosi okhwikhoya khwanje khwitsulanga nikhubilana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.4",
            "verseOrgIds": [
              "2CO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kata olwa khwali nikhuulile eMakedonia, emibili chieefwe shichianyoola obusakulushi bwosi ta; ne khwamiinwa tsimbeka tsiosi; elwanyi bwaliho obusoolo, mukari bwalimwo oburii. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oyo outinyisinjia abo abeenya okhufwa omwoyo, niye Nyasaye, yakhutinyisilia ifwe mukhwitsa khwaTito; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne shikhwali khulwa okhwitsakhwe khwonyene ta, habula khulwa obutinyisii obwa yatinyisibwa nineenywe, olwa yakhuboolela akamahoofu keenywe, nokhwikhuula khweenywe, nobulumilifu bweenywe khulwanje; mana nimeeta okhwikhoya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila kata olwa ndamubeelesia nende ibarwa yanje, shinduutsi mbu ndakhola obubii ta; habula ndali nimbaaranga mbu ndakholile obubii; okhuba enduutsi mbu ibarua eyo yamubeelesia; ne khwali khulwa eshise butswa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano ndikhoya-ne shindikhoyela okhubeelesibwa khweenywe ta, habula mbu okhubeelesibwa khweenywe khwachila nimwikalukhasia; okhuba mwabeelesilibwa munjila eya Nyasaye achama, mbu muleshe okhufwilwa likhuwa liosi khulweefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba eshibeela eshia Nyasaye achama shileera obwikalukhasii obuchooma khubuhonia, niburaleera obwisirali ta; ne eshibeela shieshialo shileera okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba likhuwa lienelo, mbu inywe okhubeelesilibwa munjila eya Nyasaye achama, lole shinga olwa liamuleerela obutinyilifu! Lole shinga olwa liamuleerela obwiteetsi, nende obusinyishi, noburii, namahoofu, nobulumilifu, toto, kata nende eshikwoli! Mukosi mweelolosia shinga olwa muli abeeleleshe mwikhuwa elo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho kata olwa ndamuhandiichila, shindahandiika khulwa eshifune shia oyo owakhola libii ta, kata khulwa oyo owakholelwa libii tawe; habula mbu obutinyilifu bweenywe khulweefwe bumumanyishile inywe abeene imbeli waNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niko akachilile nikhutinyisibwa khurio emioyo; khandi mubutinyisibwi bweefwe khwasangaalile okhushila muno khulwa obusangaafu bwaTito, shichila mwesi muhuluusiye rohoye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nimba nindeeyitsoomia imbeliwe khumakhuwa keenywe, shindamala efwimbwe omurwe ta; ne shinga olwa khwamusunjila amakhuwa kosi mubwatoto, okhwiyitsoomia khweefwe khwosi okhwa ndeeyitsoomia imbeli waTito nakhwo khwanyoolekha nikhuli okhwatoto khurio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.14",
            "verseOrgIds": [
              "2CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obuheelibwe obwomukari nabwo bumushilaanila, olwa yeetsulilanga obuhulili bweenywe mwesi, shinga olwa mwamwinjisia noburii nokhutechela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikhoyelanga likhuwa lino, mbu mukosi endi nobwisiichi khulweenywe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    }
  ],
