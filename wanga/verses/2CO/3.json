    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abakhalabani beIndakano Imbia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khukhachaachile khurio khandi okhwipaaka abeene noho? Nohomba khukhoyeele shinga abandi mbu khube netsibarwa tsiobupaachi khwinywe, kata etsirula khwinywe? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.1",
            "verseOrgIds": [
              "2CO.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ninywe ibarwa yeefwe, eyahandiikwa mumioyo chieefwe, niyimanyishila abandu bosi, niyisoomwa ninabo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.2",
            "verseOrgIds": [
              "2CO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kamanyiishe ebulafu mbu muli ibarwa yaKristo, eya khwakasia ifwe, eyirahandiikwa nobwino ta, habula nende Roho waNyasaye oubeetsangaho mwoyo; khurubaho rwamachina ta, habula khurubaho rwemioyo chieinyama.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obusuubili buno khuli ninabwo imbeli waNyasaye khulwa Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "shikali mbu ifwe khubweefwe khuhela okhubala eshindu shiosi mbu shirula khwifwe, ta; ne obunyali bweefwe burula khuNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi niye owakhunyalila okhuba abakhalabani beindakano imbia, eyirali eyetsinyukuta etsiahandiikwa ta, habula eyaroho; okhuba tsinyukuta tsiiranga, ne roho yihaana obulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obukhalabani bwobufu, obwetsinyukuta etsiasaarwa khumachina, nibuba nibweetsa muluyali, mbu abaana baIsiraeli oburanyala okhurangaala mumoni mwaMusa khulwa oluyali olwomumonimwe, olwali niluhweetsangaho, ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "obukhalabani bwaRoho shibulashila okhuba noluyali? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba obukhalabani obukhukhalachila eshiina nibuba nibuli obwoluyali, obukhalabani obukhubasilia obulunjishi bushila muno okhuba obwoluyali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba toto mwene, obwenobwo obwakholwa obwoluyali, mwikhuwa lino shibwakholwa obwoluyali ta, khulwa oluyali Iwenolwo olwalushila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba obwenobwo obuhweetsangaho nibuba nibwali nende oluyali, obwenobwo oburahwaho ta bushila okhuba obwoluyali.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa khuli nobunaayi obufwana burio, khuboolanga katong'ane, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.12",
            "verseOrgIds": [
              "2CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhuraba shinga Musa, oweefuunikhanga olububi mumoni, mbu abaana baIsiraeli baleshe okhurangaala khubumaliilishi bwolwenolwo olwali niluhwaho, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obuyililisii bwabwe bwali obusiro; okhuba kata okhuula olwa leelo luno, olwa lisoomo lieindakano yakhale lisoomungwa olububi tsana lutong'angaho nilurachinguulwa ta; ne olububi olwo lurusibungwaho muKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuula olwa leelo, olwa akaMusa kasoomwa, olububi lubafuunikhanga emioyo chiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
              "2CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli olwa omundu amushiukhanila Omwami, habwenaho olububi luyinibwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omwami niye Roho mwenoyo; khandi aha Roho wOmwami ali, habwenaho obulekhuule bubeetsangaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.17",
            "verseOrgIds": [
              "2CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ifwe fwesi, olwa khufuunuulwa mumoni, nikhukalusinjia lihunjesi lioluyali lwaNyasaye shinga eshiilolelo, khukalukhasibungwa okhufwana khurio, okhurula khuluyali okhuula khuluyali lundi; ne ako karulanga khuMwami, niye Roho.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.18",
            "verseOrgIds": [
              "2CO.3.18"
            ]
          }
        }
      ]
    }
  ],
