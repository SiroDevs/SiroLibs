            "sid": "2CO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muye. Ne olwa khukholanga ninaye halala fwesi khumusaaya mbu muleshe okhubukula obukoosia bwaNyasaye khulwa butswa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.1",
            "verseOrgIds": [
              "2CO.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba yasunga ari",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khuraba eshiisichirasio ta, mbu obukhalabani bweefwe buleshe okhubuuluulilwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.3",
            "verseOrgIds": [
              "2CO.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mukosi khwilolosia abeene shinga olwa khuli abakhalabani baNyasaye, mubwisimilisii obunji, mubusandibwi, mukamaraba, mumatinyu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.4",
            "verseOrgIds": [
              "2CO.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumakhupache, mukhubohwa, mundiri, mubunyakhani, mukhubameeso, mukhuhonga inzala; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.5",
            "verseOrgIds": [
              "2CO.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mubweleleshe, mubumanyi, mubwifwili, mushisa, muRoho Omutakatifu, mubuheeli obubula obubatsa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.6",
            "verseOrgIds": [
              "2CO.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwikhuwa liobwatoto, nomubunyali bwaNyasaye; khulwa ebimanulwa biobulunjishi khumukhono musaatsa nende khumukhono mukhasi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.7",
            "verseOrgIds": [
              "2CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata nikhupaakwa, kata nikhuchaywa; mufuma imbii nende mufuma indayi; shinga abakaatii, khane nikhuli abatoto; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.8",
            "verseOrgIds": [
              "2CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga abaramanyikha ta, khane nikhufumanga mushialo; shinga abafwitsanga, khane lole, khuli mwoyo; shinga abakuumwa, khane nikhureerwa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.9",
            "verseOrgIds": [
              "2CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga abeshibeela, khane nikhwikhoyanga tsindaalo tsiosi; shinga abamanani, khane nikhuyindihasinjia abanji; shinga ababula ebindu, khane ebindu biosi nebieefwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.10",
            "verseOrgIds": [
              "2CO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "E inywe abaKorinzo, khumubooleele kosi katong'ane; emioyo chieefwe chikaliihe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.11",
            "verseOrgIds": [
              "2CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimutiyiishe mwifwe ta, ne okhutiyikha khuli mumioyo chieenywe abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.12",
            "verseOrgIds": [
              "2CO.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha emuboolelekhwo shinga abaana banje; mbu mungalusilie elihela lirio, neenyu mukhukaliyilie echieenywe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ifwe khuli Ihekalu yaNyasaye oubeetsangaho mwoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.13",
            "verseOrgIds": [
              "2CO.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murabohelwa mwikokolo halala nende ababula obusuubili olwa muraleng'aana ninabo tawe okhuba obulunjishi bunyala burie okhuwinjana nende obumayaanu? Kata obulafu bunyala burie okhusanjilana nende eshiilima? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Kristo anyala arie okhufuchilisania nende Beliari? Kata omusuubili anyala arie okhukabana nende oubula obusuubili? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ihekalu yaNyasaye yinyala yirie okhuhulilisania nende ebifwanani ebiinamilungwa? Okhuba ifwe khuli ihekalu yaNyasaye oubeetsangaho mwoyo; shinga Nyasaye olwa yasunga, mbu Ndalamenyanga mubo, ninjendela hakari mubo; ne ndalaba Nyasaye wabwe, nabo balaba abandu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila Omwami nasunga mbu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.17",
            "verseOrgIds": [
              "2CO.6.17"
            ]
          }
        }
      ]
    }
  ],
