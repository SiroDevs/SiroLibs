    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abo 144,000 baIsiraeli bareebwakhwo ebibalikho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwa ako ndalola abamalaika bane nibasinjiile khukoona tsine tsiosi tsieshialo, nibatiilile emiyeka chine chiosi chieshialo, mbu omuyeka kwosi kwosi kuleshe okhuhuutsa khushialo, kata khunyanza, kata khumusaala kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nindola malaika undi nakulukba okhurula ebukwe, nali nende eshibalikho shiaNyasaye oubeetsangaho mwoyo; naye nalanga abamalaika abo bane abali nibafuchiiliilwe okhwonoonia eshialo neinyanza, nende omwoyo omukhongo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Muroonooniakhwo eshialo, kata inyanza, kata emisaala ta, okhuula olwa khuba nikhureele ebibalikho khubweni bwabasumba baNyasaye weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndahulila obunji bwabo abareebwakhwo ebibalikho, mbu ebikhumila eshikhumi amakhumi kane nabine, abarula mubuli luyia lwabaana baIsiraeli nibareebwakhwo eshibalikho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abokhuluyia lwaYuda, abandu ebikhumila ekhumi nabibili bareebwakhwo eshibalikho; abokhuluyia lwaReubeni, ebikhumila ekhumi nabibili; abokhuluyia lwaGadi, ebikhumila ekhumi nabibili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abokhuluyia lwaAsheri, ebikhumila ekhumi nabibili; abokhuluyia lwaNafutali, ebikhumila ekhumi nabibili; abokhuluyia lwaManase, ebikhumila ekhumi nabibili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.6",
            "verseOrgIds": [
              "REV.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "abokhuluyia lwaSimeoni, ebikhumila ekhumi nabibili; abokhuluyia lwaLawi, ebikhumila ekhumi nabibili; abokhuluyia lwaIsakhari, ebikhumila ekhumi nabibili; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.7",
            "verseOrgIds": [
              "REV.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "abokhuluyia lwaZabuloni, ebikhumila ekhumi nabibili; abokhuluyia lwaYusufu, ebikhumila ekhumi nabibili; nabokhuluyia lwaBenyamini, abandu ebikhumila ekhumi nabibili bareebwakhwo eshibalikho.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukanda omukhongo okwarula mubuli lihanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyutna lwa ako ndahenga, nindola omukanda omukhongo ngwokwo, okwa omundu yesi aranyala okhubala ta, abarula mubuli lihanga, abetsimbia tsiosi, nabandu bosi, netsinimi tsiosi, nibasinjiile imbeli weshifumbi shioburuchi khandi imbeli weLikondi, nibeefwalile tsingubo tsirambi tsindafu, nibali namashindu mumakhono kabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibalanjisia nomwoyo omukhongo, bari",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
