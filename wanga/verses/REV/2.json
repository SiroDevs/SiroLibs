            }
          ]
        },
        {
          "text": "shinga obwa ndaheebwa nende Papa; mana alabaruka nende indabushi yeshibia, natsiaraka shinga tsinyungu tsiomulonji; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
