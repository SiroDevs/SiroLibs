              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa aka muli ninako, mukahandekhwo okhuula olwa ndaleetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
