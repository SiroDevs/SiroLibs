              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako ndahulila amayoosi amakhongo akeengana akomukanda omukhongo mwikulu, nikasunga mbu",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
