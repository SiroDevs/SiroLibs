          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaboola olwakhabili, bari",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
