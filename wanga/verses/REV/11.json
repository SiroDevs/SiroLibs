          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
