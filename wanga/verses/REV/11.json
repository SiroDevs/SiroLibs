          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika womusaafu yakhupa olwikalwe; nichibaho emioyo emikhongo mwikulu, echiaboola mbu",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
