          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wakhabili yakhupa olwikalwe, mana eshifwana shinga eshikulu eshikali muno eshiyiitsanga omulilo nishisukunwa munyanza; eshitonye shiokhutaru shieinyanza niyikwa amabanga; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana eshitonye shiokhutaru shiebilonje ebiomunyanza, ebiali nibili mwoyo, nibifwa; khandi eshitonye shiokhutaru shiamaaro nikatibibwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
