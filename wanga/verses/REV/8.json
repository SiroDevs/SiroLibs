          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wakhataru yakhupa olwikalwe, inyininyini ikhongo niyakukha okhurula mwikulu, niyakha shinga eshitseso niyikwa khushitonye shiokhutaru shiemialo, khandi khubinoko biamatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "neliira lieinyininyini eyo ni Indululusia; eshitonye shiokhutaru shiamatsi nikakwa indululusia; abandu abanji nibafwa khulwa amatsi ako, shichila kali kakwile amalulu papap'pa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
