        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wakhane yakhupa olwikalwe, eliuba nilikhupwa eshitonye shiokhutaru shialio, neshitonye shiokhutaru shiomwesi, neshitonye shiokhutaru shietsinyininyini; mbu eshitonye shiabio shiokhutaru biilime, omubasu kuleshe okhufwa eshitonye shiakhataru mushiteere, kata eshilo shirio.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
