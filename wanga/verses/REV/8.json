              "REV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owambeli yakhupa, niyibaho ifula yamachina nende omulilo, nibitsokaanilemwo amabanga, nibisukunwa khushialo; eshitonye shiokhutaru shieshialo nishisambwa, khandi eshitonye shiokhutaru shiemisaala nichisambwa, khandi obunyasi obubisi bwosi nibusambwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
