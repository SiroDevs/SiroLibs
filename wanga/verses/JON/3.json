          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nalola ebikhole biabwe, shinga olwa bashiukhana okhurula khunjila yabwe imbii; Nyasaye yiyeekalukhasia khububii obwa yali nasunjile mbu yakhabakholela; ne shiyakhola ta.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
