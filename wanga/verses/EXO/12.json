    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nasunjila Musa nende Haruni mushialo shiaMisiri, ari ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.1",
            "verseOrgIds": [
              "EXO.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwesi kuno kulabeetsanga okhuchaaka khwemiesi khwinywe; kulabeetsanga omwesi kwambeli kwomuyika khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.2",
            "verseOrgIds": [
              "EXO.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musunjile abomukhung'aano kwosi kwaIsiraeli muri Omwesi kuno nikuli ekhumi, babukule buli mundu likondi lieshimwamwane, tsinzu tsiabasamwana shinga olwa tsili, khulwa litaala; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.3",
            "verseOrgIds": [
              "EXO.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abelitaala nibaba nibali abatuutu abaranyala okhumala likondi ta, kho ye nende omumenyaniwe ourondokhaane nende inzuye balibukule elala, obukhumi bwabandu shinga olwa buli; india yabuli mundu shinga olwa yihela, nindio mulababasilia khwikondi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.4",
            "verseOrgIds": [
              "EXO.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likondi lieenywe libe elibula obulema, khandi libe elieshimwamwane; mulibukule kata mumakondi kata mumbusi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.5",
            "verseOrgIds": [
              "EXO.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana mulibiishe okhuula omwesi kwenokwo nikuli ekhumi nakhane; mana libukana liosi liemukhung'aano kwaIsiraeli beere amakondi kabwe mungoloobe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.6",
            "verseOrgIds": [
              "EXO.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana babukule khumalasile, babashe khubiyindi biombi biomuliango nende khuliatiilwa, khunzu etsia nabakaliilemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.7",
            "verseOrgIds": [
              "EXO.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balie inyama eyo mushilo shieneshio, niyisambilwe, halala nende emikaate echibulamwo amamela; bachilie nende eliani lilulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.8",
            "verseOrgIds": [
              "EXO.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murachilia imbisi, kata niyiteeshilwe namatsi tawe, habula niyisambilwe; omurwe kwashio halala nende ebilenje nende amala kashio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.9",
            "verseOrgIds": [
              "EXO.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muralekhakhwo eshitonye shiosi shitong'e okhuula mukamba ta; ne eshiakhaba nishitong'ile okhuula mukamba, mushisambe mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.10",
            "verseOrgIds": [
              "EXO.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muchilie muri nanwa; nimwiboyile mubishienje, ebilaaro nibili mubilenje bieenywe, nende indabushi mumukhono; muchilie matetekhana; niyo ipasaka yOMWAMI ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.11",
            "verseOrgIds": [
              "EXO.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndalabira mushialo shiosi shiaMisiri eshilo shieneshio, nikhupa abeekulanda bosi abomushialo shiaMisiri, kata babandu kata bemiruko; ne ndalakhalaka eshiina nimbakuuma abanyasaye bosi baMisiri; nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.12",
            "verseOrgIds": [
              "EXO.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amalasile ako kalamubeela eshilolelo shieenywe khunzu etsia mulabamwo; ne olwa endola amaIasile ndalamubirakhwo, ne shililabaho linyasio khwinywe okhumumulula ta, olwa ekhupa eshialo shiaMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.13",
            "verseOrgIds": [
              "EXO.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyanga yino nayo yilamubeela eshiitsulilo, ne mulachilindanga yibeetsenje lisabo liOMWAMI; munzibulo tsieenywe tsiosi mulachilindanga yibe lisabo khulwa lilako elirahwaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.14",
            "verseOrgIds": [
              "EXO.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo musaafu mulaliitsanga emikaate echibulamwo amamela; kata khunyanga yambeli mularusinjia amamela kosi munzu tsieenywe; okhuba omundu yesi owakhalia omukaate okulimwo amamela okhurula khunyanga yambeli okhuula khunyanga yomusaafu, omundu oyo yakhaarwa arule muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.15",
            "verseOrgIds": [
              "EXO.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yambeli mulabeetsanga nende omukhung'aano omutakatifu, khandi khunyanga yomusaafu omukhung'aano omutakatifu; emilimo chiosi chiosi shichilakholungwa khutsio ta, habula chienechio echichila buli mundu alie, echio chionyene muchikholenje. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.16",
            "verseOrgIds": [
              "EXO.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulabeetsanga nende lisabo liemikaate echibulamwo amamela; okhuba khunyanga yene yino ndarusia emikanda chieenywe shinga echiabaseeri mushialo shiaMisiri; niko akachila mulalindanga inyanga yino munzibulo tsieenywe khulwa lilako elirahwaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.17",
            "verseOrgIds": [
              "EXO.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwesi kwambeli, nikuli ekhumi nakhane, khushise shiamungoloobe, mulalia emikaate echibulamwo amamela, okhuula omwesi olwa kulaba amakhumi kabili nalulala mungoloobe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.18",
            "verseOrgIds": [
              "EXO.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo musaafu amamela kaleshenje okhunyoolekhakhwo munzu tsieenywe; okhuba omundu yesi owakhalia eshindu eshilimwo amamela, omundu oyo yakhaarwa okhurula mumukhung'aano kwaIsiraeli, kata niyakhaba omurende kata niyakhaba omwibule. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.19",
            "verseOrgIds": [
              "EXO.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimulaliitsanga eshindu shiosi eshilimwo amamela ta; mubimenyo bieenywe biosi mulaliitsanga emikaate echibulamwo amamela.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.20",
            "verseOrgIds": [
              "EXO.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa yarumana nalanga abakofu bosi baIsiraeli, nabasunjila ari Mutsie bulaano, mubukule amakondi kebimwamwane, abomunzu tsieenywe shinga olwa bali, nimwira khulwa ipasaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.21",
            "verseOrgIds": [
              "EXO.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mubukule amasaafu kamabinu, mwine mumalasile akali mulukaye, mukhupe khuliatiilwa nende khubiyindi biombi amalasile akali mulukaye; mana omundu yesi mwinywe aleshe okhurula mumuliango kweinzuye okhuula olwa nabushie mutsuli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.22",
            "verseOrgIds": [
              "EXO.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI yeetsa okhubira mbu akhupe abaMisiri; ne olwa alalolanga amalasile nikal i khuliatiilwa nende khubiyindi biombi, OMWAMI alabirakhwo khumuliango okwo, narafuchiilila owonooninjia oyo okhwinjila munzu tsieenywe mbu amukhupe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.23",
            "verseOrgIds": [
              "EXO.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulalindanga likhuwa lino libe lilako khwinywe khandi khubaana beenywe ebisoni nebisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.24",
            "verseOrgIds": [
              "EXO.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa muliba nimuulile khushialo eshia OMWAMI alamuheelesia, shinga olwa yaboola, mulalondanga obukhalabani buno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.25",
            "verseOrgIds": [
              "EXO.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abaana beenywe balimureebanga bari Eshisina shiobukhalabani buno nishiina khwinywe? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.26",
            "verseOrgIds": [
              "EXO.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulaboolanga muri Nibwo omusango kwapasaka yOMWAMI, okhuba yabira khutsinzu tsiabaana baIsiraeli muMisiri, olwa yakhupa abaMisiri, nahonokosia tsinzu tsieefwe. Abandu nabo nibabunamin emirwe nibamwinamila OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.27",
            "verseOrgIds": [
              "EXO.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibatsia nibakhola bario; shinga OMWAMI olwa yali niyalachile Musa nende Haruni, nindio bakhola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Linyasio eliahelelesia; Okhufwa khwabeekulanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.28",
            "verseOrgIds": [
              "EXO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushilo hakari OMWAMI yakhupa abeekulanda bosi mushialo shiaMisiri, okhurula khumwikulanda waFarao mwene oweekhala khushifumbi shiobwami okhuula khumwikulanda womuhambe owali nali mumbohe yobwina; nende ebieebulwa ebiambeli biosi biemiruko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.29",
            "verseOrgIds": [
              "EXO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Farao nabuukha mushilo, ye nende abasumbabe bosi, nende abaMisiri bosi; nitsibaho tsimbungu tsinyinji muMisiri; okhuba shiyaliho inzu yosi eyiralimwo omufu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.30",
            "verseOrgIds": [
              "EXO.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yarumana nalanga Musa nende Haruni mushilo, naboola mbu Tsie, rule mubandu banje, inywe halala nende abaana baIsiraeli; tsie, mumukhalabanile OMWAMI, shinga olwa musunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.31",
            "verseOrgIds": [
              "EXO.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukule ebiayo bieenywe khandi nende tsing'ombe tsieenywe, shinga olwa musunjile, muhweho; ne nasi, musabile ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.32",
            "verseOrgIds": [
              "EXO.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaMisiri nibabalunyia abandu, nibabeelusia mushialo matetekhana; nibasunga bari Fwesi khuli butswa abafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.33",
            "verseOrgIds": [
              "EXO.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nabo nibabukula eshinokho shiabwe nishirashiareebwamwo amamela ta, nibaboyile tsinyungu etsia banyobelangamwo munguoo tslaowe, nibeetuu kha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.34",
            "verseOrgIds": [
              "EXO.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola shinga Musa olwa yali nasunjile, nibasaba abaMisiri ebimili bieifeetsa, nende ebimili bieitsahaabu, nende ebiifwalo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.35",
            "verseOrgIds": [
              "EXO.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naye nachila aba Misiri nibabakoosia abandu abo, nibabaheelesi ebin basaba. Nilwo olwa bayaaya abaMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalsiraeli barula eMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.36",
            "verseOrgIds": [
              "EXO.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana balsiraeli nibachenda okhurula eRamasesi okhuula eSukotsi, abandu abasaatsa shinga ebikhumila ebikhumi bisasaba abachenda namakulu, khandi nende abakhasi nabaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omukanda omukhongo kwabandu nbali nibatsokatsokaane batikulukha ninabo; nende ebiayo, nende tsing'ombe, emiruko eminji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibafumbuukha eshinokho eshia bnli nibarulile ninashio eMisiri emikaate echibulamwo amamela, okhuba shiali nishishili okhureebwamwo nmamela; shichila beelusibwa eMisiri, nibaranyala okhwiyingoyia ta, kata shibnli nibakasiye eshiokhulia tawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhumenya khwabaana baIsiraeli, olwn bamenya muMisiri, khwali okhwemiyika ebikhumi bine nende amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa emiyika chiali nichihweele ebikhumi bine nende smakhumi kataru, khunyanga yeneyo emikanda chiosi chiOMWAMI shinga echiabaseeri chiarula mushialo shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshio shiali eshilo eshiokhulinda muno khuMWAMI, olwa yabarusia mushialo shiaMisiri; kho khubaana baIsiraeli bosi shino nishio eshilo shiokhulindiilila muno khuMWAMI, munzibulo tsiabwe tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako keipasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nasunjila Musa nende Haruni ari Amalako keipasaka ngakano; mbu omundu omurende yesi shialaliakhwo tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula omusumba womundu yesi, owakulwa amapeesa, olwa wakhaba nomushebile, nolwn alaliitsangakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurende kata omukholi womushaara shibalaliakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilaliilungwa munzu ndala; shiolabukulakhwo khunyama eyo, warusia elwanyi, ta; kata shiolafunaka likumba liayo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
            "verseOrgIds": [
              "EXO.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EXO 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukhung'aano kwosi kwaIsiraeli balakholanga bario. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.47",
            "verseOrgIds": [
              "EXO.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EXO 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omurende oumenyanga mwinywe niyeenya okhumukholela OMWAMI ipasaka, kho abandube bosi abeshisaatsa bashebwe, mana asite ahambi nachikhola; mana alabeetsanga shinga omwibule; nebutswa omundu omusinde araliakhwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.48",
            "verseOrgIds": [
              "EXO.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilako lilabeetsanga elala khumwibule, nende khumurende oumenyanga mwinywe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EXO 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli bosi nibakhola bario; shinga OMWAMI olwa yalaka Musa nende Haruni, nilwo olwa bakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yeneyo, OMWAMI yarusia abaana baIsiraeli mushialo shiaMisiri, emikanda chiabwe shinga echiabaseeri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
