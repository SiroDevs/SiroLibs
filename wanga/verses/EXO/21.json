            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omundu olwa aba nafuunula obwina, kata omundu olwa aba nayaba obwina narabufuunikha ta, mana ing'ombe kata isishili niyikwamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
        },
        {
          "name": "verse",
