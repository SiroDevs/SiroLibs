              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa omundu aba nakhupa omusumbawe kata omukholiwe omukula oweshikhasi imoni, nachisasia; kho amulekhuule atsie khulwa imoniye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata naba namuupa omusumbawe kata omukholiwe omukula oweshikhasi eliino, nalio nilikhuulikha, kho amulekhuule atsie khulwa eliinolie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako khukemiruko nabeene chio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
