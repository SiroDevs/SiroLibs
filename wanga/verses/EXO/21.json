          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omwene bwina obwo arunje; aheelesie omwene muruko okwo amapeesa tsana, mana omuruko okufwile kulabe okukwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
