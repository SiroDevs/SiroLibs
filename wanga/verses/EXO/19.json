    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaIsiraeli enashikulu shiaSinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omwesi kwalaba okwakhataru okhurula olwa abaana baIsiraeli bali nibarulile mushialo shiaMisiri, khunyanga yeneyo boola mushitsiimi shiaSinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibarulile eRefidimu, nibamalile okhuula mushitsiimi shiaSinai, bakhoma ikambi yabwe mushitsiimi; ebweneyo abaIsiraeli nibakhoma ikambi yabwe imbeli weshikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa yatikulukha ewaNyasaye, OMWAMI namulanjisia okhurula mushikulu, ari Kano niko aka olasunjile inzu yaYakobo, noboolela abaana baIsiraeli; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.3",
            "verseOrgIds": [
              "EXO.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muluutsi aka ndabakholela abaMisiri, khandi shinga olwa ndamuchinga khumbaha tsietsinditsu nimuleera ewanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.4",
            "verseOrgIds": [
              "EXO.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, nimuba nimuhulila amakhuwa kanje toto, nimulinda indakano yanje, kho mulabeetsanga khwisie omwandu kwolukoosi, mumbia tsiosi tsiabandu; okhuba eshialo shiosi pe neshianje; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.5",
            "verseOrgIds": [
              "EXO.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neenyu mulabeetsanga abakuhani aboburuchi bwanje, lihanga litakatifu. Kano niko amakhuwa aka olaboolela abaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa yatsia narumana okhulanga abakofu babandu, nara imbeli wabwe amakhuwa ako kosi aka OMWAMI yali namulachile. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nabo nibakalusia bosi halala, bari Kosi aka OMWAMI asunjile, khulakakhola. Naye Musa nayilila OMWAMI amakhuwa kabandu abo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa mbu Lola, ekhwitsila mwileesi lisiro, mbu abandu bahulilenje olwa emboolana ninawe, khandi mbu bakhusuubilile inziayo. Musa naboolela OMWAMI amakhuwa kabandu abo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa ari Otsie ewa abandu bali, obaahule leelo nende mukamba, nabo boosie Lsingubo tsiabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "beerecheshele inyanga yPkhataru; shichila khunyanga yakhataru OMWAMI yakheeshe mumoni tsiabandu bosi khushikulu shiaSinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe osirile abandu tsinzakho tsimbeka tsiosi, nosunga mbu Mwilinde, muleshe okhuniina mushikulu, kata okhutiilakhwo khundulo washio ta; omundu yesi outiilakhwo khushikulu okhuula yeerwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukhono kwomundu yesi kuleshe okhumutiilakhwo, ne okhuula alaswe namachina kata nebisele; omundu oyo aleshe okhutong'a mwoyo, kata omuruko nakwo kurio; olwika olwa lukhupwa, nilutsiililila, basite ahambi khushikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.13",
            "verseOrgIds": [
              "EXO.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa yeekha okhurula mushikulu, okhuula ewa abandu bali, niyaahula abandu; nabo niboesia tsingubo tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yasunjila abandu ari Mube nimwirechesheele inyanga yakhataru; murasita ahambi nomukhasi yesi ta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yakhataru, nibushieele, okhukukuma khwaliho, nende tsimbenu nende lileesi lisiro khushikulu, nende oluyoka Iwolwika, olukhongo muno; abandu bosi abali mukambi nibatechela. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa yarusia abandu mukambi okhumwakaanila Nyasaye; nabo nibasinjila mundaalilal weshikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
            "verseOrgIds": [
              "EXO.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshikulu shiaSinai shiatuuma omwosi, okhuba OMWAMI yeeshela khushio mumulilo; omwosi kwashio nakwo nikutuumuukha shinga omwosi kwelirumbi, eshikulu shiosi nishirenga muno. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa oluyoka Iwolwika Iweemeeta nilutsiililila, Musa yali naboolanga, khandi Nyasaye yali nakalusinjia nomwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyeeshela khushikulu shiaSinai, khubutenjel bweshkulu; mana OMWAMI nalanga Musa aniine khubutenje bweshikulu; naye Musa naniina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Musa ari Yikha, obasiomele abandu, baleshe okhumaala boole ewOMw okhurangaala; abanji khubo bakhafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abakuhani nabo, abasitanga ahambi nende OMWAMI, beeyahule, OMWAMI aleshe okhubarulilakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nasunjila OMWAMI ari Abandu shibanyala okhutikulushila khushikulu shiaSinai ta; okhuba okhusiomeele, ori Sirila eshikulu tsinzakho tsimbeka tsiosi, noshiahula. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusinjila ari Tsia, wishe, khandi olaniine, halala nende Harunine abandu nende abakuhani, bo baramaala okhutikulukha ewOMWAMI ta; yakhabarulilakhwo ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa yeekha ewa abandu bali, nababoolela ario.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
          }
        }
      ]
    }
  ],
