    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibachaaka oluchendo okhurula eElimu, abomukung'aano kwosi kwabaana baIsiraeli nibatsia niboola khushitsiimi shiaSini, eshili hakari waElimu nende Sinai, omwesi kwakhabili okhurula olwa barula mushialo shiaMisiri olwa kwali ekhumi nakharaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.1",
            "verseOrgIds": [
              "EXO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhung'aano kwosi kwabaana baIsiraeli nibabuuluulila Musa nende Haruni mushitsiimi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.2",
            "verseOrgIds": [
              "EXO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana baIsiraeli nibabasunjila bari Khane bwakhabeele bulayi nikhwakhafwile khulwa omukhono kwOMWAMI muMisiri olwa khweekhalanga khutsiyamuunyu, olwakhwaliitsanga ebiliibwa nikhwikura; okhuba mukhurusiyeyo nimukhuleera mushitsiimi shino, okhwira libukaana lino liosi nende inzala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.3",
            "verseOrgIds": [
              "EXO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI namusunjila Musa mbu Lola, ndalamukwisilia ebiliibwa shinga ifula okhurula mwikulu; nabo abandu balarulanga bul i nyanga okhutoola omukabo kweinyanga, mbu mana embateeme, nibaba nibeetsa okhwichendelesia mumeebaalo kanje nohomba ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.4",
            "verseOrgIds": [
              "EXO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yakhasasaba balakasia bienebio ebia baleera, nabio bilaba ebinji okhushila ebia i atoolanga buli nyanga akhandi khabili. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
            "verseOrgIds": [
              "EXO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nende Haruni nibasunjila abaana balsiraeli bosi bari Nibwakheela, mwitsa okhumanya shinga olwa yabeele OMWAMI owamurusiye mushialo shiaMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi nibwaklhashia, mwitsa okhulola oluyali lwOMWAMI, shichila ahulilanga okhubuuluula khweenywe okhwa mumubuuluulilanga OMWAMI; neefu nifwe beena, aba mubuuluulilanga? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Musa naboola mbu Olwa OMWAMI alamuheelesinjia inyama mungoloobe mbu mulie, khandi mutsuli obusuma obumwikusia, okhuba OMWAMI ahulilanga okhubuuluula khweenywe okhwa mumubuuluulilanga kho nifwe beena? Okhubuuluula khweenywe shikhuli khwifwe ta, habula khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye yahaana imana netsisindu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa namubiila Haruni ari Sunjila abomukhung'aano kwosi kwabaana baIsiraeli ori Musite ahambi, imbeli wOMWAMI; okhuba ahuliile okhubuuluula khweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Haruni yali nashisunjila abomukhung'aano kwosi kwabaana baIsiraeli, bahenga enashitsiimi, ne lola, oluyali lwOMWAMI lwaloleshea mwileesi tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusun jila Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.11",
            "verseOrgIds": [
              "EXO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embuliile okhubuuluula khwabaana baIsiraeli; 'basunjile ori Nibwakheela mulalia inyama, khandi nibwakhashia muleekura obusuma; mana mulamanya shinga olwa endi OMWAMI Nyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibwakheela tsisindu tsiatikulukha nitsimaama ikambi yosi; khandi olwa bwashia mutsuli, eliime liali niliamile khwiloba okhubotokhana ikambi yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
            "verseOrgIds": [
              "EXO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eliime elo eliali niliamile olwa liamala niliamulukha, lola, orundu orupaapale shinga tsinzubu ndworwo, khwiloba lieshitsiimi, orupaapale shinga isakitu khwiloba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.14",
            "verseOrgIds": [
              "EXO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaana baIsiraeli balola, bareebana bari Nishiina shino? Okhuba shibashimanya ta. Musa nababoolela ari Nibwo obusuma obwa OMWAMI amuheele mulie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.15",
            "verseOrgIds": [
              "EXO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lino nilio elia OMWAMI alachile, mbu Mutoole, buli mundu okhuliakhwe shinga olwa khuli, indubil khubuli mundu, obukhumi bwabandu beenywe shinga olwa buli, nilwo olwa mulabukulenje, buli mundu khulwabo abali mwiheemalie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola bario, abandi nibatoola okhushilaasia, abandi nabo nibaleemia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bachela mundubi, owatoola ebinji shiyali nende ebishilaanile ta, kata owatoola ebitiiti shiyaleema ta; bali nibatoolile buli mundu okhuliakhwe shinga olwa khwali. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nababiila ari Omundu yesi arabilekha bikone tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shibamuhulila Musa ta; habula abandi khubo balekhakhwo eshitonye shikone, nashio nishikwa tsinyende, nishihunya; Musa naye nabasinyishila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bashitoolanga mutsuli buli mutsuli, buli mundu okhuliakhwe shinga olwa khwali; ne omubasu olwa kwalulanga, shiasalulukhanRa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yakhasasaba batoola ebiliibwa ebio ebihela khandi khabili, tsindubi tsibili khubuli mundu; abeemilisi bosi bomukhung'aano nibeetsa nibamuboolela Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila ari Lino nilio elia OMWAMI yasunjile mbu Mukamba nomuhongo; neisabato indakatifu khuMWAMI; samba ebia mwenyile okhusamba, nimuteekha ebia mwenyile okhuteekha; ne ebitong'a biosi mwibiishile, bilindwe okhuula mukamba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabibiikha okhuula mukamba shinga Musa olwa yababiila; nabio nibirahunya ta, kata inyende yosi okhubamwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa naboola mbu Mulie bienebio leelo; okhuba leelo neisabato yOMWAMI; leelo shimulabinyoola ebulafu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.25",
            "verseOrgIds": [
              "EXO.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsisasaba mulabitoolanga; ne inyanga yomusaafu neisabato; khunyanga eyo shibilabeetsangaho tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.26",
            "verseOrgIds": [
              "EXO.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yomusaafu abandi khubo barula nibatsia okhutoola, nibaranyoola eshindu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.27",
            "verseOrgIds": [
              "EXO.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI yamusunjila Musa ari Mulakhayanga okhuhulila amalako kanje nende ameebaalo kanje okhuula liina? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.28",
            "verseOrgIds": [
              "EXO.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, okhuba OMWAMI yamuha isabato, niko akachila namuheele khunyanga yakhasasaba ebiliibwa bietsindaalo tsibili; mwikhale buli mundu kawuwe, omundu yesi aleshe okhurula habunduwe khunyanga yomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.29",
            "verseOrgIds": [
              "EXO.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu nibahuluukha khunyanga yomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.30",
            "verseOrgIds": [
              "EXO.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abeinzu yalsiraeli babikulikha eliira mbu Imana; yali indafu shingana imwo yamabele keikhumba, ne yali neshiuya shingana ebisikuti ebiatsokasibwamwo obuushi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nasunga mbu Lino nilio elia OMWAMI alachile, mbu indubi yayo yibiishilwe abetsinzibulo tsieenywe; mbu balole obusuma obwa ndamuliisinjia mushitsiimi, olwa ndamurusia mushialo shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa namubiila Haruni ari Bukula inyungu, oremwo imana eyihela indubi ndala, ore imbeli wOMWAMI, yibiishilwe tsinzibulo tsieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa OMWAMI yamulaka Musa, nilwo olwa Haruni yachira imbeli wOburumbusi, yibiikhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baIsiraeli baliitsanga imana emiyika amakhumi kane, okhuula olwa boola mushialo eshiamenywamwo; batsiililila okhulia imana okhuula olwa boola khunzakho tsieshialo shiaKanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
