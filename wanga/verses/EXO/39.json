            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 39:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhola nende eshimuli eshipaarale shiolusimbi olutakatiiu eshio shieitsahaabu inzeleleshe, nibahandiika khushio lihandiiko shinga okhusaarwa khwelichina, mbu OMUTAKATIFU wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibashibohakhwo olutsaha lweibuluu, okhushiboha khushilemba ikulu; shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebikholelo bieshimeyo biosi biamalilisibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emilimo chiosi chieshimenyo shieliheema liokhwakaana chiamalilisibwa chirio; abaana baIsiraeli nibakhola kosi shinga OMWAMI olwa yamulaka Musa; nilwo olwa bakhola.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleerela Musa eshimenyo, nende liheema, nebichio biashio biosi, ebitiili biashio, nebitiisi biasl io, netsisheti tsiashio, netsisiilo esiashio, nebichibi biashio; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eshifuunikho shiamaseelo kamamiiku akanyushilwa iranji iranzayi, neshiiuunikho shiamaseelo kandi amanyushe, neingubo ishinga yolwichi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "lisanduku lioburumbusi, netsinyanzo tsialio, nelitisilo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "imeesa, nebindu biayo biosi, nomukaate kwokhubaho; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshichibi shietsitaha eshieitsahaabu inzeleleshe, netsitaha tsiashio, nitsio tsitaha etsiokhwanzwakhwo, nebichio biashio biosi namafura ketsitaha; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eshimalilo shieitsahaabu, namafura akokhutsushiilila, namalesi kelibuuliesi keisuuswa, nolwichi Iwomuliango kweliheema; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshimalilo shiomukasa, nolukhanda lwashio Iwomukasa, netsinyanzo tsiashio, nebichio biashio biosi; nolutaabo neshichibi shialwo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsingubo tsinzeleesia tsiolwanyi, netsisiilo tsialwo, nebichibi bialwo, nolwichi Iweshilibwa shiolwanyi, nemikoye chialwo, nebibambo bialwo, nende biosi ebiokhwikhoonyela mubukhalabani bweshimenyo, khulwa liheema liokhwakaana; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebiifwalo ebialukhwa bulayi ebiokhukhalabanila habundu ahatakatifu, nebiifwalo ebitakatifu ebiaHaruni omukuhani, nebiifwalo biabaanabe, ebiokhukhalabana mubukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 39:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosi aka OMWAMI yamulaka Musa shinga olwa kali, nilwo olwa abaana baIsiraeli bakhola emilimo chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa nalola emilimo chiosi, ne lola, bali nibachikholile; Musa nabasabila ikhabi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        }
      ]
