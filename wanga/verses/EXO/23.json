    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orarumbula likhuwa likhaya elia ohuliile ta; orasanjilana nende omumayaanu okhurumbula akobuloli bwobuchiishi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oralondana nomukanda okhukhola obubii ta; kata orarumbula akobuloli mushiina nokotola okhulondana nomukanda, okhushiamia obukhalachi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata oramuterelal omumanani mushifuneshie ta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa obukaana nende ing'ombe kata isishili yomusukuwo niyikorile, okhuula ochimukalusilie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noba nolola isishili ya oyo oukhukiya niyikonile hasi niyisitoheelwe nomusiiko kwayo, noreenya okhumukhoonya okhuchilekhuula ta, okhuula omukhoonye okhuchilekhuula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orashiamia obukhalachilwi bwomumananiwo mushifuneshie ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.6",
            "verseOrgIds": [
              "EXO.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiyahukhasie ehale nende likhuwa liobubeeyip; ne omundu omulunjishi oubula eshikha, oramwira tawe; shichila shindalamulanga omumayaanu mbu omulunjishi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.7",
            "verseOrgIds": [
              "EXO.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi orabukulakhwo eshiomufuusi shiosi ta; shichila eshiomufuusi shibabofusinjia abalolanga, nishishiamia amakhuwa komulunjishi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.8",
            "verseOrgIds": [
              "EXO.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramumiina omundu omurenoe ta; okhuba inywe mwamanya omwoyo kwomurende, shichila mwalinji abarende mushialo shiaMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akomuyika kwomusaafu, nakaSabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiyika chisasaba oraachenje mwilobalio nende okhuchesa ebiamo biamwo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelmtswa mumuyika kwomusaafu oliibale lihuluushe nilikona butswa; mbu mana abamanani abomubandubo baliitsenje; ne ebia balekha tsisolo etsiomubulimo tsilie. Khandi okholele omukundakwo kwemitsabibu ori nanwa, khandi nende omukundakwo kwemitseituni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsisasaba okholenje emilimochio, ne khunyanga yomusaafu ohuluushenje; mbu mana ing'ombeyo nende isishiliyo tsihuluushe, khandi mbu omwana womukholiwo weshikhasi, nende omucheni yesi, nabo basakuluushe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumakhuwa kosi aka ndamusunjiile, mube meeso; nimurarumbulaameeraabanyasayebandi ta, kata kaleshe okhuhuliilikha mumunwakwo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amasabo kataru akalachtlisibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukholelenje lisabo khataru mumuyika. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhole lisabo liemikaate echibulamwo amamela; tsindaalo musaafu olaliitsanga emikaate echibulamwo amamela, shinga olwa ndakhulaka, khunduukho eyomumwesi kwaAbibu, shichila mukwenokwo warula eMisiri; omundu yesi aleshe okhulolekha imbeli wanje nali butswa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi lisabo lielichesa, ebirongole ebirula mukhunyakhar akhwo, ebia oraakanga mumukunda; khandi nende lisabo liokhwinjisia, omuyika olwa kuhweele, olwa okhung'aasinjia ebiokhunyakhanakhwo mumukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuula khataru mumuyika abeshisaatsabo bosi baloleshenje imbeli wOMWAMI NYASAYE.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orahaana amalasile akomusango kwanje kalala nende omukaate okulimwo amamela ta; kata amasinya kelisabo lianje kaleshe okhusikala kakone okhuula mukamba ta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiambeli khubirongole ebielilobalio, obileerenje munzu yOMWAMI Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orateekha eshimeeme mumabeele kanyina ta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, eruma malaika imbeliwo, okhukhulindanga khunjila, nokhukhuusia habundu tsana aha ndakhukasiliye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.20",
            "verseOrgIds": [
              "EXO.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirechelesinjie nimuhulila aka aboola; muramukhaya ta; okhuba shialamuleshelanga obukhayi bweenywe ta; shichila eliira lianje lili muye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.21",
            "verseOrgIds": [
              "EXO.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noba nohulila aka aboola toto, nokhola kosi aka emboola; mana ndalabeetsanga omusuku wabasukubo, nimbayingania abakhuyinganinjia iwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.22",
            "verseOrgIds": [
              "EXO.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba malaika wanje alakhwimilila nakhuusia euabaAmori, nabaHiti, nabaPerizi, nabaKanaani, nabaHiwi, nende abaYebusi; nasi ndalabaakamja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.23",
            "verseOrgIds": [
              "EXO.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oreenamilanga abanyasaye babwe ta, Ieata okhubakhalabanila, kata okhukhola ebikhole shinga ebiabwe ta; nebutswa obakwisilie elala, nosasaka tsisiilo tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.24",
            "verseOrgIds": [
              "EXO.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mukhalabanilenje OMWAMI Nyasaye weenywe, naye alabiheelesinjia ikhabi ebiliibwa bieenywe, nende amatsi keenywe; khandi ndalarusinjia obulwale okhurula hakari mwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.25",
            "verseOrgIds": [
              "EXO.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiaabaho ouhuusa omwana kata oukumbahala mushibalashio ta; ndiliusia habwene obukhumi bwetsindaalolsio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.26",
            "verseOrgIds": [
              "EXO.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalarumanga oburiisii bwanje imbeliwo, ningoyaasia abandu bosi ewa otsiitsanga, ninjila abasukubo bosi nibakhufutarila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.27",
            "verseOrgIds": [
              "EXO.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalaruma amahalamba imbehwo, nako kaleelusia abaHiwi nabaKanaani nende abaHiti imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.28",
            "verseOrgIds": [
              "EXO.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shindalabeelusia imbeliwo mumuyika mulala ta; eshialo shiakhakwa likunda, khandi tsisolo etsiomubulimo tsiakhakhwinjiyila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.29",
            "verseOrgIds": [
              "EXO.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalabeelusinjia imbeliwo hatiiti hatiiti, okhuula olwa olaba niwinjiihe nolia obulaame bweshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.30",
            "verseOrgIds": [
              "EXO.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalaraho olwakhokvo okhurula khuNyanza Inzakhanyu okhuula khunyanza yabaFilisiti, khandi okhurula khushitsiimi okhuula khumwalo kwaEufurate; shichila ndalahaana abamenyanga mushialo eshio mumukhonokwo; nawe olabeelusiaimbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.31",
            "verseOrgIds": [
              "EXO.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oralia ninabo omuuma kwosi ta, kata nabanyasaye babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.32",
            "verseOrgIds": [
              "EXO.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleshe okhumenya mushialoshio; bakhachile niunzonoonela; shichila noba nokhalabanila abanyasaye babwe, liakhaba omubero khwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.33",
            "verseOrgIds": [
              "EXO.23.33"
            ]
          }
        }
      ]
    }
