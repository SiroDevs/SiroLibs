    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukholi bwelisanduku",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Bezaleli yakhola lisanduku elo liomusaala kwomupeeli, oburambi bwalio bwali emikhono chibili neinusu, obuchiikha omukhono neinusu, nobuchinguukhu omukhono neinusu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalifuuma itsahaabu inzeleleshe mukari nende ikulu walio, nalikholela olulika Iweitsahaabu okhulibotokhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.2",
            "verseOrgIds": [
              "EXO.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasalulusia itsahaabu okhulikholela tsingaka tsine, mumakuru kalio kane; mbu tsingaka tsibili khulubeka lwalio lulala, netsingaka tsibili khulubeka lwalio olundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.3",
            "verseOrgIds": [
              "EXO.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola tsinyanzo tsiomupeeli, natsifuuma itsahaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeenjisia tsinyanzo mungaka tsana etsiali mumbafu welisanduku, okhuchinga lisanduku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.5",
            "verseOrgIds": [
              "EXO.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende litisilo lieitsahaabu inzeleleshe; oburambi bwalio bwali emikhono chibili neinusu, khandi obuchiikha bwalio omukhono neinusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende abakerubi babili beitsahaabu; yabakholela emilimo chiobwiraanyi, khundulo tsibili tsielitisilo eyi nende eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukerubi mulala khundulo elubeka, nomukerubi mulala khundulo eundi; yakhola abakerubi abo eshindu shilala nende litisilo liene khundulo tsibili tsialio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakerubi abo nibabambula tsimbaha tsiabwe ikulu, nibafwimba litisilo netsimbaha tsiabwe, nibahengana mumoni nomumoni; mumoni mwabakerubi nimuhenga litisilo elo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukholi bweimeesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola imeesa yomusaala kwomupeeli; oburambi bwayo bwali emikhono chibili, obuchiikha bwayo omukhono mulala, nobuchinguukhu bwayo omukhono neinusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachifuuma itsahaabu inzeleleshe, nachikholela olulika Iweitsahaabu okhuchibotokhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachikholela olubaho olwachelwa obubambalifu bwalwo obuhela eshikalo okhuchibotokhasia, nakholela olubaho olwo olulika Iweitsahaabu okhulubotokhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasalulusia itsahaabu okhuchikholela tsingaka tsine, nara tsingaka etsio mukoona etsio tsine etsili khubilenje biayo bine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsingaka tsiali ahambi khulubaho olwo, niho habundu wetsinyanzo etsiokhuchinga imeesa tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhola tsinyanzo tsiomupeeli, natsifuuma itsahaabu, okhuchinga imeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende ebindu ebiali khumeesa, mbu tsingaye tsiayo, nemiikho chiayo, nebisanda biayo, nemiendo chiayo, echiokhutsushiilila, ebieitsahaabu inzeleleshe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukholi bweshichibi shietsitaha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola eshichibi shietsitaha eshieitsahaabu inzeleleshe; eshichibi eshio shietsitaha shiali emilimo chiomwiraanyi, eshishienje shiene nende eshirundu; ebikwata biashio, mbu amakanikha nende ebimuli, biali eshindu shilala uinashio; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi kalikhwo amasaka kasasaba akarula mumbafu washio; amasaka kataru keshichibi shietsitaha karulila elubeka lulala, khandi amasaka kataru keshichibi shietsitaha karulila elubeka lundi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebikwata bitaru ebiakholwa shinga okhumulikha khwomulusi mwisaka elala, likanikha neshimuli; khandi ebikwata bitaru ebiakholwa shinga okhumulikha khwomulusi mwisaka lindi, likanikha neshimuli; amasaka kosi kasasaba akarula mushichibi, kari nanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomushichibi shiene ebikwata bine ebiakholwa shinga okhumulikha khwomulusi, amakanikha kakwo nende ebimuli biakwo; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "likanikha hasi wamasaka kabili elili eshindu shilala ninashio; khandi likanikha hasi wamasaka kabili elili eshindu shilala ninashio; khandi likanikha hasi wamasaka kabili elili eshindu shilala ninashio; khulwa amasaka ako kasasaba akarula mushichibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakanikha kako nende ebimuli biako biali eshindu shilala ninashio; biosi biali omulimo mulala kwomwiraanyi, okweitsahaabu inzeleleshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola tsitaha tsiashio, musaafu, namahana kashio, netsindaabo tsiomulilo, ebieitsahaabu inzeleleshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yashikhola itsahaabu inzeleleshe eyachelwa italanda, nende ebichio biashio biosi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukholi bweshimalilo shiamalesi kelibuuliesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yakhola eshimalilo shiamalesi kelibuuliesi, shiomusaala kwomupeeli; oburambi bwashio bwali omukhono mulala, khandi obuchiikha bwashio omukhono, tsimbeka tsiosi tsine nitsihelana; obuchinguukhu bwashio nabwo bwali emikhono chibili; tsinzika tsiashio tsiali eshindu shilala ninashio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashifuuma itsahaabu inzeleleshe hekulu washio, netsimbeka tsiashio tsiosi, nende tsinzika tsiashio; nashikholela olulika Iweitsahaabu okhushibotokhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.26",
            "verseOrgIds": [
              "EXO.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yashikholela tsingaka tsibili tsieitsahaabu hasi wolulika lwashio, mumbafu tsiashio tsibili, khumbeka tsiashio tsibili, nitsiba habundu wetsinyanzo etsiokhushichinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.27",
            "verseOrgIds": [
              "EXO.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola tsinyanzo etsio tsiomupeeli, natsifuuma itsahaabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
            "verseOrgIds": [
              "EXO.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amafura kokhutsushiilila namalesi kelibuuliesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
