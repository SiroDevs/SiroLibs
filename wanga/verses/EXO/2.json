{
  "id": "EXO.2",
  "number": "2",
  "bookId": "EXO",
  "reference": "Okhurula 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "EXO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwibulwa khwaMusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho omundu undi owomunzu yaLawi yarula, naleera omukhaana undi khubaLawi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi oyo nahela inda, niyeebula omwana omusiani; nolwa yamulola, shinga olwa ali omwana omulayi, yamubisa emiesi chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yakhaywa okhumubisa khandi, yamubukulila akhasafina khamaturu, nachihoomela ilamu nende inimbo; namura omwana mubwenomwo narenjekha mwise khundulo womwalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhaana wabwe omwana oyo naye nasinjila ehalekhwo, mbu amanye akeetsa okhumukwila. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhaana waFarao yakholomokha okhwisinga mumwalo; mana nalola akhasafina akho mwise, naruma omukhaana omukhalabaniwe okhukheenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhafuunula, nalola omwana; ne lola, omwana nalira. Naye namutiililwa eshisa, nasunga mbu Uno nimulala khubaana babaHeburania. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukhaana wabwe omwana oyo namureeba omukhaana waFarao ari Enzie ekhulanjile omuleli owokhubakhasi abaHeburania, akhunuunilie omwana uno? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhaana waFarao namusunjila mbu Khatsie. Omukhaana naye natsia nalanga nyinamwana omwana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukhaana waFarao namusunjila mbu Tsia nomwana uno, unuunilinjie, nasi ndalakhuheelesia omurungokwo. Omukhasi naye nabukula omwana namunuuninjia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana nakhula, mana omukhasi oyo namuleera ewomukhaana waFarao, naba omwanawe. Naye namukulikha eliira mbu Musa; nasunga mbu Shichila ndamukhwesa nimurusia mumatsi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa yeelushila eMidiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga yindi, olwa Musa yali namalile okhukhula, yarula natsia ewa abandu babwe bali, nalola obusiro bwemisiiko echia bareebwakhwo; ne yalola omuMisiri nakhupa omuHeburania, omuluyia wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahenga eyi nende eyi, ne olwa yalola mbu omundu abulaho, yeera omuMisiri, namubisa mumuyeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi inyanga yakhabili yarula; ne lola, abandu babili abokhubaHeburania bali nibakhupananga; namusunjila owakhola libii ari Nishiina eshichila nomuupa owashio? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga ari Niwina owakhukhola okhuba omukhulundu khandi omwilwatsii khwifwe? Wenya okhunzira isie, shinga olwa wayeerile omuMisiri ulia? Musa naria, napaara mbu Khane likhuwa elo limanyiishe! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Farao yahulila likhuwa elo, yeenya okhumwira Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Musa yeelukha narula imbeli waFarao, namenya mushibala shiaMidiani; niyeekhala heeyabo lindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omwisaaliisi waMidiani yali nende abaanabe abakhaana musaafu; nabo nibeetsa nibataha amatsi, nibeetsusia tsinzeelo okhunyweesia ebiayo biasaabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaayi bandi nibeetsa nibabeelusia; habula Musa yasinjila nabakhoonya, nanyweesia ebiayo biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa boola ewaReueli saabwe, yabareeba ari Mubeele murie nimuchelela murio khale leelo? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakalusia bari OmuMisiri undi akhuhabiine mumukhono kwabaayi, khandi akhutayiile amatsi, nanyweesia ebiayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.19",
            "verseOrgIds": [
              "EXO.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba abakhaanabe ari Ne ali heena? Mbushiina nimumulekha omundu oyo? Mumulanje, alie ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa yachama okhumenya nende omusaatsa oyo; naye namubashila Musa omwanawe omukhaana mbu Zipora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeebula omwana omusiani, Musa namukulikha eliira mbu Gerishomu; okhuba yasunga mbu Embeelenje omuchen mushialo shiabeene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwetsindaalo tsinyinji etsio, omuruchi waMisiri nafwa; abaana baIsiraeli nabo nibeesia amahumo khulwa obunyakhani, nibakhupa tsimbungu; okhulakaya khwabwe nikhuula ewaNyasaye, khulwa obunyakhani obwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.23",
            "verseOrgIds": [
              "EXO.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Nyasaye nahulila okhubinda khwabwe, khandi Nyasaye niyeetsulila indakanoye eya yalakana nende Aburahamu, nende Isaka, nende Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.24",
            "verseOrgIds": [
              "EXO.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nyasaye nalola abaana baIsiraeli; khandi Nyasaye namanya akabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.25",
            "verseOrgIds": [
              "EXO.2.25"
            ]
          }
        }
      ]
    }
  ],
