            }
          ]
        },
        {
          "text": "Okhole ingubo ishinga yeibuluu, neisambarau, neiranzayi, neikitani indorotoro isiire; nende abakerubi, emilimo chiomulushi wamang'oole, olachikhole; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
