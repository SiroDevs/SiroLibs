          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nochiachikha khutsisiilo tsine tsiomupeeli etsiafuumwa itsahaabu, nitsili nebikuru bieitsahaabu, khubichibi bieifeetsa bine. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
