          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wachishe ingubo ishinga eyo khubitiili ebio yeleele, niwinjisia lisanduku lioburumbusi mubwenomwo, mungubo ishinga; ingubo ishinga nayo yilakhukabukhasilia hakari wahabundu ahatakatifu nende yaho ahashila obutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
