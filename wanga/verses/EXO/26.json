          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ore litisilo elo khwisanduku lioburumbusi, habundu tsana ahashila obutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orenjeshe imeesa eyo elwanyi weingubo ishinga, nende eshichibi shietsitaha, shihengane neimeesa khulubeka Iweshimenyo enasautsi; nora imeesa khulubeka Iwenotsi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
