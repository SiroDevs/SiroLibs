          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nabasunjila abaana baIsiraeli ari Lole, OMWAMI walanjile eliira liaBezaleli omwana waUri, omwana waHuri, owoluyia lwaYuda; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "namwitsusiamwo roho waNyasaye, abe nobusitsa, nobumanyilisi, nobumanyi, nobukholi bwemilimo chiosi echiahukhaane, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi okhukoora emilimo chiobusitsa, nokhukholela itsahaabu, neifeetsa, nomukasa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.32",
            "verseOrgIds": [
              "EXO.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhukhalaka amachina khulwa okhureebwa khushindu, nokhubaatsa emisaala, nokhukhola emilimo chiobusitsa chiosi echiahukhaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi wamuheele omwoyo kwokhwechesia, ye omwene, nende Oholiabu, omwana waAhisamaki, owoluyia lwaDani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeenabo yabeetsusiye obusitsa okhukhola emilimo chiosi echiahukhaane, kata echiomubaatsi, kata echiomulushi wamang'oole, kata echiomunabi wamang'oole keibuluu nakeisambarau namaranzayi neikitani indorotoro, kata echiomulushi, kata echia abo abakholanga omulimo kwosi, kata nende abo abakooranga emilimo chiobusitsa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.35",
            "verseOrgIds": [
