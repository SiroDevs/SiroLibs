    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwahulwi bwaHaruni nabaanabe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kano niko aka olabakholele khulwa okhubaahula okhu'khaabanila mubukuhani; mbu obukule ihuunwa ndala nende amamiiku kabili ebibula obulema bwosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.1",
            "verseOrgIds": [
              "EXO.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nemikaate echibulamwo amamela, namaandasi akabulamwo amamela, akatsokasiibwe amafura, nebisikuti ebibulamwo amamela ebibashilwekhwo amafura; obikasie ebiobusie obunyushe bweingano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.2",
            "verseOrgIds": [
              "EXO.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obire mushimwelo shilala, niwitsa ninabio mushimwelo tsana, halala nende ihuunwa nende amamiiku kabili ako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.3",
            "verseOrgIds": [
              "EXO.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oleere Haruni nende abaanabe khumuliango weliheema liokhwakaana, nobasinga amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.4",
            "verseOrgIds": [
              "EXO.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule ebiifwalo, omufwale Haruni likoti, neikanzu yeifoti, neifoti, neiloloti tsana yeshilifu, nomuboha omushiipi kwobulushi bwamang'oole kweifoti; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.5",
            "verseOrgIds": [
              "EXO.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nora eshilemba khumurwekwe, nora olusimbi olutakatifu khushilemba tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.6",
            "verseOrgIds": [
              "EXO.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule amafura akokhutsushiilila, otsushe khumurwekwe, abe omutsushiililwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.7",
            "verseOrgIds": [
              "EXO.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleere nende abaanabe, nobafwala amakoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.8",
            "verseOrgIds": [
              "EXO.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obabohe emishiipi Haruni nende abaanabe, nobaboha tsikofia; nabo balaba nobukuhani khulwa lilako elirahwaho ta. Nilwo olwa oleemekha Haruni nende abaanabe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.9",
            "verseOrgIds": [
              "EXO.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oleere ihuunwa eyo imbeli weliheema liokhwakaana; naye Haruni nabaanabe bare amakhono kabwe khumurwe kweihuunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.10",
            "verseOrgIds": [
              "EXO.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana wirile ihuunwa eyo imbeli wOMWAMI, hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.11",
            "verseOrgIds": [
              "EXO.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukule khumalasile keihuunwa, okare khunzika tsieshimalilo nende olwalalwo; notsukha amalasile kosi akaba nikatong'a hasi weshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.12",
            "verseOrgIds": [
              "EXO.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule amasinya kosi akafuunikhanga amala, nende olufuurilo olwokhushini, netsifiko tsiombi, namasinya katsio, nobituumilia khushimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.13",
            "verseOrgIds": [
              "EXO.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula inyama yeihuunwa, neliseelo liayo, nobuse, obisambile mumulilo elwanyi weikambi; nomusango kwobwonooni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.14",
            "verseOrgIds": [
              "EXO.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule elala khumamiiku ako; naye Haruni nende abaanabe bare amakhono kabwe khumurwe kwelimiiku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.15",
            "verseOrgIds": [
              "EXO.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana wire limiiku elo, obukule amalasile kalio, okoohe hashimalilo tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.16",
            "verseOrgIds": [
              "EXO.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofwone limiiku ebitonye, niwosia amala, nende ebilenje bialio, nobira halala nebitonye bialio nende omurwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.17",
            "verseOrgIds": [
              "EXO.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "notuumilia limiiku liosi khushimalilo; nilio omusango omusambe kwOMWAMI; neshiuya eshilayi, neshihaanwa eshihaanilwa OMWAMI khulwa omulilo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.18",
            "verseOrgIds": [
              "EXO.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule limiiku lindi elo; naye Haruni nabaanabe bare amakhono kabwe khumurwe kwelimiiku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.19",
            "verseOrgIds": [
              "EXO.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana wire limiiku tsana, obukule khumalasile kalio, okabashe khubutsunzu bweshirwe eshisaatsa shiaHaruni, khandi khubutsunzu bwebirwi ebisaatsa biabaanabe, khandi khunzala tsingali etsiokhumakhono kabwe amasaatsa, khandi khubino ebikali biebilenje biabwe ebisaatsa, niwoha amalasile kandi akatong'a khushimalilo tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.20",
            "verseOrgIds": [
              "EXO.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi obukule khumalasile akali khushimalilo, nende khumafura akokhutsushiilila, nokanyululusia khuHaruni, nokhubiifwalobie, nokhubaanabe, nende khubiifwalo biabaanabe halala ninaye; kho alaba omutakatifu, nende ebiifwalobie, nende abaanabe, nende ebiifwalo biabaanabe halala ninaye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.21",
            "verseOrgIds": [
              "EXO.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi obukule amasinya kelimiiku elo, neisembe, namasinya kosi akafuunikhanga amala, nende olufuurilo olwokhushini, netsifiko tsiombi namasinya katsio, nende eshiatakho eshisaatsa, shichila nelimiiku liobwemeshi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.22",
            "verseOrgIds": [
              "EXO.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomukaate mulala, neliandasi elala liamafura, neshisikuti shilala, ebiomushimwelo shiemikaate echibulamwo amamela eshili imbeli wOMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.23",
            "verseOrgIds": [
              "EXO.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "obire biosi khubikalo biaHaruni khandi khubikalo biabaanabe; nobichela bibe omusango kwokhuchelwa imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.24",
            "verseOrgIds": [
              "EXO.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obibukule mumakhono kabwe, nobituumilia khushimalilo, khushihaanwa eshisambe, bibe eshiuya eshilayi imbeli wOMWAMI; neshihaanwa eshihaamlwa OMWAMI khulwa omulilo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule itakatal yelimiiku liobwemeshi liaHaruni, nochichela, yibe omusango kwokhuchelwa imbeli wOMWAMI; nayo yibe omukabolewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahule itakata yomusango kwokhuchelwa nende eshiatakho shieisadaka eyichelwa eshio, isadaka eyokhwimiiku liobwemeshi, elili liaHaruni, nende eliabaanabe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nashi shilabeetsanga eshiaHaruni nabaanabe, nomukabo kwabwe obushia nobushia okhurula khubaana baIsiraeli; shichila neisadaka eyirula khubaana baIsiraeli, eyirula mumisango chiebihaanwa biabwe biokhwishia; neisadaka yabwe khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
