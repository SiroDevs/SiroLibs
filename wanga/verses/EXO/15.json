              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nende abaana baIsiraeli nibeembela OMWAMI olwimbo luno,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
