        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuKushi oyo niyoola; omuKushi nasunga mbu Endi nelikhuwa khumwami wanje omuruchi; okhuba OMWAMI akhumaliile eshikwoli inyanga yino khubeenabo bosi abakhukholeele induli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nareeba omuKushi ari Omusooliili Abisalomu nomulamu? OmuKushi nakalusia mbu Abasuku bomwami wanje omuruchi, nende abo bosi abakhukholela induli nibeenya okhukhukholela obubii, babe shinga olwa omusooliili oyo ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nabeelela muno naniina mushisika eshiali nishili hekulu weshiiibwa, nalila; ne natsiitsanga, yaboola ari nanwa, mbu O mwana wanje Abisalomu, mwana wanje, mwana wanje Abisalomu! Embeele ndaba isie oufwile mushilenjeshio, o Abisalomu, mwana wanje, mwana wanje!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
      ]
