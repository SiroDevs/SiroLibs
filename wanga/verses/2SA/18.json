    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaAbisalomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi yabasia abandu aba yali ninabo, naraho abaseesia bebikhumila nende abaseesia bebikhumi khubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.1",
            "verseOrgIds": [
              "2SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi narusia abaseeri, nabakabula ebitonye bitaru, eshindi mumukhono kwaYoabu, eshindi mumukhono kwaAbishai waZeruya, omwana wabwe Yoabu, neshindi mumukhono kwaItai omuGiti. Omuruchi nabasunjila abaseeri tsana ari Nasi siesi shinenjweye okhurula enzie nineenywe ta, isie omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaseeri nibasunga mbu Shiwitsa okhurula ta; shichila nikhuba nikhwilukha, shibalateeba likhuwa khwifwe ta; kata nikhuba nikhufwa inusu yeefwe, khandi shibalakhuteeba likhuwa ta; habula iwe ohelana nende abandu ebikhumila likhumi khwifwe; khulwako nobulayi obe niwirecheeshe okhukhuhabina okhurula mwitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nabasunjila mbu Aka muluutsi, niko aka ndalakhola. Mana omuruchi nasinjila elubeka khushilibwa, abaseeri bosi nibarula ebikhumi ebikhumi, khandi ebikhumila ebikhumila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nalaka Yoabu nende Abishai nende Itai, ari Mwiyile kahala khuka mumukholela omusooliili oyo, Abisalomu, khulwanje. Abandu bosi nabo nibahulila olwa omuruchi yalachilisia abaseesia bosi khumakhuwa kaAbisalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaseeri nibarula nibatsia mushitsiimi okhuyinga Isiraeli; lihe nalio niliba mumutsuru kwaEfuraimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaIsiraeli nabo nibarootsilwayo imbeli wabasumba baDaudi, nibubaho obwirwi obukhongo inyanga eyo, bwabandu ebikhumila amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lihe liali nilisalaanile khushialo shiosi; ne omutsuru kwalia abandu abanii inyanga eYo okhushila olukanga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abisalomu yeetsukhana nabukaana nende abasumba baDaudi. Abisalomu yali naniinile khunyumbu, inyumbu nayo niyibira hasi mumasaka amakhongo komuruba kundi omukhongo, omurwekwe nikuhanda mumuruba, naye nanakwa hakari welikulu nende eshialo; inyumbu eya yali naniinilekhwo nayo niyitsia butsia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu undi nalola, namuboolela Yoabu, ari Lola, enduutsi Abisalomu niyeeleelile mumuruba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu namusunjila owamuboolela ari Omuluutsi? Ne mbushiina noramuupa hasi yaho? Mana ndakhakhuheele tsifeetsa ekhumi, nende omushiipi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo namusunjila Yoabu mbu Kata nindakhanyoola tsifeetsa eshikhumila mumukhono kwanje, khane shindakhakololosia omukhono khumwana womuruchi tawe; okhuba omuruchi akhulachile iwe, nende Abishai nende Itai, ifwe nikhuhulila, ari Mwiyile kahala, omundu yesi yesi aleshe okhutiilakhwo khumusooliili oyo, Abisalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, nimba nindakhakholile akoburana khuye, (ne libulaho likhuwa liosi elibeetsanga nilibisilwe omuruchi) mana iwe omwene wakheeyahuushe ninasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu nasunga mbu Shinyala okhushinda nimbuutsa endio ninawe ta. Nabukula tsisaala tsisongole tsitaru mumukhono, natsifumira mushilifu shiaAbisalomu, olwa yali nashili mwoyo mukari mumuruba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasooliili ekhumi abali nibamuchinjilanga Yoabu ebimanulwabie nabo nibabotokhanaho nibamuupa Abisalomu nibamwira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu nakhupa olwika, abandu nabo nibakalukha okhurula mukhulondachililila Isiraeli; okhuba Yoabu yakaya abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niba-bukula Abisalomu, nibamusukuna mubwina obukhongo obwaliyo mumutsuru, nibabunjikha hekuluwe eshituuli shiamachina eshikhongo muno; abaIsiraeli bosi nibeelukha nibatsia buli mundu ebunangowe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Abisalomu olwa yali nashili mwoyo, yali niyabukula isiilo, niyeesinjisilia; nayo yili mwibanda liomuruchi; okhuba yasunga ari Shindi nende omwana yesi owakhachila eliira lianje niliitsulilwa tawe; nakulikha isiilo eyo khuliira lilie omwene; nayo niyilangungwa mbu eshiitsulilo shiaAbisalomu, okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ahimazi waZadoki nasunga mbu Lekha nzilushe bulaano, emuyilile omuruchi amakhuwa, shinga OMWAMI olwa amumaliile eshikwoli khubasukube. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu namusunjila mbu Iwe shiolaba omuyili wamakhuwa leelo tawe, ne olayila amakhuwa inyanga yindi; ne inyanga yino shiolayila likhuwa liosi ta, okhuba omwana womuruchi afwile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu yamubiila omuKushi undi, ari Tsia oboolele omuruchi aka oluutsi. OmuKushi oyo namwinamila Yoabu, niyeelukha natsia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ahimaazi waZadoki namusunjila Yoabu olwakhabili, ari Ne kata kario, ekhusaaya mbu siesi nzilushe, emulonde omuKushi. Yoabu namureeba mbu Ne nishiina eshichila niwenya okhwilukha, mwana wanje, okhuba shiwitsa okhunyoola amatani kosi khulwa amakhuwa kano ta? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Ne kata kario, nzilushe. Namusunjila mbu Yilukha. Kho Ahimaazi niyeelukha khunjila yomuhololookhwe, namubira omuKushi oyo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi yali niyeekhaale hakari webilibwa bibili; omulindi naye naniina khushilama shieshilibwa, halukoba, nachinga tsimoni nahenga, ne lola, omundu niyeetsa niyeelukha, nali yenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulindi nalanjisia, naboolela omuruchi. Omuruchi nasunga mbu Naba nali yenyene, ali nende amakhuwa. Niyeetsa tsimbilo, niyoola ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omulindi nalola oundi khandi niyeelukha; omulindi oyo nalanjisia omuhenji weshilibwa, nasunga ari Lola, oundi khandi yeelukha, nali yenyene. Omuruchi naboola mbu Khandi yesi aleera amakhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulindi oyo nasunga mbu Embaara mbu okhwilukha khwowambeli khwingana okhwilukha khwaAhimaazi waZadoki. Omuruchi nasunga mbu Ye nomulayi, khandi ali nende amakhuwa amalayi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ahimaazi nalanjisia nasunjila omuruchi ari Nomulembe. Niyeenama imbeli womuruchi, nabunamia obwenibwe hasi, nasunga mbu OMWAMI Nyasayewo yeetsoomibwe, oubatsunasiye abandu abo abachinga amakhono okhuyinga omwami wanje omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nareeba mbu Omusooliili Abisalomu nomulamu? Ahimaazi nakalusia mbu Olwa Yoabu arumile omusumba womuruchi, isie omusumbawo, enduutsi indiri ikhongo, ne shimanyile mbu namakhuwa shiina tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nasunga mbu Shiukhana, osinjile yaha. Naye nashiukhana, niyeemaho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
    {
