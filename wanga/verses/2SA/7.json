{
  "id": "2SA.7",
  "number": "7",
  "bookId": "2SA",
  "reference": "2 Samweli 7",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "2SA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indakano eya Nyasaye yalakana nende Daudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa omuruchi yali namenyanga munzuye, khandi olwa OMWAMI yali numuhuluusiye khubasukube bosi tsimbeka tsiosi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
              "2SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuruchi namusunjila Natsani omunabii ari Lola, isie emenyanga munzu yemisiita, ne lisanduku liaNyasaye limenyanga mungubo tsinzeleesia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
              "2SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Natsani namusunjila omuruchi ari Tsia okhole kosi akali mumwoyokwo; okhuba OMWAMI ali ninawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mushilo shieneshio likhuwa liOMWAMI liamwitsila Natsani; liri ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia oboolele omusumba wanje Daudi, ori Kano niko aka OMWAMI aboola; mbu Iwe olanyumbashila isie inzu, mbu emenyemwo, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shindamenyakhwo munzu tawe, okhurula khunyanga eya ndabatikulusia abaIsiraeli nimbarusia eMisiri, okhuula olwa leelo, habula ndachendilenje mwiheema nomushimenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habundu hosi ewa ndachendanga nende abaIsiraeli bosi, ndamusunjila likhuwa omuyaasii yesi waIsiraeli, owa ndalaka okhwayanga abandu banje Isiraeli, nimureeba mbu Nishiina eshiachila nimuranyumbashila inzu yemisiita ta, nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.7",
            "verseOrgIds": [
              "2SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano omusunjile omusumba wanje Daudi ori Kano niko aka OMWAMI omwene mahe asunga; mbu Ndakhuyinia mubwayilo, mukhwaya amakondi, mbu obe omwimilisi wabandu banje, Isiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi ndabeelenje ninawe halala, hosi ewa watsiilenje, nikhalaka abasukubo bosi barule imbeliwo; ne engaliyia eliiralio okhuba likhongo shinga eliira liabakhongo abaliho mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.9",
            "verseOrgIds": [
              "2SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi embaahulila abandu banje Isiraeli habundu, nimbaraaka, mbu bamenyenje habundu wabwe abeene, nibaranyasibwa khandi ta; kata abamayaanu shibalabasandinjia khandi tawe, shinga olwa kali khale, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.10",
            "verseOrgIds": [
              "2SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shinga okhurula khunyanga eya ndalachilisia abayaasii okhuyaasinjia abandu banje Isiraeli; khandi ndalakhuhuluusia khubasukubo bosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI akhuboolela mbu OMWAMI yeetsa okhukhukholela iwe inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa tsindaalotsio tsiliba nitsihelile, nawe nokona nolonda khubakuukabo, ndiliemekha omwanawo munyumawo, oulirula mundayo, khandi ndiliralisia eburuchibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.12",
            "verseOrgIds": [
              "2SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne niye ouliliumbashila eliira lianje inzu, nasi ndiliralisia eshifumbi shioburuchibwe okhuula khubisoni nebisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.13",
            "verseOrgIds": [
              "2SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiliba samwana, naye aliba omwana wanje; naba nakhola obumayaanu, ndilimukuuma nende indabushi yabandu, khandi nende amakhupache kabaana babandu; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.14",
            "verseOrgIds": [
              "2SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula obuheeli bwanje oburalilu shibulimurulakhwo ta, shinga olwa ndatsirusia khuSaulo, omwenoyo owa ndarusia imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.15",
            "verseOrgIds": [
              "2SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inzuyo nende oburuchibwo, bilitinyisibwa obushia nobushia imbeli wanje; eshifumbishio nashio shiliralisibwa okhuula khubisoni nebisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.16",
            "verseOrgIds": [
              "2SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga amakhuwa kano kosi olwa kali, khandi shinga libisulo lino liosi olwa lili, nolwa Natsani yamusunjila Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.17",
            "verseOrgIds": [
              "2SA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.17",
            "verseOrgIds": [
              "2SA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi omuruchi niyeenjila niyeekhala imbeli wOMWAMI; nasunga mbu O Omwami NYASAYE, nasi nisie wina, kata inzu yanje nishiina, mbu unzusiye okhuula hano? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata elo liali butswa likhuwa lituutu mumonitsio, O Omwami NYASAYE; nebutswa orumbuule akeinzu yomusumbawo mundaalo tsinyinji etsili okhwitsa, niumanyia aketsinzibulo etsishili okhwitsa, O Omwami NYASAYE! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Daudi nakhusunjile shiina khandi? Okhuba wamanya omusumbawo, O Omwami NYASAYE. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa likhuwalio khandi shinga omwoyokwo omwene olwa kuli, nindio wakholile obukhongo buno bwosi, mbu omusumbawo abumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.21",
            "verseOrgIds": [
              "2SA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, niwe omukhongo, O Omwami NYASAYE; okhuba abulaho owingana iwe, kata abulaho Nyasaye undi norali iwe ta, khukosi aka khwahuliile nende amarwi keefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nihanga shiina mushialo eliingana abandubo, eliingana Isiraeli, aba Nyasaye yatsia okhwinunulila omwene babe abandube, nokhwinyoolela omwene eliira, nokhumukholela inywe amakhuwa amakhongo, khandi amakhuwa kamariisia khulwa abandubo, aba weenunulila omwene muMisiri, niwilusia imbeli wabwe amahanga ako nende abanyasaye bako? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.23",
            "verseOrgIds": [
              "2SA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne weekholela omwene abandubo Isiraeli, babe khwiwe abandubo ebisoni nebisoni; nawe, OMWAMI, noba Nyasaye wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, O OMWAMI Nyasaye, aka wakhasunga khumakhuwa komusumbawo, khandi khumakhuwa keinzuye, okatinyisie inziayo, nokhola shinga olwa osunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliiralio nalio lilahungwe obushia nobushia, liri OMWAMI omwene mahe niye Nyasaye waIsiraeli; ne inzu yomusumbawo Daudi yilaralisibwa imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba iwe, O OMWAMI omwene mahe, Nyasaye waIsiraeli, ofwimbuliile omusumbawo likhuwa, nosunga mbu Ndalakhuumbashila inzu; niko akachilile isie omusumbawo enzaliishe okhukhwikongoyela eliikongoyo lino. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, O Omwami NYASAYE, niwe Nyasaye, namakhuwako nako niko obwatoto, nawe omusubisiye omusumbawo likhuwa lino lilayi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho bulaano ochame okhuheelesia inzu yomusumbawo ikhabi, mbu yimenyenje imbeliwo inzizyo; shichila niwe, O Omwami NYASAYE, ouboolile; kho inzu yomusumbawo yibeetsenje nende ikhabiyo obushia nobushia.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
      ]
    }
