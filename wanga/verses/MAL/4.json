    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Induukho yOMWAMI eyili okhwitsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lole, induukho yiitsanga, niyiyiile shinga amayika; nabo abeechinjimisii bosi, nende bosi abakholanga tsimbii, balakwa olububa; induukho eyo eyiitsanga yilabasamba kutu, niyirabaleshela kata omusi kata olusaka ta; nilwo olwa OMWAMI, omwene mahe, aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.1",
            "verseOrgIds": [
              "MAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khwinywe abariitsanga eliira lianje, eliuba liobulunjishi lilamufwindila, nobuhonia mumbaha tsialio; mana mularula nimutsala shinga ebimoosi ebirula mushitioli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulaseenela ababii hasi; okhuba balaba likoshe hasi webilenje bieenywe khunduukho eya ndalakhola kano; nilwo olwa OMWAMI omwene mahe aboola.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwitsulile amalako kaMusa omusumba wanje, eya ndamulachila muHorebu khulwa Isiraeli yosi, mbuakalachilisibwa nakobukhalachi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, ndalamurumila Eliya omunabii, induukho eyo yOMWAMI, ikhongo neyamariisia, niyirashioola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alashiukhasilia abaana emioyo chiabasaabwe, nashiukhasilia abasaabwe emioyo chiabaana; mbu endeshe okhwitsa okhukuuma eshialo nishilaka eshilaka munwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
          }
        }
      ]
    }
  ],
