    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu banichilisibwa okhuumbakha ihekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhabili kwaDario omuruchi, mumwesi kwakhasasaba, nikuli lulala, likhuwa liOMWAMI lieetsela mumunwa kwaHagai omunabii khuZerubabeli waShealitieli, omukafuna waYuda, nokhuYoswa waYehozadaki omukuhani omukhulundu, liri ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI, omwene mahe, aboola; mbu Abandu bano basunga bari Eshise shishili okhuula eshiokhuumbakha inzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.2",
            "verseOrgIds": [
              "HAG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana likhuwa liOMWAMI niliitsila mumunwa kwaHagai omunabii, liri ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.3",
            "verseOrgIds": [
              "HAG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shino neshise eshimukhoyeele inywe okhumenya munzu tsieenywe etsiafuumwakhwo tsimbaho, olwa inzu yino yisikaale yirio likunda? ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.4",
            "verseOrgIds": [
              "HAG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano OMWAMI omwene mahe aboola mbu Yililisie khukamukwilanga; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.5",
            "verseOrgIds": [
              "HAG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaraaka ebinji, nimuchesa ebituutu; muliitsanga, nimureekura ta; munyweetsanga, nimuranyalikha ta; mwifwalanga, ne abulaho outunduma omubili. Ouliitsanga omushaara akulia okhukura muloloti eyafutukha emiluhu.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.6",
            "verseOrgIds": [
              "HAG.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe aboola, mbu Yililisie khukamukwilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.7",
            "verseOrgIds": [
              "HAG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niine mushikulu, murikande emisaala, muumbashe inzu; nasi ndalachisangaalila, nindolosiamwo oluyali lwanje; nilwo olwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.8",
            "verseOrgIds": [
              "HAG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakhaaba ebinji; ne lole, biali butswa ebituutu; kata olwa mwabileera hango, ndabifuura bufuura. Ne mbushiina? Nolwa OMWAMI omwene mahe areeba. Mbula, khulwa inzu yanje eyili butswa likunda, olwa mutetekhanilanga buli mundu khukeinzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.9",
            "verseOrgIds": [
              "HAG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila likulu niliikalwa, oburaamia eliime ta, kata liloba okhwama ebiamo. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalanjile eshimiyu shiitse khushialo, nokhubikulu, nokhumele, nokhudivai, nokhumafura, nokhubiosi ebirula mwiloba, nokhubandu, nokhumiruko, nokhubunyakhani bwabwe bwosi.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.11",
            "verseOrgIds": [
              "HAG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Zerubabeli waShealitieli, naYoswa waYehozadaki omukuhani omukhulundu, halala nende abandu bosi abasikala, nibahulila omwoyo kwOMWAMI Nyasaye wabwe, nende amakhuwa kaHagai omunabii, shinga OMWAMI Nyasaye wabwe olwa yali namurumile; abandu nabo nibaria imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.12",
            "verseOrgIds": [
              "HAG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hagai omurume wOMWAMI yaboolela abandu amakhuwa kOMWAMI; ari OMWAMI aboola mbu Endi halala nineenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
            "verseOrgIds": [
              "HAG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nabuusia roho yaZerubabeli waShealitieli, omukafuna waYuda, naroho yaYoswa waYehozadaki, omukuhani omukhulundu, naroho tsiabandu abo bosi abasikala; nabo nibeetsa nibakhola emilimo munzu yOMWAMI, omwene mahe Nyasaye wabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumwesi kwakhasasaba nikuli amakhumi kabili nakhane.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.15",
            "verseOrgIds": [
              "HAG.1.15"
            ]
          }
        }
      ]
    }
  ],
