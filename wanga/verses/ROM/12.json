        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusango okuli mwoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, baana beefwe, nimusaaya khulwa tsimbabasi tsiaNyasaye mbu mwihaane emibili chieenywe chibe omusango okuli mwoyo, omutakatifu, okwa Nyasaye anyala okhuchama; shichila nibwo obukhalabani bweenywe obweshiroho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne murakwisibwa khukhufwana khweshialo shino ta; ne mbu mukalukhasibwe khulwa emioyo emiyia echia muheebwa, mbu mukateeme nimukamanyila elala aka Nyasaye yeenya, niko akali amalayi, akachamisinjia, akali amalamba habwene.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila khulwa obukoosia obwa ndaheebwa emboolela buli mundu yesi mwinywe mbu aleshe okhupaaranga akokhwichinjimisia; ne mbu apaarenje noburechelefu, shinga Nyasaye olwa yakabila buli mundu inengo yobusuubili. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga olwa khuli nebiungo ebinji mumubili mulala, ne ebiungo ebio biosi shibikholanga omulimo mulala ta, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.4",
            "verseOrgIds": [
              "ROM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "neefu fwesi khurio, kata olwa khuli abanji, khuli omubili mulala muKristo, nikhuli ebiungo, buli mundu khuwashie. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khuli nemikabo echiahukhaane, obukoosia obwa khwaheebwa shinga olwa buli; nibuba nibuli obunabii, khulakulenje obusuubili bweefwe shinga olwa buli; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata obukhalabani, khurekhwo emioyo khubukhalabani bweefwe; oyo owechesinjia, khukhwechesiakhwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyo ouchesiyinjia khubuchesiyiibwe; ouhaananga ahaane namakhono amasiro; ourukanga, aruche nobulumilifu; oukholanga aketsimbabasi, akholenje nobusangaafu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesiyii khubikhole bieshiKristayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuheeli bube bwobwatieeli. Sile amabii; muhande khumalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.9",
            "verseOrgIds": [
              "ROM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhuheela abaana beefwe, muheelanenje abeene nabeene; mumakhuwa koluyali, buli mundu yeemisie owashie; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukeshinani, muratofuhala tawe; mube nobulumilifu muroho tsieenywe; kholelenje Omwami shinga abasumbabe; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mubunaayi bweenywe musangaalenje; mwisimilisie mumasila; mulumililenje mukhusaaya; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "musanjilanenje nende abatakatifu mubutambi bwabwe; mubeetsenje abaangu okhwinjisia abacheni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubasabile ikhabi abamusandia; sabe ikhabi, nimuralaka ebilaka munwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwikhoyelenje halala nende abo abeekhoya; mulililenje halala nende abo abalila amasika. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mufuchilisaninjie abeene nabeene. Mureechinjimisia ta, ne muwinjanenje nende abamanani. Muleshe okhwipaara shinga olwa muli abachesi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muramurunga omundu yesi obubii khulwa obubii ta. Yitsulilenje akachamwa nabandu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba nikanyalikha, halubeka Iweenywe mumenyenje nomulembe nabandu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.18",
            "verseOrgIds": [
              "ROM.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaheelwa banje, mureemalilanga abeene eshikwoli ta, ne muheelesie Oburima obwo obwiyangu; shichila kahandiikwa kari Omwami yasunga mbu Okhumala eshikwoli nokhwanje, nasi ndilirunga. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusukuwo naba nali inzala, omuhe eshiokhulia; naba nali nobuloho, omuhe eshiokhunywa; shichila olwa okhola orio, omubumba amaanda komulilo khumurwekwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orahulwa nobubii ta, nebutswa ohulenje obubii nende obulayi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.21",
            "verseOrgIds": [
              "ROM.12.21"
            ]
          }
        }
      ]
    }
  ],
