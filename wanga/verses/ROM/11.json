              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.32",
            "verseOrgIds": [
              "ROM.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
