    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mukhusaayilenje",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihelelesia ndielino, baana beefwemukhusaayile mbu likhuwa liOmwami lianguhe niliheebwa oluyali, shinga olwa libeetsanga mwinywe; ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
              "2TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu khuhonibwe mumakhono kabamayaanu, abakhayikhanu; shichila shibali bosi abali nobusuubili ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omwami nomwisiikwa; alamuralisia namuteetsa mumukhono kwomubii oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu khumwisiikanga Omwami khulweenywe, mbu mukholanga akeenako aka khumulaka, khandi mulakakholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami alunjisilie emioyo chieenywe khunjila eyula mubuheeli bwaNyasaye, khandi mubwisimilisii bwaKristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, baana beefwe, khumulaka muliira liOmwami weefwe Yesu Kristo, mbu mwiyahule khubuli mwana weefwe ouchendanga mubukara, narachenda mumakhuwa keene aka khwamwechesia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.6",
            "verseOrgIds": [
              "2TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila inywe muma; yile shinga olwa mukhoyile okhulonda mukhola yeefwe; okhuba ifwe shikhwali abakara olwa khwali mwinywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
            "verseOrgIds": [
              "2TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikhwabukula ebiokhulia mumukhono kwomundu yesi oburarunga ta; habula muminyakhano namatinyu, nikhukholanga emilimo eshilo neshiteere mbu khuleshe okhusitohela omundu yesi khwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.8",
            "verseOrgIds": [
              "2TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikali mbu khwabula obunyali ta, habula mbu okhwikhola eshilolelo khwinywe, mana inywe mulonde mukhola yeefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kata olwa khwaliho nineenywe khwamubiila khuri Ourachama okhukhola emilimo araliakhwo ebiliibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila khuhulilanga mbu baliho mwinywe abali abakara, abarakholakhwo omulimo kwosi ta, nebutswa beeyinjisinjia muchiabeene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
              "2TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abali bario, khubalaka nikhubachesiyia muMwami Yesu Kristo mbu bakhole emilimo chiabwe mubuholeelefu nibalia ebiliibwa biabwe abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu, baana beefwe, muleshe okhufwa omwoyo mukhukhola amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba narahulila nokhukhola akelikhuwa lieefwe mubarwa yino, mumwitsulile, nimurachenda nimurachenda ninaye ta, mbu afwimbwe omurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
            "verseOrgIds": [
              "2TH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa muramuhamba obusuku ta; habula mbu mumuchesiyia shinga olwa ali omwana weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abasabila omulembe nobukoosia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano Omwami womulembe omwene amuheelesinjie omulembe tsindaalo tsiosi, munjila tsiosi. Omwami abeetsenje nineenywemwesi.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emushiesia nomukhono kwanje omwene--nisie Paulo; ne nishio eshilolelo mubuli barwa; okhuhandiika khwanje khwokhuno.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        }
      ]
    },
