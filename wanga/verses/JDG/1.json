{
  "id": "JDG.1",
  "number": "1",
  "bookId": "JDG",
  "reference": "Abayaasii 1",
  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JDG 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda naSimeoni babukula Adoni-bezeki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma Iwokhufwa khwaYoswa, abaana baIsiraeli bareeba OMWAMI bari Niwina oularanjilila okhukhutikulushila khubaKanaani, okhubaseera? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.1",
            "verseOrgIds": [
              "JDG.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola mbu Yuda atsie; lole, ehaanile eshialo mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.2",
            "verseOrgIds": [
              "JDG.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda nasunjila Simeoni omwana wabwe ari Chenda khutikulushe ninawe, khutsie mushialo eshia ndakabilwa, khuseere abaKanaani; nasi siesi, ndalatsia ninawe mumukabo kukwo. Kho Simeoni natsia ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.3",
            "verseOrgIds": [
              "JDG.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yuda natikulukha; OMWAMI nahaana abaKanaani nabaPerizi mumakhono kabwe; nibarootsa abandu ebikhumila ekhumi khubo eBezeki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.4",
            "verseOrgIds": [
              "JDG.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibanyoola Adonibezeki ebweneyo eBezeki; nibamuseera, nibarootsa abaKanaani nabaPerizi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.5",
            "verseOrgIds": [
              "JDG.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Adonibezeki niYeelukha; nibamulondachilila, nibamu-hamba, nibamukhalaka tsinzala tsingali tsiamakhono nende ebino. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.6",
            "verseOrgIds": [
              "JDG.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoni-bezeki naboola mbu Abaruchi amakhumi musaafu abakhalakwa tsinzala tsingali tsiamakhono nebino bali nibatoolanga ebiokhulia mulwalo weimeesa yanje; shinga olwa ndakhola isie, nolwa Nyasaye yarunjile ario. Nibamuleera eYerusalemu, nafwilayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuda yahula Yerusalemu naHeberoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.7",
            "verseOrgIds": [
              "JDG.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baYuda baseera Yerusalemu nibalibukula, nibalikhupa netsinganga, nibahambia li-tookho omulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.8",
            "verseOrgIds": [
              "JDG.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyumakhwo abaana baYuda nibakholomokha, nibatsia okhuseera abaKanaani abamenyanga mushialo shiebikulu, nomuNegebu, nomushialo shiolwasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.9",
            "verseOrgIds": [
              "JDG.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Yuda natsia naseera abaKanaani abali nibamenyanga muHeberoni; ne khale eliira liaHeberoni lialinji Kiriatsi-araba; nibahula Sheshai, naAhimani, naTalumai.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otsinieliyahula Debiri, nabashilwa Akhisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.10",
            "verseOrgIds": [
              "JDG.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhurula yaho yatsia naseera abamenyanga muDebiri; ne khale eliira liaDebiri lialinji Kiriatsi-sefiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.11",
            "verseOrgIds": [
              "JDG.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalebu naboola mbu Oukhupa Kiriatsi-sefiri nashibukula, ndalamubashila omukhaana wanje Akhisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.12",
            "verseOrgIds": [
              "JDG.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Otsinieli waKenazi, omusiani wabwe Kalebu omushe yashibukula; naye namubashila Akhisa omukhaanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.13",
            "verseOrgIds": [
              "JDG.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yamutsiila, yamunichilisia okhusaba samwana omukundaniyeekha okhurula khusishiliye; Kalebu namureeba mbu Eshia wenya nishiina? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.14",
            "verseOrgIds": [
              "JDG.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Umbeesie eshihaanwa; shinga olwa wara muNegebu, kho umbeesie nende tsisebele tsiamatsi. Kalebu namuha tsisebele tsiemukulu nende etsiemwalo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuheli bweshialo eshia Yuda naBenyamini bahula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.15",
            "verseOrgIds": [
              "JDG.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana bomuKeni, nyakhufialanyene Musa, batikulukha nibarula mwitookho tsana liemisaala chiamashindu, halala nabaana baYuda, okhuula khushitsiimi shiaYuda, eshili muNegebu, ahambi nende Aradi; nibatsia nibamenya nabandu abo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.16",
            "verseOrgIds": [
              "JDG.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yuda natsia naSimeoni omwana wabwe, nibakhupa abaKanaani abamenyanga muZefatsi, nibalimululila elalaneliira lielitaala elo lialangwa mbu Horoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.17",
            "verseOrgIds": [
              "JDG.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Yuda nabukula Gaza nomumbali tsialio, naAshekeloni nomumbali tsialio, naEkeroni nomumbali tsialio ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.18",
            "verseOrgIds": [
              "JDG.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naba halala nende Yudanaye niyeelusia abomushialo shiebikulu; ne yakhaywa okhwilusia abamenyanga mwibanda, shichila bali namakaari keshibia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.19",
            "verseOrgIds": [
              "JDG.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibamuheelesia Kalebu Heberoni, shinga Musa olwa yali niyaboola; naye niyeelusiamwo abaana abo bataru baAnaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.20",
            "verseOrgIds": [
              "JDG.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baBenyamini shibayeelusia abaYebusi abamenyanga muYerusalemu ta; ne abaYebusi bamenyanga eYerusalemu halala nabaana baBenyamini okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufu yahula Beteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabeinzu yaYusufu nabo bosi nibatiku lukha okhuseera Beteli; OMWAMI naba halala ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.22",
            "verseOrgIds": [
              "JDG.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeinzu yaYusufu nibaruma abandl okhuluura Beteli; ne khale eliira liaBeteli lialinji Luzu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.23",
            "verseOrgIds": [
              "JDG.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaluuri abo nibalola omund narula mwitaala, nibamusaaya mbu Chama okhu manyie obwinjililo bwelitaala, neefu khulakhu kholela amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.24",
            "verseOrgIds": [
              "JDG.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabamanyia obwinji lilo bwelitaala; nibakhupa litaala netsinganga ne omundu tsana nabomunzuye, babalekha ba tsie. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.25",
            "verseOrgIds": [
              "JDG.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omundu oyo natsia mushialo shia baHiti, niyoombakhayo litaala nalikulikha mbu Luzu; ne lienelo nilio eliira lialio okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuheli bweshialo eshia Manase naEfuraimu bahula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.26",
            "verseOrgIds": [
              "JDG.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
