          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaana ba Isiraeli bali nibameeteeshe amaani, babalunyi abaKanaani nibabakhola abasumba; nibarabaru silia elala ta.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.28",
            "verseOrgIds": [
              "JDG.1.28"
            ]
          }
        }
