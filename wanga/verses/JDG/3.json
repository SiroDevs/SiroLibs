        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amahanga okhutong'ayo khulwa okhuteema Isiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kano niko amahanga tsana aka OMWAMI yalekha, okhuteema Isiraeli ninako, mbu abeenabo muIsiraeli abaralola amahe kosi kaKanaani ta, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
            "verseOrgIds": [
              "JDG.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kali butswa mbu tsinzibulo tsiabaana baIsiraeli bamanye akelihe, okhubeechesia akobulasani, abeenabo abali nibarashiamanyakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga tsana ngakano; mbu abaami baraano babaFilisiti, nabaKanaani bosi, nabaSidoni, nabaHiwi abamenyanga mushikulu shiaLebanoni, okhurula khushikulu shiaBaali-heremoni okhuula khubwinjililo bwaHamatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baliho khulwa obuteemwi bwaIsiraeli, okhumanya nibaba nibakhahulilanga amalako kOMWAMI, aka yalaka basamwana mumunwa kwaMusa, nohomba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli nibamenya hakari wabaKanaani, nabaHiti, nabaAmori, nabaPerizi, nabaHiwi, nabaYebusi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.5",
            "verseOrgIds": [
              "JDG.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhwa abakhaana abamahanga kandi, abakhaana babwe nabo nibabakha khubamahanga ako, nibakhalabanila abanyasaye babwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otsinieli vahonia Isiraeli mumakhono kaKuskani-rishatsaimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.6",
            "verseOrgIds": [
              "JDG.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola akali amabii mumoni tsiOMWAMI, nibeebilila OMWAMI Nyasaye wabwe, nibakhalabanila emiBaali nemiAshera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.7",
            "verseOrgIds": [
              "JDG.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako oburima bwOMWAMI nibwashila Isiraeli, naye nabakusia mumukhono kwaKushani-rishatsaimu omuruchi waMesopotamia; abaana baIsiraeli nibakhalabanila Kushani-rishatsaimu emiyika munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.8",
            "verseOrgIds": [
              "JDG.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaana baIsiraeli bamuhaabila OMWAMI, OMWAMI yasinjisilia abaana baIsiraeli omuhonia, owabahonia, niye Otsinieli waKenazi, omusiani wabwe Kalebu omushe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.9",
            "verseOrgIds": [
              "JDG.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho w niyeenjila muye, naye nayaasia Isiraeli; narula natsia mwihe, OMWAMI nahaana Kushanirishatsaimu omuruchi waMesopotamia mumukhonokwe; omukhonokwe nikuhula Iiushanirishatsaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.10",
            "verseOrgIds": [
              "JDG.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo nishihuluukha emiyika amakhumi kane. Mana Otsinieli waKenazi nafwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehudi diyahGnia Isiraeli mumakhono kaMoabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.11",
            "verseOrgIds": [
              "JDG.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibakhola akali amabii mumori tsiOMWAMI khandi; OMWAMI natinyia Egeloni omuruchi waMoabu okhuyinga Isiraeli, shichila bali nibakholile akali amabii mumoni tsiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.12",
            "verseOrgIds": [
              "JDG.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakhung'aasia abaana baAmoni naAmaleki, natsia nahula Isiraeli; nibabukula litookho elo liemisaala chiamashindu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli nibakhalabanila Egeloni omuruchi waMoabu emiyika ekhumi namunaane.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaana balsiraeli bahaabila OMWAMI, OMWAMI yabasinjisilia omuhonia, mbu Ehudi waGera, omuEenyamini, omundu womukaata; abaana baIsiraeli nibarumila Egeloni omuruchi waMesopotamia eshihaanwa mumukhono kwaEhudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ehudi yeeraanya olukanga lwobumemu tsimbeka tsiombi; oburambi bwalwo bwali omukhono mulala; nalubohela mungubotsie mukari, khukhukunyu isaatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yaleerela Egeloni omuruchi waMesopotamia eshihaanwa tsana; ne Egeloni oyo yali omundu omukhomefu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Ehudi yali namalile okhuhaana eshihaanwa, yaseebula abandu abali nibachinjile eshihaanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ye omwene yashiukhanila hamachina amabaatse akali eGiligali, natsia naboola mbu Omwami, endi nelikhuwa liamabiswi. Naye nalaka ari Holeele. Mana bosi abali nibasinjiileho ahambi nibamurulakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ehudi natsia ewa yali; ne yali niyeekhaale yenyene mushisikashie eshinyifu eshiahekulu. Ehudi nasunga mbu Endi nelikhuwa khwiwe elirula khuNyasaye. Naye nasinjila aha yali niyeekhaale. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ehudi naleera omukhonokwe mukaata, nabukula olukanga olwali khukhukunyu isaatsa, namufumira munda; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "eshilungu shiene nishilonda khulukanga nishiinjila; amasinya nikeekala olukanga, okhuba shiyatsomola olukanga mundaye ta; ebibii nibirula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ehudi narula, natsia mumuliango, niyeekala emiliango chieshisika tsana, nachiboha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali namalile okhutsia, abasumba nibeetsa; niealola emiliango chieshisika nichiboyilwe; nibapaara mbu Haundi yeefuunikha ebilenje mushisikashie. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalinda, okhuula olwa barambwa, ne nareekulakhwo emiliango chieshisika ta; mana nibabukula eshibohololo nibeekula; ne omwami wabwe ngwoyo, ukwile hasi, ufwile.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bashinda, Ehudi naye niyeelukha, nabira amachina amabaatse tsana, niyeelushila Seiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.26",
            "verseOrgIds": [
              "JDG.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoolayo, yakhupa olwika mushialo shiebikulu shiaEfuraimu, abaana baIsiraeli nibakholomokha ninaye okhurula mushialo shiebikulu, naye nabeemilila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.27",
            "verseOrgIds": [
              "JDG.3.27"
            ]
          }
        },
        {
          "name": "verse",
