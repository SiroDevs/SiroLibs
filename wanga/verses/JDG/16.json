              "JDG.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samusoni nahaabila OMWAMI, ari E Omwami NYASAYE, ekhusaaya mbu unzitsulile; ekhusaaya mbu umeetelekhwo tsingufu, lulala luno lwonyene, e Nyasaye, mbu emale eshikwoli khubaFiliriti khulwa ndala khumoni tsianje tsibili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Samusoni natiila tsisiilo etsio tsibili tsiahakari etsiasiilanga inzu, niyeesetamiakhwo, ndala khumukhono musaatsa neyindi khumukhono mukhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.29",
            "verseOrgIds": [
              "JDG.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni naboola mbu Efwile halala nabaFilisiti. Mana niyeenama namaani kosi; inzu niyikwila abaami abo, nabandu bosi abali nibalimwo. Kho abafu aba yeera khukhufwakhwe bali abanji okhushila abo aba yeera mubulamubwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana babwe, nabosi abeinzu yabwe, nibakholomokhayo, nibamubukula, nibatikulukha nibali ninaye, nibamuyabila hakari waZora naEshitaoli, mushihembekho shiaManoa samwana. Ne yali nali omuyaasii muIsiraeli emiyika amakhumi kabili.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
