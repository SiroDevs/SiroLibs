    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samusoni eGaza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni natsia eGaza, nalolayo omukhasi omutamba, niyeenjila ewuwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaGaza nibaboolelwa mbu Samusoni witsile yino. Nibamwikalila, nibamukoneshela eshilo tulu hashilibwa shielitaala, nibaholeela tsi eshilo tulu, bari Khulinde okhuula nibushia mukamba, mana khumwire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samusoni nakona okhuula mushilo hakari; mana mushilo hakari nabuukha, natiila tsinzichi tsieshilibwa shielitaala, nebiyindi biashio bibili, nabiiha, neshiyinjiilo shiene, nabichinjila khumabeka, nabiyila khubutenje bweshikulu eshihengana naHeberoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samusoni naDelila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyumakhwo Samusoni yali naheela omukhasi undi mwibanda liaSoreki; ne eliiralie liali Delila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaami babaFilisiti nibatsia ewa yali, nibamusunjila bari Omunichilisie, omanye eshinoko shietsingufutsie tsinyinji, khandi injila yene eya khwakhanyala okhumuhulila, khumubohe nikhumutiitiyia; mana khulakhuha, buli mundu khwifwe, tsifeetsa ebikhumi ekhumi nashilala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Delila namusunjila Samusoni ari Chama umboolele eshinoko shietsingufutsio tsinyinji, khandi eshia wakhanyala okhubohelwa mbu otiitiyibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samusoni namukalusia ari Nibaba nibambohela tsinzaha tsiobuyingo musaafu tsimbisi, etsirayoomakhwo ta, kho ndakhatora, nimba shinga omundu undi yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaami babaFilisiti nibamuleerela tsinzaha tsiobuyingo musaafu tsimbisi, etsirayoomakhwo ta, naye namuboha ninatsio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali nende abakonesheli abali nibalindanga mushisika shiomukari. Kho yamuboolela mbu Samusoni, abaFilisiti mbabano! Naye nakhalaka tsinzaha tsana, shinga olutsaha Iweipamba olwa lukhalikha niluula ahambi khumulilo. Kho eshinoko shietsingufutsie nishiramanyikha ta.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila namusunjila Samusoni mbu Lola, umbalabaale niumbeehela; bulaano nochama umboolele eshia onyala okhubohelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namukalusia ari Nibaba nibambohela emikoye emiyia echishili okhukholelwa omulimo kwosi, kho ndakhatora, nimba shinga omundu undi yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Delila nabukula emikoye emiyia, namuboha ninachio; namuboolela mbu Samusoni, abaFilisiti mbabano! Nabo abakonesheli bali nibalindanga mushisika shiomukari. Naye nachikhalaka khumakhono shinga oluusi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Delila nasunjila Samusoni mbu Okhuula bulaano umbalabalanga butswa, niumbeehela; umboolele eshia onyala okhubohelwa. Naye namuboolela mbu Noba nolukha ebikolo musaafu bieliswi lianje mungubo eyilukhungwa, nobitinyia noluchela, kho ndakhatora, nimba shinga omundu undi yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa yali nali mundoolo, Delila yalushila ebikolo ebio musaafu bieliswilie mungubo eyali niyilukhungwa; nabitinyia noluchela, namuboolela mbu Samusoni, abaFilisiti mbabano! Naye nasisimukha mundoolo, niyeeha butswa oluchela nolusaala neingubo yene.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Delila namusunjila mbu Oboolanga orie mbu Ekhuheelanga, olwa omwoyokwo kurali ninasi ta? Umbalabaale butswa okhuula khataru, noramboolelangakhwo eshinoko shietsingu-futsio tsinyinji ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa yali namuhachinjia khatsotselo namakhuwake, namulunyia, omwoyokwe kwachoonya kata khukhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namuboolela kosi akali mumwoyokwe, ari Olumwo lushili okhuula khumurwe kwanje; okhuba okhurula khulubeleshelo lwamama embeetsanga omuNaziri waNyasaye; nimba nimbekwa, tsingufu tsianje tsiakharulakhwo, nindora, nimba shinga omundu undi yesi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Delila yalola mbu amubooleele kosi akali mumwoyokwe, yakhupila abaami babaFilisiti omunwa, ari Mwitse luno lulala, okhuba yambooleele kosi akali mumwoyokwe. Mana abaami babaFilisiti nibatsia ewuwe, nibali namapeesa tsana mumakhono. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.18",
            "verseOrgIds": [
              "JDG.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namukonia tsindoolo khumakuluke; nalanga omundu, nabeka ebikolo ebio musaafu ebiokhumurwekwe; mana nachaaka okhumunyasia, tsingufutsie nitsimurulakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.19",
            "verseOrgIds": [
              "JDG.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila namuboolela mbu Samusoni, abaFilisiti mbabano! Naye nasisimukha mundoolo, napaara mbu Ndalarula shinga olwa ekholanga buli lwosi, nindibungulula. Ne shiyamanya mbu OMWAMI umurulilekhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaFilisiti nibamuhamba, nibamufutula tsimoni; nibamukholomosia nibamuleera eGaza, nibamuboha nebitiili biomukasa. Ne olwa yali mucheela yalinji omusii. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula liswi eliokhumurwekwe nilichaaka okhumela khandi olunyuma Iwokhubekwakhwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaSamusoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaami babaFilisiti bakhung'aana halala okhumalila Dagoni nyasaye wabwe omusango omukhongo, nokhwikhoya; okhuba basunga mbu Nyasaye weefwe ahaanile Samusoni omusuku weefwe mumukhono kweefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abandu bamulola, bachaaka okhufumia nyasaye wabwe; okhuba basunga mbu Nyasaye weefwe ahaanile omusuku weefwe mumukhono kweefwe, oyo oumululanga eshialo shieefwe, niyeera abanji khwifwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa emioyo chiabwe chiali nichitsatsahalanga, baboola bari Lanje Samusoni, akhukholele emibayo. Nibamulanga Samusoni okhurula mucheela; naye nakhola emibayo imbeli wabwe; mana nibamusinjisia hakari wetsisiilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samusoni nasunjila omusiani owamutiila omukhono ari Lekha endiilekhwo khutsisiilo etsisiilanga inzu, ndisetamiekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inzu tsana yali niyiitsuulemwo abandu, abasaatsa nabakhasi; abaami babaFilisiti nabo bali nibalimwo; khandi khushilama balikhwo abandu shinga ebikhumila bitaru, abasaatsa nabakhasi, abali nibahenganga olwa Samusoni yakhola emibayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
