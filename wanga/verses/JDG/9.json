    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAbimeleki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Abimeleki waYerubaali yatsia eShekhemu ebukhootsanyene, nasungana ninabo nende bosi abeinzu yabwe nyina; ari ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.1",
            "verseOrgIds": [
              "JDG.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chame musungane nabaShekhemu, mubareeba muri Lilayi lili heena, mbu abaana baYerubaali bosi, abandu amakhumi musaafu, bamuruche, nohomba mbu mulala amuruche? Khandi mwitsulile mbu isie endi likumba liokhumubili kweenywe, khandi inyama eyokhumubili kweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.2",
            "verseOrgIds": [
              "JDG.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bakhootsanyene nibarumbula mumarwi kabaShekhemu amakhuwa ako kosi; emioyo chiabwe nichienya okhulonda khuAbimeleki; okhuba basunga mbu Nomwana weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.3",
            "verseOrgIds": [
              "JDG.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuheelesia tsifeetsa amakhumi musaafu okhurula munzu yaBaali-beritsi; Abimeleki natsiikhoonyela okhuhandiika abandu abasilu ababula oburechelefu, nibamulondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.4",
            "verseOrgIds": [
              "JDG.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana natsia ewabasamwana eOfira, niyeerela abaana babwe, abaana baYerubaali, abandu amakhumi musaafu, khwichina elala; habula Yotsamu omwana waYerubaali omushe yasikala; okhuba yali niyeebisile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.5",
            "verseOrgIds": [
              "JDG.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaShekhemu nibakhung'aana halala, nabaBetsimilo, nibatsia nibeemekha Abimeleki abe omuruchi, hamuruba kweisiilo isongokhu eyali muShekhemu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yotsamu yaboolelwa yatsia nasinjila khubutenje bweshikulu shiaGerizimu, nachinga omwoyo nalanjisia, nabasunjila mbu Murechele amarwi, inywe abaShekhemu, mbu Nyasaye naye amurechele inywe eshirwi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.7",
            "verseOrgIds": [
              "JDG.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbu Inyanga yindi emisaala chiarula nichitsia okhwemekha omuruchi achiruche; nichisunjila omutseituni mbu Iwe okhuruche. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.8",
            "verseOrgIds": [
              "JDG.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwo omutseituni nikuchikalusia mbu Nasi ndakhalekha obunulu bwanje, obwikhoonyelungwa okhuheelesia abanyasaye nabandu oluyali, ninzia okhwelela eyi nende eyi ikulu wemisaala? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.9",
            "verseOrgIds": [
              "JDG.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana emisaala nichisunjila omukhuyu mbu Iwe witse okhuruche. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.10",
            "verseOrgIds": [
              "JDG.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhuyu nikuchikalusia mbu Nasi ndakhalekha obumilamili bwanje, nebiamo bianje ebilayi, ninzia okhwelela eyi nende eyi ikulu wemisaala? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.11",
            "verseOrgIds": [
              "JDG.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana emisaala nichisunjila omutsabibu mbu Iwe witse okhuruche. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.12",
            "verseOrgIds": [
              "JDG.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omutsabibu nikuchikalusia mbu Nasi ndakhalekha idivai yanje, eyitsatsahasinjia abanyasaye nabandu, ninzia okhwelela eyi nende eyi ikulu wemisaala? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.13",
            "verseOrgIds": [
              "JDG.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana emisaala chiosi nichisunjila olusasaari mbu Iwe witse okhuruche. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.14",
            "verseOrgIds": [
              "JDG.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olusasaari nilukalusia emisaala mbu Nimuba nimunyemekha toto embe omuruchi oumuruka, kho mwitse mwibise mushiinikha shianje; ne nikarali kario ta, omulilo kurule mulusasaari kusambe emisiita chieLebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.15",
            "verseOrgIds": [
              "JDG.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.15",
            "verseOrgIds": [
              "JDG.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, nimuba nimukholile Abimeleki abe omuruchi mubwatoto nobukololofu; khandi nimuba nimukholeele Yerubaali nabeinzuye bulayi nimumukholela akakhoyeele ebikholebie; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.16",
            "verseOrgIds": [
              "JDG.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba papa yamulwanila, kata yakhachamile okhwirwa, okhumuhonia mumukhono kwaMidiani; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.17",
            "verseOrgIds": [
              "JDG.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa inywe leelo mubuushile okhuseera inzu yapapa; mwiriile abaanabe, abandu amakhumi musaafu, khwichina elala, nimukhola Abimeleki, omwana womukhasi omukholiwe, abe omuruchi wabaShekhemu, shichila nomwihwa weenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.18",
            "verseOrgIds": [
              "JDG.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu nimuba nimukholeele Yerubaali nabeinzuye akali akobwatoto nobukololofu inyanga yino, kho mwikhoyele Abimeleki, naye amwikhoyele inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.19",
            "verseOrgIds": [
              "JDG.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikarali kario ta, omulilo kurule muAbimeleki, kusambe abaShekhemu nabaBetsi-milo; khandi omulilo kurule mubaShekhemu nabaBetsi-milo, kusambe Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.20",
            "verseOrgIds": [
              "JDG.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yotsamu natsia tsimbilo, niyeelukha, natsia eBeeri, namenyayo; shichila yali nariile Abimeleki omwana wabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abimeleki naruka Isiraeli emiyika chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.22",
            "verseOrgIds": [
              "JDG.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naruma roho omubii hakari waAbimeleki nabandu baShekhemu; abaShekhemu nibamukhoba Abimeleki; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.23",
            "verseOrgIds": [
              "JDG.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu akamahababa akakholelwa abaana amakhumi musaafu baYerubaali kakalushe, amabanga kabwe nikamutuukhana Abimeleki omwana wabwe owabeera, nikatuukhana abaShekhemu abamutinyia amakhono okhwira abaana babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.24",
            "verseOrgIds": [
              "JDG.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaShekhemu nibaraho abakonesheli bamulindilile khubutenje bwetsingulu, nibanuula bosi ababirilanga khunjila eyo ewa bali, emiandu chiabwe; mana Abimeleki nahoolelwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.25",
            "verseOrgIds": [
              "JDG.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.25",
            "verseOrgIds": [
              "JDG.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gaali waEbedi niyoolayo nabaana babwe, nahuya natsia eShekhemu; abaShekhemu nibamwisiika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.26",
            "verseOrgIds": [
              "JDG.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatsia mumikunda, nibachesa emikunda chiemitsabibu, nibatsitiinya, nibakhola lisabo, nibeenjila munzu yomunyasaye wabwe; nibalia nokhunywa, nibamunyeka Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.27",
            "verseOrgIds": [
              "JDG.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gzali waEbedi nareeba mbu Abimeleki niye wina, kata Shekhemu nishiina ifwe okhumukhalabanila? Omwana waYerubaali naZebuli omunyaparawe, shibali nibakhalabanila Hamori samwana Shekhemu? Neefu bulaano khubakhalabanila mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.28",
            "verseOrgIds": [
              "JDG.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiamba ndaba nobunyali khubandu bano! Mana ndakhamuyiniaho Abimeleki. Ndakhamusunjila Abimeleki mbu Yinjiyia lihelio, orule!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.29",
            "verseOrgIds": [
              "JDG.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.29",
            "verseOrgIds": [
              "JDG.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Zebuli omuruchi welitookho yahulila amakhuwa kaGaali waEbedi, yatiilwa oburima; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.30",
            "verseOrgIds": [
              "JDG.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "naruma abarume ewaAbimeleki eAruma, ababoola mbu Lola, Gaali waEbedi nabaana babwe boolile eShekhemu, nibayakula litookho okhukhufukula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.31",
            "verseOrgIds": [
              "JDG.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, iwe orule mushilo, nabandu aba oli ninabo, mukoneshele ebulafu; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.32",
            "verseOrgIds": [
              "JDG.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana nibwakhashia mukamba, ohuune noseera litookho; ne lola, olwa alarula nabandu aba ali ninabo okhuseerana nineenyu, obakholele aka oluutsi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Abimeleki narula mushilo, nabandu bosi aba yali ninabo, nibakoneshela eShekhemu emikanda chine. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.34",
            "verseOrgIds": [
              "JDG.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Gaali waEbedi narula, nasinjila habwinjililo bweshilibwa shielitookho; nabo Abimeleki nabandu aba yali ninabo nibabuukha nibarula mwikeno. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.35",
            "verseOrgIds": [
              "JDG.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Gaali yalola abandu abo, yasunjila Zebuli ari Lola, abandu beekha nibarula khubutenje bwetsingulu. Zebuli namukalusia mbu Olola butswa eshiiniini shietsingulu, nokaala mbu nabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.36",
            "verseOrgIds": [
              "JDG.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaali naboola khandi, ari Henga yaho! Abandu bakholomokha nibarula mukari weshialo; kata emukanda mulala kwitsa nikulonda khunjila yomuruba kwabalakusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.37",
            "verseOrgIds": [
              "JDG.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Zebuli namureeba mbu Kho bulaano omunwakwo kuli keena, okwaboola mbu Abimeleki niye wina, ifwe okhumukhalabanila? Bano shibali abandu tsana aba waleka? Bulaano rula otsie olasane ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.38",
            "verseOrgIds": [
              "JDG.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gaali narula imbeli wabaShekhemu, nalasana naAbimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.39",
            "verseOrgIds": [
              "JDG.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abimeleki namulonda, namuyiima, naye namwilukha; abanji nibakwa nibafumiirwekhwo, okhuula khubwinjililo bweshilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.40",
            "verseOrgIds": [
              "JDG.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abimeleki namenya eAruma, ne Zebuli yeelusia Gaali nabaana babwe, baleshe okhumenya muShekhemu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba abandu barula okhutsia mumikunda; naye Abimeleki naboolelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.42",
            "verseOrgIds": [
              "JDG.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabukula abandube nabakabula emikanda chitaru, nibakonekha mumikunda; nahenga, nalola abandu nibarula mwitookho; nabuukha, nabaseera, nabeera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.43",
            "verseOrgIds": [
              "JDG.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki nomukanda okwo okwa yali ninakwo nibeelukha butinyu hambeli, nibasinjila habwinjililo bweshilibwa shielitookho; nabo abemikanda chibili nibatsia butinyu khubosi abali mumikunda, nibabeera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.44",
            "verseOrgIds": [
              "JDG.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki naseera litookho eshiteere eshio tulu; nabukula litookho, niyeera abandu abalimwo; nalikulula litookho liosi, nalimiitsakhwo omuunyu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 9:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu bosi bomunaara kwaShekhemu olwa bahulilakhwo, beenjila mulukoba Iwelitaala liaEli-beritsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.46",
            "verseOrgIds": [
              "JDG.9.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 9:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abimeleki naboolelwa mbu abandu bosi bomunaara kwaShekhemu bali nibakhung'aanile halala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.47",
            "verseOrgIds": [
              "JDG.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Abimeleki natikulukha natsia eneeshikulu shiaZalumoni, halala nabandu aba yali ninabo; Abimeleki nabukula ihaywa mumukhono, narema olusaka kvomusaala, nachinga khwibeka; nasunjila abandu aba yali ninabo ari Eshia muluutsi nikhola, neenyu mwanguhe mukhole murio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.48",
            "verseOrgIds": [
              "JDG.9.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JDG 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandu bosi nibarema bario buli mundu olusakalwe, nibalendakhwo Abimeleki, nibatsira halukoba, nibahambilia olukoba omulilo ikulu khubo; mana abandu bosi bomunaara kwaShekhemu nibafwa, abandu shinga eshikhumila, abasaatsa nabakhasi bosi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.49",
            "verseOrgIds": [
              "JDG.9.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JDG 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.49",
            "verseOrgIds": [
              "JDG.9.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JDG 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Abimeleki ratsia eTsebezi, nakhupa ikambi ahaher gana na Tsebezi, nalibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.50",
            "verseOrgIds": [
              "JDG.9.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JDG 9:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kwalimwo omunaara kwamaani mwitaala, abandu bosi, abasaatsa nabakhasi, nibeelushilamwo, nabakhongo bosi abomwitaala, nibeeyikalilamwo, nibariina khushilama shiomunaara. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.51",
            "verseOrgIds": [
              "JDG.9.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JDG 9:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abimeleki niyoola khumunaara, nakuseera, nasita hamuliango kwomunaara okhukusamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.52",
            "verseOrgIds": [
              "JDG.9.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JDG 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukhasi undi nalasa isio khumurwe kwaAbimeleki, namutubula eshihanganga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.53",
            "verseOrgIds": [
              "JDG.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JDG 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kko bwangu yalanga omusooliili omuchinji webimanulwabie, namubiila mbu Tsomola olukangalwo, unzire, abandu baleshe okhusungakhwo mbu Omukhasi yamwira. Omusooliiliwe namufumira, nafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.54",
            "verseOrgIds": [
              "JDG.9.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JDG 9:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abaIsiraeli balola mbu Abimeleki ufwile, beenyokha nibatsia buli mundu ewuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
            "verseOrgIds": [
              "JDG.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JDG 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Nyasaye yakalusia obumayaanu bwaAbimeleki, obwa yakholela samwana niyeera abaana babwe amakhumi musaafu; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.56",
            "verseOrgIds": [
              "JDG.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JDG 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi obumayaanu bwosi bwabaShekhemu, Nyasaye yakalusia khumirwe chiabwe; nibatuukhana amanyeko kaYotsamu waYerubaali.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.57",
            "verseOrgIds": [
              "JDG.9.57"
            ]
          }
        }
      ]
    }
