    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu baGideoni bahula abamidiani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yerubaali, niye Gideoni, yahuuna mumabwibwi, nende abandu bosi aba yali ninabo, nibakhupa ikambi hasebele yaHarodi; nayo ikambi yaMidiani yali elubeka lwanotsi, hashikulu shiaMore, mwibanda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Gideoni mbu Abandu aba oli ninabo nabanji okhushila; shinyala okhuhaana Midiani mumukhono kwabwe ta; Isiraeli yakheeyitsoomia, mbu omukhonokwe omwene nikwo okumuhonive. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano tsia otangasie, abandu nibahulila, mbu Omundu yesi ouriitsanga nokhutechela, yeenyoshe atsie ingo. Gideoni nabateema ario, abandu nibeenyokha ebikhumila amakhumi kabili nabibili; nibasikala ebikhumila ekhumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Gideoni mbu Kata bulaano abandu bashili abanji okhushila. Obayile khumatsi, ekhuteemeleyo abandu. Mana oyo owa ndalakhuboolela mbu Uno otsie ninaye, niye owa olatsia ninaye; ne oyo owa ndalakhubeolela mbu Uno shiolatsia ninaye ta, kho aleshe okhutsia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.4",
            "verseOrgIds": [
              "JDG.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yayila abandu hamatsi; OMWAMI naboolela Gideoni mbu Buli mundu oukapula amatsi nolulimi, shinga imbwa olwa yikapulanga, omure elubeka yenyene; kata buli mundu ousikama niyeenama okhunywa ario. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.5",
            "verseOrgIds": [
              "JDG.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obunji bwa abo abakapula nomukhono bali abandu ebikhumi bitaru; habula abandi bosi basikama nibeenama okhunywa amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.6",
            "verseOrgIds": [
              "JDG.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI nasunjila Gideoni mbu Ndalamuhonia khulwa abandu abo ebikhumi bitaru abakapula bario nihaana abaMidiani mumukhonokwo; nebutswa abandi bosi batsie buli mundu ewuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.7",
            "verseOrgIds": [
              "JDG.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabukula tsisiongo etsia abandu abo bali ninatsio nende tsinzika tsiabwe; naruma abaIsiraeli buli mundu khwiheemalie, ne natong'a nende abo ebikhumi bitaru; ne ikambi yabaMidiani yali niyili emwalo mwibanda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.8",
            "verseOrgIds": [
              "JDG.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushilo shieneshio OMWAMI yamuboolela mbu Buukha; kholomokha otsie okhuseera ikambi; okhuba enjihaanile mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa noba noriile okhukholomokha, iwe omwene otsie naPura omusumbawo mukambi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.10",
            "verseOrgIds": [
              "JDG.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho olahulila aka baboolanga; nolunyumakhwo olaba niwumile ikholo okhukholomokha otsie okhuseera ikambi. Mana yakholomokha halala nende Pura omusumbawe, okhuula khubandu bebimanulwa abali khundulo weikambi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.11",
            "verseOrgIds": [
              "JDG.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaMidiani nabaAmaleki nabandu bebukwe tosi bali nibamaamile mwibanda shinga tsisiche obunji bwabwe; kata tsingamia tsiabwe natsio shitsiabalikha ta, obunji shinga omuyeeshe okwokhulukuku lweinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.12",
            "verseOrgIds": [
              "JDG.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Gideoni yoolayo yanyoola omundu natoonyelanga owashie akelilooro; ari Lola, endoorile lilooro; mbu omukaate mulala kweishayiri kulakaashe nikukomongoma nikwitsa mukambi yaMidiani, nikuula khwiheema, nikulikhupa, nikulikwisia nikulifumamia, nalio nilipaama nilikona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.13",
            "verseOrgIds": [
              "JDG.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owashie namukalusia mbu Lino shilichweya okhuba olukanga lwaGideoni waYoashi, omuIsiraeli, ta; Nyasaye ahaanile Midiani nelihelie liosi mumukhonokwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.14",
            "verseOrgIds": [
              "JDG.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Gideoni yahulila akelilooro nikatoonywa, nende oburimbululi bwalio, yamwinamila OMWAMI; mana nakalukha mukambi yaIsiraeli naboola mbu Buushe; okhuba OMWAMI uhaanile lihe liaMidiani mumukhono kweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.15",
            "verseOrgIds": [
              "JDG.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yakabula abandu abo ebikhumi bitaru emikanda chitaru, nabaheelesia bosi tsinzika mumakhono, nende tsisiongo tsikhaya, nebitseso musiongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.16",
            "verseOrgIds": [
              "JDG.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela mbu Munenjenje, nimukhola murio; ne ninzulile khundulo weikambi, aka ekhola isie, neenyu mukhole murio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.17",
            "verseOrgIds": [
              "JDG.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ekhupa olwika, isie nabosi aba endi ninabo, neenyu mwesi mukhupe tsinzika, tsimbeka tsiosi tsieikambi, nimulanjisia mbu Khulwa OMWAMI, khandi khulwa Gideoni!",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.18",
            "verseOrgIds": [
              "JDG.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gideoni nende abzndu abo eshilihumi aba yali ninabo niboola khundulo weikambi mukhubameeso khubulindi okhwomushilo hakari, olwa bali nibakharaho abalindi; nibakhupa tsinzika, nibaaraka tsisiongo etsia bali nibachinjile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.19",
            "verseOrgIds": [
              "JDG.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abemikanda echio chiosi chitaru nibakhupa tsinzika, nibaaraka tsisiongo, nibatiila ebitseso buli mundu mumukhono mukhasi, nolwika mumukhono musaatsa, khulwa okhuupa; nibalanjisia mbu Olukanga lwOMWAMI, nolwa Gideoni! ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.20",
            "verseOrgIds": [
              "JDG.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasinjila buli mundu mumasinjike okhubotokhana ikambi; abelihe elo liosi nibeelukha, nibakhupa amakhu, nibeelukha bwilukha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.21",
            "verseOrgIds": [
              "JDG.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakhupa tsinzika tsana ebikhumi bitaru, OMWAMI nashiukhasia olukanoa lwabuli mundu khuwashie, nende khwihe liosi; abelihe tsana nibeelukha okhuula eBetsishita, khunjila yaZerera, okhuula khulwakho lwaAbelimehola ahambi nende Tabitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaIsiraeli nibakhung'aana halala, abarula muNafutali, nomuAsheri, nomuManase yosi, nibalondachilila Midiani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.23",
            "verseOrgIds": [
              "JDG.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gideoni yaruma abarume mushialo shiebikulu shiaEfuraimu, okhuboola mbu Kholomoshe, mwitse museere Midiani, mubukule emialo imbeli wabwe, okhuula eBetsi-bara, nende Yorodani. Kho abaEfuraimu bosi nibakhung'aana halala, nibabukula emialo okhuula eBetsi-bara, nende Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibahamba abakhulundu babili baMidiani, mbu Orebu naZeebu; nibamwirila Orebu halwanda lwaOrebu, naye Zeebu nibamwirila hashitiinyilo shieidivai shiaZeebu; nibalondachila Midiani; nibeetsa nomurwe kwaOrebu nokwa Zeebu ewa Gideoni yali, injelekha weYorodani.",
