            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa abelitaala babuukha mumabwibwi, banyoola eshimalilo shiaBaali nishilikuluulwe, omuAshera okwalinji ahambi ninashio nikuremilwe, nayo isurusi yakhabili tsana niyimalilwe yibe omusango khushimalilo eshiumbaakhwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibareebana bari Niwina oukholile lino? Ne olwa bali nibarunilisiye nokhureebelesia, baboola mbu Gideoni waYoashi niye oukholile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abelitaala nibasunjila Yoashi bari Rusia omwanawo, yeerwe, shichila alikuluule eshimalilo shiaBaali, khandi shichila aremile omuAshera okubeelenje ahambi ninashio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yozshi nasunjila bosi abasinjila nibamufukula, ari Mwenya okhusoola Baali? Kata mwenya okhumuterela? Owenya okhumusoola, yeerwe nibushili okhushia. Naba nali omunyasaye, yeesoole omwene, shichila omundu alikuluule eshimaliloshie. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, khunyanga yeneyo yakulikhwa mbu Yerubaali, eshisina mbu Baali asoolane ninaye; okhuba yalikulula eshimaliloshie.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaMidiani bosi nabaAmaleki nende abebukwe nibakhung'aana halala, nibaambukha Yorodani, nibakhupa ikambi mwibanda liaYezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Roho w niyeenjila muGideoni; naye nakhupa olwika, abaAbiezeri nibakhung'aana halala nibamulondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yaruma abarume muManase yosi; nabo bosi nibakhung'aana halala okhumulondakhwo. Naruma abarume muAsheri, naZabuloni, naNafutali; nibatikulukha bosi nibeetsa okhubaakanila.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gideoni nasunjila Nyasaye ari Noba noli okhuhonia Isiraeli khulwa omukhono kwanje, shinga olwa waboola, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "lola, ndalara obwoya bwelikondi khulutse; mana eliime niliba niliama khubwoya tsana bwonyene, liloba liosi niliba eliumu, kho nemanye mbu witsa okhuhonia Isiraeli nomukhono kwanje, shinga olwa waboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba kario; mbu nibwakhashia mukamba yahuuna, nafwinya obwoya tsana, natiinya eliime eliali mubwoya, amatsi nikeetsula mulutaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gideoni nasunjila Nyasaye ari Orasinyishila ta, ndalasunga khandi lulala lwonyene; ekhusaaya mbu ochame endeeme khandi nobwoya buno lulala luno lwonyene; bulaano obwoya bube obuumu, obwene bwonyene, ne eliime liame khwiloba liosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nakhola ario eshilo shieneshio; mbu obwoya bwali obuumu, obwene bwonyene, ne eliime liali niliamile khwiloba liosi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
