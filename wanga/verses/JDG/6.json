    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulango kwaGideoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli bakhola akali amabii mumoni tsiOMWAMI; OMWAMI nabahaana mumukhono kwaMidiani emiyika musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.1",
            "verseOrgIds": [
              "JDG.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhono kwaMidiani nikuhula Isiraeli; ne khulwa Midiani, abaana baIsiraeli beekasilia tsimbangatsi etsio etsili mungulu, netsimbinga, netsingoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.2",
            "verseOrgIds": [
              "JDG.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli olwa abaIsiraeli bali nibamalile okhuraaka, abaMidiani batikulukhanga nibeetsa, nabaAmeleki, nabandu bebukwe, nibeetsa okhubaseera; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.3",
            "verseOrgIds": [
              "JDG.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhupanga ikambi ahahengana ninabo, niboonoonia imele yeliloba, okhuula eGaza, nibaralekhakhwo eshiokhulia muIsiraeli ta, kata likondi, kata ing'ombe, kata isishili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.4",
            "verseOrgIds": [
              "JDG.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali nibatikulukhanga nemiruko chiabwe, namaheema; beenjilanga shingana tsisiche obunji bwabwe; shibabalikha ta, kata tsingamia tsiabwe tawe; ne beetsanga mushialo nibashimulula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.5",
            "verseOrgIds": [
              "JDG.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Isiraeli yatiitiyibwa muno khulwa Midiani; mana abaana baIsiraeli nibahaabila OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.6",
            "verseOrgIds": [
              "JDG.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa abaana baIsiraeli bahaabila OMWAMI khulwa Midiani, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.7",
            "verseOrgIds": [
              "JDG.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI yarumila abaana baIsiraeli omunabii; naye nababoolela mbu OMWAMI, Nyasaye waIsiraeli, asunga mbu Ndamutikulusia okhurula muMisiri, nimurusia munzu yobunyakhani, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.8",
            "verseOrgIds": [
              "JDG.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuhonia mumukhono kwabaMisiri, nomumukhono kwabo bosi abamusandinjia, nimbeelusia imbeli weenywe, nimuheelesia eshialo shiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.9",
            "verseOrgIds": [
              "JDG.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndamusunjila mbu Isie nisie OMWAMI Nyasaye weenywe; murariitsanga abanyasaye babaAmori, aba mumenyanga mushialo shiabwe, ta; nebutswa shimuhuliilenje amakhuwa kanje tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.10",
            "verseOrgIds": [
              "JDG.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne malaika wOMWAMI niyeetsa, niyeekhala hasi womuruba okwo okuli eOfira, okwali kwaYoashi omuAbiezeri; naye omwanawe Gideoni yali nahuulanga ingano mushitiinyilo shieidivai, okhuchibisa khulwa abaMidiani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.11",
            "verseOrgIds": [
              "JDG.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wOMWAMI namuloleshela namusunjila mbu Iwe omundu omululu weitswoni, OMWAMI ali halala ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.12",
            "verseOrgIds": [
              "JDG.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Gideoni namukalusia mbu Nebutswa, Omwami, OMWAMI naba nali halala nineefwe, kho kano kosi kakhukwiliile mbushiina? Bili heena ebikholebie biamangaliimwa biosi ebia abakuuka bakhuboolelakhwo, bari Ne OMWAMI shiyakhurusia muMisiri? Nebutswa bulaano OMWAMI wakhusukuune, nakhuhaana mumukhono kwabaMidiani ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.13",
            "verseOrgIds": [
              "JDG.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nashiukhana namuhenga, nasunga mbu Tsia mumaaniko kano, ohonie Isiraeli mumukhono kwaMidiani; shindi isie oukhuruma? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.14",
            "verseOrgIds": [
              "JDG.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namusunjila mbu E Omwami, nasi nembonie Isiraeli endie? Lola, eshilibwa shieefwe neshimanani muManase, nasi endi omutuutu munzu yeefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.15",
            "verseOrgIds": [
              "JDG.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila mbu Shindalachweya okhubeetsanga ninawe ta; nawe olakhupa abaMidiani shinga emundu mulala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Nimba ningoosibwa imbeliwo bulaano, umbeesie eshilolelo mbu niwe ousungana ninasi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya mbu orarula hano ta okhuula olwa emba ningaluushe nikhuleerela eshihaanwa shianje, nishira imbeliwo. Naye nasunga mbu Ndalalinda okhuula olwa olakalukha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gideoni niyeenjila munzu, nakasia eshimeeme shieimbusi, namaandasi akabulzmwo amamela akakasilibwa efa ndala yobusie; yara inyama mundubi, nomuunyu nakura khushikaye, namuleerela ewa yali, hasi womuruba, namuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika waNyasaye namubiila mbu Bukula inyama namaandasi, obire khulwanda luno, notsukhakhwo omuunyu. Naye nakhola ario. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.20",
            "verseOrgIds": [
              "JDG.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana malaika wOMWAMI nanyiila omurwe kweindabushi eya yali ninayo mumukhono, niyeenakhwo khunyama namaandasi tsana, mana omulilo nikurubukha nikurula mulwanda, nikusamba inyama namaandasi kutu; malaika wOMWAMI narula nahwaho namukhamakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.21",
            "verseOrgIds": [
              "JDG.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gideoni natiila khushisina. Mbu nimalaika wOMWAMI; Gideoni nasunga mbu Woowe, OMWAMI Nyasaye! Shichila enduutsi malaika wOMWAMI mumoni khumoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.22",
            "verseOrgIds": [
              "JDG.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila mbu Lema omwoyo; oraria ta; shiwitsa okhufwa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Gideoni yamuumbashila OMWAMI eshimalilo habwenaho, nashilznga mbu Yahweh-shalomu; nzshio shishiliho okhuula olwa leelo eOfira liaAbiezeri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushilo shieneshio, OMWAMI yamuboolela mbu Bukula isurusi yaso, isurusi eyo yakhabili eyemiyika musaafu; khandi olikulule eshimalilo shiaBaali, eshia so ali ninashio, norema omuAshera okuli ahambi ninashio. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuumbashile OMWAMI Nyasayewo eshimalilo hekulu khulukoba luno, niwanza bulayi; obukule isurusi eyo yakhabili, omale omusango omusambe netsikhwi tsiomuAshera tsana okwa witsa okhurema. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiho Gideoni nabukula abandu ekhumi khubasumbabe, nakhola shinga OMWAMI olwa yali nzmubooleele; ne okhuba yali nariile abeinzu yasamwana nende abandu belitaala, shiyanyala okhukhola mushiteere ta; habula yakhola mushilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
