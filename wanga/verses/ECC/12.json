    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yitsulila Omulonjiwo mundaalo tsiolusooliililwo, tsindaalo tsimbii nitsirashieetsa ta, kata emiyika okhusita ahambi, olwa olisunga mbu Shichinjamisia ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.1",
            "verseOrgIds": [
              "ECC.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa eliuba, nobulafu, nomwesi, netsinyininyini birashiamaliha ta, tsinjeka nitsikalukha inyuma weifula; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.2",
            "verseOrgIds": [
              "ECC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "khunyanga olwa abalindi beinzu balitechela, abasaatsa bamaani nibeenama, abasieetsanga nibalekha, shichila nabatuutu, abalimwo nibahenjela elwanyi mumatirisha nibeelima, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.3",
            "verseOrgIds": [
              "ECC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "emiliango echiokhunjila nichiikalwa; olwa obuyoka bwokhusia buli hasi, omundu nabuukha khulwa omwoyo kwelinyoni, nabo abakhaana bobwimbi nibeesibwa hasi; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.4",
            "verseOrgIds": [
              "ECC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bariitsanga ebili ikulu, amariisia nikali khunjila; omukomari kumulikha, liteete limusitohela, ne obwikombi bwakama; shichila omundu atsia hangowe hobumeli, nabo abeekhuuli bachenda khunjila; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.5",
            "verseOrgIds": [
              "ECC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omukoye kweifeetsa nikurashiakhalikha ta, kata eshikaye shieitsahaabu okhutubukha, kata isiongo okhwatishila hasebele, kata omukurutumo okhufinishila heeyabo; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.6",
            "verseOrgIds": [
              "ECC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "olufu nilukalushila khwiloba shinga olwa lwali, iroho nayo niyikalushila Nyasaye owachihaana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.7",
            "verseOrgIds": [
              "ECC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namakhaya kuru, Omwilwatsi aboola; kosi kali butswa amakhaya.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukuuli kwamakhuwa akakhoyeele omundu okhukhola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.8",
            "verseOrgIds": [
              "ECC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halala nende okhuba omuchesi, Omwilwatsi yali niyeechesinjia abandu obumanyi; yachela nakhaaba niyaanza tsinjelo tsinyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwilwatsi yakhaabanga amakhuwa akachamisia, nahandiika amakhuwa kobwatoto mubulunjishi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa komuchesi kali shinga tsisaala tsimemu etsiokhuruchila emiruko; nako amasungo akakhung'aasibwa akahaanwa nomwayi mulala, kali shinga emisumari echiakhomwa bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.11",
            "verseOrgIds": [
              "ECC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mwana wanje, wirecheshe khukashila kano. Okhuhandiika ebitabu khubula eshiakamo; nokhusooma okhunji khuchoonyia omubili.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.12",
            "verseOrgIds": [
              "ECC.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho amakhuwa kaakame yaho; kosi kahuliilwe; riitsanga Nyasaye, nokhola akamalakoke okhuba ako konyene niko aka omundu akhoyile okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.13",
            "verseOrgIds": [
              "ECC.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Nyasaye alayaasia buli shikhole, halala nende buli likhuwa liamabiswi, kata nilili lilayi kata nilili libii.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.14",
            "verseOrgIds": [
              "ECC.12.14"
            ]
          }
        }
      ]
    }
  ],
