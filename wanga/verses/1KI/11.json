{
  "id": "1KI.11",
  "number": "11",
  "bookId": "1KI",
  "reference": "1 Abaruchi 11",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "1KI 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omwoyo kwaSulemani okhushiukhasibwa. Akabafukulibe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi Sulemani yaheelanga abakhasi abasuku abanji, halala nende omukhaana waFarao tsana, mbu abakhasi abaMoabu, nabaAmoni, nabaEdomu, nabaSidoni, nabaHiti; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abamahanga tsana aka OMWAMI yaboolelakhwo abaana baIsiraeli mbu Murateeshaninjia ninabo, kata bo okhuteeshania nineenyu ta; okhuba shibalachweya okhushiukhasia emioyo chieenywe okhulonda khubanyasaye babwe ta; ne Sulemani yahanda khubeenabo nabaheelanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali nabakhasibe ebikhumi musaafu, abakhaana babaami, nende abasuria ebikhumi bitaru; nabo abakhasibe nibashiukhasia omwoyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa Sulemani yali nakofuule, abakhasibe bashiukhasia omwoyokwe okhulonda khubanyasaye bandi; omwoyokwe nikuraba omwisiikwa khuMWAMI Nyasayewe shinga omwoyo kwaDaudi samwana olwa kwalinji ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Sulemani yalonda khuAshitoretsi, omunyasaye weshikhasi wabaSidoni, nende Milikomu, okusinyo kwabaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani nakhola akali amabii mumoni tsiOMWAMI, naralonda OMWAMI nomwoyo kwosi shinga Daudi samwana olwa yakhola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sulemani niyoombakha habundu aheechingu khulwa Khemoshi okusinyo kwebuMoabu, mushikulu eshili ebukwe weYerusalemu, khandi khulwa Molekhi okusinyo kwabaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yabakholela ario abakhasibe abasuku abo bosi, abali nibasambanga amalesi kelibuuliesi nibamalila abanyasaye babwe emisango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI yatiililwa Sulemani oburima, okhuba omwoyokwe kwali nikushiukhaane nikumulekha OMWAMI, Nyasaye waIsiraeli, owali niyamuloleshela khabili, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyamulaka khwikhuwa lienelo, mbu aralondakhwo abanyasaye bandi ta; nebutswa shiyalinda ako aka OMWAMI yalaka ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako OMWAMI naboolela Sulemani ari Olwa kano niko aka oli ninako, ne noralindanga indakano yanje nende aka ndalachilisia, shinga olwa ndakhulaka, shindalachweya tawe okhwitsumba oburuchi bukhurulekhwo, nimuheelesia omusambawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khulwa Daudi so, shindalakhola endio mundaalo tsitsio ta; ne ndalabwitsumba burule mumukhono kwomwanawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shindaleetsumba oburuchi nimburusiaho bwosi ta; habula ndalaheelesia omwanawo oluyia lulala, khulwa Daudi omusumba wanje, khandi khulwa Yerusalemu elia ndalobola.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI nabuusilia Sulemani omufukuli, mbu Hadadi omuEdomu; yali owolwibulo Iwomuruchi muEdomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa Daudi yali nali muEdomu, Yoabu omuseesia welihe naye natikuluushe natsiile okhuyabila abo abeerwa, yamala yeere buli mundu weshisaatsa muEdomu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Yoabu nabaIsiraeli bosi batong'ayo emiesi chisasaba, okhuula olwa yali nasisiye buli oweshisaatsa muEdomu; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Hadadi niyeelukha, halala nabaEdomu bandi abokhubasumba basamwana, nibatsia eMisiri; ne Hadadi yali nashili butswa omwana omutiiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabuukha okhurula muMidiani, niboola eParani; nibeetsa nende abandu bandi abarula eParani niboola eMisiri, ewaFarao omuruchi waMisiri; naye namuheelesia inzu, nalaka mbu akabilungwe ebiokhulia, namuha emikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Farao yamukoosia Hadadi muno; namubashila mulamunyene, omukhaana wabwe Tapenesi omukhayewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hadadi nende omukhaana wabwe Tapenesi nibeebula omwana, mbu Genubatsi; ne Tapenesi namulelela munzu yaFaraoGenubatsi naba munzu waFarao, halala nabaana baFarao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Hadadi olwa yahulila ewa yali eMisiri mbu Daudi ukonile nalonda abakuukanyene, khandi mbu Yoabu omuseesia welihe ufwile, Hadadi namusaba Farao mbu Ochame nzinyoshe, enzie mushialo shianje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao namureeba mbu Eshia otambile nikhuli ninawe nishiina, eshichila niwenya okhutsia mushialoshio? Naye nakalusia mbu 'A, eshindu shiosi ta; nebutswa chama nzinyoshe endio.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Nyasaye namubuusilia omufukuli undi, mbu Rezoni waEliada, owali niyeelukha omwamiwe Hadadezeri omuruchi waZoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yakhung'aasia abandu, nakwa omwimilisi weing'anda yabaseeri, olunyuma Iwobwiri bwaDaudi; nibatsia eDamasiko, nibamenyayo, naye naba omuruchi muDamasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali omufukuli waIsiraeli tsindaalo tsiosi tsiaSulemani, naleera amatinyu shinga akaHadadi; Isiraeli yamusinya; ne yaruka Siria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Yeroboamu waNebati, omuEfuraimu weZereda, omusumba waSulemani, omwana womukhasi omulekhwa owa eliiralie liali Zerua, yesi yachinga omukhono okhufukula omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kano niko akachila nachinga omukhono okhufukula omuruchi; mbu Sulemani yoombakha Milo, niyeekala eshibanga eshiomwitookho liaDaudi, samwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu oyo Yeroboamu yali omutinyilifu; Sulemani nalola omusooliili oyo, shinga olwa yali omulumilifu, namukhola abe omusinjilili wabakholi abalunyibwa munzu yaYusufu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo etsio, olwa Yeroboamu yarula eYerusalemu, omunabii Ahiya omuShilo yamunyoola nali khunjila; ne Ahiya yali niyeefwalile ingubo imbianabo babili bali bonyene ebulafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiya natiila ingubo eyo imbia eya yali niyeefwalile, nachirandula ebitonye ekhumi nabibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila Yeroboamu mbu Bukula ebitonye ekhumi; okhuba kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola; mbu Lola, ndalarandula obwami burule mumukhono kwaSulemani, nikhuheelesia iwe tsimbia ekhumi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula ye alaba noluyia lulala, khulwa Daudi omusumba wanje, khandi khulwa Yerusalemu, litookho elia ndalobola mumbia tsiosi tsiaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila yandekha, niyeenamila Ashitoretsi, omunyasaye weshikhasi owabaSidoni, naKhemoshi omunyasaye waMoabu, naMilikomu omunyasaye wabaana baAmoni; kata shiyachendile khunjila tsianje, okhukhola akali amalayi mumoni tsianje nokhulinda aka ndalachilisia nakobukhalachi bwanje, shinga Daudi samwana olwa yakhola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shindalayinia oburuchi bwosi mumukhonokwe ta; habula ndalamukhola abe omukhulundu tsindaalo tsiosi tsiobulamubwe, khulwa Daudi omusumba wanje owa ndalobola, shichila ye yalinda amalako kanje, naka ndalachilisia kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalayinia oburuchi mumukhono kwomwanawe, nikhuheelesia iwe, mbu tsimbia ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omwanawe ndalamuheelesia oluyia lulala, mbu Daudi omusumba wanje abeetsenje neitaha imbeli wanje tsindaalo tsiosi eYerusalemu, litookho elo elia ndeelobolela okhuramwo eliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalakhubukula iwe, nawe olaruka khubwosi obwa omwoyokwo kwenya, noba omuruchi khuIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne noba nohulilenje kosi aka ekhulaka, nochenda khunjila tsianje, nokhola akali habwene mumoni tsianje, nolindanga aka ndalachilisia namalako kanje, shinga Daudi omusumba wanje olwa yakhola, kho ndalabeetsanga ninawe halala, nikhuumbashila inzu iralilu shinga olwa ndamuumbashila Daudi, nikhuheelesia Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwako ndalasandia olwibulo lwaDaudi, habula obushia nobushia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila Sulemani niyeenya okhwira Yeroboamu; nebutswa Yeroboamu yarula, niyeelukha natsia eMisiri, ewaShishaki omuruchi waMisiri, nabayo muMisiri okhuula khukhufwa khwaSulemani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaSulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaSulemani, naka yakhola kosi, nobuchesibwe, shikahandiikwa mushitabu shiamakhuwa kaSulemani? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo etsia Sulemani yaruka muYerusalemu khuIsiraeli yosi tsiahela emiyika amakhumi kane. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani nakona nalonda khubakuukanyene, nayabilwa mwitookho liaDaudi samwana; naye Rehoboamu omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
  ],
