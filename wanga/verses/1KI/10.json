    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omuruchi weshikhasi owaSheba yacheniha ewaSulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omuruchi weshikhasi owaSheba yahulila akeifuma yaSulemani mukeliira liOMWAMI, yeetsa okhumuteema namareebo amatinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yoola eYerusalemu nali nomukanda omukhongo, ne tsingamia etsiachinga tsindesi tsieshiuya eshilayi, neitsahaabu inyinji, noruchina orwolukoosi; ne olwa yoola ewaSulemani, yasungana ninaye khukosi akali mumwoyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani namukalusia amareebo kosi; kata shilialiho likhuwa liosi litinyu eliakhaya omuruchi okhumuboolela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omuruchi weshikhasi owaSheba yali naluutsi obuchesi bwosi bwaSulemani, nende inzu eya yoombakha, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebiliibwa ebiokhumeesaye, nobwikhalo bwabasumbabe, nobukhalabani bwabakhalabanibe, nebiifwalo biabwe, nabasumba abamukaamilanga eshikombe, nemisango emisambe echia yamalilanga munzu yOMWAMI, yafwa omwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yasunjila omuruchi ari Aka ndaboolelwa mushialo shianje khukebikholebio nakobuchesibwo kali akatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shindakasuubila ta, okhuula olwa ndayeetsile, tsimoni tsianje nitsilola; ne lola, shindaboolelwa kata inusu ta, obuchesibwo noburabaalibwo bushila kata ifuma eya ndahulilakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhasibo nabeikhabi, kata abasumbabo bano nabeikhabi, abasinjilanga imbeliwo tsindaalo tsiosi nibahulila obuchesibwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasayewo yeetsoomibwe, owakhuchama nakhwemekha khushifumbi shioburuchi shiaIsiraeli! Okhuba OMWAMI yaheela Isiraeli obushia nobushia, niyeshichila nakhukhola omuruchi, okhukholanga akobuyaasii nende obulunjishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namuheelesia omuruchi itsahaabu tsitalanda eshikhumi namakhumi kabili, netsindesi tsieshiuya tsinyinji muno, noruchina rwolukoosi; kata obunji bwetsindesi tsana tsieshiuya shinga obwa omuruchi weshikhasi owaSheba yaheelesia omuruchi Sulemani shibwamala bwitsekhwoyo khandi ta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omukanda kwamaaro kaHiramu, akaleera itsahaabu okhurula eOfiri, karusia muOfiri emisaala chiemisandali eminji, noruchina rwolukoosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nakhola emisaala tsana chiemisandali tsisiilo tsieinzu yOMWAMI, nende etsieinzu yomuruchi, khandi nende obukhana namatungu ebiabeembi; kata emisaala chiemisandali echiafwana chirio shichiamala chiitsekhwo kata okhulolekha ta, okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi Sulemani yamuheelesia omuruchi weshikhasi owaSheba biosi ebia yeenya ebia yasaba biosi biosi, khandi nende ebindi ebia Sulemani yamuheelesilia omukhono omusiro kwoburuchi. Kho yashiukhana niyeenyokha, natsia mushialoshie, ye nabasumbabe bosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuyinda bwaSulemani, neifwnaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusiro bweitsahaabu obwaleerelwa Sulemani mumuyika mulala bwahela tsitalanda ebikhumi bisasaba, amakhumi kasasaba natsisasaba, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi nende etsio etsiarula khubahooni, nobukhala bwabeinganga, nokhurula khubaruchi bebuArabu, nokhubakafana beshialo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi Sulemani nakhola tsingabo ebikhumi bibili etsiakholwa itsahaabu inziraanye; buli ngabo yakholwa itsahaabu tsishekeli ebikhumi bisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhola nende ebikhumba ebikhumi bitaru ebieitsahaabu inziraanye; buli shikhumba shiakholwa itsahaabu tsimina tsitaru; omuruchi natsira muNzu yOmutsuru kwaLeba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omuruchi yakhola eshifumbi shioburuchi shiameeno ketsinzofu, nashifuumakhwo itsahaabu inzeleleshe muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalikhwo amaniinilo kasasaba akoola khushifumbi tsana; eshitonye shiashio shiemukongo shialikhwo omurwe kweshimoosi; bialiho ebiokhwisiililakhwo amakhono elubeka eyi nende eyi wobwikhalo bwene, netsitalanyi tsibili etsirondokhaane ninabio; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi tsitalanyi ekhumi natsibili tsiasinjisibwa khumaniinilo ako kasasaba, eyi nende eyi; kata shishialiho eshiakholwa shinga eshio mubwami bwosi bwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebia omuruchi Sulemani yanyweelangamwo biosi biali ebieitsahaabu, nebimanulwa biosi bieInzu yOmutsuru kwaLebanoni nabio biali bieitsahaabu inzeleleshe; shishialikhwoho eshieifeetsa shiosi ta; yo shiya paarwakhwo mbu neshindu mundaalo tsiaSulemani tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khunyanza omuruchi yali nomukanda kwamaaro kwaTarashishi, halala nomukanda kwamaaro kwaHiramu; ne lulala mumuyika chitaru omukanda kwamaaro kwaTarashishi kweetsanga nikuleera itsahaabu, neifeetsa, nameeno ketsinzofu, namashene, netsinguche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ario omuruchi Sulemani yashila abaruchi bosi beshialo obuyinda nobuchesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeshialo shiosi beenyanga okhubaho ewa Sulemani yali, okhuhulila obuchesibwe obwa Nyasaye yali nareele mumwoyokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleera buli mundu omuruulukwe, mbu ebindu bieifeetsa, nebindu bieitsahaabu, nebiifwalo, nebimanulwa, netsindesi tsieshiuya, netsifarasi, nende tsinyumbu, eshichelo nalebe omuyika buli muyika.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulemani yekhola obukhala bwetsifarasi namakaari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani yali nakhung'aasinjia amakaari nabandu abachendela khufarasi; yali namakaari eshikhumila nebikhumi bine, aka yabiikhanga mumataala kamakaari, nahalala nomuruchi eYerusalemu, halala nende abachendela khufarasi, ebikhumila ekhumi nabibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi yakutsia ifeetsa muYerusalemu shinga amachina, nemisiita shinga emikhuyu chiomuShefela obunji bwachio. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsifarasi etsia Sulemani yali ninatsio tsiarusibungwa muMisiri; abahooni bomuruchi batsinyoolanga okhurula eKoa, nibatsirunga obukusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likaari liarusibungwa muMisiri nilileerwa khulwa tsishekeli ebikhumi bisasaba tsieifeetsa; kata ifarasi, eshikhumi namakhumi karaano; mana abahooni bomuruchi batsiyililanga abaruchi bosi babaHiti nabaruchi baSiria bario.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
      ]
    }
