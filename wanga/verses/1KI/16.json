      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI lieetsela Yehu waHanani, okhufukula Baasha, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ndakhukhulunduyia nikhurusia mulufu, nikhukhola omwimilisi wabandu banje Isiraeli; nawe olwa wachendilenje khunjila yaYeroboamu, nochila abandu banje Isiraeli niboonoona, nibasinyisia nebionoono biabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho lola, ndalamalilana Baasha neinzuye yosi; ndalakhola inzuye yibe shinga inzu yaYeroboamu waNebati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi waBaasha oufwila mwitaala, tsimbwa tsilamulia; ne omunduwe oufwila ebulafu, amanyonyi akokhwikulu kalamulia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaBaasha, naka yakhola, nende akobululubwe, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Baasha nakona nalonda khubakuukanyene, nayabilwa eTiriza; naye Ela omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi likhuwa liOMWAMI lieetsela mumunwa kwomunabii Yehu waHanani okhufukula Baasha, nokhufukula inzuye, khulwa amabii kosi aka yakhola mumoni tSiOMWAMI, okhumusinyisia nebikhole biamakhonoke, nafwanana nabeinzu yaYeroboamu; khandi shichila yachisisia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaEla",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kabili nakhasasaba kwaAsa omuruchi waYuda, Ela waBaasha yachaaka okhuruchila Isiraeli eTiriza, naruka emiyika chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusumbawe Zimiri, owasinjilila inusu yamakaarike, yatsia namusanjilila okhumukhaya; ne yali nali eTiriza, nanyweetsanga nameelela munzu yaAriza, owasinjilila litaala liomuruchi muTiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Zimiri niyeenjila, namuupa, namwira, mumuyika kwamakhumi kabili namusaafu kwaAsa omuruchi waYuda, naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nashichaaka okhuruka, niyakheekhala khushifumbi shioburuchi, yeera abeinzu yaBaasha bosi; shiyamuleshela omundu weshisaatsa namulala ta, kata mubeekhobe kata mubeetsabe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Zimiri yasishia bosi beinzu yaBaasha, likhuwa liOMWAMI elia yasunga mumunwa kwaYehu omunabii okhufukula Baasha shinga olwa liali, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa ebionoono biosi biaBaasha, nebionoono biaEla omwanawe, ebia abeene boonoona, nebiachila Isiraeli niyonoona, nibasinyisia OMWAMI Nyasaye waIsiraeli nende ebiabutswa ebia beenamilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaEla, nende kosi aka yakhola, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaZimiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kabili namusaafu kwaAsa omuruchi waYuda, Zimiri yaruchila tsindaalo musaafu muTiriza. Ne abandu belihe bali nibakhupile ikambi okhuseera Gibetsoni, eliali liabaFilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abo abali mukambi nibaboolelwa mbu Zimiri amusanjiliile omuruchi, namwira; khulwako Isiraeli yosi yeemekha Omiri, omuseesia welihe, abe omuruchi waIsiraeli, inyanga eyo mukambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Omiri natikulukha narula eGibetsoni, naIsiraeli yosi halala ninaye, nibeekalila Tiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Zimiri yalola mbu litaala libukuulwe, yeenjila munzu ikhulundu yomuruchi, nachihambia omulilo omwene nalimwo, nafwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa ebionoonobie ebia yoonoonanga nakhola akali amabii mumoni tsiOMWAMI, nachenda khunjila yaYeroboamu, neshionoonoshie eshia yoonoona, nachila Isiraeli niyonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaZimiri, nobukhobanibwe obwa yakhola, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaOmiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho abaIsiraeli bali nibakabukhaane emikanda chibili; omukandu mulala nikulondakhwo Tibini waGinatsi, okhumwemekha; nomukanda kundi nikulondakhwo Omiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abalondakhwo Omiri bahula abandu abalondakhwo Tibini waGinatsi; kho Tibini nafwa, naye Omiri naruka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kataru nalulala kwaAsa omuruchi waYuda, Omiri yachaaka okhuruka Isiraeli, naruka emiyika ekhumi nachibili; yaruchila muTiriza emiyika chisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.23",
            "verseOrgIds": [
              "1KI.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakula eshikulu shiaSamaria nende Shemeri, tsitalanda tsibili tsieifeetsa, niyoombakha olukoba khushikulu, nakulikha litaala elia yoombakha khuliira liaShemeri, omwene shikulu, mbu Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omiri yakhola akali amabii mumoni tsiOMWAMI, nakhola obumayaanu okhushila bosi abamuranjilila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yachenda khunjila yosi naYeroboamu waNebati, nomubionoonobie ebiachila Isiraeli niyonoona, nibasinyisia OMWAMI, Nyasaye waIsiraeli, nende ebiabutswa ebia beenamilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaOmiri, aka yakhola, nobululubwe shinga olwa bwali, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Omiri nakona nalonda khubakuukanyene, nayabilwa eSamaria; naye Ahabu omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAhabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumuyika kwamakhumi kataru namunaane kwaAsa omuruchi waYuda, Ahabu waOmiri yachaaka okhuruka Isiraeli; Ahabu waOmiri naruchila Isiraeli muSamaria emiyika amakhumi kabili nachibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ahabu waOmiri yakhola akali amabii mumoni tsiOMWAMI okhushila bosi abamuranjilila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola shinga ouluutsi mbu okhuchenda mubionoono biaYeroboamu waNebati nelikhuwa lituutu butswa; nameeta nateeshia Yezebeli omukhaana waEtsibaali, omuruchi waSidoni, natsia nakhalabanila Baali, namwinamila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yasinjisia eshimalilo shiaBaali, munzu yaBaali eya yali niyoombakha eSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu nakhola nende omuAshera; khandi Ahabu nameeta butswa okhusinyisia OMWAMI, Nyasaye waIsiraeli, okhushila abaruchi baIsiraeli bosi abamuranjilila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsitsie Hieli omuBeteli yoombakha Yeriko; yakhupa omuse kwalio nafwilwa omwanawe omwikulanda, Abiramu, nasinjisia eshilibwa shialio nafwilwa omwanawe omushe, Segubu; likhuwa liOMWAMI shinga olwa liali, elia yasunga nomunwa kwaYoswa waNuni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
