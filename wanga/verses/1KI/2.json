    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Daudi yalachilisia Sulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne induukho yokhufwa khwaDaudi niyula ahambi; namulachilisia Sulemani omwanawe ari ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie bulaano endi okhulonda khunjila eya abandu bosi balondakhwo; nawe wume ikholo, okholenje eshisaatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olindenje ako aka oleshelwa nOMWAMI Nyasayewo, mbu okhuchenda khunjilatsie, nokhulinda aka alachilisia namalakoke, nobukhalachibwe, noburumbusibwe, kosi akahandiikwa mumalako kaMusa shinga olwa kali, mbu mana okaasenje mukosi aka okhola, buli hosi aha oshiukhana okhutsia; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu OMWAMI atinyisie aka yaboolakhwo khwisie, ari Abaanabo nibaba nibeerechelesia khunjila tsiabwe, okhuchenda imbeli wanje mubwatoto, nomwoyo kwosi neshiimo shiosi, shiolachweyakhwo okhuba nomundu khushifumbi shioburuchi shiaIsiraeli ta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omanyile aka Yoabu waZeruya yakholela, aka yakholela abaseesia babili belihe liaIsiraeli, mbu Abineri waNeri naAmasa waNetseri, aba yeera, namala eshikwoli shiamabanga akeebeenela mwihe, mundaalo tsiomulembe; nara amabanga kelihe khumushiipi okwali mushishienje shianje, nokhubilaaro ebiali mubilenje bianje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho iwe okhole akobuchesibwo; orafuchiilila tsimbutsitsie tsiishile emakombe mumulembe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula obakholelenje akeshisa abaana baBarizilai omuGileadi ulia, babe khubaliitsanga khumeesayo; okhuba bakholela bario akeshisa olwa ndeelukha Abisalomu omwana weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.7",
            "verseOrgIds": [
              "1KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oli nende Shimei waGera omuBenyamini weBahurimu, owaseya amaseyo amalulu khunyanga eya ndatsia eMahanaimu; nebutswa yakholomokha niyeetsa okhunzakaanila haYorodani, nasi nimwitsubila khuMWAMI mbu Shindalakhwira nolukanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.8",
            "verseOrgIds": [
              "1KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho oramupaarakhwo mbu abula eshikha ta, okhuba oli omundu wobuchesi; olamanya aka okhoyile okhumukholela; oleesia tsimbutsitsie emakombe halala namabanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa IkkwaDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nakona nalonda abakuukanyene, nayabilwa mwitookho liaDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.10",
            "verseOrgIds": [
              "1KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo etsia Daudi yaruka muIsiraeli tsiali emiyika amakhumi kane; yaruka emiyika musaafu muHeberoni, ne emiyika amakhumi kataru nachitaru yaruka muYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Sulemani niyeekhala khushifumbi shioburuchi shiaDaudi samwana; oburuchibwe niburalisibwa muno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sulumani yaralisia oburuchibwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Adoniya waHagitsi yatsia ewaBatsesheba nyina Sulemani. Naye namureeba mbu Witsile mumulembe noho? Naye ari Mumulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nameeta mbu Endi nelikhuwa. Naye ari Khaboole. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboola mbu Omanyile shinga oburuchi olwa bwali obwanje, kata abaIsiraeli bosi bali nibachoomia tsimoni khwisie, mbu nisie owakharuka. Nebutswa oburuchi bwakalukhana, nibuba bwomwana weefwe; okhuba bwali obubwe okhurula khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.15",
            "verseOrgIds": [
              "1KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano ekhusaba likhuwa elala; oranyima tawe. Naye namusunjila mbu Khaboole. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Chama osabe Sulemani omuruchi, okhuba shianyala okhukhwima iwe ta, mbu afuchiilile emukalusie Abisagi omuShunami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.17",
            "verseOrgIds": [
              "1KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batsesheba namusunjila mbu Nobulayi; ndalasaba omuruchi khululwo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Batsesheba natsia ewomuruchi Sulemani okhusungana ninaye akaAdoniya. Naye omuruchi nabuukha okhumwakaanila, namwinamila; mana niyeekhala khushifumbishie, nabaIaka okhurenjeshela nyina omuruchi eshifumbi naye niyeekhala khumukhonokwe musaatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.19",
            "verseOrgIds": [
              "1KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yamusunjila mbu Ekhusaba likhuwa elala lituutu; oranyima ta. Omuruchi namukalusia mbu Khasabe, mama; shinekhwime ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.20",
            "verseOrgIds": [
              "1KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Fuchiilile Adoniya omwana weeny ve akalusie Abisagi omuShunami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.21",
            "verseOrgIds": [
              "1KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi Sulemani nakalusia, nasunjila nyina mbu Ne mbushiina nosabila Adoniya Abisagi omuShunami? Kho omusabile oburuchi bwosi; okhuba niye omwana weefwe omukhulundu khandi Abiatsari omukuhani, naYoabu waZeruya, bamuterela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.22",
            "verseOrgIds": [
              "1KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi Sulemani niyeetsuba khuMWAMI, ari Nyasaye yakholele ario, nende akashilaho, likhuwa lino elia Adoniya aboolile niliramukosia obulamubwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.23",
            "verseOrgIds": [
              "1KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, shinga OMWAMI olwa ali mwoyo, oyo owaralisia niyara khushifumbi shiapapa Daudi, niyakholela inzu, shinga olwa yasuubisia, Adoniya shinachweye okhwirwa inyanga yino ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.24",
            "verseOrgIds": [
              "1KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi Sulemani naruma Benaya waYehoyada, naye namukwakhwo, namwira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.25",
            "verseOrgIds": [
              "1KI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nasunjila Abiatsari omukuhani, ari Otsie eAnatsotsi, mundalo tsitsio; okhuba okwanile okhwirwa; nebutswa shinekhwire khushise shino ta, shichila niwe owachinganga lisanduku liOmwami NYASAYE imbeli waDaudi papa, khandi shichila wasanjilana nende papa mukhusandibwakhwe khwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Sulemani narusia Abiatsari, aleshe okhuba omukuhani w; ne yoosia ario likhuwa liOMWAMI elia yaboola khukeinzu yaEli eShiilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako nikoola ewaYoabu; okhuba Yoabu yali nashiukhaane okhumulondakhwo Adoniya, kata naralondakhwo Abisalomu ta. Kho yeelushila mwiheema liOMWAMI, natiila tsinzika tsieshimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi Sulemani naboolelwa mbu Yoabu wilushiile mwiheema liOMWAMI, ne lola, ali hashimalilo. Kho Sulemani naruma Benaya waYehoyada, ari Tsia omukwekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Benaya natsia khwiheema liOMWAMI, namuboolela mbu Omuruchi alaka mbu Rulamwo. Naye ari Tawe; ndalafwila hano. Benaya nakhupila omuruchi omunwa, mbu Yoabu asunjile ari, khandi niyangalusia ari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi namubiila mbu Khola shinga olwa asunjile; omukwekhwo, omwire, nomuyabila, mbu mana orusie khwisie khandi khunzu yapapa eshiina shiamabanga aka Yoabu yeebenia aharali eshifune ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI alakalusia amabangake khumurwekwe omwene, shichila yabakwila abandu babili abamushila obulunjishi nobulayi, nabeera nolukanga, papa Daudi naramanyile ta, mbu Abineri waNeri, omuseesia welihe liaIsiraeli, naAmasa waYetseri, omuseesia welihe liaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho amabanga kabwe kalakalukha khumurwe kwaYoabu, nokhumirwe chiolwibulolwe ebisoni nebisoni; habula khuDaudi, nokhulwibulolwe, nokhunzuye, nokhushifumbushie shiobwami, omulembe kwOMWAMI kulabakhwo inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Benaya waYehoyada yatikulukha natsiayo, namukwakhwo, namwira; nayabilwa munzuye eyali mushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nara Benaya waYehoyada mushilenjeshie okhusinjilila lihe, naye Zadoki omukuhani, omuruchi yamura mushilenje shiaAbiatsari.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi narumana okhulanga Shimei, namusunjila mbu Wumbashe inzu eYerusalemu, omenyemwo, norarulamwo okhutsia habundu hosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khunyanga eya olarulamwo niwambukha omuchela kwaKidironi, manya tieri mbu oleerwa bwirwa; amabangako kalaba khumurwe kukwo omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimei nakalusia omuruchi mbu Aka oboola namalayi; shinga omwami wanje omuruchi olwa oboolile, nolwa isie omusumbawo ndalakhola endio. Shimei namenya eYerusalemu tsindaalo tsinyinji.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba olunyuma Iwemiyika chitaru mbu abasumba baShimei babili beelukha nibatsia ewaAkhishi waMaaka, omuruchi waGatsi. Mana Shimei naboolelwa, mbu Lola, abasumbabo bali eGatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Shimei nabuukha, niyaala eshiokhwikhalakhwo khusishili, natsia eGatsi ewaAkhishi, okhukhaaba abasumbabe; Shimei natsia, nakalusia abasumbabe okhurula eGatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Sulemani naboolelwa shinga Shimei olwa yali narulile eYerusalemu, natsia eGatsi, khandi mbu ucheleele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi narumana okhulanga Shimei, namusunjila mbu Shindakhwitsubia khuMWAMI, nikhusiomela muno, mbu Manya tieri mbu khunyanga eya olarula nochenda ebulafu habundu hosi, oleerwa bwirwa? Nawe niumboolela mbu Likhuwa elia oboolile nelilayi; endihuliile. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nishiina eshichilile noralinda eshiitsubo shiOMWAMI, nelilako elia ndakhulaka ta? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omuruchi nasunjila Shimei mbu Omanyile mumwoyokwo obubii obwo bwosi obwa wakholela Daudi papa; khulwako OMWAMI alakalusia obubiibwo khumurwekwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi Sulemani alaheebwa ikhabi, nashio eshifumbi shiaDaudi shilaralisibwa imbeli wOMWAMI inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi nalaka Benaya waYehoyada; naye narula namukwakhwo, namwira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburuchi nabwo bwaralisibwa mumukhono kwaSulemani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    }
  ],
