              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yali omuchesi okhushila abandu bosi; yashila Etsani omuEzerahi, naHemani, naKalikoli, naDarada, abaana baMaholi; ifumaye niyitswana mumahanga kosi akabotokhanaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.31",
            "verseOrgIds": [
              "1KI.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaboola tsinjelo ebikhumila bitaru; tsinyimbotsie natsio tsiali eshikhumila nende tsiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaboolanga akemisaala, okhurula khumisiita echili khuLebanoni okhuula khumabinu akamela khulukoba; khandi yaboolanga aketsisolo, nakamanyonyi, nakebimoolanga, nende aketsinyeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
