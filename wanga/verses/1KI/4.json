            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abokhutsimbia tsiosi nibeetsa okhuhulila obuchesi bwaSulemani, nibarula khubaruchi bosi bebialo biosi, abali nibahuliilekhwo akobuchesibwe.",
          "type": "text",
