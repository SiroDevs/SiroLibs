    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahabu yahula abaSiria.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Beni-hadadi omuruchi waSiria yakhung'aasia abelihelie bosi; yali nali nende abaruchi bandi amakhumi kataru nababili, netsifarasi namakaari; kho natikulukha natsia niyeekalila Samaria naliseera. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.1",
            "verseOrgIds": [
              "1KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naruma abarume ewaAhabu omuruchi waIsiraeli mwitookho, namusunjila mbu Kano niko aka Beni-hadadi aboola; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.2",
            "verseOrgIds": [
              "1KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsifeetsatsio netsitsahaabutsio netsianje; kata abakhasibo nabaanabo nabo, abashila obulayi khubo, nabanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.3",
            "verseOrgIds": [
              "1KI.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waIsiraeli nakalusia mbu Shinga olwa oboolile, omwami wanje omuruchi; endi owuwo, halala nende biosi ebia endi ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.4",
            "verseOrgIds": [
              "1KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarume nibeetsa khandi, nibasunga mbu Kano niko aka Beni-hadadi aboola, ari Erumile abandu khwiwe okhusunga mbu Undeerele tsifeetsatsio, netsitsahaabutsio, nabakhasibo, nabaanabo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.5",
            "verseOrgIds": [
              "1KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebulaano nekhurumile abasumba banje mukamba shinga khusaa yino; nabo balakhaabilisia munzuyo nomunzu tsiabasumbabo; mana shiosi shiosi eshibachamisia, balashibukula nibashiyila.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi waIsiraeli nalanga abakofu bosi beshialo, nasunga mbu Henje bulaano, mulole shinga omundu uno olwa akhaabanga amabii; okhuba arumile abandu okhubukula abakhasi banje, nabaana banje, netsifeetsa tsianje, netsitsahaabu tsianje; nasi nindamwima ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.7",
            "verseOrgIds": [
              "1KI.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakofu bosi nabandu bosi nibamuboolela mbu Orahuhla kata okhufuchiilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.8",
            "verseOrgIds": [
              "1KI.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yasunjila abarume baBeni-hadadi ari Boolela omwami wanje omuruchi mbu Kosi aka orumaane ewanje isie omusumbawo olwambeli, nekhole; ne kano shingakhola ta. Abarume nibeenyokha, nibamukalusilia amakhuwa khandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.9",
            "verseOrgIds": [
              "1KI.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beni-hadadi namuupila omunwa, ari Abanyasaye bakholele bario nende akashilaho, olufu lwaSamaria niluba niluhela tsifusi tsiabandu bosi abanondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.10",
            "verseOrgIds": [
              "1KI.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waIsiraeli nakalusia ari Muboolele mbu Oushiiboha ebimanulwa aleshe okhwisunga shinga owinaabula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.11",
            "verseOrgIds": [
              "1KI.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Beni-hadadi yahulila likhuwa elo, nali mumalwa halala nabaruchi bandi abo mumatili, yasunjila abasumbabe ari Mwirecheshe. Nabo nibeerechekha okhuseera litookho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.12",
            "verseOrgIds": [
              "1KI.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.12",
            "verseOrgIds": [
              "1KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omunabii undi nasitila Ahabu omuruchi waIsiraeli ahambi, nasunga mbu Kano niko aka OMWAMI aboola; mbu Oluutsi omukanda kuno omukhongo noho? Lola, ndalakuhaana mumukhonokwo inyanga yino; nawe olamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.13",
            "verseOrgIds": [
              "1KI.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu nareeba mbu Khulwa wina? Naye ari Kano niko aka OMWAMI aboola; mbu Khulwa abasooliili abakhalabanila abakhulundu betsingongo. Namureeba mbu Oularanjilila okhuseera niwina? Namukalusia mbu Niwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabasia abasooliili babakhulundu betsingongo, nanyoola nibali ebikhumi bibili namakhumi kataru nababili; mana inyuma wabwe yabasia abandu bosi, nibo abaana baIsiraeli, nibali ebikhumila musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushiteere nibarula. Naye Benihadadi yali nanyweetsanga nameelela mumatili, halala nabaruchi bandi tsana, abo abaruchi amakhumi kataru nababili abali nibamukhoonyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.16",
            "verseOrgIds": [
              "1KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasooliili abo babakhulundu betsingongo nibo abaranjilila okhurula. Ne Beni-hadadi yaruma abandu okhuhenga, nabo nibamuboolela mbu Abandu bandi barula eSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.17",
            "verseOrgIds": [
              "1KI.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga mbu Kata nibarulile nibeetsa mumulembe, mubahambe nibali mwoyo; kata nibarulile nibeetsa mubusoolo, mubahambe nibali mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu tsana barula mwitookho, abasooliili babakhulundu betsingongo, nende abelihe ababalondakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.19",
            "verseOrgIds": [
              "1KI.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeera buli mulala omundu; nabo abaSiria nibeelukha, Isiraeli niyibalondachilane Beni-hadadi omuruchi waSiria niyeehonokoshela khufarasi, halala nabachendela khufarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.20",
            "verseOrgIds": [
              "1KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waIsiraeli narula, narootsa tsifarasi namakaari, niyeera abaSiria obwiri obukali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omunabii tsana nasitila omuruchi waIsiraeli ahambi, namuboolela mbu Kho otsie, wiralisie, niwirecheshela aka witsa okhukhola; okhuba mushiubwe omuruchi waSiria alatikulukha niyeetsa okhukhuseera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumba bomuruchi waSiria nibamusunjila mbu Nyasaye wabwe nomunyasaye webikulu; niko akachilile nibakhushila amaani; ne bulaano khubaseerele mumuhololookhwe; mana shikhulachweya okhubashila amaani ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.23",
            "verseOrgIds": [
              "1KI.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi okhole ori nanwa; mbu orusieho abaruchi tsana, buli mundu okhurula ewa abeetsanga, nokalusiaho abaseesia mushilenje shiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.24",
            "verseOrgIds": [
              "1KI.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ochele lihe elihela shinga lihe elo eliakhukorelakhwo, mbu ifarasi mushilenje shiabuli farasi, nelikaari mushilenje shiabuli likaari; khulabaseerela mumuhololookhwe, mana shikhulachweva okhubashila amaani ta. Naye narechelesia aka baboola, nakhola ario.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
