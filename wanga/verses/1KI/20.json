            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mushiubwe Beni-hadadi yachela abaSiria, natikulukha natsia eAfeki okhuseera Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.26",
            "verseOrgIds": [
              "1KI.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nabo nibachelwa nibakabilwa ebiokhulia, nibatsia okhuseerana ninabo; abaana baIsiraeli nibakhupa ikambi imbeli wabwe shinga orutuli rubili rwebimeeme bietsimbusi; habula abaSiria beetsula mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omundu waNyasaye nasita ahambi, nasunjila omuruchi waIsiraeli mbu Kano niko aka OMWAMI aboola; mbu Shichila abaSiria basunjile mbu OMWAMI nomunyasaye webikulu, ne shiali omunyasaye wamabanda ta; niko akachila ndalahaana omukanda kuno omukhongo mumukhonokwo; mana mulamanya mbu isie nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeekhalayo mutsikambi tsiabwe etsihengaane tsindaalo musaafu. Mana khunyanga yomusaafu nibachaaka okhulasana; abaana baIsiraeli nibeera abandu ebikhumila eshikhumi abachenda nebilenje abokhubaSiria khunyanga ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.29",
            "verseOrgIds": [
              "1KI.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatong'a nabo nibeelukha, nibatsia eAfeki, mwitaala bwene; olukoba nilukwila abandu ebikhumila amakhumi kabili namusaafu abali nibatong'ile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Beni-hadadi niyeelukha, niyeenjila mwitaala, mushisika shindi eshiomukari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasumbabe nibamusunjila mbu Bulaano lola, khuhulilanga mbu abaruchi beinzu yaIsiraeli nabaruchi betsimbabasi; kho chama khwibohe tsingubo tsiamakunia mubishienje, namakhoola khumirwe, khurule khutsie ewomuruchi waIsiraeli; haundi alahonokosia obulamubwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.31",
            "verseOrgIds": [
              "1KI.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibeeboha tsingubo tsiamakunia mubishienje, namakhoola khumirwe, nibatsia ewomuruchi waIsiraeli, nibasunga mbu Omusumbawo Beni-hadadi asunga ari Ekhusaaya mbu chama embe mwoyo. Naye nakalusia ari Khane ashili mwoyo? Mbula, nomwana weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu abo bali nibakhaaba eshilolelo; kho bwangu batiila khwikhuwalie, nibasunga mbu Ee, omwana weenywe Beni-hadadi. Nabasunjila mbu Tsie mumuleere. Mana Beni-hadadi namwitsila; namuniinia mwikaarilie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi namusunjila mbu Amataala aka papa vanuula khuso, ekhukalusilia; nawe okhole ebiirobio eDamasiko, shinga papa olwa yakholela eSamaria. Naye Ahabu ari Nasi ndalakhulekhuula nikhulakaane khurio. Kho nibakhola indakano, namulekhuula.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oundi owokhubaana babanabii nasunjila owashie khulwa likhuwa liOMWAMI, mbu Chama ukhupe. Omundu oyo nakhaya okhumuupa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho namusunjila mbu Olwa orahuliile omwoyo kwOMWAMI ta, lola, niwakharulakhwo italanyi yilakhwira. Ne olwa yali niyakhamurulakhwo, italanyi niyimunyoola niyimwira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nanyoola omundu undi namusunjila mbu Chama ukhupe. Omundu oyo namuupa, okhuupa nokhumusaalisia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omunabii tsana natsia, nalinda omuruchi hanjila, niyeekaluule okhufwana lukano, niyeeboyile eshitambaya mumoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa omuruchi yali nabiranga, yamulanjilisia omuruchi, ari Isie omusumbawo ndali ninziile mubusoolo; oundi niyeebeera nandeerela omundu, namboolela mbu Linda omundu uno; naba nakora, munjila yosi yosi, obulamu bubwo bulaba mushilenje shiobulamubwe; kata mbu orunje italanda yeifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa isie omusumbawo ndabeele nindi khumilimo eyi nende eyi, ndeetsukhaane ukhamile. Omuruchi waIsiraeli namuboolela mbu Mbula, eshiinashio shibe shirio; niwe omwene oukhalaache. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bwangu yarusiaho eshitambaya khumoni; omuruchi waIsiraeli namumanya mbu nimulala khubanabii. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila mbu Kano niko aka OMWAMI aboola, mbu Shichila walekhuula mumukhonokwo omundu oyo owa ndali ninzahuliile obutibibwi, niko akachila obulamu bubwo bulatsia mushilenje shiobulamubwe, nabandubo mushilenje shiabandube. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi waIsiraeli natsia ebunanzuwe narunyile, nasinyiishe, niyoola eSamaria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.43",
            "verseOrgIds": [
              "1KI.20.43"
            ]
          }
        }
      ]
    }
  ],
