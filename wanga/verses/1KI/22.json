  "reference": "1 Abaruchi 22",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mikaya yalakula mbu Ahabu naYehoshafati beetsa okhuhulwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamenya emiyika chitaru oburaba nelihe hakari waSiria nende Isiraeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.1",
            "verseOrgIds": [
              "1KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumuyika kwakhataru Yehoshafati omuruchi waYuda yakholomokha niyeetsela omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.2",
            "verseOrgIds": [
              "1KI.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waIsiraeli nasunjila abasumbabe ari Shimumanyile mbu Ramotsigileadi nelieefwe? Ne ifwe khuholeelile butswa, nikhuralibukula mumukhono kwomuruchi waSiria ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.3",
            "verseOrgIds": [
              "1KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila Yehoshafati ari Khulatikulukha ninawe okhuseera Ramotsi-gileadi noho? Yehoshafati nakalusia omuruchi waIsiraeli mbu Isie endi shinga iwe olwa oli, abandu banje shinga abandubo, tsifarasi tsianje shinga tsifarasitsio.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.4",
            "verseOrgIds": [
              "1KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati nasunjila omuruchi waIsiraeli ari Chama oreebe khwikhuwa liOMWAMI leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.5",
            "verseOrgIds": [
              "1KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi waIsiraeli nakhung'aasia abanabii, abandu shinga ebikhumi bine, nabareeba mbu Endikulushe okhuseera Ramotsi-gileadi, nohomba endeshe? Nabo bari Tikulukha; okhuba OMWAMI alalihaana mumukhono kwomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.6",
            "verseOrgIds": [
              "1KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Yehoshafati nareeba mbu Shiyakhabakhwoho omunabii undi wOMWAMI, khumureebe? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.7",
            "verseOrgIds": [
              "1KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waIsiraeli nakalusia Yehoshafati mbu Ashiliho oundi owa khwakhanyala okhureebela ewOMWAMI, mbu Mikaya waImila; nebutswa ndamuhamba isila; okhuba shiarumbulilanga amalayi ta, habula amabii. Naye Yehoshafati nasunga mbu Omuruchi aleshe okhuboola ario. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.8",
            "verseOrgIds": [
              "1KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi waIsiraeli nalanga omukali undi, naboola mbu Tsia bwangu, omwende Mikaya waImila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.9",
            "verseOrgIds": [
              "1KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi waIsiraeli naYehoshafati omuruchi waYuda bali nibeekhaale bombi khubifumbi biabwe bioburuchi, nibeefwalile tsingubo tsioburuchi, habundu halafu hamasanganjila keshilibwa shiaSamaria; nabo abanabii bosi nibalakulila imbeli wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.10",
            "verseOrgIds": [
              "1KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Zedekia waKhenaana yeekasilia tsinzika tsieshibia, nasunga mbu Kano niko aka OMWAMI aboola; mbu Olaluuma abaSiria netsino okhuula olwa baba nibahweele. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.11",
            "verseOrgIds": [
              "1KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abanabii bosi balakula bario, bari Tikulukha otsie eRamotsi-gileadi, okaase; okhuba OMWAMI alalihaana mumukhono kwomuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.12",
            "verseOrgIds": [
              "1KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omurume owatsia okhulanga Mikaya namusunjila ari Lola, amakhuwa kabanabii namalayi khumuruchi, akomunwa mulala; nawe chama likhuwa lilio lifwane shinga likhuwa lioundi yesi khubo; oboole amalayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.13",
            "verseOrgIds": [
              "1KI.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mikaya nakalusia mbu Shinga OMWAMI olwa ali mwoyo, aka OMWAMI alamboolela, niko nka ndalasunga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.14",
            "verseOrgIds": [
              "1KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyoolile ewomuruchi, omuruchi namureeba mbu Mikaya, khutsie khuseere Ramotsi-gileadi, nohomba khuleshe? Naye namukalusia mbu Tikulukha, okaase; OMWAMI alalihaana mumukhono kwomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.15",
            "verseOrgIds": [
              "1KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi namusunjila mbu Nakhandi khanga nikhubiilanga mbu umboolelenje akobwatoto konyene muliira liOMWAMl? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.16",
            "verseOrgIds": [
              "1KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nasunga mbu Ndaluutsi Isiraeli yosi niyisalaaniile khubikulu shinga amakondi akabula omwayi; naye OMWAMI nasunga mbu Eano babula omwami; bakalushe buli mundu ebunanzuwe mumulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.17",
            "verseOrgIds": [
              "1KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waIsiraeli nasunjila Yehoshafati ari Shikhubooleele mbu shiyakhandakulile amalayi ta, habula amabii? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.18",
            "verseOrgIds": [
              "1KI.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nameeta mbu Khulwako, ohulile likhuwa liOMWAMI; mbu ndaluutsi OMWAMI niyeekhaale khushifumbishie shiobwami, nabo abamahe kosi komwikulu nibasinjiile ahambi ninaye, khumukhonokwe musaatsa nomukhasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.19",
            "verseOrgIds": [
              "1KI.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI nareeba mbu Niwina oulamutsuuba Ahabu, mbu atikulushe, atsie akwile eRamotsi-gileadi? Oundi nakalusia ari, noundi ari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.20",
            "verseOrgIds": [
              "1KI.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana roho undi narula mubo, nasinjila imbeli wOMWAMI, nasunga mbu Isie ndalamutsuuba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.21",
            "verseOrgIds": [
              "1KI.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namureeba mbu Orie? Naye ari Ndalatsia nimba roho wobubeeyi muminwa chiabanabiibe bosi. Namuboolela mbu Olamutsuuba, khandi olamuhula. Tsia, okhole orio. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.22",
            "verseOrgIds": [
              "1KI.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano lola, OMWAMI ureele roho wobubeeyi muminwa chiabanabiibo bano bosi; ne OMWAMI uboolile amabii khwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.23",
            "verseOrgIds": [
              "1KI.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Zedekia waKhenaana nasita ahambi, napaama Mikaya khuluseya, nasunga mbu Roho wOMWAMI yalonda khunjila shi narula khwisie okhusungana ninawe? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.24",
            "verseOrgIds": [
              "1KI.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya nakalusia mbu Witsa okhulola, khunyanga olwa oliinjila mushisika shiomukari okhwibisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.25",
            "verseOrgIds": [
              "1KI.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waIsiraeli nasunga mbu Bukule Mikaya, mumukalusie ewaAmoni, omukafuna welitookho, newaYoashi omwana womuruchi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.26",
            "verseOrgIds": [
              "1KI.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "musunje mbu Kano naka omuruchi aboola; mbu Mure omundu uno mumbohe, mumuheelesie eshiokhulia namatsi ebihela omubohe, okhuula olwa ndalakalukha muznulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.27",
            "verseOrgIds": [
              "1KI.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Mikaya nasunga mbu Khane noba niwitsa mumulembe kwosi kwosi, khane OMWAMI shiaba nabooleele mwisie ta. Nameeta mbu Hulile, inywe abandu mwesi!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
