            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.28",
            "verseOrgIds": [
              "1KI.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi waIsiraeli nende Yehoshafati omuruchi waYuda nibatikulukha, nibatsia eRamotsi-gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.29",
            "verseOrgIds": [
              "1KI.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waIsiraeli nasunjila Yehoshafati mbu Ndaleekalula okhufwana lukano, ninzia mubulasani; habula iwe wifwale tsingubotsio tsiobwami. Kho omuruchi waIsiraeli niyeekalula okhufwana lukano, natsia mubulasani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.30",
            "verseOrgIds": [
              "1KI.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi waSiria yali nalachile abaseesia abo amakhumi kataru nababili bamakaarike ari Muralasana nabandi kata aba-tuutu kata abakhongo ta, habula nomuruchi waIsiraeli yenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.31",
            "verseOrgIds": [
              "1KI.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa abaseesia bamakaari tsana balola Yehoshafati, bapaara mbu Oyo shiakosa okhuba omuruchi waIsiraeli ta; nibashiukhana okhumuseera; naye Yehoshafati nakhupa oluhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.32",
            "verseOrgIds": [
              "1KI.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaseesia bamakaari balola mbu shiali omuruchi waIsiraeli ta, bashiukhana khandi nibalekha okhumulondachila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.33",
            "verseOrgIds": [
              "1KI.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu undi yalasa obuyingo, niyeetsukhana nakhupa omuruchi waIsiraeli khubunjilo bwebimanulwabie; naye nasunjila omuchesii welikaarilie ari Shiukhana, urusie mwihe; okhuba efumiirwe butinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.34",
            "verseOrgIds": [
              "1KI.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusoolo nibwimeeta inyanga eyo; naye omuruchi yaleetelelwa mwikaarilie ahahengana nabaSiria; ne nafwa khubwile; amatsayi nikarula aha yafumirwa, nikaraatsa nikatsia mwikaari hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.35",
            "verseOrgIds": [
              "1KI.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amakhu nikakhupwa mwihe liosi khushiisiisie, kari Buli mundu atsie eneetaalalie, nabuli mundu mushialoshie!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.36",
            "verseOrgIds": [
              "1KI.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi nafwa, nayilwa eSamaria; nibamuyabila omuruchi eSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.37",
            "verseOrgIds": [
              "1KI.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niboosilia likaari tsana heetiba liaSamaria, tsimbwa natsio nitsikhomba amatsayike, abakhasi abatamba nibeeyosiayo, likhuwa liOMWAMI shinga olwa liali elia yaboola. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.38",
            "verseOrgIds": [
              "1KI.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaAhabu, naka yakhola kosi, nakeinzu eyang'oonelwa ameeno ketsinzofu eya yoombakha, nakamataala kosi aka yoombakha, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.39",
            "verseOrgIds": [
              "1KI.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Ahabu nakona nalonda khubakuukanyene; naye Ahazia omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaYehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.40",
            "verseOrgIds": [
              "1KI.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati waAsa yachaaka okhuruka Yuda mumuyika kwakhane kwaAhabu omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.41",
            "verseOrgIds": [
              "1KI.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati yali owemiyika amakhumi kataru nachiraano olwa yachaaka okhuruka; naruchila emiyika amakhumi kabili nachiraano muYerusalemu; ne eliira lianyina liali Azuba, omukhaana waShilihi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.42",
            "verseOrgIds": [
              "1KI.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yachenda munjila yosi yaAsa, samwana; shiyayeebera okhuchirulakhwo ta, ne yakholanga akali amalayi mumoni tsiOMWAMI; habula habundu aheechingu shiharusibwaho ta; abandu bali nibashimalilanga emisango nibasambila amalesi kelibuuliesi habundu aheechingu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.43",
            "verseOrgIds": [
              "1KI.22.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati nibakhalakana imbwa nende omuruchi waIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 22:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.44",
            "verseOrgIds": [
              "1KI.22.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 22:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kosi kaYehoshafati, nakobululubwe shinga olwa bwali, nakamaheke aka yaseeranga, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baYuda? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.45",
            "verseOrgIds": [
              "1KI.22.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabomusikalo kwabatanyani, abali nibasikaale mundaalo tsiaAsa samwana, yabarusia mushialo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 22:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.46",
            "verseOrgIds": [
              "1KI.22.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 22:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shiyali naliho omuruchi muEdomu ta; omulindi undi yali narukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.47",
            "verseOrgIds": [
              "1KI.22.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 22:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati nachila amaaro kaTarashishi nikatsia eOfiri, okhwenda itsahaabu; ne shikamala katsie ta; okhuba amaaro tsana kafinishila eEzioni-geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.48",
            "verseOrgIds": [
              "1KI.22.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 22:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ahazia waAhabu nasunjila Yehoshafati mbu Abasumba banje batsie nabasumbabo mumaaro. Nebutswa Yehoshafati shiyafuchiilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.49",
            "verseOrgIds": [
              "1KI.22.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoshafati nakona nalonda khubakuukanyene, nayabilwa halala ninabo mwitookho liaDaudi kuukanyene; naye Yehoramu omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAhazia walsiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 22:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.50",
            "verseOrgIds": [
              "1KI.22.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 22:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazia waAhabu yachaaka okhuruchila Isiraeli muSamaria mumuyika kwekhumi namusaafu kwaYehoshafati, omuruchi waYuda; naruka Isiraeli emiyika chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.51",
            "verseOrgIds": [
              "1KI.22.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 22:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, nachenda munjila yasamwana, khandi munjila yanyina, khandi munjila yaYeroboamu waNebati, owachila Isiraeli niyonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.52",
            "verseOrgIds": [
              "1KI.22.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 22:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakhalabanila Baali namwinamila, nasinyisia OMWAMI, Nyasaye waIsiraeli, shinga samwana olwa yali nakholanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.22.53",
            "verseOrgIds": [
              "1KI.22.53"
            ]
          }
        }
      ]
    }
