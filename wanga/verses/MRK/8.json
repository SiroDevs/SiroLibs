{
  "id": "MRK.8",
  "number": "8",
  "bookId": "MRK",
  "reference": "Mariko 8",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MRK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yaliisia abandu ebikhumila bine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio, olwa omukanda omukhongo kwaliho khandi, nibabula eshiokhulia, yalanga abeechibe, nabasunjila mbu ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.1",
            "verseOrgIds": [
              "MRK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endiililwa omukanda kuno eshisa, shichila leelo lukhola khataru nibabeetsanga ninasi nibarali nende eshia balia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba nimbaseebula batsie ingo nibali inzala bakhahlumbutsanila khunjila, ne abandi khubo barulile ehale. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.3",
            "verseOrgIds": [
              "MRK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibamukalusia bari Mushitsiimi muno omundu yakhanyoola heena emikaate echihela okhubeekusia abandu bano? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba mbu Muli nemikaate chinga? Nibakalusia mbu Nimusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababiila abomukanda mbu beekhale hasi; nolwa yali nabukuule emikaate echio musaafu nende okhuupa orio yachisonyola nabakabila abeechibe mbu babarenjeshele; nabo nibachirenjekha imbeli wabomukanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi balikhwo norunyeeni oruleemu. Olwa yali narusabiile ikhabi yababiila abeechibe okhururenjekha narwo imbeli wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalia nibeekura; nibatoola ebisonye ebiatong'a, ebimwelo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bali shinga ebikhumila bine. Naye nabaseebula. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeenjila muliaro halala nende abeechibe niboola mungongo tsieDalamanutsa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaFarisayo basaba eshilolelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho abaFarisayo nibeetsa nibayingana ninaye. Bamusaba eshilolelo eshirula mwikulu, nibamuteema. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeesia amahumo mumwoyokwe, nasunga mbu Olwibulo luno lusabanga eshilolelo mbushiina? Emuboolela toto, mbu olwibulo luno shilulaheebwakhwo eshilolelo shiosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabarulakhwo, niyeenjila khandi muliaro niyeenyokha niyaambukha injelekha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amamela kabaFarisayo nakaHerode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali nibeebiliile okhubukula emikaate, nibaralikhwo nende eshindu muliaro ta habula omukaate mulala kwonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabalaka ari Mubeetsenje meeso, nimwiyila kahala khulwa amamela kabaFarisayo nende amamela kaHerode. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bali nibeefuubilanangal abeene bonyene khukachilile nibabula nomukaate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yamanya ario, nabasunjila ari Mbushiina nimwifuubilananga abeene mwenyene murio khukachilile nimubula omukaate? Mushili okhumanya nende eshisina ta? Emioyo chieenywe chishili butswa emisiro? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimoni muli ninatsio; shimuloIanga ta? Amarwi muli ninako; shimuhulilanga ta? Kata shimwitsulilanga ta? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa ndasonyolela abo ebikhumila biraano emikaate chiraano, mwatoola ebisonye ebiahela ebimwelo binga? Nibakalusia mbu Ekhumi nabibili. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa ndasonyolela abo ebikhumila bine emikaate musaafu, mwatoola ebisonye ebiahela ebimwelo binga? Nibamusunjila mbu Musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila mbu Mushili okhumanya eshisina? Omubofu yahonilibwa eBetsesaida ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.21",
            "verseOrgIds": [
              "MRK.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niboola eBetsesaida. Abandu nibamuleerela omubofu undi nibamusaaya mbu amutiilekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamutiila omubofu omukhono namuyila elwanyi welitaala, ne olwa yali nafuutsile amare mumonitsie namureelekhwo amakhono, yamureeba mbu Ololakhwo eshindu noho? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nachinguula tsimoni, nasunga ari Endola abandu okhuba beengana shiemisaala, nibachenda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namurakhwo amakhono khumoni khandi, naye nalola bulayi. Yali nahonile, nalola ebindu biosi ebili ehale habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namuseebula atsie ebunangowe; nasunga ari Oraboolelakhwo omundu mwitaala ta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Petero yarumbula khukaYesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu narula nende abeechibe nibatsia mumataala kaKaisaria-Filipi. Olwa bali khunjila yareeba abeechibe ari Abandu baboolanga barie khwisie, mbu nisie wina? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakalusia nibamuboolela bari Yohana Omubatisii; nabandi, bari Eliya; nabandi, bari Mulala khubanabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba mbu Neenyu muboolanga murie, mbu nisie wina? Petero nakalusia, namusunjila mbu Niwe Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabakaania butinyu oburamuboolela omundu yesi akeke ta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yaboola akokhufwakhwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
