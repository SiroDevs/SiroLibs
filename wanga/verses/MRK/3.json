{
  "id": "MRK.3",
  "number": "3",
  "bookId": "MRK",
  "reference": "Mariko 3",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "MRK 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omundu owomukhono okwanyela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeenjila khandi musinagogi; ne yalimwo omundu owa omukhonokwe kwanyela. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyichila okhulola naba niyakhamuhonia khuSabato, mbu kho bamwinjilile itookho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.2",
            "verseOrgIds": [
              "MRK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunjila omundu oyo owa omukhonokwe kwanyela ari Sinjila hakari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabareeba ari Kafuchiililwa okhukhola amalayi nohomba okhukhola amabii khuSabato, okhuhonia obulamu nohomba okhwira? Nabo nibaholeela tsi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabahenga eyi nende eyi noburima, nahuka muno khubutinyu bwemioyo chiabwe, nasunjila omundu oyo mbu Kololosia omukhonokwo. Nakukololosia, omukhonokwe nikukalukha habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho abaFarisayo nibarula halala nende abaHerode, nibamusanjila okhukhaaba shinga olwa nabanyale okhumwira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukanda omukhongo khuluchinga Iweinyanza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu narulaho nende abeechibe nibatsia hanyanza; omukanda omukhongo kwarula eGalilaya nikulondana ninayei nabebuYahudi ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.7",
            "verseOrgIds": [
              "MRK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Yerusalemu nende Idumaya nende injelekha weYorodani nende mumbali tsieTiro nende Sidoni, omukanda omukhongo, olwa bahulila aka yakholanga nibatsia ewa yali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabiila abeechibe mbu eliaro libeele ahambi ninaye omukanda kwakhamutiya; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
              "MRK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila yali nahoniye abanji, okhuula olwa bosi abanyakhananga mumibili chiabwe bamufwindisia mbu bamutiilekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa abaroho beshifwabwi bamulolanga beekhupanga hasi mumakuluke, nibayiiba, bari Niwe Omwana waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasiomela butinyu, mbu baleshe okhumubuula.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yalobola abeechi ekhumi nababili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho naniina mushikulu, nalanga abo aba yachama okhulanga, nabo nibatsia ewa yali. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula ekhumi nababili nabaraho mbu babeetsenje ninaye, khandi mbu abarumenje okhwilwatsa, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaba nobunyali okhurusinjia amadimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yaraho abo Ekhumi-nababili, nabo mbabano, mbu Simoni owa yakulikha mbu Petero, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo waZebedayo, nende Yohana omwana wabwe Yakobo; nabo yabalaha mbu Boanerige, eshisina mbu Abaana bOmukukumo; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anderea, naFilipo, naBaritsolomayo, naMatsayo, naTomasi, naYakobo waAlufayo, naTsadayo, naSimoni Omukananayo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Yuda Isikariote, owatsana owamukhobana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naBeelezebuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeenjila munzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukanda nibakhung'aana khandi, okhuula olwa bakhaywa kata okhulia ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.20",
            "verseOrgIds": [
              "MRK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomunzu yabwe olwa bahulilakhwo barula nibatsia okhumutiila, shichila abandu bali nibaboolanga mbu ulaluushe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.21",
            "verseOrgIds": [
              "MRK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahandiichi abali nibakholomooshe okhulula eYerusalemu basunga mbu Beelezebuli ali ninaye, khandi mbu arusinjia amadimoni khulwa obunyali bwomwami wamadimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabalanga nabasunjila muluchelo, ari Setani yakhanyala arie okhurusia Setani? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oburuchi bwosi nibuba nibwahukhana obwene khubwene, oburuchi obwo shibunyala okhusinjila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.24",
            "verseOrgIds": [
              "MRK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata inzu yosi niyiba niyahukhana eyene khuyene, inzu eyo shiyilanyala okhusinjila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.25",
            "verseOrgIds": [
              "MRK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Setani naba niyeekholela omwene induli, abeetsanga niyaahukhaane, naranyala okhusinjila ta; kho yoolile khushihesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.26",
            "verseOrgIds": [
              "MRK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata abulaho ounyala okhwinjila munzu yomunelu wamaani, wayaaya emianduchie, habula naranjiliile okhumuboha omundu oyo wamaani; nilwo olwa ayaaya inzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela toto, mbu abandu balaleshelungwa ebionoono biabwe biosi kata nende obunyechi bwabwe obwa banyeka Nyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa ounyeka Roho Omutakatifu shialikhwo nobuleshelwi inziayo ta; ali neshikha shieshionoono shiobumeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
            "verseOrgIds": [
              "MRK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila bali nibaboolanga mbu Roho weshifwabwi ali ninaye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyina Yesu, nende abaana babwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina nende abaana babwe nibeetsa nibasinjila elwanyi nibarumana okhumulanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukanda kwabandu bali nibeekhaale nibamubotokhaane; nibamuboolela bari Lola, mawo nende abaana beenywe bali elwanyi; bakhwenya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, nabasunjila mbu Mama niye wina, kata abaana beefwe nibeena? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahenga eyi nende eyi khubandu abeekhala nibamubotokhaane, nasunga mbu Mama nende abaana beefwe mbabano. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi oukhola aka Nyasaye yeenya, omwenoyo niye omusiani weefwe, khandi omukhaana weefwe, khandi mama.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.35",
            "verseOrgIds": [
              "MRK.3.35"
            ]
          }
        }
      ]
    }
