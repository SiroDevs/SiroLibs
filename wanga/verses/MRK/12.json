{
  "id": "MRK.12",
  "number": "12",
  "bookId": "MRK",
  "reference": "Mariko 12",
  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MRK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo lwabalimili bemitsabibu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nachaaka okhuboolelana ninabo munjelo; ari Omundu undi yaraaka omukunda kwemitsabibu, nakubotokhasiakhwo olukaka, nayaba obwina bweingulu yeidivai, niyoombakha omunaara, nakuhosia abalimili, natsia mushialo shindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.1",
            "verseOrgIds": [
              "MRK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa induukho yoola, yaruma omusumba undi khubalimili abo, mbu anyoole khubalimili ebiokhubiamo ebiomumukunda kwemitsabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.2",
            "verseOrgIds": [
              "MRK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamutiila, nibamunywekha, nibamwilusia amakhono amakhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.3",
            "verseOrgIds": [
              "MRK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yabarumila omusumba undi; omwenoyo bamwara tsinguma, nibamuhambia tsisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.4",
            "verseOrgIds": [
              "MRK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naruma oundi; naye nibamwira; nende abandi abanji; abandi nibabanywekha, abandi nibabeera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.5",
            "verseOrgIds": [
              "MRK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali nashili ninaye mulala, omwanawe owa yaheela muno; olunyuuna lwabosi yamuruma ye khubo, naboola mbu Balamuria omwana wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.6",
            "verseOrgIds": [
              "MRK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abalimili abo basungana abeene, bari Uno niye owobulaame; chende khumwire, mana obulaame bulaba obweefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.7",
            "verseOrgIds": [
              "MRK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamutiila, nibamwira, nibamuyinia mumukunda kwemitsabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano omwami omwene mukunda alakhola arie? Mbula aliitsa namalilana abalimili abo, naheelesia abandi omukunda okwo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.9",
            "verseOrgIds": [
              "MRK.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhurunga obushuru bwaKaisari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamurumila abandi abokhuba Farisayo nende abokhubaHerode, mbu bamureche mumasungo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.13",
            "verseOrgIds": [
              "MRK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa bali niboolile, nibamusunjila bari Omwechesia, khumanyile shinga olwa oli owatoto, norateebanga akomundu yesi ta; shichila shiopaaranga khushiimo shiomundu yesi ta, ne mbu wibaalanga injila yaNyasaye mubwatoto; okhurunga obushuru khuKaisari nomusilo nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.14",
            "verseOrgIds": [
              "MRK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khurunje, nohomba khuleshe okhurunga? Naye namanya obubatsa bwabwe, nabasunjila ari Mundeema mbushi? Mundeerele itinari endole. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.15",
            "verseOrgIds": [
              "MRK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibachileera. Nabareeba ari Nobwawina obukondo buno, nende lihandiiko lino? Nibamukalusia mbu NebiaKaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.16",
            "verseOrgIds": [
              "MRK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nababoolela mbu Ebili biaKaisari, mumurunjenje Kaisari; nebili ebiaNyasaye, mumurunjenje Nyasaye. Nibahuka muno.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lireebo eliokhubulamushi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaSadukayo bandi nibeetsa, ababoolanga mbu bubulaho obulamushi; nibamureeba ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bari Omwechesia, Musa yakhuhandiichila ari Omusiani wabwe omundu naba nafwa, nalekha omukhasi ne naralekha omwana yesi ta, kho omusiani wabwe akhoyile okhukalusia omukhasiwe, amubuusilie omwana wabwe omurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali nibaliho abasiani musaafu abomunzu ndala; owambeli yaleera omukhasi, ne nafwa naralekha olwibulo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.20",
            "verseOrgIds": [
              "MRK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "owakhabili namukalusia, nafwa, naralekha olwibulo ta; kata owakhataru yesi ario; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.21",
            "verseOrgIds": [
              "MRK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata abo bosi musaafu shibalekhakhwo olwibulo tawe. Olunyuma wabo bosi omukhasi yesi nafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.22",
            "verseOrgIds": [
              "MRK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhulamukha aliba omukhasi wawina khubo? Shichila bosi musaafu bali nibamuteeshia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.23",
            "verseOrgIds": [
              "MRK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabasunjila mbu Shikali niko akachilanga nimushiama, mbu shimwamanya akamahandiiko kata obunyali bwaNyasaye shinga olwa buli, ta? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.24",
            "verseOrgIds": [
              "MRK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa balilamukha okhurula mubafu, shibaliteeshinjia kata okhuteeshibwa ta; ne baliba shinga abamalaika abomwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.25",
            "verseOrgIds": [
              "MRK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumakhuwa kabafu, shinga olwa balamusibungwa, shimwasoomakhwo mushitabu shiaMusa, haShitsakha, shinga Nyasaye olwa yamuboolela ari Nisie Nyasaye waAburahamu, khandi Nyasaye waIsaka, khandi Nyasaye waYakobo? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiali ye Nyasaye wabafu ta, habula wabali mwoyo; mwakorwa pe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilako likhongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulala khubahandiichi niyeetsa, nahulila nibareebananga ninaye, nalola shinga olwa yali nabakalusiye bulayi, namureeba ari Lili heena lilako eliranjilila mukosi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia mbu Eliambeli ndielino, mbu Iwe Isiraeli, hulila. Omwami Nyasaye weefwe nOmwami mulala; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuheelenje Omwami Nyasayewo nende omwoyokwo kwosi, neshiimoshio shiosi, nobuyililisibwo bwosi, nende amaaniko kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliakhabili ndielino, mbu Oheelenje owashio shinga olwa wiheela omwene. Libulaho lilako lindi elishila kano. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhandiichi oyo namusunjila mbu Toto mwene, Omwechesia, oteechile noboola mbu niye mulala; oundi ahumaho, habula ye; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
            "verseOrgIds": [
              "MRK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhumuheela nende omwoyo kwosi, nende obuchesi bwosi, nende amaani kosi, nokhuheela owashio shinga olwa wiheela omwene, khushila ebihaanwa ebisambe ebilamba nende emisango chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Yesu yalola shinga olwa yakalusia nobuchesi, yamusunjila mbu Shioli ehale nende obwami bwaNyasaye ta. Nokhurula habwenaho yabulaho owatsaalikha okhumureeba likhuwa liosi ta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lireebo eliokhuMwana waDaudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
