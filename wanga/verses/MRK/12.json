            "sid": "MRK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Yesu yali niyeechesinjia muhekalu yareeba mbu Abahandiichi baboolanga barie mbu Kristo nomwana waDaudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi omwene yasunga niyeebaalilwa nende Roho Omutakatifu, mbu",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yafukula Abahandiichi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
