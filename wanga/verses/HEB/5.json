          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba buli mukuhani omukhulundu yeelwa mubandu khandi areebwaho khulwa abandu mumakhuwa kaNyasaye, mbu ahaanenje ebihaanwa nende okhumala emisango khulwa ebionoono. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyala okhubabeela eshisa abo abakorwa, nabashiamile, shichila ye omwene yesi afumbilungwakhwo obuteshele; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khulwako akhoyile okhwimalilanga omwene emisango khulwa ebionoono, shinga olwa akholelanga abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abulaho owibukulila oluyali olwo ta, habula olwa Nyasaye amulanga, shinga olwa yalanga Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ario kata Kristo shiyeebukulila omwene oluyali Iwokhukholwa omukuhani omukhulundu ta; habula ovo owamuboolela ari",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi haundi yaboola ari",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiobulamubwe bweshinamubili yahaana amalaamo namasaayo, nalakaya nalila amasika khumwenoyo owanyala okhumuhonia mukhufwa, ne yahulilwa shichila yamuriitsanga Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata olwa yali omwana, yeeka ario akokhuhulila munjila yobusaalili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namalile okhukholwa omulamba ario, yabakwila bosi abamuhulilanga eshinoko shiobuhonia bwobumeli; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye namukulikha mbu omukuhani omukhulundu weimela yaMelekisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesiyii khukobuhunzushi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumwenoyo khuli nende amakhuwa amanji okhuboola, akali amatinyu okhurimbulula, olwa muli butswa abeshiikala amarwi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa bulaano, mukhoyile okhuba abeechesii; nebutswa khatimba omundu yeeluule okhumwechesia akaranjilila keene mumasungo kaNyasaye; mwakwile abakwanile okhunyweesibwa amabeele, nebiliibwa ebitinyu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila omundu yesi oushinyweesibungwa amabeele abeetsanga nashili okhukoonyakhwo khwikhuwa liobulunjishi ta; nomwana omutoro. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ebiliibwa ebitinyu nebiabandu abalamba abakhulile, abeenabo abakhola eshinani nibanasia obuyililisii bwabwe okhwahukhasinjia amalayi namabii.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
    }
  ],
