            "sid": "HEB 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa kashili butswa kario, mbu abandi beenjilemwo; khandi mbu abo abeelwatsilwa Amakhuwa amalayi khale bachweya okhwinjilamwo khulwa obukhayi bwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.6",
            "verseOrgIds": [
              "HEB.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho khandi yaraho inyanga nabulebe, mbu “Leelo,” naboola mumunwa kwaDaudi inyuma wetsindaalo tsinyinji, shinga olwa khuboolile yaho inyuma, mbu",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.7",
            "verseOrgIds": [
              "HEB.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
