        "style": "s1"
      },
      "items": [
        {
          "text": "Obuhonia obukhongo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nikhukhoyile okhumeeta okhuyililisinjia muno khukeenako aka khwahuliile, khuleshe okhurelela. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
              "HEB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba likhuwa eliaboolwa muminwa chiabamalaika niliba nilianyoolekha nilili liralilu, buli buyiiri kata obukhayi bwosi niburungwa, Agwa omurungo okuhela habwene, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ifwe khuleehonokokha khurie, nikhuba nikhurateeba likhuwa ta khubuhonia obuli obukhongo burio? Bwaranjilila okhurumbulwa nOmwami, mana nibukhutinyisilibwa nende abahulili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye yesi yarumbula akobuloli halala ninabo, mubilolelo nende ebiamakana nende ebikhole biobunyali bindi nebindi, khandi mumikabo chiaRoho Omutakatifu, shinga okhuchama khukhwe omwene olwa khwali.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusimishi wobuhonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shiyara eshialo shilia eshili okhwitsa, eshia khuboolangakhwo, hasi woburuchi bwabamalaika ta. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.5",
            "verseOrgIds": [
              "HEB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omundu undi yarumbula habundu undi, ari",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.6",
            "verseOrgIds": [
              "HEB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.9",
            "verseOrgIds": [
              "HEB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila kamukhoyela Nyasaye, owa ebindu biosi bibeetsangaho khululwe, nibietsela muye, mbu olwa yeenjisinjia abaana abanji muluyali, amukhole omusimishi wobuhonia bwabwe abe omulamba, munjila yobusaalili. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila omwenoyo owahulanga nende abo abaahulwa bosi barula khulala; ne niko akachila narafwimbwa omurwe okhubalanga mbu abaana babwe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, ari Ndalamwisiikanga. Khandi, ari Lole, isie nende abaana bano aba Nyasaye yambeelesiye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho shinga abaana olwa basanjilana khumabanga neinyama yomubili, ye yesi yasanjilana ario khubiatsana; mbu mana munjila yokhufwa atibie oyo owali nali nende obunyali bwokhufwa, niye Setani; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.14",
            "verseOrgIds": [
              "HEB.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu ababoholole abo bosi abalinji mumbohe tsindaalo tsiabwe tsiosi khulwa okhuria okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.15",
            "verseOrgIds": [
              "HEB.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila toto mwene, shibali abamalaika aba yahabina ta; habula yahabina abolwibulo lwaAburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.16",
            "verseOrgIds": [
              "HEB.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila yali nakhoyile okhufwananibwa nabaana babwe mumakhuwa kosi mbu abe omukuhani omukhulundu, owetsimbabasi khandi omwisiikwa, mukaNyasaye, okhutisa abandu ebionoono biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.17",
            "verseOrgIds": [
              "HEB.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila olwa omwene yasaalila mubuteemwi, anyala okhubahabina abateemungwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.18",
            "verseOrgIds": [
              "HEB.2.18"
            ]
          }
        }
      ]
    }
