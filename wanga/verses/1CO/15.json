{
  "id": "1CO.15",
  "number": "15",
  "bookId": "1CO",
  "reference": "1 Abakorinzo 15",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulangushi bwaKristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, baana beefwe, emumanyia amakhuwa keene amalayi aka ndamwilwatsila. Mwakanyoola, muraliile muko, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.1",
            "verseOrgIds": [
              "1CO.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi muhonibungwa khulwako, nimuba nimuhanda khumakhuwa keene aka ndamwilwatsila--habula obusuubili bweenywe nibwali obukhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.2",
            "verseOrgIds": [
              "1CO.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwambeli ndamukaamila akeenako aka ndaheebwa, aka Kristo shinga olwa yafwa khulwa ebionoono bieefwe, shinga amahandiiko olwa kaboola; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi shinga olwa yayabilwa; khandi shinga olwa yalamusibwa mukhufwa khunyanga yakhataru, shinga amahandiiko olwa kaboola; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi shinga olwa yaloleshela Kefa; mana nende abeenabo Ekhumi-nababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana naloleshela abaana beefwe abashila ebikhumi biraano, bosi halala; ne khubo obunji bwabwe bashiliho okhuula bulaano, ne abandi bamalile okhukona; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana naloleshela Yakobo, mana nende abarume bosi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolunyuma lwabosi yandoleshela isie, omukhokosi omwitsukhanwa uno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila endi omutuutu khubarume bosi, nindakwanile okhulangwa mbu omurume ta, shichila ndasandinjia ikanisa yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa obukoosia bwaNyasaye endi endio shinga olwa endi; kata obukoosiabwe obwa ndaheebwa shibwali obukhaya ta; ne ndanyakhana muno muno, okhubashila bosi; ne shindi nisie ta, habula obukoosia bwaNyasaye obwa ndali ninabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho kata nindi isie, kata nibali bo, nilwo olwa khwilwatsanga, khandi nilwo olwa mwasuubila.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulamushi bwabafu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aka Kristo olwa keelwatsungwa mbu yalamusibwa okhurula mukhufwa, abandi khwinywe basunganga barie mbu bubulaho obulamushi bwabafu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibuba nibubulaho obuIamushi bwabafu, kho kata Kristo shiyalamusibwa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Kristo naba naralamusibwa ta, khane obwilwatsi bweefwe nibutswa, khandi obusuubili bweenywe nibutswa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, neefu khunyoolekha nikhurumbulanga akobubeeyi khuNyasaye shichila khwarumbula akobuloli khuNyasaye mbu yamulamusia Kristo; ne khane shiyamulamusia tawe, abafu nibaba nibaralamusibungwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila abafu nibaba nibaralamusibungwa ta, kata Kristo shiyalamusibwa ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Kristo naba naralamusibwa ta, khane obusuubili bweenywe nibutswa; mushilinji mubionoono bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abeenabo abakona muKristo bamalile okhutiba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhuba nikhunaayilanga muKristo mubulamu buno bwonyene, khuli abamasila mubandu bosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Kristo yalamusibwa okhurula mukhufwa, naba omurongole wabeenabo abakona tsindoolo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga okhufwa olwa khweetsa khulwa omundu, obulamushi bwabafu nabwo bweetsa khulwa omundu burio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga bosi olwa bafwila muAdamu nolwa bosi balalamusibwa muKristo bario. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne buli mundu mutsisinjitsie; mbu Kristo ouli omurongole; mana khukhwitsakhwe, abo abali baKristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obumaliilishi bwitsa olwa alakaamila Nyasaye Samwana obwami; olwa alaba niyaakamiye oburuchi bwosi, nende obukhulundu nende obunyali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khatimba aruche, okhuula olwa alaba nareele abasukube bosi hasi wamakuluke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusuku oulahelelesia okhutibibwa nokhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.26",
            "verseOrgIds": [
              "1CO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila mbu Yara biosi muburukwi hasi wamakuluke. Ne olwa yasunga mbu Ebindu biosi biareebwa muburukwi, limanyikha mbu oyo owabira muburukwibwe shialimwo mubindu tsana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.27",
            "verseOrgIds": [
              "1CO.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa ebindu biosi bilaba nibireelwe muburukwibwe, mana Omwana mwene yesi alareebwa muburukwi bwomwenoyo owara biosi muburukwi bubwe, mbu Nyasaye abe biosi khubosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikarali kario ta, balakhola barie ababatisibwa khulwa abafu? Abafu nibaba nibaralamusibwakhwo ta, mbushiina nibababatisilibwa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.29",
            "verseOrgIds": [
              "1CO.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu fwesi, khubeetsanga khurio mumatinyu isaa buli saa, mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.30",
            "verseOrgIds": [
              "1CO.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana beefwe, nditsuba khukhwiyitsoomia okhwa endi ninakhwo khwinywe muKristo Yesu Omwami weefwe, mbu efwitsanga buli nyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.31",
            "verseOrgIds": [
              "1CO.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba nindalwana nende tsisolo eEfeso, isie omundu namundu, khwakhangaasila shiina, abafu nibaba nibaralamusibwa ta? Leshe khulie nikhunywa, shichila mukamba nakhufwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muleshe okhukosibungwa; okhuchenda nababii khubiiyinjia ebiima ebilayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.33",
            "verseOrgIds": [
              "1CO.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labe tsimoni, nimuroonoona ta; okhuba abandi shibamumanyakhwo Nyasaye ta; emboola endio okhumufwimbia emirwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omubili kwobulamushi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwana oundi alareeba mbu Abafu balamusibwa barie? Khandi nemibili echiambia shiina echia beetsa okhwitsa ninachio? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.35",
            "verseOrgIds": [
              "1CO.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusilu iwe, eshia oraakanga iwe omwene shishilamusibwa nishirafwile ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.36",
            "verseOrgIds": [
              "1CO.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata eshio eshia oraaka, shioraaka omubili okulibaho ta, habula imwo ikhaya, haundi eyeingano, haundi eyeimbia yindi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.37",
            "verseOrgIds": [
              "1CO.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Nyasaye achiheelesinjia omubili shinga olwa achama, buli imwo nomubili kwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.38",
            "verseOrgIds": [
              "1CO.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama yemibili chiosi shiyili inyama ndala ta; ne yiliho eyabandu, neinyama yindi yetsisolo, neinyama yindi yamanyonyi, neyindi eyetsinyeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.39",
            "verseOrgIds": [
              "1CO.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi chiliho emibili echieshineekulu, nende emibili echieshinashialo; ne oluyali lwa echio echieshineekulu chili khubwalwo, nende olwa echio echieshinashialo chili khubwalwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.40",
            "verseOrgIds": [
              "1CO.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luliho oluyali lulala Iweliuba, noluyali lundi olwomwesi, noluyali lundi Iwetsinyininyini; okhuba kata inyininyini ndala yinyala okhwahukhana nende eyindi oluyali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CO 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nindio obulamushi bwabafu buli burio. Kuraakwa mumela yobuboli, kulamusibwa mumela eyirabola ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.42",
            "verseOrgIds": [
              "1CO.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CO 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuraakwa mubufwolwi, kulamusibwa muluyali; kuraakwa mubuteshele, kulamusibwa mubunyali; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.43",
            "verseOrgIds": [
              "1CO.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuraakwa omubili kwoburulanda; kulamusibwa omubili kweshiroho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikuba nikuliho omubili kwoburulanda, kuliho khandi omubili kweshiroho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CO 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kario kahandiikwa mbu Omundu owambeli, Adamu, niyeekhola omwoyo okuli nobulamu. Naye Adamu owobumaliilishi naba roho ouhaana obulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.45",
            "verseOrgIds": [
              "1CO.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CO 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shishili eshieshiroho eshiranjilila okhubaho ta, habula eshili eshioburulanda; mana eshili eshieshiroho nishirakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.46",
            "verseOrgIds": [
              "1CO.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CO 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu wambeli nowokhulufu Iweshialo; omundu wakhabili nowomwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.47",
            "verseOrgIds": [
              "1CO.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CO 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga omundu oyo wolufu olwa ali, nolwa bosi abali bolufu bafwana bario; ne shinga oyo owomwikulu olwa ali, nolwa bosi abali bomwikulu bafwana bario. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.48",
            "verseOrgIds": [
              "1CO.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga olwa khwafwanana khwikondo liowolufu, nindio khulifwanana khwikondo liowomwikulu khurio.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, baana beefwe, esunga mbu omubili kweinyama namabanga shikunyala okhulaamilwa obwami bwaNyasaye ta; kata eshieimela yobuboli okhulaamilwa eshieimela yoburabola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CO 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, emuboolela akelibiso: mbu Shikhulakona tsindoolo fwesi ta, ne fwesi khulakalulwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CO 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "shialwangu, mushise shiokhutemiliamwo butswa imoni, olwika olumaliilikha olwa lulikhupa; okhuba olwika lulilanga, mana abafu balilamusibwa mumela yoburabola ta, fwesi nikhukalulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.52",
            "verseOrgIds": [
              "1CO.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CO 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba obuboli buno bukhoyile okhwifwala oburabola ta; khandi obufwitsanga buno bukhoyile okhwifwala oburafwitsanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.53",
            "verseOrgIds": [
              "1CO.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CO 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obuboli buno olwa buliba nibwifwalile oburabola ta, khandi obufwitsanga buno olwa buliba nibwifwalile oburafwitsanga ta, habwenaho likhuwa liliusibwa eliahandiikwa, mbu Okhufwa khumilishiile mukhuhula. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.54",
            "verseOrgIds": [
              "1CO.15.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CO 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe okhufwa, okhuhulakhwo khuli heena? Iwe okhufwa, olubalalwol luli heena? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1CO 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olubala Iwokhufwa nobwonooni; nobunyali bwobwonooni burula mumalako; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.56",
            "verseOrgIds": [
              "1CO.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1CO 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khumuupile Nyasaye orio, oukhunyalilanga okhuhula khulwa Omwami weefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.57",
            "verseOrgIds": [
              "1CO.15.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1CO 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, baana beefwe abaheelwa, simbiilenje nimuralila, nimushilaana mumilimo chiOmwami tsindaalo tsiosi, okhuba mumanyile mbu muMwami, emilimo chieenywe shichili emikhaya ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.58",
            "verseOrgIds": [
              "1CO.15.58"
            ]
          }
        }
      ]
    }
  ],
