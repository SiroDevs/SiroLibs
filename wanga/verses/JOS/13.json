              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shiabwe shiali okhurula eMahanaimu, muBashani shiosi, oburuchi bwosi bwaOgu omuruchi waBashani, namataala kosi kaYairi, akali muBashani, mbu amataala amakhumi kasasaba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
