  "reference": "Yoswa 13",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "JOS 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshialo eshiali nishitong'a nishishili okhubukulwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yoswa yali omukofu omuyindifu wemiyika eminji; OMWAMI namusunjila mbu Iwe oli omukofu, omuyindifu wemiyika eminji; ne shishitong'a eshialo eshikhongo eshishili okhubukulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo eshishitong'a shieshino; mbu mumbali tsiosi tsiabaFilisiti; netsiabaGeshuri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu okhurula khumwalo kwaShihori okuli elubeka Iwebukwe weMisiri, okhuula khulwakho lwaEkeroni enotsi, nashio shibalwa mbu neshiabaKanaani; baliho abaami baraano babaFilisiti, mbu ababaGaza, nabaAshidodi, nabaAshekeloni, nabaGatsi, nabaEkeroni; khandi mumbali tsiabaAwi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "esautsi; eshialo shiosi shiabaKanaani, nende Meara eshili shiabaSidoni, okhuula khuAfeki, nokhuula khulwakho lwabaAmori; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshialo shiabaGebali, nende Lebanoni shiosi, okuhenjile ewa eliuba lifwindilanga, okhurula eBaali-gadi, mundaalila weshikulu shiaHeremoni okhuula khubwinjililo bwaHamatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bosi abamenya mushialo shiebikulu okhurula eLebanoni okhuula khuMisirefotsi-maimu, nibo abaSidoni bosi; isie omwene ndalabarusia imbeli wabaana baIsiraeli; habula iwe oshibakabulile abaIsiraeli shibe eshiobulaame, shinga olwa ndakhulaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.6",
            "verseOrgIds": [
              "JOS.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano okabulile tsimbia etsio shienda neinusu yoluyia lwaManase eshialo shino shibe obulaame.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshialo eshiakabilzoa Manase naReubeni naGadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inusu yoluyia lwaManase eyo, halala nabaReubeni nabaGadi, banyoola obulaame bwabwe obwa Musa yabaheelesia, injelekha weYorodani ebukwe, shinga Musa omusumba wOMWAMI olwa yabaheelesia; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu okhurula eAroeri elili khundulo welibanda liaArinoni, nelitaala elili hakari welibanda, nomuhololookhwe kwosi kwaMedeba okhuula eDiboni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namataala kosi kaSihoni omuruchi wabaAmori, owali niyaruka muHeshiboni, okhuula khulwakho lwabaana baAmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Giieadi, nomumbali tsiabaGeshuri nabaMaaka, neshikulu shiosi shiaHeremoni, nende Bashani shiosi okhuula khuSaleka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "noburuchi bwosi bwaOgu muBashani; ye yarukanga muAshitarotsi naEderei; ne niye yenyene owatong'a khumusikalo kwabaRefai. Okhuba abo nibo aba Musa yakhupa nabarusiamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaana baIsiraeli shibarusia abaGeshuri kata abaMaaka ta; ne Geshuri naMaaka bamenyanga hakari waIsiraeli okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khuluyia lwaLawi lwonyene shiyabaheelesia obulaame ta; ebihaanwa biOMWAMI Nyasaye waIsiraeli ebikholelwa omulilo nibio obulaamebwe, shinga olwa yamuboolela.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Musa yaheelesia oluyia lwabaana baReubeni obulaame, ebilibwa biabwe shinga olwa biali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.15",
            "verseOrgIds": [
              "JOS.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shiabwe shiarula khuAroeri, elili khundulo welibanda liaArinoni, nelitaala elili hakari welibanda, nomuhololookhwe kwosi kwaMedeba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.16",
            "verseOrgIds": [
              "JOS.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naHeshiboni, namataala kalio kosi akali khumuhololookhwe; Diboni, naBamotsi-baali, naBetsi-baali-meoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "naYahaza, naKedemotsi, naMefaatsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.18",
            "verseOrgIds": [
              "JOS.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naKireatsaimu, naSibima, naZeretsi-shahari mushikulu shielibanda; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.19",
            "verseOrgIds": [
              "JOS.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "naBetsi-peori, neshitikulukho shiaPisiga, naBetsi-yeshimotsi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.20",
            "verseOrgIds": [
              "JOS.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu amataala kosi komuhololookhwe, noburuchi bwosi bwaSihoni omuruchi wabaAmori, owali niyaruka muHeshiboni, nowa Musa yakhupa halala nabaami baMidiani, mbu Ewi, naRekemu, naZuri naHuri naReba, abal hulundu baSihoni, abali nibamenya mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.21",
            "verseOrgIds": [
              "JOS.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende Balaamu waBeori, omuupi wolubu, abaana baIsiraeli nibamwira nolukanga halala nabandi abo abeerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.22",
            "verseOrgIds": [
              "JOS.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwakho lwabaana baReubeni lwali khuYorodani; nikwo olwakho. Obwo nibwo obulaame bwabaana baReubeni, ebilibwa biabwe shinga olwa biali, amataala kabwo nebisoma biabwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Musa yaheelesia oluyia lwaGadi obulaame, khubaana baGadi, ebilibwa biabwe shinga olwa biali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshialo shiabwe shiali Yazeri, namataala kosi kaGileadi, neinusu yeshialo shiabaana baAmoni, okhuula khuAroeri elili imbeli waRaba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhurula eHeshiboni okhuula eRamatsi-mizipe, nende Betonimu; nokhurula eMahanaimu okhuula khulwakho IweDebiri; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mwibanda, mbu Betsiharamu, naBetsi-nimira, naSukotsi, naZafoni, obwatong'a khuburuchi bwaSihoni omuruchi waHeshiboni, Yorodani nikuli olwakho, okhuula khushihesi shieinyanza yaKhineretsi injelekha weYorodani ebukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo nibwo obulaame bwabaana baGadi, ebihbwa biabwe shinga olwa biali, amataala kabwo nebisoma biabwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
