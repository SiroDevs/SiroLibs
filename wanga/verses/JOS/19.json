          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno nibwo obulaame bwoluyia lwabaana baDani, ebilibwa biabwe shinga olwa biali amataala nebisoma biako.",
          "type": "text",
