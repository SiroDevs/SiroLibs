          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukabo kwakhasasaba nikurulila mukha, nikukwila oluyia lwaNafutali, mbu abaana baNafutali, ebilibwa biabwe shinga olwa biali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.32",
            "verseOrgIds": [
              "JOS.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwakho lwabwe lwarula eHelefi, okhurula khumuruba okwali muZaananimu, naAdaminekebu, naYabineeli, okhuula khuLakumu; neshihesi shialwo khuYorodani; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana olwakho nilukotola nilutsia mumbo okhuula eAzinotsi-tabori, nilurula yaho nilutsia eHukoki niluula khuZabuloni esautsi, nende khuAsheri mumbo, nende Yuda ewa eliuba lifwindilanga, haYorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namataala akali netsingoba ngakano; mbu Zidimu, Zeri, Hamatsi, Rakatsi, Khineretsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
