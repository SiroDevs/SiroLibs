          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleteke, Gibetsoni, Baalatsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
