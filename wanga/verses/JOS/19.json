          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekeshi, Ederei, Eni-hazori, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.37",
            "verseOrgIds": [
              "JOS.19.37"
            ]
          }
        },
        {
          "name": "verse",
