              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamalilisia bario okhukabula eshialo shibe obulaame, mumbali tsiashio; mana abaana baIsiraeli nibaheelesia Yoswa waNuni obulaame hakari wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
