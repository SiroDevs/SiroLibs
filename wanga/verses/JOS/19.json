              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno nibwo obulaame bwoluyia lwabaana baNafutali, ebilibwa biabwe shinga olwa biali, amataala nebisoma biako.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
