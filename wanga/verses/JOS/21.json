          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI naheelesia Isiraeli eshialo shiosi eshia yeetsubila abasamwana mbu yakhabaha; nabo nibashilia, nibamenyamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nabaheelesia obuhuluushi tsimbeka tsiosi, kosi aka yeetsubila basamwana shinga olwa kali; kata shiyaliho omundu yesi khubasuku babwe owasinjila imbeli wabwe ta; OMWAMI yahaana abasuku babwe bosi mumakhono kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata khumalayi kosi aka OMWAMI yali niyasunga khunzu yaIsiraeli, shiliachweya okhwikhola kata elala ta; habula kosi keekhola.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
