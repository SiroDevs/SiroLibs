            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abaana baGerishoni, abali abokhubilibwa biabaLawi, khukeinusu yoluyia lwaManase babaheelesia Golani muBashani nobwayilo bwalio, litaala tsana liobwilushi ilo bwomundu omwiri; nende Be-eshitera nobwayilo bwalio; amataala kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhukoluyia lwaIsakhari, Kishioni nobwayilo bwalio; Daberatsi nobwayilo bwalio; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaramutsi nobwayilo bwalio; Eni-ganimu nobwayilo bwalio; amataala kane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.29",
            "verseOrgIds": [
              "JOS.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhukoluyia lwaAsheri, Mishali nobwayilo bwalio, Abidoni nobwayilo bwalio; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.30",
            "verseOrgIds": [
              "JOS.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helikatsi nobwayilo bwalio, naRehobu nobwayilo bwalio; amataala kane. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.31",
            "verseOrgIds": [
              "JOS.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhukoluyia lwaNafutali, Kedeshi muGalilaya nobwayilo bwalio, litaala tsana liobwilushilo bwomundu omwiri; nende Hamotsi-dori nobwayilo bwalio, naKaratani nobwayilo bwalio; amataala kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.32",
            "verseOrgIds": [
              "JOS.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amataala kosi kabaGereshoni, ebilibwa biabwe shinga olwa biali, kali amataala ekhumi nakataru nobwavilo bwako.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.33",
            "verseOrgIds": [
              "JOS.21.33"
            ]
          }
        }
      ]
    },
    {
