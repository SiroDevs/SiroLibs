    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lishiesio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyirula khuPaulo, omurume waKristo Yesu, khulwa lilako liaNyasaye Omuhonia weefwe, nelia Kristo Yesu ouli linaayo lieefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yule khuTimotseo, omwana wanje watoto mubusuubili:",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukoosia, netsimbabasi, nomulembe, ebirula khu Kristo Yesu Omwami weefwe, nende Nyasaye ouli Samwana.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuchesiyii khukameechesio kobukaatii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa ndakhusaaya mbu omenyekhwoyo eEfeso olwa ndali nindi okhutsia eMakedonia, okhoyile okhukaania abandu nabulebe obureechesia ameechesio kandi lukano ta, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata okhureka amarwi khuketsingano kata khuketsinzibulo akabula eshiakamo, akaleera amareebano nikaralolosia tsiyemi tsiaNyasaye etsili mubusuubili, tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne elikhoyile okhurula mubukaanii obwo nilio obuheeli oburula mumwoyo omweleleshe, nomwoyo omulayi, nobusuubili obubula obubatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu nabulebe beehaanya kano, nibashiukhanila imbakha ikhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beekomba okhuba abeechesia beitorati, kata olwa bakorwa eshisina shiakeenako aka baboolanga nende akeenako aka barumbulanga chiminiyai.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumanyile mbu amalako namalayi, omundu naba nakalonda shinga amalako keene olwa kalaka, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "namanyile mbu amalako shikachooma khumundu ouli omulunjishi ta, habula khubakhayi bamalako, abeinumba; khulwabo abaramuria Nyasaye ta, aboonooni; khulwabo ababula idini, abakafwiri; khulwa aboopi babasamwana naboopi babanyina, abeeri babandu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaheyi, abatanyana, abeebi babandu, ababeeyi, abeetsuba ebiitsubo biobubeeyi, kata elindi liosi eliakhafukula ameechesio akali amalamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa kali munjiili yoluyali lwaNyasaye omwene ikhabi yosi, eya ndaheebwa okhulinda.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yakhupa orio khulwa tsimbabasi etsia yabeelwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emukhupila orio omwenoyo owa'nyalila, niye Kristo Yesu Omwami weefwe, shinga olwa yambasia mbu endi omwisiikwa niyaraho khubukhalabanibwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata olwa ndalinji omunyechi nomusandii, owamahababa. Nebutswa ndabeelwa tsimbabasi, shichila ndakholanga khulwa okhukorwa, nimbula obusuubili; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi obukoosia bwOmwami weefwe bwashilaana muno, halala nobusuubili nende obuheeli obuli muKristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa lino neliisiikwa, elikwanile okhufuchiiliilwa elala, mbu Kristo Yesu yeetsa mushialo okhuhonia aboonooni; ne khubeenabo nisie owambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lino nilio eliaebila nimbeelwa tsimbabasi, mbu mwisie owambeli tsana Yesu Kristo alolosiliemwo obwifwilibwe bwosi, embe eshilolelo shiabo abakhamusuubilila mundaalo etsiitsa okhuula khubulamu bwobumeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano Omuruchi oyo owobumeli, ourahwaho ta, ouralolekha ta, ouli Nyasaye yenyene, aheebwe ifuma noluyali, ebisoni nebisoni. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wanje Timotseo, amakhuwa kano ekhulachilisia, amakhuwa kobulakusi shinga olwa kali akeemila injila khwiwe, mbu khulwako oseerenje lihe lilayi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.18",
            "verseOrgIds": [
              "1TI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nohanda khubusuubili khandi khumwoyo omulayi. Baliho abasindikha ehale akomwoyo omulayi, mana obusuubili bwabwe nibukhama khamu shinga eliaro eliiyinikha mumatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.19",
            "verseOrgIds": [
              "1TI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubeenabo Himenayo nende Alekisanda balimwo; nabo ndabahaana mumakhono kaSetani, mbu beechesibwe okhulekha akobunyechi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.20",
            "verseOrgIds": [
              "1TI.1.20"
            ]
          }
        }
      ]
    }
  ],
