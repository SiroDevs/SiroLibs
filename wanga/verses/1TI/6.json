{
  "id": "1TI.6",
  "number": "6",
  "bookId": "1TI",
  "reference": "1 Timotseo 6",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1TI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi abali mwikokolo liobusumba bapaarenje khubaami babwe shinga olwa bakwaniile oluyali lwosi, mbu eliira liaNyasaye nende ameechesio keene bileshe okhunyekwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo aba abaami babwe bali abasuubili, barabachaya ta, shichila nabaana babwe; nebutswa bashile okhubakhalabanila, shichila abasanjilana khubiamo biobukholi bwabwe nabasuubili, khandi nabaheelwa.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhusangaalila ebia khuli ninabio.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kano obeechesie nobachesiyia. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba niyeechesia ameechesio kandi lukano, narafuchiilila amakhuwa amalamu ta, niko amakhuwa kOmwami weefwe Yesu Kristo, kata okhufuchiilila ameechesio akeidini, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwenoyo nowolukungu, ne shiamanyile likhuwa ta. Ali nobwikombi obufu khumareebano netsimbakha tsiamakhuwa; ne muko murulangamwo imbalikha, nobusoolo, namanyeko, nokhuyililisia okhubii khubandu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "namayingano kabandu aboonoonekha amayililisii kabwe, aba akatoto kakorela, nibakaala mbu idini yilabaleerela inganga. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne toto, idini neinganga ikhongo khu oyo ouchama ebia ali ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.6",
            "verseOrgIds": [
              "1TI.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shikhwayeenjila mushibala nikhuli nende eshindu, kata shikhulirulamwo nikhuchinjile eshindu ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.7",
            "verseOrgIds": [
              "1TI.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa nikhuli nende ebiokhulia nende ebiokhwihabikha, ebio bilakhuhela. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.8",
            "verseOrgIds": [
              "1TI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abo abeekomba okhuyindihala bakwitsanga mukhuteemwa nende mumubelo kwobwikombi obusilu obubasaalisia, obunyala okhuchila nibamilishila mubwonooneshi nokhutiba. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.9",
            "verseOrgIds": [
              "1TI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba okhuheelanga amapeesa nikhwo eshisina shiobumayaanu bwetsimbia tsiosi. Abandi nibeehenelesia okhukanyoola bamala bashiamibwe okhurula mubusuubili, nibeefumira abeene namasila amalulu amanji.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lihe lilayi eliobusuubili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.10",
            "verseOrgIds": [
              "1TI.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa iwe, omundu waNyasaye, wihaanye ako; ne olondachilile obulunjishi, okhuria Nyasaye, obwisiikwa, obuheeli, obwisi-milisii, nende obuholo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
              "1TI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olasanenje lihe lilayi liobusuubili; hamba obulamu bwobumeli obwa walanjilwa nobwa weeyama obwiyami obulayi imbeli wabaloli abanji. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhulaka imbeli waNyasaye oulamusinjia biosi, khandi imbeli waKristo Yesu, oweeyama obwiyami obulayi imbeli waPondio Pilato, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu ohulilenje lilako, harali eshiroonyelesi naharali eshikha shiosi, okhuula khukhulolekha khwOmwami weefwe Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhwa alilolosia khunduukhoye, oyo ouli Omwene bunyali bwosi yenyene, owitsoomibwa, Omuruchi wabaruchi, khandi Omwami wabaami; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.15",
            "verseOrgIds": [
              "1TI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne niye yenyene ourafwitsanga ta, oumenyanga mubulafu obwa omundu yesi aranyala okhuulakhwo ta; abulaho owamulola, kata owakhanyala okhumulola tawe; omwenoyo abe noluyali nende obunyali bwobumeli. Amina.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.16",
            "verseOrgIds": [
              "1TI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obakaanie abo abali abayinda mushialo shino eshiliho bulaano, mbu baleshenje okhwichinjimisia kata okhuchoomia obunaayi bwabwe khubuyinda oburaralila ta, habula khuNyasaye oukhuyindihasia nebindu biosi mbu khubitsatsahalile. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.17",
            "verseOrgIds": [
              "1TI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obalache mbu bakholenje amalayi, mana babeetsenje abayinda bebikhole ebilayi; mbu babeetsenje abahaani, abasanjilana nabandu; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.18",
            "verseOrgIds": [
              "1TI.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibeebiishila abeene libiikho elilibabeela omuse omulayi mundaalo etsili imbeli, mbu bahambe obulamu obwo obuli obwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.19",
            "verseOrgIds": [
              "1TI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Timotseo, lindanga ako aka waheebwa okhulinda; wihaanye obwilakalakanii bweshialo nende amayinje ebirula khubwenobwo obulangwa mbu obuchesi, niburali burio ta; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.20",
            "verseOrgIds": [
              "1TI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba baliho abeeyama ako, nibaroola khushindu shiosi halubeka Iwobusuubili ta. Obe nobukoosia.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.21",
            "verseOrgIds": [
              "1TI.6.21"
            ]
          }
        }
      ]
    }
  ],
