{
  "id": "1PE.2",
  "number": "2",
  "bookId": "1PE",
  "reference": "1 Petero 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
