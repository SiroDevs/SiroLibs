            "number": "32",
            "style": "v",
            "sid": "JOL 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi ouhaabila eliira liOMWAMI alihonibwa; okhuba mushikulu shiaSayuni nomuYerusalemu balibaho abaliihonokokha, shinga OMWAMI olwa aboolile; ne mumusikalo balibaho abandi aba OMWAMI alanga.",
          "type": "text",
          "attrs": {
