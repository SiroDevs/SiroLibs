              "type": "text"
            }
          ]
        },
        {
          "text": "Ndililolosia ebiamakana mwikulu nomushialo, mbu amatsayi, nomulilo, netsisiilo tsiomwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.30",
            "verseOrgIds": [
              "JOL.2.30"
            ]
          }
