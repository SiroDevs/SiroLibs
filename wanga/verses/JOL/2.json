            "number": "31",
            "style": "v",
            "sid": "JOL 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubasu kulikwa eshiilima nomwesi okhukwa amatsayi, induukho yOMWAMI, ikhulundu eyamariisia, niyirashioola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.31",
            "verseOrgIds": [
              "JOL.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
