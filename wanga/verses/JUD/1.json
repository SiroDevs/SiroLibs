          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa inywe, abaheelwa banje, mwitsulile amakhuwa akaboolwa khale nabarume bOmwami weefwe Yesu Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JUD 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa bamuboolela bari Mushise shiobumaliilishi balibaho abakokonyi abachenda mubwikombi bwabwe nibarariitsanga Nyasaye ta.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.18",
            "verseOrgIds": [
              "JUD.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
