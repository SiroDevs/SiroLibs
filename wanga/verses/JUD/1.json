          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
