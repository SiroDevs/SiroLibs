      },
      "items": [
        {
          "text": "Hosea nende omukhasi omuheyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI niyasunjila mbu Khatsie khandi, oheele omukhasi ouheelwa nomutiawe, ouli omuheyi; shinga OMWAMI olwa aheelanga abaana baIsiraeli, kata olwa bashiukhanilanga abanyasaye bandi, nibaheela amabumbi ketsinzabibu tsinyumu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimukula tsifeetsa ekhumi natsiraano, nende ishayiri ihomeri neinusu; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimuboolela mbu Oleekhala ninasi tsindaalo tsinyinji; shiolakhola obutamba kata shiolateeshibwa nomusaatsa yesi ta; nasi siesi ndalaba endio khwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nindio abaana baIsiraeli baleekhala tsindaalo tsinyinji nibabula omuruchi, nibabula omukhulundu, nibabula omusango, nibabula isiiro yelichina lisongookhu, nibabula efoti kata omuterafi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olunyumakhwo abaana baIsiraeli balakalukha nibakhaaba OMWAMI Nyasaye wabwe, naDaudi omuruchi wabwe; ne baleetsa noburii khuMWAMI nokhubulayibwe mundaalo tsiolunyuma.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    }
