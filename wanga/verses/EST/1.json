        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omukhaye Washiti yakhaya omuruchi Ahasuwero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiaAhasuwero, niye Ahasuwero tsana owaruka tsingongo eshikhumi amakhumi kabili namusaafu okhurula ebiHindi okhuula eEtiopia, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mundaalo etsio, olwa omuruchi Ahasuwero yali nali khushifumbi shioburuchibwe, eSusa, litookho, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumuyika kwakhataru kwoburuchibwe yakholela abakhulundube nabasumbabe lisabo, abaseesia belihe liaPerisia nebuMedi, nabamakuru, nende abakhulundu betsingongo nibali imbeliwe, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa yalolosinjia ebiobuyinda bioburuchibwe bwoluyali, neifuma neing'oono yobukhulundubwe, tsindaalo tsinyinji, nitsio tsindaalo eshikhumi namakhumi munaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsindaalo etsio olwa tsiali nitsihelile, omuruchi yabakholela lisabo abandu bosi abali nibaliho eSusa mwitookho, ari abakhongo ari abatuutu, tsindaalo musaafu, khushitonye eshilobole eshiomulwanyi Iweinzu ikhulundu yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsialiho tsingubo tsinzelesia tsindafu etsieipamba, netsieibulu, etsiabohelwa tsinzaha tsieikitani indorotoro neisambarau khungaka tsieifeetsa netsisiilo tsiamarimari; ne bialiho ebitali bieitsahaabu neifeetsa, ebiali khubwelu bwamachina kamarimari amaranzayi, namalafu, nakamunyuria, namamali. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabaheelesia ebiokhunywa mubikombe bieitsahaabu, ebikombe ebio biosi nibiahukhaane lukano lukano, neidivai yeshiami inyinji muno, eyirula khumukhono omusiro kwomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata obunywi obwo bwalonda khumalako; yabulaho owaraichilisibwa; okhuba nindio omuruchi yali nalachile abakali bosi abomunzuye, mbu bakhole aka buli mundu yeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Washiti omukhaye womuruchi yesi yakholela abakhasi lisabo munzu ikhulundu eyali yomuruchi Ahasuwero.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yomusaafu, olwa omwoyo kwomuruchi kwali nikutsatsahaale khulwa idivai, yalaka Mehumani, Bizitsa, Haribona, Bigitsa, Abigitsa, Zetsari, naKarikasi, abasumba abalate musaafu abakhalabananga imbeli waAhasuwero omuruchi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuleera Washiti omukhayewe imbeli womuruchi, nali nolusimbi Iweshiruchi, okhumanyia abandu nabakhulundu eshiisoshie, okhuba yali oweshiiso muno. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omukhaye Washiti yaloba okhwitsa khwilako liomuruchi muminwa chiabasumba abalate; ne khulwako omuruchi yasinyikha muno, inda niyiyia.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nareeba abachesibe, abachesibe, abachesihala khuketsindaalo etsio; okhuba nilwo olwa omuruchi yayinyanga okhureeba abo bosi abamanya akamalako nakobuyaasii; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abo abamulondanga ahambi bali Karishena, Shetsari, Adimatsa, Tarishishi, Meresi, Marisena, naMemukani, nibo abakhulundu musaafu baPerisia nende buMedi, abali beshiina shiomuruchi, abeekhalanga hambeli muburuchibwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabareeba mbu Khukhamukholele shina omukhaye Washiti khukamalako, shichila shiakholile aka yabiilwa nomuruchi Ahasuwero muminwa chiabasumba abalate ta? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Memukani nakalusiamwo, imbeli womuruchi nabakhulundu, ari Omukhaye Washiti shiakholeele omuruchi yenyene obubii ta, habula abakhulundu bosi, nende abandu bosi abali mungongo tsiosi tsiomuruchi Ahasuwero. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba eshikhole shino shiomukhaye womuruchi shilafuma ebulafu mubakhasi bosi, okhuchila abaami babwe nibachaywa mumoni tsiabwe, olwa kalasungwa mbu Omuruchi Ahasuwero yalaka Washiti omukhayewe okhuleerwa imbeliwe, ne shiyayeetsa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kata leelo luno abeshikhaye bosi baPerisia nebuMedi ababa nibahuliile akeshikhole shino shiomukhaye womuruchi, balaba nibaboolelanga abasumba bosi bomuruchi; mana obuchayi noburima bulabaho obunji. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi naba nachama, lilako liomuruchi lirumbulwe ebulafu, nilihandiikwa mumalako kabaPerisia nabaMedi, mbu lileshe okhukalukhasibwa, eliboola mbu Washiti areetsa imbeli womuruchi Ahasuwero khandi ta; mana omuruchi aheelesie oundi oumushila olukhayelwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa oburumbusi bwomuruchi, obwa yeetsa okhurumbula, bulaba nibutswanile muburuchibwe bwosi, obuli burio obukhongo, abakhasi bosi balaheelesia abaami babwe oluyali, ari abatuutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo nilichamisia omuruchi nabakhulundu; omuruchi nakhola aka Memukani yaboola; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "yayila tsibarwa mungongo tsiosi tsiomuruchi, khubuli lukongo mubuhandiichi bwalwo, nokhubuli bandu mululimi lwabwe, mbu buli musaatsa abeetsenje omuruchi munzu yiye, naboola olulimi lwabandu boluyialwe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
