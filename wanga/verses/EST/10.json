            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho omuruchi Ahasuwero yabalunyia abeshialo nabetsinguku tsieinyanza okhumukholela emilimo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kosi kobunyalibwe nakobululubwe, nakosi akatoonywa khubukhongo bwaMoridekai, obwa omuruchi yamwemekhakhwo, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi bebuMedi naPerisia? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Moridekai omuYahudi yali owakhabili khumuruchi Ahasuwero, nali omukhongo mubaYahudi, nafuchiililwa nemikanda emikhongo chiabaluyia babwe; okhuba yakhaabanga amalayi kabandube, nasunjilanga abolwibulolwe lwosi akomulembe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
