    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hamani yakhaaba okhusishia abaYahudi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako, omuruchi Ahasuwero yamwemekha Hamani waHamedatsa omuAgagi, namuchinguula, nara eshifumbishie emukulu wabakhulundu bosi aba yali ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.1",
            "verseOrgIds": [
              "EST.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abasumba bosi bomuruchi, abali muluyia Iwewomuruchi, nibabunamia emirwe, nibamwinamila Hamani; okhuba omuruchi yali nalachile ario khukeke. Habula Moridekai shiyabunamia omurwe kata okhumwinamila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.2",
            "verseOrgIds": [
              "EST.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumba bomuruchi abaliho muluyia Iwewomuruchi nibamureeba Moridekai bari Okhayile lilako liomuruchi mbushiina? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.3",
            "verseOrgIds": [
              "EST.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibamusunjilangakhwo khatsotselo, naye narabahulila ta, bamala nibamuboolela Hamani, okhumanya amakhuwa kaMoridekai nikaba nikakhahela nohomba; okhuba yali niyababoolela mbu nomuYahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.4",
            "verseOrgIds": [
              "EST.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa Hamani yalola shinga Moridekai olwa arabunamia omurwe kata okhumwinamila ta, Hamani yatiilwa oburima. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.5",
            "verseOrgIds": [
              "EST.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shikamuhela okhuhamba Moridekai yenyene ta; okhuba bali nibamubuuliile oluyia lwabwe Moridekai; niko akachila Hamani niyeenya okhutibia abaYahudi bosi abali muburuchi bwosi bwaAhasuwero, nibo oluyia lwabwe Moridekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.6",
            "verseOrgIds": [
              "EST.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwesi kwambeli, nikwo omwesi kwaNisani, mumuyika kwekhumi nakhabili kwomuruchi Ahasuwero, bakhupa Puri, eshisina mbu ikha, imbeli waHamani inyanga buli nyanga, khandi omwesi buli mwesi, okhuula khumwesi kwekhumi nakhabili, nikwo omwesi kwaAdari. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.7",
            "verseOrgIds": [
              "EST.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hamani nasunjila omuruchi Ahasuwero ari Luliho oluyia lwabandu abasalaanile ebulafu, nibamenyanga nibeeyahuushe mumbia etsiomungongo tsiosi tsiomuburuchibwo. Amalako kabwe kahukhaane nende akabandi bosi; kata shibalindanga amalako komuruchi ta; khulwako shikakhoyeele omuruchi okhubeesimilisilia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.8",
            "verseOrgIds": [
              "EST.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi naba nachama, kahandiikwe mbu bamululwe; nasi ndalarunga tsitalanda ebikhumila likhumi etsieifeetsa mumakhono ka abo abaleshelungwa obulindi bwamakhuwa komuruchi, okhutsira mumabiishilo komuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.9",
            "verseOrgIds": [
              "EST.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi narusia ingakaye yeshibalikho khulwala, namuheelesia Hamani waHamedatsa omuAgagi, omusuku wabaYahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.10",
            "verseOrgIds": [
              "EST.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi namuboolela Hamani ari Oheebwe tsifeetsa nende abandu, okhubakholela shinga olwa oluutsi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.11",
            "verseOrgIds": [
              "EST.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abahandiichi bomuruchi balangwa, mumwesi kwambeli nikuli ekhumi nakhataru; mana kosi aka Hamani yali nalachile nikahandiichilwa abakhulundu bomuruchi, nabakafuna abasinjilila tsingongo, nokhubeemilisi babuli luyia; khubuli lukongo mubuhandiichi bwalwo, nokhubuli bandu mululimi lwabwe; kahandiikwa muliira liomuruchi Ahasuwero, nikabalikhwa eshibalikho shieingaka yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.12",
            "verseOrgIds": [
              "EST.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abarume barumwa netsibarwa mungongo tsiosi tsiomuruchi, okhumulula, nokhwira, nokhutibia abaYahudi bosi, ari abatoro ari abakofu, ari abaana abatiiti ari abakhasi, khunyanga ndala, niyo inyanga yekhumi nakhataru eyomumwesi kwekhumi nakhabili, nikwo omwesi kwaAdari; khandi okhuyaaya ebindu biabwe, bikwe ebioluyiitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.13",
            "verseOrgIds": [
              "EST.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikopi yelihandiiko tsana yatswanibwa mumbia tsiosi tsiabandu, mbu omulome kukhupwe khukalakwa mubuli lukongo, mbu babe nibeerechesheele inyanga eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
            "verseOrgIds": [
              "EST.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abarume barula bwangu khwilako liomuruchi, omulome nikukhupwa khukalakwa okhurula eSusa litookho; nabo omuruchi nende Hamani bibeekhala okhunywa; ne abomwitookho liaSusa, kabaramba pe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.15",
            "verseOrgIds": [
              "EST.3.15"
            ]
          }
        }
      ]
    }
  ],
