        "style": "s1"
      },
      "items": [
        {
          "text": "Esita yeeyama okhubasaayika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Moridekai yamanya kosi akakholwa shinga olwa kali, Moridekai yarandula tsingubotsie, niyeefwala ingubo yamakunia, niyeepuuka likoshe, natsia habulafu hakari welitookho, nakhupa tsimbungu tsindulu muno; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyoola haluyia Iwewomuruchi; okhuba shikafuchiililwa mbu omundu yesi yeenjile muluyia Iwewomuruchi niyeefwalile tsingubo tsiamakunia ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mubuli lukongo, buli hosi ewa lilako liomuruchi lioola, nende omulome okwa yakhupa, khwaliho okhwikhuula okhukhongo mubaYahudi, nokhuhonga inzala, nokhulila, netsimbungu; abanji nibakona khungubo tsiamakunia nelikoshe.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhaana abatiitikhani baEsita nabasumbabe abalate nibeetsa nibamuboolela; omukhaye oyo nabeelela muno; naruma ebiifwalo okhumufwala Moridekai, nokhumufwalula tsingubo tsiamakunia; ne yakhaya okhubibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Esita nalanga Hatsakhi, mulala owokhubasumba abalate bomuruchi, owa omuruchi yali namulachile okhumukhalabanila, namulaka mbu atsie khuMoridekai, amureebe khumakhuwa kano, nende akachilile. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Hatsakhi yarula, natsia ewa Moridekai yali ebunashikuuri shielitookho, haluyia Iwewomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moridekai namuboolela kosi akali nikamukwiliile, nende obunji bwamapeesa keene aka Hamani yali nasuubisiye okhurunga mumabiishilo komuruchi khulwa abaYahudi, mbu batibibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namuheelesia nende ikopi yamahandiiko komulome okwakhupwa muSusa okhubatibia, mbu amumanyie Esita, namwinoosia; khandi mbu amulache atsie ewomuruchi okhumusaaya, nokhumusaba khulwa abandube. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hatsakhi nachelela, namuboolela Esita aka Moridekai asunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Esita nasungana nahatsakhi, namuruma ewaMoridekai okhuboola mbu ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasumba bosi bomuruchi nabandu abomungongo tsiomuruchi, bamanya mbu omundu yesi, kata omusaatsa kata omukhasi, owinjila ewomuruchi mulwanyi Iwomukari, ne naralanjilwe ta, liliho lilako elala lionyene, mbu yeerwe bwirwa; habula omwenoyo owa omuruchi yakhanyiilila indabushiye yeitsahaabu, mbu abe mwoyo; nasi shinanjilwe okhwinjila ewomuruchi ta, tsindaalo amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaboolela Moridekai aka Esita asunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Moridekai nabalaka okhukalusia Esita mbu Orakaala mbu iwe wakheehonokokha munzu yomuruchi, okhushila abaYahudi bosi, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba noba noholeela tsi leelo, ihabini nobuhonia bilabuushila abaYahudi okhurula habundu undi; nebutswa iwe nabeshilibwa shieenywe mulasikha; ne ali heena oumanyile nikakhali akeshise eshifwana shiri namwa, akachila niwula khuburuchi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Esita nababiila okhukalusia Moridekai mbu ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia okhung'aasie abaYahudi bosi abali muSusa, muhonje inzala khulwanje, oburalia kata okhunywakhwo tsindaalo tsitaru ta, eshiteere neshilo; nasi siesi halala nabakhaana abatiitikhani banje khulahonga khurio inzala; mana ndakhatsie endio okhwinjila ewomuruchi, kata olwa kuli omusilo; nimba nifwa, kho efwa bufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Moridekai natsia, nakhola kosi aka Esita yali namulachile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
