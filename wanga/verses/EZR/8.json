    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abeemilisi bebilibwa, khandi buno O nibwo obulondokhani bwetsinzibulo tsiabo aba khwatikulukha ninabo okhurula eBabeli, mundaalo tsioburuchi bwaAritashashita omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baFinehasi, Gerishomu; khubaana baItsamari, Danieli; khubaana baDaudi, Hatushi ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "owokhubaana baShekania; khubaana baParoshi, Zakaria; nahalala ninaye abokhubulondokhani bwetsinzibulo, abeshisaatsa eshikhumi namakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baPahatsi-moabu, Eliehoenai waZerahia; nahalala ninaye, abeshisaatsa ebikhumi bibili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baZatu, Shekania waYahazieli, nahalala ninaye, abeshisaatsa ebikhumi bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baAdini, Ebedi waYonatsani; nahalala ninaye, abeshisaatsa amakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baElamu, Yeshaya waAtsalia, nahalala ninaye, abeshisaatsa amakhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baShefatia, Zebadia waMikaeli; nahalala ninaye, abeshisaatsa amakhumimunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baYoabu, Obadia waYehieli; nahalala ninaye, abeshisaatsa ebikhumi bibili ekhumi namunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baBani, Shelomitsi waYosifia; nahalala ninaye, abeshisaatsa eshkihumi namakhumi kasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baBebai, Zakaria waBebai; nahalala ninaye, abeshisaatsa amakhumi kabili namunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baAzigadi, Yohanani waHakatani; nahalala ninaye, abeshisaatsa eshikhumi nende ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khubaana baAdonikamu, abo abalondakhwo; ameera kabwe ngakano, mbu Elifeleti, naYeueli, naShemayai nahalala ninabo, abeshisaatsa amakhumi kasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabaana baBigiwai, Utsai naZabudi; nahalala ninabo, abeshisaatsa amakhumi musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabakhung'aasia halala khumwalo okutsia eAhawa; nikhuupa ikambi nikhwikhalayo tsindaalo tsitaru; nihenjelesia mubandu nomubakuhani bulayi, nindanyoola mubo omundu yesi owokhubaana baLawi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nirumana okhulanga Eliezeri, naArieli, Shemaya. Elinatsani. Yaribu, Elinatsani, Natsani, Zakaria, naMeshulamu, abali abeemilisi; khandi nende Yoiaribu naElinatsani, abali abachesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimbaruma ewaIdo, omundu omukhulundu owali habundu ahalangwa mbu Kasifia; nimbaboolela aka bakhoyile okhusunjila Ido nabaana babwe, nibo abasumba abomuhekalu, habundu yaho eKasifia, mbu bakhuleerele abakhalabani khulwa inzu yaNyasaye weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba omukhono omulayi kwaNyasaye weefwe kwali khwifwe bakhuleerela omundu omurechelefu owokhubaana baMali waLawi waIsiraeli, mbu Sherebia, halala nabaana babwe nende abaanabe, ekhumi namunaane; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naHashabia, halala nende Yeshaya owokhubaana baMerari, nabaana babwe nende abaana aba abo beebula, amakhumi kabili; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhubasumba abomuhekalu, aba Daudi nende abakhulundu bali nibaraho khulwa obukhalabani bwabaLawi, abasumba ebikhumi bibili namakhumi kabili; ne bosi barumbulwa ameera kabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ndakhupa omulome okwokhuhonga inzala, ebweneyo khumwalo kwaAhawa, mbu khwituutuyie imbeli waNyasaye weefwe, okhumuhaabila akeinjila ingololofu khulweefwe abeene, nokhulwa abaana beefwe, nemiandu chieefwe chiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndafwimbwa omurwe okhusaba omuruchi ing'anda yabasikari nabachendela khufarasi mbu bakhuhabine khulwa abasuku abali khunjila; shichila khwali nikhumusunjiile omuruchi khuri Omukhono kwaNyasaye weefwe kuli khubosi abamukhaabanga, okhubakholela amalayi; habula obunyalibwe noburimabwe bufukulanga abo bosi abamulekha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nikhuhonga inzala nikhuhaabila Nyasaye weefwe khulwako; naye nafuchiilila okhuhaaba khweefwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ninzahula abandu ekhumi nababili abokhubeemilisi babakuhani, banga Sherebia naHashabia halala nende abaana babwe ekhumi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbachelela ifeetsa, neitsahaabu, nebimanulwa, nibio ebihaanwa bieinzu yaNyasaye weefwe ebia omuruchi nabeshiinashie nabakhulundube nende abaIsiraeli bosi abali nibaliyo, bali nibahaanile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndachela tsitalanda ebikhumi bisasaba namakhumi karaano tsieifeetsa, nebimanulwa bieifeetsa tsitalanda eshikhumi; itsahaabu tsitalanda eshikhumi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "netsindaabo amakhumi kabili tsieitsahaabu, etsiahela tsidarikoni eshikhumila; nebimanulwa bibili biomukasa omweleleshe, omung'inang'inu, ebiolukoosi okhuhelana nende itsahaabu, nimbihaana mumakhono kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbasunjila mbu Inywe muli abatakatifu bOMWAMI, nebimanulwa nabio nebitakatifu; ne ifeetsa neitsahaabu nebihaanwa ebihaanilwa OMWAMI, Nyasaye wabakuuka beenywe, khulwa okhuchama. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeetsenje meeso nimubilinda, okhuula olwa mulabichelela imbeli wabeemilisi babakuhani nabaLawi, nabeemilisi bebilibwa biaIsiraeli, eYerusalemu, mubisika bieinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abakuhani nabaLawi babukula obusiro obwo bweifeetsa neitsahaabu, nebimanulwa okhubiusia eYerusalemu, munzu yaNyasaye weefwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
