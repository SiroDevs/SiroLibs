            "sid": "EZR 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Dario omuruchi yahaana omunwa, nibarunilisia munzu yebitabu, ewa amabiikho kabiikhungwa eBabeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne eshitabu eshikanye shianyoolekha eEkibatana, mwitookho elili mulukongo IwebuMedi; nashio shiali nishiahandiikwamwo amakhuwa kano, kabiikhwe; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwambeli kwaKoreshi omuruchi, Koreshi omuruchi yahaana omunwa, ari Khumakhuwa keinzu yaNyasaye eYerusalemu, inzu tsana yumbakhwe, habundu ewa balamalilanga emisango, ewa baleerelanga emisango emisambe; obuchinguukhu bwayo bube amakhono amakhumi kasasaba, nobuchiikha bwayo amakhono amakhumi kasasaba; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.3",
            "verseOrgIds": [
              "EZR.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yikholwe amachina amakhongo tsinyaali tsitaru, nemisaala olunyaali lulala; nachio emirungo chiosi echienyekha chirulenje munzu yomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.4",
            "verseOrgIds": [
              "EZR.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ebimanulwa bieitsahaabu nebieifeetsa bieinzu yaNyasaye, ebia Nebukhadineza yarusia muhekalu eyili eYerusalemu nabileera eBabeli, bikalusibwe nibiyilwa khandi muhekalu eyili eYerusalemu, buli shindu mubwikhalo bwashio, nobira munzu yaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, iwe Tateni, kafuna wolukongo oluli injelekha womwalo, nawe Shetsari-bozenai, halala nabashieenywe abakafuna abali injelekha womwalo, muruleyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "leshe emilimo chieinzu yaNyasaye eyo chibe; leshe omukafuna wabaYahudi nabakofu babaYahudi boombashe inzu yaNyasaye tsana habundu wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.7",
            "verseOrgIds": [
              "EZR.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ehaana omunwa khuka namubakholelenje abakofu abaYahudi tsana, khulwa obuumbashi bweinzu yaNyasaye eyo; mbu khumiandu chiomuruchi, eshisina mbu khubindu ebiroosibungwa injelekha womwalo, abandu bano baheebungwe emirungo echienyekha chiosi habwene; baleshe okhushisibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata biosi ebia batamba, mbu tsihunwa, namamiiku, namakondi kebimwamwane, ebiemisango emisambe chiaNyasaye welikulu, neingaano, nomuunyu, ne idivai, namafura, shinga abakuhani abali eYerusalemu olwa baboola, baheebungwe khatsotselo, oburachweyekha ta, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.9",
            "verseOrgIds": [
              "EZR.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu bamalilenje Nyasaye welikulu emisango chieshiuya eshilayi, nibasaayila omuruchi obuyindifu, nabaanabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
              "EZR.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ehaana omunwa mbu omundu yesi yesi owakhakalukhasia likhuwa lino, omukuulo kutsomolwe okhurula khunzuye, naye arungwekhwo; inzuye nayo yikwisibwe eshipiitsi shiamakokha khulwa likhuua elo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.11",
            "verseOrgIds": [
              "EZR.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Nyasaye omwenoyo owamenyiayo eliiralie, akwisie bosi, ari abaruchi ari abandu, abakhaleera amakhono kabwe okhulikalukhasia, kata okhulikulula inzu yaNyasaye yino eyili eYerusalemu. Isie Dario ehaanile omunwa; kakholwe neshinani.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Tatenai, kafuna wolukongo oluli injelekha womwalo, naShetsari-bozenai nabashiabwe bosi, khulwa amakhuwa aka Dario omuruchi yabakhupila omunwa, bakhola bario neshinani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakofu babaYahudi nabo niboombakha nibakaasa, khulwa obulakuli bwaHagai omunabii naZakaria waIdo. Niboombakha, nibamalila elala, lilako liaNyasaye waIsiraeli shinga olwa liali, khandi omunwa kwaKoreshi nokwaDario nokwa Aritashashita omuruchi waPerisia okwa bahaana shinga olwa kwali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzu tsana yahwa khunyanga yakhataru eyomumwesi kwaAdari okwomumuyika kwakhasasaba kwoburuchi bwaDario omuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli, mbu abakuhani nabaLawi nabandi bosi abarula mubwarwi obwo, nibakhola akobwahuli bweinzu yaNyasaye eyo nomwikhoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamala emisango khubwahuli bweinzu yaNyasaye eyo, mbu tsisurusi eshikhumi, namamiiku ebikhumi bibili, namakondi kebimwamwane ebikhumi bine; nende omusango kwobwonooni khulwa Isiraeli yosi, mbu tsikhole ekhumi natsibili, obunji bwetsimbia tsiaIsiraeli shinga olwa buli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaraho abakuhani mubukabulwi bwabwe, nabaLawi mumikanda chiabwe, khulwa obukhalabani bwaNyasaye eYerusalemu, shinga olwa kahandiikwa mushitabu shiaMusa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abarula mubwarwi obwo nibalia irasaka khunyanga yekhumi nakhane eyomumwesi kwambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abakuhani nabaLawi bali nibeesiiyile bosi halala; bali abasiiye bosi; nibeera amakondi keipasaka khulwabo bosi abarula mubwarwi, nokhulwa abakuhani abaana babwe, nokhulwabwe abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli abali nibacheleele okhurula mubwarwi, nabo bosi abali niboongana ninabo nibeeyahukhasia khushifwabwi shiabamahanga abomushialo okhukhaaba OMWAMI, Nyasaye waIsiraeli, nibachilia, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhola lisabo liemikaate echibulamwo amamela tsindaalo musaafu nomwikhoyo; okhuba OMWAMI yali nabeekhoyesiye, nabashiukhasilia omwoyo kwomuruchi waAshuru, okhutinyisia amakhono kabwe mumilimo chieinzu yaNyasaye, niye Nyasaye waIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        }
      ]
    }
