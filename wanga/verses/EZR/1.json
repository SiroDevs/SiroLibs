        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Koreshi yakhupila omulome",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mumuyika kwambeli kwaKoreshi omuruchi waPerisia, khulwa okhuusia likhuwa elia OMWAMI yaboolela mumunwa kwaYeremia, OMWAMI yayakula omwoyo kwaKoreshi, omuruchi waPerisia, naye nakhupa omulome mubialo biosi bioburuchibwe, khandi nakahandiika, ari.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka Koreshi omuruchi waPerisia aboola; mbu Oburuchi bwosi obwomushialo shiosi, OMWAMI, Nyasaye welikulu, yabumbeelesiye; khandi yandachile okhumuumbashila inzu muYerusalemu, elili muYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.2",
            "verseOrgIds": [
              "EZR.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi yesi ouli mwinywe, owokhubandube bosi, Nyasayewe abe ninaye; atikulushe atsie eYerusalemu, elili muYuda, yoombashe inzu yOMWAMI, Nyasaye waIsiraeli; niye Nyasaye ouli muYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi ouba natong'ile, habundu hosi aha aba namenyangakhwo, abewabwe bamukhoonye neifeetsa, neitsahaabu, nemiandu, nemiruko, halala nende ebihaanwa ebia bachama okhuhaanila inzu yaNyasaye eyili muYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaare nibakalukha eYerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abeemilisi bebilibwa bieYuda naBenyamini nibarula, nabakuhani, nabaLawi, bosi aba Nyasaye yali nayakuule emioyo chiabwe okhutikulukha batsie okhuumbakha inzu yOMWAMI eyili eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bosi abali ahambi ninabo nibabakhoonya nebimanulwa bieifeetsa, neitsahaabu, nemiandu, nemiruko, nebindu biolukoosi, halala nende ebio ebia bachama okhuhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Koreshi omuruchi narusia ebimanukva bieinzu yOMWAMI, ebia Nebukhadineza yali niyaleera okhurula eYerusalemu nabira munzu abanyasayebe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bienebio biosi Koreshi omuruchi waPerisia yabiyinia, nabihaana mumukhono kwaMitsiredatsi omubiishi, owabibasilia Sheshibaza, omwami waYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunji bwabio mbwobuno; mbu tsingaye amakhumi kataru tsieitsahaabu, tsingaye eshikhumila tsieifeetsa, tsindaabo tsiomulilo amakhumi kabili nashienda; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsindaabo tsieitsahaabu amakhumi kataru, tsindaabo tsieifeetsa ebikhumila bibili ebikhumi bine nende ekhumi, nebimanulwa bindi eshikhumila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebimanulwa biosi bieitsahaabu nebieifeetsa biali ebikhumila biraano nebikhumi bine. Ebio biosi Sheshibaza yatikulukha ninabio, olwa abobwarwi batikulusibwa okhurula eBabeli okhuula eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
  ],
