        "style": "s1"
      },
      "items": [
        {
          "text": "Abafukuli basinjisia emilimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa abafukuli baYuda naBenyamini bahulila shinga olwa abo abarula mubwarwi bali niboombashilanga OMWAMI, Nyasaye waIsiraeli, ihekalu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "basitila Zerubabeli nabeemilisi bebilibwa ahambi, nibabasunjila mbu Chame khuumbashe nineenyu halala; okhuba khuhaabilanga Nyasaye weenywe, shinga inywe olwa mukhola; khandi khumumalilanga emisango okhurula mundaalo tsiaEsarihadoni omuruchi waAshuru, owakhutikulusia nakhuleera hano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Zerubabeli naYeswa, nabandi bosi abokhubeemilisi bebilibwa biaIsiraeli, babakalusia mbu Shimulikhwo nelikhuwa nineefwe ta, okhuumbashila Nyasaye weefwe inzu; nebutswa ifwe abeene fwenyene khuloombashila OMWAMI, Nyasaye waIsiraeli, shinga omuruchi Koreshi, omuruchi waPerisia, olwa yakhulaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu beshialo tsana batofuhasia amakhono kabaYuda, nibabariisia okhuumbakha, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibarunga abandu abachesiyii okhubafukula, okhwikalila tsiyemi tsiabwe, tsindaalo tsiosi tsiaKoreshi omuruchi waPerisia, kata okhuula khuburuchi bwaDario omuruchi waPerisia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana muburuchi bwaAhasuero, khukhuchaaka khwokhurukakhwe, bahandiika akobwinjilili khubeYuda naYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mundaalo tsiaAritashashita, Bishilamu naMitsiredatsi naTabeeli nabashiabwe bandi bamuhandiichila ibarwa Aritashashita omuruchi waPerisia; ibarwa tsana yahandiikwa munukuta tsieshiAramu, mululimi IwoluAramu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu omukhulundu naShimishai omuhandiichi bandiichila Aritashashita omuruchi ibarwa eyokhufukula Yerusalemu, yiri nanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana Rehumu omukhulundu yahandiika, naShimishia omuhandiichi, nabashiabwe bandi, mbu abayaasii, abakafuna, nabakhulundu bandi, abaPerisia, abaArekhi, abaBabeli, nabaSusa, nibo abaElamu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabamahanga kandi aka Osinapari omukhongo omukoosi yaleera, nabara mumataala kaSamaria nomumbali tsieinjelekha womwalo; bahandiika bari nanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne yino neikopi yeibarwa eya bayila; mbu Khu Aritashashita omuruchi. Abasumbabo abeinjelekha womwalo, nakandi kario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi akhoyile okhumanya mbu abaYahudi abatikulukha nibakhurulakhwo boolile eweefwe eYyerusalemu; bulaano boombakha litookho tsana libii lieinduli; bamalilisinjia olukoba, nibakasia omuse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.12",
            "verseOrgIds": [
              "EZR.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano omuruchi akhoyile okhumanya mbu litookho lino niliba nililumbakhwa, olukoba nilumalilisibwa, shibalarungakhwo obushuru, kata oburoosii, kata omurungo kundi kwosi ta; mana amapeesa aka omuruchi aliitsanga kalatiitiha kario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.13",
            "verseOrgIds": [
              "EZR.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, ifwe olwa khunyweetsanga omuunyu kweitookho, ne nikarakhukhoyeele mbu khulole omuruchi nafwolwa ta, khukhupiile omuruchi omunwa okhumumanyia bulayi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.14",
            "verseOrgIds": [
              "EZR.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu barunilisie mushitabu shiamakhuwa kabakuukabo; kho olakanyoola mushitabu shiamakhuwa tsana, nomanya shinga litaala lino olwa lili litaala liobukhaye, elileerelanga omuruchi nende tsingongotsie amatinyu, khandi shinga olwa babuusinjia induli mulio okhurula khale; ne niko akachila litaala lino liakwisibwa likunda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.15",
            "verseOrgIds": [
              "EZR.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumanyia omuruchi mbu litaala lino niliba niliumbakhwa, olukoba lwalio nilumalilisibwa, lilachila obule omukabo kwosi injelekha womwalo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.16",
            "verseOrgIds": [
              "EZR.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nabahandiichila likalusia banga Rehumu omukhulundu, naShimishai omuhandiichi, nabashiabwe bandi abali nibamenyanga eSamaria nomumbali tsindi injelekha womwalo; ari Omulembe, nakandi kario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibarwa eya mwakhuleerela yasoomelwa bulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.18",
            "verseOrgIds": [
              "EZR.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndahaana omunwa, nibarunilisia, nibanyoola shinga litaala lino olwa liabuushilanga khubaruchi nilibafukula khale, khandi shinga olwa induli nobukhayi bwakholelungwa mulio. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.19",
            "verseOrgIds": [
              "EZR.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi balinjiho abaruchi bamaani muYerusalemu, abarukanga mumbali mwosi injelekha womwalo; nibaheebungwa obushuru, noburoosii, nemirungo chindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.20",
            "verseOrgIds": [
              "EZR.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano mukhole lilako nimubasinjisia abandu bano emilimo chiabwe, litaala lino lileshe okhuumbakhwa okhuula olwa lilako lilarula khwisie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.21",
            "verseOrgIds": [
              "EZR.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mwirecheshe muleshe okhuba abatendeyu mwikhuwa lino; obwonooneshi bwimeetenje mbushi, nibuleerela omuruchi amatinyu?",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa ikopi yeibarwa yomuruchi Aritashashita yasoomelwa Rehumu, naShimishai omuhandiichi, nabashiabwe, batsia bwangu eYerusalemu khubaYahudi, nibabasinjisia emilimo namaani nende obunyali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emilimo chieinzu yaNyasaye eyili eYerusalemu nichisinjisibwa; chiasinjila chirio, okhuula khumuyika kwakhabili kwoburuchi bwaDario omuruchi waPerisia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
          }
        }
      ]
    }
  ],
