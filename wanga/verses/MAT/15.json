    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ameechesio kabakofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaFarisayo nabahandiichi barula eYerusalemu nibeetsa ewa Yesu yali, nibareeba bari ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
              "MAT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishiina eshichilanga abeechibo nibakhaya ameechesio kabakofu? Shichila shibasaabanga amakhono nibali okhulia ebiliibwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.2",
            "verseOrgIds": [
              "MAT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakalusia, nababoolela mbu Mbushiina neenyu nimukhayanga lilako liaNyasaye khulwako aka mwechesibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.3",
            "verseOrgIds": [
              "MAT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Nyasaye yaboola ari Heelesinjia so nende mawo oluyali; khandi ari Oufwola samwana kata nyina, okhuula afwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.4",
            "verseOrgIds": [
              "MAT.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neenyu muboolanga muri Omundu yesi ousunjila samwana kata nyina ari Eshieneshio eshia ndakhakhukhoonyile ninashio shiahuliilwe Nyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.5",
            "verseOrgIds": [
              "MAT.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho aleshe okhumuheelesia samwana oluyali. Ne khulwako aka mwechesibwa, mwirile likhuwa iiaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.6",
            "verseOrgIds": [
              "MAT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe abobukaati, Isaya yalakula habwene khwinywe, ari",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.7",
            "verseOrgIds": [
              "MAT.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akoonooninjia omundo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.9",
            "verseOrgIds": [
              "MAT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalanga omukanda ewa yali, nabasunjila ari Hulile, mumanye neshisina shiene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.10",
            "verseOrgIds": [
              "MAT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shishili eshio eshiinjilanga mumunwa eshimwonoonoonia omundu ta; habula akarulanga mumunwa niko akamwonoonia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.11",
            "verseOrgIds": [
              "MAT.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.11",
            "verseOrgIds": [
              "MAT.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abeechi beene nibeetsa, nibamureeba bari Omanyile mbu abaFarisayo bahuchile olwa bahuliile lisungo elo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.12",
            "verseOrgIds": [
              "MAT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, naboola mbu Buli shiraache eshia Papa owomwikulu araraaka ta, shiakhasiulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.13",
            "verseOrgIds": [
              "MAT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lekha babe; nabeemilisi ababofu. Ne omubofu naba niyeemilila omubofu washie, balakwa bombi mubuko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.14",
            "verseOrgIds": [
              "MAT.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.14",
            "verseOrgIds": [
              "MAT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero nakalusia, namusunjila mbu Okhuboolele akoluchelo olwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.15",
            "verseOrgIds": [
              "MAT.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga ari Khane kata inywe mushileemile obumanyilisii? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.16",
            "verseOrgIds": [
              "MAT.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimumanyile mbu eshindu shiosi eshiinjila mumunwa shibira shitsia munda, nishirusibwa shitsia elwanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.17",
            "verseOrgIds": [
              "MAT.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne akeensko akarulanga mumunwa kabeetsanga nikarulile mumwoyo; nako niko akamwonooninjia omundu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.18",
            "verseOrgIds": [
              "MAT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila okhurula mumwoyo nimwo omwa murulanga amayililisio amabii, nobwiri, nobuheyi, nobusooti, nobwifi, nobuloli bwobubeeyi, nobuchiishi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.19",
            "verseOrgIds": [
              "MAT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakhuwa ako niko akamwonooninjia omumdu; nebutswa okhulia namakhono akarasaabilwe ta, okhwo shikhwonoonia omundu ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.20",
            "verseOrgIds": [
              "MAT.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusuubili bwomukhasi omuKanaanayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.20",
            "verseOrgIds": [
              "MAT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu narula ebweneyo niyeenyokha natsia mumbali tsieTiro nende Sidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.21",
            "verseOrgIds": [
              "MAT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne lola, omukhasi omuKananayo yarula mumbali etsio niyeetsa ewa yali, nalanga ari Umbeele tsimbabasi, E Omwami, omwana waDaudi; omwana wanje omukhaana anyasibungwa muno nende lidimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.22",
            "verseOrgIds": [
              "MAT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shiyamukalusia likhuwa ta. Abeechibe nibeetsa nibamusaaya, bari 'Museebule; okhuba alanjilisinjia munyuma weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.23",
            "verseOrgIds": [
              "MAT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, nasunga mbu Shindarumilwa abandi tawe, habula khumakondi akakora akomunzu yaIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.24",
            "verseOrgIds": [
              "MAT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omukhasi oyo niyeetsa namwinamila, naboola ari Omwami, ukhoonye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.25",
            "verseOrgIds": [
              "MAT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, ari Shineshilayi okhubukula omukaate kwabaana nokhusukunila tsimbwa u. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga ari Mbula, Omwami, kata tsimbwa tsiliitsanga khumbungulusi etsibungulukhanga nitsirula khumeesa yabeenetsio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yesu nakalusia, namusunjila mbu Mama, obusuubilibwo nobukhongo; kakhukholelwe shinga olwa wenya. Omukhaanawe nahona okhurula khushise eshio.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yahonia abanji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu narula ebweneyo niyoola ahambi khuNyanza yaGalilaya; natikulukha mushikulu, niyeekhalayo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.29",
            "verseOrgIds": [
              "MAT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana emikanda emikhongo nichiitsa ewa yali, nibali nende abetsindieku, nababofu, nabasilu, nabalema, nende abandi abanji, nibabakonia imbeliwe, naye nabahonia; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.30",
            "verseOrgIds": [
              "MAT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa abomukanda bachenya, olwa balola abasilu nibaboolanga, abalema nibeekaluule abalamba, abetsindieku nibachenda, nababofu nibalola; nibamwitsoomia Nyasaye waIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yaliisia abandu ebikhumila bine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.31",
            "verseOrgIds": [
              "MAT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nalanga abeechibe, naboola mbu Endiililwa omukanda kuno eshisa, shichila leela lukhola khataru nibabeetsanga ninasi nibarali nende eshia balia ta; shinzenya okhubaseebula nibali inzala tawe; haundi bakhahumbutsanila khunjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechi nibamukalusia bari Mushitsiimi muno khwakhanyoola heena emikaate eminji echihela okhubeekusia abomukanda omukhongo kuri? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nabareeba mbu Muli nemikaate chinga? Nibakalusia mbu Nimusaafu, khandi norunyeeni oruleemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababiila abomukanda mbu beekhale hasi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.35",
            "verseOrgIds": [
              "MAT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabukula emikaate echio musaafu nende tsinyeeni etsio, nakhupa orio nabisonyola nabakabila abeechi; abeechi nabo nibakabila abemikanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.36",
            "verseOrgIds": [
              "MAT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalia bosi, nibeekura; nibatoola ebisonye ebiatong'a, ebimwelo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.37",
            "verseOrgIds": [
              "MAT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalia bali abasaatsa ebikhumila bine, oburabala abakhasi kata abaana tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.38",
            "verseOrgIds": [
              "MAT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naseebula abemikanda, niyeenjila muliaro, niyoola mumbali tsiaMagadani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.39",
            "verseOrgIds": [
              "MAT.15.39"
            ]
          }
        }
      ]
    }
