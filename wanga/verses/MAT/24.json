{
  "id": "MAT.24",
  "number": "24",
  "bookId": "MAT",
  "reference": "Matsayo 24",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "MAT 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yaboola akokhukwisibwa khweihekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yesu narula muhekalu, nachaaka okhutsia; abeechibe nabo nibeetsa ewa yali okhumumanyia amoombakho keihekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.1",
            "verseOrgIds": [
              "MAT.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia nabasunjila ari Shimuluutsi ebindu bino biosi? Emuboolela toto mbu shililitong'aho lichina elala hekulu khulindi, eliralisukunwa hasi ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.2",
            "verseOrgIds": [
              "MAT.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eminyakhano nende obusandibwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.2",
            "verseOrgIds": [
              "MAT.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yali niyeekhaale khushikulu shiEmitseituni abeechi nibeetsa mabiswi nibamureeba bari Okhuboolelekhwo, amakhuwa ako kaliikhola liina? Kata neshilolelo shiina eshilimanyia okhwitsakhwo nende eshihesi shieshise shino?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.3",
            "verseOrgIds": [
              "MAT.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.3",
            "verseOrgIds": [
              "MAT.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu nakalusia nababoolela ari Mwirecheshe, omundu yesi aleshe okhumushiamia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.4",
            "verseOrgIds": [
              "MAT.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abanji bakheetsenje muliira lianje, nibaboola bari Nisie Kristo; nibabashiamia bario abanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.5",
            "verseOrgIds": [
              "MAT.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulahulilanga khukobusoolo nende amakhuwa kamahe; mwirecheshe muleshe okhuhenda; okhuba ako kakhoyile okhwikhola; ne obumaliilishi nibushili. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.6",
            "verseOrgIds": [
              "MAT.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lihanga lilabuushila khwihanga lindi, khandi oburuchi khuburuchi bundi; khandi inzala nende okhurenga khweshialo bilabaho eyi nende eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.7",
            "verseOrgIds": [
              "MAT.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ako kosi nokhuchaaka butswa khweinumwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.8",
            "verseOrgIds": [
              "MAT.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana balamukhobana mumatinyu, nibamwira; ne mulakiywa namahanga kosi khulwa eliira lianje. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.9",
            "verseOrgIds": [
              "MAT.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abanji baleesichirala, nibakhobana abeene nabeene, nende okhukiyana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.10",
            "verseOrgIds": [
              "MAT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abanabii bobubeeyi abanji balabuushilamwo, nibashiamia abanji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.11",
            "verseOrgIds": [
              "MAT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa okhumeetekha khwobumayaanu, obuheeli bwabanji bulanyira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.12",
            "verseOrgIds": [
              "MAT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa owifwila okhuula khushihesi, omwenoyo alahonibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.13",
            "verseOrgIds": [
              "MAT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne injiili yino yobwami yileelwatswa mubialo biosi, yibe oburumbusi khumahanga kosi; kho mana eshihesi shiliula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.14",
            "verseOrgIds": [
              "MAT.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akamasila amakali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.14",
            "verseOrgIds": [
              "MAT.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa mulola Eshisinyo Shiobwonooneshi owa omunabii Danieli yasungakhwo nasinjiile habundu hatakatifu (ousooma ayililisie bulayi) ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.15",
            "verseOrgIds": [
              "MAT.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana abali mubuYahudi beelushile mubikulu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.16",
            "verseOrgIds": [
              "MAT.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "noyo ouba nali hekulu khushilama shieinzuye aleshe okhwikha mbu ayinie ebindu ebiba nibili munzuye; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.17",
            "verseOrgIds": [
              "MAT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata ouba nali mumukunda arakalukha ingo okhubukula inguboye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.18",
            "verseOrgIds": [
              "MAT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woowe khubaliba nibabeleeshe nende khubaliba nibanuuninjia mundaalo etsio! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.19",
            "verseOrgIds": [
              "MAT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musaayenje mbu okhwilukha khweenywe khuleshe okhwikhola murootso, kata khusabato yosi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.20",
            "verseOrgIds": [
              "MAT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila habwenaho kalabaho amasila amakali akashili okhubaho kata okhurula khukhuchaaka khweshialo okhuula bulaano tawe, kata shikalibakhwoho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.21",
            "verseOrgIds": [
              "MAT.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo etsio tsilabula okhukhalakua, khane shiyakhahonile omundu kata mulala ta; nebutswa khulwa abalobole tsindaalo etsio tsiitsa okhukhalakwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.22",
            "verseOrgIds": [
              "MAT.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.22",
            "verseOrgIds": [
              "MAT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio omundu naba namusunjila ari Lole, Kristo ngwowuno; kata mbu Ngwowulia; murafuchiilila ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.23",
            "verseOrgIds": [
              "MAT.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila balibuukha abaKristo bobubeeyi, nabanabii bobubeeyi, nibalolosia ebilolelo ebikali nende akamakana, khulwa okhukosia kata abalobole, nikaba nikanyalikha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.24",
            "verseOrgIds": [
              "MAT.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, emubooleele khale. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.25",
            "verseOrgIds": [
              "MAT.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibaba nibamusunjila bari Lole, ali mushitsiimi; murarula tawe; bari Lole, ali munzu mukari; murafuchiilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.26",
            "verseOrgIds": [
              "MAT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shinga oluhenu olwa lurulanga ebukwe, nilulolekha kata okhuula mumbo, nolwa okhwitsa khwOmwana wOmundu khuliba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewa omulambo kuli, eyo niyo ewa tsingosia tsikhung'aanilanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwitsa khwOmwana womundu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne habwenaho, inyuma wamasila akomundaalo tsienetsio, omubasu kulikwa eshiilima, kata omwesi shikuliakhakhwo ta, tsinyininyini natsio tsiliakukha okhurula mwikulu, ebietsingufu ebiomwikulu nibitechesibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana eshilolelo shililolekha eshiOmwana wOmundu mwikulu; mana tsimbia tsiosi tsiabomushialo tsiliikhuula, ne balilola Omwana wOmundu niyeetsa mumaleesi akomwikulu nende obunyali noluyali olunji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.30",
            "verseOrgIds": [
              "MAT.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne aliruma abamalaikabe nende omwoyo omukhongo kwolwika, nabo balikhung'aasia abalobolebe okhurula ahemiyeka chiosi chine, okhurula khundulo welikulu eundi okhuula eundi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliechesio liomukhuyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano mweche oluchelo khumukhuyu; mbu olwa lisaka liakwo libeetsanga liakhakalukha libisi nilisebukha, habwenaho mumanyanga mbu tsindaalo tsiomubasu omunji tsili ahambi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "neenyu mwesi olwa mulola amakhuwa kano kosi, mumanye murio mbu ali ahambi, kata hamuliango bwene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela toto, mbu olwibulo luno shilulihwaho ta okhuula olwa kano kosi kaliba nikamalile okhuusibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likulu nende eshibala bilihwaho; ne amasungo kanje shikalihwaho ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abulaho oumanyilekhwo inyanga kata isaa ta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga yene kata isaa, abulaho oumanyilekhwo, kata abamalaika abomwikulu ta, kata Omwana, habula Samwana yenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga tsindaalo tsiaNoa olwa tsiali, nolwa okhwitsa khwOmwana wOmundu khulaba khurio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila shinga olwa bali nibaliitsanga nende okhunywa, nibateeshinjia nende okhuteeshibwa, mundaalo etsio Omuyembo nikurashiabaho ta, okhuula khunyanga eyo olwa Noa yeenjila musafina, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaramanya ta okhuula olwa Omuyembo kwoola nikubakholomosia bosi, nolwa okhwitsa khwOmwana wOmundu khulaba khurio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenafio babili balaba nibali mumukunda; mulala abukulwa, oundi nalekhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babili balaba nibasieetsanga khuluchina; mulala abukulwa, oundi nalekhwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mubeetsenje meeso, shichila shimumanyile neinyanga shi eya Omwami weenywe anyala okhwitsilakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumanye likhuwa lino, mbu khane omusaatsa omwenengo niyakhamanyile eshise shiene eshia omwibi ali okhwitsilamwo, khane yakhabeelenje meeso, narafuchiilila inzuye okhuyabwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana nineenywe mwesi murio, mwirecheshe; shichila khusaa eya murapaarakhwo ta, Omwana wOmundu yeetsa okhwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusumba omwisiikwa, nende ourali omwisiikwa ta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yakhaba wina omusumba omwisiikwa omuchesi, owa omwamiwe yamwemeeshe hekulu khubakholibe, mbu abakabilenje ebiliibwa khushise eshikhoyeele? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noweikhabi omusumba oyo, owa omwamiwe aleetsa nanyoola nakholanga ario. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emuboolela toto mbu alimwemekha hekulu khubiosi ebia ali ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusumba omubii oyo naba naboola mumwoyokwe ari Omwami wanje ashindile; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana nachaaka okhuupa abasumba bashie, nalia nanywa halala nende abameesi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwami womusumba oyo aleetsela khunyanga eya arapaarangakhwo ta, khandi khusaa eya aramanya ta, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "namukhalasia hakari ebitonye bibili, namukabila omukabokwe halala nabakaatii; ebweneyo khulabayo okhulila nokhulumaasia ameeno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.51",
            "verseOrgIds": [
              "MAT.24.51"
            ]
          }
        }
      ]
    }
  ],
