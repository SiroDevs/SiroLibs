          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwahuliile shinga olwa kasunjilwa abakhale, mbu Oreera ta; khandi mbu omundu yesi owira akwanile okhuyaasibwa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.21",
            "verseOrgIds": [
              "MAT.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi emusunjila mbu buli mundu yesi outiililwa owashie oburima akwanile okhuyaasibwa; khandi mbu omundu yesi ousunjila owashie mbu Oli omusilu, akwanile eshiina, ne omundu yesi ousunjila owashie mbu Oli eshiyingwa, akwanile Gehena yomulilo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.22",
            "verseOrgIds": [
              "MAT.5.22"
            ]
          }
        }
      ]
