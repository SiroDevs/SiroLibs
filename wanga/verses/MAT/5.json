          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, mwahuliile shinga olwa kasunjilwa abakhale mbu Oreetsuba akobubeeyi ta, ne mbu wusilie Omwami akebiitsubobio; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.33",
            "verseOrgIds": [
              "MAT.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi emusunjila mbu mureetsubakhwo ta, kata khwikulu, shichila nilio eshifumbi shiaNyasaye; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.34",
            "verseOrgIds": [
              "MAT.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
