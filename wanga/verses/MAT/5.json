          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi kasungwa mbu Omundu yesi owilisia omukhasiwe, amuheelesie lihandiiko liobukabukhani, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.31",
            "verseOrgIds": [
              "MAT.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi emusunjila mbu omundu yesi owilusia omukhasiwe, habula khulwa obuheyi, amukhola ario okhuba omuheyi; ne omundu yesi oumuteeshia olwa aba niyeelusiibwe ario, yesi aheya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.32",
            "verseOrgIds": [
              "MAT.5.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yesu yeechesia kukebiitsubo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
