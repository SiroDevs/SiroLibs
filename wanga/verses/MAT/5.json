          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata imoniyo isaatsa niyiba niyikhwisichirasinjia, ochitsomole, ochisukune ehale; shichila shiakhakhukaasila mbu eshiungoshio shiala shitibe, omubilikwo kwosi nikurasukunwa muGehena ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.29",
            "verseOrgIds": [
              "MAT.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
