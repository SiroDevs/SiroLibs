          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuchilisania bwangu nende oukhwinjilila itookho, nimushili ninaye khunjila; oukhwinjilila aleshe okhukhuhaana mumukhono kwomuyaasii, omuyaasii naye nakhuhaana mumukhono kwomusikari, nawe nosukunwa mumbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.25",
            "verseOrgIds": [
              "MAT.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhuboolela toto mbu shiolirulakhwomwo khandi ta, okhuula olwa oba nomalile okhurunga isende yene eyihelesia.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        }
      ]
