          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata khushibala, shichila nishio eshia alambisinjiakhwo ebilenje; kata khuYerusalemu, shichila nilio litookho liOmuruchi omukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.35",
            "verseOrgIds": [
              "MAT.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata oreetsuba khumurwekwo ta, shichila shionyala okhukalula olwoya kata lulala lube olulafu kata olumali ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.36",
            "verseOrgIds": [
              "MAT.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa amasungo keenwye kabeetsenje mbu Ee, Ee; khandi mbu Tawe, tawe; ne liosi elishila ako neliobumayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
              "MAT.5.37"
            ]
          }
        }
      ]
    },
