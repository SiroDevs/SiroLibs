          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi emusunjila mbu buli mundu yesi ouhenjelesia omukhasi khulwa okhumwikomba, abeetsanga namalile okhuheya ninaye mumwoyokwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        }
