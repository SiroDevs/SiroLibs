          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhonokwo musaatsa nikuba nikukhwisichirasinjia, okureme okusukune ehale; shichila shiakhakhukaasila mbu eshiungoshio shilala shitibe, omubilikwo kwosi nikuratsia mu Gehena ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.30",
            "verseOrgIds": [
              "MAT.5.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yesu yeechesia khukokhulekhana khwomusaatsa nomukhasiwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
