          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabeikhabi abamanani mumwoyo, shichila obwami obwomwikulu nobwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.3",
            "verseOrgIds": [
              "MAT.5.3"
