              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabeikhabi abali neinzala nibaliibwa obuloho bwobuluniishi; shichila baleekusibwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.6",
            "verseOrgIds": [
