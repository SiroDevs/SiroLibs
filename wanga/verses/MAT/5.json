          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, noba noleera eshihaanwashio khushimalilo shuemisango, mana niwitsulilayo mbu owashio ali nende likhuwa khwiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.23",
            "verseOrgIds": [
              "MAT.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "lekhaho eshihaanwashio imbeli weshimalilo shiemisango, otsie butsia, osaasanibwe nende owashio mbeli, kho mana witse oleere eshihaanwashio.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.24",
            "verseOrgIds": [
              "MAT.5.24"
            ]
          }
        }
      ]
