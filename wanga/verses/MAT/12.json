{
  "id": "MAT.12",
  "number": "12",
  "bookId": "MAT",
  "reference": "Matsayo 12",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MAT 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abeechi bakhuunuula ingano khuSabato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio Yesu yarula khunyanga yaSabato nabira mundalo tsieingano; inzala niyiluma abeechibe, nibachaaka okhukhuunuula ingano nibahululila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abaFarisayo balola, bamusunjila bari Lola, abeechibo bakhola akali omusilo okhukhola khusabato. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia ari Shimwasooma aka Daudi yakhola, olwa yali nali inzala halala naba yali ninabo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.3",
            "verseOrgIds": [
              "MAT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbu yeenjila munzu yaNyasaye nalia Emikaate chiOkhubaho echili omusilo ye okhuchiliakhwo, kata aba yali ninabo, habula abakuhani bonyene? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.4",
            "verseOrgIds": [
              "MAT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shimwasoomakhwo mumalako mbu khunyanga yaSabato abakuhani abali muhekalu boonooninjia isabato, nibarabakhwo neshikha ta? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.5",
            "verseOrgIds": [
              "MAT.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi emuboolela mbu aliho hano oushila ihekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.6",
            "verseOrgIds": [
              "MAT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulaba nimwakhamanyile eshisina shielikhuwa lino, mbu Enzenyanga tsimbabasi, emisango ta, shimwakhabakhalachiile eshiina ababula eshikha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.7",
            "verseOrgIds": [
              "MAT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Omwana wOmundu niye Omwami waSabato.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omundu owomukhono okwanyela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.8",
            "verseOrgIds": [
              "MAT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narulayo, niyeenjila musinagogi yabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.9",
            "verseOrgIds": [
              "MAT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne lola, yalimwo omundu owomukhono okwanyela. Nibamureeba bari Kafuchiililwa okhuhonia khuSabato, noho? Mbu kho bamwinjilile itookho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.10",
            "verseOrgIds": [
              "MAT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabareeba ari Ali heena omundu khwinywe ouba nali nelikondi elala, nalio nilikwile mubuko khunyanga yaSabato, ne naralitiilakhwo waliyiniamwo! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu shiashila likondi muno! Kho kafuchiililwa okhukhola amalayi khuSabato. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.12",
            "verseOrgIds": [
              "MAT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nasunjila omundu oyo mbu Kololosia omukhonokwo. Nakukololosia; nikukalukha habwene omulamba, shinga okundi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusumba omulobole",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaFarisayo nibarula, nibamusanjila okhukhaaba shinga olwa nabanyale okhumwira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Yesu yalola ario yarulaho, abandu abanji nibalondana ninaye, nabahonia bosi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.15",
            "verseOrgIds": [
              "MAT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabachesiyia mbu baleshe okhumubuula; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.16",
            "verseOrgIds": [
              "MAT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana akaboolwa mumunwa kwaIsaya omunabii koosibwe; mbu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.17",
            "verseOrgIds": [
              "MAT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu nende Beelezebuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.21",
            "verseOrgIds": [
              "MAT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yaleerelwa oundi owali nelidimoni, nali omubofu khandi omusilu; naye namuhonia, okhuula olwa omusilu yaboola nalola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.22",
            "verseOrgIds": [
              "MAT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abemikanda bosi nibang'ang'aala, nibaboola bari Uno yakhaba omwana waDaudi noho? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.23",
            "verseOrgIds": [
              "MAT.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa aibaFarisayo bahulilakhwo basunga mbu Omundu uno shiarusinjia amadimoni butswa ta, habula khulwa obunyali bwaBeelezebuli, omwami wamadimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yamanya amapaaro kabwe, nabasunjila ari Buli buruchi obubeetsanga nibwahukhaane obwene khubwene, bukwitsanga amakunda; khandi buli litaala kata buli inzu ebibee-tsanga nibiahukhaane ebiene khubiene, shibilasinjila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.25",
            "verseOrgIds": [
              "MAT.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata Setani naba narusia Setani, abeetsanga niyaahukhaane e-mwene khumwene; kho oburuchibwe bulanyala burie okhusinjila? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.26",
            "verseOrgIds": [
              "MAT.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isie nimba nirusinjia amadimoni khulwa obunyali bwaBeelezebuli, kho abaana beenywe bakarusinjia khulwa obunyali bwawina? Khulwako bo balamukabukhasilia amakhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.27",
            "verseOrgIds": [
              "MAT.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isie nimba nirusinjia amadimoni khulwa Roho waNyasaye, kho obwami bwaNyasaye bumuuliilekhwo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.28",
            "verseOrgIds": [
              "MAT.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu anyala arie okhwinjila munzu yomundu wamaani, ayaaye emianduchie, habula naranjiliile okhumuboha omundu oyo wamaani; nilwo olwa ayaaya inzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.29",
            "verseOrgIds": [
              "MAT.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouraba ninasi halala ta, yafukulanga; nourakhung'aasia ninasi ta, asalaasinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.30",
            "verseOrgIds": [
              "MAT.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nimuboolela, mbu abandu balaleshelungwa buli shionoono nende buli linyeko eliokhunyeka Nyasaye; ne okhunyeka Roho, shikhulaleshelwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.31",
            "verseOrgIds": [
              "MAT.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi ouboola likhuwa nafukula Omwana wOmundu, alaleshelwa; ne ouboola likhuwa nafukula Roho Omutakatifu, shialaleshelwa ta, kata mushise shino, kata mushilia eshiitsanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omusaala nebiamo biakwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.32",
            "verseOrgIds": [
              "MAT.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukule omusaala okuli omulayi, ebiamo biakwo bilaba ebilayi; kata mbu mubukule omusaala okuli omubii, nende ebiamo biakwo nabio bilaba ebibii; shichila omusaala kumanyishilanga khubiamo biakwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.33",
            "verseOrgIds": [
              "MAT.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe olwibulo Iwetsinzokha, olwa muli ababii murio, munyala murie okhuboola amakhuwa amalayi? Okhuba khulwa obunji obwomumwoyo omunwa kuboolanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.34",
            "verseOrgIds": [
              "MAT.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu omulayi okhurula mwibiikholie lilayi arusinjiamwo ebindu ebilayi; noyo omundu omubii okhurula mwibiikholie libii arusinjiamwo ebindu ebibii.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.35",
            "verseOrgIds": [
              "MAT.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi emusunjila mbu buli likhuwa likhaya liosi elia abandu balaboolanga, balikalusia khunduukho yeshiina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.36",
            "verseOrgIds": [
              "MAT.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila khulwa amakhuwa aka oboola olabasilibwakhwo obulunjishi, khandi khulwa amakhuwa aka oboola olakhalachilwa eshiina.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwibulo olumayaanu olwenya eshilolelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.37",
            "verseOrgIds": [
              "MAT.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandi khubahandiichi nabaFarisayo nibakalusia nibamusunjila bari Omwechesia, khwenya okhulola eshilolelo khwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.38",
            "verseOrgIds": [
              "MAT.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakalusia, nababoolela mbu Olwibulo olumayaanu olubula obwisiikwa Iwenyanga eshilolelo; ne shilulaheebwakhwo eshilolelo shiosi ta, habula eshilolelo shiaYona omunabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.39",
            "verseOrgIds": [
              "MAT.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga Yona olwa yali munda yokunyeeni tsindaalo tsitaru eshiteere neshilo, nolwa Omwana wOmundu alaba munda yeliloba tsindaalo tsitaru, eshiteere neshilo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.40",
            "verseOrgIds": [
              "MAT.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Ninewe balisinjila mumuse halala nende abolwibulo luno, nibalukhalachila eshiina; shichila bo beekalukhasilia obwilwatsii bwaYona; ne lole, oushila Yona ali hano. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.41",
            "verseOrgIds": [
              "MAT.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi omukhasi oyo owesautsi alibuukha mumuse halala nende abolwibulo luno, nalukhalachila eshiina; shichila ye yarula khundulo weshibala okhuhulila obuchesi bwaSulemani; ne lole, oushila Sulemani ali hano.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukalukha khwaroho weshifwabwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.42",
            "verseOrgIds": [
              "MAT.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne roho weshifwabwi olwa aba narulile mumundu, abiranga aha amatsi kabula, nakhaaba aha ahuluushila, naranyoola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.43",
            "verseOrgIds": [
              "MAT.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amala aboole ari Lekha engalushe munzu yanje omwa ndarula; nolwa yoolamwo, anyoola niyili ikhaya, niyelilwe niying'oonilwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.44",
            "verseOrgIds": [
              "MAT.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana atsia yeenda abaroho bandi musaafu abamushila obubii; beenjila bamenyamwo; mana obumaliilishi bwomundu oyo buba obubii okhushila shinga olwa yabeelenje; nolwa kaliba kario khulwibulo luno olumayaanu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
              "MAT.12.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyina Yesu, nende abaana babwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.45",
            "verseOrgIds": [
              "MAT.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nashisunjilanga abemikanda amakhuwa, lola, nyina nende abaana babwe bali nibasinjiile elwanyi, nibeenya okhusungana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.46",
            "verseOrgIds": [
              "MAT.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oundi namuboolela ari Lola, mawo nende abaana beenywe basinjiile elwanyi; beenyanga okhusungana ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.47",
            "verseOrgIds": [
              "MAT.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakalusia nasunjila owamuboolela ari Mama niwina? Kata abaana beefwe nibeena? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.48",
            "verseOrgIds": [
              "MAT.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanyiila omukhono, namanyia ewa abeechibe bali, nasunga mbu Mama nende abaana beefwe mbabano! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.49",
            "verseOrgIds": [
              "MAT.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi oukhola aka Papa ouli mwikulu yeenya, omwenoyo niye omusiani weefwe, khandi omukhaana weefwe, khandi mama.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.50",
            "verseOrgIds": [
              "MAT.12.50"
            ]
          }
        }
      ]
    }
  ],
