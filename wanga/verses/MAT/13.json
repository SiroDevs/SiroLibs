          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yaseebulana nabemikanda niyeenjila munzuabeechibe nibeetsa ewa yali, nibasunga bari Okhwinoosie eshisina shioluchelo Iwelibanze eliomumukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.36",
            "verseOrgIds": [
              "MAT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, naboola mbu Oumiitsa imwo indayi niye Omwana wOmundu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.37",
            "verseOrgIds": [
              "MAT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukunda nikwo eshialo shiosi; imwo indayi nibo abaana bobwami; libanze nibo abaana bomumayaanu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.38",
            "verseOrgIds": [
              "MAT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne omusuku owalmmiitsa niye Setani; lichesa nishio eshihesi shieshise shino; nabachesi nibo abamalaika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.39",
            "verseOrgIds": [
              "MAT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho shinga libanze olwa lihkung'sasibwa nilisambwa nomulilo, nindio kaliba kario khushihesi shieshise shino. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.40",
            "verseOrgIds": [
              "MAT.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana wOmundu aliruma abamalaikabe, nabo balikhung'aasia ebiisichirasio biosi, nende abo abakholanga obumayaanu, nibabirusia mubwamibwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.41",
            "verseOrgIds": [
              "MAT.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabisukuna mumulilo okufwana shinga okwelirumti; ebweneyo khulibayo okhulila nokhulumaasia ameeno. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.42",
            "verseOrgIds": [
              "MAT.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho abalunjishi baliakha shinga eliuba mubwami bwaSabwe Ouli namarwi ahulile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.43",
            "verseOrgIds": [
              "MAT.13.43"
            ]
          }
        }
