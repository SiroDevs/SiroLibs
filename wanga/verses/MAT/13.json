              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako kosi Yesu yababoolelanga abemikanda munjelo; nebutswa harali oluchelo shiyabasunjila likhuwa liosi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.34",
