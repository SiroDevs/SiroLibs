          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana akaboolwa mumunwa kwomunabii koosibwe, mbu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.35",
            "verseOrgIds": [
              "MAT.13.35"
            ]
