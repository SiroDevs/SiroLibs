          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa lwali nilwitsuule, balukhwesa khulukuku; nibeekhala nibakhung'aasia tsindayi mubichinjilo, habula tsimbii batsisukuna. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.48",
