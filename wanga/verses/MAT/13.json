              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, obwami obwomwikulu bufwana shinga omundu weinganga oukhaabanga tsilulu tsindayi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.45",
