          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, obwami obwomwikulu bufwana shinga olukhanda olwafuubwa munyanza, nilukhung'aasia etsietsimbia tsiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.47",
