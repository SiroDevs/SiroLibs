          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabasukuna mumulilo okufwana shinga okwelirumbi; ebweneyo khulibayo okhulila nokhulumaasia ameeno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.50",
            "verseOrgIds": [
              "MAT.13.50"
            ]
          }
        }
