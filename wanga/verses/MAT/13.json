          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhuliile amakhuwa kano kosi? Nibamukalusia bari Ee, khuhuliile. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.51",
            "verseOrgIds": [
              "MAT.13.51"
            ]
          }
