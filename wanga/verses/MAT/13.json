              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa yanyoola ilulu ndala yobukusi obunji muno, yatsia nakulaasia ebia yali ninabio amapeesa, nachikula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.46",
