          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa kaliba kario khushihesi shieshise shino; abamalaika balirula nibeela ababii okhurula mubalunjishi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.49",
            "verseOrgIds": [
