            "number": "52",
            "style": "v",
            "sid": "MAT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela mbu Niko akachila buli muhandiichi oweechesiibwe amakhuwa kobwami obwomwikulu afwana shinga omundu omwenengo ourusinjia mumabiikhoke ebmdu ebiyia nende ebikhulu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.52",
