          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Yesu yali namalile tsinjelo etsio yarulaho natsia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.53",
            "verseOrgIds": [
              "MAT.13.53"
            ]
          }
        },
        {
          "name": "verse",
