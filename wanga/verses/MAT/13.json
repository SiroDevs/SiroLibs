{
  "id": "MAT.13",
  "number": "13",
  "bookId": "MAT",
  "reference": "Matsayo 13",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MAT 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo Iwomumiitsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyanga eyo Yesu yarula munzu niyeekhala khulukuku lweinyanza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.1",
            "verseOrgIds": [
              "MAT.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikanda emikhongo chiakhung'aana ewa yali, okhuula niyeenjila muliaro niyeekhalamwo; abomukanda niba sinjiile khulukuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.2",
            "verseOrgIds": [
              "MAT.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela amakhuwa amanji munjelo, nasunga ari Lole, omumiitsi yarula natsia okhumiitsa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.3",
            "verseOrgIds": [
              "MAT.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa yali namiitsanga, imwo yindi yakwa khunjila, amanyonyi nikeetsa nikachibootsa; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.4",
            "verseOrgIds": [
              "MAT.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyindi niyikwa hanyanda, niyiraba neliloba elihela ta, niyimela bwangu, shichila liloba shiliatsia hasi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.5",
            "verseOrgIds": [
              "MAT.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa omubasu kwabala, niyifululukha, niyiniala, shichila yabula emisi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.6",
            "verseOrgIds": [
              "MAT.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyindi niyikwa habisisia; ebisisia nabio nibikhula, nibichitiya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.7",
            "verseOrgIds": [
              "MAT.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyindi niyikwa mwiloba lilayi, niyama, eyindi eshikhumi, eyindi amakhumi kasasaba, eyindi amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.8",
            "verseOrgIds": [
              "MAT.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ouli namarwi, ahulile.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka tsinjelo tsichoomakhwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.9",
            "verseOrgIds": [
              "MAT.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibeetsa, nibamureeba bari Eshichilanga nobaboolela munjelo nishiina? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.10",
            "verseOrgIds": [
              "MAT.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakalusia nababoolela mbu Inywe mwaheebwa okhumanya amabiso akobwami bwomwikulu, ne bo shibaheebwa bario ta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.11",
            "verseOrgIds": [
              "MAT.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila omundu yesi oulikhwo nebindu, alaheebwa ebindi, abe ninabio ebinji; ne omundu yesi oubula ninabio, kata ebia ali ninabio bilabukulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.12",
            "verseOrgIds": [
              "MAT.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachilanga nimbaboolela munjelo; shichila bahenganga, ne shibalola ta; bahulilanga, ne shibahulila ta, kata okhutiila khushisina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.13",
            "verseOrgIds": [
              "MAT.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obulakusi bwaIsaya buboosiliibwe, mbu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.14",
            "verseOrgIds": [
              "MAT.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.15",
            "verseOrgIds": [
              "MAT.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne netsieikhabi tsimoni tsieenywe, okhuba tsilolanga; nende amarwi keenywe, okhuba kahulilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.16",
            "verseOrgIds": [
              "MAT.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba emuboolela toto mbu abanabii abanji nende abandu abalunjishi abanji bali nibeekombanga okhulola ebia mulolanga inywe, nibarabilola ta; nokhuhulila aka muhulilanga inywe, nibarakahulila ta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yeenoosia oluchelo Iwomumiitsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.17",
            "verseOrgIds": [
              "MAT.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hulile oluchelo Iwomumiitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.18",
            "verseOrgIds": [
              "MAT.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omundu yesi ahulila likhuwa liobwami, naratiila khushisina ta, habwenaho omubii oyo yeetsa niyeetsumba eyeneyo eyali niyimiitsilwe mumwoyokwe. Eyo niyo eyamiitswa khunjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.19",
            "verseOrgIds": [
              "MAT.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyo eyamiitswa hanyanda, neniye ouhulila likhuwa, ne habwenaho alifuchiilila nobusangaali; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.20",
            "verseOrgIds": [
              "MAT.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa abulanga emisi mumwoyo; ne atsiililila eshise eshituutu butswa, ne olwa amasila kata obusandibwi biitsanga khulwa likhuwa tsana, habwenaho akalukha inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.21",
            "verseOrgIds": [
              "MAT.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyo eyamiitswa mubisisia, neniye ouhulila likhuwa, nebutswa ebiamaramba biosi ebiomushialo shino, nobukaati bwobuyinda, bitiya likhuwa; nayo niyikumbahala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.22",
            "verseOrgIds": [
              "MAT.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyo eyamiitswa mwiloba lilayi, neniye ouhulila likhuwa, natiila khushisina; omwenoyo yaamanga toto, naleera haundi eshikhumi, haundi amakhumi kasasaba, haundi amakhumi kataru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Libanze hakari mungano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.23",
            "verseOrgIds": [
              "MAT.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabachelela oluchelo lundi, naboola mbu Obwami obwomwikulu buchelasibwa nende omundu owamiitsa imwo indayi mumukundakwe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.24",
            "verseOrgIds": [
              "MAT.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa abandu bali mundoolo, omusukuwe niyeetsa namiitsa libanze hakari munganoye, niyeenyokha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.25",
            "verseOrgIds": [
              "MAT.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa ingano yamela, mana niyitsomola, kho libanze nalio nililolekha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.26",
            "verseOrgIds": [
              "MAT.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasumba bomwenengo nibeetsa nibamureeba bari Omwami, shiwamiitsa imwo indayi mumukundakwo? Ne libanze lino liarula heena? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.27",
            "verseOrgIds": [
              "MAT.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabasunjila mbu Omundu omusuku niye owakhola lino. Abasumba nibamureeba bari Kho wenya mbu khutsie khulikhung'aasie? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.28",
            "verseOrgIds": [
              "MAT.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakaana, mbu Tawe; olwa mbu nimukhung'aasia libanze, mwakheetsukhana nimwiha ingano halala ninalio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.29",
            "verseOrgIds": [
              "MAT.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leshe bikhulile biosi halala okhuula khwichesa; mana khunduukho yelichesa ndilibiila abachesi, mbu Ranjilile mukhung'aasie libanze, mulibohe tsing'anda mulisambe; ne ingano muchikhung'aasie mushiachi shianje.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.13.30",
            "verseOrgIds": [
              "MAT.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluchelo Iwolufwa Iwelisaatsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
