    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lishiesio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "3JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyirula khumukofu, yule khuGayo omuheelwa, owa eheelanga mubwatoto.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "3JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "3JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelwa wanje, ekhusaayila mbu mukosi okaasenje noba omulamu, shinga omwoyokwo nakwo olwa kukaasanga. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.2",
            "verseOrgIds": [
              "3JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "3JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeekhoya muno abaana beefwe olwa beetsa nibarumbula akobuloli khubwatotobwo, shinga olwa ochendanga mubwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.3",
            "verseOrgIds": [
              "3JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shindi nomwikhoyo khundi okushila kuno ta, mbu okhuhulila akabaane banje shinga olwa bachendanga mubwatoto.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Gayo akholelanga abacheni kapaakwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "3JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelwa wanje, obeetsanga omwisiikwa mukosi aka obakholelanga abaana beefwe nende abacheni bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.5",
            "verseOrgIds": [
              "3JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "3JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barumbuule akobuheelibwo imbeli wabeikanisa. Ne chama oboongule khuluchendo lwabwe shinga olwa kakhoyeele imbeli waNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.6",
            "verseOrgIds": [
              "3JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "3JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila khulwa Eliira elo barula nibarabukula eshindu shiosi khuBamahanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.7",
            "verseOrgIds": [
              "3JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khukhoyile okhwinjisia abafwana bario, nikhusanjilana ninabo okhukhalabanila obwatoto.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obufukuli bwaDioterefe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "3JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndahandiichila ikanisa; ne Dioterefe, owenyanga muno okhuba owambeli mubo, shiakhufuchiilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.9",
            "verseOrgIds": [
              "3JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nimba ninzitsa ndalaboola khukebikholebie ebia akholanga, nasindobokha niyeelakalakania nakhufukula namakhuwa amamayaanu. Kata ako shikamuhela ta; mbu ye omwene shiyeenjisinjia abaana beefwe ta, ne abeenya okhubeenjisia abakaaninjia, nabeelusia mukanisa.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ifuma indayi yaDemeterio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "3JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelwa wanje, oralonda ikhola imbii ta, habula indayi. Oukhola amalayi nowaNyasaye; oukhola amabii shiyamulolakhwo Nyasaye ta.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "3JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Demeterio ali neifuma indayi khubandu bosi, khandi khubwatoto bwene; kata fwesi khurumbula khurio; ne omanyile mbu oburumbusi bweefwe nobwatoto.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amashiesio akahelelesia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "3JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embeele namakhuwa amanji okhukhuhandiichila; ne shinjamile okhukhuhandiichila ako kosi neikalamu nobwino ta. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne enaayanga okhulolana ninawe mundaalo etsili ahambi, mana khulasungana mumoni khumoni. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "3JN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulembe kube khwiwe. Abeetsa beefwe bakhushiesiye. Shiesia abeetsa, buli mundu neliiralie.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
      ]
    }
  ],
