          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuuka beefwe bali nende liheema lioburumbusi mushitsiimi, shinga owasungana nende Musa olwa yalachilisia, mbu alikhole shinga omufwano okwa yali naluutsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.44",
            "verseOrgIds": [
              "ACT.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuuka beefwe nabo balilaamilwa nibaliinjisia halala nende Yoswa olwa balia obulaame bwamahanga aka Nyasaye yeelusia imbeli wabakuuka beefwe okhuula khundaalo tsiaDaudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.45",
            "verseOrgIds": [
              "ACT.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "ACT 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yachamwa nende Nyasaye, mana nasaba mbu amunyoolele Nyasaye waYakobo eshimenyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.46",
            "verseOrgIds": [
              "ACT.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sulemani yamuumbashila inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.47",
            "verseOrgIds": [
              "ACT.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "ACT 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Oyo Ouli Ikulu Muno shiamenyanga munzu etsioombakhwa namakhono ta; shinga omunabii olwa yaboola, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.48",
            "verseOrgIds": [
              "ACT.7.48"
            ]
          }
        },
