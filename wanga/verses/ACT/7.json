              "ACT.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa emiyika amakhumi kane chiali nichihweele, malaika yamuloleshela mushitsiimi shieshikulu shiaSinai mulumemu Iwomulilo mushitsakha shindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.30",
            "verseOrgIds": [
              "ACT.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Musa yalulola, yachenyela eshilolelo eshio; ne olwa yasita ahambi okhuhenga, omwoyo kwOmwami nikumwitsila, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.31",
            "verseOrgIds": [
              "ACT.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuri Isie nisie Nyasaye wabakuukabo, Nyasaye waAburahamu, naIsaka, nende Yakobo. Musa natechela, kata shiyatsaalikha okhuhengakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.32",
            "verseOrgIds": [
              "ACT.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami namusunjila ari Wifwalule ebilaaro mubilenjebio, okhuba liloba elia osinjiilekhwo nahabundu hobutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.33",
            "verseOrgIds": [
              "ACT.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, ndaluutsinji okhumiinwa khwabandu banje abali eMisiri, khandi embuliile okhubinda khwabwe, ne enzishile okhubahabina; kho bulaano yitsa, ekhurume eMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.34",
            "verseOrgIds": [
              "ACT.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
