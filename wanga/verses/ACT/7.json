          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abakuuka beefwe bakhaya okhumuhuila, nibamusindikha ehale, ne mumioyo chiabwe bakalukha eMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.39",
            "verseOrgIds": [
              "ACT.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibasunjila Haruni bari Okhukholele abanyasaye bakhwimilile; shichila Musa oyo, owakhwimilila nakhurusia mushialo shiaMisiri, shikhumanyile akamwikholilekhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.40",
            "verseOrgIds": [
              "ACT.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibakhola eshimoosi mundaalo etsio, nibaleerela eshifwanani tsana omusango, nibeekhoyela emilimo chiamakhono kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.41",
            "verseOrgIds": [
              "ACT.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye yabafutarila, nabalekha bakhalabanile amahe kelikulu; shinga olwa kahandiikwa mushitabu shiabanabii, mbu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.42",
            "verseOrgIds": [
              "ACT.7.42"
            ]
          }
        }
      ]
    },
    {
