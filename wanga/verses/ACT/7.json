        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.7.34",
            "verseOrgIds": [
              "ACT.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
