      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yabuusia oluchendo Iwokhutsiila muliaro eRoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa kakasibwa mbu khutsiile muliaro ebuItalia, bahaana Paulo nende ababohe bandi mumakhono komuseesia oweliira mbu Juliasi, oweing'anda yaAugusito. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhuniina muliaro lindi lieAdiramitio, eliali nilili okhutsia khumataala akali khulukuku lwaAsia, nikhuchaaka oluchendo; nikhuli nende Arisitariko, omuMakedonia weTsesalonika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba nikhuula eSidoni; naye Juliasi yamukholela Paulo akeshisa, namuheelesia omunwa okhutsia ewabeetsabe, bamukhoonye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhurulayo, nikhubirila elubeka IweKipiro mbu khwishinje khumuyeka, shichila kwali nikurulanga imbeli weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhubirile khunyanza eyirondokhana nende Kilikia nende Pamufilia, khwoola eMira, litaala lindi lieLikia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebweneyo omuseesia yanyoola eliaro lieAlekisanderia nilitsia ebuItalia; nakhuniiniamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhuchendile kahala tsindaalo tsinyinji, nikhuula ahambi nende Nido khulwa okhutiika khubutinyu bwoluchendo; mana okhuba omuyeka kwakhukaya, khwabirila elubeka IweKirete, mbu khwishinje khumuyeka, nikhuhengana nende Salumone; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhutiika nikhutsiililila khurio nikhulondoola khulukuku lwashio okhuula habundu ahalangwa mbu Obukobelo Obulayi; ne ahambi nende ebweneyo lialiho litaala liLasea.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa tsindaalo tsiali nitsihweele tsinyinji, khulwa obubii bwoluchendo obwali imbeli, shichila tsindaalo etsiokhuhonjelamwo inzala tsiali nitsimalile okhubira, Paulo yabachesiyia, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabasunjila ari Abasaatsa abashianje, enduutsi mbu oluchendo luno Iwitsa okhuba nobusaalili nende okhufwilwa oburali khumisiiko nende eliaro bionyene ta, habula nende khubulamu bweefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omuseesia yahulila akomwene eliaro nende omukhulundu walio okhushila akeenako aka Paulo yaboola. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba obukobelo obwo shibwakaasanga okhwikhalamwo mumiesi chiosi chiomunyiri ta, abanji khubo bakhuchesiyia mbu khurule yaho, khuule eFoinikise nikaba nikanyalikha, khwikhaleyo mumiesi chiomunyiri; nibwo obukobelo bundi bweKirete, okuhenjile mumbo ahambi khunotsi okhuula ahambi khusautsi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imbumbuyeka khunyanza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa omuyeka okurula esautsi kwahuutsa kahala bakaala mbu banyoolile eshia bali nibeenyile, nibeeha eshiralisio nibachaaka khandi okhuchendela muliaro nibalondoola ahambi khulukuku IweKirete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyuma Iweshise eshitiiti butswa, omuyeka kweimbumbuyeka okulangwa mbu Eurakilo kwahuutsa okhurulayo nikukhuupa; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa eliaro liatiilwa, niliranyala okhuchooma omuyeka aha kurula ta, khwalekha okhuluumana ninakwo, nikhwilusibwa bwilusibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nikhwilukhanga khurio nikhushingungwa neshikhalachinga eshituutu eshilangwa mbu Kauda, khwatiika nikhumala nikhutiila akhaaro kheefwe; ne khwali okhutinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibakhakhwesile nibakharusia mumatsi babukula ebiokhwikhoonyela, nibabisilia emikoye hasi weliaro nibaboha khulwa okhulitinyisia; ne shichila bariitsanga mbu bakheetiya khumuyeshe ahalangwa mbu Siruti, beesia ebiokhuchesilia, nibeelukha butswa bario. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwali nikhunyakhananga muno khulwa imbumbuyeka, mukamba bachaaka okhusukuna emisiiko mumatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khunyanga yakhataru, abeene namakhono kabwe bafuuba ebimanulwa bindi ebiomuliaro mumatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata eliuba kata tsinyininyini shibiakhuloleshela mundaalo tsinyinji ta, khandi imbumbuyeka ikhongo yakhufwimba; kho obunaayi bwosi bwokhuhonibwa bwakhurulakhwo pe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibahonjile inzala eshise eshirambi, Paulo yasinjila hakari mubo nasunga mbu Abasaatsa abashianje, mwali nimukhoyile okhumbulila, oburarula eKirete nikhunyoola okhusaalila khuno nokhufwilwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa bulaano emuchesiyia mbu muume tsikholo; okhuba omundu yesi mwinywe shiyeetsa okhufwa ta, habula eliaro lionyene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila mushilo shino malaika waNyasaye omwenoyo owa endi owuwe, khandi owa ekhalabanilanga, asitile ahambi ninasi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasunga mbu Paulo, oraria ta; okhoyile okhusinjila imbeli waKaisari; ne lola, Nyasaye akhuheele abo bosi aba ochendanga ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, abashianje, muume tsikholo; okhuba esuubilanga Nyasaye, mbu kalaba kario shinga olwa embooleelwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula mbu khukhoyile okhwikhupa khushikhalachinga shindi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa eshilo shioola shielikhumi nakhane, nikhuyuyungwa eyi nende eyi khunyanza yaAdiria, mushilo hakari abakholi abomuliaro bapaara mbu bakhaba nibasitanga ahambi nende eshialo shindi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibeesia omukoye mumatsi okhuchela, nibanyoola mbu netsifuti eshikhumi namakhumi kabili; olunyuma Iweshise eshitiiti nibachela khandi, nibanyoola tsifuti amakhumi shienda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaria mbu khwakheekhupa khutsinyanda; kho nibeesia ebiralisio bine mumatsi inyuma weliaro, nibasaba mbu bushie. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba abakholi abomuliaro bali nibeenya okhwilukha eliaro, ne bali nibeesiye akhaaro mumatsi, nibeefwayafwayia shia abeenya okhuyila ebiralisio okhurula muliaro hamurwe kwalio, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho Paulo yasunjila omuseesia nende abasikari ari Bano nibaratong'a muliaro, shinamunyale okhuhona tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasikari nibateta emikoye chiakhaaro mbu khakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bwachaaka okhushia, Paulo yabanichilisia bosi mbu baliekhwo khubiliibwa, ari Leelo lukhola ekhumi nakhane nimulindanga nimuhonga inzala, nimuralia eshindu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho chame muliekhwo; khukhoyeele khulwa obuhoni bweenywe. Shichila kata olwoya lulala Iweliswi eliokhumirwe chieenywe shilulakorakhwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nasunjile ario, nabukula omukaate nakhupila Nyasaye orio imbeli wabo bosi; nakusonyola, nachaaka okhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bosi nibalema emioyo, nabo bosi nibabukula ebiokhulia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne fwesi abali muliaro khwali abandu ebikhumi bibili amakhumi musaafu nende basasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibaliile nibeekuure, basukuna ingano eya bali ninayo mumatsi, okhwanguyia eliaro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliaro lieekhupa khwiloba nilirabukha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bwashia mutsuli shibamanya eshialo eshio ta; ne balola omukhono kweinyanza okwali nende olukuku Iwomuyeshe, nibachela nibaba nibakhanyala okhwinjisia eliaro mubwenomwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibalekhuula ebiralisio nibabilekha mumatsi, khandi nibatendeyia emikoye chiebilunjisilio, nibabambula litanga lieimbeli khumuyeka, nibachooma khulukuku olwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne beetsukhana niboola aha amatsi kakabukhana eyi nende eyi, nibakhupia eliaro khwiloba; omurwe kweliaro nikuhanda, nikuranyala okhusitibwa ta; habula hashitakho liachaaka okhurabukha khulwa amaani kamarunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka abasikari beenya nokhwira ababohe, oundi yesi khubo aleshe okhwerema yeehonokoshe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuseesia yali niyeenya okhuhonia Paulo; kho yabakaya, oburakhola aketsiyemi tsiabwe ta; ne yalaka mbu abamanya okhwelema beekhupe mumatsi, babe abaranjilila okhuula khulukuku; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo abatong'a, abandi khutsimbaho, abandi khubindu bindi ebiomuliaro. Kho bosi nibahona niboola khulukuku shisale.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
    }
