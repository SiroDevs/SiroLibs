          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa bahulila akobulamushi bwabafu, abandi bamutsesheelela; nabandi nibasunga bari Khulakhuhulila olundi khandi khumakhuwa kano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
