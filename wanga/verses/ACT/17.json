    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indiri yeekholela eTsesalonika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibabirile muAmufipoli nende Apolonia, niboola eTsesalonika, ewa isinagogi yabaYahudi yali; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.1",
            "verseOrgIds": [
              "ACT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Paulo, eshiimashie shinga olwa shiali, yeenjilamwo, mana muSabato tsitaru yakhupa imbakha ninabo khumakhuwa akomumahandiiko, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.2",
            "verseOrgIds": [
              "ACT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakeenoosia nende okhumanyia shinga olwa kali nikamukhoyeele Kristo oyo okhusaalila, khandi okhulamukha okhurula mukhufwa; ari Yesu uno, owa emurumbulila, niye Kristo watsana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.3",
            "verseOrgIds": [
              "ACT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi khubo bamala nibasuubila, nibeeyunga khuPaulo nende Sila; nabokhubaYunani abeekayakayi abanji muno, nokhubakhasi abakhulundu abanjikhwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.4",
            "verseOrgIds": [
              "ACT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaYahudi batiilwa imbalikha, nibalanga abandu bandi abamayaanu abokhushiiro, nibakhung'aasia omukanda, nibakoyaasia litookho; nibatsia enanzu waYasoni, nibateema okhubarusilia abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.5",
            "verseOrgIds": [
              "ACT.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa barabanyoola ta, bakhwesa Yasoni nende abandi abokhubaana beefwe nibabayila imbeli wabaami belitookho, nibayochela, bari Bano abafumamiye eshialo shiosi boolile nende yino; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.6",
            "verseOrgIds": [
              "ACT.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Yasoni yabeenjisiye; ne bano bosi bakholanga akayingania amalako kaKaisari, nibasunga mbu aliho omuruchi undi, mbu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.7",
            "verseOrgIds": [
              "ACT.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikabahendia abemikanda nende abaami belitookho, olwa bahulila amakhuwa ako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.8",
            "verseOrgIds": [
              "ACT.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibabukuule omusingo khubanga Yasoni, babalekhuula.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abarume nibali eBeroya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.9",
            "verseOrgIds": [
              "ACT.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nonoho abaana beefwe babaruma Paulo naSila mushilo okhuula eBeroya; nabo olwa boolayo nibeenjila musinagogi yabaYahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.10",
            "verseOrgIds": [
              "ACT.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abeenabo bali abeshiilongoole okhushila abali muTsesalonika; okhuba bali abemioyo emiangu okhufuchiilila likhuwa, nibanoonelesinjia amahandiiko buli nyanga, okhumanya amakhuwa ako nikaba nikali kario, nohomba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.11",
            "verseOrgIds": [
              "ACT.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abanji khubo nibasuubila, khandi nende abakhasi abaYunani abali abakhaye toto, nende abasaatsa abaniikhwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.12",
            "verseOrgIds": [
              "ACT.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abaYahudi beTsesalonika baboolelwa shinga likhuwa liaNyasaye olwa lieelwatsungwa nende Paulo khandi eBeroya, nabo bosi niboolayo, nibatubuula emioyo chiabandu nibabakoyaasia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.13",
            "verseOrgIds": [
              "ACT.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho habwene nahabwene abaana beefwe bamuruma Paulo mbu atsie okhuula khunyanza; ne Sila nende Timotseyo nibashitong'ayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.14",
            "verseOrgIds": [
              "ACT.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abo abamukooba Paulo bamuusia eAtsene; ne nibalachilwe likhuwa khuSila nende Timotseyo, mbu bamwitsile bwangu, nibeenyokha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo nali eAtsene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.15",
            "verseOrgIds": [
              "ACT.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Paulo yali nashibalindilangayo eAtsene, omwoyokwe kwayia olwayalola litookho elo niliitsuulemwo ebifwanani ebiinamilungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.16",
            "verseOrgIds": [
              "ACT.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yakhupa imbakha musinagogi nende abaYahudi nabandu abeekayakayi, khandi muluvia buli nyanga nende abo abaakaananga ninaye ebweneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.17",
            "verseOrgIds": [
              "ACT.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandi khandi babaEpikurio nabaSitoike abobumanyilisii nibabukaana ninaye. Abandi nibasunga bari Omwibootsi uno akhaboola shi? Nabandi bari Yeengana ourumbula abanyasaye abacheni. Shichila yeelwatsanga akaYesu nende obulamushi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.18",
            "verseOrgIds": [
              "ACT.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuhamba nibamuyila muAreopago, nibasunga bari Nochama, khumanye akameechesio amayia aka oboolanga shinga olwa kali? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.19",
            "verseOrgIds": [
              "ACT.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba oleeranga amakhuwa kandi amacheni mumarwi keefwe; kho khwenya okhumanya eshisina shiamakhuwa ako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.20",
            "verseOrgIds": [
              "ACT.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaAtsene bosi, halala nabacheni abamenyangayo, shibali nobwiyangu bwelikhuwa lindi ta, habula okhuboola kata okhuhulila likhuwa iiosi liyiakha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.21",
            "verseOrgIds": [
              "ACT.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Paulo nasinjila hakari weAreopago, nasunga mbu Inywe abandu baAtsene, mumakhuwa kosi enduutsi mbu muli abandu abayililisinjiakhwo khumakhuwa keidini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.22",
            "verseOrgIds": [
              "ACT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olwa embirilenje nindola bienebio ebia mwinamilanga enduutsi eshimalilo shiemisango shindi eshiahandiikwakhwo shiri KHUNYASAYE OURAMANYIKHA TA. Kho omwenoyo owa mwinamilanga mukhukorwa, neniye owa emurumbulilanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.23",
            "verseOrgIds": [
              "ACT.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye oyo owakhola eshialo nende biosi ebilimwo, ye ouli Omwami welikulu nende eshialo, shiamenyanga muhekalu etsiumbakhwa namakhono ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.24",
            "verseOrgIds": [
              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shiakhalabanilwa namakhono kabandu, shinga outamba eshindu, tawe; okhuba neniye ouheelesinjia bosi obulamu, nemiuya echia baheelanga, nende ebindu biosi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhurula mumulala yakhola buli lihanga liabandu mbu bamenye khushialo shiosi, namalile okhuraho tsinduukho etsialakwa nende tsinzakho tsiebimenyo biabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu bamukhaabe Nyasaye, nikaba mbu fwana bakhahabasiahabasia nibamunyoola, kata olwa arali ehale nende buli mulala khwifwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba muye nimwo omwa khumenyanga, nikhuchenda, nikhubaho; shinga abandi kata abomubakasii betsinyimbo tsieenywe olwa baboola, mbu Okhuba fwesi khuli olwibulolwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa khuli khurio olwibulo lwaNyasaye, shikhukhoyile okhukaala mbu Obunyasaye bufwana shinga itsahaabu, kata ifeetsa, kata lichina, eshibaatsilwa obunina nobuchesi bwabandu, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.29",
            "verseOrgIds": [
              "ACT.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebise ebiokhukorwa, Nyasaye yabimaayia; habula bulaano alachilisinjia abandu mbu bosi, ababuli handu, bakhoyile okhwikalukhasia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.30",
            "verseOrgIds": [
              "ACT.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila amalile okhuraho induukho olwa alayaasia eshialo eshiina shiobulunjishi, khulwa omundu oyo owa yaahula; khandi yasuubisiye abandu bosi amakhuwa ako, olwa yamulamusia mukhufwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        }
      ]
