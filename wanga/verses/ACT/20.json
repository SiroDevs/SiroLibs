{
  "id": "ACT.20",
  "number": "20",
  "bookId": "ACT",
  "reference": "Ebikhole 20",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "ACT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yatsia eMakedonia nende ebuYunani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa indiri yaakama, Paulo yarumana okhulanga abeechi, nabachesiyia, mana naseebulana ninabo narulayo mbu atsie ebuMakedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.1",
            "verseOrgIds": [
              "ACT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nabirile mumbali etsio, nabachesiyiye namakhuwa amanji, yamala niyoola ebuYunani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.2",
            "verseOrgIds": [
              "ACT.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.2",
            "verseOrgIds": [
              "ACT.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yamalayo emiesi chitaru; mana olwa yali nali okhutsiila Siria muliaro, abaYahudi nibamukhobana; kho yapaara okhukalukha nabirile muMakedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.3",
            "verseOrgIds": [
              "ACT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandu bano bamukooba okhuula eAsia, mbu Sopatero omuBeroya, waPiro; nende Arisitariko naSekundo, abokhubaTsesalonika; nende Gayo oweDerube, nende Timotseo; nende Tikiko naTurofimo abeAsia ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.4",
            "verseOrgIds": [
              "ACT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandu abo bali nibaranjiliile, nibakhuli ndiile eTeroa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.5",
            "verseOrgIds": [
              "ACT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nikhurula eFilipi muliaro tsindaalo tsiomukaate okubulamwo amamela olwa tsiahwa, nikhuula ewa bali eTeroa mundaalo tsiraano; nikhumenyakhwoyo tsindaalo musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo nali eTeroa, nende akaEutiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.6",
            "verseOrgIds": [
              "ACT.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yambeli eyomwihonga olwa khwali nikhukhung'aaniile halala okhusonyola omukaate, Paulo yabeelwatsila, nali okhurulayo mukamba; ne yarambiyia aka yeelwatsa okhuula mushilo hakari. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.7",
            "verseOrgIds": [
              "ACT.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsialiho tsitaha tsinyinji mushisika shiahekulu ewa khwali nikhukhung'aar iile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.8",
            "verseOrgIds": [
              "ACT.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomusooliili undi oulangwa mbu Eutiko yali niyeekhaliile mwitirisha; tsindoolo tsinyinji nitsimuyila; ne olwa Paulo yatsiililila okhwilwatsa, khulwa tsindoolo etsimuyilile yakuunukha nakwa okhurula khubwelu bwakhataru, nachingwa namalile okhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.9",
            "verseOrgIds": [
              "ACT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Paulo yeekha, niyeekhupa khuye, namufumbeelela, nasunga mbu Murahenda ta; okhuba obuIamubwe bushili muye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.10",
            "verseOrgIds": [
              "ACT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali naniinile khandi, nasonyoole omukaate nende okhulia, nasungaane ninabo eshise eshirambi, kata okhuula olwa obukwe bwasheba, mana niyeenyokha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.11",
            "verseOrgIds": [
              "ACT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleera omuyia oyo nali omulamu, nibalemibwa emioyo muno.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhurula eTeroa, okhuula eMileto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.12",
            "verseOrgIds": [
              "ACT.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu nikhuranjilila nikhutsia khuliaro, nikhutsia ninalio okhuula eAso, nikhupaara mbu ebweneyo khwakhamubukulilayo Paulo; okhuba yali nalachile ario, ne omwene yeenya okhutsia nebilenje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.13",
            "verseOrgIds": [
              "ACT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa khwabukaana ninaye eAso, khwamubukula, mana nikhuula eMitilene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.14",
            "verseOrgIds": [
              "ACT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhurulayo neliaro, mana mukamba nikhuula ahahengana nende Kio; khandi mukamba kwakhabili nikhwambukha nikhuula eSamo; ne mukamba kwakhataru nikhuula eMileto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.15",
            "verseOrgIds": [
              "ACT.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Paulo yali nakasiye amakhuwa okhubira Efeso bubira, aleshe okhumala ebise muAsia; okhuba yali natetekhananga mbu abe eYerusalemu khunyanga yaPendekote, nikaba nikakhanyalikha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo yaseebulana nabakofu beEfeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.16",
            "verseOrgIds": [
              "ACT.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhurula eMileto yarumana eEfeso, nalanga abakofu beikanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.17",
            "verseOrgIds": [
              "ACT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali niboolileyo, yababoolela ari Inywe abeene mumanyile, okhurula khunyanga yambeli olwa ndaranjilila okhuseena eshilenje muAsia, obwiyili bwanje shinga olwa bwalinji, nindi nineenywe tsindaalo tsiosi, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.18",
            "verseOrgIds": [
              "ACT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikhalabanilanga Omwami nende omwoyo omwituutuyi nende amasika, nende amatinyu akangwilanga khulwa obukhobani bwabaYahudi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.19",
            "verseOrgIds": [
              "ACT.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shinga olwa ndaraholeela khwikhuwa liosi eliamukaasila ta, nimwechesinjia habulafu kata mutsinzu, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.20",
            "verseOrgIds": [
              "ACT.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbarumbulila abaYahudi nabaYunani bosi akobwikalukhasii khuNyasaye, nakobusuubili khuMwami weefwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.21",
            "verseOrgIds": [
              "ACT.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, lole, enzia eYerusalemu nindi omubohe mumwoyo, nindamanya amakhuwa akalingwilayo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.22",
            "verseOrgIds": [
              "ACT.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula mbu Roho Omutakatifu yandumbulilanga mubuli litookho, naboola mbu ebibohelo nende obusandibwi binindiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.23",
            "verseOrgIds": [
              "ACT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi shimbasia obulamu bwanje mbu neshindu, kata mbu nobwolukoosi khwisie omwene ta; habula mbu emalilisie oluchendo lwanje, nende obukhalabani obwa ndaheebwa nende Omwami Yesu, okhurumbula akobuloli khunjiili yobukoosia bwaNyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.24",
            "verseOrgIds": [
              "ACT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, lole, emanyile mbu inywe mwesi, aba ndachendelenjemwo nindilwatsanga akobwami, shimulindola mumoni mwanje khandi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.25",
            "verseOrgIds": [
              "ACT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nimurumbulila inyanga yino, mbu shindi nende eshikha shiamabanga khumundu yesi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.26",
            "verseOrgIds": [
              "ACT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shindaholeela oburamurumbulila tsiyemi tsiosi tsiaNyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.27",
            "verseOrgIds": [
              "ACT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwilinde abeene, nende lituuli elo liosi omwa Roho Omutakatifu yamukholilemwo abalindi, mbu muliisinjie ikanisa yaNyasaye, eya yakula amabanga keke omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.28",
            "verseOrgIds": [
              "ACT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emanyile mbu olunyuma Iwokhwinyokha khwanje ebisuutse ebihalaba biakheenjile mwinywe, nibirahonokosia lituuli ta; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.29",
            "verseOrgIds": [
              "ACT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata mukari mwinywe abandi bakhabuushe nibaboola amakhuwa amarambaatsanu, okhukhwesa abeechi babalondekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.30",
            "verseOrgIds": [
              "ACT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila, mubeetsenje meeso, nimwitsulila mbu mundaalo tsiemiyika chitaru shindakonelanga tawe okhuchesiyia buli mundu nindila amasika, eshiteere nende eshilo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
