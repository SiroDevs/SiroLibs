          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali naboolile ario, yasikama hasi, nasaaya halala ninabo bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.36",
            "verseOrgIds": [
              "ACT.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi nibalila muno, nibakwa mwikosi liaPaulo, nibamutsunzuuna, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.37",
            "verseOrgIds": [
              "ACT.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
