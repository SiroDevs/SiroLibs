          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibali neshibeela okhushila muno khulwa likhuwa elia yali naboolile, mbu shibakhamulola mumonimwe khandi ta. Nibamukooba okhuula khuliaro.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.38",
