          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.20.31",
            "verseOrgIds": [
              "ACT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
