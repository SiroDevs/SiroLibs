      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo nali eEfeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho olwa Apolo yali nashili eKorinzo, Paulo yoola eEfeso, namalile okhubira mushialo shiemukulu, nanyoola abeechi bandi; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabareeba ari Mwanyoola Roho Omutakatifu olwa mwasuubila? Nabo bari Tawe; kata okhuhulila shikhwahulilakhwo mbu aliho Roho Omutakatifu tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba ari Kho mwabatisibwa khububatisii shiina? Nibasunga bari Khububatisii bwaYohana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo nasunga mbu Yohana yabatisinjia obubatisii bwobwikalukhasii, naboolela abandu mbu bamusuubilile omwenoyo owakheetse munyumawe, niye Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.4",
            "verseOrgIds": [
              "ACT.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bahulila bario, nibabatisibwa nibeenjisibwa muliira liOmwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.5",
            "verseOrgIds": [
              "ACT.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Paulo yali nabareelekhwo emikhono, Roho Omutakatifu yabeetsela; nibaboola netsinimi, nibalakula. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.6",
            "verseOrgIds": [
              "ACT.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bosi bali abasaatsa shinga ekhumi nababili.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.7",
            "verseOrgIds": [
              "ACT.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niyeenjila musinagogi, naboolanga katong'ane emiesi chitaru, nakhupanga imbakha nabanichilisinjia khumakhuwa kobwami bwaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.8",
            "verseOrgIds": [
              "ACT.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandi olwa boomia amakosi nibakhaya okhusuubila, nibaboola obubii khuNjila eyo imbeli wemikanda, yabarulakhwo, natsia nende abeechi, nakhupanga imbakha inyanga buli nyanga mwisoomelo liaTirano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.9",
            "verseOrgIds": [
              "ACT.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano nikatsiililila kario emiyika chibili, okhuula bosi abamenya muAsia olwa bahulila likhuwa liOmwami, kata abaYahudi kata abaYunani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.10",
            "verseOrgIds": [
              "ACT.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye yakhola akamakana amayia namakhono kaPaulo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu orutawulo nebitambaya biarusibwa khumubiliwe nibiyililwa abalwale, obulwale mana nibubalekha, abaroho ababii nibabarulamwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaana baSikewa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abandi abokhubaYahudi abayeeyeemi, abarusinjia abaroho, bateema okhurumbulila abeenabo abali nabaroho ababii eliira liOmwami Yesu, bari Emubiila khulwa eliira liaYesu owa Paulo yeelwatsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baliho abasiani musaafu bomundu mbu Sikewa, omuYahudi, omukuhani omukhulundu, abakhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana roho omubii naye nakalusia nabasunjila ari Yesu emumanyile, khandi Paulo emumanyile; ne inywe ninywe beena? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo owalimwo roho omubii nabaruumilakhwo nabahula bosi, nabanyala, okhuula olwa beelukha nibarula munzu omwo nibali eshihechenye, nibasaaliile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo nilimanyishila abandu bosi abamenya eEfeso, abaYahudi nende abaYunani; indenga niyibahamba bosi, eliira liOmwami Yesu niliitsoomibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abanji khubo abali nibasuubiile nibeetsa nibeeyama, nibarumbula ebikhole biabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abanjikhwo khubo abakholanga akobufumu bakhung'aasia ebitabu biabwe nibabisamba abandu bosi nibalola; nibabasia obukusi bwabio, nibanyoola nibuhela tsifeetsa ebikhumila amakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa likhuwa liOmwami liakhula nilihula.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukoyaani bweekhola eEfeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho amakhuwa ako olwa kahwa, Paulo yarakhwo omwoyo okhutsia eYerusalemu olwa yakhaba nabirile muMakedonia nende Akhaya; ari Nimalile okhubayo ebweneyo, kakhoyeele mbu endolekhwo kata Roma yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babili khubeenabo abamukhalabanilanga, nibo Timotseo nende Erasito, yabaruma eMakedonia, omwene natong'ayo ebuAsia eshisekhwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mundaalo etsio, obukoyaani bwabuukha obunji khumakhuwa keInjila eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.23",
            "verseOrgIds": [
              "ACT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omundu undi oweliiralie mbu Demeterio, omwiraanyi weifeetsa, oweeraanyanga ifeetsa oruhekalu rwaAritemi, yali nabaleerelanga abafundi inganga inyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.24",
            "verseOrgIds": [
              "ACT.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabakhung'aasia, halala nabakholi bandi bemilimo chienechio, nasunga ari Abasaatsa abashianje, mumanyile mbu obuyinda bweefwe burulanga mumilimo chino. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.25",
            "verseOrgIds": [
              "ACT.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi muluutsi nimuhulila mbu shimuli muEfeso mwonyene ta, habula muAsia ahambi mwosi Paulo uno unichilisiye abandu abanji nabashiukhasia, naboolanga mbu ebikholwa namakhono shibili abanyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.26",
            "verseOrgIds": [
              "ACT.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikali butswa mbu emilimo chieefwe chino chinyala okhulekwa, ta; habula ihekalu yomunyasaye weshikhasi omukhuIundu Aritemi yinyala okhupaarwakhwo mbu shishili eshindu ta; kata yakhanyala okhuyinibwakhwo oluyalilwe lwosi, oyo owa Asia yosi nende abomubialo biosi pe beenamilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.27",
            "verseOrgIds": [
              "ACT.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bahulila bario, batiilwa oburima, nibayiiba, bari Aritemi wabaEfeso nomukhongo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.28",
            "verseOrgIds": [
              "ACT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litookho liosi niliitsulamwo obukoyaani; nabo nibeelukha tsimbilo nomwoyo mulala nibeenjila mwikhung'aanilo, nibamalile okhuhamba Gayo nende Arisitariko, abandu beMakedonia, abachendanga nende Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.29",
            "verseOrgIds": [
              "ACT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Paulo yali niyeenya okhwinjila ewa abandu bali, abeechi shibamumoka ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.30",
            "verseOrgIds": [
              "ACT.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandi abokhubakhuIundu baAsia, abali abeetsabe, bamukhupila omunwa nibamusaaya mbu aratsaalikha okhwinjila mwikhung'aanilo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.31",
            "verseOrgIds": [
              "ACT.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandi balanjilisinjia bari, nabandi bari, okhuba omukhung'aano kwosi kwali nikukoyaanile; obunji bwabwe nibaramanyakhwo akachilile nibakhung'aana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.32",
            "verseOrgIds": [
              "ACT.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamurusia Alekisanda mumukanda, abaYahudi nibamusitia hambeli. Naye Alekisanda nabasimila omukhono, niyeenya okhwiteetsa imbeli wabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.33",
            "verseOrgIds": [
              "ACT.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo olwa bamanya mbu nomuYahudi, bosi bayiiba nomwoyo muIala, eshise shietsisaa tsibili, bari Aritemu wabaEfeso nomukhongo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.34",
            "verseOrgIds": [
              "ACT.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuhandiichi welitookho olwa yali naholelesiye omukanda, yasunga ari Inywe abasaatsa beEfeso, ali heena ouramanyile ta shinga litookho liaEfeso olwa lili lilindi lieihekalu yaAritemi omukhongo, nende lieshieneshio eshiaakukha okhurula mwikulu? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.35",
            "verseOrgIds": [
              "ACT.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa amakhuwa ako shikanyala okhukaanwa ta, mukhoyile okhwihootselesia nimurayungubala ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.36",
            "verseOrgIds": [
              "ACT.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba muleerile abandu bano hano, abarayeebakhwo ebiomuhekalu kata okhunyeka nyasaye weefwe oweshikhasi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.37",
            "verseOrgIds": [
              "ACT.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Demeterio nabafundi aba ali ninabo nibaba nibali nende likhuwa khumundu yesi, ebiina biliho, khandi abakafuna baliho; kho beenjililane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.38",
            "verseOrgIds": [
              "ACT.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimukhaaba akali khumakhuwa kandi, kalakasilibwa mumukhung'aano okubeetsangaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.39",
            "verseOrgIds": [
              "ACT.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nitoto, khwakhanyala okhwinjililwa khumakhuwa keinduli yaleelo, eyibula eshifune; kata khwikhuwa elo shikhulanyala okhurumbula eshisina shiomukhung'aano kuno ta. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.40",
            "verseOrgIds": [
              "ACT.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali naboolile ario, yaseebula omukhung'aano.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.41",
            "verseOrgIds": [
              "ACT.19.41"
            ]
          }
        }
      ]
    }
  ],
