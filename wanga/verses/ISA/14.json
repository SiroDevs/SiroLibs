          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI omwene mahe aboola mbu Nasi ndalabarulilakhwo nikhalachila Babeli eliira nende omusikalo, nende omwana nende omwitsukhulu; nolwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.22",
            "verseOrgIds": [
              "ISA.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalashikhola eshimenyo shianamungulu, nende amatiba kamatsi; khandi ndalashieya nende ameeyo kobutibii; nolwa OMWAMI omwene mahe aboola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.23",
            "verseOrgIds": [
              "ISA.14.23"
            ]
          }
        }
      ]
    },
