          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khunyanga eya OMWAMI alakhuhuluusia mubusaalilibwo, nende mumasilako, nende mubukholi obutinyu obwa wakhosibwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "olamukhoomolela omuruchi waBabeli nende olwimbo luno, nosunga mbu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
            "verseOrgIds": [
              "ISA.14.4"
            ]
          }
        }
      ]
