          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI abeela Yakobo tsimbabasi; alalobola Isiraeli khandi, nabara Inushialo shiabwe abeene; nabarende baleeyunga khubo nibaliimaana khunzu yaYakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsimbia tsiabandu tsilababukula nitsibakooba ewabwe; nabeinzu yaIsiraeli balabaruka mushibala shiOMWAMI, babe abakholi abeshisaatsa nende abeshikhasi; khandi balabahamba abeenabo abalinji nibabahamba; nibaruka abasandii babwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
