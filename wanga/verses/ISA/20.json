        "style": "s1"
      },
      "items": [
        {
          "text": "Ashuru okhuhula Misiri nende Etiopia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika okwa Taratani yeetsela eAshidodi, olwa Saragoni omuruchi waAshuru yamuruma, naye naseera Ashidodi nalibukula, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "khushise shieneshio OMWAMI yaboolela mumunwa kwaIsaya waAmozi, ari Tsia, oboholole amakunia akali mubishienjebio, wifwalule ebilaarobio mubilenje. Naye yakhola ario, nachenda niyeengana ouli eshihechenye, nebilenje ebikhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola ari Shinga omusumba wanje Isaya olwa yachendilenje niyeengana ouli eshihechenye, nebilenje ebikhaya, emiyika chitaru, khulwa eshilolelo nende eshiamakana khuMisiri nende khuEtiopia, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwa omuruchi waAshuru aleelusia abahambe beMisiri, khandi baEtiopia abaarwa mushialo shiabwe, abaana nende abakofu, nibali eshihechenye, abebilenje ebikhaya, abemibili emikhaya kuru, okhuhambia Misiri tsisoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne balafwa emioyo nibafwimbwa emirwe, khulwa Etiopia owali obunaayilo bwabwe, khandi khulwa Misiri, ing'oono yabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oumenyanga mulukuku luno alasunga khunyanga eyo mbu Lole, aba khwayeesiichilenje shinga olwa bali, ewa khweelushila obuhabini mbu khuhonibwe khumuruchi waAshuru; kho neefu, nakhwihonokoshe khurie?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
    }
  ],
