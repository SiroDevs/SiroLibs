              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi munduukho eyo OMWAMI alahuula imeleye yosi, okhurula khumulaakha kwOmudlo okwo okhuula khumuchela kwaMisiri, ne mularulumwl mulala mulala, inywe abaana baIsiraeii.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
