              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munduukho eyo OMWAMI alakuuma inzokha eyo inyangu, mbu Lewiatsani, khandi nende Lewiatsani inzokha eyo eyiikotiombola, nende olukangalwe olumemu, olukhongo, olwamaani; khandi aleera nende okuyokha okuli munyanza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
