        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shino shilaba eshilolelo khwiwe eshirula ewOMWAMI, mbu OMWAMI alakhola likhuwa lino elia aboolile; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.7",
            "verseOrgIds": [
              "ISA.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu lola, ndalakalusia eshiinikha khumaniinilo, aha shiishile khumaniinilo kaAhazi khulwa omubasu; ndalashikalusia inyuma khumaniinilo ekhumi. Kho eliuba liakalukha amaniinilo ekhumi khumaniinilo aka liali niliishiilekhwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        }
      ]
    },
