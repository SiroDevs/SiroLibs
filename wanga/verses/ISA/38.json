          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia naye yali nasunjile mbu Shili heena eshilolelo eshilolosia mbu ndalatikulukha okhuula enanzu yOMWAMI?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.22",
