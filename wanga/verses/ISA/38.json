          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka Hezekia omuruchi waYuda yahandiika olwa yali niyalwalile, nahonile mubulwalebwe, ngakano; mbu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
