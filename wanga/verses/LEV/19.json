          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obasinjililenje abetsimbutsi, noheelesia tsimoni tsiomukofu oluyali, nomuria Nyasayewoisie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.32",
            "verseOrgIds": [
              "LEV.19.32"
            ]
          }
        }
      ]
