          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakholanga likhuwa elirali lilunji mubayaasii ta, kata mukhuchela oburambi kata obusiro kata obwitsulu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.35",
            "verseOrgIds": [
              "LEV.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeetsenje neshiitenjelesiol eshili habwene, namachina keiratili akali habwene, na efa eyili habwene, na hini eyili habwene; isie nisie OMWAMI Nyasaye weenywe, owamurusia mushibala shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.36",
            "verseOrgIds": [
              "LEV.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulindenje aka emulachilisia kosi, nakobukhalachi bwanje kosi, nimukakhola. Isie nisie OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.19.37",
            "verseOrgIds": [
              "LEV.19.37"
            ]
          }
        }
      ]
