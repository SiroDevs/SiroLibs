    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhulinda itaha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.1",
            "verseOrgIds": [
              "LEV.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laka abaana baIsiraeli mbu bakhuleerele amafura kemitseituni amaswache ameeleleshe khulwa tsitaha, mbu itaha yashenje khatsotselo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elwanyi weingubo ishinga eyoburumbusi, mwiheema liokhwakaana, Haruni ashikasinjie okhurula mungoloobe okhuula mutsuli imbeli w khatsotselo; libe likhuwa elilachilisibwa obushia nobushia munzibulo tsieenywe tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasinjie tsitaha khushichibi shiatsio shieitsahaabu inzeleleshe imbeli w khatsotselo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emikaate chiokhubaho khwOMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukule obusie obunyushe, obufumbuushe amaandasi ekhumi nakabili; ebitonye bibili bielikhumi bia efa bibe mubuli liandasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.5",
            "verseOrgIds": [
              "LEV.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okaanze tsinyali tsibili, kasasaba mulunyali, khumeesa eyo yeitsahaabu inzeleleshe imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore obubaane obweleleshe khubuli lunyali, bube eshiitsulilo khumikaate echio, eshihaanwa shiOMWAMI eshikholelwa omulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli nyanga yasabato Haruni achianzenje imbeli wOMWAMI tshldaalo tsiosi, khulwa abaana baIsiraeli, indakano eyirahwaho ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chibe echiaHaruni nabaanabe; bachiliile habundu undi ahatakatifu; okhuba khuye nomukabo omutakatifu muno kwokhubihaanwa biOMWAMI ebikholelwa omulilo, khulwa obulachilisii oburahwaho ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akokhunyeka eliira liOMWAMI, nende akemirungo chiehonoono",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
            "verseOrgIds": [
              "LEV.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho omwihwa muIsiraeli, owa samwana yali omuMisiri, yachendanga mubaana baIsiraeli; ne oyo omwihwa muIsiraeli nende omundu waIsiraeli bakhupanila mukambi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.10",
            "verseOrgIds": [
              "LEV.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omwiwha oyo yanyeka Eliira tsana, nalifwola; nibamuleera ewaMusa. Eliira lianyinamwana niShelomitsi, omukhaana waDibiri, owoluyia lwaDani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.11",
            "verseOrgIds": [
              "LEV.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamura mundindi, okhuula olwa bakhaba nibarumbuliilwe aka OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.12",
            "verseOrgIds": [
              "LEV.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.13",
            "verseOrgIds": [
              "LEV.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo ouboolile akokhufwola, mumurusie elwanyi weikambi; mana bosi abamuhuliile, bare amakhono khumurwekwe, mana abomukhung'aano kwosi bamulase namachina. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe oboolele abaana baIsiraeli mbu Omundu yesi oufwola Nyasayewe, yeetuushe eshionoonoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.15",
            "verseOrgIds": [
              "LEV.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata oyo ounyeka eliira liOMWAMI, yeerwe bwirwa; abomukhung'aano bosi bamulase bulasa namachina; kata omurende kata omwibule, bosi, olwa banyeka Eliira tsana, beerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.16",
            "verseOrgIds": [
              "LEV.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata oukhupa omundu namwira, yeerwe bwirwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "noyo oukhupa omuruko nakwira, akurunje; mbu obulamu khulwa obulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu naba nalemia owashie; shinga olwa akholile, akholelwe ario yesi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.19",
            "verseOrgIds": [
              "LEV.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu okhufinikha khulwa okhufinikha, imoni khulwa imoni, eliino khulwa eliino; shinga olwa yamulemia omundu, yesi arungwe ario. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.20",
            "verseOrgIds": [
              "LEV.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owira omuruko, arunje; nowira omundu yeerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.21",
            "verseOrgIds": [
              "LEV.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mube nobukhalachi bwamalako bulala, khulwa omurende khandi khulwa omwibule; okhuba isie nisie OMWAMI Nyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa naboolela abaana baIsiraeli, nabo nibamurusia mukambi oyo ouboolile akokhufwola, nibamulasa namachina. Abaana baIsiraeli nibakhola shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
          }
        }
      ]
    }
  ],
