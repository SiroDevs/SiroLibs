        },
        {
          "text": "Nebutswa eshindu eshiahuliilwe elala, eshia omundu yaahuliila OMWAMI elala eshiokhubia ali ninabio, kata omundu kata omuruko kata omukunda okwobulaamebwe, shishinyala okhukusibwa kata okhununulwa ta; buli shindu eshiahulilwa elala, neshitakatifu muno khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu owahulilwa elala, owahulwa ario mubandu, aranunulwa ta; yeerwe bwirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
