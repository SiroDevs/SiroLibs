          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arahenjelesia okhumanya nishili eshilayi kata eshibii, kata okhushikulaasia, ta; ne naba nashikulaasia eshindi, kho eshiene nende eshindi shilia eshia shikulaasiibwe bibe ebitakatifu; shishinyala okhununulwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
