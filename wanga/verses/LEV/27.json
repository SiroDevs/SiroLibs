          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshitonye shielikhumi eshiokhung'ombe kata khubiayo, khubibiranga hasi weindabushi yomwayi, buli shieikhumi shibe eshitakatifu shiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
