    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako khukemilukha chiobwahuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Omundu olwa aba niyeetsuba eshiitsubo shiabandu khuMWAMI, babe shinga iwe olwa ochela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuchelakhwo khwomundu oweshisaatsa, okhurula khumuyikakwe kwamakhumi kabili okhuula khumuyika kwamakhumi kasasaba, khube tsishekeli amakhumi karaano tsieifeetsa, nochela khushekeli yahabundu ahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nali omundu weshikhasi, okhuchelakhwe khube tsishekeli amakhumi kataru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naba nali omundu owokhurula emiyikachie chiraano okhuula khumiyika amakhumi kabili, okhuchelakhwo khube khuweshisaatsa tsishekeli amakhumi kabili, nokhuweshikhasi tsishekeli ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naba nali omundu owokhurula khumwesikwe kwambeli okhuula khumiyika chiraano, okhuchelakhwo khube khuweshisaatsa tsishekeli tsiraano tsieifeetsa, nokhuweshikhasi okhuchelakhwo khube tsishekeli tsitaru tsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nali omundu wemiyika amakhumi kasasaba nokhushilaho, naba nali oweshisaatsa, okhuchelakhwo khube tsishekeli ekhumi natsiraano, ne nali oweshikhasi tsishekeli ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nali omumanani ouranyala eshia ochelile ta, kho asinjisibwe imbeli womukuhani, naye omukuhani arumbulekhwo omuchelokwe; obunyali bwa oyo owitsubile shinga olwa buli, nolwa omukuhani amurumbulile omuchelo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikuba nikuli omuruko ekwa abandu baleeranga kube eshihaanwa shiOMWAMi, kwosi okwa omundu ahaanila OMWAMI okweimbia eyo kube omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arakukalukhasia kata okhukukulaasia, mbu omulayi mushilenje shiomubii kata omubii mushilenje shiomulayi, ta; ne naba nakulaasia omuruko mushilenje shiomuruko kundi, kho okwene nende okundi kulia okwa kukulasiibwe chiosi chibe emitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikuba nikuli omuruko okuli omusilo, okwa baraleerelanga kube eshihaanwa shiOMWAMI ta, kho asinjisie omuruko tsana imbeli womukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani akuchele, nikuba nikuli omulayi kata omubii; shinga iwe omukuhani olwa okuchelile, nolwa kuba kurio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba niyeenya okhukununula, ameetekhwo eshitonye shiakharaano khukhuchelakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata olwa omundu aba niyaahula inzuye, yibe indakatifu khuMWAMI, kho omukuhani achichele, niyiba niyili indayi kata imbii; shinga omukuhani olwa achichela, nolwa yisinjila yirio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo ouchiahula naba niyeenya okhununula inzuye, ameetekhwo eshitonye shiakharaano khumapeesa aka oba nochelilekhwo, mana yibe eyiye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu naba niyeenya okhwahulila OMWAMI eshitonye shiomukunda okuli okukwe, okhuchelakhwo khube khukhuraakwa khwakwo shinga olwa khuli; mbu nikuraakwa ishayiri ihomeri ndala, kuchelwe tsishekeli amakhumi karaano tsieifeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naba niynahula omukundakwe okhurula khumuyika kwayubile, okhuchelakhwo khusinjile khurio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba niyaahula omukundakwe olunyuma lwayubile, omukuhani amubasilie amapeesa emiyika echishitong'a okhuula khumuyika kwayubile shinga olwa chili; mana okhuchelakhwo khulatiitiyibwa khurio. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo owahula omukunda tsana naba niyeenya okhukununula, ameetekhwo eshitonye shiakharaano khumapeesa aka oba nochelilekhwo, mana kulamutinyisilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nareenya okhununula omukundakwe ta, kata naba nakukusiye omundu undi, kho shikulanunulwa khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omukunda tsana olwa kulekhuulwa muyubile, kube omutakatifu kwOMWAMI, shinga omukunda okwaahuliilwa elala; kulaba okwomukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba niyaahulila OMWAMI omukunda okwa yakula, okurali okukwe okwa yalaamilwa ta, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani amubasilie obukusi obwa ochelakhwo okhuula khumuyika kwayubile, naye akhuhe eshiokhuchelakhwo khunyanga yeneyo, shibe eshitakatifu shiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwayubile omukunda kumukalushile oyo owakukusia, oyo ouli omwene omukunda tsana khulwa okhulaamilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuchelakhwo khwosi khube khushekeli yahabundu ahatakatifu shinga olwa yili; mbu ishekeli yihele tsigera amakhumi kabili.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula eshiibulwa shiambeli mumiruko, eshili eshiOMWAMI shichila neshiibulwa eshiambeli, omundu yesi arashiahula ta; kata nishiba ing'ombe kata likondi, neshiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nikuba omuruko okuli kwomusilo, akununule okhuchelakhwo shinga olwa khuli, nameetakhwo eshitonye shiakharaano; kata nikuba nikuranunulwa ta, kho kukusibwe obukusi shinga obwa ochelile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
