            "number": "1",
            "style": "v",
            "sid": "LEV 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela Haruni, nabaanabe, nabaana bosi baIsiraeli, mbu Kano niko aka OMWAMI yalachilisia; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi owomunzu yaIsiraeli ouba niyeerela ing'ombe, kata likondi, kata imbusi mukambi, kata ouba nashiirila elwanyi weikambi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nareetsile ninashio hamuliango weliheema liokhwakaana, okhulileera libe eshihaanwa shiOMWAMI imbeli weshimenyo shiOMWAMI ta, eshiina shiamabanga shimufwila omundu oyo; yeebeeniye amalasile; omundu oyo yaakamibwe mubandube; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kachile abaana baIsiraeli baleere emisango chiabwe echia baba nibeerile mumikunda ebulafu, mbu bachileere ewOMWAMI hamuliango weliheema liokhwakaana, ewomukuhani, nibabimala bibe emisango chiokhwishia khuMWAMI ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani yoohe amalasile khushimalilo shiOMWAMI hamuliango weliheema liokhwakaana, nasamba amasinya khulwa eshiuya eshilayi khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleshenje okhumala emisango chiabwe khumadimoni akafwana netsikhole, aka balondangakhwo shinga abaheyi. Lino libabeele elilachilisibwa obushia nobushia munzibulo tsiabwe tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi obaboolele mbu Omundu yesi owakhabaho oweinzu yaIsiraeli, kata owokhubarende abamenyakhwo mubo, oumala omusango omusambe kata omusango kundi kwosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nareetsa ninakwo hamuliango weliheema liokhwakaana okhukumalila OMWAMI ta, omundu tsana asishibwe mubandube.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bakaanibwa oburaliakhwo amalasile ta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi owakhabaho oweinzu vaIsiraeli, kata owokhubarende abamenya mubo, ouliakhwo khumalasile keimbia yosi; isie ndalamuyinilia tsimoni tsianje nimufukula omundu oyo oulia amalasile; ndalamusishia mubandube. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba obulamu bwomubili buli mumalasile; nasi ndakamuheelesia khushimalilo okhumutisa; okhuba amalasile niko akakholanga eshitiso, khulwa obulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila nimusunjila abaana baIsiraeli mbu Omundu yesi yesi khwinywe aleshenje okhulia amalasile, kata omurende ouba namenyile mwinywe aleshe okhulia amalasile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu yesi owakhabaho owokhubaana baIsiraeli kata owokhubarende abamenya mubo, ouyiima isolo yosi kata linyonyi liosi khubiliibungwa, yeebeenia amalasile kashio pe, akafuunishekhwo olufu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kali kari nanwa khubulamu bwebiemibili biosi; mbu amalasile kabio nobulamu bwabio neshindu shilala. Ne niko akachila nisunjila abaana baIsiraeli mbu Muraliakhwo amalasile keshiomubili shiosi shiosi ta; okhuba obulamu bwabuli shiomubili nibwo amalasile kashio; oukalia alasishibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli mundu oulia khushindu eshifwile eshiene, kata eshiatonyatonyilwe netsisolo, kata naba omwibule kata omurende, yoosie tsingubotsie, niyeesinga amatsi, naba mwibilu okhuula olwa bwila; mana abe omusiiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba naratsiosia ta, kata okhwisinga omubili, kho yeetuushe obumayaanubwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
        }
      ]
    }
