          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa muba nimuchesa lichesa lieliloba lieenywe, orachesela elala omukundakwo mutsikoona, kata okhukhung'aasia ebirulume ebiomwichesalio ebisikaaleyo ta; obileshele ahamanani nabarende; isie nisie OMWAMI Nyasaye weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
    },
    {
