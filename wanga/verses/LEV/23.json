              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsino nitsio tsinduukho tsiamasabo kOMWAMI, etsia mulatangasinjia tsibe emikhung'aano emitakatifu, okhuhaanila OMWAMI ebihaanwa ebikholelwa omulilo, nemisango emisambe, nemisango chieimele, nemisango chindi, nemisango chiokhutsushilwa, buli mulala khunyanga yakwo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.37",
            "verseOrgIds": [
              "LEV.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi tsiliho tsisabato tsiOMWAMI; biliho ebihaanwa bieenywe; biliho ebiitsubo bieenywe biosi; khandi biliho ebihaanwa bieenywe ebia muhaanila OMWAMI khulwa okhuchama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.38",
            "verseOrgIds": [
              "LEV.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yekhumi nakharaano eyomumwesi kwomusaafu, olwa muba nimumalile okhukhung'aasia ebiamo biosi bieliloba, mukhole lisabo liOMWAMI tsindaalo musaafu. Khunyanga yambeli omuhongo kubeho, khandi khunyanga yomunaane omuhongo kubeho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.39",
            "verseOrgIds": [
              "LEV.23.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 23:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yambeli mubukule ebiamo biemisaala emilayi, namasaafu kamashindu, netsisaka tsiemisaala echili namasaafu, netsimbaya etsiokhumuchela; mana mwikhoye imbeli wOMWAMI Nyasaye weenywe tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 23:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulikhole libe lisabo khuMWAMI tsindaalo musaafu mumuyika; nilio likhuwa elilachilisibwa obushia nobushia munzibulo tsieenywe tsiosi; mulikhole mumwesi kwomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 23:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumenye mumatili tsindaalo musaafu; abeebule bosi baIsiraeli bamenye mumatili; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 23:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abetsinzibulo tsieenywe bamanye shinga olwa ndamenyia abaana baIsiraeli mumatili olwa ndabarusia mushibala shiaMisiri; isie nisie OMWAMI Nyasaye weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.43",
            "verseOrgIds": [
              "LEV.23.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 23:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa natangasilia abaana baIsiraeli tsinduukho rsiamasabo kOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.44",
            "verseOrgIds": [
              "LEV.23.44"
            ]
          }
        }
      ]
    }
