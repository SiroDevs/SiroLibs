              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Mumwesi kwomusaafu, khunyanga yambeli eyomumwesi, mulaba nomuhongo, eshiitsulilo eshilimwo okhuupa tsinzika, omukhung'aano omutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakholakhwo omulimo kwosi kwobukhalabani ta; ne muhaanile OMWAMI eshihaanwa eshikholelwa omulilo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
