      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano kabe amalako khukomundu wobuchele khunyanga yokhusiiywakhwe; mbu aleerwe ewa omukuhani ali; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani arule mukambi; mana omukuhani ahenjelesie; ne oluumbe Iwobuchele niluba nilumalile okhuhona muwobuchele tsana, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani abalache okhumubukulila omundu tsana ouli okhusiiywa, amanyonyi amasiiyikhu kabili akali mwoyo, nolusaala Iwomusiita, neingubo iranzayi, namabinu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omukuhani abalache okhwirila linyonyi elala khu ako kabili khulutaabo ikulu wamatsi komuchela akabiranga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalio linyonyi elishili mwoyo, alibukule, halala nolusaala tsana Iwomu-siita, neingubo iranzayi, namabinu, nabiina ebio nende linyonyi tsana elili mwoyo mumalasile kelinyonyi eliirilwe ikulu wamatsi komuchela akabiranga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana akamiitse khu oyo ouli okhusiiywa obuchelebwe okhuula musaafu, narumbula mbu nomusiiye, nalekhuula linyonyi elo elili mwoyo mumikunda ebulafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omundu oyo ouli okhusiiywa yoosie tsingubotsie, niyeebeka pe, niyeesinga mumatsi, kho abe omusiiye; ne olunyuma lwa ako yeenjile mukambi; nebutswa amenyenje elwanyi weliheemalie tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomusaafu, yeebeche liswi liosi, neshileefu, nebisiche, kata amaswake kosi pe, yeebeche; khandi yoosie tsingubotsie, niyeesinga omubilikwe mumatsi, naba omusiiye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane abukule amakondi keshimwamwane kabili akabula obulema, nelisibiini elala liomuyika mulala elibula obulema, nebitonye bitaru bielikhumi bia efa yobusie obunyushe obutsokasiibwe amafura khulwa omusango kweimele, namafura akahela ilogu' ndala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani oumusiiya asinjisie omundu mwene ouli okhusiiywa, nebindu biosi, imbeli w, hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani abukule likondi elala khumakondi keshimwamwane tsana, nalileera libe omusango kweshiuku, namafura ako akahela ilogu ndala, nabichela imbeli w bibe omusango kwokhuchelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yeere likondi lieshimwamwane habundu aha beerelanga omusango kwobwonooni nomusango omusambe, habundu ahatakatifu tsana; okhuba shinga omusango kwobwonooni olwa kuli okwomukuhani, nolwa omusango kweshiuku kuli kurio okukwe; nomutakatifu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani abukule khumalasile akomusango kweshiuku, omukuhani nakara khubutsunzu bweshirwi shisaatsa shia oyo ouli okhusiiywa, khandi khulwala olukali Iwomukhonokwe musaatsa, khandi khushino eshikali shieshilenjeshie shisaatsa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omukuhani abukulekhwo khulogu eyo yamafura, nakatsukha mushikalo shiomukhono mukhasi, okukwe omwene; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuhani niyeena olwalalwe lusaatsa mumafura akali mumukhonokwe mukhasi, namiitsakhwo amafura nolwala okhuula musaafu imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amafura akashitong'a mumukhonokwe, akare khubutsunzu bweshirwi shisaatsa shia oyo ouli okhusiiywa, nokhulwala olukali Iwomukhonokwe musaatsa, nokhushino eshikali shieshilenjeshie shisaatsa, khumalasile kalia komusango kweshiuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namafura akashitong'a mumukhono kwomukuhani, akare khumurwe kwa oyo ouli okhusiiywa; omukuhani namutisa imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omukuhani akhole omusango kwobwonooni, namutisa oyo ouli okhusiiywa khulwa obukaalibwe; mana olunyumakhwo yeere omusango kwokhusambwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuhani namala omusango omusambe nomusango kweimele khushimalilo; omukuhani namutisa ario, mana alaba omusiiye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nali omumanani ouranyala ebindu ebihela birio ta, kho abukule likondi elala lieshimwamwane liomusango kweshiuku eliokhuchelwa, okhumutisa, neshitonye shilala shieikhumi shia efa yobusie obunyushe obutsokasiibwe amafura khulwa omusango kweimele, neilogu ndala yamafura, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "namahuusi kabili, kata emisosole chibili chiamakuuku, shinga olwa anyala okhunyoola; shilala shibe shiomusango kwobwonooni, neshindi nashio shiomusango omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane, yeetse ninabio ewomukuhani, hamuliango weliheema liokhwakaana, imbeli w, khulwa okhusiiywakhwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani abukule likondi liomusango kweshiuku neilogu yamafura tsana, omukuhani abichele imbeli w, bibe omusango kwokhuchelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yeere likondi tsana liomusango kweshiuku, omukuhani nabukula khumalasile akomusango kweshiuku, nakara khubutsunzu bweshirwi shisaatsa shia oyo ouli okhusiiywa, khandi khulwala olukali Iwomukhonokwe musaatsa, khandi khushino eshikali shieshilenjeshie shisaatsa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omukuhani atsushekhwo khumafura ako mushikalo shiomukhono mukhasi okukwe omwene; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani amiitsekhwo nolwalalwe olusaatsa akokhumafura akali mumukhonokwe mukhasi imbeli w okhuula musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani arekhwo akokhumafura akali mumukhonokwe khubutsunzu bweshirwi shisaatsa shia oyo ouli okhusiiywa, khandi khulwala olukali Iwomukhonokwe musaatsa, khandi khushino eshikali shieshilenjeshie shisaatsa, habundu hosi aha amalasile komusango kweshiuku kareebwa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "namafura akashitong'a mumukhono kwomukuhani akare khumurwe kwa oyo ouli okhusiiywa, okhumutisa imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana amale elala khumahuusi kata khumisosole chiamakuuku, shinga olwa anyalile okhunyoola, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu elala liomusango kwobwonooni nelindi liomusango omusambe, halala nomusango kweimele; naye omukuhani amutise oyo ouli okhusiiywa imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amalako khuka oyo owa oluumbe Iwobuchele buli muye, ne naranyala okhunyoola ebiene ebikhoyeele okhusii-ywakhwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa naHaruni ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa mulaba nimwinjiile mushialo shiaKanaani, eshia emuheelesia shibe eshieenywe, ne niramwo oluumbe Iwobuchele munzu yosi eyomushialo eshili eshieenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omwenenzu tsana niyeetsa naboolela omukuhani ari Isie enduutsi mbu fwana oluumbe lundi lulimwo munzu yanje; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani alache mbu barusie ebindu biosi ebili munzu omwo, omukuhani mwene narashieenjila okhulola aholuumbe ta, mbu biosi ebili munzu bileshe okhukwisibwa bibe omusilo; nolunyumakhwo omukuhani yee-njile okhulola inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ahenjelesie haluumbe; ne oluumbe niluba niluli mwisiisi lieinzu, shinga tsikhombekhwo, etsiobukondo bweisuutsa kata tsiranzayi, nitsilolekha shinga etsihobooshekhwo mwisiisi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani arule munzu, okhuula khumuliango weinzu, niyeekala inzu eyo tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunya-nga yomusaafu omukuhani akalushe, ahenjelesie; ne haluumbe nihaba nihalandile khwisiisi lieinzu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukuhani abalache mbu balikulule amachina aka oluumbe lulimwo, bakafuube habundu ahali homusilo, elwanyi welitaala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abalache okhuhalakara munzu mukari, aharondokhanaho; mana litoyi elia bahalakarakhwo balitsushe elwanyi welitaala, habundu ahali homusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana babukule amachina kandi, bakare mushilenje shiamachina kalia; naye abukule litoyi liyia, ahoome inzu tsana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oluumbe niluba nilukalukha khandi nilurubukha munzu omwo olunyuma Iwokhurusiamwo amachina, nokhuhalakara inzu, nokhuchihooma, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani yeenjile, ahenje; ne oluumbe niluba nilulandile munzu, nibwo obuchele obunyanya obuli munzu; nomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho alikulule inzu, amachina kayo, nemisaala chiayo, nelitoyi liosi lieinzu tsana; mana abichinje, abirusie mwitaala, okhuula habundu ahali homusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi owinjila munzu omwo tsindaalo etsio tsiosi olwa yibeetsanga niyiikaale, abe mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi oukona munzu omwo, yoosie tsingubotsie; kata ouliila munzu omwo, yesi yoosie tsingubotsie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omukuhani naba niyeenjila, nahenjelesia, ne haluumbe niharalandile munzu omwo olunyuma Iwokhuhoomwa khweinzu ta; kho omukuhani arumbule mbu inzu tsana neisiiye, shichila oluumbe luhonile. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa okhusiiya inzu abukule amanyonyi kabili, nolusaala Iwomusiita, neingubo iranzayi, namabinu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana yeerele linyonyi elala khu ako khulutaabo, ikulu wamatsi komuchela akabiranga; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana abukule olusaala tsana Iwomusiita, namabinu, neingubo iranzayi, nelinyonyi elishili mwoyo, abiine mumalasile kelinyonyi eliirilwe, khandi mumatsi ako komuchela akabiranga, namiitsa khunzu okhuula musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho asiiye inzu namalasile kelinyonyi khandi namatsi komuchela akabiranga, khandi nelinyonyi elili mwoyo, khandi nolusaala Iwomusiita, namabinu, neingubo iranzayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana alekhuule linyonyi tsana elishili mwoyo, lirule mwitaala litsie mumikunda ebulafu; kho ario atise inzu; nayo yilaba isiiye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
