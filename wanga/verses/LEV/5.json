          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba nakhola akobukhobani, niyoonoona khulwa okhukorwa mwikhuwa liebitakatifu biOMWAMI, kho yeetse ewOMWAMI nomusangokwe kweshiuku, mbu limiiku elibula obulema eliomubiayo, elia olachela obukusi bwalio tsishekeli tsieifeetsa, nochela khushekeli yahabundu ahatakatifu, libe omusango kweshiuku; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi arunje shieneshio eshia yoonoonela khubitakatifu, nameetakhwo eshitonye shiakharaano, namuheelesia omukuhani; naye omukuhani amutise limiiku liomusango kweshiuku, naye alaleshelwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
