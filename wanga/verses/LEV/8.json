    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwahulwi bwaHaruni nabaanabe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukula Haruni nabaanabe bosi, nebiifwalo, namafura akokhutsushiilila, neisumsi yomusango kwobwonooni, namamiiku kabili tsana, neshimwelo shiemikaate echibulamwo amamela; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana okhung'aasie omukhung'aano kwosi hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nakhola shinga OMWAMI olwa yamulaka; nakwo omukhung'aano nikukhung'aasibwa hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nasunjila omukhung'aano ari Kano niko aka OMWAMI yalaka mbu kakholwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa niyeetsa nende Haruni nabaanabe nabasinga amatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namufwala likoti tsana, namuboha omushiipi, namufwala ikanzu yene, nara ifoti tsana khuye, namuboha omushiipi kwobulushi bwamang'oole kweifoti, nachiboha ario. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namurakhwo iloloti eyokhushilifu tsana, ne muloloti yaramwo Urimu nende Tsumimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nara eshilemba khumurwekwe; ne khushilemba tsana, khulubeka weimbeli, yara eshimuli eshipaapale shieitsahaabu, olusimbi olutakatifu; shinga OMWAMI olwa yalaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nabukula amafura ako akokhutsushiilila, natsushiilila eshimenyo nende biosi ebialimwo, nabiahula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namiitsa khushimalilo okhuula musaafu, natsushiilila eshimalilo nebimanulwa biashio biosi, nende olutaabo neshichibi shialwo, okhubiahula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsukhakhwo amafura kokhutsushiilila khumurwe kwaHaruni, namutsushiilila, okhumwahula. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa naleera abaana baHaruni, nabafwala amakoti, nababoha emishiipi, nababohakhwo tsingofia; shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana niyeetsa nende isurusi tsana yomusango kwobwonooni; nabo Haruni nabaanabe nibara amakhono khumurwe kweisurusi yomusango kwobwonooni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nachiira, nabukula khumalasile, nakara khunzika tsieshimalilo tsimbeka tsiosi nende olwala, nasiiya eshimalilo; natsukha amalasile hasi weshimalilo, nashiahula, okhushitisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula amasinya kosi akali khumala, nolufuurilo Iweshini, netsifiko tsibili tsiombi, namasinya katsio; kho Musa nakasambila khushimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isurusi yene, neliseelo liayo, neinyama, nobuse, yabisamba nomulilo elwanyi weikambi; shinga OMWAMI olwa yalaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yaleera limiiku liomusango kwokhusambwa; Haruni nabaanabe nibara amakhono khumurwe kwelimiiku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa naliira, niyooha amalasile khushimalilo tsimbeka tsiosi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nafwona limiiku ebitonye; mana Musa nasamba omurwe, nebitonye tsana, namasinya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyoosia amala nebilenje namatsi; mana Musa nasambila limiiku liosi khushimalilo; nikuba omusango omusambe kweshiuya eshilayi; neshihaanwa shiOMWAMI eshikholelwa omulilo; shinga OMWAMI olwa yalaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naleera elindi, mbu limiiku liobwahulwi; Haruni nabaanabe nibara amakhono khumurwe kwelimiiku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa naliira, nabukula khumalasile kalio, nakabakha khubutsunzu bweshirwi eshisaatsa shiaHaruni, khandi khulwala olukali Iwomukhonokwe musaatsa, khandi khushino eshikali shieshilenjeshie shisaatsa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baHaruni nibaleerwa, Musa nabakhakhwo amalaoile khubutsunzu bwamarwi kabwe amasaatsa, khandi khunzala tsingali tsiemikhono chiabwe emisaatsa khandi khubino ebikali biebilenje biabwe ebisaatsa; Musa niyooha amalasile khushimalilo tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabukula amasinya, neisembe, namasinya kosi akali khumala, nolufuurilo Iweshini, netsifiko tsibili tsiombi, namasinya katsio, neshiatakho eshisaatsa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhurula mushimwelo shiemikaate echibulamwo amamela eshiali nishili imbeli wOMWAMI yabukula eliandasi elala, nomukaate mulala kwamafura, neshisikuti shilala, nabira khumasinya nokhushiatakho eshisaatsa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabira biosi khubikalo biaHaruni khandi khubikalo biabaanabe, nabichela imbeli wOMWAMI bibe omusango kwokhuchelwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nabibukula mumakhono kabwe, nabisambila khushimalilo, khumusango omusambe; biali eshihaanwa shiobwahulwi shieshiuya eshilayi, eshihaanwa eshikholelwa omulilo khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nabukula itakata nachichela yibe omusango kwokhuchelwa imbeli wOMWAMI; nikwo omukabo kwaMusa okwokhwimiiku liobwahulwi; shinga OMWAMI olwa yalaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
