            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshihaanwa shiaHaruni nende eshiabaanabe, eshia baleerele OMWAMI khunyanga olwa atsushiililwa amafura, shieshino; mbu eshitonye shielikhumi shia efa ndala yobusie obunyushe khulwa omusango kweimele khatsotselo, eshitonye mutsuli neshitonye mungoloobe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shikholelwe amafura, khuluchio olwokhusambilakhwo j olwa shiba nishitsokasiibwe bulayi, kho winjile ninashio; oleere ebitonye biashio ebifumbuukhu, shinga omusango kweimele, eshiuya eshilayi khuMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani owokhubaanabe owatsushiililwa amafura, oulakalusibwa mushilenjeshie, nbe oushileera; nelikhuwa elilachilisibwa lietsindaalo tsiosi; lisambilwe OMWAMI liosi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli musango kweimele kwomukuhani kusambwe liosi pe; shikulaliibwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
