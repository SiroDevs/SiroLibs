            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuu ndu yesi naba niyoonoona nakholela OMWAMI akobukhobani, nakaatia owashie mwikhuwa liesbiechekho, kata omusingo, kata eliobwibi, kata eliokhusandia owashie; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata niyanyoola eshindu eshiali nishikorile, nakhola akobukaatii, niyeetsuba akobubeeyi; mwikhuwa liosi khukano aka abandu bakholanga niboonoona; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho naba niyoonoona nali neshiuku toto, akalusie shieneshio eshia yabukula munjila yobwibi, kata eshia yanyoola munjila yobusandii, kata eshia yeechekhwa, kata eshiakora naye nashinyoola, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4",
            "verseOrgIds": [
              "LEV.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata eshindu shiosi eshia yeetsubilakhwo akobubeeyi; ashikalusie shiosi, nashimeetakhwo eshitonye shiakharaano; amuheelesie omweneshio khunyanga olwa aleera omusangokwe kweshiuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.5",
            "verseOrgIds": [
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeetse ewOMWAMI nomusangokwe kweshiuku, mbu limiiku elibula obulema eliomubiayo, elia olachela obukusi, libe omusango kweshiuku, nilileerelwa omukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani amutise imbeli w; naye alaleshelwa khwikhuwa liosi elia omundu akhola naba neshiuku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako kandi khukemisango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
