          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli shindu eshia aba nakonilekhwo nali nobukaalibwe, shibe shiomusilo; kata nende buli shindu eshia aba niyeekhaalekhwo, nashio shibe shiomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
