          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane abukule amahuusi kabili kata emisosole chiamakuuku chibili, yeetse ninabio ewomukuhani, hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
