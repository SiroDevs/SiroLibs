          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omukhasi naba narula mumubilikwe amatsayi, nikali akokhutsia mumwesi, abe mubukaalibwe tsindaalo musaafu; nomundu yesi oumutiilakhwo abe mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
