          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusaatsa yesi naba niyeeloorelela, yeesinje omubilikwe mumatsi, naba mwibihl okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata buli ngubo kata buli liseelo elilikhwo ameenyali tsana, shiosibwe mumatsi nishiba omusilo okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomusaatsa yesi owiloorelela nibali nomukhasi mubukono bulala, beesinje bombi mumatsi, nibaba mwibilu okhuula olwa bwila.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
