            "sid": "LEV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa naHaruni ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela abaana baIsiraeli mbu Omusaatsa yesi naba nali neshisununu eshirulanga mumubilikwe, khulwa eshisununushie abe mwibilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.2",
            "verseOrgIds": [
              "LEV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobukaalibwe mushisununushie buba buri nanwa; mbu omubilikwe nikuba nikuraatsa neshisununushie, kata omubilikwe nikukhaliishe mushisununushie, kho nobukaalibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.3",
            "verseOrgIds": [
              "LEV.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shitali eshia omundu oyo ouli neshisununu aba nakonilekhwo shibe shiomusilo; kata nende buli shindu eshia aba niyeekhaalekhwo nashio shibe shiomusilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.4",
            "verseOrgIds": [
              "LEV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omundu yesi ouba natiilakhwo khushitalishie, yoosie tsingubotsie, niyeesinga mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ouba niyeekhala khushindu shiosi eshia oyo ouli neshisununu yeekhaalekhwo, yoosie tsingubotsie, yeesinje mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ouba natiilakhwo khumubili kwa oyo ouli neshisununu, yoosie tsingubotsie, yeesinje mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata oyo ouli neshisununu naba namufuutsakhwo omundu ouli omusiiyikhu, kho yoosie tsingubotsie, yeesinje mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshiokhwikhalakhwo khufarasi eshia oyo ouli neshisununu aba nachendeelekhwo, shibe shiomusilo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi outiilakhwo khushindu shiosi shiosi eshibeele hasiwe, abe mwibilu okhuula olwa bwila; kata ouchinga ebindu ebio, yoosie tsingubotsie, niyeesinga mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi owa oyo ouli neshisununu aba natiilakhwo, ne nalasaabile amakhono mumatsi ta, yoosie tsingubotsie, niyeesinga mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata inyungu yosi eya oyo ouli neshisununu aba natiilakhwo, yarwe; neshimanulwa shiosi shieshibaho nashio shiosibwe mumatsi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oyo ouli neshisununu olwa aba nasiiywa eshisununushie, yeebasilie omwene tsindaalo musaafu khulwa okhusiiywakhwe, niyoosia tsingubotsie, niyeesinga omubili mumatsi komuchea akabiranga, naba omusiiye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane abukule amahuusi kabili kata emisosole chiamakuuku chibili, yeetse imbeli w hamuliango weliheema liokhwakaana, naheelesie omukuhani; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omukuhani abimale, shilala shibe omusango kwobwonooni, neshindi omusango omusambe; kho omukuhani amutise imbeli w khulwa eshisununushie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
