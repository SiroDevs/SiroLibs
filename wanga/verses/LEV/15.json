          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omukhasi naba niyeerulutsa tsindaalo tsinyinji etsirali tsindaalo tsiene tsiobukaalibwe ta, kata niyeerulutsa tsindaalo etsibira etsiobukaalibwe; tsindaalo tsiosi tsiokhwirulutsakhwe, abe mwibilu, shinga olwa abeetsanga mundaalo tsiobukaalibwe; aba mwibilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shitali eshia aba nakonakhwo mundaalo tsiokhwirulutsakhwe, shibe khuye shinga eshitali shiobukaalibwe; kata buli shindu eshia aba niyeekhalakhwo, shikwa shiomusilo, shinga omusilo kwobukaalibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
