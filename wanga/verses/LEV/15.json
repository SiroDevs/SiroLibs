            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omundu yesi ouba natiilakhwo khushindu shiosi eshia aba niyeekhaalekhwo, yoosie tsingubotsie, niyeesinga mumatsi, naba mwibilu okhuula olwa bwila. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
