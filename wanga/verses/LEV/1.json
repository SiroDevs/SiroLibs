            "sid": "LEV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI yalanga Musa, nasungana ninaye okhurula ewa yali mwiheema liokhwakaana, ari ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungana nabaana baIsiraeli, nobaboolela mbu Olwa omundu yesi khwinywe aba naleerela OMWAMI eshihaanwashie, aleere eshihaanwashie eshiokhumiruko, mbu khung'ombe kata khubiayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eshihaanwashie nishiba nishili omusango kwokhusambwa okwokhung'ombe, aleere isaatsa eyibula obulema; achileere hamuliango weliheema liokhwakaana, mbu afuchiililwe imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana are omukhonokwe khumurwe kwomusango kwokhusambwa; nakwo kulafuchiililwa khululwe, okhumutisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yeere ing'ombe tsana imbeli w; mana abaana baHaruni, abakuhani, baleere amalasile, nibakooha amalasile tsana khumbeka tsiosi tsieshimalilo eshili hamuliango weliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaache omusango kwokhusambwa nakufwona ebitonye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baHaruni omukuhani babwane omulilo khushimalilo, nibaanzakhwo tsikhwi khumulilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi abakuhani abaana baHaruni baanzekhwo ebitonye tsana, halala nomurwe namasinya, khukhwi etsio khumulilo okuli khushimalilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa amala nebilenje, abiosie namatsi; mana omukuhani achisambile yosi khushimalilo yibe omusango omusambe, eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshihaanwashie nishiba nishili eshiokhubiayo, khumakondi kata khumbusi, khulwa omusango kwokhusambwa, aleere eshisaatsa eshibula obulema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashiirile elubeka Iweshimalilo enotsi, imbeli w; nabo abaana baHaruni, abakuhani, boohe amalasile kashio khushimalilo tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ashifwone ebitonye, halala nomurwe namasinya; naye omukuhani abianzekhwo khukhwi etsiokhumulilo okuli khushimalilo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.12",
            "verseOrgIds": [
              "LEV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa amala nebilenje, abiosie namatsi; mana omukuhani ashileere shiosi, ashisambile khushimalilo; nomusango omusambe, eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
