          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata eshihaanwashie khuMWAMI nishiba nishili omusango kwokhusambwa kwamanyonyi, kho aleere eshihaanwashie shiamahuusi kata emisosole chiamakuuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani alileere khushimalilo, aborole likosi nafwonola omurwe nalisambila khushimalilo; amalasile kalio nako karaatsile khulubeka Iweshimalilo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ayiniemwo libootselo namabaha, nabisukuna mushibero weshimalilo ebukwe, habundu welikoshe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "naliabula tsimbaha, oburaliarasilia elala ta; mana omukuhani alisambile khushimalilo, khukhwi etsiokhumulilo; nomusango omusambe, eshihaanwa eshikholelwa omulilo, shieshiuya eshilayi khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        }
      ]
