        },
        {
          "text": "Omukabo kwambeli kwarulila mukha nikukwila Asafu, khuYusufu; okwakhabili khuGedalia; ye nabaana babwe nabaanabe bali ekhumi nababili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
