    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Daudi nabaseesia belihe nibaahula abandi abokhubaana baAsafu, nabaHemani, nabaYedutsuni, khulwa obukhalabani, okhulakulilanga mubukhana, namatungu, nebisili; nobunji bwabo abakholanga emilimo, obukhalabani bwabwe shinga olwa bwali, mbwobuno; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "khubaana baAsafu; Zakuri, Yusufu, Netsania, naAsharela, abaana baAsafu; abali mubunyali bwaAsafu, owalakulanga khulwa lilako liomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhuYedutsuni; abaana baYedutsuni; mbu Gedalia, Zeri, Yeshaya, Shimei, Hashabia naMatitsia, basasaba; abali mubunyali bwasaabwe, Yedutsuni omuupi wobukhana, owalakulanga nakhupa orio namwitsoomia OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhuHemani; abaana baHemani; mbu Bukia, Matania, Uzieli, Shebueli, Yerimotsi, Hanania Hanani, Eliatsa, Gidaliti, naRomamuti-ezeri, Yoshibekasha, Malotsi, Hotsiri, naMahaziotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi bali abaana baHemani, omunabii womuruchi, amakhuwa kaNyasaye shinga olwa kali mbu yakhamuchinguula. Nyasaye namuheelesia Hemani abaana abasiani ekhumi nabane, nabakhaana bataru. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi bali mubunyali bwasaabwe khulwa tsinyimbo munzu yOMWAMI halala nende ebisili, namatungu, nobukhana, khulwa obukhalabani bwomunzu yaNyasaye; banga Asafu naYedutsuni naHemani nibali mubunyali bwomuruchi mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obukhumi bwabwe, halala nende abaana babwe abeechesibwa okhwimbila OMWAMI, bosi abali abasitsa, bwali ebikhumi bibili amakhumi munaane namunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bakhupilwa ikha khulwa emilimo chiabwe, bosi halala, ari omutuutu ari omukhongo, ari omwechesia ari omwechi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
      ]
    },
    {
