  "reference": "1 Aketsindaalo 21",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1CH 21"
      },
      "items": [
        {
