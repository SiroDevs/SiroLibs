          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yabala abaIsiraeli nabaYuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Setani yasinjila okhuseera Isiraeli namutsuuba Daudi okhubala Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.1",
            "verseOrgIds": [
              "1CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yamusunjila Yoabu nende abakhulundu babandu, ari Tsie mubale Isiraeli, okhurula eBeeri-sheba okhuula eDani; mundeerele amakhuwa, emanye obukhumi bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.2",
            "verseOrgIds": [
              "1CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoabu nasunga mbu OMWAMI yeenjiyie abandube akhandi eshikhumi okhushila shinga olwa bali! Ne omwami wanje omuruchi, shibali bosi abasumba bomwami wanje? Omwami, wenyile likhuwa lino mbushiina? Mbushiina nochila Isiraeli niyiba neshikha? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.3",
            "verseOrgIds": [
              "1CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula likhuwa liomuruchi liamushila Yoabu. Kho Yoabu yarulayo, natsia okhulambuula Isiraeli yosi, niyoola eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.4",
            "verseOrgIds": [
              "1CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoabu naboolela omuruchi obukhumi bwobubasii bwabandu. Ne abaIsiraeli bosi bali ebikhumila eshikhumila nende eshikhumi, abasaatsa betsinganga; abaYuda nibaba abasaatsa betsinganga ebikhumila ebikhumi bine namakhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.5",
            "verseOrgIds": [
              "1CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abaLawi nabaBenyamini, shiyababalakhwo ta; okhuba likhuwa homuruchi liamusinya Yoabu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.6",
            "verseOrgIds": [
              "1CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Nyasaye shiyachama likhmwa elo ta; ne yakhupa isiraeli khulwalio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.7",
            "verseOrgIds": [
              "1CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi nasunjila Nyasaye mbu Ndoonoonile muno khwikhuwa lino elia ekholile; ne bulaano ekhusaaya mbu orusieho obumayaanu bwomusumbawo; okhuba ekholile akobusilu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.8",
            "verseOrgIds": [
              "1CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI nasunjila Gadi, omulakusi waDaudi, ari ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.9",
            "verseOrgIds": [
              "1CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsia oboolele Daudi mbu Aka OMWAMI aboola ngakano; mbu Era imbeliwo amakhuwa kataru; wilobolele elala khuko, elia ekhukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Gadi namutsiila Daudi, namusunjila ari Kano niko aka OMWAMI aboola; mbu Lobola elia wenya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu emiyika chitaru chieinzala; kata emiesi chitaru chiokhumalilanwa imbeli wabasukubo, tsinganga tsiabasukubo nitsikhulondachilila; kata tsindaalo tsitaru tsiolukanga lwOMWAMI, nikvo oluumbe mushialo malaika w namululanga mumbali mwosi mwaIsiraeli. Kho bulaano oyililisie khwikalusia elia ndalamukalusia oyo ourumile. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Gadi ari Kandinyiile muno; kho bulaano engwe mumukhono kwOMWAMI; okhuba tsimbabasitsie netsinyinji muno; ne endeshe okhukwa mumukhono kwomundu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI narumila Isiraeli oluumbe; abandu baIsiraeli nibakwisibwa nibafwa ebikhumila amakhumi musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naruma malaika eYerusalemu okhulimulula; ne olwa yali nali okhulimulula, OMWAMI yalola, natsuunwa omwoyo khulwa obubii obwo, nasunjila malaika omumululi ari Kahelile; bulaano yeesia omukhonokwo. Ne malaika wOMWAMI yali nasinjiile halutse lwaOrinani, omuYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nachinguula tsimoni, nalola malaika w nasinjiile hakari weshialo nende likulu, nali nende olukanga olutsomole mu nukhono, nalunyiilile ikulu waYerusalemu. Mana Daudi nende abakofu nibasikama mbabunamia obweni, nibeerwalile ebiifwalo biamakunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.16",
            "verseOrgIds": [
              "1CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Nyasaye mbu Shindi isie owalaka mbu abandu babalwe? Nisie oweonoonile nikhola obubii muno; ne amakondi kano, nako kakholile shiina? Ekhusaaya, OMWAMI Nyasaye wanje, omukhonokwo kube khwisie, khandi nende khushilibwa shieefwe; ne kuleshe okhuba khubandubo, oluumbe luraba khubo ta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.17",
            "verseOrgIds": [
              "1CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana malaika wOMWAMI yalaka Gadi ekhuboolela Daudi mbu Daudi atikulushe, asinjisilie OMWAMI eshimalilo mulutse lwaOrinani OmuYebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi natikulukha, khulwa likhuwa liaGadi elia yaboola muliira liOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.19",
            "verseOrgIds": [
              "1CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Orinani yali nahuulanga ingano; ne yakhupa amashemo, nalola malaika; abaanabe bane aba yaliyo ninabo nibeebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
              "1CH.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Daudi yoola ewaOrinani, Orinani yahenga, nalola Daudi, narula khulutse, niyeenamila Daudi, nabunamia Gbwenibwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi namusunjila Orinani ari Umbe halutse hano, enyumbashileho OMWAMI eshimalilo; naumbe kkubukusii obulamba; mbu oluumbe luyinjilwe mubandu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Orinani nakalusia Daudi ari Olubukule; okhole akali amalayi mumonitsio, omwami wanje omuruchi; lola, ekhuha buha tsing'ombe, tsibe emisango emisambe, nebihuulilo bibe tsikhwi, neingano yibe omusango kweimele; biosi embihaana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi Daudi namukaania Orinani, ari Tawe; habula ndalabikula khubukusii obulamba; okhuba shindalabukula ebili ebibio khulwa OMWAMI, kata okhumala omusango okurali okwobukusii ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.24",
            "verseOrgIds": [
              "1CH.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Daudi yaheelesia Orinani itsahaabu eyachelwa tsitalanda ebikhumi bisasaba khulwa habundu tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.25",
            "verseOrgIds": [
              "1CH.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi niyoombashila OMWAMI eshimalilo habwenaho, namala emisango emisambe nemisango chiokhwishia, nahaabila OMWAMI; naye namukalusia okhurula mwikulu mumulilo khushimalilo shiemisango emisambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namulaka malaika; naye nakalusia olukangalwe muluula lwalwo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Habundu ahokkuumbashilakhwo Ihekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khushise eshio, olwa Daudi yalola mbu OMWAMI umukalusiyemwo halutse lwaOrinani omuYebusi, yamalilayo emisango. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
