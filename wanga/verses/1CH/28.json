{
  "id": "1CH.28",
  "number": "28",
  "bookId": "1CH",
  "reference": "1 Aketsindaalo 28",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "1CH 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi yakaamila Sulemani emilimo chiokhuumbakha Ihekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yakhung'aasilia eYerusalemu abakhulundu bosi baIsiraeli, abakhulundu betsimbia, nabasinjilili betsing'anda tsia abo abakhalabanilanga omuruchi, nabaseesia bebikhumila, nabaseesia bebikhumi, nabasinjilili bemiandu nemiruko chiomuruchi nende echiabaanabe, halala nende abakali, nende abalulu nende abaseeri abeitswoni bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.1",
            "verseOrgIds": [
              "1CH.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi omuruchi yabuukha nasinjila, nasunga mbu Mumbulile, inywe abaana beefwe, nabandu banje. Khulwanje, omwoyo kwanje kwali nikwenya okhuumbashila lisanduku lieindakano yOMWAMI inzu yobuhuluushi, khandi khulwa Nyasaye weefwe okhulambisiakhwo ebilenje; ne ndali nirecheeshe ebindu biobumbaashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.2",
            "verseOrgIds": [
              "1CH.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Nyasaye yangaania, mbu Shioloombashila eliira lianje inzu ta, shichila oli omunduwelihe, khandi weebeenia amatsayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.3",
            "verseOrgIds": [
              "1CH.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI, Nyasaye waIsiraeli, yandobola mubeinzu yapapa bosi, okhuba omuruchi ouruka Isiraeli obushia nobushia. Okhuba yalobola Yuda abe omwimilisi; nomunzu yaYuda, inzu yapapa; nomubaana bapapa, yanjama isie, niyanyemekha embe omuruchi waIsiraeli yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.4",
            "verseOrgIds": [
              "1CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubaana banje bosi, okhuba OMWAMI yambeelesia abaana abanji, yalobola Sulemani omwana wanje okhwikhala khushifumbi shioburuchi bwOMWAMI khuIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.5",
            "verseOrgIds": [
              "1CH.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yamboolela mbu Sulemani omwanawo niye ouloombakha inzu yanje netsinyanyi tsianje; okhuba ndamulobola abe omwana wanje, nasi ndalabeetsanga samwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.6",
            "verseOrgIds": [
              "1CH.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalaralisia oburuchibwe obushia nobushia, naba niyakhaba omutinyilifu okhukholanga akamalako kanje nakobukhalachi bwanje shinga olwa akholanga leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.7",
            "verseOrgIds": [
              "1CH.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, Isiraeli yosi, nibo omukhung'aano kwOMWAMI, nibalolanga, khandi Nyasaye weefwe nahulilanga, mwitsulile nimurunilisia amalako kosi OMWAMI Nyasaye weenywe; mbu eshialo eshilayi shino shibe eshieenywe, nimushilaamila abaana beenywe abamulonda, inziayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.8",
            "verseOrgIds": [
              "1CH.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, Sulemani omwana wanje, omanye Nyasaye waso, nomukhalabanila nende omwoyo omweleleshe namapaaro akobwihaani, okhuba OMWAMI arunilisinjia akemioyo chiosi, namanyilisia obuyililisii bwosi bwamapaaro; noba nomukhaaba, alakhunyooleshela; ne noba nomulekha, alakhwibala obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.9",
            "verseOrgIds": [
              "1CH.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulaano wirecheshe; okhuba OMWAMI yakhulobola iwe okhuumbakha inzu yibe hzbandu ahatakatifu; witinyie, okhole.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.10",
            "verseOrgIds": [
              "1CH.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Daudi naheelesia Sulemani omwanawe omufwano kweshirookoola shieihekalu, no-kwetsinzu tsiayo, nokwamabiishilo kwayo, nokwebisika biayo biahekulu, nokwebisika biayo biomukari, nokwahabundu helitisilo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.11",
            "verseOrgIds": [
              "1CH.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende omufwano kwabiosi ebiali mumwoyokwe khulwa tsinyanyi tsieinzu yOMWAMI, khulwa ebisika biosi tsimbeka tsiosi, khulwa amabiishilo keinzu yaNyasaye, khandi khulwa amabiishilo kebindu ebiahule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.12",
            "verseOrgIds": [
              "1CH.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khulwa emikanda chiabakuhani nabaLawi, khulwa emilimo chiosi chiobukhalabani bweinzu yOMWAMI, nokhulwa ebimanulwa biosi biobukhalabani munzu yOMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.13",
            "verseOrgIds": [
              "1CH.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "obusiro bweitsahaabu yebimanulwa bieitsahaabu biabuli bukhalabani; obusiro bwebimanulwa bieifeetsa biabuli bukhalabani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.14",
            "verseOrgIds": [
              "1CH.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "obusiro khandi bwebichibi bietsitaha bieitsahaabu nende tsitaha tsiabio; obusiro bweitsahaabu yabuli shichibi nende tsitaha tsiashio; obusiro bweifeetsa yeshichibi shietsitaha nende tsitaha tsiashio, emilimo chiabuli shichibi shinga olwa chiali; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.15",
            "verseOrgIds": [
              "1CH.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "obusiro bweitsahaabu yetsimeesa tsiemikaate echiokhubaho, eya buli meesa; neifeetsa yetsimeesa tsieifeetsa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.16",
            "verseOrgIds": [
              "1CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitsahaabu inzeleleshe yamakhango, netsindaabo, nebikombe; khulwa tsindaabo tsieitsahaabu, nobusiro bwabuli lutaabo; khulwa tsindaabo tsieifeetsa, nobusiro bwabuli lutaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.17",
            "verseOrgIds": [
              "1CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obusiro bweitsahaabu eyasaalulwa eyeshimalilo shiamalesi kelibuuliesi; nomufwano kwelikaari lieitsahaabu liabakerubi ababambula tsimbaha tsiabwe nibafuunikha lisanduku lieindakano yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.18",
            "verseOrgIds": [
              "1CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nasunga mbu Ako kosi ndakamanyiliibwe mumahandiiko akarula mumukhono kwOMWAMI, mbu emilimo chiosi chiomufwano kuno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.19",
            "verseOrgIds": [
              "1CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nasunjila Suleman omwanawe ari Witinyie, wume ikholo, okhole bukhola; oraria kata okhufwa omwoyo ta; okhuba OMWAMI Nyasaye, niye Nyasaye wanje, ali ninawe; shialakhwibala kata okhukhulekha ta, okhuula olwa emilimo chiosi khulwa obukhalabani bweinzu yOMWAMI chilaba nichihweele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.20",
            "verseOrgIds": [
              "1CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lola, emikanda chiabakuhani nabaLawi njiechio, khulwa obukhalabani bwosi bweinzu yaNyasaye; ne mumilimo chietsimbia tsiosi, olabeetsanga nende buli mundu wobusitsa bwosi owihaanile; khandi abeemilisi nabandu bosi balahuliililanga elala amalakoko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.28.21",
            "verseOrgIds": [
              "1CH.28.21"
            ]
          }
        }
      ]
    }
  ],
