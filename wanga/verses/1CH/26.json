{
  "id": "1CH.26",
  "number": "26",
  "bookId": "1CH",
  "reference": "1 Aketsindaalo 26",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "1CH 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalindi bebilibwa, nabasinjilili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwa emikanda chiabalindi bebilibwa; khubaKora, Meshelemia waKore, owo khubaana baAsafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.1",
            "verseOrgIds": [
              "1CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Meshelemia yali nende abaana; mbu Zekaria owambeli, Yediaeli owakhabili, Zebedia owakhataru, Yatsinieli owakhane, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.2",
            "verseOrgIds": [
              "1CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elamu owakharaano, Yehohanani owakhasasaba, Eliehoenai owomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.3",
            "verseOrgIds": [
              "1CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Obededomu yali nende abaana; mbu Shemaya owambeli, Yehozabadi owakhabili, Yoa owakhataru, Sakari owakhane, Netsaneli owakharaano, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.4",
            "verseOrgIds": [
              "1CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amieli owakhasasaba, Isakhari owomusaafu, Peuletsai owomunaane; okhuba Nyasaye yamuheelesia ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.5",
            "verseOrgIds": [
              "1CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Shemaya omwanawe yeebula abaana, abaruka eshilibwa shiabwe; okhuba bali abalulu beitswoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.6",
            "verseOrgIds": [
              "1CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baShemaya; mbu Otsini, Refaeli, Obedi, Elizabadi aba abaana babwe bali abeitswoni, mbu Elihu naSemakhia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.7",
            "verseOrgIds": [
              "1CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi bali abaana baObededomu; bo, nabaana aba beebula, nabaana babwe abandu bobunyali abahela obukhalabani; abandu amakhumi kasasaba nababili baObededomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.8",
            "verseOrgIds": [
              "1CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Meshelemia yali nende abaanabe, nende abaana babwe, abandu beitswoni, ekhumi nomunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.9",
            "verseOrgIds": [
              "1CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hosa yesi, owokhubaana baMerari, yali nende abaana; mbu Shimiri omukhulundu; okhuba kata narali omwikulanda ta, samwana yamukhola omukhulundu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.10",
            "verseOrgIds": [
              "1CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikia owakhabili, Tebalia owakhataru, Zakaria owakhane; abaana bosi baHosa, nabaana babwe, bali ekhumi nabataru.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.11",
            "verseOrgIds": [
              "1CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emikanda chiabalindi bebilibwa chiali khubeenabo, khubandu abakhulundu, nibali nende obulindi shinga obwabaana babwe, okhukhalabanila munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.12",
            "verseOrgIds": [
              "1CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhupila buli shilibwa ikha, ari abatuutu ari abal hongo, ebilibwa biabwe shinga olwa biali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.13",
            "verseOrgIds": [
              "1CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulindi bwebukwe nibukwila Shelemia. Mana nibamukhupila ikha Zekaria omwanawe, omuchesiyii omurechelefu, obulindibwe nibuba enotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.14",
            "verseOrgIds": [
              "1CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ObwaObededomu bwali obwesautsi, nobwabaanabe, libiishilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.15",
            "verseOrgIds": [
              "1CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ObwaShupimu naHosa bwali mumbo, hashilibwa shiaShalekhetsi, hanjila yeshitikulukho. Obulindi bwosi nibuhelana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.16",
            "verseOrgIds": [
              "1CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "elubeka Iwebukwe abaLawi basasaba buli nyanga; enotsi bane buli nyanga; esautsi bane buli nyanga; ne khulwa libiishilo, babili babili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.17",
            "verseOrgIds": [
              "1CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamakuru kebunambo, bane hanjila, nababili hamakuru keene. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.18",
            "verseOrgIds": [
              "1CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echio chiali emikanda chiabalindi bebilibwa, khubaana babaKora nende khubaana baMerari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.19",
            "verseOrgIds": [
              "1CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhubaLawi, Ahiya yasinjilila amabiishilo keinzu yaNyasaye, namabiishilo kebindu ebiahule. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.20",
            "verseOrgIds": [
              "1CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baLadani; abaana babaGerishoni abali baLadani, abeemilisi bebilibwa biaLadani omuGerishoni; mbu Yehieli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.21",
            "verseOrgIds": [
              "1CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baYehieli, Zetsamu naYoeli omwana wabwe, basinjilila amabiishilo keinzu YOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.22",
            "verseOrgIds": [
              "1CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhubaAmuramu, khubaIzihari, khubaHeberoni, khubaUzieli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.23",
            "verseOrgIds": [
              "1CH.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Shebueli waGerishomu waMusa niye owarukanga akamabiishilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana babwe; abaEliezeri, Rehabia omwanawe, naYeshaya waRehabia, naYoramu waYeshaya, naZikhiri waYoramu, naShelomotsi waZikhiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelomotsi watsana nabaana babwe basinjilila amabiishilo kosi kebindu ebiahule, ebia Daudi omuruchi nende abeemilisi bebilibwa, nabaseesia bebikhumila nabebikhumi, nabaseesia belihe, bali nibaahula. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubiyaayo ebianyoolwa mubusoolo baahula ebindi khulwa ol hukasia inzu yOMWAMI aha yakhaba niyoonooneeshekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nende biosi ebia Samweli omulakuli, naSaulo waKishi, naAbineri waNeri, naYoabu waZeruya, bali nibaahula; kata eshia omundu yesi yesi yaahula, shiali mubulindi bwaShelomotsi nende abaana babwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhubaIzihari, Khenania nende abaanabe bareebwa khumilimo chielwanyi muIsiraeli, babe abakali nabayaasii. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhubaHeberoni, Hashabia nabaana babwe, abandu beitswoni, eshikhumila nebikhumi musaafu, basinjilila Isiraeli injelekha waYorodani mumbo; khulwa emilimo chiOMWAMI, khandi khulwa obukhalabani bwomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "KhubaHeberoni, Yeriya yali omukhulundu owabaHeberoni, tsinzibulo tsiabwe shinga olwa tsiali, mubilibwa biabwe. Ne mumuyika kwamakhumi kane kwoburuchi bwaDaudi bakhaabwa; ne abandu abalulu beitswoni banyoolwa mubo eYazeri liaGileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana babwe, abandu beitswoni, bali ebikhumila bibili nebikhumi musaafu, abeemilisi bebilibwa, aba Daudi omuruchi yakhola babe abasinjilili khubaReubeni nabaGadi, nabeinusu yoluyia lwabaManase, khulwa kosi akali akaNyasaye, khandi khulwa amakhuwa komuruchi. Abakali abakhalabanila omuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
