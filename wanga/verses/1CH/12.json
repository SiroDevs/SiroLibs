          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.37",
            "verseOrgIds": [
              "1CH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi, nibali abandu belihe abamanya okhwiyanza bulayi okhulasana, beetsa eHeberoni nemioyo emieleleshe, okhwemekha Daudi abe omuruchi waIsiraeli yosi; kata nende abaIsiraeli bandi bosi basanjilana nomwoyo mulala okhwemekha Daudi muburuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.38",
            "verseOrgIds": [
              "1CH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeekhalayo nende Daudi tsindaalo tsitaru, nibalia amasabo; okhuba abaana babwe bali nibabakasiliye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abali ahambi ninabo bosi, okhuula eIsakhari naZabuloni naNafutali, beetsa nebiokhulia nibabichinjiile khusishili, nokhungamia, nokhunyumbu, nokhung'ombe; mbu ebiokhulia ebinji biobusie, namabumbi kamakhuyu, nebisakanya bietsinzabibu tsinyumu, neidivai, namafura, netsing'ombe, namakondi; okhuba kwaliho omwikhoyo muIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
        }
      ]
