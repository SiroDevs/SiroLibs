          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 33:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 33:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "From Mount Hor to the plains of Moab the Israelites set up camp at the following places: Zalmonah, Punon, Oboth, the ruins of Abarim in the territory of Moab, Dibon Gad, Almon Diblathaim, the Abarim Mountains near Mount Nebo, and in the plains of Moab across the River Jordan from Jericho, between Beth Jeshimoth and the Valley of Acacia.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41+NUM.33.42+NUM.33.43+NUM.33.44+NUM.33.45+NUM.33.46+NUM.33.47+NUM.33.48+NUM.33.49",
            "verseOrgIds": [
              "NUM.33.41",
              "NUM.33.42",
              "NUM.33.43",
              "NUM.33.44",
              "NUM.33.45",
              "NUM.33.46",
              "NUM.33.47",
              "NUM.33.48",
              "NUM.33.49"
            ]
          }
        }
      ]
    },
