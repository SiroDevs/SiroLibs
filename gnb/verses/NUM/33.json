            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "The king of Arad in southern Canaan heard that the Israelites were coming.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
