                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "At the command of the ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38+NUM.33.39",
            "verseOrgIds": [
              "NUM.33.38",
              "NUM.33.39"
            ]
          }
        },
        {
          "text": ", Aaron the priest climbed Mount Hor. At the age of 123 he died there on the first day of the fifth month of the fortieth year after the Israelites had left Egypt.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38+NUM.33.39",
            "verseOrgIds": [
              "NUM.33.38",
