        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20+NUM.1.21+NUM.1.22+NUM.1.23+NUM.1.24+NUM.1.25+NUM.1.26+NUM.1.27+NUM.1.28+NUM.1.29+NUM.1.30+NUM.1.31+NUM.1.32+NUM.1.33+NUM.1.34+NUM.1.35+NUM.1.36+NUM.1.37+NUM.1.38+NUM.1.39+NUM.1.40+NUM.1.41+NUM.1.42+NUM.1.43+NUM.1.44+NUM.1.45+NUM.1.46",
