            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the Israelites set up camp, each man will camp under the banner of his division and the flag of his own clan. The camp is to be set up all round the Tent.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        }
      ]
    },
