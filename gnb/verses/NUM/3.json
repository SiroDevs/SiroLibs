              "type": "text"
            }
          ]
        },
        {
          "text": "the 1,365 pieces of silver ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
