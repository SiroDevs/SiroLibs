                  "text": "Ps 68.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whenever the Covenant Box started out, Moses would say, “Arise, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "text": "; scatter your enemies and put to flight those who hate you!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "And whenever it stopped, he would say, “Return, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        },
        {
          "text": ", to the thousands of families of Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.36",
              "type": "text"
            },
            {
              "text": "Return",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "Israel",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "Return, LORD, you who are like an army of millions for Israel.",
              "type": "text"
            }
          ]
        }
      ]
