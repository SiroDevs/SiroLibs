              "NEH.7.68",
              "NEH.7.69"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "70",
            "style": "v",
            "sid": "NEH 7:70"
          },
          "items": [
            {
              "text": "70",
              "type": "text"
            }
          ]
        },
        {
          "text": "Many of the people contributed to help pay the cost of restoring the Temple:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.70+NEH.7.71+NEH.7.72",
            "verseOrgIds": [
              "NEH.7.70",
              "NEH.7.71",
              "NEH.7.72"
            ]
          }
        }
      ]
    },
