              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.2"
              },
              "items": [
                {
                  "text": "1 Chr 9.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.3"
              },
              "items": [
                {
                  "text": "Neh 11.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The priests, the Levites, the temple guards, the musicians, many of the ordinary people, the temple workmen — all the people of Israel — settled in the towns and cities of Judah.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.73",
            "verseOrgIds": [
              "NEH.7.73"
            ]
