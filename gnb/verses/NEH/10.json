              "attrs": {
                "loc": "DEU.15.1+DEU.15.2"
              },
              "items": [
                {
                  "text": "Deut 15.1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "If foreigners bring corn or anything else to sell to us on the Sabbath or on any other holy day, we will not buy from them.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.31",
            "verseOrgIds": [
              "NEH.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
