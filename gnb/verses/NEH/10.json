            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "We will provide for the temple worship the following: the sacred bread, the daily grain offering, the animals to be burnt each day as sacrifices, the sacred offerings for Sabbaths, New Moon Festivals, and other festivals, the other sacred offerings, the offerings to take away the sins of Israel, and anything else needed for the Temple.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.33",
            "verseOrgIds": [
              "NEH.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
