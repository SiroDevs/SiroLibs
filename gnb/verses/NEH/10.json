              "items": [
                {
                  "text": "Deut 7.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "We will not intermarry with the foreigners living in our land.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
              "NEH.10.30"
            ]
          }
        }
