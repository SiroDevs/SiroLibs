          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The first to sign was the governor, Nehemiah son of Hacaliah, and then Zedekiah signed. The following also signed:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.1",
            "verseOrgIds": [
              "NEH.10.1"
            ]
          }
        }
      ]
    },
    {
