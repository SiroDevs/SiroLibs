                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Every year we will each contribute five grammes of silver to help pay the expenses of the Temple.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.32",
            "verseOrgIds": [
              "NEH.10.32"
            ]
          }
        }
