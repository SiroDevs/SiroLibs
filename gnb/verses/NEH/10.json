              "items": [
                {
                  "text": "Deut 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "We will take to the Temple each year an offering of the first corn we harvest and of the first fruit that ripens on our trees.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        }
      ]
