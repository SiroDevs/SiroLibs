          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Peter spoke up. “Lord, if it is really you, order me to come out on the water to you.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        }
      ]
    },
