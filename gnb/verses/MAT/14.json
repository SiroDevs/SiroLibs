          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Between three and six o'clock in the morning Jesus came to the disciples, walking on the water. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "When they saw him walking on the water, they were terrified. “It's a ghost!” they said, and screamed with fear.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        }
      ]
    },
