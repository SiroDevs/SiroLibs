          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "where the people recognized Jesus. So they sent for the sick people in all the surrounding country and brought them to Jesus. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
