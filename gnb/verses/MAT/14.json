          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "They crossed the lake and came to land at Gennesaret, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
