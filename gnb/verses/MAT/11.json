              "type": "text"
            }
          ]
        },
        {
          "text": "When Jesus finished giving these instructions to his twelve disciples, he left that place and went off to teach and preach in the towns near there.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
