          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“That's true, sir,” she answered; “but even the dogs eat the leftovers that fall from their masters' table.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.27",
            "verseOrgIds": [
              "MAT.15.27"
            ]
          }
        }
