          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "The disciples asked him, “Where will we find enough food in this desert to feed this crowd?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
