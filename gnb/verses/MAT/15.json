          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Jesus answered her, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        },
        {
          "text": " And at that very moment her daughter was healed.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.28",
            "verseOrgIds": [
              "MAT.15.28"
            ]
          }
        }
      ]
