            "style": "v",
            "sid": "MAT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Why is it that your disciples disobey the teaching handed down by our ancestors? They don't wash their hands in the proper way before they eat!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.2",
            "verseOrgIds": [
              "MAT.15.2"
