                }
              ]
            }
          ]
        },
        {
          "text": "When Jesus heard that John had been put in prison, he went away to Galilee. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
