              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "and at once they left the boat and their father, and went with him.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.22",
            "verseOrgIds": [
              "MAT.4.22"
            ]
