          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“All this I will give you,” the Devil said, “if you kneel down and worship me.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
