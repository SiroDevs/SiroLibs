              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "As Jesus walked along the shore of Lake Galilee, he saw two brothers who were fishermen, Simon (called Peter) and his brother Andrew, catching fish in the lake with a net. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.18",
            "verseOrgIds": [
              "MAT.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus said to them, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.19",
            "verseOrgIds": [
              "MAT.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
