                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Jn 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "He did not stay in Nazareth, but went to live in Capernaum, a town by Lake Galilee, in the territory of Zebulun and Naphtali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "This was done to make what the prophet Isaiah had said come true:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
