{
  "id": "EZK.24",
  "number": "24",
  "bookId": "EZK",
  "reference": "Ezekiel 24",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
