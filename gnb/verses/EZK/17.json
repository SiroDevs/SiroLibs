          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
