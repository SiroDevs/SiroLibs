              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the dazzling light of the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "text": "'s presence left the entrance of the Temple and moved to a place above the creatures. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "They spread their wings and flew up from the earth while I was watching, and the wheels went with them. They paused at the east gate of the Temple, and the dazzling light was over them. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I recognized them as the same creatures which I had seen beneath the God of Israel at the River Chebar.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
