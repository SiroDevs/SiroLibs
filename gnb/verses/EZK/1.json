              "type": "text"
            }
          ]
        },
        {
          "text": "Above the heads of the creatures there was something that looked like a dome made of dazzling crystal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
