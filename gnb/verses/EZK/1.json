                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The figure seemed to be shining like bronze in the middle of a fire. It shone all over with a bright light ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
