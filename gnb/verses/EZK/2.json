                  "text": "Rev 5.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I saw a hand stretched out towards me, and it was holding a scroll. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "The hand unrolled the scroll, and I saw that there was writing on both sides — cries of grief were written there, and wails and groans.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
            ]
