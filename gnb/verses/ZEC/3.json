        },
        {
          "text": "Joshua was standing there, wearing filthy clothes. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
