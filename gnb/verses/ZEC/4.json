              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I asked him, “What do the two olive trees on either side of the lampstand mean? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "And what is the meaning of the two olive branches beside the two gold pipes from which the olive oil pours?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
      ]
