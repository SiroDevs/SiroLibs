          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“No, I don't, sir,” I replied.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        },
        {
