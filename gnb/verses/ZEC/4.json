        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Don't you know?” he asked me.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        }
      ]
    },
