              "type": "text"
            }
          ]
        },
        {
          "text": "Another message came to me from the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
