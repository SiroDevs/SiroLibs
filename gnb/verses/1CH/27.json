        },
        {
          "text": "This is the list of the Israelite heads of families and clan leaders and their officials who administered the work of the kingdom. Each month of the year a different group of 24,000 men was on duty under the commander for that month.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.1",
            "verseOrgIds": [
              "1CH.27.1"
            ]
          }
        }
      ]
    },
