              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.1+2SA.24.2+2SA.24.3+2SA.24.4+2SA.24.5+2SA.24.6+2SA.24.7+2SA.24.8+2SA.24.9+2SA.24.10+2SA.24.11+2SA.24.12+2SA.24.13+2SA.24.14+2SA.24.15"
              },
              "items": [
                {
                  "text": "2 Sam 24.1–15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.1+1CH.21.2+1CH.21.3+1CH.21.4+1CH.21.5+1CH.21.6+1CH.21.7+1CH.21.8+1CH.21.9+1CH.21.10+1CH.21.11+1CH.21.12+1CH.21.13+1CH.21.14"
              },
              "items": [
                {
                  "text": "1 Chr 21.1–14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Joab, whose mother was Zeruiah, began to take a census, but he did not complete it. God punished Israel because of this census, so the final figures were never recorded in King David's official records.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.24",
            "verseOrgIds": [
              "1CH.27.24"
            ]
          }
        }
      ]
