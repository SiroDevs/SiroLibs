        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.25+1CH.27.26+1CH.27.27+1CH.27.28+1CH.27.29+1CH.27.30+1CH.27.31",
            "verseOrgIds": [
              "1CH.27.25",
              "1CH.27.26",
              "1CH.27.27",
              "1CH.27.28",
              "1CH.27.29",
              "1CH.27.30",
