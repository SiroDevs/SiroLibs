                  "text": "26.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "King David did not take a census of the people who were under the age of twenty, because of the ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "text": "'s promise to make the people of Israel as numerous as the stars in the sky. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.23",
            "verseOrgIds": [
              "1CH.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 27:24"
