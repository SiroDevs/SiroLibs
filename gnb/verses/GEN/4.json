              "type": "text"
            },
            {
              "text": "Seth",
              "type": "text"
            },
            {
              "text": ": This name sounds like the Hebrew for “has given”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
