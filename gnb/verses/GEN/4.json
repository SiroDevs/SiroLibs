            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamech said to his wives,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.23",
            "verseOrgIds": [
              "GEN.4.23"
            ]
          }
        }
