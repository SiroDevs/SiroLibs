              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jacob said, “I have seen God face to face, and I am still alive”; so he named the place Peniel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
