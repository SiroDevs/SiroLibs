          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jacob answered, “I will give it to you if you give me your rights as the firstborn son.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        }
      ]
    },
