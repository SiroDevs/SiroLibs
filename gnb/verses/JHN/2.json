        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 2:12"
          },
          "items": [
            {
              "text": "12",
