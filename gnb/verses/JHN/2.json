            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.13"
              },
              "items": [
                {
                  "text": "Mt 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "After this, Jesus and his mother, brothers, and disciples went to Capernaum and stayed there a few days.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
