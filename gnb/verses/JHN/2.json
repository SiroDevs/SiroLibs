        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
