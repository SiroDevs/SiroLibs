              "type": "text"
            },
            {
              "text": "Some manuscripts do not have",
              "type": "text"
            },
            {
              "text": "except for their feet.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.10",
            "verseOrgIds": [
              "JHN.13.10"
            ]
