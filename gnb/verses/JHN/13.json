          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judas accepted the bread and went out at once. It was night.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
