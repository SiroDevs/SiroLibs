            "verseId": "JHN.13.7",
            "verseOrgIds": [
              "JHN.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peter declared, “Never at any time will you wash my feet!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
    },
    {
