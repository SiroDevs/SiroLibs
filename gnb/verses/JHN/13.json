        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        },
        {
          "text": " Jesus answered, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.8",
            "verseOrgIds": [
              "JHN.13.8"
            ]
          }
        }
      ]
