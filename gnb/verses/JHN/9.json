          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Jesus heard what had happened, he found the man and asked him, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        }
