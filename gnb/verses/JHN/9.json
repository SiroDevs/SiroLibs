            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "As Jesus was walking along, he saw a man who had been born blind. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "His disciples asked him, “Teacher, whose sin caused him to be born blind? Was it his own or his parents' sin?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        }
      ]
    },
