          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the entrance of the Tent they made a curtain of fine linen woven with blue, purple, and red wool and decorated with embroidery. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
