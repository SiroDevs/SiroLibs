              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "text": " made the king stubborn, and he would not let them go. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said to Moses, “Get out of my sight! Don't let me ever see you again! On the day I do, you will die!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
