                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Moses raised his hand towards the sky, and there was total darkness throughout Egypt for three days. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Egyptians could not see each other, and no one left his house during that time. But the Israelites had light where they were living.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        }
      ]
    },
