          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "The king called Moses and said, “You may go and worship the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        },
        {
          "text": "; even your women and children may go with you. But your sheep, goats, and cattle must stay here.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.24",
            "verseOrgIds": [
              "EXO.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
