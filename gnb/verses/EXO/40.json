              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "The Israelites moved their camp to another place only when the cloud lifted from the Tent. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
