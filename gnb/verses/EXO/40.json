          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "As long as the cloud stayed there, they did not move their camp. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
