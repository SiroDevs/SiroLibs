        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Of all the nations on earth, you are the only one I have known and cared for. That is what makes your sins so terrible, and that is why I must punish you for them.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.2",
            "verseOrgIds": [
              "AMO.3.2"
            ]
          }
        }
