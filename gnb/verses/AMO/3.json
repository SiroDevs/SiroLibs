                {
                  "text": "2 Kgs 23.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“On the day when I punish the people of Israel for their sins, I will destroy the altars of Bethel. The corners of every altar will be broken off and will fall to the ground. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        },
