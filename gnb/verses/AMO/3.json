          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I will destroy winter houses and summer houses. The houses decorated with ivory will fall in ruins; every large house will be destroyed.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.15",
            "verseOrgIds": [
              "AMO.3.15"
            ]
