            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "People of Jerusalem, gather your forces!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.1",
              "type": "text"
            },
            {
              "text": "Probable text",
              "type": "text"
            },
            {
              "text": "People",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "forces!",
              "type": "text"
            },
            {
              "text": "; Hebrew unclear.",
              "type": "text"
            }
          ]
        },
        {
          "text": " We are besieged! They are attacking the leader of Israel!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
