                "loc": "MRK.2.25+MRK.2.26"
              },
              "items": [
                {
                  "text": "Mk 2.25–26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.3"
              },
              "items": [
                {
                  "text": "Lk 6.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "David went to the priest Ahimelech in Nob. Ahimelech came out trembling to meet him and asked, “Why did you come here all by yourself?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“I am here on the king's business,” David answered. “He told me not to let anyone know what he sent me to do. As for my men, I have told them to meet me at a certain place. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.2",
            "verseOrgIds": [
              "1SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now, then, what supplies have you got? Give me five loaves of bread or anything else you have.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The priest said, “I haven't any ordinary bread, only sacred bread; you can have it if your men haven't had sexual relations recently.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Of course they haven't,” answered David. “My men always keep themselves ritually pure even when we go out on an ordinary mission; how much more this time when we are on a special mission!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8+LEV.24.9"
              },
              "items": [
                {
                  "text": "Lev 24.5–9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "So the priest gave David the sacred bread, because the only bread he had was the loaves offered to God, which had been removed from the sacred table and replaced by fresh bread.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Saul's chief herdsman, Doeg, who was from Edom, happened to be there that day, because he had to fulfil a religious obligation.)",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "David said to Ahimelech, “Have you got a spear or a sword you can give me? The king's orders made me leave in such a hurry that I didn't have time to get my sword or any other weapon.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.51"
              },
              "items": [
                {
                  "text": "1 Sam 17.51",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimelech answered, “I have the sword of Goliath the Philistine, whom you killed in the Valley of Elah; it is behind the ephod, wrapped in a cloth. If you want it, take it — it's the only weapon here.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Give it to me,” David said. “There is not a better sword anywhere!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "So David left, fleeing from Saul, and went to King Achish of Gath. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.7"
              },
              "items": [
                {
                  "text": "1 Sam 18.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.5"
              },
              "items": [
                {
                  "text": "29.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The king's officials said to Achish, “Isn't this David, the king of his country? This is the man about whom the women sang, as they danced, ‘Saul has killed thousands, but David has killed tens of thousands.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.56"
              },
              "items": [
                {
                  "text": "Ps 56",
                  "type": "text"
                }
              ]
            },
            {
              "text": "(Title)",
              "type": "text"
            }
          ]
        },
        {
          "text": "Their words made a deep impression on David, and he became very much afraid of King Achish. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34"
              },
              "items": [
                {
                  "text": "Ps 34",
                  "type": "text"
                }
              ]
            },
            {
              "text": "(Title)",
              "type": "text"
            }
          ]
        },
        {
          "text": "So whenever they were around, David pretended to be insane and acted like a madman when they tried to restrain him; he would scribble on the city",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.13",
              "type": "text"
            },
            {
              "text": "city",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "palace.",
              "type": "text"
            }
          ]
        },
        {
          "text": " gates and dribble down his beard. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Achish said to his officials, “Look! The man is mad! Why did you bring him to me? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haven't I got enough madmen already? Why bring another one to annoy me with his daft actions right here in my own house?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
              "1SA.21.15"
            ]
          }
        }
      ]
    }
  ],
