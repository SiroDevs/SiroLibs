            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saul answered, “I have done wrong. Come back, David, my son! I will never harm you again, because you have spared my life tonight. I have been a fool! I have done a terrible thing!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.21",
            "verseOrgIds": [
              "1SA.26.21"
            ]
          }
        }
