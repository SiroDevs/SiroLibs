              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "text": " rewards those who are faithful and righteous. Today he put you in my power, but I did not harm you, whom the ",
