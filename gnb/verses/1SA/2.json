          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
