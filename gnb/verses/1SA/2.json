              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "The boy Samuel continued to grow and to gain favour both with the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "text": " and with people.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
