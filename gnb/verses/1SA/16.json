            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "text": " answered, “Take a calf with you and say that you are there to offer a sacrifice to the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Invite Jesse to the sacrifice, and I will tell you what to do. You will anoint as king the man I tell you to.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        }
      ]
