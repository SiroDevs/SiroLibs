        },
        {
          "text": "He cried out in a loud voice: “She has fallen! Great Babylon has fallen! She is now haunted by demons and unclean spirits; all kinds of filthy and hateful birds live in her. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
