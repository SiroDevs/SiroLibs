            "number": "3",
            "style": "v",
            "sid": "REV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Is 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Jer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "For all the nations have drunk her wine — the strong wine of her immoral lust. The kings of the earth practised sexual immorality with her, and the merchants of the world grew rich from her unrestrained lust.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        }
