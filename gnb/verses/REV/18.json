          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "and say, “How terrible! How awful for the great city! She used to dress herself in linen, purple, and scarlet, and cover herself with gold ornaments, precious stones, and pearls! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.16",
            "verseOrgIds": [
              "REV.18.16"
            ]
          }
        },
