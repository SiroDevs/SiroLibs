        },
        {
          "text": "Then I heard a loud voice speaking from the temple to the seven angels: “Go and pour out the seven bowls of God's anger on the earth!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
      ]
    },
