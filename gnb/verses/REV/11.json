            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then the seventh angel blew his trumpet, and there were loud voices in heaven, saying, “The power to rule over the world belongs now to our Lord and his Messiah, and he will rule for ever and ever!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the 24 elders who sit on their thrones in front of God threw themselves face downwards and worshipped God, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
            "verseOrgIds": [
              "REV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "saying:",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
