                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Is 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Jer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The kings of the earth practised sexual immorality with her, and the people of the world became drunk from drinking the wine of her immorality.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        }
      ]
    },
    {
