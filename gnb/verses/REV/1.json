              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Look, he is coming on the clouds! Everyone will see him, including those who pierced him. All peoples on earth will mourn over him. So shall it be!",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
