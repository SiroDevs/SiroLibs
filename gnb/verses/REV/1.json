                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Rev 5.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "and made us a kingdom of priests to serve his God and Father. To Jesus Christ be the glory and power for ever and ever! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
