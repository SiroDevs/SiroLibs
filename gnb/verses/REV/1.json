                  "text": "Rev 4.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "From John to the seven churches in the province of Asia:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
