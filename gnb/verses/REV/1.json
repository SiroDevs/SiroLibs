                "loc": "ISA.55.4"
              },
              "items": [
                {
                  "text": "Is 55.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27"
              },
              "items": [
                {
                  "text": "Ps 89.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "and from Jesus Christ, the faithful witness, the first to be raised from death and who is also the ruler of the kings of the world.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
