              "items": [
                {
                  "text": "Ezek 44.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "But nothing that is impure will enter the city, nor anyone who does shameful things or tells lies. Only those whose names are written in the Lamb's book of the living will enter the city.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.27",
