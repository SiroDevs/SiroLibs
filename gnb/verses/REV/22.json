          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the angel said to me, “These words are true and can be trusted. And the Lord God, who gives his Spirit to the prophets, has sent his angel to show his servants what must happen very soon.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.6",
            "verseOrgIds": [
              "REV.22.6"
            ]
          }
        }
      ]
