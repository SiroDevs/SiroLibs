                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Happy are those who wash their robes clean and so have the right to eat the fruit from the tree of life and to go through the gates into the city. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "But outside the city are the perverts and those who practise magic, the immoral and the murderers, those who worship idols and those who are liars both in words and deeds.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
