                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Gen 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.12"
              },
              "items": [
                {
                  "text": "Ezek 47.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "and flowing down the middle of the city's street. On each side of the river was the tree of life, which bears fruit twelve times a year, once each month; and its leaves are for the healing of the nations. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.2",
            "verseOrgIds": [
              "REV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "Zech 14.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nothing that is under God's curse will be found in the city.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The throne of God and of the Lamb will be in the city, and his servants will worship him. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.3",
            "verseOrgIds": [
              "REV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will see his face, and his name will be written on their foreheads. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.4",
            "verseOrgIds": [
              "REV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Is 60.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.18"
              },
              "items": [
                {
                  "text": "Dan 7.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "There shall be no more night, and they will not need lamps or sunlight, because the Lord God will be their light, and they will rule as kings for ever and ever.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
    },
    {
