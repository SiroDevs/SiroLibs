              "REV.6.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "Zech 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then the Lamb broke open the third seal; and I heard the third living creature say, “Come!” I looked, and there was a black horse. Its rider held a pair of scales in his hand. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I heard what sounded like a voice coming from among the four living creatures, which said, “A litre of wheat for a day's wages, and three litres of barley for a day's wages. But do not damage the olive trees and the vineyards!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the Lamb broke open the fourth seal; and I heard the fourth living creature say, “Come!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.7",
            "verseOrgIds": [
              "REV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.21"
              },
              "items": [
                {
                  "text": "Ezek 14.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I looked, and there was a pale-coloured horse. Its rider was named Death, and Hades",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.8",
              "type": "text"
            },
            {
              "text": "Hades",
              "type": "text"
            },
            {
              "text": ": The world of the dead (see 1.18).",
              "type": "text"
            }
          ]
        },
        {
          "text": " followed close behind. They were given authority over a quarter of the earth, to kill by means of war, famine, disease, and wild animals.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the Lamb broke open the fifth seal. I saw underneath the altar the souls of those who had been killed because they had proclaimed God's word and had been faithful in their witnessing. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.9",
            "verseOrgIds": [
              "REV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "They shouted in a loud voice, “Almighty Lord, holy and true! How long will it be until you judge the people on earth and punish them for killing us?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.10",
            "verseOrgIds": [
              "REV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Each of them was given a white robe, and they were told to rest a little while longer, until the complete number of their fellow-servants and fellow-Christians had been killed, as they had been.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.11",
            "verseOrgIds": [
              "REV.6.11"
            ]
          }
        }
      ]
    },
