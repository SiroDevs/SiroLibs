        },
        {
          "text": "Another angel, who had a gold incense burner, came and stood at the altar. He was given a lot of incense to add to the prayers of all God's people and to offer it on the gold altar that stands before the throne. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
