        },
        {
          "text": "When the Lamb broke open the seventh seal, there was silence in heaven for about half an hour. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
