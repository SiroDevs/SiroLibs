                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "and singing the song of Moses, the servant of God, and the song of the Lamb:",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
