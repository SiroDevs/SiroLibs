              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then I saw in the sky another mysterious sight, great and amazing. There were seven angels with seven plagues, which are the last ones, because they are the final expression of God's anger.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
