          "items": [
            {
              "text": "24.36",
              "type": "text"
            },
            {
              "text": "Some manuscripts do not have",
              "type": "text"
            },
            {
              "text": "and said to them, “Peace be with you.”",
              "type": "text"
            }
          ]
        }
      ]
    },
