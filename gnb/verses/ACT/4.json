            "number": "35",
            "style": "v",
            "sid": "ACT 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
              "ACT.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "And so it was that Joseph, a Levite born in Cyprus, whom the apostles called Barnabas (which means “One who Encourages”), ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
            "verseOrgIds": [
              "ACT.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
