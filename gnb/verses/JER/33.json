        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "text": " said, “People are saying that this place is like a desert, that it has no people or animals living in it. And they are right; the towns of Judah and the streets of Jerusalem are empty; no people or animals live there. But in these places you will hear again ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
