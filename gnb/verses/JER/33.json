                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I, the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "text": ", promise that there will always be a descendant of David to be king of Israel ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
