          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.46",
            "verseOrgIds": [
              "JER.48.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JER 48:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "But in days to come the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
            "verseOrgIds": [
              "JER.48.47"
            ]
          }
        },
        {
          "text": " will make Moab prosperous again. All of this is what the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
            "verseOrgIds": [
              "JER.48.47"
            ]
          }
        },
        {
          "text": " has said will happen to Moab.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
            "verseOrgIds": [
              "JER.48.47"
            ]
          }
        }
