            "number": "20",
            "style": "v",
            "sid": "JER 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.20",
            "verseOrgIds": [
              "JER.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“So then,” says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        },
        {
          "text": ", “once and for all I will make the nations know my power and my might; they will know that I am the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.21",
            "verseOrgIds": [
              "JER.16.21"
            ]
          }
        }
