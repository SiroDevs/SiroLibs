        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.5",
            "verseOrgIds": [
              "JER.49.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“But later on I will make Ammon prosperous again. I, the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.6",
            "verseOrgIds": [
              "JER.49.6"
            ]
          }
        },
        {
          "text": ", have spoken.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.6",
            "verseOrgIds": [
              "JER.49.6"
            ]
          }
        }
      ]
    },
