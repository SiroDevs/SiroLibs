              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        },
