          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“You, Jeremiah, must proclaim everything I have said. You must tell these people,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
