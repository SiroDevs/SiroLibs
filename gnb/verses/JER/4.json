            "verseId": "JER.4.1",
            "verseOrgIds": [
              "JER.4.1"
            ]
          }
        },
        {
          "text": " says, “People of Israel, if you want to turn, then turn back to me. If you are faithful to me and remove the idols I hate, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.1",
            "verseOrgIds": [
              "JER.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "it will be right for you to swear by my name. Then",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.2",
            "verseOrgIds": [
              "JER.4.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
