        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.17",
            "verseOrgIds": [
              "JER.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judah, you have brought this on yourself by the way you have lived and by the things you have done. Your sin has caused this suffering; it has stabbed you through the heart.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.18",
            "verseOrgIds": [
              "JER.4.18"
            ]
          }
        }
      ]
