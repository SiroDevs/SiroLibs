              "type": "text"
            },
            {
              "text": "it will be right",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "name. Then",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "and if you swear by my name and are truthful, just, and righteous, then.",
              "type": "text"
            }
          ]
        },
        {
          "text": " all the nations will ask me to bless them, and they will praise me.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.2",
            "verseOrgIds": [
              "JER.4.2"
            ]
          }
        }
      ]
