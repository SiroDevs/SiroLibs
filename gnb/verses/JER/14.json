            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "text": " says about these people, “They love to run away from me, and they will not control themselves. So I am not pleased with them. I will remember the wrongs they have done and punish them because of their sins.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
