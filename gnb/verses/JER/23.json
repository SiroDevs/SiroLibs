              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.4",
            "verseOrgIds": [
              "JER.23.4"
            ]
          }
        },
        {
