          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“And now I command that if anyone of any nation, race, or language speaks disrespectfully of the God of Shadrach, Meshach, and Abednego, he is to be torn limb from limb, and his house is to be made a pile of ruins. There is no other god who can rescue like this.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.29",
            "verseOrgIds": [
              "DAN.3.29"
            ]
          }
