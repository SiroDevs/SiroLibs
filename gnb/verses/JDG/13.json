          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manoah replied, “Tell us your name, so that we can honour you when your words come true.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
