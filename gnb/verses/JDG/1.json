            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.36",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "Edomite",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "Amorite.",
              "type": "text"
            }
          ]
        },
        {
          "text": " border ran through Akrabbim Pass.",
          "type": "text",
          "attrs": {
