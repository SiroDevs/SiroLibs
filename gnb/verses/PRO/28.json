          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyone who thinks it isn't wrong to steal from his parents is no better than a common thief.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.24",
            "verseOrgIds": [
              "PRO.28.24"
            ]
          }
        }
      ]
    },
    {
