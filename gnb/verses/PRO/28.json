          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "It is foolish to follow your own opinions. Be safe, and follow the teachings of wiser people.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.26",
            "verseOrgIds": [
              "PRO.28.26"
            ]
          }
        }
      ]
    },
