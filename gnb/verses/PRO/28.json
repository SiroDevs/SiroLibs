          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.19",
            "verseOrgIds": [
              "PRO.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Honest people will lead a full, happy life. But if you are in a hurry to get rich, you are going to be punished.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.20",
            "verseOrgIds": [
              "PRO.28.20"
            ]
          }
        }
      ]
    },
