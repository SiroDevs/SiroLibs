          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Give to the poor and you will never be in need. If you close your eyes to the poor, many people will curse you.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.27",
            "verseOrgIds": [
              "PRO.28.27"
            ]
          }
        }
