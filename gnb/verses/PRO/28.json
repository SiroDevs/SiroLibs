          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Correct someone, and afterwards he will appreciate it more than flattery.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.23",
            "verseOrgIds": [
              "PRO.28.23"
            ]
          }
        }
      ]
    },
