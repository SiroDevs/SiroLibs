          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selfishness only causes trouble. You are much better off to trust the ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.25",
            "verseOrgIds": [
              "PRO.28.25"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.25",
            "verseOrgIds": [
              "PRO.28.25"
            ]
          }
        }
      ]
