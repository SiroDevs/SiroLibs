          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selfish people are in such a hurry to get rich that they do not know when poverty is about to strike.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.22",
            "verseOrgIds": [
              "PRO.28.22"
            ]
          }
        }
      ]
    },
    {
