          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "People stay in hiding when the wicked come to power. But when they fall from power, the righteous will rule again.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.28",
            "verseOrgIds": [
              "PRO.28.28"
            ]
