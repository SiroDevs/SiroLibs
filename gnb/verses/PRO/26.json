              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Insincere",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26.23",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "Insincere",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "Burning.",
              "type": "text"
            }
          ]
        },
        {
          "text": " talk that hides what you are really thinking is like a fine glaze",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26.23",
              "type": "text"
            },
            {
              "text": "Probable text",
              "type": "text"
            },
            {
              "text": "fine glaze",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "unrefined silver.",
              "type": "text"
            }
          ]
        },
        {
          "text": " on a cheap clay pot.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.23",
            "verseOrgIds": [
              "PRO.26.23"
            ]
          }
        }
      ]
