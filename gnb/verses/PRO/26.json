          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A hypocrite hides hatred behind flattering words. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.24",
            "verseOrgIds": [
              "PRO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "They may sound fine, but don't believe him, because his heart is filled to the brim with hate. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.25",
            "verseOrgIds": [
              "PRO.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "He may disguise his hatred, but everyone will see the evil things he does.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.26",
            "verseOrgIds": [
              "PRO.26.26"
            ]
          }
        }
      ]
    },
