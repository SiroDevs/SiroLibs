              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "People who set traps for others get caught themselves. People who start landslides get crushed.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.27",
            "verseOrgIds": [
              "PRO.26.27"
            ]
          }
        }
