          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
