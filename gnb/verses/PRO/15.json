        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        },
        {
          "text": " is pleased when good people pray, but hates the sacrifices that the wicked bring him.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
