            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "If you are lazy, you will meet difficulty everywhere, but if you are honest, you will have no trouble.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.19",
            "verseOrgIds": [
              "PRO.15.19"
            ]
          }
