          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hot tempers cause arguments, but patience brings peace.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.18",
            "verseOrgIds": [
              "PRO.15.18"
            ]
          }
        }
      ]
    },
