          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Better to eat vegetables with people you love than to eat the finest meat where there is hate.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
