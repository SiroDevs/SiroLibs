          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A fool will believe anything; sensible people watch their step.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.15",
            "verseOrgIds": [
              "PRO.14.15"
            ]
          }
        }
      ]
