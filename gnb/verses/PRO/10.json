                {
                  "text": "1 Pet 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hate stirs up trouble, but love overlooks all offences.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
