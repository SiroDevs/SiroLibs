          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A good person's words are a fountain of life, but a wicked person's words hide a violent nature.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
