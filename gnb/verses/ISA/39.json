        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "King Hezekiah understood this to mean that there would be peace and security during his lifetime, so he replied, “The message you have given me from the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        },
        {
          "text": " is good.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
