              "items": [
                {
                  "text": "2 Chr 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Some of your own direct descendants will be taken away and made eunuchs to serve in the palace of the king of Babylonia.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
