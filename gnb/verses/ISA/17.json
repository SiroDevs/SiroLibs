                "loc": "AMO.1.3+AMO.1.4+AMO.1.5"
              },
              "items": [
                {
                  "text": "Amos 1.3–5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
              },
              "items": [
                {
                  "text": "Zech 9.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
          "text": " said, “Damascus will not be a city any longer; it will be only a pile of ruins. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The cities of Syria will be deserted for ever.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.2",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "The cities",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "for ever",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "The cities of Aroer are deserted.",
              "type": "text"
            }
          ]
        },
        {
          "text": " They will be a pasture for sheep and cattle, and no one will drive them away. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel will be defenceless, and Damascus will lose its independence. Those Syrians who survive will be in disgrace like the people of Israel. I, the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        },
        {
          "text": " Almighty, have spoken.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        },
        {
          "text": " said, “A day is coming when Israel's greatness will come to an end, and its wealth will be replaced by poverty. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel will be like a field where the corn has been cut and harvested, as desolate as a field in the valley of Rephaim when it has been picked bare. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Only a few people will survive, and Israel will be like an olive tree from which all the olives have been picked except two or three at the very top, or a few that are left on the lower branches. I, the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "text": " God of Israel, have spoken.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "When that day comes, people will turn for help to their Creator, the holy God of Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "They will no longer rely on the altars they made with their own hands, or trust in their own handiwork — symbols of the goddess Asherah and altars for burning incense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "When that day comes, well-defended cities will be deserted and left in ruins like the cities that the Hivites and the Amorites",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.9",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "the Hivites and the Amorites",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "woodland and hill country.",
              "type": "text"
            }
          ]
        },
        {
          "text": " abandoned as they fled from the people of Israel.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel, you have forgotten the God who rescues you and who protects you like a mighty rock. Instead, you plant sacred gardens",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.10",
              "type": "text"
            },
            {
              "text": "sacred gardens",
              "type": "text"
            },
            {
              "text": ": See 1.29.",
              "type": "text"
            }
          ]
        },
        {
          "text": " in order to worship a foreign god. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "But even if they sprouted and blossomed the very morning you planted them, there would still be no harvest. There would be only trouble and incurable pain.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Powerful nations are in commotion with a sound like the roar of the sea, like the crashing of huge waves. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The nations advance like rushing waves, but God reprimands them and they retreat, driven away like dust on a hillside, like straw in a whirlwind. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "In the evening they cause terror, but by morning they are gone. That is the fate of everyone who plunders our land.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "ISA.18",
    "number": "18",
    "bookId": "ISA"
  },
  "previous": {
    "id": "ISA.16",
