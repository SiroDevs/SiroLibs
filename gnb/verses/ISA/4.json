              "type": "text"
            }
          ]
        },
        {
          "text": "When that time comes, seven women will grab hold of one man and say, “We can feed and clothe ourselves, but please let us say you are our husband, so that we won't have to endure the shame of being unmarried.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
