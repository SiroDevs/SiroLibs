                {
                  "text": "Ex 13.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.16"
              },
              "items": [
                {
                  "text": "24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then over Mount Zion and over all who are gathered there, the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "text": " will send a cloud in the daytime and smoke and a bright flame at night. God's glory will cover and protect the whole city. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "His glory will shade the city from the heat of the day and make it a place of safety, sheltered from the rain and storm.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.6",
            "verseOrgIds": [
              "ISA.4.6"
            ]
          }
        }
      ]
