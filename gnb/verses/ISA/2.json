              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "This is the message which God gave to Isaiah son of Amoz about Judah and Jerusalem:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
