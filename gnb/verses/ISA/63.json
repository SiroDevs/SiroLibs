          "attrs": {
            "verseId": "ISA.63.16",
            "verseOrgIds": [
              "ISA.63.16"
            ]
          }
        },
        {
          "text": ", are our father, the one who has always rescued us. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.16",
            "verseOrgIds": [
              "ISA.63.16"
            ]
          }
        },
