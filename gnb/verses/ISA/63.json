          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Why is his clothing so red, like that of someone who tramples grapes to make wine?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
