                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Who is this coming from the city of Bozrah in Edom? Who is this so splendidly dressed in red, marching along",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "63.1",
              "type": "text"
            },
            {
              "text": "Some ancient translations",
              "type": "text"
            },
            {
              "text": "marching along",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "bowed down.",
              "type": "text"
            }
          ]
        },
        {
          "text": " in power and strength?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
