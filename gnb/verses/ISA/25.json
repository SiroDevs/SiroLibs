        },
        {
          "text": "Here on Mount Zion the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "text": " Almighty will prepare a banquet for all the nations of the world — a banquet of the richest food and the finest wine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
