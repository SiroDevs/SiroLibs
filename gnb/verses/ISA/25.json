          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "He will destroy the fortresses of Moab with their high walls and bring them tumbling down into the dust.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.12",
            "verseOrgIds": [
              "ISA.25.12"
            ]
