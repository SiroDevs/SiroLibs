          "text": "The Sovereign ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "text": " will destroy death for ever! He will wipe away the tears from everyone's eyes and take away the disgrace his people have suffered throughout the world. The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "text": " himself has spoken!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
