                  "text": "Rev 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Just as the new earth and the new heavens will endure by my power, so your descendants and your name will endure. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
