          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "On every New Moon Festival and every Sabbath, people of every nation will come to worship me here in Jerusalem,” says the ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
