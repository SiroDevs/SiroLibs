          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        },
        {
          "text": " says,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.44.21",
            "verseOrgIds": [
              "ISA.44.21"
            ]
          }
        }
      ]
    }
