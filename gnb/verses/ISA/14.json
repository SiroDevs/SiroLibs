          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
          }
        },
        {
          "text": " will be a shepherd to the poor of his people and will let them live in safety. But he will send a terrible famine on you Philistines, and it will not leave any of you alive.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.30",
            "verseOrgIds": [
              "ISA.14.30"
            ]
          }
        }
