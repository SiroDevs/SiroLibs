        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.24",
            "verseOrgIds": [
              "ISA.14.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
