              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Howl and cry for help, all you Philistine cities! Be terrified, all of you! A cloud of dust is coming from the north — it is an army with no cowards in its ranks.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.31",
            "verseOrgIds": [
              "ISA.14.31"
            ]
          }
