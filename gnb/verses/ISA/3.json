          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Instead of using perfumes, they will stink; instead of fine belts, they will wear coarse ropes; instead of having beautiful hair, they will be bald; instead of fine clothes, they will be dressed in rags; their beauty will be turned to shame!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.24",
            "verseOrgIds": [
              "ISA.3.24"
            ]
          }
