          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "The men of the city, yes, even the strongest men, will be killed in war. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.25",
            "verseOrgIds": [
              "ISA.3.25"
            ]
          }
        },
