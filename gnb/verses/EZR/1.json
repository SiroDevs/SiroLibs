          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9+EZR.1.10",
            "verseOrgIds": [
              "EZR.1.9",
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "In all there were 5,400 gold and silver bowls and other articles which Sheshbazzar took with him when he and the other exiles went from Babylon to Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
