              "EZR.2.70"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.2"
              },
              "items": [
                {
                  "text": "1 Chr 9.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.11.3"
              },
              "items": [
                {
                  "text": "Neh 11.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "The priests, the Levites, and some of the people settled in or near Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.70",
            "verseOrgIds": [
              "EZR.2.70"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.70",
              "type": "text"
            },
            {
              "text": "One ancient translation",
              "type": "text"
            },
            {
              "text": "in or near Jerusalem",
              "type": "text"
            },
            {
              "text": "; Hebrew does not have these words.",
              "type": "text"
            }
          ]
        },
        {
          "text": " the musicians, the temple guards, and the temple workmen settled in nearby towns; and the rest of the Israelites settled in the towns where their ancestors had lived.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.70",
            "verseOrgIds": [
              "EZR.2.70"
            ]
          }
        }
      ]
    }
  ],
