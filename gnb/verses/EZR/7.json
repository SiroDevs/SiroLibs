              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
