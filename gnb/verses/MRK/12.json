        },
        {
          "text": "The Jewish leaders tried to arrest Jesus, because they knew that he had told this parable against them. But they were afraid of the crowd, so they left him and went away.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
