        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus answered them, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.22",
            "verseOrgIds": [
              "MRK.11.22"
            ]
          }
        },
