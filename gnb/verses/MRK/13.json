          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "As Jesus was leaving the Temple, one of his disciples said, “Look, Teacher! What wonderful stones and buildings!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.1",
            "verseOrgIds": [
              "MRK.13.1"
            ]
          }
        }
      ]
    },
