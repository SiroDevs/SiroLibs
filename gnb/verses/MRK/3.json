              "MRK.3.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.34"
              },
              "items": [
                {
                  "text": "Mt 9.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "10.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Some teachers of the Law who had come from Jerusalem were saying, “He has Beelzebul in him! It is the chief of the demons who gives him the power to drive them out.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        }
      ]
    },
