              "MRK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Jesus called them to him and spoke to them in parables: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
