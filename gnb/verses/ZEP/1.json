            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "On the day when the ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
          }
        },
        {
          "text": " shows his fury, not even all their silver and gold will save them. The whole earth will be destroyed by the fire of his anger. He will put an end — a sudden end — to everyone who lives on earth.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
          }
        }
      ]
