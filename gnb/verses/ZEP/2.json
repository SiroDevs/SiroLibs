              "type": "text"
            },
            {
              "text": "Some ancient translations",
              "type": "text"
            },
            {
              "text": "Crows",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "Desolation.",
              "type": "text"
            }
          ]
        },
        {
          "text": " will caw on the doorsteps. The cedar wood of her buildings will be stripped away. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
