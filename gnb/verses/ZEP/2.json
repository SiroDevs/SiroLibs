        },
        {
          "text": "It will be a place where flocks, herds, and animals of every kind will lie down. Owls will live among its ruins and hoot from the windows. Crows",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
