                "loc": "HAB.2.3+HAB.2.4"
              },
              "items": [
                {
                  "text": "Hab 2.3–4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "(LXX)",
              "type": "text"
            }
          ]
        },
        {
          "text": "For, as the scripture says:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
