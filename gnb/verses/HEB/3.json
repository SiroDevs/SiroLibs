              "type": "text"
            }
          ]
        },
        {
          "text": "This is what the scripture says:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        }
      ]
