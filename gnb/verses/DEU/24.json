          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Remember that you were slaves in Egypt and that the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        },
        {
          "text": " your God set you free; that is why I have given you this command.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        }
      ]
