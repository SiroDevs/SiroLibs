                "loc": "EXO.21.16"
              },
              "items": [
                {
                  "text": "Ex 21.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Whoever kidnaps a fellow-Israelite and takes him or her as a slave or sells them into slavery is to be put to death. In this way you will get rid of this evil.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
    {
