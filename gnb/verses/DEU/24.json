                  "text": "Deut 27.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Do not deprive foreigners and orphans of their rights; and do not take a widow's garment as security for a loan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
