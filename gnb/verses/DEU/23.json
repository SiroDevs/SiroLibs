                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Lev 25.36–37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Deut 15.7–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“When you lend money or food or anything else to a fellow-Israelite, do not charge him interest. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
