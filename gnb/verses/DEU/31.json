              "items": [
                {
                  "text": "Josh 1.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        },
        {
          "text": " spoke to Joshua son of Nun and said to him, “Be confident and determined. You will lead the people of Israel into the land that I promised them, and I will be with you.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
