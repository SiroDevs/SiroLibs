              "DEU.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.19"
              },
              "items": [
                {
                  "text": "Lev 19.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not plant any crop in the same field as your grapevines; if you do, you are forbidden to use either the grapes or the produce of the other crop.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not hitch an ox and a donkey together for ploughing.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.10",
            "verseOrgIds": [
              "DEU.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Do not wear cloth made by weaving wool and linen together.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.37+NUM.15.38+NUM.15.39+NUM.15.40+NUM.15.41"
              },
              "items": [
                {
                  "text": "Num 15.37–41",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sew tassels on the four corners of your clothes.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Suppose a man marries a woman and later he decides he doesn't want her. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "So he makes up false charges against her, accusing her of not being a virgin when they got married.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“If this happens, the woman's parents are to take the bloodstained wedding sheet that proves she was a virgin, and they are to show it in court to the town leaders. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Her father will say to them, ‘I gave my daughter to this man in marriage, and now he doesn't want her. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "He has made false charges against her, saying that she was not a virgin when he married her. But here is the proof that my daughter was a virgin; look at the bloodstains on the wedding sheet!’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the town leaders are to take the husband and beat him. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "They are also to fine him a hundred pieces of silver and give the money to the woman's father, because the man has brought disgrace on an Israelite woman. Moreover, she will continue to be his wife, and he can never divorce her as long as he lives.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“But if the charge is true and there is no proof that she was a virgin, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "then they are to take her out to the entrance of her father's house, where the men of her city are to stone her to death. She has done a shameful thing among our people by having intercourse before she was married, while she was still living in her father's house. In this way you will get rid of this evil.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
