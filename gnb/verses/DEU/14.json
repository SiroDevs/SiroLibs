          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“All winged insects are unclean; do not eat them. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.19",
            "verseOrgIds": [
              "DEU.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "You may eat any clean insect.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.20",
            "verseOrgIds": [
              "DEU.14.20"
            ]
          }
        }
      ]
