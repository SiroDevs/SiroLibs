            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“You may eat any clean bird. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "But these are the kinds of birds you are not to eat: eagles, owls, hawks, falcons; buzzards, vultures, crows; ostriches; seagulls, storks, herons, pelicans, cormorants;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12+DEU.14.13+DEU.14.14+DEU.14.15+DEU.14.16+DEU.14.17+DEU.14.18",
            "verseOrgIds": [
              "DEU.14.12",
              "DEU.14.13",
              "DEU.14.14",
              "DEU.14.15",
              "DEU.14.16",
              "DEU.14.17",
              "DEU.14.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14.12–18",
              "type": "text"
            },
            {
              "text": "The identification of some of these birds is uncertain.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hoopoes; and bats.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12+DEU.14.13+DEU.14.14+DEU.14.15+DEU.14.16+DEU.14.17+DEU.14.18",
            "verseOrgIds": [
