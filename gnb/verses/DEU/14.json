                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "You belong to the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "text": " your God; he has chosen you to be his own people from among all the peoples who live on earth.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
