          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "text": " your God angry when you were at Taberah, Massah, and Kibroth Hattaavah. ",
          "type": "text",
