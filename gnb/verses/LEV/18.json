              "items": [
                {
                  "text": "Lev 20.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "or with your brother's wife. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
