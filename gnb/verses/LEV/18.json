          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "and then the land will not reject you, as it rejected the pagans who lived there before you. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
