              "items": [
                {
                  "text": "Deut 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Do not have intercourse with the daughter or granddaughter of a woman with whom you have had intercourse; they may be related to you, and that would be incest. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
