          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not take your wife's sister as one of your wives, as long as your wife is living.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
