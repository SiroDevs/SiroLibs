          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "text": " is punishing the land and making it reject the people who lived there. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
