        {
          "text": "Do not have intercourse with an aunt, whether she is your father's sister or your mother's sister. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12+LEV.18.13",
            "verseOrgIds": [
              "LEV.18.12",
              "LEV.18.13"
            ]
