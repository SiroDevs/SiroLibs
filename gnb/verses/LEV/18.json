        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not have intercourse with your uncle's wife; she, too, is your aunt. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "verse",
