              "items": [
                {
                  "text": "Deut 27.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Do not have intercourse with your sister or your stepsister, whether or not she was brought up in the same house with you. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not have intercourse with your granddaughter; that would be a disgrace to you. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
