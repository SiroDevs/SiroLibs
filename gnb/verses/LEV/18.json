              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "text": " gave the following regulations. Do not have sexual intercourse with any of your relatives. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Do not disgrace your father by having intercourse with your mother. You must not disgrace your own mother. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
