        {
          "text": "Do not disgrace your father by having intercourse with any of his other wives. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
