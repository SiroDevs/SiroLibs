              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "When anyone offers one of his cattle as a fellowship offering, it is to be a bull or a cow without any defects. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.1",
            "verseOrgIds": [
              "LEV.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "The man shall put his hand on the head of the animal and kill it at the entrance of the Tent of the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "text": "'s presence. The Aaronite priests shall throw the blood against all four sides of the altar ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.2",
            "verseOrgIds": [
              "LEV.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "and present the following parts of the animal as a food offering to the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "text": ": all the fat on the internal organs, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.3",
            "verseOrgIds": [
              "LEV.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "the kidneys and the fat on them, and the best part of the liver. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.4",
            "verseOrgIds": [
              "LEV.3.4"
            ]
          }
        },
        {
