        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "text": " gave Moses ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.1",
            "verseOrgIds": [
              "LEV.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "the following regulations for the religious festivals, when the people of Israel are to gather for worship. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
