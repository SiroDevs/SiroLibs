                "loc": "EXO.34.21"
              },
              "items": [
                {
                  "text": "34.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.35.2"
              },
              "items": [
                {
                  "text": "35.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.12+DEU.5.13+DEU.5.14"
              },
              "items": [
                {
                  "text": "Deut 5.12–14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "You have six days in which to do your work, but remember that the seventh day, the Sabbath, is a day of rest. On that day do not work, but gather for worship. The Sabbath belongs to the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "text": ", no matter where you live. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Proclaim the following festivals at the appointed times.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
      ]
    },
    {
