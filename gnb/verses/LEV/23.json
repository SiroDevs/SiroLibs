                "loc": "EXO.20.8+EXO.20.9+EXO.20.10"
              },
              "items": [
                {
                  "text": "Ex 20.8–10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.12"
              },
              "items": [
                {
                  "text": "23.12",
