              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "Jaareoregim.",
              "type": "text"
            }
          ]
        },
        {
          "text": " from Bethlehem killed Goliath from Gath, whose spear had a shaft as thick as the bar on a weaver's loom.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
            ]
          }
        }
