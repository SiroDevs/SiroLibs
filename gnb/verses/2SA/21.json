              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "There was another battle with the Philistines at Gob, and Elhanan son of Jair",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.19",
            "verseOrgIds": [
              "2SA.21.19"
