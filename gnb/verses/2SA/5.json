          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "David did what the ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.25",
            "verseOrgIds": [
              "2SA.5.25"
            ]
          }
        },
        {
          "text": " had commanded, and was able to drive the Philistines back from Geba all the way to Gezer.",
          "type": "text",
