          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dor (on the coast), Goiim (in Galilee",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
        {
