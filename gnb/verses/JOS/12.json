          "type": "text",
          "attrs": {
            "verseId": "JOS.12.19",
            "verseOrgIds": [
              "JOS.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
