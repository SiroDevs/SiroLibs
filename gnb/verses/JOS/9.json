              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "So this is what Joshua did: he protected them and did not allow the people of Israel to kill them. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
