            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now we are in your power; do with us what you think is right.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
