              "attrs": {
                "loc": "DEU.21.17"
              },
              "items": [
                {
                  "text": "Deut 21.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "There, Elijah said to Elisha, “Tell me what you want me to do for you before I am taken away.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
