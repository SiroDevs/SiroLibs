          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Let me receive the share of your power that will make me your successor,”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.9",
              "type": "text"
            },
            {
              "text": "the share",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "successor",
              "type": "text"
            },
            {
              "text": ": Elisha asked for the share that the firstborn son inherited by law from his father (see Deut 21.17).",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elisha answered.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
