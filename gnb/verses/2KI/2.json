          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Some men from Jericho went to Elisha and said, “As you know, sir, this is a fine city, but the water is bad and causes miscarriages.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
