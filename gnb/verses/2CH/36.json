              "text": "Some ancient translations (and see 2 Kgs 24.17)",
              "type": "text"
            },
            {
              "text": "uncle",
              "type": "text"
            },
            {
              "text": "; Hebrew",
              "type": "text"
            },
            {
              "text": "brother.",
              "type": "text"
            }
          ]
        },
