        },
        {
          "text": "Zedekiah was 21 years old when he became king of Judah, and he ruled in Jerusalem for eleven years. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
