              "items": [
                {
                  "text": "1 Chr 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "When King Solomon finished all the work on the Temple, he placed in the temple storerooms all the things that his father David had dedicated to the ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "text": " — the silver, gold, and other articles.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
