        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
