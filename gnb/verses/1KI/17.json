            "style": "v",
            "sid": "1KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "text": " said to Elijah, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.2",
            "verseOrgIds": [
              "1KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Leave this place and go east and hide yourself near the brook of Cherith, east of the Jordan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.3",
            "verseOrgIds": [
              "1KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The brook will supply you with water to drink, and I have commanded ravens to bring you food there.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.4",
            "verseOrgIds": [
              "1KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elijah obeyed the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "text": "'s command, and went and stayed by the brook of Cherith. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.5",
            "verseOrgIds": [
              "1KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "He drank water from the brook, and ravens brought him bread and meat every morning and every evening. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.6",
            "verseOrgIds": [
              "1KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "After a while the brook dried up because of the lack of rain.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.7",
            "verseOrgIds": [
              "1KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "text": " said to Elijah, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.8",
            "verseOrgIds": [
              "1KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.25+LUK.4.26"
              },
              "items": [
                {
                  "text": "Lk 4.25–26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Now go to the town of Zarephath, near Sidon, and stay there. I have commanded a widow who lives there to feed you.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.9",
            "verseOrgIds": [
              "1KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Elijah went to Zarephath, and as he came to the gate of the town, he saw a widow gathering firewood. “Please bring me a drink of water,” he said to her. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.10",
            "verseOrgIds": [
              "1KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "And as she was going to get it, he called out, “And please bring me some bread, too.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.11",
            "verseOrgIds": [
              "1KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "She answered, “By the living ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        },
        {
          "text": " your God I swear that I haven't got any bread. All I have is a handful of flour in a bowl and a drop of olive oil in a jar. I came here to gather some firewood to take back home and prepare what little I have for my son and me. That will be our last meal, and then we will starve to death.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.12",
            "verseOrgIds": [
              "1KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Don't worry,” Elijah said to her. “Go ahead and prepare your meal. But first make a small loaf from what you have and bring it to me, and then prepare the rest for you and your son. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.13",
            "verseOrgIds": [
              "1KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "For this is what the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        },
        {
          "text": ", the God of Israel, says: ‘The bowl will not run out of flour or the jar run out of oil before the day that I, the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        },
        {
          "text": ", send rain.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.14",
            "verseOrgIds": [
              "1KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The widow went and did as Elijah had told her, and all of them had enough food for many days. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.15",
            "verseOrgIds": [
              "1KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "As the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        },
        {
          "text": " had promised through Elijah, the bowl did not run out of flour nor did the jar run out of oil.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.16",
            "verseOrgIds": [
              "1KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Some time later the widow's son fell ill; he got worse and worse, and finally he died. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.17",
            "verseOrgIds": [
              "1KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "She said to Elijah, “Man of God, why did you do this to me? Did you come here to remind God of my sins and so cause my son's death?”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.18",
            "verseOrgIds": [
              "1KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Give the boy to me,” Elijah said. He took the boy from her arms, carried him upstairs to the room where he was staying, and laid him on the bed. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.19",
            "verseOrgIds": [
              "1KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then he prayed aloud, “O ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "text": " my God, why have you done such a terrible thing to this widow? She has been kind enough to take care of me, and now you kill her son!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.20",
            "verseOrgIds": [
              "1KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.34+2KI.4.35"
              },
              "items": [
                {
                  "text": "2 Kgs 4.34–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Then Elijah stretched himself out on the boy three times and prayed, “O ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        },
        {
          "text": " my God, restore this child to life!” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.21",
            "verseOrgIds": [
              "1KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
            "verseOrgIds": [
              "1KI.17.22"
            ]
          }
        },
        {
          "text": " answered Elijah's prayer; the child started breathing again and revived.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.22",
            "verseOrgIds": [
              "1KI.17.22"
            ]
          }
        }
      ]
