            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.17"
              },
              "items": [
                {
                  "text": "Jas 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "A prophet named Elijah, from Tishbe in Gilead, said to King Ahab, “In the name of the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        },
        {
          "text": ", the living God of Israel, whom I serve, I tell you that there will be no dew or rain for the next two or three years until I say so.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.17.1",
            "verseOrgIds": [
              "1KI.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
