          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elijah answered, “All right, go back. I'm not stopping you!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19.20",
              "type": "text"
            },
            {
              "text": "All right",
              "type": "text"
            },
            {
              "text": "…",
              "type": "text"
            },
            {
              "text": "you",
              "type": "text"
            },
            {
              "text": "; or",
              "type": "text"
            },
            {
              "text": "Go on, but come back, because what I have just done to you is important.",
              "type": "text"
            }
          ]
        }
      ]
