            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Like his father before him, he sinned against the ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "text": " and led Israel into sin.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
