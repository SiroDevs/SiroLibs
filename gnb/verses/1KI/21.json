              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Elijah finished speaking, Ahab tore his clothes, took them off, and put on sackcloth. He refused food, slept in the sackcloth, and went about gloomy and depressed.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
