          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the entrance to the main room a rectangular door-frame of olive wood was made. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
