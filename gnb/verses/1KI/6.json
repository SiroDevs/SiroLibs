          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "and decorated with carved figures of winged creatures, palm trees, and flowers, which were evenly covered with gold.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
