        },
        {
          "text": "A double door made of olive wood was set in place at the entrance of the Most Holy Place; the top of the doorway was a pointed arch. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
