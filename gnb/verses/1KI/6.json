              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "The foundation of the Temple was laid in the second month, the month of Ziv, in the fourth year of Solomon's reign. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
