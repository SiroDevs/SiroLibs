              "type": "text"
            }
          ]
        },
        {
          "text": "balimwita, kandi obu halihinguraho ebiro bisatu alihumbuurwa.” Aho bbo baatuntura muno.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
