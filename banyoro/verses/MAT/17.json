                "loc": "GEN.22.2"
              },
              "items": [
                {
                  "text": "Kub 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zab 2:7",
                  "type": "text"
                }
              ]
            },
