        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oruganikyo rw'abaisiki ikumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.35"
              },
              "items": [
                {
                  "text": "Luk 12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu kasumi ako, obukama bw'omwiguru bulirengesanizibwa n'abaisiki ikumi abatwaire etaara zaabo baagenda kutangirra omuswezi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abataano bakaba bali badoma, kandi bataano b'amagezi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba abadoma obu baatwaire etaara zaabo, batatwale magita ag'okwerinza; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu ab'amagezi bakatwara amagita omu cupa n'omu taara zaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuswezi obu yakeererirwe okwija, boona baatandika kuhungira, baagwijagira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu ekiro omu itumbi bakahurra etoko ngu: ‘Dara kigabura aizire! Muturuke aheeru mumutangirre.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.6",
            "verseOrgIds": [
              "MAT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiki bali boona nubwo baimukire, baasemeza etaara zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadoma baasaba ab'amagezi bati: ‘Mutuheho amagita, habwokuba etaara zaitu zaagya kuraara.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ab'amagezi baabagarukamu bati: ‘Tigarukwija kutumara itwena; haakire inywe mugende hali abasuubuzi mwegurreyo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.9",
            "verseOrgIds": [
              "MAT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba bagenzire kugura amagita, omuswazi yaija; abo abakaba beeteekaniize baataaha nawe omu nju ey'obugenyi, n'orwigi rwakingwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.25"
              },
              "items": [
                {
                  "text": "Luk 13:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abaisiki abandi nabo baija nibagamba bati: ‘Waitu, waitu, tukingurreho!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omuswezi yagarukamu ati: ‘Mazimakwo nimbagambira nti: Timbamanyire.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki mwikalege nimurora, habwokuba timurukumanya kiro noobwekuba saaha.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Orufumo rw'abaheereza abaasiigirwe sente",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.11+LUK.19.12+LUK.19.13+LUK.19.14+LUK.19.15+LUK.19.16+LUK.19.17+LUK.19.18+LUK.19.19+LUK.19.20+LUK.19.21+LUK.19.22+LUK.19.23+LUK.19.24+LUK.19.25+LUK.19.26+LUK.19.27"
              },
              "items": [
                {
                  "text": "Luk 19:11-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obukama bw'omwiguru bulisisana nk'omuntu ow'akaba naija kwimukya orugendo; akeeta abaheereza be yabakwasa ebintu bye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaha buli omu narorra ha bwekambi bwe. Omu akamuha siringi omutwaro, gumu, ondi yamuha enkumi itaano, n'ondi yamuha rukumi rumu, hanyuma yagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu ayatungire siringi omutwaro gumu, ahonaaho yagenda yaisuubuza; yatunga amagoba omutwaro gumu ogundi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ayatungire siringi enkumi itaano, nawe yagobamu siringi enkumi itaano zindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ogu ayatungire siringi rukumi rumu, akagenda yalima ekiina omu itaka, yaserekayo sente za mukama we.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obu haahingwireho omwanya mukooto, mukama w'abaheereza abo yagaruka, yabara nabo ebi yabasigiire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu ayahairwe siringi omutwaro gumu yaija, yaleeta siringi omutwaro gumu ogundi naagamba ati: ‘Mukama wange okansigira siringi omutwaro gumu, na nyowe nkagobamu omutwaro gumu ogundi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama we yamugambira ati: ‘Webale omuheereza murungi kandi omwesigwa; oyesigirwe omu bike, ninyija kukukwasa bingi; ija osemererwe na mukama waawe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oli ayatungire siringi enkumi itaano yaija, naagamba ati: ‘Mukama wange, okansigira siringi enkumi itaano, hati ngoberemu enkumi itaano ezindi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama we yamugambira ati: ‘Webale omuheereza murungi kandi omwesigwa; oyesigirwe omu bike, ninyija kukukwasa bingi; ija osemererwe na mukama waawe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oli ayatungire siringi orukumi rumu yaija naagamba ati: ‘Waitu, nkakumanya nkooku oli muntu ngumangani. Ogesa ebi otarasigire, ohunika ebi otarasigire; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nahabweki nkatiina, naagenda naasereka siringi zaawe omu itaka. Darazo, ozitwale.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu mukama we yamugarukamu ati: ‘Muheereza iwe omubi kandi omugara! Okamanya nkooku ngesa ebi ntarasasigire, kandi mpunika ebi ntarasigire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siringi zange waakubaire ozitaire omu banka, obu naakugarukire naakuzitungire n'amagoba gaazo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki mumwiheho siringi zange, muzihe ogu anyakwina omutwaro gumu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
