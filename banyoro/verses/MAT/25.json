            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba weena anyakwina alyongerwaho ebindi bingi; baitu anyakwina ebike, n'ebi ainabyo birimwihwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
