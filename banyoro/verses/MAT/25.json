            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheereza ataina mugaso ogu, mumunage aheeru omu mwirima. Oku nuho abantu baliririrra, kandi banene ensaya.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
    },
    {
