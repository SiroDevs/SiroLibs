            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Abafalisaayo baagamba bati: “Abinga emyoyo emibi habw'obusobozi bwa mukuru wayo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
