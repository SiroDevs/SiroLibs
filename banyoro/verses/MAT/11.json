              "items": [
                {
                  "text": "10:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isenyowe akankwasa ebintu byona, kandi busaho n'omu amanyire Mwana okwihaho Ise, kandi busaho n'omu amanyire Ise okwihaho Mwana, na weena Mwana ou agonza kumusuukurra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.27",
            "verseOrgIds": [
              "MAT.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
