              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhimbe ekikoligo kyange, mwegere hali nyowe; habwokuba ndi muculeezi kandi ninyebundaaza omu mutima, na inywe mulitungira emyoyo yanyu ekihuumuro. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
