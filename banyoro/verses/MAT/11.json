            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwije nambere ndi inywena abajwahire n'abalemeriirwe mbahuumuze. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
