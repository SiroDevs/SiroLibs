              "items": [
                {
                  "text": "Luk 10:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu nimbagambira nti: Ha kiro ky'okucwerwa omusango, ensi ya Sodomu eriganyirwa kukira iwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
            "verseOrgIds": [
              "MAT.11.24"
            ]
          }
        }
      ]
