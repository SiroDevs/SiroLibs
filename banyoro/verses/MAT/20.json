            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.26"
              },
              "items": [
                {
                  "text": "Luk 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikiriba kiti omuli inywe; baitu arukwenda kuba mukuru omuli inywe, naasemerra kuba muheereza wanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi arukwenda kuba w'okubanza omuli inywe, naasemerra kuba muheereza wanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkooku Omwana w'omuntu ataraiziire kuheerezibwa baitu okuheereza, n'okuhayo obwomeezi bwe okucungura baingi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naakiza abafu b'amaiso babiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.28",
            "verseOrgIds": [
              "MAT.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba nibaruga Yeriko, ekitebe kikooto ky'abantu kyahondera Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abafu b'amaiso babiri abakaba baikaliire ha muhanda rubaju, obu baahuliire ngu, Yesu naahingura, baayamirra nibagamba bati: “Omwana wa Daudi, tugirre embabazi!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitebe ky'abantu kyabacoomera nikibaigaliriza ngu baculeere; baitu bbo baatokera haiguru okukiraho bati: “Waitu, Omwana wa Daudi, tugirre embabazi!” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yayemerra, yabeeta, yabakaguza ati: “Nimugonza mbakorre ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamugarukamu bati: “Waitu, nitugonza amaiso gaitu gaiguke.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yabakwatirwa embabazi, yabakora ha maiso, ahonaaho baarora, kandi baamuhondera.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
