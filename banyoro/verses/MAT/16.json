                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Yesu yagambiire abeegesebwa be ati: “Weena anyakugonza kumpondera, ayehwemu wenka, ahimbe omusaraba gwe, ampondere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
