              "items": [
                {
                  "text": "Bar 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana w'omuntu aliija n'abamalaika be omu kitiinisa kya Ise, nubwo alisasura buli muntu naasigikira ha bikorwa bye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mali mali nimbagambira nti: Haroho abeemeriire hanu abatalihikwaho rufu batakarozire Omwana w'omuntu naizira omu bukama bwe.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
          }
        }
