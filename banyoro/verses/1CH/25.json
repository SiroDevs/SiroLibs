          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "aba kana, Iziri, batabani be n'abanyina, boona hamu ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.11",
            "verseOrgIds": [
              "1CH.25.11"
            ]
