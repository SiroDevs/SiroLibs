            "sid": "1CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asafu na Yosefu, nubo baabandize kukwatwa itomo; aba kabiri, Gedaliya, abaanyina na batabani be, boona hamu ikumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
