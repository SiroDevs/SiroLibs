          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesobbabbu, Yamuleki, Yosa mutabani w'Amaziya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
            "verseOrgIds": [
              "1CH.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoweri, Yehu mutabani wa Yosibbiya, Yosibbiya mutabani wa Seraaya, Seraaya mutabani w'Asiyeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriyo-nayi, Yaakobba, Yesohaaya, Asaaya, Adyeri, Yesimiyeri, Bbenaaya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziiza mutabani wa Siifu, Siifu mutabani w'Alloni, Alloni mutabani wa Yedaaya, Yedaaya mutabani wa Simuli, Simuli mutabani wa Semaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banu abanyakugambirwe amabara, omubitabu byabo nubo bakaba bali bakuru, kandi amaju ga baisebo, gakakanya muno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.38",
            "verseOrgIds": [
              "1CH.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakagenda baahika ha ntaaho ya Gedora, harubaju orwa Burugaizooba orw'ekihanga, baserurre amagana gaabo iriisizo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.39",
            "verseOrgIds": [
              "1CH.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "oku nuho baazoire iriisizo erirumu obunyansi bwingi oburungi, kandi n'ensi, ekaba eri ngazi, eculiire kandi ina obusinge; habwokuba abantu abaabandize kwikara omunsi egi, bakaba bali ba Haamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubusinge bwa Hezekiya omukama wa Yuda, abantu abo abanyakugambirwe amabara eruguru, nubwo baagenzire Gerali, baahwerekereza eheema n'ensiisira z'abantu abaikaraga omunsi egi eyabahunimu. Abantu baababinga, baikarra kimu oku, habwokuba hakaba haliyo iriisizo erigalihire ery'okuliisizaamu entaama zaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu hali bo, abasaija Abasimyoni ebikumi bitaano, beebembiirwe Peratiya, Neyaliya, Rrefaaya na Uziyeri, batabani ba Isi, bakagenda ha rusozi Seyiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "baahwerekereza Abamaleki endagalikwa abakaba batabukire, baikarra kimu oku, okuhika na hati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
