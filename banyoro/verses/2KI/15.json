            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogw'ataano n'ebiri ogw'engoma y'Azariya omukama wa Yuda, Peeka mutabani wa Remalia nubwo yatandikire kulema Isirairi omu rubuga Samaliya, akalemera emyaka amakumi abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora MUKAMA ebi atasiima; ebibi Yerobbowamu mutabani wa Nebati ebi yanagiremu Isirairi atabireke.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu businge bwa Peeka omukama wa Isirairi, Tigulaasi-Pileseeri omukama wa Siriya, nubwo yaizire yahamba Lyooni, Abeeribesi-maaka, Yanoha, Kedesi, Hazora, Giryadi na Galilaaya, ensi eya Nafutaali yoona, abantu aba yahambire yabatwara Asiriya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Hoseya mutabani w'Ela, akaliirana Peeka mutabani wa Remalia, yamutema yamwita, yateera engoma omu mwaka ogw'amakumi abiri ogw'engoma ya Yosaamu mutabani wa Uzia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebindi Peeka ebi yakozire, bikahandiikwa omu kitabu eky'obusinge obw'abakama aba Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Engoma ya Yosamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwa kabiri ogw'engoma ya Peeka mutabani wa Remalia omukama wa Isirairi, Yosamu mutabani wa Uzia omukama wa Yuda, nubwo yatandikire kulema. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha yatandikiire kulema, akaba ahikize emyaka amakumi abiri n'etaano, akalemera emyaka ikumi na mukaaga omu rubuga Yerusaalemu. Ibara lya nyina, nuwe Yerusa muhara wa Zadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora ebirukusemereza MUKAMA nka ise Uzia ebi yakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu ebiikaro ebikuru eby'okuramizaaho, atabiseese; abantu bakongera kubitambirraho ebyonzira n'okubicumiikirirraho obubbani. Nuwe yayombekere irembo ery'eruguru ery'enju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu abindi Yosamu ebi yakozire, bikahandiikwa omu kitabu eky'obusinge obw'abakama ba Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebi, MUKAMA nubwo yatandikire kutweka Rezini omukama wa Siriya na Peeka mutabani wa Remalia baramagire Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosamu akafa nka baisenkuru oku baafiire, yaziikwa hamu nabo omu rubuga rwa Daudi ise; Ahazi omutabani yateera engoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
