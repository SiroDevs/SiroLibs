            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogw'amakumi ataano ogw'engoma ey'Azariya omukama wa Yuda, Pekahia mutabani wa Yenahemu nubwo yatandikire kulema Isirairi omu rubuga Samaliya, akalemera emyaka ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora MUKAMA ebi atasiima; ebibi Yerobbowamu mutabani wa Nebati ebi yanagiremu Isirairi atabireke. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peeka mutabani wa Remalia engabwa ye, akamuliirana, yayekoba hamu n'abasaija amakumi ataano Abagiryadi, yamwitira omu rubuga Samaliya, omu kikaali ky'omukama, yateera engoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebindi Pekahia ebi yakozire, bikahadiikwa omu kitabu eky'obusinge obw'abakama ba Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
