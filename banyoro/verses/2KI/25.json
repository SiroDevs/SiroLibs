                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20+1KI.7.21+1KI.7.22+1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26"
