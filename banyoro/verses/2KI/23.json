              },
              "items": [
                {
                  "text": "Yer 22:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Faraaho Neeko, akakwata Eliakimu mutabani wa Yosiya, nuwe yata ha ngoma ya Yosiya ise ibara lye Eliakimu yalihindura, yamuruka Yehoyakimu. Baitu Yehoyahazi yamwihaho; yamutwara omu nsi Misiri, oku nuho yagwire.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        }
      ]
