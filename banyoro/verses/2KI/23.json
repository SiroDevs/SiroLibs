        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya naakiraanura Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Omukama nubwo yayesire abakuru ab'Abayuda boona n'aba Yerusaalemu baije nambere ali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagenda omunju ya MUKAMA, hamu n'abantu ba Yuda n'enzaarwa zoona eza Yerusaalemu, banyakatagara boona n'abarangi, abantu boona ab'ekitiinisa n'abatali b'ekitiinisa; yabasomera bategere amatu ebigambo byona eby'ekitabu eky'endagaano ekikaba kisangirwe omunju ya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akeemerra haihi n'enyomyo, yaraganiza MUKAMA okumukuraatiraga, okukwataga Ebiragiro bye, ebigambo bye, n'ebi yamanyisize n'omutima gwe gwona n'omwoyo gwe gwona, okuhikiriza ebigambo eby'endagaano egi ebyahandiikirwe omu kitabu eki; abantu boona baateerana na uwe okukora endagaano egi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
