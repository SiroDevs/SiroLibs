                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1MA.4.52+1MA.4.53+1MA.4.54+1MA.4.55+1MA.4.56+1MA.4.57+1MA.4.58+1MA.4.59"
              },
              "items": [
                {
                  "text": "52-59",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2MA.1.18"
              },
              "items": [
                {
                  "text": "2Mak 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2MA.10.5"
              },
              "items": [
                {
                  "text": "10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu bwire obu, omu rubuga Yerusaalemu, bakaba nibakuza ekiro kikuru eky'okwijuka okwezibwa kw'Enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.22",
            "verseOrgIds": [
              "JHN.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukaba buli bwire bw'obutiti, kandi Yesu akaba naarubatarubata omunju ya Ruhanga, omu kisasi ky'omulyango gwa Solomooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.23",
            "verseOrgIds": [
              "JHN.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya baamwehinguliriza baamukaguza bati: “Olihikya nkaha kutwehanikisa emitima? Obu oraaba oli Kristo, tugambire bbwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.24",
            "verseOrgIds": [
              "JHN.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nukwo kubagarukamu ati: “Nkabagambira ira, baitu timwaikiriza. Emirimo ei ndukukora omu ibara lya Isenyowe, niyo erukungumya; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.25",
            "verseOrgIds": [
              "JHN.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu inywe timurukwikiriza, habwokuba timuli ntaama zange. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.26",
            "verseOrgIds": [
              "JHN.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entaama zange zihurra iraka lyange. Nzimanyire, nazo zimpondera; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.27",
            "verseOrgIds": [
              "JHN.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nziha obwomeezi obutahwaho, tizirihwerekerra ebiro byona. Busaho n'omu alizinsahuraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.28",
            "verseOrgIds": [
              "JHN.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.3.1"
              },
              "items": [
                {
                  "text": "Ama 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isenyowe ayazimpaire naakira boona amaani kandi busaho n'omu asobora kuzimusahuraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.29",
            "verseOrgIds": [
              "JHN.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe na Isenyowe tuli omu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.30",
            "verseOrgIds": [
              "JHN.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya baagaruka baakoma amabaale kugamuteera. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.31",
            "verseOrgIds": [
              "JHN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nukwo kubagambira ati: “Nkabooleka ebirungi bingi ebyarugire hali Isenyowe. Nikiha hali ebi ekirukubanteeza amabaale?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.32",
            "verseOrgIds": [
              "JHN.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.16"
              },
              "items": [
                {
                  "text": "Lev 24:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya baamugarukamu bati: “Titurukukuteera amabaale habw'okukora ebirungi, baitu habw'okujuma Ruhanga. Iwe nooyeyeta Ruhanga, kandi kunu oli muntu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.6"
              },
              "items": [
                {
                  "text": "Zab 82:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandiki Yesu ati: “‘Muli baaruhanga’? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.34",
            "verseOrgIds": [
              "JHN.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abaiziirwe ekigambo kya Ruhanga obu aliba yabeesire baaruhanga (kandi Ebihandiiko Ebirukwera tibisobora kucwibwa), ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.35",
            "verseOrgIds": [
              "JHN.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ogu Isenyowe ou yayereze kandi yatuma omunsi, inywe nimumugambaho muta: ‘Noojuma Ruhanga’, habw'okugamba ngu: ‘Ndi Mwana wa Ruhanga?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.36",
            "verseOrgIds": [
              "JHN.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu ndaaba ntarukukora bukwenda bwa Isenyowe, muleke kunyikiriza; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.37",
            "verseOrgIds": [
              "JHN.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu obu ndaaba nimbukora, inywe noobu muraaba mutarukunyikiriza, haakire mwikirize ebikorwa ebi ndukukora. Nukwo mumanye kandi mwetegereze Isenyowe nkooku ali omuli nyowe, na nyowe nkooku ndi omuli Uwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.38",
            "verseOrgIds": [
              "JHN.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalengaho kugaruka kumukwata, baitu yabeecwamu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naayambuka nseeri ya Yorudaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.28"
              },
              "items": [
                {
                  "text": "Yoh 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagaruka yayambuka ekisaaru Yorudaani omu kiikaro nambere Yohaana yabandize kubatiriza, yaikara oku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baingi bakaija hali uwe, baagamba bati: “Yohaana atakole kintu ekirukuhuniriza na kimu, baitu byona Yohaana ebi yagambireho omusaija onu, bikaba biri by'amazima.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oku baingi baamwikiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
      ]
    }
