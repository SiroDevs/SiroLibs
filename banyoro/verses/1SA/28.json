                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10"
              },
              "items": [
                {
                  "text": "Bir 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako, Samwiri akaba amazire kufa, Abaisirairi boona bakamulirirra, baamuziika Rama omurubuga rwe rwonyini. Omubwire obu, abaabandwaga emizimu n'abarogo, Saulo akaba ababingire omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.3",
            "verseOrgIds": [
              "1SA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahe g'Abafirisiti gakeesorooza baateera orukande Sunemu; Saulo na uwe nukwo kusorooza Abaisirairi boona, nabo baateera orukande Giriboha; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.4",
            "verseOrgIds": [
              "1SA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo obuyaboine ihe ery'Abafirisiti, yatiina enkizi yaserra kumwita. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.5",
            "verseOrgIds": [
              "1SA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.21"
              },
              "items": [
                {
                  "text": "Kubar 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuyayekagwize hali MUKAMA, MUKAMA atamugarukemu naamuroosa, n'amutumaho banyakatagara rundi abarangi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.6",
            "verseOrgIds": [
              "1SA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nubwo yaragiire abaheereza ati: “Munserurre omukazi arukubandwa emizimu, nuwe ngende nyekaguzeeho.” Abaheereza be baamugarukamu bati: “Endoori, nuho hali omukazi arukubandwa emizimu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.7",
            "verseOrgIds": [
              "1SA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nukwo kwehindura aleke kumanyirirwa, yajwara ebyokujwara ebindi, obwire obubwamazire kwira, yagenda mb'omukazi oli hamu n'abasaija babiri. Saulo yaragira omukazi ati: “Ndagura nooyekonyeza omuzimu, ondeetere omuntu wena ou ndaakugambira ibara.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.8",
            "verseOrgIds": [
              "1SA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yamugarukamu ati: “Ningira omanyire Saulo ekiyakozire, nkooku yabingire boona abanyakubandwa emizimu n'abarogo yabamara omunsi. Hati iwe, nontegera ki omutego ogw'okunyita.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.9",
            "verseOrgIds": [
              "1SA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yarahira omukazi naajurra MUKAMA ati: “Ndahiire MUKAMA omwomeezi, obu oraakora ekintu kinu, torukwija kuhikwaho kifubiro na kimu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.10",
            "verseOrgIds": [
              "1SA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.46.20"
              },
              "items": [
                {
                  "text": "Sir 46:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi nubwo yakagwize Saulo ati: “Nkwetere oha?” Saulo yagarukamu ati: “Nyetera Samwiri.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.11",
            "verseOrgIds": [
              "1SA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi obuyaboine Samwiri, yatoka muno yakaguza Saulo ati: “Ombiihiire ki? Ka niiwe Saulo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.12",
            "verseOrgIds": [
              "1SA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yagarukamu omukazi ati: “Otatiina; yamukaguza ati: Noorora ki?” Omukazi yagarukamu ati: “Nindora omuzimu niguruga omwitaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.13",
            "verseOrgIds": [
              "1SA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yayongera yakaguza omukazi ati: “Omuzimu ogu nigusisana guta?” Omukazi yagarukamu ati: “Omugurusi nuwe ndukurora naatemba; ajwaire ekanzu.” Saulo nukwo kumanya omuntu ogu nkooku ali Samwiri, yajuumara hansi, yamutamu ekitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.14",
            "verseOrgIds": [
              "1SA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri yakaguza Saulo ati: “Ontalibaniriizeeki kundeeta hanu?” Saulo yagarukamu ati: “Ndi omukabi akatagambwa; nindwana na Abafirisiti, kandi Ruhanga andugireho takyangarukamu naaraba omu barangi, rundi omukundoosa ebirooto, nukwo kukweta ongambire ekinsemeriire kukora.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.15",
            "verseOrgIds": [
              "1SA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samwiri yakaguza Saulo ati: “MUKAMA obwaraaba yakurugireho yafooka munyanzigwa waawe, kandi nyowe nonkaguliza ki? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.16",
            "verseOrgIds": [
              "1SA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.28"
              },
              "items": [
                {
                  "text": "1 Sam 15:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akukozire ekiyakugambiriire omuli nyowe; obukama abukwihireho, yabuha omutaahi ou oherraine nawe, nuwe Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.17",
            "verseOrgIds": [
              "1SA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15:3-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba otahurre MUKAMA ekiyakuragiire, tiwahweekereza Abamaleki n'ebintu byabo byona, nikyo MUKAMA arukukukorra ati. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.18",
            "verseOrgIds": [
              "1SA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torukwija kugarukira aho honka, Abaisirairi boona na iwe otabuziremu, naija kubaihamu emikono abalekere Abafirisiti; ijo, iwe n'abatabani bawe muliija nambere ndi, ihe ery'Abaisirairi MUKAMA nukwo abalekere Abafirisiti.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo, habw'obutiini nyamwingi obw'ebigambo Samwiri ebiyagambire, ahonaaho yayeteera hansi; wena amaani gaamuhwamu, habwokuba akaba asiibire kandi araire ataliire kantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yahikaho Saulo yamugambira ati: “Nyowe omuzaana wawe mpuliirege ekyogambire, obwomeezi bwange nabuhwamu nakora ekyondagiire; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
