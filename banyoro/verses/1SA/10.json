          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Samwiri yasoborra abantu obusobozi n'emirimo y'omukama; ebiyabihandiika omukitabu yakita omumaiso ga MUKAMA. Nubwo yaraga abantu, buli omu yakwata ogw'owabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.25",
            "verseOrgIds": [
              "1SA.10.25"
            ]
          }
        },
        {
