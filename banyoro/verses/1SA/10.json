              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo, na uwe akagenda omuka ye Gibeha, hamu n'abasaija ab'amaani Ruhanga abayayorobeze emitima. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
