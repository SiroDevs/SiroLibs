                "loc": "PSA.57"
              },
              "items": [
                {
                  "text": "Zab 57",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.142"
              },
              "items": [
                {
                  "text": "142",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaruga oku, yairuka yagenda omubwingira bwa Aduraamu; abaanyina neeka ya ise yoona obubaahuliire ekigambo eki, baamuhondera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weena ow'akaba aina omuhito, weena ow'akaba naatongwa ibanja, na weena ow'akaba aina ibanja, na weena ow'akaba aina obusaalizi, bakamwebinga; yafooka mukuru wabu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuyarugire aho, yagenda Mizipa eya Mowabbu, yagambira omukama w'ensi egi ati: “Nkwesengeriize, oikirize ise nyowe na nyina nyowe baikalege na iwe, okuhika obundakeeteegereza MUKAMA ekyarankorra.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazaire be yabasigira omukama wa Mowabbu, baikara na uwe akasumi koona aka yamazire ayeserekere omubwingira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omurangi Gaadi nubwo yagambiire Daudi ati: “Ruga hanu ogende omunsi ya Yuda.” Na uwe yakwata omuhanda, yataaha omukibira ekya Heresi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro kimu, Saulo akaba ali Gibeya hansi y'omuti omunyinya, ogukaba guli ha rusozi, akwasire icumu lye, abaheereza be boona bamwehinguliriize. Abantu baamugambira ngu: “Daudi n'abasaija be boona, bakazooka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakaguza abaheereza be ati: “Inywe Ababenyamiini, nimuteekereza mutabani wa Yese inywena alibaha emisiri etali y'emizabbibbu n'ey'emizabbibbu, alifoora ngabwa ez'okulema abantu enkumi n'ez'okulema ebikumi, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikyo murukundiiranira? Busaho noomu hali inywe ayangambirre mutabani wange nkooku arukwikirraniza na mutabani wa Yese, busaho noomu hali inywe arukunsaalirirwa rundi kungambira mutabani wange nkooku yaleeteriize abaheereza bange kundwanisa, n'okunyeserekerra nkooku bakozire kiro kinu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.7+1SA.21.8+1SA.21.9"
              },
              "items": [
                {
                  "text": "1 Sam 21:7-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.52"
              },
              "items": [
                {
                  "text": "Zab 52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dohegi Omwedomu, owakaba ayemeriire haihi n'abaheereza ba Saulo, nubwo yagarukiremu ati: “Nyowe nkabona mutabani wa Yese naagenda Nobu hali Ahimereki mutabani wa Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimereki yamukaguliza hali MUKAMA, yamuha ebyokulya empirima ya Golyasi Omufiristi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Saulo nukwo kutuma abantu beete Ahimereki nyakatagara mutabani w'Ahitubu, neeka ya ise yoona, nubo abo abakaba nabo bali banyakatagara b'omukiikaro Nobu; boona baahikaho omukama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.11",
            "verseOrgIds": [
              "1SA.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yagamba ati: “Iwe mutabani w'Ahitubu, otege okutu.” Oli yagarukamu ati: “Nzaire, nyeteekaniize okukora kyona ekyorakagamba.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Habwaki wayekobere na mutabani wa Yese kundiirana okamuha ebyokulya n'empirima, okamukaguliza hali Ruhanga, nukwo andwanise kandi anyeserekerre nkooku akozire kiro kinu?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimereki yakaguza omukama ati: “Omubaheereza bawe boona, nooha omwesigwa nka Daudi? Nuwe muko wawe, nuwe ngabwa y'abaserikale bawe, kandi eka yawe yoona emutamu ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiro kinu, nubwo nabanza kumukaguliza hali Ruhanga? Nikikafuuhe! Omukama aleke kutekereza kubi nyowe omwiru we, kandi aleke kutekereza kubi eka ya ise nyowe; nyowe omwiru waawe, ekintu eki tinyina ekinkimanyireho n'akataito kati.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yagamba ati: “Iwe Ahimereki, neeka ya sso yoona, muli b'okufa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yagambira abaserikale abalinzi abakaba bamuli haihi ati: “Ija mwite baanyakatagara ba MUKAMA abo, habwokuba nabo bakeekoba na Daudi, bakamanya nkooku yairukire, baitu tibangambira.” Baitu abaserikale baayanga kwita baanyakatagara ba MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama nukwo kuragira Dohegi ati: “Weza iwe baite.” Dohegi Omwedomu ataikazeeho, yagwera baanyakatagara, kiro eki akaita kinaana na bataano, abo abaajwaraga efodi ya kitaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.18",
            "verseOrgIds": [
              "1SA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi Nobu yoona, orubuga rw'abanyakatagara, yagiisa empirima; yaita abasaija n'abakazi, abaana abakuruho n'enkerembe, enimi, enkaina n'entaama, ebi byona yabiisa empirima.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omwana omu ha baana ba Ahimereki mutabani wa Ahitubu ibara lye Abyasara, akairuka yakurata Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
            "verseOrgIds": [
              "1SA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamugambira Saulo nkooku yaisire baanyakatagara ba MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yamugarukamu ati: “Eki nkakimanya ha kiro eki kyonyini, Dohegi Omwedomu nkooku akaba ali oku, nkagumya nkooku arukwija kugambira Saulo. Abantu abeeka ya sso boona, bafiire ha bwange. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
              "1SA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe twikale hamu, leka kutiina; habwokuba ogu arukwenda kukwita, naayenda kwita na nyowe; baitu obuturaaba tuli hamu, torukwija kuhikwaho kabi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.23",
            "verseOrgIds": [
              "1SA.22.23"
            ]
          }
        }
      ]
    }
  ],
