                "loc": "ISA.47.1+ISA.47.2+ISA.47.3+ISA.47.4+ISA.47.5+ISA.47.6+ISA.47.7+ISA.47.8+ISA.47.9+ISA.47.10+ISA.47.11+ISA.47.12+ISA.47.13+ISA.47.14+ISA.47.15"
              },
              "items": [
                {
                  "text": "Is 47:1-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Yer 50:1—51:64.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binu nibyo ebigambo ebirukubaza hali Bbabbulooni, Isaaya mutabani w'Amozi ebi yagambiirwe Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
