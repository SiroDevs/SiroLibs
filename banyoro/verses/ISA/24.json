          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MUKAMA naacwera ensi omusango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA alihwerekereza ensi agimalemu abantu, aligijuumika, ararangye abagiikaramu ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.1",
            "verseOrgIds": [
              "ISA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona balihikwaho ebintu binu, ebirihikaho abantu kwonka, nibyo birihikaho banyakatagara, ebirihikaho abairu, nibyo birihikaho bakama baabo; ebirihikaho abazaana nibyo birihikaho bagole baabo; ebirihikaho abaguzi, nibyo birihikaho abatunzi; ebirihikaho abarukwehora, nibyo birihikaho abarukutongwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.2",
            "verseOrgIds": [
              "ISA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi erihwerekererra kimu, kandi erisiisikarra kimu; habwokuba eki, MUKAMA nuwe akigambire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.3",
            "verseOrgIds": [
              "ISA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi neeteera empamo neeganya kandi neehotoka, ensi yoona neruhirra kandi ehotokere; iguru nirihwerra hamu n'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.4",
            "verseOrgIds": [
              "ISA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu basiisire ensi, nibacwa ebiragiro bya Ruhanga kandi nibacwa endagaano ei yataireho ikaleho obusinge bwona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.5",
            "verseOrgIds": [
              "ISA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga nukwo kukyena ensi; abantu nibasasurwa eki baakozire, nikyo abaikazi baamu barukusiririirra, hasigaireho abantu mbarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.6",
            "verseOrgIds": [
              "ISA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emizabbibu neehotoka, viini etandikire kukeeha. Abantu boona ira abaikaraga basemeriirwe, hati bali omu obujune. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.7",
            "verseOrgIds": [
              "ISA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaikaraga basemeriirwe nibateera enjogera, baculiire, etoko ey'abantu abagira omuhimbo tekyaroho, okusemererwa kw'abateezi b'enanga kuhoireho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.8",
            "verseOrgIds": [
              "ISA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu tibakyanywa viini nibazina ebizina; eky'okunywa eky'amaani, nikisaalirra abo abakinywa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.9",
            "verseOrgIds": [
              "ISA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu rubuga ebintu byona birarangire, amaju goona gakingirwe, nukwo haleme kubaho n'omu arukutaaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.10",
            "verseOrgIds": [
              "ISA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu nibateera enduuru omu mihanda habw'okuburwa amarwa; omuhimbo tigukyaroho, okusemererwa kw'ensi kukahwerekerra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.11",
            "verseOrgIds": [
              "ISA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orubuga, tirurumu kantu, amalembo garwo bikamburo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.12",
            "verseOrgIds": [
              "ISA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo kirukwija kubaho omu mahanga goona, omunsi yoona. Nikiija kuba nk'omu kasumi k'isingorra, emiti yoona emazire kunogororwa, n'ebijuma eby'okumalirra bimazire kunogwa hamizabbibbu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.13",
            "verseOrgIds": [
              "ISA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasigaireho baliimukya amaraka bazine habw'omuhimbo, aba Bugwaizooba, balisubirra MUKAMA nkooku ali mukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.14",
            "verseOrgIds": [
              "ISA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, inywe aba Burugaizooba muhaisanize MUKAMA, aba hamikungu y'enyanja, muhaisanize ibara lya MUKAMA, Ruhanga owa Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.15",
            "verseOrgIds": [
              "ISA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mitaano yoona ey'ensi, nituhurra ebizina eby'okuhaisaniza, eby ekititiinisa hali Ogu Omuhikiriire. Baitu nyowe ningamba nti: “Mpoireho, mpoireho obujune bw'okunyita, kamboine! Encwangya ikora eby'obucwangya.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.16",
            "verseOrgIds": [
              "ISA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe abantu abali omunsi, mutege amatu, mbagambire ebintu ebirukutiinisa, obuhya n'omutego bibategeriize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.17",
            "verseOrgIds": [
              "ISA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ow'alihurra ekintu ekirukutiinisa akairuka, aligwa omu buhya; ow'alitabuka obuhya, alikwatwa omutego Habwokuba amadirisa g'iguru gakingwirwe, emisingi y'ensi neetengeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.18",
            "verseOrgIds": [
              "ISA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi ericwekacweka ensi eribagaanuka ensi eritengeeta muno. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.19",
            "verseOrgIds": [
              "ISA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi erizongazonga nk'omutamiizi, eritengatengeta nk'akasiisira; ekibi kyayo kirigiremeera erigwa, kandi obu erimara kugwa, terigaruka kwimuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.20",
            "verseOrgIds": [
              "ISA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, MUKAMA alifubira ebintu byona ebya haiguru, omwiguru, n'abakama ab'ensi abanyakuli hansi, omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.21",
            "verseOrgIds": [
              "ISA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balisoroolezibwa hamu nk'abanyankomo abanyakuli omu kiina; balikingirwa omu nkomo, kandi obu halihinguraho ebiro bingi, balifubirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.22",
            "verseOrgIds": [
              "ISA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwezi kuliswekwa omwirima, izooba tiririgaruka kujwa; habwokuba, MUKAMA ow'amahe alirema ha rusozi Siyoni orwa Yerusaalemu, kandi alyoleka abantu ekitiinisa kye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.24.23",
            "verseOrgIds": [
              "ISA.24.23"
            ]
          }
        }
      ]
    }
  ],
