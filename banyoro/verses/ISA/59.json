            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.26"
              },
              "items": [
                {
                  "text": "Bar 11:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: ndiija Siyoni ndi mucunguzi w'aba Yakobbo abaafuuhize obubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 59:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA naagamba ati: Enu niyo ndagaano yange ei ndukuragaana nabo: Mwoyo wange ou mbahaire, n'ebigambo byange ebi mbeegeseze, bitalibaruga omukanwa; kandi bitaliruga omu kanwa k'abaana banyu, n'ak'abaijukuru banyu, ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.21",
            "verseOrgIds": [
              "ISA.59.21"
            ]
          }
        }
      ]
