              "1KI.7.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.17+EXO.30.18+EXO.30.19+EXO.30.20+EXO.30.21"
              },
              "items": [
                {
                  "text": "Kurug 30:17-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi akakora ebbeseni ez'omulinga; buli bbeseni, yahikyaga emikono ena, hakaba haroho ebbeseni ey'okuteekwa omu buli emu ha ntebe ziri ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.38",
            "verseOrgIds": [
              "1KI.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bukiizi obw'obulyo na ha bw'emoso, akatayo entebe itaano itaano; etanka yagita ha bukiizi obw'obulyo obwa Burugaizooba obw'enju.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.39",
            "verseOrgIds": [
              "1KI.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu na uwe, akabumba ebinaga, yaheesa ebitiyo n'ebbeseni. Aho, yamara omulimo gwona ogu yakoliire omukama Solomooni ha nju ya MUKAMA: Binu nibyo yakozire: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyomyo ibiri ebbakuli ibiri ez'emitwe eyekaba eri ha nyomyo eruguru, obutimba bubiri obw'okusweka ebbakuli ibiri ez'emitwe eyekaba eri eruguru y'enyomyo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.41",
            "verseOrgIds": [
              "1KI.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebisisani by'enkomamahanga eby'okuhunda obutimba, eby'okusweka ebbakuli ibiri ez'emitwe eyekaba eri ha nyomyo; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.42",
            "verseOrgIds": [
              "1KI.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "enyomyo ikumi, n'ebbeseni ikumi ezaaikaraga ha ntebe; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.43",
            "verseOrgIds": [
              "1KI.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "etanka emu, n'ebisisani by'enimi ikumi na ibiri ezikaba ziri hansi y'etanka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.44",
            "verseOrgIds": [
              "1KI.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebinaga, ebitiyo, n'ebbeseni, ebikwato byona eby'omunju ya MUKAMA, Hiramu ebi yakoliire omukama Solomooni, bikaba biri by'omulinga omurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.45",
            "verseOrgIds": [
              "1KI.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi, omukama akabyagiza omu kyeya kya Yorudaani, ha itaka ery'ibumba, hagati ya Sukosi na Zeresani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.46",
            "verseOrgIds": [
              "1KI.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomooni ebintu byona atabirenge, habwokuba bikaba biri bingi muno; omulinga gutamanywe nambere gukaba nigwingana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.47",
            "verseOrgIds": [
              "1KI.7.47"
            ]
          }
        }
      ]
    },
