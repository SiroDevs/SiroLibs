          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebindi ebya Nadabu, na byona ebi yakozire, bikahandiikwa omu kitabu eky'obusinge obw'abakama aba Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama Asa owa Yuda n'omukama Baasa owa Isirairi baikaraga nibarwana obwomeezi bwabo bwona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        }
