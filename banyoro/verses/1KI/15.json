            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwa kabiri ogw'engoma y'omukama Asa owa Yuda, Nadabu mutabani wa Yerobbowamu, nugwo yatandikiiremu kulema Isirairi; akalema Isirairi okumara emyaka ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora MUKAMA ebi akaba atarukwenda, akakwata engeso za ise, yakora ekibi kandi yakikoza Isirairi yoona.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
