                  "text": "1 Bakam 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akarumisa kuteera engoma ati, yaita enju ya Yerobbowamu yoona; omunju ya Yerobbowamu, atasigemu muntu n'omu omwomeezi, akabahwerekereza boona nkooku MUKAMA yagambiire omukanwa k'omwiru we Ahija Omusiiro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaturwa ebibi Yerobbowamu ebi yakozire, n'ebi yakoleze Abaisirairi boona, n'ekiniga eki yakwasize MUKAMA Ruhanga owa Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
