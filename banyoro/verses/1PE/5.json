            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbahandiikiire ebbaruha enu engufu, ninkoonyerwa Siraasi ou ndukumanya nkooku ali w'oruganda omwesigwa. Nimbateererra kandi nimbamanyisa enyegesa enu nkooku erumu embabazi za Ruhanga ez'amazima; mugigumiremu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
