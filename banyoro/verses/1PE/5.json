            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitebe ky'abaikiriza abali Bbabbulooni, akyakomerwe Ruhanga nka inywe, nikibaramukya. Omwana wange Mariko nawe naabaramukya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muramukyangane nimugwangana omu kifuba n'engonzi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
    },
