          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.34"
              },
              "items": [
                {
                  "text": "Nfu 3:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na inywe abasigazi mworobere abakuru. Inywena mwekambire kuheerezangana nimwebundaaza, buli omu omu rubu rwe; habwokuba: “Ruhanga ahakaniza abeekuliiriza; baitu abeebundaaza, abaha omugisa.”",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.5",
            "verseOrgIds": [
              "1PE.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
