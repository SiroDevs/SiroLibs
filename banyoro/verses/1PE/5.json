              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwerinde kandi mwikale nimurora. Sitaani, omuzigu wanyu, naarabanganamu nk'entale erukubbukura, neeserra ou eraajunjubura. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.8",
            "verseOrgIds": [
              "1PE.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwangirre, mugumiire omu kwikiriza kwanyu, nimumanya bagenzi banyu ab'omunsi yoona nkooku bahikwaho okubonesibwa nk'okwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.9",
            "verseOrgIds": [
              "1PE.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi obu muliba mumazire kubonesibwa akacu kake, Ruhanga ow'embabazi nyingi, ayabeetiire ekitiinisa kye ekitahwaho omu Kristo, alibahuumuza, alibagumya, kandi alibongera amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.10",
            "verseOrgIds": [
              "1PE.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulemi bwikale nawe ebiro byona. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
