              "items": [
                {
                  "text": "18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki mwebundaaze mwikirize kulemwa obusobozi bwa Ruhanga, nukwo akasumi obu kalihika asobole kubanyumiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.2.1+SIR.2.2+SIR.2.3+SIR.2.4+SIR.2.5+SIR.2.6+SIR.2.7+SIR.2.8+SIR.2.9+SIR.2.10+SIR.2.11+SIR.2.12+SIR.2.13+SIR.2.14+SIR.2.15+SIR.2.16+SIR.2.17+SIR.2.18"
              },
              "items": [
                {
                  "text": "Sir 2:1-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okutuntura kwanyu kwona mukumukwase, habwokuba abataho omutima.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.7",
            "verseOrgIds": [
              "1PE.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
