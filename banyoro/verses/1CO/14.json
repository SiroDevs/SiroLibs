          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyonka byona bikorwe kurungi kandi nibihonderangana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
