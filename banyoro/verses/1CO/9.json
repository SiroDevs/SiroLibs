          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu nsaalize omubiri gwange, kandi ngulema, nukwo obu ndimara kurangirra abandi, ntaliija kubarwa nk'atahikire.",
          "type": "text",
