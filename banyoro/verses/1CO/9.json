          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nyowe tinyiruka ntaina eki ndukugenderra, kandi tinteera ntomi nk'arukuteera amasa; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.26",
            "verseOrgIds": [
              "1CO.9.26"
            ]
          }
        },
        {
          "name": "verse",
