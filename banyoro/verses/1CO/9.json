              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muzaani ayemanyiiza kwetanga omu bintu byona. Eki, bakikora habw'okutunga ekondo erukuhwaho, baitu itwe tutunga ekondo etarukuhwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.25",
            "verseOrgIds": [
