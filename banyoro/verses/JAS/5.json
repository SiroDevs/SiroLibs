                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Bakam 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.1"
              },
              "items": [
                {
                  "text": "18:1",
