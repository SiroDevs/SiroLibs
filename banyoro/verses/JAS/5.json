            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriya akaba ali muntu nka itwe, baitu akasaba ataireho omutima ngu, enjura ereke kugwa, kandi enjura yamara emyaka esatu n'ameezi mukaaga etarukugwa ha nsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
