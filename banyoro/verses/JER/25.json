            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Hanyuma mugambire abantu muti: ‘MUKAMA ow'amahe, Ruhanga owa Isirairi naagamba ati: Munywe mutamiire, kandi mutanake, mugwe kandi mutagaruka kwimuka, habw'empirima ei ndukwija kubanagamu.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
