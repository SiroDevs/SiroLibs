            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obu baraayanga kukwihaho ekikopo eki bakanywa, nubwo obagambire oti, ‘MUKAMA ow'amahe naagamba ati: nimusemerra Munywe! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ntandikire kukora akabi ha rubuga orwarukirwe ibara lyange, ninywe muraagurukwa ekifubiro? MUKAMA ow'amahe naagamba ati, timwagurukwe kifubiro, habwokuba nintumisa empirima ey'okurwanisa abasi ab'ensi yoona.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
