            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obagambire oti: ‘Linu niryo ihanga eritarahuliire MUKAMA Ruhanga walyo, likanga kworoorwa; amananu gakahwerekerra; gakabaruga n'omu kanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyemwe isoke olihungule hara; oteere empamo hansozi ezitaroho kantu, habwokuba MUKAMA ayangire kandi ayogere abantu abayabihiriirwe.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        }
      ]
    },
