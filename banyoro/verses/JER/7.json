              },
              "items": [
                {
                  "text": "Lev 18:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kihanga ekya Hinoomu, bombekeremu itambiro, ibara lyalyo Tofesi, niryo batambirehoga batabani baabu na bahara baabu, babookye omu murro. Eki ntabaragire kukikora, n'okukiteekereza tinkakiteekerezaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.31",
            "verseOrgIds": [
              "JER.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: akasumi kahikire akalitalyongera kweterwamu Tofesi, rundi ekihanga kya mutabani wa Hinoomu, baitu aka lirweterwamu ekihanga eky'ifeero, kalihika, habwokuba habw'okuburwa omwanya handi, baraaziikaga Tofesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.32",
            "verseOrgIds": [
              "JER.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emitumbi y'abantu abo, eriboijwa amanyonyi ag'omu mwanya, eriibwe enyamaiswa ez'omu iswa; tihalibaho muntu ow'okubibinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.33",
            "verseOrgIds": [
              "JER.7.33"
            ]
          }
        },
