          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA naagamba ati: Batabani ba Yuda bakozire ekibi ndoleriire nti; omunju eyarukirwe ibara lyange numwo bataire ebisisani eby'embandwa zaabu, nukwo bagisiise. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
