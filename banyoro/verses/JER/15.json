                {
                  "text": "1 Sam 7:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, MUKAMA yangambira ati, “Musa na Samwiri noobu baakunyemerra omumaiso, nabwo abantu banu tinaakubagiriire mbabazi. Babinge bagende; bagambire banduge omumaiso.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA naagamba ati: Ninyija kubakomera ebintu ebihwerekereza eby'emiringo ena: empirima ey'okubaita, embwa ez'okubataagatagura, amanyonyi ag'omu mwanya ag'okubaboija n'enyamaiswa ez'omwirungu ez'okubajunjubura n'okubahwerekereza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.1+2KI.21.2+2KI.21.3+2KI.21.4+2KI.21.5+2KI.21.6+2KI.21.7+2KI.21.8+2KI.21.9+2KI.21.10+2KI.21.11+2KI.21.12+2KI.21.13+2KI.21.14+2KI.21.15+2KI.21.16"
              },
              "items": [
                {
                  "text": "2 Bakam 21:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
                  "text": "2 Byok 33:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habw'ebikorwa ebibi Manaase mutabani wa Hezekiya omukama wa Yuda ebi yakoliire Yerusaalemu, ndibafoora kintu ky'okutiinwa abakama boona ab'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya n'ahakaniza MUKAMA",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawe, mau, mahano iwe kuzaara nyowe omusaija ow'empaka kandi arukuhakaniza ensi yoona! Tinkoohozaaga habwensaagi, kandi omuntu takanyohozaaga, baitu abantu boona bankondereza! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA, obu ndiba ntarakuheeriize kurungi, obu ndiba ntaratonganiriire abanyanzigwa bange hali iwe, bali omu kabi n'omu muhito byona ebi bankonderiize bihikirre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busaho muntu asobora kucwa ekyoma, munomuno ekyoma ekya habukiizi bw'emoso, ekinyakutabiremu omulinga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habw'ebibi byawe ebi wakozire omunsi yoona, obuguuda bwawe bwona na byona ebi wayahwiire ndibihayo binyagwe, bisasule ebibi ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibafoora bairu b'abanyanzigwa banyu omunsi ei mutamanyire,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MUKAMA naananura Yeremiya",
          "type": "text"
        }
      ]
    }
