          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati: “Omuntu omunyamagezi, aleke kwenyumiza habw'amagezi ge, ow'amaani aleke kwenyumiza habw'amaani ge, omuguuda aleke kwenyumiza habw'obuguuda bwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
