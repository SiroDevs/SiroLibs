                "loc": "1CO.1.31"
              },
              "items": [
                {
                  "text": "1Kor 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.17"
              },
              "items": [
                {
                  "text": "2Kor 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "anyakusemeriire kwenyumiza, nuwe ogu anyakunyetegereza kandi anyakuumanyire, ngu ninyowe MUKAMA ow'engonzi ezitayuga, ow'obwinganiza kandi ow'obuhikiriire omunsi; Habwokuba MUKAMA naagamba ati; ebintu ebi nibyo ngonza.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
