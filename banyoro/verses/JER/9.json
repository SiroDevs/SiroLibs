              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA naagamba ati, akasumi aka ndifubirramu abantu abo abasazirwe omu mubiri kwonka, kandi kunu omu mwoyo tibasazirwe, kalihika. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo nubo Abanyamisiri, Abayudaaya, Ab'edomu, batabani b'Amooni, Abamowabbu, na boona abanyakwikara omwirungu, abanyakukona hambaju isoke ryabu; habwokuba amahanga ago goona tigasazirwe, kandi enju ya Isirairi yoona, tesazirwe omu mutima.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
      ]
    }
