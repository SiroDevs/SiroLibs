                "loc": "2KI.24.18+2KI.24.19+2KI.24.20"
              },
              "items": [
                {
                  "text": "2 Bakam 24:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2 Byok 36:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekiya mutabani wa Yosiya omukama wa yuda, obwakaba yatandika kulema MUKAMA akangambira ekigambo kinu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“oyesibire emiguha n'ekikoligo eky'ebihongozo okyete omu bikya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otumeho omukama w'Edomu, omukama wa Mowabbu, omukama wa batabani b'Amooni omukama wa Taya, n'omukama wa Sidoni, abakwenda baabu abanyakwizire Yerusaalemu omba Zedekiya omukama wa Yuda, nubo batwale obukwenda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "obaragire, kinu nikyo bagambire bakama baabu bati: ‘MUKAMA ow'amahe Ruhanga owa Isirairi naagamba ati: Kinu nikyo mugambire bakama banyu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ninyowe nahangire ensi yoona, nagihangisa obusobozi bwange obutagambwa n'amaani gange, hamu n'abantu n'ebisoro ebinyakuli omunsi, ngiha weena ou ndora asemeriire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "BAR.3.16"
              },
              "items": [
                {
                  "text": "Baru 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "BAR.3.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati ensi zinu zoona nzihaire Nebbukadaneza omukama wa Bbabbulooni omuheereza wange; kandi mmuhaire n'enyamaiswa zimukorre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga goona galimuheereza, galiheereza mutabani we n'omwijukuru okuhika akasumi ak'ihanga lye lyonyini kugwa obu kalihika; hanyuma amahanga maingi n'abakama ab'ekitiinisa, balimufoora mwiru wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘“MUKAMA naagamba ati, baitu kakuba habaho ihanga, rundi obukama obutaliheereza Nebukadeneza ogu omukama wa Bbabbulooni, bukeeta omu bikya ekikoligo ky'omukama wa Bbabbulooni; ihanga eri ndirifubiza empirima, kiihe, na kagingo, okuhika obu ndikamwikiriza kulihwerekereza kimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki abarangi banyu, abafumu, abaroosi, abaraguzi n'abarogo abarukubagambira ngu, ‘Mutaliheereza omukama wa Bbabbulooni, muleke kubahurra.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba nibabarangira ebisuba, ekirirugamu nukwo kuzaahisibwa muruge omunsi yanyu, ndibabinga muhwerekerre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA n'agamba ati, ihanga lyona eriryehongera omukama wa Bbabbulooni likamuheereza, ndirireka liikale omunsi yalyo, ligirime, ligiikalemu.”’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekiya omukama wa Yuda, nawe nukwo namugambiire nti, “Wehongere omukama wa Bbabbulooni, omuheereze n'abantu, nubwo olyoomeera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe n'abantu bawe, muliitirwa ki empirima, kiihe na kagingo, MUKAMA nkooku yagambireho ihanga lyona eritaliheereza omukama wa Bbabbulooni? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarangi abarukubagambira ngu, timulihereza omukama wa Bbabbulooni, muleke kwikiriza ebi barukugamba, nibabarangira ebisuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati, ntabatume, nibaranga ebisuba omu ibara lyange, ekirirugamu, nukwo kubabinga muhwerekerre n'abarangi banyu abarukubarangira.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, nubwo nabaliize banyakatagara n'abantu abo boona nti, “MUKAMA naagamba ati: Abarangi banyu abarukubarangira nibagamba bati, ‘Ebikwato eby'enju ya MUKAMA biri haihi kugarurwa Bbabbulooni,’ ebigambo byabo muleke kubiikiriza, habwokuba nibabarangira ebisuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabaikiriza, muheereze omukama wa Bbabbulooni nubwo mwomeere. Orubuga runu, rwazira ki kufooka itongo? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baraaba bali barangi, kandi obu baraaba baaragiirwe MUKAMA, beesengereze MUKAMA ow'amahe, ebikwato ebyasigirwe omunju ya MUKAMA, ebyasigirwe omunju ya Yuda na Yerusaalemu, bireke kugenda Bbabbulooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba enyomyo, enyanja, ebitebe eby'okuteekamu ebintu ebindi, na habikwato ebindi ebyasigaire omurubuga, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebbukadaneza omukama wa Bbabbulooni ebi ataraihire Yerusaalemu, naazaahya Yekoniya mutabani wa Yehoyakimu omukama wa Yuda, n'abanyoro boona aba Yuda na Yerusaalemu, yabazaahisiza Bbabbulooni, MUKAMA ow'amahe naabigambaho ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.20",
            "verseOrgIds": [
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikwato ebyasigaire omunju ya MUKAMA, omunju y'omukama wa Yuda na Yerusaalemu, MUKAMA ow'amahe Ruhanga owa Isirairi naabigambaho ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biritwarwa Bbabbulooni biikaleyo, okuhika obu ndibiteekereza, nubwo ndibigarra mbiteeranize ha kiikaro kinu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    }
  ],
