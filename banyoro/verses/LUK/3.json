          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu boona obu baamazire kubatizibwa, Yesu nawe yabatizibwa kandi akyali aho naasaba, iguru lyakinguka, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.21",
            "verseOrgIds": [
              "LUK.3.21"
            ]
          }
        },
