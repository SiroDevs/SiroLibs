          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi mutabani wa Yese, Yese mutabani wa Obedi, Obedi mutabani wa Bowazi, Bowazi mutabani wa Sala, Sala mutabani wa Nahasooni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.32",
            "verseOrgIds": [
