            "number": "27",
            "style": "v",
            "sid": "LUK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yooda mutabani wa Yohanani mutabani wa Rehesa, Rehesa mutabani wa Zerubabeeri, Zerubabeeri mutabani wa Seyahtyeri, Seyahtyeri mutabani wa Neeri, Neeri mutabani wa Meleki, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.27",
            "verseOrgIds": [
              "LUK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meleki mutabani wa Adi, Adi mutabani wa Kosamu, Kosamu mutabani wa Erimoodamu, Erimoodamu mutabani wa Eri, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.28",
            "verseOrgIds": [
              "LUK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eri mutabani wa Yoswa, Yoswa mutabani wa Eryezeeri, Eryezeeri mutabani wa Yolimu, Yolimu mutabani wa Mataati, Mataati mutabani wa Leevi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.29",
            "verseOrgIds": [
              "LUK.3.29"
            ]
          }
        },
