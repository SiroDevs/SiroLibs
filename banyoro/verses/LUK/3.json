          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainani mutabani wa Enosi, Enosi mutabani wa Seesi, Seesi mutabani wa Adamu, Adamu mutabani wa Ruhanga.",
          "type": "text",
