          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahasooni mutabani wa Aminadabbu, Aminadabbu mutabani wa Adimini, Adimini mutabani wa Aram, Aram mutabani wa Hezirooni, Hezirooni mutabani wa Perezi, Perezi mutabani wa Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.33",
            "verseOrgIds": [
              "LUK.3.33"
            ]
          }
        },
