          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda mutabani wa Yakobbo, Yakobbo mutabani wa Isaaka, Isaaka mutabani wa Abburahamu, Abburahamu mutabani wa Teera, Teera mutabani wa Nahora, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
              "LUK.3.34"
            ]
          }
        },
        {
          "name": "verse",
