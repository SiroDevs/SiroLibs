          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ha yatandikire emirimo ye, akaba aina emyaka nka makumi asatu ey'obukuru. Kandi abantu baateekerezaaga ngu: akaba ali mwana wa Yosefu, mutabani wa Heeli, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heeli mutabani wa Mataati, Mataati mutabani wa Leevi, Leevi mutabani wa Meleki, Meleki mutabani wa Yanai, Yanai mutabani wa Yosefu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu mutabani wa Matatiya, Matatiya mutabani wa Amosi, Amosi mutabani wa Nahumu, Nahumu mutabani wa Esiri, Esiri mutabani wa Nagai, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.25",
            "verseOrgIds": [
              "LUK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagai mutabani wa Maati, Maati mutabani wa Matatiya, Matatiya mutabani wa Semeyi, Semeyi mutabani wa Yoseki, Yoseki mutabani wa Yooda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
