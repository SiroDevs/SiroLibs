            "sid": "LUK 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriyakimu mutabani wa Melea, Melea mutabani wa Mena, Mena mutabani wa Matata, Matata mutabani wa Nasani, Nasani mutabani wa Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
