          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leevi mutabani wa Simyoni, Simyoni mutabani wa Yuda, Yuda mutabani wa Yosefu, Yosefu mutabani wa Yonamu, Yonamu mutabani wa Eriyakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.30",
            "verseOrgIds": [
              "LUK.3.30"
            ]
          }
        },
