                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamusana Yesu yayegesaaga omunju ya Ruhanga, baitu obwire obu bwairaga yagendaga kugonya ha rusozi rw'emiti Oliva. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nyenkya kara abantu boona baazindukaga kuhurra ebi arukwegesa omu Nju ya Ruhanga.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
