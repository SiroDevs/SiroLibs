          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaikara ali mufaakati okuhika ha myaka kinaana n'ena y'obukuru. Tiyarugaga omu Nju ya Ruhanga. Yaikaramuga naaramya, naasiiba kandi naasaba nyamusana n'ekiro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.37",
            "verseOrgIds": [
              "LUK.2.37"
            ]
          }
        },
        {
