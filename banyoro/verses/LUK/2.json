          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako obu yaizire yatandika kusiima Ruhanga, kandi boona abakaba bategeriize okucungurwa kwa Yerusaalemu, yabagambira ha mwana ogu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.38",
