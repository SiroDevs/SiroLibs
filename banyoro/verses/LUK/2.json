                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazaire be obu baamazire kuhikiriza byona ebiragiro bya MUKAMA nkooku byaragiraga, baagarukayo Galiraaya omu rubuga rw'owaabu Nazareeti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
