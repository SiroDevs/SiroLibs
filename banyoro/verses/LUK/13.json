            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.9"
              },
              "items": [
                {
                  "text": "Kurug 20:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
