                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwijuke eki yabagambiire akyali omu Galiraaya ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Omwana w'omuntu ali w'okuheebwayo omu mikono y'abasiisi, abambwe ha musaraba, baitu ha kiro kya kasatu ahumbuuke.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo abakazi baijukire ebigambo bye; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.8",
            "verseOrgIds": [
              "LUK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaruga ha kituuro, baagaruka omu rubuga. Ebi byona baabigambira bali ikumi n'omu n'abandi boona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.9",
            "verseOrgIds": [
              "LUK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi abo nubo Mariya Magadaleena, Yohanani, hamu na Mariya nyina Yakobbo. Bbo, hamu n'abakazi abandi abakaba bali nabo, ebi byona baabigambira abakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.10",
            "verseOrgIds": [
              "LUK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abakwenda batabiikirize, bikabazookera nk'orugambo orutarukugasa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.11",
            "verseOrgIds": [
              "LUK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Petero yaimukire, yagenda yahika ha kituuro nairuka. Obu yainamire alingwizemu, atarole kindi kwihaho engoye zonka. Yagaruka owaabu ahuniriire habw'ebi ebyabaireho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naabonekera abakaba nibagenda Emmausi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki kyonyini, babiri omulibo bakaba nibagenda omu kyaro ekirukwetwa Emmausi, kikaba kiri nka kilomita ikumi n'emu okuruga Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.13",
            "verseOrgIds": [
              "LUK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaba nibabazaaho ebi byona ebyabaireho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.14",
            "verseOrgIds": [
              "LUK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba nibakyabibazaaho nibakaguzangana, Yesu wenka yabahikaho, yatandika kugenda nabo; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.15",
            "verseOrgIds": [
              "LUK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu amaiso gaabo gaaswekererwa, tibaamumanyirra.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yabakaguza ati: “Bigambo ki ebi murukugenda nimubazaaho?” Baayemerra baina amaiso g'obujune. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu halibo, ibara lye Kileyopa, yamugarukamu ati: “Niiwe mugenyi wenka hali abo abaizire Yerusaalemu, atarukumanya bigambo byona ebibaireho biro binu?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.18",
            "verseOrgIds": [
              "LUK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandiki Yesu ati: “Bigambo ki ebi?” Baamugarukamu bati: “Ebyabaireho Yesu owa Nazareeti, ow'akaba ali murangi w'amaani omu bikorwa n'omu bigambo omumaiso ga Ruhanga n'omumaiso g'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baanyakatagara baitu abakuru n'abalemi nkooku baamuhaireyo kucwerwa omusango gw'okufa, baamubamba ha musaraba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.20",
            "verseOrgIds": [
              "LUK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu itwe tukaba nitunihira ngu, nuwe akaba ali w'okucungura ihanga lya Isirairi. Okwongera hali ebi, kiro kinu nkyo kya kasatu kuruga obu byabaireho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.21",
            "verseOrgIds": [
              "LUK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hati abakazi abamu ab'omu kitebe kyaitu batuhunirizireege. Bazindukiire ha kituuro omu rukyakya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.22",
            "verseOrgIds": [
              "LUK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "omutumbi gwe tibagusangireyo; baitu bagarukire nibagamba ngu, babonekiirwe bamalaika ababagambiire nkooku ayomiire. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.23",
            "verseOrgIds": [
              "LUK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagenzi baitu abamu bagenzirege ha kituuro, kandi baasanga biri nkooku abakazi bagambire, baitu uwe tibamurozire.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Yesu yabagambiire ati: “Ha! Badoma inywe, abatarukurahuka kwikiriza byona abarangi ebi baagambire! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.25",
            "verseOrgIds": [
              "LUK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikaba kitarukwetaagwa Kristo okubonabonesibwa omuli ebi byona, nukwo ataahe omu kitiinisa kye?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.26",
            "verseOrgIds": [
              "LUK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yabandiza ha bya Musa n'abarangi naabasoborra ebyamugambirweho omu Byahandiikirwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baahikire haihi n'ekyaro nambere bakaba nibagenda, Yesu yasisana nk'arukuhinguraho; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.28",
            "verseOrgIds": [
              "LUK.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu baamwesengereza bati: “Ikara na itwe, obwire buhoireyo kandi izooba liri haihi kugwa.” Nubwo yataaha omunju kwikara nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.29",
            "verseOrgIds": [
              "LUK.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu akaba aikaliire nabo ha byokulya, yakwata omugaati, yasiima Ruhanga, yagucwamu, yagubaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.30",
            "verseOrgIds": [
              "LUK.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho amaiso gaabo gaiguka, baamumanyirra; baitu uwe yababuraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagambirangana bati: “Obu abaire naabaza na itwe omu muhanda naatusoborra Ebyahandiikirwe, emitima yaitu teyakirege omurro?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ako konyini baimuka, baagaruka Yerusaalemu; baasangayo ikumi n'omu beesoroize hamu n'ab'oruganda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baabahurra nibagamba bati: “Mazimakwo MUKAMA ahumbuukire, kandi abonekiire Simooni!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo n'ababiri baabasoboroire ebyabaireho omu muhanda, kandi nkooku baamumanyiriire obu yacwire omugaati.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naabonekera abeegesebwa be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba nibakyabaza ebi, Yesu wonyini yabeemerra hagati, yabaramukya ati: “Obusinge bube hali inywe.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.36",
            "verseOrgIds": [
              "LUK.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayekanga, baatiina nibateekereza ngu barozire omuzimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.37",
            "verseOrgIds": [
              "LUK.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu uwe yabagambira ati: “Nimutuntuzibwa ki? Nimwekaguliza ki omu mitima yanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.38",
            "verseOrgIds": [
              "LUK.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murole engaro zange n'ebigere byange; ninyowe kwo. Munkwateho murole, habwokuba omuzimu tigugira amagufa n'enyama, nk'ebi murukurora nyinabyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu yamazire kugamba ebi, yabooleka engaro ze n'ebigere bye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.40",
            "verseOrgIds": [
              "LUK.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba bakyalemerwe kwikiriza habw'okuhinirra na habw'omuhimbo, nubwo yabakagwize ati: “Hanu mwinaho ekyokulya?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.41",
            "verseOrgIds": [
              "LUK.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamuha ekicweka ky'encu etalikire, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.42",
            "verseOrgIds": [
              "LUK.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "yagikwata, yagirya bamuroleriire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naaraga abakwenda be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo yabagambiire ati: “Binu nibyo bigambo ebi nabagambiire nkyali na inywe ngu, byona ebyampandiikirweho omu Biragiro bya Musa, n'omu Bihandiiko by'abarangi, n'omu Zabbuli biri by'okuhikirizibwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo yasuukwire amagezi gaabo beetegereze Ebyahandiikirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabagambira ati: “Kinu nikyo ekyahandiikirwe ngu, Kristo naasemerra kubonabonesibwa, nukwo ha kiro kya kasatu ahumbuuke omu bafu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.46",
            "verseOrgIds": [
              "LUK.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngu, omu ibara lye okwegarukamu n'okuganyirwa ebibi birangirirwe omu mahanga goona, okubandiza Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.47",
            "verseOrgIds": [
              "LUK.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niinywe muli bakaiso b'ebigambo ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.48",
            "verseOrgIds": [
              "LUK.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.4"
              },
              "items": [
                {
                  "text": "Ebik 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ninyija kubatwekera Taata eki yaraganiize. Baitu mwikale omu rubuga okuhika obu muliheebwa amaani agarukuruga omwiguru.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu naatwarwa omwiguru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.9+ACT.1.10+ACT.1.11"
              },
              "items": [
                {
                  "text": "Ebik 1:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Yesu yabeebembiire, yabahikya haihi na Betaniya. Yaimukya emikono ye, yabaha omugisa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SIR.50.20"
              },
              "items": [
                {
                  "text": "Sir 50:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu akaba naakyagubaha, yabarugaho, yatwarwa omwiguru. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamuramya, hanyuma baagaruka Yerusaalemu baijwire okusemererwa kwingi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 24:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
