              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo nu, obu muraaba mwahumbuukire hamu na Kristo, mute omutima ha by'omwiguru, Kristo nambere ali, anyakwikaliire ha mukono gw'obulyo ogwa Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteekerezeege ebintu eby'omwiguru, bitali eby'omunsi. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba mukafa, kandi obwomeezi bwanyu buserekerwe na Kristo omu Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.3",
            "verseOrgIds": [
              "COL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristo obwomeezi bwaitu obu aligaruka kuzooka, nubwo na inywe mulizooka hamu nawe omu kitiinisa.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuleka obwomeezi obwa ira n'okutandika obuhyaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki mucwe engeso ez'ensi ezinyakuli omuli inywe: obusiihani, obugwagwa, ebiteekerezo ebibi, okwegomba okubi, n'omukoijo gw'itungo ly'abandi, itungo eri mwafoire embandwa zanyu ez'okuramya. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ebi nibyo birireetera Ruhanga kubakayukira. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ebi nibyo mwakoraga obu mukaba mukyabirumu. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu hati mucwe engeso zinu: ekiniga, okubiihirwa, itima okuhangirra, n'okubaza eby'ensoni. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.8",
            "verseOrgIds": [
              "COL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.22"
              },
              "items": [
                {
                  "text": "Bef 4:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabiihangana ebisuba, habwokuba mukaleka obwomeezi obwa ira n'engeso zaabwo, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
            "verseOrgIds": [
              "COL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.24"
              },
              "items": [
                {
                  "text": "Bef 4:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Kub 1:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwatandika obundi obunyakwikara nibuhindurwa buhyaka nukwo bubahikye ha magezi na ha nsisana by'Ogu ayabuhangire. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu, nihaba hatakyaroho Omugiriiki n'Omuyudaaya, asazirwe n'atasazirwe, omunyaihanga n'ow'ihanga eriteegesibwe, omwiru n'ow'obugabe, baitu Kristo nuwe byona omu byona.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
