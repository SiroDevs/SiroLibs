          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aheeru, oteho emeeza, kandi ha bukiizi obw'obulyo obw'Eheema oteho ekikondo eky'etaara, kirolerre emeeza, ha bukiizi obw'emoso.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
