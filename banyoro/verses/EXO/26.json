            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyigamo erengizire ha bikwaso. Otahyemu esanduuko ey'endagaano, ogite omunda y'enyigamo, enyigamo egi, niyo eraabaganiza ekiikaro ekirukwera, ha kiikaro ekirukukirra kimu kwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ruguru y'esanduuko ey'endagaano enyakuli omu kiikaro ekirukukirra kimu kwera, oteho ekitebe eky'okuganyirirraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
