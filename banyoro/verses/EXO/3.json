              "items": [
                {
                  "text": "Ama 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamisiri, ndibatamu omwoyo omurungi ogw'okugonza abantu abo, obu muliba nimurugayo, timulirugayo mutaina kantu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.21",
            "verseOrgIds": [
              "EXO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu buli mukazi, alisaba omukazi omutaahi rundi omukazi anyakuraara omunju ye amuhe amabaale ag'omuhendo, ag'efeeza, n'ag'ezaabbu n'ebyokujwara, mubijweke batabani baanyu na bahara baanyu; Abanyamisiri nukwo mulibanyaga muti.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.22",
            "verseOrgIds": [
              "EXO.3.22"
            ]
          }
        }
