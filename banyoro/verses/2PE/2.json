{
  "id": "2PE.2",
  "number": "2",
  "bookId": "2PE",
  "reference": "2Pet 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2PE 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwerinde abarangi n'abeegesa b'ebisuba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarangi b'ebisuba nkooku baimukire omwihanga lya Isirairi, n'abeegesa b'ebisuba nukwo baliimuka bati omuli inywe, babataahyemu mpora mpora obuhakani oburukuhwerekereza, nangwa n'okwehakana MUKAMA wabu ayabacungwire. Baayereetera bonka okuhwerekerra okwa bwango. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.1",
            "verseOrgIds": [
              "2PE.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baingi balihondera engeso zaabo z'orwanju kandi bagayise abantu omuhanda gw'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.2",
            "verseOrgIds": [
              "2PE.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habw'omukoijo gwabo balibaihaho sente nibabeegesa ebigambo eby'obugobya. Omusango gukabasinga ira kandi tigukarugahoga. Ekifubiro kyabu kiikara nikibategereza.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruhanga yajunaga abantu abaamutiinaga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga ataganyire bamalaika obu baasiisire, baitu yabanaga omu kiinongoro ky'omurro, yababohera okuzimu omu mwirima kasira, baikaleyo okuhika obu balicwerwa omusango. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.4",
            "verseOrgIds": [
              "2PE.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kub 6:1—7:24",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.10.4"
              },
              "items": [
                {
                  "text": "Ama 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ataganyire abantu aba ira n'ensi yabo obu yaleesire okusandaara kw'amaizi omunsi y'abo abatatiina Ruhanga, baitu akajuna Noha ayateereriire abantu bahikirre. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Kub 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ruhanga akookya embuga za Sodomu na Gomora yazifoora iju, yaisingisa omusango ogw'okuhwerekerra, zibe kyokurorraho ky'abo abaliba batarukutiina Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16"
              },
              "items": [
                {
                  "text": "Kub 19:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "WIS.10.6+WIS.10.7+WIS.10.8"
              },
              "items": [
                {
                  "text": "Ama 10:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu yajuna Looti, omuntu omurungi ow'akaba atuntuziibwe muno orwanju rw'abantu ababi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7",
            "verseOrgIds": [
              "2PE.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ningira omuntu omurungi ogu, ebi yarozire n'ebi yahuliire obu yabaikaramuga nibakora ebitahikire, byasaalizaga omutima gwe omurungi buli kiro.) ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.8",
            "verseOrgIds": [
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi byona bitwoleka Ruhanga nkooku amanyire kujuna abamutiina, akabaiha omu mitalibano; amanyire n'okwikaza ababi ha kifubiro okuhika ha kiro eky'okucwerwa omusango; ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi okukira muno abo abeemarra ha kwegomba okubi okw'emibiri yabo, kandi abarukugaya obusobozi bwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekifubiro ky'abatatiina Ruhanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeegesa b'ebisuba abo, bantu bahoole kandi ntahurra, tibatiina n'okujuma bamalaika ab'ekitiinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kunu bamalaika noobu baraaba nibabakiraho amaani n'obusobzi, tibabahyemera kandi tibabajunaana musango omumaiso ga MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu abasiisi abo basisana ebisoro ebitaina magezi, ebisoro ebirukulemwa obuhangwa bwabyo, ebyazaalirwe kutegwa n'okwitwa. Bajuma ebintu ebi batarukumanya, bali b'okuhwerekerezibwa nk'ebisoro ebi, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "basaalizibwa kubi habw'ebibi ebi baakozire. Eki barukweta kusemererwa, nugo amagenyi ga nyamusana. Abantu abo bitonyezi ebibi kandi bumogo omu kitebe kyanyu, nibeegondeza omu obubi bwabo, babagobeza noobu muba nimulya nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaiso gaabo gaijwire obusiihani, tibaniha kibi. Batwaliriza abantu abaina emitima etagumire, kandi emitima yabo ekamanyirra omukoijo. Baana bakyenwa! ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.4+NUM.22.5+NUM.22.6+NUM.22.7+NUM.22.8+NUM.22.9+NUM.22.10+NUM.22.11+NUM.22.12+NUM.22.13+NUM.22.14+NUM.22.15+NUM.22.16+NUM.22.17+NUM.22.18+NUM.22.19+NUM.22.20+NUM.22.21+NUM.22.22+NUM.22.23+NUM.22.24+NUM.22.25+NUM.22.26+NUM.22.27+NUM.22.28+NUM.22.29+NUM.22.30+NUM.22.31+NUM.22.32+NUM.22.33+NUM.22.34+NUM.22.35"
              },
              "items": [
                {
                  "text": "Kubar 22:4-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaruga omu muhanda oguterekeriire, baahaba, baatoma omuhanda ogwa Balaamu, mutabani wa Behori, ayagondeze kwetungira ebisembo ebyarugire omu kukora ebitahikire, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu yacoomerwa habw'ekibi kye. Endogoyi etagamba, ekabaza n'iraka nk'ery'omuntu, yamaraho iraro ly'omurangi ogu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo tubeeta maziba agoomere kandi kiho ekirukutwarwa ekiyaga; baahuliirwe omwirima ogukwasire. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baba nibabaza ebigambo eby'okwehaahire, batwaliriza omu kwegomba kw'omubiri abantu abakaruga kwecwaho abasiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.18",
            "verseOrgIds": [
              "2PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babanihiza obusinge, kandi kunu bbo, bairu b'engeso mbi; ningira kyona ekisingura omuntu, aba mwiru wakyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.19",
            "verseOrgIds": [
              "2PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu obu bamara kutabuka obubi bw'ensi, habw'okumanya MUKAMA waitu kandi Omujuni Yesu Kristo, bakagaruka kubwetabamu kandi bukabasingura. Enyikara yabo eya hanyuma efooka mbi okukira ey'okubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.20",
            "verseOrgIds": [
              "2PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyakubaire kirungi kakuba abantu abo bataramanyire omuhanda ogw'obuhikiriire, okukira kumara kugumanya, bakagurugaho kandi baaleka ebiragiro ebirukwera ebi baahairwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.21",
            "verseOrgIds": [
              "2PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.26.11"
              },
              "items": [
                {
                  "text": "Nfu 26:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibahikireho nk'orufumo rw'amazima orugamba ruti: “Embwa egarukira ebitanaki byayo”; kandi: “Empunu obu emara kwogebwa, egaruka kwekulingura omu saabu.”",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.22",
            "verseOrgIds": [
              "2PE.2.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2PE.3",
    "number": "3",
