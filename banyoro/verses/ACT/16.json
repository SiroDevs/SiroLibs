{
  "id": "ACT.16",
  "number": "16",
  "bookId": "ACT",
  "reference": "Ebik 16",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
