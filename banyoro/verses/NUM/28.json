              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eky'okubanza eky'obugenyi bw'amagesa, obu muraabaga nimuhongera MUKAMA ekihongwa eky'ebyokulya ebya magesa musorrokanege muramye; mutalikora omulimo ogw'amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu muhongere MUKAMA ekihongwa eky'okwokya, ekirukurugwamu ekisorrokoko ekirukumuboyera: nizo enimi ento ibiri, entaama empaya emu, ebyana by'entaama musanju eby'omwaka gumu: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n'ekihongwa kyabyo eky'ebyokulya eby'ensaano enyakuniinuukire kurungi, etabwire n'amagita agarukuhikya kiloguraamu isatu, ezirukuhongwa hamu na buli nimi, na kiloguraamu isatu ezirukuhongwa hamu n'empaya y'entaama, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kiloguraamu emu, erukuhongwa hamu na buli kimu, ha byana by'entaama omusanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamu n'empaya y'emburabuzi ey'okwereherra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi mubyongere ha kihongwa eky'okwokya ekya butoosa, na ha kihongwa kyakyo eky'ebyokulya, mubihonge n'ekihongwa kyabyo eky'ekyokunywa. Mutalikisura, mukahonga ebinyakwina akamogo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
            "verseOrgIds": [
              "NUM.28.31"
            ]
          }
        }
      ]
