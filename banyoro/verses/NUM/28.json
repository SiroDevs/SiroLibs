              },
              "items": [
                {
                  "text": "Kurug 12:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1"
              },
              "items": [
                {
                  "text": "Bir 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekiro ekya ikumi na bbina eky'okwezi okw'okubanza, kiraabaga ky'okwijuka okuhingurwaho kwa MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kurug 12:14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "23:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Bir 16:3-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ekiro ekya ikumi na bitaano eky'okwezi oku, kiraabaga kiro eky'obugenyi, mumale ebiro musanju nimulya omugaati ogutarumu kitumbisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eky'okubanza, mwesoroozeege muramye: mutalikora omulimo ogw'amaani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu muhongere MUKAMA ekihongwa eky'okwokya: ekihongwa eki, nizo enimi ento ibiri, empaya y'entaama emu, n'ebyana by'entaama musanju eby'omwaka gumu; mutalikisura mukahonga ebinyakwina akamogo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muhonge n'ebihongwa byabyo eby'ebyokulya eby'ensaano enyakuniinuukire kurungi, etabwirwe n'amagita; kiloguraamu isatu, mubihonge hamu n'enimi, kiloguraamu ibiri muzihonge hamu n'empaya y'entaama; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kiloguraamu emu, mugihonge hamu na buli kimu, ha byana by'entaama omusanju; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi muhonge empaya y'emburabuzi ey'ekihongwa eky'okuganyiza ebibi, nukwo mwereherre. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi mubihonge, mubyongere ha kihongwa eky'okwokya ekya nyenkya, ekya butoosa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mulingo nugwo gumu, muhongere MUKAMA ebyokulya eby'ekihongwa eky'okwokya okumara ebiro musanju, ekihongwa ekirukurugwamu ekisorrokoko ekirukuboyera MUKAMA; eki mukyongere ha kihongwa eky'okwokya ekya butoosa, na ha kihongwa kyakyo eky'okunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya musanju, musorrokanege muramye; mutalikora omulimo ogw'amaani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
