              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.9"
              },
              "items": [
                {
                  "text": "7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘MUKAMA tabiihirwa bwango, aikara aine engonzi ezitahwaho, aganyira obubi n'ensobi, baitu taleka kufubira omuntu wena anyakwina omusango afubira abaana habwebibi bya baise bo na baisenkurubo okuhika habwijukuru bw'enyakasatu nenyakana.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkoku oli w'embabazi nyingi muno, nkwesengeriize, ganyira abantu banu nkooku wakabaganyiire bakaba kuruga Misiri okuhika na hati.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekifubiro Ruhanga eki yahaire Abaisirairi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo MUKAMA yagambiire Musa ati: “Mbaganyiire nkooku ogambire; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.18"
              },
              "items": [
                {
                  "text": "Baheb 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu mazimakwo nkooku ndi mwomeezi kandi ensi yoona ijwire ekitiinisa kyange, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha bantu abarozire ekitiinisa kyange ebyamahano ebi nakoliire Misiri n'omwirungu, bakagaruka baandeenga emirundi n'emirundi, baayanga kuhurra eki ndukugamba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "busaho n'omu alirora ensi ei narahiire kuha baisenkurubo kandi busaho n'omu ha bantu abangayire aligirora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
