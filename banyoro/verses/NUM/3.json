            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abaraateeraga orukande omumaiso ag'enju ya Ruhanga niyo Eheema ey'okutangatanganiramu oroleriire Bugwaizooba, nubo Musa, Arooni n'abatabani, abaakoraga emirimo omu kiikaro ekirukwera, kyona ekyayetaagwaga kukolerwa abaana ba Isirairi; omuntu weena atasemeriire ayairraga ha kiikaro, ogu yaitwaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhendo gwona ogw'abaana b'Abaleevi abarukuhikya okwezi kumu n'okweyongerayo Musa aba yabazire omu nganda zaabo nkooku MUKAMA yaragiire, bakahika emitwaro ebiri n'enkumi ibiri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebirukukwata ha Baleevi n'okucungura emizigaijo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 3:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: “Bara emizigaijo yoona ey'aboojo ey'abantu ba Isirairi okurugirra ha b'okwezi kumu n'okweyongerayo, obale omuhendo n'amabara gaabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kiikaro eky'emizigaijo yoona ey'abantu ba Isirairi onyihiremu Abaleevi, omu kiikaro eky'emizigaijo yoona ey'ente ez'abantu ba Isirairi, onyihiremu ey'ez'Abaleevi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 3:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo Musa yabara emizigaijo yoona ey'abantu ba Isirairi, nkooku MUKAMA yamuragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emizigaijo yoona ey'abaana aboojo, okurugirra ha ab'okwezi kumu n'okweyongerayo, omuhendo gwabo n'amabara gaabo bakahika emitwaro ebiri nkumi ibiri bibiri nsanju na basatu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
            "verseOrgIds": [
              "NUM.3.43"
            ]
          }
        }
      ]
    },
