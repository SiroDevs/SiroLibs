          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA akagambira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 3:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu mizigaijo yoona ey'abantu aba Isirairi, onyihiremu Abaleevi, kandi omu kiikaro eky'emizigaijo ey'ente ez'abantu ba Isirairi, onyihiremu ey'ez'Abaleevi; Abaleevi babe bantu bange: Ninyowe MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 3:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi habw'okucungura abaana emizigaijo bibiri nsanju na basatu abantu ba Isirairi, ei barukukiza Abaleevi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 3:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha buli mwana omwiheho ebicweeka bya feeza bitaano, nimubalirirra ha sente ezinyakuragirwa ey'Ekiikaro Ekirukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 3:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sente ez'omuhendo gw'abaana abakizireho, kucungurwa muzihe Arooni n'abatabani.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo abaakizireho abaacungwirwe Abaleevi, Musa yabaihaho sente ez'okubacungura; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "emizigaijo ey'abantu aba Isirairi, yabaihaho sente ezirukuhika bicweeka byafeeza rukumi mu bisatu nkaaga na itaano ogubaliriirwe ha sente ez'Ekiikaro Ekirukwera; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "sente ezi Musa yaziha Arooni n'abatabani, MUKAMA nkooku yagambire, kandi nkooku yamuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
            "verseOrgIds": [
              "NUM.3.51"
            ]
          }
        }
      ]
