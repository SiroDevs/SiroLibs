              "NUM.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kika ekya Kohati, nuho haarugire ebika binu: Abaamuraamu, Abaizara, Abahebburooni naba Uziyeri. Ebi nibyo bika ebya Kohati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
            "verseOrgIds": [
              "NUM.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhendo ogw'abasaija okurugirra ha b'okwezi kumu n'okukiraho, ab'okukoraga emirimo ey'ekiikaro ekirukwera, obu baahandiikirwe, bakahika kanaana n'orukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebika bya batabani ba Kohati baraateeraga orukande ha rubaju orw'obulyo orw'enju ya Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erizafani nuwe mukuru w'ebika bya baisenkurubo ab'ekitabu kya Kohati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakwasibwa omulimo ogw'okurolerra Esanduuko ey'Endagaano, emeza, ekikondo ky'etaara, amatambiro, ebintu ebinyakukwatirwa omu Kiikaro Ekirukwera, banyakatagara ebi baheererezaamu, n'orukingyo, omulimo gwona ogurukukwataho ebintu ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eryeza mutabani wa Arooni nyakatagara, nuwe abe mwebembezi omukuru ow'Abaleevi, kandi muroleerezi w'abo abaakwasiibwe kurolerra Ekiikaro Ekirukwera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
