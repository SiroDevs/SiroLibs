                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "32:48-52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Musa ati: “Temba orusozi Abarimu oru, orole ensi ei ndukwija kuha Abaisirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu oraamara kugirora, na iwe noija kufa, Arooni owanyoko nkooku yafiire, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba ekitebe obu kyantiize empaka omwirungu lya Ziini, obu nabaragiire kwoleka omumaiso gaabo nkooku nyina obusobozi, obw'okubatungira amaizi inywembi mukagaya ekiragiro kyange.” Amaizi aga ndukugamba, nugo aga Meriba eya Kadesi, omwirungu erya Ziini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yagambira MUKAMA ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MUKAMA Ruhanga iwe anyakulema emitima y'abantu boona, okome omuntu araayebembera ekitebe kinu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.17"
              },
              "items": [
                {
                  "text": "1 Bakam 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.5"
              },
              "items": [
                {
                  "text": "Ezek 34:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mar 6:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araabeebemberaga kandi araabagarraga omuka; ekitebe kya MUKAMA kireke kuba nk'entaama ezitanyina muliisa.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.13"
              },
              "items": [
                {
                  "text": "Kurug 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA yagambira Musa ati: “Kwata Yoswa mutabani wa Nuuni, omusaija anyakwina omwoyo, omuteho omukono gwawe; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "omwemereze omumaiso ga Eryeza nyakatagara n'ekitebe kyona, omuhe ebiragiro abantu boona nibarora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuhe ha busobozi bwawe, nukwo Abaisirairi boona bamuhurre. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Kurug 28:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.41"
              },
              "items": [
                {
                  "text": "1 Sam 14:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "28:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araayemerraga omumaiso ga Eryeza nyakatagara, ogu nuwe ow'araamukagulizaaga hali MUKAMA kandi akamucweramu naakonyerwa akabaale Ulimu; obu araaragiraga abantu, baturuke kandi bagendege, kandi obu aragarukaga akaragira, bataahe baije hamu, uwe n'ekitebe kyona.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yakora MUKAMA nkooku yamuragiire; yakwata Yoswa yamwemereza omu maiso ga Eryeza nyakatagara n'ekitebe kyona, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.23"
              },
              "items": [
                {
                  "text": "Bir 31:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yamutaho emikono, yamukwasa omulimo MUKAMA nkooku yamuragiire.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
