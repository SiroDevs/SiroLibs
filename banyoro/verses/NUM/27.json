          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 27:12"
          },
          "items": [
