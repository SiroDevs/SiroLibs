      },
      "items": [
        {
          "text": "Ekiro eky'okwijuka Okuhingurwaho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
