          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teera yatwara omutabani Abburamu n'omwijukuru Looti, omwana wa Harani, na Sarai mukamwana we, mukazi w'Abburamu, baagenda hamu, baaruga omunsi Uli ey'Abakarudeya, baagenda omunsi eya Kanaani, baitu obu baahikire Harani, nuho baikara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
