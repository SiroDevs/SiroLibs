          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aripakisaadi obu yamazire kuzaara Seera, akongera yayomeera emyaka endi bikumi bbina n'esatu, yazaara abaana abandi aboojo n'abaisiki.",
          "type": "text",
