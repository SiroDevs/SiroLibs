          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganu nugo mabara g'abaijukuru ba Seemu. Seemu obu yahikize emyaka kikumi ey'obukuru, yazaara Aripakisaadi, obu hakaba hahingwireho emyaka ebiri, okusandaara kw'amaizi kuhoire omunsi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu obu yamazire kuzaara Aripakisaadi, akongera yayomeera emyaka endi bikumi bitaano, yazaara abaana abandi aboojo n'abaisiki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
