            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagambira Rebbeka ebigambo Esau omutabani omukuru ebi yagambire, aho yatuma bamwetere Yakobbo omutabani omuto, obu yaizire yamugambira ati: “Mugenzi wawe naahiika, kandi naategeka kukwita. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
