                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yakaguza ati: “Ibara Yakobbo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:36",
              "type": "text"
            },
            {
              "text": "Yakobbo",
              "type": "text"
            },
            {
              "text": "Ibara Yakobbo, limanyisa Engobya.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", litamuhike? Yakangobeza emirundi ebiri. Okubanza akanyihaho obukuru bwange, kandi hati anyihireho n'omugisa gwange.” Yagaruka yakaguza ati: “Nanyowe tonsabiraho mugisa?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka yagarukamu Esau ati: “Mmuhaire obusobozi obw'okukulema, kandi mmuhaire bagenzi be boona babe bairu be, mmuhaire ebyokulya n'ebyokunywa. Hati mwana wange, leero iwe ndaakukorra ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
