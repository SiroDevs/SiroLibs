          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "akeebwa ebi wamukozire, nubwo ndituma bakutabarre. Habwaki mbafeerwa inywembi izooba limu?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        },
        {
