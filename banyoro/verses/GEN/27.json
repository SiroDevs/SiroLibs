          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise yamugarukamu ati: “Owanyoko aizirege yambiihabiiha, namusabira omugisa ogu naakukusabiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        },
