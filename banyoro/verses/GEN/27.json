                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho, Isaaka ise yagamba ati: “Oraikaraga omunsi etarumu rwezo kandi etarukugwibwamu rume. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        },
