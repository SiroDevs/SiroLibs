        },
        {
          "text": "Kinu nikyo kitabu ekirukwoleka oruzaaro rw'Adamu. Ruhanga obu yahangire omuntu, akamuhanga omunsisana ye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
