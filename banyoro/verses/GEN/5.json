              "type": "text"
            }
          ]
        },
        {
          "text": "Seesi obu yahikize emyaka kikumi n'ataano, yazaara Enosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
