          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo kugamba, emyaka yoona Seesi ei yayomiire, ekahika rwenda mu ikumi n'ebiri; yafa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
