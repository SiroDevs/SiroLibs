          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "batabani ba Delaaya, aba Tobiya, n'aba Nakoda, rukaaga ataano na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.60",
            "verseOrgIds": [
