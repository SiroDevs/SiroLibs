          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Bbani, rukaaga ana na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.10",
            "verseOrgIds": [
              "EZR.2.10"
            ]
          }
