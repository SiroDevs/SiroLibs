          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganu nugo mabara g'abantu abaarugire omu bunyagwa, hali abo Nebbukadeneeza omukama wa Babbulooni aba akaba atwaire Babbulooni bali banyagwa; bakagaruka Yerusaalemu na Buyudaaya buli muntu omurubuga rw'owaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.1",
            "verseOrgIds": [
              "EZR.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaija hamu na Zerubbabbeeri, Yesuha, Nehemiya, Seraaya, Relaaya, Morodekayi, Birusaani, Misipaara, Biguvai, Rrehumu na Bbaana. Gunu nugwo muhendo ogw'abantu aba Isirairi; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "batabani ba Parosi, enkumi ibiri, kikumi nsanju na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
              "EZR.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Sefatiya, ebikumi bbisatu omu nsanju na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.4",
            "verseOrgIds": [
              "EZR.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Ara, rusanju nsanju na bataano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
              "EZR.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Pahasi-Mowabbu, nuwe Yeswa, enkumi ibiri, runaana, ikumi na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
            "verseOrgIds": [
              "EZR.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Eremu, rukumi, bibiri ataano na bbana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.7",
            "verseOrgIds": [
              "EZR.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Zaatu, rwenda ana na bataano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.8",
            "verseOrgIds": [
              "EZR.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Zakayi, rusanju n'enkaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.9",
            "verseOrgIds": [
              "EZR.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
