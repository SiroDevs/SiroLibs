          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "EZR 2:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo amabara gaabo bakagaserra omuli abo abaahandiikirwe omu mabara ga baisenkurubo okugaagenzire nigakurutana, baitu batasangwe omuli abo, nahabweki, bakaihwa omu banyakatagara, habwokuteekerezibwa ngu nibazirwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.62",
            "verseOrgIds": [
              "EZR.2.62"
            ]
          }
        },
