          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi aba batabani ba nyakatagara: batabani ba Habaaya, batabani ba Hakozi na batabani ba Baruzilayi, ow'akaba aswire omukazi omu bahara ba Baruzilayi Omugiryadi, yarukwa ibara lyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.61",
            "verseOrgIds": [
              "EZR.2.61"
            ]
          }
        },
