          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "otabaliireho abairu n'abazaana baabo, abaahikaga kasanju bisatu asatu na musanju kandi bakaba baina abazini bikumi bibiri abasaija n'abakazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.65",
