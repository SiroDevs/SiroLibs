            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embaraasi zaabo zaahikaga rusanju asatu na mukaaga, enyumbu ebikumi bibiri ana na itaano, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.66",
            "verseOrgIds": [
              "EZR.2.66"
            ]
          }
        },
