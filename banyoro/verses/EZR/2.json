            }
          ]
        },
        {
          "text": "Omuhendo gw'ekitebe kyona hamu, gwahikaga emitwaro ana nkumi ibiri bisatu n'enkaaga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64",
