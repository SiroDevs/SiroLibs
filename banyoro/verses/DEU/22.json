          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo bombi mubaturukye orubuga mubaleete ha irembo, mubateere amabaale bafe. Habwokuba omwisiki, noobwakubaire akaba, ali omurubuga, atateere nduuru ati: ‘Munjune’, kandi omusaija, habwokuba akabyama n'omwisiki anyakujumbiirwe, nukwo mwihe muti ekibi omu Isirairi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
