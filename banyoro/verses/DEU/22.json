                "loc": "EXO.23.4"
              },
              "items": [
                {
                  "text": "Kurug 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Otalirora ente rundi entaama ya mugenzi wawe neehaba, okalema kugira ekyokozireho, osemeriire ogitwarre mugenzi wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.1",
            "verseOrgIds": [
              "DEU.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba aba atali haihi, rundi kakuba oba otamumanyire, ogireete omuka yawe, ogitaahye omunju yaawe. Ekisoro eki oikale nakyo, okuhika mugenzi wawe obwalikiserra, okimugarurre, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.2",
            "verseOrgIds": [
              "DEU.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo okole oti, obwaraabaga abulirirwe enkaina ye, ekyokujwara kye rundi ekintu kye ekindi kyona, ekinyakubuzire, iwe okakizoora, nukwo okolege oti, otalyanga kumukonyera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.3",
            "verseOrgIds": [
              "DEU.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otalirora enkaina rundi ente y'Omwisirairi mugenzi wawe ebutamire ha muhanda okanga kugikonyera, mukonyere kugiimukya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi atalijwara ekintu kyona ekirukwetwa eky'omusaija, omusaija na uwe atalijwara ekijwaro eky'omukazi; weena arukukora ebintu ebi MUKAMA Ruhanga wawe tamugonza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuba ogwaho ekiju ky'ekinyonyi omumuti rundi haitaka, harumu ebyana rundi amahuli, nyinabyo ebumbaatiire ebyaana, rundi eraaliire amahuli, nyinabyo n'ebyana otalibitwarra hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.6",
            "verseOrgIds": [
              "DEU.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oleke nyinabyo egende, osobora kutwara ebyana, nukwo otunge omugisa kandi ohangaale.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
