        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.7",
            "verseOrgIds": [
              "DEU.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obworaayombekaga enju empyaka, orusu oruzitiirrehoga ekisiika, omuntu obwalirugaho akagwa, enju yawe oleke kugireetaho omusango ogw'esagama.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
