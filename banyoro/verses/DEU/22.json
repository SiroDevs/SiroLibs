            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baitu eki kakuba kibaho omukyaro, omusaija akaitirana omwisiki anyakujumbiirwe, akamugwera, akabyama na uwe, obu, omusaija wenka kibyama na mukazi, nuwe aitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omukazi mutalimukoraho kantu na kati, omukazi tanyina nsobi ey'okumwisa, habwokuba ekintu kinu, nikisisana n'eky'omusaija anyakuseesa akaita omutaahi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba akamugwaho ali omukyaro, omwisiki kijumbirwa noobu yataagire ati munjune, hatabeho muntu noomu ow'okumwirukiirra, hatabeho noomu ow'okumujunira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
