            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.17"
              },
              "items": [
                {
                  "text": "Bir 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Omu bugwetwa obwolitunga omunsi MUKAMA Ruhanga wawe eyarukwija kukuha kutunga, otaliihurra akarorwaho ak'omutaano ogw'omutaahi wawe, abantu abaira akabaataireho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebiragiro Ebirukukwata ha bakaiso",
          "type": "text"
        }
      ]
    },
