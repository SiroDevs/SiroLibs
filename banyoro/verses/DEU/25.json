            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Obumukaba muli omumuhanda nimuruga omunsi Misiri, oijukege Amaleki ekiyabakozire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkooku yabaseesiire, mugwiire ensazi kandi mujwahire, tiyatiina Ruhanga, yaita boona abakaba basigaire enyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki, MUKAMA Ruhanga wawe obwaraamara kukuhuumuza, akakwiha omu banyanzigwa bawe boona abanyakukwehinguliriize abanyakuli omunsi eyarukwija kukuha, ogyetwarre ebe bugwetwa bwawe, obu nubwo olimarraho kimu Amaleki, aleke kugaruka kwijukwa hansi y'iguru; eki kitalikweba.",
