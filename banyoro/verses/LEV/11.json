              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki nikyo kiragiro ekirukukwata ha bisoro, ebinyonyi n'ebihangwa byona ebyomeezi ebinyakwikara omu maizi, ebihangwa byona ebinyakwekururra ha itaka, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
