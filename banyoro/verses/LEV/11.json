          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba ninyowe MUKAMA Ruhanga ayabaihire omunsi Misiri, mbe Ruhanga wanyu; habweki, mubege abarukwera, habwokuba nyowe ninyera.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
      ]
