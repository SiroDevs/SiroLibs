            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.16"
              },
              "items": [
                {
                  "text": "1Pet 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba ninyowe MUKAMA Ruhanga wanyu; habweki, mweyeze mufooke barukwera, habwokuba nyowe ninyera. Muleke kwesiisa n'ebintu ebirukugendesa enda, ebinyakwekururra ha itaka, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
