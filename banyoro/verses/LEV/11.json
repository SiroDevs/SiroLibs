            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ebintu byona ebinyakwekwata akaseebo, mubizizeege; bitaliriibwa. Kyona ekinyakugendesa enda kandi kyona ekinyakugendesa amaguru ana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
              "LEV.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rundi kyona ekinyakunyina obugere bwingi, ebintu byona ebinyakwekurra, ebinyakwekururra ha itaka, muleke kubirya, habwokuba bintu binugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutalirya ebintu ebirukugendesa enda, ebi nyakwekururra ha itaka abantu bakabanuga kandi mutalyesiisa habwabyo mukafooka abarukuzirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
