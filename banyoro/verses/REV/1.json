            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Omu Rugiriiki: “Alufa kandi Omega”, amakuru ngu: Aa na Za, nukwo kugamba Entandiko n'Empero.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anyakubaho, ayabaireho, kandi ow'okwija, Kamara-byona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
