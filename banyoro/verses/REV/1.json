              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo nakubuutukire kurora ow'akaba naabaza na nyowe. Obu nakubuutukire, narora ebikondo musanju eby'etaara, bya zaabbu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
