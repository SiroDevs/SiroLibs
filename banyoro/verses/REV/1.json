            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunu nukwo okusuukururwa Ruhanga oku yahaire Yesu Kristo kwoleka abaheereza be, bamanye ebikaba nibiija kubaho bwango. Binu akabimanyisa naatuma malaika hali omuheereza we Yohaana, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayahandiikire byona ebi yaboine naajurra ebigambo bya Ruhanga n'obwakaiso bwa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "W'omugisa anyakusoma ebigambo binu eby'okuranga, kandi b'omugisa abo abanyakuhurra n'abanyakukwata ebihandiikirwe omu kitabu kinu; habwokuba akasumi kali haihi kuhika.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naaramukya ebitebe musanju eby'abaikiriza",
          "type": "text"
        }
      ]
    },
