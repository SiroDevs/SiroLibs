          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi hati nyomiire. Nkafa, baitu okuruga hati ndaikaraga ndi mwomeezi ebiro byona, kandi nyina ebisumuruzo by'Orufu n'eby'Okuzimu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
              "REV.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
