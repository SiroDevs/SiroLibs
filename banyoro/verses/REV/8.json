        },
        {
          "text": "Aho malaika yakwata ekiswa kya zaabbu, yakiijuza omurro ogwa ha itambiro, yakihungura omunsi; enkuba zaabbaruka, emirabyo yamulikya, haabaho n'omusisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
