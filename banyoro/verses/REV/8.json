            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owa kabiri yateera engwara ye, ekintu ekirukusisana orusozi orukooto orurukwaka omurro, kyagwa omu nyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimu kya kasatu eky'enyanja kyafooka sagama, n'ekimu kya kasatu eky'ebihangwa ebyomeezi ebiri omu nyanja kyafa, kandi kimu kya kasatu eky'emeeri kyahwerekerezibwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
