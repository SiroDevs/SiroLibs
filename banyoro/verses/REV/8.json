              },
              "items": [
                {
                  "text": "Yer 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibara ly'enyunyuuzi egi, niyo Nyakusarra. Kimu kya kasatu eky'amaizi gasarra pe, gaita abantu baingi, habwokuba gakaba gasaaliire.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
