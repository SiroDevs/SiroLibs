              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika owa kasatu yateera engwara ye, enyunyuuzi enkooto yaruga omu iguru, neeyaka nk'ekimuli, yagwa ha kimu kya kasatu eky'ebisaaru na ha maziba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
