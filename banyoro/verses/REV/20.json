              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "alituruka kubiihabiiha Gogu na Magogu, nugo amahanga agali ha mbaju ina ez'ensi agasorooleze obulemu. Omuhendo gw'abantu abo nigwingana omusenyi ogw'enyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakagenda banyaaka ensi yoona, baagota orukande rw'abantu ba Ruhanga n'orubuga orukuru orugonzibwa; baitu omurro gwaruga omwiguru gwabahwerekereza, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.9",
            "verseOrgIds": [
              "REV.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi Omwohi ayababiihabiihaga yanagwa omu nyanja erukwaka omurro n'obuganga, nambere hakaba hali ekinyamaiswa n'omurangi ow'ebisuba, kandi nambere balibonabonesezibwa nyamusana n'ekiro ebiro byona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.10",
            "verseOrgIds": [
              "REV.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okucwerwa omusango okwa ha mpero",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
