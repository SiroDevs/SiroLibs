          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka rukumi obu erihwa, Sitaani alisumururwa aruge omu nkomo ye, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
