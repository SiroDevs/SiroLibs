                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe nkaba nyemeriire ha musa gw'enyanja; kandi narora ekinyamaiswa nikiimuka omu nyanja kiina amahembe ikumi, emitwe musanju, ekondo ikumi ha mahembe gaakyo, kandi ha mitwe yakyo hahandiikirweho ibara erirukujuma Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekinyamaiswa eki narozire, kikaba nikisisana engo, ebigere byakyo nibisisana eby'edubu, akanwa kaakyo nikasisana ak'entale. Ekijoka kyakiha amaani gaakyo, n'ekitebe kyakyo eky'obukama, n'obusobozi bwakyo obwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogumu ha mitwe yakyo gukaba nigusisana ogwina ekihuta ekirukusobora kukiita, baitu ekihuta eki ekyakusoboire kukiita, kyakira; kandi abantu boona ab'ensi bahondera ekinyamaiswa bahuniriire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baaramya ekijoka eki, habwokuba obusobozi bwakyo kikabuha ekinyamaiswa, kandi baaramya n'ekinyamaiswa nibagamba bati: “Nooha arukusisana ekinyamaiswa, kandi nooha asobora kukirwanisa?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 13:5"
          },
