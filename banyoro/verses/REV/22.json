                  "text": "3:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "B'omugisa abo aboogya ebijwaro byabu bakabyeza, nukwo baikirizibwe kulya ha bijuma by'emiti y'obwomeezi n'okutaaha orubuga orukuru nibaleetwa omu malembo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.14",
            "verseOrgIds": [
              "REV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aheeru yarwo haikarayo embwa, abarogo, abasiihani, abaisi b'abantu, abaramya abacwezi na boona abagonza kandi abaikaliza eby'obugobya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
