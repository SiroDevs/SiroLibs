          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omuntu kakuba abikeehyaho, Ruhanga talimwikiriza kuhika ha muti ogw'obwomeezi n'omu rubuga orurukwera, ebisoboroirwe omu kitabu kinu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.19",
            "verseOrgIds": [
