          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wena anyakukwasirwe iroho, leka aije; na weena arukwetaaga, leka anywe amaizi ag'obwomeezi agatarukugurwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
