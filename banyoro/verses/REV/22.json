            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyowe Yohaana, nimpabura weena arukuhurra ebigambo ebyarangirwe ebiri omu kitabu kinu: Kakuba omuntu abyongeraho, Ruhanga alimwongeraho emihito enyakusoboroirwe omu kitabu kinu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.18",
            "verseOrgIds": [
