              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yagamba ati: “Dora ndi haihi kwija. Nyina empeera ey'okusasura buli omu habw'ebi yakozire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
