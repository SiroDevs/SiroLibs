              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu arukugumya binu naagamba ati: “Mazimakwo ndi haihi kwija.” Nukwo kibe! Ija MUKAMA Yesu!",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.20",
