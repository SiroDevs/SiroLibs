            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Handiikira malaika ow'ekitebe eky'abaikiriza ekiri Laodikeya noogamba oti: ‘Binu nibyo bigambo by'Ogu arukwetwa “Kibekwo”, kaiso omwesigwa kandi ow'amazima, endugirro ya byona Ruhanga ebi yahangire. Naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 3:14"
          },
          "items": [
