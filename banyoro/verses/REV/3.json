              "items": [
                {
                  "text": "Zab 69:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.20.12"
              },
              "items": [
                {
                  "text": "Kus 20:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.32"
              },
              "items": [
                {
                  "text": "Mat 10:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.8"
              },
              "items": [
                {
                  "text": "Luk 12:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu anyakusingura, nukwo alijwara ati ebijwaro ebirukwera, kandi ibara lye tindiriragaza omu kitabu eky'obwomeezi; baitu ndimuranga omumaiso ga Isenyowe n'ag'obwomeezi; baitu ndimuranga omumaiso ga Isenyowe n'ag'abamalaika be. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.5",
            "verseOrgIds": [
              "REV.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyakwina okutu, ahurre Mwoyo ebi arukugambira ebitebe eby'abaikiriza.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.6",
            "verseOrgIds": [
              "REV.3.6"
            ]
          }
        }
      ]
    },
    {
