            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Handiikira malaika ow'ekitebe eky'abaikiriza ekiri Filadelufiya noogamba oti: Binu nibyo bigambo by'Ogu Ahikiriire, ow'amazima kandi anyakwina ekisumuruzo kya Daudi. Nuwe ogu anyakukingura hatarukubaho n'omu anyakukinga; kandi anyakukinga hatarukubaho n'omu anyakukingura. Naagira ati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.7",
            "verseOrgIds": [
              "REV.3.7"
            ]
          }
        }
      ]
