              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.14",
            "verseOrgIds": [
              "REV.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Mmanyire ebikorwa byawe: torukufuka kandi torukwokya. Haakire waakufukire rundi waakwokeze! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.15",
            "verseOrgIds": [
              "REV.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu habw'okusangwa oli kooyakooya, torukufuka kandi torukwokya, ninyija kukutanaka, onduge omu kanwa! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.16",
            "verseOrgIds": [
              "REV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningira niiwe arukugamba oti: Ndi muguuda, ebintu nibinyizira kurungi, tinyina eki ndukwetaaga; kandi kunu torukumanya nkooku oli munaku, w'okuganyirwa, museege, kihimbaara, kandi noogenda busa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.17",
            "verseOrgIds": [
              "REV.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki ninkuhabura: onguleho zaabbu enyakusemeziibwe omurro, nukwo obe muguuda. Onguleho n'ebijwaro ebirukwera, bikuswekerre, bikwiheho ensoni ez'okurorwa noogenda busa; kandi onguleho omubazi ogw'okuta omumaiso, nukwo orole. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.18",
            "verseOrgIds": [
              "REV.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.12"
              },
              "items": [
                {
                  "text": "Nfu 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.6"
              },
              "items": [
                {
                  "text": "Baheb 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo aba ngonza, mbahana kandi mbafubira; nahabweki wekambe kandi oyegarukemu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.19",
            "verseOrgIds": [
              "REV.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurra nu, nyemeriire ha rwigi ninyeranga; omuntu weena obu ahurra iraka lyange akakingura orwigi, ninyija kutaahamu, mmuhikeho, nukwo tulye hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.20",
            "verseOrgIds": [
              "REV.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogu anyakusingura, ndimwikiriza aikarre na nyowe ha kitebe kyange eky'obukama, nka nyowe oku nasingwire, naikarra na Isenyowe ha kitebe kye eky'obukama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.21",
            "verseOrgIds": [
              "REV.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyakwina okutu, ahurre Mwoyo ebi arukugambira ebitebe eby'abaikiriza.’”",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.22",
            "verseOrgIds": [
              "REV.3.22"
            ]
          }
        }
      ]
    }
