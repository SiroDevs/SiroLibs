                "loc": "JER.17.21"
              },
              "items": [
                {
                  "text": "Yer 17:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu biro ebi, nkabona abantu abaajungaga ha Sabbato kandi nibaleeta engano nyingi, nibagyetwekesa enkaina zaabo nibataho n'eviini, emizaabbibbu, emitini, n'ebintu ebindi bingi ebi baaleetaga Yerusaalemu ha Sabbato; nkabahabura ha kiro eki baaguliizeeho ebyokulya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.15",
            "verseOrgIds": [
              "NEH.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija aba Taaya abaikaraga omu rubuga oru, baaleetaga ebintu bingi eby'emeringo yoona, babiguza abantu ba Yuda abakaba bali Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.16",
            "verseOrgIds": [
              "NEH.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo najunaine abanyoro ba Yuda nabakaguza nti: “Eki nimukora kintu ki eki ekibi kiti, okusiisa ekiro kya Sabbato? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.17",
            "verseOrgIds": [
              "NEH.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baisenkuru inywe tinukwo bakozire bati? Ruhanga waitu tinukwo kutuleetera akabi kanu koona, n'okukaleetera orubuga runu? Nimukyayongera kuhambiriza Ruhanga akwatirwe muno Isirairi ekiniga okukiraho, habw'okusiisa Sabbato.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.18",
            "verseOrgIds": [
              "NEH.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.18",
            "verseOrgIds": [
              "NEH.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwire obu bukaba nibwira amaiso omu malembo ga Yerusaalemu, Sabbato etakahikire, nkaragira nti: Enyigi ikingwe, kandi nateererra nti italikingurwa okuhika Sabbato ehoire. Kandi nkataho abamu ha baheereza bange balinde amalembo, haleme kubaho ekintu na kimu ekirukutaahibwa ha kiro kya Sabbato. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.19",
            "verseOrgIds": [
              "NEH.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abasuubuzi n'abatunzi ab'ebintu ebya buli mulingo bakaraara aheeru ya Yerusaalemu dimu rundi kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.20",
            "verseOrgIds": [
              "NEH.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
