              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.24"
              },
              "items": [
                {
                  "text": "2 Sam 12:24",
                  "type": "text"
                }
              ]
            },
