                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi omu biro ebi, nkarora Abayuda abakaba baswire abakazi aba Asidoodi, Abaamoni n'Abamowabbu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekicweka ekya kabiri eky'abaana baabo, baabazaaga Orunyasidoodi, bakaba batarukusobora kubaza engambo ey'Abayuda, baitu baabazaaga engambo eya buli ihanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkateera nabo empaka, nabakyeena, abamu omuli bo nabateera, nabamenya isoke; nabaragira barahire omu ibara lya Ruhanga nibagamba bati: “Mutaliikiriza mutalisweza bahara banyu batabani baabo, rundi inywe kuswererra bahara baabo batabani banyu, rundi inywe inywenka kubaswera. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
