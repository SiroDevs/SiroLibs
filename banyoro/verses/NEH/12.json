            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma natembya abakuru ba Yuda ha kisiika eruguru, nabacwamu ebicweka ebikooto bibiri, bisoronge by'ehingulirize orubuga, nibisiima Ruhanga. Ekimu kikatemba ekisiika ha mukono gw'obulyo, kyagenda ha irembo ery'orubungo; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo baakuratwa Hosaya n'ekicweka eky'abakuru ba Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaliya, Ezira, Mesuraamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, Benyamiini; Semaaya, Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abamu ha batabani ba banyakatagara, nibateera, amakondere: Haakurataho Zekaliya mutabani wa Yonasaani, mwijukuru wa Semaaya, Semaaya ya Mataniya, Mataniya ya Mikaaya, Mikaya ya Zikuli mutabani w'Asafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ab'oruganda rwe Semaaya, Azaleeri, Miralayi, Giralayi, Mayi, Netaneeri, Yuda na Hanani, nibateera ebintu ebirukugamba nk'ebya Daudi omuntu wa Ruhanga; kandi Ezira omuhandiiki nuwe yabeebembiire. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu baarugire ha irembo ly'ensoro, baagenda babeebeembiire, baaraba ha matembero g'orubuga rwa Daudi ha matemba g'ekisiika eruguru y'enju ya Daudi, baahika ha irembo ery'amaizi erya Burugaizooba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
