            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.12"
              },
              "items": [
                {
                  "text": "1 Byok 26:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakoraga emikoro ey'okweza n'emigenzo endi Ruhanga ei yaragiire, nk'abazini n'abalinzi oku baakoraga nka Daudi na mutabani we Solomooni nkooku baaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu kasumi ka Daudi n'Asafu aba ira, habahoga mukuru w'abazini, kandi hakaba haroho ebizina eby'okuhaisaniza n'okusiima Ruhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abaisirairi boona, omu kasumi ka Zerubbabberi n'obwa Nehemiya, baahayoga emigabo eya buli kiro ey'okukoonyera abazini n'abalinzi; egi ey'Abaleevi, baagitaga ha rubaju; kandi Abaleevi nabo, baataga ha rubaju egi eya batabani b'Arooni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
