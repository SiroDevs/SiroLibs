              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro eki, bakahonga ebyonzira bingi kandi bakaijura omuhimbo. Habwokuba Ruhanga nuwe yabaleetiire omuhimbo ogu ogutagambwa; abakazi n'abaana na bo bakasemererwa muno. Omuhimbo gwa Yerusaalemu gwahulirwa hara muno.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
