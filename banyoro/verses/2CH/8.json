            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma, yahonga ebihongwa eby'okwokya, yabihongera ha itambiro eri akaba ayombekere omumaiso g'ekisasi ky'omulyango, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
