            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "omulimo ogwa buli kiro nkooku gukaba nigwetagwa, yahonga naakuraatira ekiragiro kya Musa, ekya Sabbato, ameezi emboneko n'amagenyi asatu aga buli mwaka: obugenyi obw'omugaati ogutatumbisiibwe, obugenyi obwa wiiki, n'obugenyi obw'ensiisira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakoma ebihanda bya banyakatagara nkooku baraakoraga omulimo gwabo, naahondera ekiragiro kya Daudi ise, n'Abaleevi nkooku baraakoraga emirimo yabo ey'okuhaisaniza n'okuheereza omumaiso ga banyakatagara, omulimo ogwa buli kiro nkooku gwabaga nigwetaagwa, ebihanda eby'abalinzi b'amalembo, ab'okulinda amalembo agatali gamu; habwokuba, Daudi omuntu wa Ruhanga, nukwo akaba aragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyona omukama eki yaragiire banyakatagara n'Abaleevi ha buli kintu, na ha bintu ebyayahwirwe, batakirugeho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
