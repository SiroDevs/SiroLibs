                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Yer 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya kuteera engoma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "34:1",
              "type": "text"
            },
            {
              "text": "Engoma",
              "type": "text"
            },
            {
              "text": "nikimanyisa obulemi bw'omukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaba ahikize emyaka munaana, akalemera emyaka amakumi asatu na gumu, ali omu rubuga Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akakora MUKAMA ebi asiima, yakwata omuhanda Daudi isenkuru ogu yakwasire; atarukuhugahuga kutoma ha bulyo rundi ha bumoso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya Narwanisa Endamya y'Abakafiiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, omu mwaka ogwa munaana ogw'engoma ye, obwakaba akiri muto muno, nubwo yatandikire kuserra Ruhanga wa Daudi isenkuru; kandi omu mwaka ogwa ikumi n'ebiri, nubwo yatandikire kusemeza Yuda na Yerusaalemu, kuziihamu ebiikaro eby'abanyamahanga eby'okuramizaamu, kuziihamu Asera, n'ebisisani ebisarwiirwe, n'ebyagiibwe omu bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2 Bakam 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Byok 33:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaseesa amatambiro ga Baali, na uwe aroleriire ati; yatematema amatambiro agaacumiikirirwahoga obubbaani, agakaba gali eruguru ya gali; baacwacwana Asera n'ebisisani ebisarwiirwe n'ebyagiibwe omu bintu, yabisasangura yabifoora cuucu, ecuucu egi, yagiseesa ha bituuro by'abantu abaabitambiraga ebyonzira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Bakam 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi akookya n'amagufa ga banyakatagara, yagookeza ha matambiro gaabo, Yuda na Yerusaalemu, nukwo yazisemiize ati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omu mbuga za Manaase, ez'Efuraimu, n'eza Simyoni, ezikaba ziri bikambuuro, ha mbaju zoona, okuhikira kimu ha Nafutaali, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akacwacwana amatambiro, yasasangura Asera n'ebisisani yabifoora nsaano, yatematema amatambiro, agaacumiikirirwahoga obubbaani, yagamara omunsi ya Isirairi yoona. Hanyuma, yagaruka Yerusaalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekitabu ky'Ebiragiro Nikizorwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omu mwaka ogwa ikumi na munaana ogw'engoma ye, obu yamazire kusemeza ensi n'Enju naihamu endamya ey'ekinyamahanga akatuma Safani mutabani w'Azaliya, Maaseya omulemi omukuru ow'orubuga, na Yoa mutabani wa Yowazi omuhandiiki w'amakuru, basemeze Enju ya MUKAMA Ruhanga we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baahikaho Hilukiya nyakatagara omukuru, baamukwasa sente ezikaba zireesirwe omunju ya MUKAMA, Abaleevi abaalindaga omulyango ezi bakaba basoroize omunsi ya Manaase n'ey'Efuraimu, hali Abaisirairi boona abakaba basigaireho, ezi baasoroize omunsi eya Yuda yoona n'eya Benyamiini, n'omu basi ba Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baazikwasa abakozi abakaba bali ha mulimo ogw'okurolerra Enju ya MUKAMA; abakozi abo, baazita ha kusemeza n'okwimukya Enju. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaziha ababaizi n'aboombeki, bagule amabaale agabaizirwe, embaaho ez'okubohesa, n'emirabba ey'okwombeka amaju abakama ba Yuda aga baalekere gaaseeseka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaija, abaakozire omulimo bakaba bali beesigwa mali. Yowazi n'Obadiya Abaleevi aba batabani ba Merari, nubo batairweho kubarolerra, oteho Zekaliya na Mesulaamu, aba batabani b'Abakohasi Abaleevi, boona abakaba bamanyire muno kuteera ebintu ebirukugamba eby'okuzinisa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nubo baarolerraga abeetweki b'ebintu, kandi nubo bahaburaga boona abaakoraga omulimo gwona ogwobuheereza; Abaleevi abamu bakaba bali bahandiiki, abandi banyoro, abamu balinzi b'amalembo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu bakaba nibaturukya sente ezikaba zireesirwe omunju ya MUKAMA, Hilukiya nyakatagara yazoora ekitabu eky'Ebiragiro bya MUKAMA, ebi yahaire Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo yagambiire Safani omuhandiiki w'eby'ensita ati: “Ekitabu ky'Ebiragiro nakizoora omunju ya MUKAMA”; yakimuha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safani yakireetera omukama, yamurangira ati, “Byona ebyaragiirwe abaheereza bawe, nibabikora. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sente ezaasangirwe omunju ya MUKAMA, baiturukize, baazikwasa abanyampara n'abakozi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Safani nukwo kugambira omukama ati, “Hilukiya nyakatagara, ampaire ekitabu.” Yakimusomera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama obu yahuliire ebigambo eby'Ebiragiro, yatemura ebyokujwara bye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaragira Hilukiya, Ahikamu mutabani wa Safani, Abudoni mutabani wa Miika, Safani omuhandiiki w'ebyensita, n'Asaaya omugaragara w'omukama naagamba ati, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Irooko mugende, munkagulize hali MUKAMA, na habw'abo abasigaire omu Isirairi na Yuda, ha bigambo by'ekitabu ekinyakuzoirwe; MUKAMA atubiihiriirwe muno, habwokuba, baisenkurwitwe batakwate kigambo kye, batalore byona ebyahandiikirwe omu kitabu kinu.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilukiya n'abo omukama aba akaba atumire, nukwo kugenda mba Hulida omurangikati, muka Saluumu mutabani wa Tokuhasi, mwijukuru wa Hasira, omulinzi w'eryahurro ery'ebyokujwara (omu kasumi ako, yaikaraga Yerusaalemu, omu kicweka ekya kabiri) baabimugambira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabagarukamu ati, “MUKAMA, Ruhanga owa Isirairi naagamba ati: ‘Mugende mugambire omusaija ayabantumireho muti, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "MUKAMA naagamba ati, ekiikaro kinu, ndikireetera akabi, hamu n'abantu bakyo, ndibaleetera emikyeno yoona, enyakuhandiikirwe omu kitabu ekyasomiirwe omukama wa Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwokuba, nyowe bakanfuruka, baaruhanga abandi, nubo baacumiikirra obubbaani, oleke bambiihize n'ebintu ebi, ebi barukukora, habweki, ndibiihirirwa muno ekiikaro kinu, kandi ekiniga tikirindugaho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama wa Yuda ayabatumire okwekaguzaaho MUKAMA, mugende mumugambire muti, MUKAMA Ruhanga owa Isirairi naagamba ati: Okubaza ha bigambo ebi wahuliire, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwokuba, obu wahuliire ebigambo MUKAMA ebi yagambireho ekiikaro kinu n'abantu abakiikaramu, omutima gwawe gukazira kandi wayebundaaliza Ruhanga, nkooku wanyebundaaliize, watemura ebyokujwara byawe walirirra omumaiso gange, nanyowe nkuhuliire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikutwara nkusangise baswenkuru, olituuza otabaazibwe n'obusinge, akabi koona aka ndireetera ekiikaro kinu n'abasi bakyo tolikabonaho.’” Ebi, baagaruka baabigambira omukama.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama, nubwo yatumire, yasorooza abakuru ba Yuda boona, n'aba Yerusaalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagenda omunju ya MUKAMA, n'abantu ba Yuda boona, n'abasi ba Yerusaalemu, banyakatagara n'Abaleevi, abantu boona abakuru n'abato; yasoma ebigambo eby'endagaano eyasangirwe omunju ya MUKAMA, abantu boona bahunzire amatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yayemerra omu kiikaro kye, yaraganiza MUKAMA kumukuraatiraga, kukwataga Ebiragiro bye n'ebigambo bye, n'omutima gwe gwona, n'omwoyo gwe gwona, kuhikirizaaga ebigambo Eby'Endagaano ebyahandiikirwe omu kitabu kinu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma boona aba Yerusaalemu n'aba Benyamiini abakaba bali aho, yabaragira kukwataga endagaano egi. Abasi ba Yerusaalemu, baakora ebirukuragirwa endagaano ya Ruhanga, Ruhanga owa baisenkurubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya yaiha ebinugwa byona omu nsi ey'abantu ba Isirairi; kandi obwomeezi bwe bwona, akaragira abantu ba Isirairi boona kuheereza MUKAMA, Ruhanga owa baisenkurubo. Obusinge bwe bwona, batarugeho MUKAMA, Ruhanga owa baisenkurubo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
