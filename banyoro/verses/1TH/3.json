                "loc": "ACT.17.15"
              },
              "items": [
                {
                  "text": "Ebik 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki obu twarozire tutakyasobora kugumiisiriza, tukacwamu tusigale Aseni itwenka, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo kutuma Timoteho mugenzi waitu kandi omuheereza wa Ruhanga omu kurangirra Amakuru Amarungi ga Kristo, abagumye omu kwikiriza kwanyu kandi abateererre, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "haleke kubaho n'omu arukutengesibwa emihito egi. Na inywe inywenka nimumanya ebi nkooku bikaba biri by'okutuhikaho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukabagambira kara, obu tukaba tukyali na inywe, nkooku tuli b'okubona emihito; kandi nukwo kyabairekwo, nkooku murukumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki obu narozire ntakyasobora kwikara ntaina eki mbahuliireho, nabatumaho Timoteho, mmanye okwikiriza kwanyu nkooku kuli, habwokuba nkaba nintiina nti, rundi omwohi ataakuba abooheze, kandi omulimo gwaitu gukafa busa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo naasiima Ruhanga habw'ebi yabahuliireho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Ebik 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati Timoteho obu yagarukire naaruga owaanyu, yatuleetera amakuru ag'okwikiriza kwanyu n'okugonza kwanyu. Kandi yatumanyisa nkooku mutwijuka butoosa n'okusemererwa, nimugonza muno kuturora, nka itwe oku turukugonza kubarora. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabweki ab'oruganda, okwikiriza kwanyu kutuhuumwize omu bujune bwaitu bwona n'omu mihito yaitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumanya inywe nkooku mugumire hali MUKAMA, nikyo kitugumya omutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruhanga turaamusiima tuta habw'okusemererwa oku kwona oku twinakwo habwanyu omumaiso ge? ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukataho muno omutima kusaba nyamusana n'ekiro, nukwo tusobole kurorangana twongerereze ebirukubura omu kwikiriza kwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitusaba Ruhanga waitu kandi Isiitwe wonyini, hamu na MUKAMA waitu Yesu, batwebembere batuhikye owaanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi MUKAMA abongere okugonzangana muno, n'okugonza abantu boona, nka itwe oku tubagonza, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo asobole kugumya emitima yanyu, mwemerre omu maiso ga Ruhanga kandi Isiitwe nimwera kandi mutaina kamogo ha kiro MUKAMA waitu obw'aliija aina abahikiriire be boona.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
              "1TH.3.13"
            ]
          }
        }
      ]
    }
  ],
