            "sid": "2SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseboseesi mutabani wa Saulo obuyahuliire Abbuneeri nkooku afiire, agwire Hebburoni, yahwa amaani, Abaisirairi boona baatiina. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.1",
            "verseOrgIds": [
              "2SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutabani wa Saulo akaba aina abasaija babiri, abakaba bali ngabwa ez'ebitebe ebiseesi; ibara ly'omu, nuwe Bbaana, ery'owakabiri, nuwe Rrekabu, bombi batabani ba Rrimoni, omusaija ow'oruganda rwa Bbenyamiini ayarugire Beroosi, (Beroosi nayo yayetwaga ya Bbenyamiini); ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.2",
            "verseOrgIds": [
              "2SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu Ababerosi bakasingirwa Gitahimu, nuho baikara okuhika na hati.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
