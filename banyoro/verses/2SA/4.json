                "loc": "2SA.9.3"
              },
              "items": [
                {
                  "text": "2 Sam 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonasaani mutabani wa Saulo akaba aina omwana omwojo omu ow'akaba aramaire amaguru, ibara lye Mefiboseesi. Nambere haiziire amakuru agaarugire Yezereeri, agarukubika Saulo na Yonasaani, akaba ahikize emyaka etaano; omulezi we yamuhimba yairuka; omulezi we ogu obwakaba nairuka naayanguha muno, omwana ogu yagwa, aho nuho haamurugiire obulema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.4",
            "verseOrgIds": [
              "2SA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho batabani ba Rrimoni Omuberosi, Rrekabu na Bbaana, baimukya, baahika hanju ya Iseboseesi omu ihangwe, omukasumi ako, Iseboseesi akaba yabyamaho ahuumwire ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.5",
            "verseOrgIds": [
              "2SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukazi omulinzi w'enju akaba naahehemukya engano, oturo twamukwata, yabyama; Rrekabu na Bbaana owanyina, nukwo kusooba bakataaha omunju. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.6",
            "verseOrgIds": [
              "2SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obubaataahire omunju, baarora Iseboseesi abyamire ha kitabu kye omukisiika eky'okuraaramu, baamucumita, baamwita, baamucwaho omutwe. Omutwe gwe baagutwara, bakaraara nibarubata ekiro kyona, baatwarwa omuhanda ogw'Arabba, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.7",
            "verseOrgIds": [
              "2SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "baaguleetera omukama Daudi Hebburoni. Baamugambira bati: “Dara omutwe gwa Iseboseesi mutabani wa Saulo omunyanzigwa wawe ayayendaga kukwita; waitu, kiro kya hati, MUKAMA aholiire mukama wange enzigu hali Saulo n'oruzaaro rwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.8",
            "verseOrgIds": [
              "2SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu Daudi yagarukamu Rrekabbu na Bbaana owanyina batabani ba Rrimoni Omuberosi ati: “Nindahira MUKAMA omwomeezi ayanjunire obubi bwona, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.9",
            "verseOrgIds": [
              "2SA.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.1+2SA.1.2+2SA.1.3+2SA.1.4+2SA.1.5+2SA.1.6+2SA.1.7+2SA.1.8+2SA.1.9+2SA.1.10+2SA.1.11+2SA.1.12+2SA.1.13+2SA.1.14+2SA.1.15+2SA.1.16"
              },
              "items": [
                {
                  "text": "2 Sam 1:1-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu onu obuyangambiire ngu Saulo afiire, naateekereza ngu akaba naambaliza amakuru amarungi, nkamukwata namwitira Zikiraga, egi niyo yabaire mpeera namusaswire habw'amakuru agayandetiire. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.10",
            "verseOrgIds": [
              "2SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ababi obubaraaba baisire omuhikiriire, baamunaga omunju ye ha kitabu kye, eki nakozire buli, hati tinkikizeeho? Tikimpikiriire kubajunaana esagama ye, na inywe nkabahwerekereza mukaruga omunsi?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.11",
            "verseOrgIds": [
              "2SA.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi yaragira abaserikale be, baabaita, baabacwaho emikono n'amaguru, baabahanika Hebburoni haihi n'ekiyanja. Baitu omutwe gwa Iseboseesi, bakagutwara baaguziika Hebburoni omukituuro ekyaziikirwemu Abbuneeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.12",
            "verseOrgIds": [
              "2SA.4.12"
            ]
          }
        }
      ]
    }
