          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyamuleesire hanu, akaija kukubiihabiiha, ayetegereze byona ebyokora, amanye hoona nambere ogenda.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
