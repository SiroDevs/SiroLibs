              "2SA.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, Omukuusi yahika; yagambira omukama ati: “Waitu mukama wange omukama, nkuleetiire amakuru amarungi! Habwokuba kiro kinu, MUKAMA akujunire boona abaakwemiire.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukama yakaguza Omukuusi ati: “Omusigazi Abusalomu aliyo kurungi?” Omukuusi yagarukamu ati: “Abanyanzigwa ba mukama wange iwe omukama, na boona abanyakukwimukirra kukukora kubi, babe nk'omusigazi ogu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo omukama yasaalirwa muno, yagenda omukisiika ekya hairembo, yatandika kurra, naatongyatongya ati: “Ai mwiru wange Abusalomu, mwiru wange, mwiru wange Abusalomu! Kakuba ninyowe nafiire nkakusiga, Ai Abusalomu mwana wange, mwana wange!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
      ]
