              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa akeeta ab'oruganda rwa Rubbeni, orwa Gaadi, n'ekicweka eky'oruganda rwa Manaase ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.20+NUM.32.21+NUM.32.22+NUM.32.23+NUM.32.24+NUM.32.25+NUM.32.26+NUM.32.27+NUM.32.28+NUM.32.29+NUM.32.30+NUM.32.31+NUM.32.32"
              },
              "items": [
                {
                  "text": "Kubar 32:20-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.12+JOS.1.13+JOS.1.14+JOS.1.15"
              },
