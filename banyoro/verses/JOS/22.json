              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehaasi nyakatagara n'abeebembezi b'ekitebe, abakuru ab'ebitabu eby'enganda ez'Abaisirairi abakaba bali hamu na uwe, baahurra ebigambo abantu ba Rubbeni, aba Gaadi n'aba Manaase ebi baagambire, babisiima muno. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehaasi mutabani wa Eryeza nyakatagara yagambira abantu ba Rubbeni, aba Gaadi naaba Manaase ati: “Kiro kinu twamanya MUKAMA nkooku ali na itwe, habwokuba mutamugobeze; nikyo mwajuniire Isirairi ekifubiro kye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
