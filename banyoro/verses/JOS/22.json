                  "text": "Yos 1:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yabagambira ati: “Mukahikiriza byona, ebi Musa omuheereza wa MUKAMA yabaragiire; mwakora kyona ekinabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.2",
            "verseOrgIds": [
              "JOS.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiro binu byona, bagenzi banyu timukabahemukiraga, okuhikya na hati mukataho omutima okuhikiriza MUKAMA Ruhanga wanyu ekiyabaragiire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.3",
            "verseOrgIds": [
              "JOS.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati, MUKAMA Ruhanga wanyu, ahaire bagenzi banyu Abaisirairi obusinge nkooku yabaraganiize; habweki, mwimuke mugaruke omumaka ganyu, omunsi ey'omugabo gwanyu, Musa omuhereza wa MUKAMA ei yabahaire obuseeri bwa Yorudaani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.4",
            "verseOrgIds": [
              "JOS.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteho muno omutima okukwata ebiragiro n'ebigambo, Musa omuheereza wa MUKAMA ebiyabaragiire: nukwo okugonza MUKAMA Ruhanga wanyu, okukora byona ebi agonza, okukwata ebiragiro bye, okumugumiraho, n'okumuheereza n'omutima gwanyu gwona, n'obwomezi bwanyu bwoona.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.5",
            "verseOrgIds": [
              "JOS.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo, Yoswa yabaha omugisa, yabaraga, baagaruka owaabu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.6",
            "verseOrgIds": [
              "JOS.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekicweka ekimu eky'oruganda rwa Manaase, Musa akaba akihaire ensi enyakuli Basani; ekicweka ekindi, akakiha ensi enyakuheeriire bagenzi babu omunsi enyakuli Bugwaizooba bwa Yorudaani. Yoswa obuyamazire kubaraga bagaruke owaabu bo, abasabiire n'omugisa, yabagambira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.7",
            "verseOrgIds": [
              "JOS.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwagaruka owanyu mumazire kuguudahara, mwina amagana maingi muno, mwina efeeza, zaabbu, omulinga, ebyoma, n'engoye nyingi; ebimwanyagireho abanyanzigwa banyu, mubagane na bagenzi banyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.8",
            "verseOrgIds": [
              "JOS.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo, ab'oruganda rwa Rubbeni, Gaadi n'ekicweka eky'oruganda rwa Manaase, baagaruka owaabu bo, baayahukana n'Abaisirairi omukiikaro Siiro ekinyakuli omu nsi Kanaani, bagenda omunsi eya Giryadi, ensi ey'omugabo gwabo, MUKAMA ei yaragiire Musa kubaha, ebe nsi yabo mali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.9",
            "verseOrgIds": [
              "JOS.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obubaahikire omukicweeka ekinyakuheeriire Yorudaani, enyakuli omunsi Kanaani, baayombekaho itambiro erikooto rurangaanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.10",
            "verseOrgIds": [
              "JOS.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eki, Abaisirairi baakimanya, baagamba bati: “Ab'oruganda rwa Rubbeni, orwa Gaadi n'ekicweka eky'oruganda rwa Manaase bombekere itambiro ha mutaano ogw'ensi ya Kanaani, omukicweeka ekinyakuheeriire Yorudaani, harubaju orw'ensi yaitu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.11",
            "verseOrgIds": [
              "JOS.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisirairi obubaahuliire eki, boona baayesorooleza Siiro, babarwanise.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.12",
            "verseOrgIds": [
              "JOS.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo, Abaisirairi baakwata Finehaasi mutabani wa Eryeza nyakatagara, baamutumaho ab'oruganda rwa Rubbeni, orwa Gaadi n'ekicweka eky'oruganda rwa Manaase abakaba bali omunsi Giryadi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.13",
            "verseOrgIds": [
              "JOS.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baamutuma hamu n'abalemi ikumi, buli omu hali bo, akomerwe omubuli ruganda orwa Isirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.14",
            "verseOrgIds": [
              "JOS.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaseesira ab'oruganda rwa Rubbeni, orwa Gaadi n'ekicweka eky'oruganda rwa Manaase abakaba bali omunsi Giryadi. Baabagambira bati: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.15",
            "verseOrgIds": [
              "JOS.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.13"
              },
              "items": [
                {
                  "text": "Bir 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekitebe kya MUKAMA kyona nikikaguza kiti: ‘Mukozire ki kinu okugobeza Ruhanga owa Isirairi nimwanga kuhondera MUKAMA kiro kya hati, nimweyombekera itambiro erirukwoleka nkooku mumujemiire? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.16",
            "verseOrgIds": [
              "JOS.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3+NUM.25.4+NUM.25.5+NUM.25.6+NUM.25.7+NUM.25.8+NUM.25.9"
              },
              "items": [
                {
                  "text": "Kubar 25:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwijuka ekibi kyaitu eki twakozire tuli omukiikaro Peyora? Ekibi eki, ekyaleetiire ekitebe kya MUKAMA omuhito, kikyaturoho na hati hoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.17",
            "verseOrgIds": [
              "JOS.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hati nikyo murukwangira kumukuratira? Hati obu murayemera MUKAMA, ijo naija kubiihirirwa ekitebe kyona ekya Abaisirairi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.18",
            "verseOrgIds": [
              "JOS.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yanyu obweraaba etali nungi, mugende omunsi ya MUKAMA nambere hali Eheema ye, nuho mwikale hamu na itwe, kyonka mutalirengaho mukamwemera, rundi na itwe kutufoora beemi nimwombeka itambiro erindi eritali lya MUKAMA Ruhanga waitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.19",
            "verseOrgIds": [
              "JOS.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.1+JOS.7.2+JOS.7.3+JOS.7.4+JOS.7.5+JOS.7.6+JOS.7.7+JOS.7.8+JOS.7.9+JOS.7.10+JOS.7.11+JOS.7.12+JOS.7.13+JOS.7.14+JOS.7.15+JOS.7.16+JOS.7.17+JOS.7.18+JOS.7.19+JOS.7.20+JOS.7.21+JOS.7.22+JOS.7.23+JOS.7.24+JOS.7.25+JOS.7.26"
              },
              "items": [
                {
                  "text": "Yos 7:1-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwijuke Akani mutabani wa Zera nkooku yacwire ekiragiro ekyatairweho habw'ebintu ebisemeriire kuhwerekerezibwa: ekitebe kyona ekya Isirairi nkooku twafubiirwe habw'ekigambo eki? Mutagira Akani wenka nuwe yafubiirwe habw'ekibi kye eki.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.20",
            "verseOrgIds": [
              "JOS.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo abaana ba Rubbeni naaba Gaadi, n'ekicweka eky'oruganda rwa Manaase, baagarukamu bakuru b'ebika bya Isirairi bati ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.21",
            "verseOrgIds": [
              "JOS.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ow'obusobozi ali omu, nuwe MUKAMA Ruhanga! Amanyire! Kandi Isirairi nayo esemeriire kumumanya! Obu tuliba twayemere titwaba beesigwa hali MUKAMA, mutwite hati. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.22",
            "verseOrgIds": [
              "JOS.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutuliba twayangire kuhurra MUKAMA, twayeyombekera itambiro okwokezaaho ebyonzira rundi ebihongwa eby'ebyokulya rundi eby'okuteerana hamu, MUKAMA wonyini atufubire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.23",
            "verseOrgIds": [
              "JOS.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyatukoleze eki, tukateekereza tuti omu biro eby'omumaiso, abaijukuru banyu balikaguza abantu bati: ‘MUKAMA Ruhanga owa Isirairi mumwinaho bukwatane ki? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.24",
            "verseOrgIds": [
              "JOS.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yorudaani, niyo yafoire mutaano ogurukwahukaniza itwe hali inywe abantu ba Rubbeni n'aba Gaadi, inywe timwina mugabo MUKAMA oguyabahaire.’ Nubwo, abaana banyu, balirekesa abaitu kuramya MUKAMA. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.25",
            "verseOrgIds": [
              "JOS.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukwo kucwamu tuti: ‘Ka tweyombekere itambiro, tiriri ly'okwokezaaho ebihongwa rundi ebyonzira, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.26",
            "verseOrgIds": [
              "JOS.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "baitu bwakaiso hali itwe na hali inywe, na ha bantu ab'obusinge obuliija itwe tutakyaroho, nkooku turamyakwo MUKAMA omumaiso ag'Eheema ye erukwera, nituhonga ebihongwa eby'okwokya n'ebyonzira, n'ebihongwa eby'okuteerana hamu. Ekyatukoleze eki, nukwo kutanga abaijukuru banyu kugamba ngu: “abantu tibanyina mugabo MUKAMA oguyabahaire.”’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.27",
            "verseOrgIds": [
              "JOS.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukateekereza tuti: Obuhalibaho arukutugamba ekigambo eki rundi kukigamba abaijukuru baitu omu biro eby'omumaiso, baligamba bati: ‘Murole, ba isenkuru itwe bakombeka itambiro erirukusisanira kimu itambiro lya MUKAMA. Itambiro eri, litabe ly'okwokezaaho ebihongwa eby'okwokya rundi ebyonzira, baitu libe bwakaiso obw'abantu baitu n'abanyu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.28",
            "verseOrgIds": [
              "JOS.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikikafuuhe, itwe okwemera MUKAMA n'okuleka kumukuraatira, nitwombeka itambiro ery'okwokezaaho ebihongwa eby'okwokya, rundi ebyonzira, eritali itambiro lya MUKAMA Ruhanga waitu erinyakwemeriire omumaiso ag'Eheema ye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.29",
            "verseOrgIds": [
              "JOS.22.29"
            ]
          }
        }
      ]
    },
