          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
              "JOS.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
