          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Musa yayongera yaaha obugwetwa bw'ensi ekicweka eky'oruganda rwa Manaase nkooku bakaba bali omu bika byabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensi yabo ekatandikira Mahanaimu, yayasaamu Basani yoona, nubwo obukama obwa Ogi omukama wa Basani n'embuga zoona eza Yairi ezinyakuli omunsi Basani, embuga nkaaga; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekicweka ekya Giryadi, Asitarosi na Edereyi, embuga ezinyakuli omu bukama bwa Ogi owa Basani, ezi ikaheebwa abantu ba Makiri, itwarwe ekicweka eky'abaana ba Makiri baijukuru ba Manaase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
