{
  "id": "2TI.2",
  "number": "2",
  "bookId": "2TI",
  "reference": "2Tim 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naamuteererra kugumira obulemeezi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hati iwe, mwana wange, ba w'amaani habw'obukoonyezi bwa Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi nakugambiire omumaiso g'abakaiso baingi, obikwase abantu abeesigwa, abalisobora kwegesa n'abandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na iwe nk'omuserikale omurungi owa Kristo Yesu, gumira okubonabona kwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiharoho muserikale anyakuli ha mulimo gwe anyakwetaba omu bigambo by'abatali barwani, habwokuba naagenderra kusiimwa ayamukomere. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuzaani w'empaka taheebwa kondo, rundi buli naahondera ebiragiro by'okuzaana. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulimi omwekambi nuwe asemerra kubanza kuganura ebyokulya ebi ayereze. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weetegereze ebi ndukugamba, habwokuba MUKAMA naija kukukoonyera kukenga byona.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijuka Yesu Kristo ayahumbuukire omu bafu kandi mwijukuru wa Daudi, nkooku kyarangirwe omu Makuru Amarungi aga nabatebiize. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakuru Amarungi ago nugo ndukubonabonera, mboherwe omu njegere nk'omuntu enkozi y'ebibi. Baitu ekigambo kya Ruhanga tikibohwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki ngumiisiriza byona habw'abakomerwemu, nukwo nabo batunge okujunwa n'ekitiinisa eky'ebiro n'ebiro omu Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kinu ky'amazima ekirukugamba kiti:",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwerinda empaka ezitarukugasa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi oikalege noobibaijukya, kandi obateererre omumaiso ga MUKAMA: beerinde empaka ezitaleeta karungi, baitu zihwerekereza abazihurra. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wekambe okweyoleka oli muntu kwo arukusiimwa Ruhanga, omukozi atarukukwatwa nsoni, arukwegesa kurungi ekigambo ky'amazima. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Werinde embazo ezitarumu kutiina Ruhanga, habwokuba nizongera kuhabisa abantu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ebigambo byabo bigenda nibirya nk'ekookoro. Omuli abo nuho hali Himenaayo na Fileeto, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaahabire amazima nibagamba ngu, okuhuumbuka kukahingura ira. Nukwo bajuumika okwikiriza okw'abantu abamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Kubar 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baitu omusingi gwa Ruhanga ogugumire gwikaraho, guroho emanyikirizo erukugamba eti: “MUKAMA, abe naabamanya”, kandi eti: “Weena anyakwatura ibara lya MUKAMA, aruge omu bubi.”",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunju enkooto tihabamu bikwato ebya zaabbu n'efeeza byonka, baitu habamu ebibaizirwe n'ebibumbirwe. Ebimu biba by'emirimo ey'ekitiinisa, ebindi by'emirimo etali y'ekitiinisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu kakuba ayeihaho byona ebitali birungi; obu, alifooka kikwato ky'omulimo gw'ekitiinisa, kintu ekyeziibwe kandi ekirukugasira nyineeka, kiteekaniziibwe okukora omulimo gwona omurungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habweki oyetantale okwegomba kubi okw'obusigazi, oyemarre ha buhikiriire, ha kwikiriza, ha kugonza, na ha businge, nookwataniza n'abo abeeta ibara lya MUKAMA, baina omutima ogurukwera. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wecwereho kimu empaka ez'obudoma ezitaina makuru; na iwe omanyire nkooku izaara enkungani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheereza wa MUKAMA tasemerra kuba muntu w'enkungani, baitu aba munyambabazi ha buli muntu weena, mwegesa murungi kandi anyakugumiisiriza, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2TI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "omuntu arukuhana mpora abarukumuteeza empaka. Rundi Ruhanga asobora kubaha kwegarukamu kandi bakamanya amazima, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2TI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukwo basobole kutabuka emitego Sitaani ei yabakwatiiremu, bakole ebi Ruhanga yagondeze.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.26",
            "verseOrgIds": [
              "2TI.2.26"
            ]
          }
        }
      ]
    }
  ],
