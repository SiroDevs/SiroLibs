      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okufa kwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
