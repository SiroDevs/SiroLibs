            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu byabaga nibigenda, nahurraga okuhuuma kw'amapapa gaabyo, nikusisana nk'okuhirra kwenyanja, nk'iraka ly'Ow'obusobozi bwona, iraka ery'akoogo, nk'iraka ery'ihe; obu byayemerraga, bisirimura amapapa gaabyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
        {
