              "EZK.1.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.9+EZK.10.10+EZK.10.11+EZK.10.12+EZK.10.13"
              },
              "items": [
                {
                  "text": "Ezek 10:9-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukasumi ako, obunaroleriire ebihangwa ebyomeezi, narora enyamuziga ekwasire ha itaka, ebiri hagati, buli kimu hali byo, kiina enyamuziga emu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyamuziga ezi, zikaba nizisisana kandi zikozirwe ziti: Ensisana yazo, zikaba nizengeengeta nk'ibaale ry'omuhendo berulo; ebihangwa ebbina ebi, bikaba nibisisana enkora yabyo, eri nk'enyamuziga enyakutaahiibwe omu nyamuziga endi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obu byabaga nibigenda, byatomaga ha habuli rumu, ha mbaju zaabyo ina, kandi byagendaga bitarukuhinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Kus 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyamuziga ina zikaba ziina empanga ina, kandi zikaba ziina empagi; empanga zaazo, zikaba ziina obuhuru okuzeehinguliriza ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebihangwa ebyomeezi obu byabaga nibigenda, emyamuziga zaabigenderaga ha rubaju; kandi obu byabaga nibiimuka hansi, nazo ziimuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoona omuyaga ha gwateeraga nigutoma, ebihangwa ha byagendaga, n'enyamuziga nuho zaagendaga, hamu nabyo; habwokuba omwoyo gw'ebihangwa ebyomeezi, nugwo gukaba guli omu nyamuziga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biri obu byagendaga, na binu bigenda; kandi biri obu byayemerraga binu nabyo byemerra; kandi biri obu byaimukaga, enyamuziga ziimuka hamu nabyo; habwokuba omwoyo ogw'ebihangwa ebyomeezi nugwo gukaba guli omu nyamuziga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.6"
              },
              "items": [
                {
                  "text": "Kus 4:6",
                  "type": "text"
