              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haahulirwaga iraka niriruga omu mwanya ogubiri haiguru ha mitwe yabyo; obu byayemerraga bisirimura amapapa gaabyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
