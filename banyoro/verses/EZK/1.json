              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumuliikana okukaba kwehinguliriize aho, kukaba nikusisana nk'omuhangazima ogunyakuzooka omu kicu hakiro eky'enjura.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
