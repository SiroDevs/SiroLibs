            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eruguru y'emitwe ey'ebihangwa ebyomeezi, hakaba nihasisana nk'omwanya ogw'iguru, nihamuliikana nk'ibaale kurrisitoolo, aganjairwe ha mitwe yabyo eruguru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hansi y'omwanya ogu, amapapa gaabyo, nuho gakaba geeyanjurwire garorangaine; buli kihangwa, kikaba kiina amapapa abiri agakiswekeriire omubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
