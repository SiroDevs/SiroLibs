              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kiro ekya ikumi na bibiri eky'okwezi okwa ikumi okw'omwaka ogwa ikumi ogw'okuzaahisibwa kwaitu, MUKAMA akangambira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wewe mwana w'omuntu, oimukye amaiso gawe, orole Faraaho omukama wa Misiri, orange ebirimuhikaho, kandi ebirihikaho Misiri yoona; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "omugambire oti: MUKAMA Ruhanga naagamba ati:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
