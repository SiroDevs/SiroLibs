            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiboshethi mutabane wa Saulo bwe yawulira nga Abuneri bamwitiire e Heburoni, yaawaamu amaani n'Abaisiraeli boonaboona baasoberwa inho. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.1",
            "verseOrgIds": [
              "2SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishiboshethi oyo mutabane wa Saulo, yali n'abasaadha be babiri abaakuliranga ebikunsu ebyajanga okulumba mu ntalo. Owundi nga ni Baana, ate owundi nga ni Rekabu, bombi nga batabane ba Rimmoni, omusaadha ow'e Beerothi, nga wa kika kya Benjamini. (Beerothi ekyo, kyona kitwalibwa okuba ekiketezo ekya Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.2",
            "verseOrgIds": [
              "2SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatyamye b'omu Beerothi ekyo, baalumukira e Gittaimu, era ye babairenga baba okutuusa ni ye buli eno.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.4.3",
            "verseOrgIds": [
              "2SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
