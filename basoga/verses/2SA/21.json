          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo bwe yasoononkereza Abaisiraeli, Yonathani mutabane wa Shimei muganda wa Daudi, yaamwita.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.21",
