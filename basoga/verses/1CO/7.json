              "1CO.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo eyamala okwandhula bw'akibona nga tikikola bukalamu omughala ye yamala okwandhula, ng'amairu ali na mangi, era ng'awulira ng'ateekwa okubayiza omughala oyo, akole nga bw'ayenda, amubayize aba takoze kibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.36",
            "verseOrgIds": [
              "1CO.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye oyo atakakiibwa bukakibwe era amaliriire mu mwoyo gwe obutabayiza, era ng'asobola bukalamu okufuga amairu ge, era ng'amaze okusalagho mu mwoyo gwe eky'okukola, kiba kikalamu obutabayiza mughala oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.37",
            "verseOrgIds": [
              "1CO.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale oyo abayiza mwine ye yamala okwandhula akola bukalamu, aye asinga n'oyo atabayiriza irala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi omufumbo tasobola kuba wa busa iba bw'aba ng'akaali mulamu. Aye iba bw'afa asobola okubayira omusaadha owundi, aye omusaadha oyo ateekwa kuba nga Mukurisito. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu kubona okwange, okusigala nga bw'ali mwe yandisinze kwesiimira, era ndowooza nga zeena ndi ni Mwoyo wa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
