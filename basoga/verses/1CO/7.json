          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli ni mukazi wo? Kale otagezangaku kumwetoolaku. Okaali kubayiza? Kale otagezangaku kubayiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.27",
            "verseOrgIds": [
              "1CO.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bw'obayiza oba tokoze kibi, era n'omughala omwegha bw'abayira aba takoze kibi. Aye abafumbo baba n'ebizibu kamaala, era nandyenze okubawonia ebizibu oti n'ebyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.28",
            "verseOrgIds": [
              "1CO.7.28"
            ]
          }
        }
      ]
