              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboluganda, bwe naidha ye muli okubakobera amazima ag'ekyama kya Katonda, tyakozesa bibono bikalangafu waire okukozesa amagezi ag'ekikugu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba nasalagho okuleka ebindi byonabyona okutoolaku Yesu Kurisito n'okufa kwe ku musalaba. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bwe naidha ye muli nali munafu nga ntya era nga ndhugumira zeenazeena",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.9"
              },
              "items": [
                {
                  "text": "Bik 18:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "era mu ndhegeresa yange ni mu bukwenda bwange timwalimu magezi ga nsi agasendasenda, aye mwalimu kwoleka maani ga Mwoyo wa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo kyaba nti okwikiriza kwaimwe tikuva mu magezi ga nsi, aye kuva mu maani ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
