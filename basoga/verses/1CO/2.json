            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waire nkobye ntyo, abo abakuze mu mwoyo mbakobera amagezi, aye nga amagezi ago ti n'ag'ensi eno oba ag'abo ab'obukumu abagifuga, abali n'okuwaagho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mbakobera amagezi ag'ekyama kya Katonda amagise, ge yataagho ng'ensi ekaali kutondebwa olw'okutugheesa ekitiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghazira naire ku bafuzi ab'ensi eyakimanha, kuba nguli baali bakiidhi, tibandikomereire Musengwa ow'ekitiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nga bwe kyaghandiikibwa:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
