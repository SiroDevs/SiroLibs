            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Tattenai, omufuzi w'ekiketezo ekiri ere ng'osomoike omwiga Eufurate, ni Shetharibozenai, nga bali ghalala ni bakagwa baibwe, baakolera irala byonabyona nga kyabazinga Dario bwe yalagira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.1"
              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Era abakulembeze b'Abayudaaya baazimba eisinzizo eryo bukalamu. Abalanzi Haggai ni Zekaria mutabane wa Iddo baabaizangamu amaani olw'ebyo bye baalanganga. Baamaliriza okuzimba nga bajiira ku biragiro bya Katonda wa Isiraeli, ni ku kwikirizibwa kwa bakyabazinga, Kuro ni Dario ni Arutazerizesi, ab'e Perusia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale eisinzizo eryo lyawa okuzimba ku lunaku olwokusatu olw'omwezi ogwetebwa Adari, nga kyabazinga Dario ali kufuga omwaka gwe ogwomukaaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abaisiraeli, ni bakabona, n'Abalevi, n'abantu abandi abaira okuva mu bunhage, baasagamba inho nga batukuza eisinzizo lya Katonda eryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku mukolo ogwo baaghaayo ente enume kikumi (100), entaama enume ebikumi bibiri (200), n'entaama ento ebikumi bina (400). Baaghaayo n'embuzi enume ikumi na ibiri (12), embuzi ndalandala olwa buli kika kya Isiraeli, kibe ng'ekigheebwayo olw'ebibi eby'Abaisiraeli boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baataagho bakabona mu bikunsu byaibwe, n'Abalevi mu ngobo dhaibwe, baagheerezanga Katonda mu isinzizo e Yerusalemu, nga bwe kyaghandiikibwa mu kitabo kya Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
