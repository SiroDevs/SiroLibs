              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga Dario yaagha ekiragiro banoonereze mu bighandiiko eby'ebyafaayo eby'obwakyabazinga ebyali mu materekero g'ebitabo mu nsi Babilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.1",
            "verseOrgIds": [
              "EZR.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baayagaana mu kibuga Ekubatana ekyali mu kiketezo eky'e Media, enzingo y'ekitabo eyalimu ekighandiiko ekikoba kiti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.2",
            "verseOrgIds": [
              "EZR.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 6:5"
          },
          "items": [
