              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.5",
            "verseOrgIds": [
              "EZR.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Dario yairamu ng'agheereza obukwenda buno, ati:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        }
      ]
    },
