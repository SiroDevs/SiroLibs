        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embaluwa eyo eyava ye kyabazinga Arutazerizesi bwe baagisomera Rehumu, ni Shimushai omughandiisi, ni banaibwe abandi boonaboona, baasitukiramu baajiiragho y'Abayudaaya e Yerusalemu, baakaka bya ntaka Abayudaaya okulekera okuzimba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.23",
            "verseOrgIds": [
              "EZR.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
