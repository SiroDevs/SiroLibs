              },
              "items": [
                {
                  "text": "Hag 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.1"
              },
              "items": [
                {
                  "text": "Zek 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kale omulimo ogwali guli kukolebwa e Yerusalemu ku isinzizo lya Katonda baagwemereza, okutuusa mu mwaka ogwokubiri ogw'obufuzi bwa kyabazinga Dario ow'e Perusia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.24",
            "verseOrgIds": [
              "EZR.4.24"
            ]
