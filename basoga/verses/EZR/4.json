            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Zerubbabeli, ni Yeshua, n'abakulu ab'enda dha baiseibwe mu Isiraeli baabakoba bati: “Titwetaaga buyambi bwaimwe okusobola okuzimbira Musengwa Katonda waife isinzizo. Ife beene tuja kulizimba, nga kyabazinga Kuro ow'e Perusia bwe yatulagira.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu abaali baba mu kiketezo ekyo baagezaaku okumala mu Bayudaaya amaani nga babatiisatiisa, balekere okuzimba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaguliriranga abafuzi babatabuletabule mu kigendererwa kyaibwe ekyo. Ekyo baakikola ekiseera kyonakyona Kuro kye yamala nga ni kyabazinga w'e Perusia, n'okutuusa mu biseera Daria mwe yabeera kyabazinga w'e Perusia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
