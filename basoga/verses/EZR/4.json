          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga yaabairamu mu bughandiike ati:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.17",
            "verseOrgIds": [
              "EZR.4.17"
            ]
          }
        }
