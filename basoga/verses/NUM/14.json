            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye beene baakana, baaniinaniina mu kiketezo eky'oku nsozi, waire ng'Esanduuku ey'Endagaano ya Musengwa Katonda tiyava mu kifo ghe baasimba weema dhaibwe, oba Musa okuva mu kifo ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abamaleki n'Abakanaani abaabanga mu biketezo ebyo eby'oku nsozi, baabalumba, baabaghangula, era baababingirira okubatuukiza irala e Horuma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
