          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye bw'anaabanga nga tiyeeyonoona era nga mulongoofu, amaadhi ago tigaamukolenga kabi koonakoona, era aidha kusobolanga okuzaala abaana.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
