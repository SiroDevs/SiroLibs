    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninze Paulo eyafuuka omutume wa Kurisito Yesu olw'okwenda kwa Katonda, n'owoluganda Timotheo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.1"
              },
              "items": [
                {
                  "text": "Bik 18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tughandiikira Ekikunsu eky'Abaikiriza mu Kurisito ekya Katonda mu Korintho, n'abatuukirivu boonaboona abali mu Akaia yoonayoona.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkabi n'emiraala ebya Katonda Lata waife, ni Musengwa Yesu Kurisito bibe n'imwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda era Ise wa Musengwa waife Yesu Kurisito agheebwe ekitiisa, oyo Lata ow'okusaasira okungi era atubeera buliidho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kudaagadaaga kwaife okwa buli nsambo atugumya, memale twena tughange okugumya abali mu kudaagadaaga okwa buli nsambo, nga tubagumya nga ife beene Katonda bw'atugumya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba, nga bwetugabana ku kudaagadaaga einho okwa Kurisito, tutyo bwetugabana ni mu kugumizibwa einho Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe tudaazibwadaazibwa, imwe mufuna okugumizibwa n'okulokolebwa, ate bwe tugumizibwa era mwafuna amaani ag'okuguminkiriza, n'okubita mu kudaagadaaga nga ife kwe tubitamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tubeesiga inho buliidho, kuba twidhi tuti nga bwe mugabana ku kudaagadaaga kwaife, mugabana ni ku kugumizibwa kwaife.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aboluganda, twenda mumanhe okudaagadaaga okwatutuukaku mu Asia. Twanhigirizibwa ebitaloodheka, era nga titulowooza nga tusobola okuba abalamu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.32"
              },
              "items": [
                {
                  "text": "1 Kor 15:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwene twawulira mule nga tusaliirwa gwa kufa. Aye kino kyatutuukaku tulobe kwesiga maani gaife, aye twesige Katonda yenka azuukiza abafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo eyatuwonia mu kabi akanene akaaga agho ak'okufa era n'alituwonia, era oyo ye tusuubira okutuwonia kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwena mutubeere nga mutusabira, ng'abantu kamaala bwebatusabira Katonda n'atugha enkabi, era abantu kamaala ni batwebalizaaku Katonda olw'enkabi dhe tufuna olw'okusaba kwaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensonga etwesiimisa n'eno nti munda mule twekakasa nga mu nsi muno, n'okusingira irala mu imwe, twebisiiza bukalamu mu mazima ni mu butuukirivu, ti lwa magezi ga bantu aye lwa kisa kya Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tubaghandiikira ebyo byonka bye musobola okusoma era n'okutegeera. Ka nsuubire nti mulibitegeera mu bwidhuvu ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga bwe mwabitegeeraku akatono, mughange okwesiima olwaife, oti niife bwe tulyesiima olwaimwe ku lunaku lwa Musengwa waife Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olw'okuba kino nali nkikakasa, nayenda nsooke okukyalira imwe musobole okufuna enkabi edh'emikuzi ebiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayenda mbakyalire nga nja e Makedonia, ate kabiri mbakyalire nga nva e Makedonia, mungemereku ku by'olugendo lwange olw'e Buyudaaya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Bik 19:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ntegeka yange nayenda okukola ntyo. Mudhuuba muti nali n'emyoyo ebiri? Muti entegeka dhange ndhikola oti n'omuntu ow'ensi akoba ati “Yii” ni “Busa” mu kaseera n'akalala ako? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Katonda bw'ali, ow'amazima era atakyukakyuka, twena titubakobangaku tuti “Yii” ate kabiri ni tubakoba tuti “Busa”. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba Yesu Kurisito Omwana wa Katonda, Siluvano, Timotheo, ninze ye twabakobera, tiyali “Yii” ni “Busa”, aye oyo buliidho ni “Yii.” wa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba oyo ni “yii” wa kiisi Katonda kye yasuubiza. Eyo n'ensonga lwaki kubwa Kurisito Yesu tukoba tuti “Amiina” nga tugha Katonda ekitiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda n'atukakasa ife n'imwe nga mu Kurisito mwe tufunira obulamu, era mwene oyo n'eyatulobolamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatutaaku akamanhiso ke ng'ababe, era yatugha Mwoyo Mutukuvu mu myoyo gyaife ng'omusingo olw'ebyo by'atuterekera.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda aidhi ebiri mu mwoyo gwange n'omudhulizi wange, nti olw'obutenda kubataghaania n'ekyandobera okwidha e Korintho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti twenda kubalagira bulagire bye muteekwa kwikiriza kuba twidhi nga muli bagumu mu kwikiriza, aye twenda tukolere ghalala memale musangaale.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.24",
            "verseOrgIds": [
              "2CO.1.24"
            ]
          }
        }
      ]
    }
  ],
