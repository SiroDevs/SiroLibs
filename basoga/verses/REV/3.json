        },
        {
          "text": "“Kale nkugha amagezi onguleku zaabu alongooseibwa mu muliro osobole okuba omukombe, onguleku ebivaalo ebyeru ovaale owone ensoni edh'okubita ekidu, era onguleku obulezi obw'okusiiga ku maiso go oghange okubona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.3.18",
            "verseOrgIds": [
              "REV.3.18"
            ]
          }
        }
