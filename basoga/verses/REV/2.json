          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ali n'amatu awulire Mwoyo ky'akoba Ebikunsu eby'Abaikiriza mu Kurisito. Oyo aghangula ndimugha ku mannu eyagisibwa, era ndimugha eibaale eryeru okughandiikiibwa eriina eiyaaka eritamanhiibwa muntu wundi yeenayeena, okutoolaku oyo aba alifunie.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        },
