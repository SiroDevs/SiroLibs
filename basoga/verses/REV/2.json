        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye ndiku ni bye ntakusiimaku: Eyo oliyo n'abantu abajiira ku kwegeresa kwa Balaamu eyayegeresa Balaki okusendasenda Abaisiraeli okugwa mu kibi balye ebigheereibwayo eri ebisinzibwa ebitali Katonda, era bakole eby'obudankaanu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.5"
              },
              "items": [
                {
                  "text": "Kub 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
