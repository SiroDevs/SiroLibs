        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emyaka egyo olukumi (1,000) nga gimaze okuwaaku Sitaani alisibulwa mu ikomera lye, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.7",
            "verseOrgIds": [
              "REV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaafuluma okuguya amaghanga agali ku nsonda eina edh'ensi edheetebwa Gogi ni Magogi. Alibasoloza okulwana nga bali bangi ng'omusenho gw'enhandha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.8",
            "verseOrgIds": [
              "REV.20.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
