              "HEB.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaigulu ghaayo nga ghaligho ebitonde ebiri n'amaghagha ebyetebwa kerubi, ebyoleka ekitiisa kya Katonda, ebighemba ekityamo ekisoniyirwaku ebibi n'amaghagha gaabyo. Aye bino byonabyona, titughanga kubyogeraku mu bwidhuvu buti.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
