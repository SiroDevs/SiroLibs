              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Einhuma ew'olutimbe olwokubiri yaliyo ekiketezo ekindi ekyetebwa Ekifo Ekitukuvu Einho.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
