              },
              "items": [
                {
                  "text": "Kuv 26:31-33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghano n'aghaali alutaari eyakolebwa mu zaabu nga yaakuniokezaaku bubbaani. Era n'aghaali Esanduuku ey'Endagaano, eyaghembwaku zaabu ku ndhuyi dhoonadhoona. Mu sanduuku omwo mwalimu ekibya ekya zaabu omwali mannu era mwalimu omwigo gwa Aaroni ogwalokaku amakaba, mwabaamu n'ebipande eby'endagaano.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.4",
            "verseOrgIds": [
              "HEB.9.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
