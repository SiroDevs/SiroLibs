              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endagaano eyasooka yoona yabanga n'amateeka agaakolerwangaku mu kusinza, era yabanga n'ekifo ekitukuvu ku nsi kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eweema yateebwagho. Mu kifo kyayo ekituukirwaku mwalimu ekikondo ky'eitaala, n'emeeza, n'emigaati egigheereibwayo eri Katonda. Ekiketezo ekyo nga kyetebwa Ekifo Ekitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
