            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebyo byonabyona nga bimaze okutegekebwa bityo, bakabona baajanga buliidho mu kiketezo eky'eweema ekituukirwamu, baakolanga eby'obwakabona.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.2+NUM.18.3+NUM.18.4+NUM.18.5+NUM.18.6"
              },
              "items": [
                {
                  "text": "Kub 18:2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu Weema ey'omunda mwajangamu Omukulu wa Bakabona yenka, ng'angiramu omukuzi mulala buli mwaka, era ng'ateekwa okutwalayo omusaayi gw'aghaayo ku lulwe ni ku lw'ebyonoono eby'abantu bye bakola mu butamanha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2+LEV.16.3+LEV.16.4+LEV.16.5+LEV.16.6+LEV.16.7+LEV.16.8+LEV.16.9+LEV.16.10+LEV.16.11+LEV.16.12+LEV.16.13+LEV.16.14+LEV.16.15+LEV.16.16+LEV.16.17+LEV.16.18+LEV.16.19+LEV.16.20+LEV.16.21+LEV.16.22+LEV.16.23+LEV.16.24+LEV.16.25+LEV.16.26+LEV.16.27+LEV.16.28+LEV.16.29+LEV.16.30+LEV.16.31+LEV.16.32+LEV.16.33+LEV.16.34"
              },
              "items": [
                {
                  "text": "Lev 16:2-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bino byonabyona Mwoyo Mutukuvu alaga nti engira etuuka mu Kifo Ekitukuvu Einho yali ekaali kwigulwagho kuba ekiketezo eky'eweema ekituukirwamu kyali nga kikaaligho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako kaali kamanhiso bumanhiso ak'ebyo ebirigho buti, kuba mu nkola eno ebirabo n'emisengo ebyagheebwangayo tibyasobolanga kutukuza mwoyo gw'oyo aba aidhie okusinza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino byakomanga ku bya ku ngulu ebigema ku kulya, ni ku kunhwa, ni ku bulombolombo obw'okwetukuza, ebyali eby'okubaagho okutuusa ku kiseera eky'okwiza ebintu byonabyona obuyaaka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Kurisito bwe yaidha ng'Omukulu wa Bakabona ow'ebintu ebirungi ebija okwidha, yabita mu weema esinga obukulu n'okutuukirira, etaakolebwa bantu, era etaali ya ku nsi kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangira mu Kifo Ekitukuvu Einho omukuzi mulala guti gwamala, nga tatwalayo musaayi gwa mbuzi na nte nto ng'omusengo, aye ng'atwala omusaayi gwe mwene olw'okutufunira okununulibwa okutawaagho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaayi ogw'embuzi, n'ogw'ente enume, n'eivu ery'ente enduusi, bwe bimansirwa ku abo abatali balongoofu bibatukuza baaba balongoofu mu by'oku ngulu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15+LEV.16.16"
              },
              "items": [
                {
                  "text": "Lev 16:15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.9"
              },
              "items": [
                {
                  "text": "Kub 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.17+NUM.19.18+NUM.19.19"
              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba ng'ekyo kityo bwekiri, memale omusaayi gwa Kurisito tigulisingagho inho kututukuza ni tugheereza Katonda omulamu ku lwa Kurisito aziraku kimyamya, eyeeghaayo ye Katonda mu maani ga Mwoyo atawaagho?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni Kurisito n'akwania endagaano empyaka, abo abaasuubizibwa ebirungi ebitawaagho babifune. Kuba yafa, yaanunula abantu mu bibi byaibwe bye baakolanga nga bakaafugibwa endagaano eyasooka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aghali ekiraamo ghateekwa okubaagho obukakafu obw'okufa kw'oyo eyakiraama, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba ekiraamo tikikola ng'eyakiraama akaali mulamu, aye amala kufa memale kyakola. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'endagaano eyasooka kyeyava ekakasibwa n'omusaayi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa bwe yamala okukobera abantu ebiragiro byonabyona ebiri mu Mateeka, yatoola omusaayi ogw'ente ento n'ogw'embuzi, ghalala n'amaadhi, n'obuviiri bw'entaama obwa kasaayisaayi, n'akati akeetebwa hissopu, yaamansira ku kitabo ni ku bantu boonaboona,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Kuv 24:6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga bw'akoba ati: “Guno n'omusaayi ogukakasa endagaano Katonda y'abateereiregho.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mu nsambo n'endala Musa yamansira omusaayi ku weema ni ku bintu byonabyona ebyakozesebwanga mu kusinza.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.15"
              },
              "items": [
                {
                  "text": "Lev 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mu Mateeka kumpi buli kintu kitukuzibwa na musaayi, era aghazira kuyugha musaayi, tighabaagho kusoniyibwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.11"
              },
              "items": [
                {
                  "text": "Lev 17:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu ebyo ebyefaanaanirizaaku ku bire eby'omu igulu byalinga n'okwamulwa mu nsambo oti n'eyo. Aye eby'omu igulu byene biri n'okwamulibwa n'emisengo egisingaku obukalamu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurisito tiyangira mu kifo kitukuvu ekyakolebwa abantu, ekifaananaku obufaanane ni kire kyene, aye yangira mu igulu lyene, y'ali mperaano mu maiso ga Katonda ku lwaife. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kurisito tiyeeghaayo mikuzi kamaala oti ni Bakabona Abakulu bwe bangiranga buli mwaka mu Kifo Ekitukuvu Einho, ate nga ti kughaayo musaayi gwaibwe gwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba nguli kyali kityo, Kurisito yandibaire ng'ali n'okudaagadaaga emikuzi kamaala kasookanga ensi etondebwe. Aye mu byanda bino ebisembayo yaboneka omukuzi mulala guti nga gumala, atoolegho ekibi olw'okweghaayo mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.26",
            "verseOrgIds": [
              "HEB.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nga buli muntu bw'ali n'okufa omukuzi omulala, era ng'amaze okufa n'asalirwa omusango, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
            "verseOrgIds": [
              "HEB.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni Kurisito atyo bwe yagheebwayo omukuzi mulala olw'okutoolagho ebibi eby'abantu kamaala. Aliboneka omukuzi ogwokubiri, ti lwa kibi aye lwa kulokola abo abamulindirira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
            "verseOrgIds": [
              "HEB.9.28"
            ]
          }
        },
