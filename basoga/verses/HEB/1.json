              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana yagheebwa ekitiisa ekisinga ekya bamalaika, era nga bwe yagheebwa eriina erisinga agaibwe ekitiisa ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
