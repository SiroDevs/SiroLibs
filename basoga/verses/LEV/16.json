            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aaroni bw'anaamalirizanga okukola omukolo ogw'okutukuza Ekifo Ekitukuvu n'Eweema yoonayoona ey'Okwagaananirangamu ni Musengwa Katonda, ni alutaari, anaatwalanga ye Musengwa Katonda embuzi ere enamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:20",
              "type": "text"
            },
            {
              "text": "Embuzi enamu:",
              "type": "text"
            },
            {
              "text": "bona ni 16:8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaatanga emikono gye gyombi ku mutwe gw'embuzi eyo enamu, yaalaamiriza ng'ayatula ebyonoono n'ebibi eby'Abaisiraeli n'obudheemu bwonabwona yaabisindika ku mutwe gwayo, olwo yaagisindiikiriza mu irungu ng'etwalibwa omuntu eyategekebwa okukola ekyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embuzi eyo n'enaatwalanga ebibi byaibwe byonabyona, yaaja nabyo mu nsi eziramu bantu. Oyo agitwala anaagirekuliranga eyo mu irungu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
