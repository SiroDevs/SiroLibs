        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agho Aaroni aidha kwingiranga mu Weema ey'Okwagaananirangamu ni Musengwa Katonda, atoolemu ebivaalo ebighegheevu bye yavaire ng'aingira mu Kifo Ekitukuvu, era abireke omwo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.19"
              },
              "items": [
                {
                  "text": "Ezek 44:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaanaabiranga omubiri mu Kifo Ekitukuvu ekyo, yaavaala ebivaalo bye ebyabuliidho, yaafuluma, yaaghaayo ekigheebwayo ekyokebwa ekikye, n'ekigheebwayo ekyokebwa eky'abantu, olw'okutoolagho ebibi ebibye n'eby'abantu boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasavu ag'ekigheebwayo olw'ebibi anaagookeranga ku alutaari. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo asindiikiriza embuzi mu irungu eri Azazeli, anaayozanga ebivaalo bye era yaanaaba omubiri mu maadhi, memale yaira mu kifo omuba abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente enume n'embuzi edh'ekigheebwayo olw'ebibi, dheene musaayi ogwingizibwa mu Kifo Ekitukuvu olw'okukola omukolo ogw'okutukuza, dhinaafulumizibwanga ku luya dhaatwalibwa mu kifo omutaba bantu, dhaayokebwa. Amawu, emamba n'ebyenda byadho, binaayokebwanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Heb 13:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo abyokya anaayozanga ebivaalo bye, yaanaaba omubiri mu maadhi, memale yaira mu kifo omuba abantu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Eiteeka lino munaalikuumanga enaku dhoonadhoona: Ku lunaku olweikumi olw'omwezi ogwomusanvu, Abaisiraeli n'abasenze abaabasengamu, baneebonerezanga era tibaakolenga mulimo waire omulala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.26+LEV.23.27+LEV.23.28+LEV.23.29+LEV.23.30+LEV.23.31+LEV.23.32"
              },
              "items": [
                {
                  "text": "Lev 23:26-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Kub 29:7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo ghanaakolebwangagho omukolo olwa imwe okutukuzibwa, mutoolebweku ebibi byaimwe byonabyona, mube balongoofu mu maiso ga Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo lunaabanga lunaku lutukuvu lwa kuwuumulira irala, era muneebonerezanga. Eiteeka eryo linaakuumibwanga enaku dhoonadhoona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabona eyasiigibwa omuzigo n'ayawulibwa okuba kabona mu kifo kya ise, n'anaakolanga omukolo ogw'okutukuza ng'avaire ebivaalo ebighegheevu ebitukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aidha kukolanga omukolo ogw'okutukuza ekifo Ekitukuvu, n'Eweema ey'Okwagaananirangamu ni Musengwa Katonda, n'alutaari, era ni bakabona, n'abantu boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiteeka eryo munaalikuumanga enaku dhoonadhoona, nga mutaagho omukolo ogw'okutukuza, omukuzi mulala buli mwaka, olw'okutoola ku Baisiraeli ebibi byaibwe.” Musa yaakola nga Musengwa Katonda bweyamulagira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:34",
              "type": "text"
            },
            {
              "text": "Musa yaakola nga Musengwa Katonda bweyamulagira:",
              "type": "text"
            },
            {
              "text": "oba, Aaroni yaakola nga Musengwa Katonda bweyalagira Musa.",
              "type": "text"
            }
          ]
        }
      ]
    }
