          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kale mugonderenga bye mbalagira, mulobenga kujiiranga ku mpisa edho edheenhinhalwa, edh'abo abaabasooka okuba mu nsi eno, era mulobenga kwereetaku butali bulongoofu nga mukola ebyo. Ninze Musengwa Katonda waimwe.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
