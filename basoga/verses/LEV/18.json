            "sid": "LEV 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda yaalagira Musa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.1",
            "verseOrgIds": [
              "LEV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kobera Abaisiraeli oti: Ninze Musengwa Katonda, Katonda waimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muteebisanga ng'abantu ab'e Misiri ye mwabanga, oba ng'abantu ab'omu nsi Kanaani, ye ndi kubatwala. Mutajiiranga ku mpisa dhaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugonderenga amateeka gange, era mukolenga bye mbalagira. Ninze Musengwa Katonda waimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
              "LEV.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ni mugemenga amateeka n'ebiragiro bye mbagha. Anaabituukirizanga, anaabanga mulamu. Ninze Musengwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
