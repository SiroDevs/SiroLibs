              "type": "text"
            }
          ]
        },
        {
          "text": "“Omuntu bw'anaaghangayo embuzi, anaagigheerangayo mu maiso ga Musengwa Katonda. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
