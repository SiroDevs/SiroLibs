        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi ayenda okumpeereza annonerezenga. Ghe mba n'omugheereza wange gh'anaabanga. Era Lata alita oyo yeenayeena ampeereza mu kifo eky'ekitiisa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.26",
