          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.33",
            "verseOrgIds": [
              "JHN.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eikuukuubira lyamukoba liti: “Amateeka gatukoba gati Kurisito aja kuba mulamu ebyanda n'ebyanda. Aye iwe otukoba otya oti Omwana w'Omuntu ali n'okughanikibwa? Omwana w'Omuntu ono naani?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
