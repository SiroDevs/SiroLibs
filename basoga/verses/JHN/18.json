          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Anna yaamugheereza ye Kayafa Omukulu wa Bakabona era ng'akaali musibe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
