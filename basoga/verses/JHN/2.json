            "sid": "JHN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abayudaaya baamukoba bati: “Kamanhiso ki k'osobola okukola okutumanhisa ng'oli n'obukumu obukola bino?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        }
      ]
    },
