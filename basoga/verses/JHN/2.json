          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yali mu Yerusalemu, mu nnaku edh'Ekibinuko eky'Okubitizibwa abantu kamaala baamwikiriza bwe baabona ebyewuunhio bye yakolanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
