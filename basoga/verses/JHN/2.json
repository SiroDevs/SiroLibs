          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bwe yazuukira mu bafu Abeegeresebwa be baidhukira nga yayogera kino, era baikiriza Ebyaghandiikibwa, ni Yesu bye yakoba.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
