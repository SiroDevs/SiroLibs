              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye eisinzizo Yesu lye yali ayogeraku n'omubiri gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
