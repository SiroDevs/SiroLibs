          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayudaaya baamukoba bati: “Kyatwala emyaka amakumi ana na mukaaga (46) okuzimba eisinzizo lino! Waakoba oti oghanga okuliizaagho mu nnaku eisatu?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        }
      ]
    },
    {
