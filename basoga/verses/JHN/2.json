          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yesu nga tabeeyalizaamu, kuba boonaboona yali abaidhi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
              "JHN.2.24"
            ]
