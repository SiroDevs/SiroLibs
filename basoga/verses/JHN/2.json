          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyali tikyetaagisa kubaagho amukobera ebifa ku muntu, kuba yali ng'aidhi ebiri mu myoyo egy'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
