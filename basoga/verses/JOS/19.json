          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebibuga ebyo byonabyona aghalala n'ebyalo byaku, n'omugabo ogwagheebwa ekika eky'Abadani ng'enda dhaibwe bwe dhaali.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
