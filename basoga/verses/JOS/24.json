              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ghabiseegho ekiseera naatuma Musa ni Aaroni, okubatoola mu Misiri, era naata ku Misiri obuzibu obutakobeka, naabatoolayo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kuv 3:1—12:42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badhaadha baimwe abo bwe nabatoola mu Misiri ni batuuka ku Nhandha Emyufu, Abamisiri baababingirira n'ebigaali eby'omu lutalo, ghalala n'abalwani ab'oku mbalaasi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.1+EXO.14.2+EXO.14.3+EXO.14.4+EXO.14.5+EXO.14.6+EXO.14.7+EXO.14.8+EXO.14.9+EXO.14.10+EXO.14.11+EXO.14.12+EXO.14.13+EXO.14.14+EXO.14.15+EXO.14.16+EXO.14.17+EXO.14.18+EXO.14.19+EXO.14.20+EXO.14.21+EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29+EXO.14.30+EXO.14.31"
              },
              "items": [
                {
                  "text": "Kuv 14:1-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badhaadha baimwe bwe baatuuka ku Nhandha Emyufu bandirira mbabeere. Agho naaleetagho enzikiiza ghagati ghaibwe n'Abamisiri, era naalagira enhandha okubayoolookeraku era ebasandikire. Mwidhi bukalamu kye nakola Abamisiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
