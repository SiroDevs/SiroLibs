          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.3",
            "verseOrgIds": [
              "JOS.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaka naamugha Yakobo ni Esau. Esau naamugha ensi ey'ensozi Edomu nga n'obutaka bwe. Aye dhaadha waimwe Yakobo n'abaana be, baaja e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
