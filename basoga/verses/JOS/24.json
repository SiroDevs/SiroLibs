          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagumba ga Yosefu, Abaisiraeli ge baidha nago okuva e Misiri, baagaziika e Shekemu mu itaka Yakobo lye yagula ku batabane ba Hamori lata wa Shekemu. Eitaka eryo yaligula ebitundu bya feeza kikumi, era lyafuuka obutaka obwa baidhukulu ba Yosefu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
