              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Kuv 23:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.20"
              },
              "items": [
                {
                  "text": "Ma 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabagha emisiri gye mutaasimba, era naabagha ebibuga bye mutaazimba, era buti mwe muli. Mulya emizabbibu n'ebibala eby'emiti emyoliva gye mutaasimba.’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
