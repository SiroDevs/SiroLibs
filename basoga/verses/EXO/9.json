              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Musa yaafuluma ekibuga ekyo, yaaghanika emikono yaasaba Musengwa Katonda okubwatuka okw'olukuba n'omugozi era n'amaadhi byalekera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
