          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye era kyabazinga olwabona ng'amaadhi, n'omugozi, n'okubwatuka birekeire, mwene n'abakungu be kabiri baayonoona, baakalangusa emyoyo baaloba kutya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
