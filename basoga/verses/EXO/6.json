              "type": "text"
            }
          ]
        },
        {
          "text": "Gereshoni yazaala abana babiri era nga ni bano ng'ojiira ku nda dhaibwe, Libuni ni Shimei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
