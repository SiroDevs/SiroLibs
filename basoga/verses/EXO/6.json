            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni mutabane wa Yakobo omukulu yali n'abaana bano: Hamoki, Pallu, Hezironi, ni Karumi. Buli muntu ku abo yavaamu ekika. Edho n'enda edhaasimuka mu Reubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simeoni yazaala abaana mukaaga era nga ni bano: Yemueli, Yamini, Ohadi, Yakini, Zohara ni Shaulo omwana w'omukazi Omukanaani. Edho n'enda edhaasimuka mu Simeoni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        }
      ]
    },
    {
