            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzzieli yeena yaazaala abaana basatu era nga ni bano: Mishaeli, Elizafani ni Sithiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        }
