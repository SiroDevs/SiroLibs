              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Levi yazaala abaana basatu era nga ni bano ng'ojiira ku nse dhaibwe: Gereshoni, Kohathi ni Merari. Era Levi oyo yaaghangaala emyaka kikumi n'asatu na musanvu (137).",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
