          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora yazaala abaana basatu: Assiri, Elukana ni Abiasafu; edho nga n'enda edhaasimuka mu Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazari mutabane wa Aaroni yaafuna omukazi ku baghala ba Putieli, baazaala omwana baamutuuma eriina Finehasi. Edho n'enda edhaasimuka mu Levi era abo n'abakulu baadho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
