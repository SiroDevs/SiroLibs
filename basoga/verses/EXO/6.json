            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izahara yazaala abaana basatu era nga ni bano: Kora, Nefega ni Zikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        },
