        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku Musengwa Katonda lwe yayogera ni Musa mu Misiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda oyo yakoba Musa ati: “Ninze Musengwa Katonda. Kobera kyabazinga ow'e Misiri, byonabyona bye nkukoba.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Musa yaakoba ati: “Wo Musengwa Katonda, okiidhi bukalamu nga nze tiri mwogezi mulungi. Memale kyabazinga anampulirisa atya?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.30",
            "verseOrgIds": [
              "EXO.6.30"
            ]
          }
        }
