              "type": "text"
            }
          ]
        },
        {
          "text": "Musa n'Abaisiraeli abandi baayembera Musengwa Katonda olwembo luno, olukoba luti:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        },
        {
