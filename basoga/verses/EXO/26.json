                "loc": "HEB.6.19"
              },
              "items": [
                {
                  "text": "Heb 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3+HEB.9.4+HEB.9.5"
              },
              "items": [
                {
                  "text": "9:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho ote ekisandikiza ku ngulu okw'esanduuku eyo ng'eri mu Kifo Ekitukuvu Einho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oleete emeeza eteebwaku emigaati egigheereibwayo eri Katonda, ogite agho ku luya lwe Ekifo Ekitukuvu Einho, ku luuyi olw'omukono omugooda olw'e buvandhuba w'Eweema. Ate ekikondo eky'entaala okite ku luuyi olw'omukono omusaadha olw'e buvandhuba w'Eweema eyo, nga byolekaine n'emeeza ere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
