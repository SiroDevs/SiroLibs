              "EXO.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mu mulyango ogwingira mu Kifo Ekitukuvu Einho oidha kukoleragho ekintu ekikinzaagho nga kyakolebwa mu lugoye olwa langi ya bbululu, n'olw'eya nakasooma, n'olw'eya kasaayisaayi, ni mu lugoye olughegheevu era okitungiremu ebimuli ng'okozesa empiso n'ewuuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.36",
            "verseOrgIds": [
              "EXO.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekikinzaagho ekyo, oidha kukikolera empango itaanu edh'omuti ogwetebwa akasia, era nga dhirimbiibwaku zaabu dhoonadhoona okudheezunguluza. Empango oidha kudhikoleraku obusumaali bwa zaabu obugemerera ekikinzaagho ekyo, era odhikolere ebikolo bitaanu eby'ekyuma eky'ekikomo kwe dhinaayemereranga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.37",
            "verseOrgIds": [
              "EXO.26.37"
            ]
          }
        }
      ]
    }
