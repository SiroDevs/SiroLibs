        },
        {
          "text": " Buno n'obukwenda bwa Musengwa Katonda:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
