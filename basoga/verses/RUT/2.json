          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        },
