        },
        {
          "text": "Naomi yali n'omumanhe mu kibuga omwo nga bamweta Boazi era nga ba kika kirala ni Elimeleki eyali iba. Yali mukombe era nga mutaka mukulu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
