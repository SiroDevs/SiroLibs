            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.17"
              },
              "items": [
                {
                  "text": "24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abazaire mu iwe batwalibwa ng'ekitagasa, ebintu by'abasenze byakupankupanizibwa, banamwandu ni bamulekwa baatulugunhizibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.7",
            "verseOrgIds": [
              "EZK.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.30"
              },
              "items": [
                {
                  "text": "Lev 19:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.2"
              },
              "items": [
                {
                  "text": "26:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Onhoomerera ebintu byange ebitukuvu, era waayonoona n'olunaku lwange olwa Sabbato. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.8",
            "verseOrgIds": [
              "EZK.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu iwe mulimu abantu abaghaayiriza banaibwe olw'okwenda okubaitisa, mwabaamu abalya ku misengo gye bagheerayo mu masabo ku nsozi, mwabaamu n'abeesanhusa n'okukola obwenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.9",
            "verseOrgIds": [
              "EZK.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20"
              },
              "items": [
                {
                  "text": "Lev 18:7-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu iwe mulimu abasaadha ababa ni baka baiseibwe mu buliri, era mwabaamu n'abo abakaka abakazi ni baba nabo mu buliri nga bali mu biseera byaibwe eby'okulwala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.10",
            "verseOrgIds": [
              "EZK.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu iwe mulimu abenda ku baka beene, mwabaamu abenda ku baka batabane baibwe, n'abenda ku baanhinaibwe abaana ba baiseibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.11",
            "verseOrgIds": [
              "EZK.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
