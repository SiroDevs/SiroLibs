              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.5",
            "verseOrgIds": [
              "EZK.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bona eno, abakulembeze ab'omu Isiraeli ababa mu iwe, baita abantu nga bakozesa obukumu bwaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.6",
            "verseOrgIds": [
              "EZK.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
