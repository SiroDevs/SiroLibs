          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omuntu, lira amaziga ku lwa kyabazinga wa Tiro, omukobe oti nze Musengwa Katonda ndi kumukoba nti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
