        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda era yaakoba ati: “Ku maghanga goonagoona ageezungulwire ensi Isiraeli agaaginhoomanga, tighalibaagho waire eirala liti eririgifuukira olukandwa okugikwadula oba okugifuukira eiwa okugifumita. Olwo balimanha nga ninze Musengwa Katonda.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda era yaakoba ati: “Bwe ndimala okusoloza Abaisiraeli ni mbatoola mu maghanga mwe baasansaanira, olwo ab'amaghanga goonagoona balibona bwendi omutukuvu. Era Abaisiraeli abo baliba mu nsi yaibwe, ye nagha omugheereza wange Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baligibaamu mu miraala, baazimba amayumba, baasimba n'amasamba ag'emizabbibu. Baliba mu miraala bwe ndisala omusango ni mbonereza baliraanwa baibwe boonaboona abaabanhoomanga. Olwo balimanha nga ninze Musengwa Katonda.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
