              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iwe omuntu, kobera omufuzi ow'e Tiro oti nze Musengwa Katonda ndi kumukoba nti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
