            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.23.32",
            "verseOrgIds": [
              "EZK.23.32"
            ]
          }
        }
