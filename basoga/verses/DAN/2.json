          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.15",
            "verseOrgIds": [
              "DAN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Danieli yaaja okweghemba kyabazinga amughe ekiseera, asobole okumukobera amakulu ag'ekirooto ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.16",
            "verseOrgIds": [
              "DAN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yava eyo yairayo eka, yaakoberaku Hanania, Mishaeli, ni Azaria, ebibairegho. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.17",
            "verseOrgIds": [
              "DAN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaabakoba basabe Katonda ow'eigulu abasaasire ku bigema ku kyama ekyo, balobe kwitirwa ghalala n'abagezigezi ab'omu Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.18",
            "verseOrgIds": [
              "DAN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwire obwo Katonda yaayoleka Danieli ekyama ekyo mu kubonekerwa. Era Danieli oyo yaasaaka Katonda ow'eigulu, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.19",
            "verseOrgIds": [
              "DAN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng'akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.20",
            "verseOrgIds": [
              "DAN.2.20"
            ]
          }
        }
      ]
    },
