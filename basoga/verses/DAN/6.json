          "type": "text",
          "attrs": {
            "verseId": "DAN.6.22",
            "verseOrgIds": [
              "DAN.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
