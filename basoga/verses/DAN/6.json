          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emiraala gyeyongerenga okuba mu imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi kugha ekiragiro nti mu biketezo byonabyona ebiri mu bwakyabazinga bwange, abantu boonaboona batyenga Katonda wa Danieli, bamutengamu ekitiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
