            "number": "11",
            "style": "v",
            "sid": "DAN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nali nga nkaalingiriire, naawulira ng'akayiga kali kwogera eby'okwesuutasuuta. Naja okubona ng'ekisolo ekyokuna bakiise, omulambo gwakyo gwagheebwayo okwokebwa omuliro. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebisolo bire ebindi baabitoolaku obukumu bwabyo obw'okufuga, aye baabireka byasigala nga bikaali biramu okumala ekiseera ekigere.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
