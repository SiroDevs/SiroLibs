          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aripakishadi oyo ng'amaze okuzaala Shela yaaghangaala emyaka egindi bikumi bina n'esatu, era yaazaala n'abaana abandi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
