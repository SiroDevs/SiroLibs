            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano ni baidhukulu ba Shemu: Nga ghabiseegho emyaka ebiri bukyanga omwidhuzo gubaagho, Shemu yali agheza emyaka kikumi (100) egy'obukulu. Agho yaazaala Aripakishadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu ng'amaze okuzaala Aripakishadi, yaaghangaala emyaka egindi bikumi bitaanu (500), era yaazaala n'abaana abandi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
