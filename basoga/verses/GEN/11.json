        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera yatwala mutabane Aburamu, ni mwidhukulu we Loti, eyali mutabane wa Harani, era yaatwala ni mukaamwana Sarai, eyali muka Aburamu. Yaaja nabo, baava mu Uri ekiri mu nsi ey'Abakaladea, nga baja mu kiketezo eky'e Kanaani. Aye bwe baatuuka mu Harani, baasenga eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera yaafiira eyo ng'agheza emyaka bikumi bibiri n'etaanu (205) egy'obukulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
