              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yakobo yaayeta batabane be, yaakoba ati: “Mwidhe ghalala, mbakobere ebiribatuukaku ye bwidha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
