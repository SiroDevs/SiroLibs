              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
            "verseOrgIds": [
              "GEN.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu yaaba ni mukazi we kabiri, yaazaala omwana mulenzi. Yaamutuuma eriina Sethi, kuba yakoba ati: “Katonda ampaire omwana omulenzi aire mu kifo kya Abeli, Kaini ye yaita.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sethi yeena yaazaala omwana mulenzi, yaamutuuma eriina Enoshi. Mu biseera ebyo abantu mwe baasookera okusabanga Musengwa Katonda mu liina lye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.26",
            "verseOrgIds": [
              "GEN.4.26"
            ]
          }
        }
      ]
    }
  ],
