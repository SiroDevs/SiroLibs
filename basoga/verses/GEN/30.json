  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "GEN 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli bweyabona nga tazaalira Yakobo baana, yaagemerwa muganda we ensaalwa, yaakoba Yakobo ati: “Mpa abaana, oba ti n'ekyo ntuuse okufa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.1",
            "verseOrgIds": [
              "GEN.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaasungughalira Rakeli, yaakoba ati: “Ninze Katonda eyakwima okuzaala.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.2",
            "verseOrgIds": [
              "GEN.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.2",
            "verseOrgIds": [
              "GEN.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli yaakoba ati: “Omwiru wange omukazi Biliha wuuyo, ba naye asobole okunzaalira abaana olwo zeena mbe muzaire nga mbita mu oyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.3",
            "verseOrgIds": [
              "GEN.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale yaamugha omwiru we Biliha, abe mukazi we. Yakobo yaaba ni Biliha mu buliri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.4",
            "verseOrgIds": [
              "GEN.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biliha oyo yaatoola enda, yazaalira Yakobo omwana mulenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.5",
            "verseOrgIds": [
              "GEN.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli yaakoba ati: “Katonda asaze mu butuufu. Era awuliire okusaba kwange, yampa omwana mulenzi.” Kyeyava n'amutuuma eriina Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.6",
            "verseOrgIds": [
              "GEN.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biliha kabiri yaatoola enda, yaazaalira Yakobo omwana omulenzi owokubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.7",
            "verseOrgIds": [
              "GEN.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli yaakoba ati: “Ntuulaine inho ni muganda wange naamukuba ekigwo eky'amaani.” Kyeyava n'amweta eriina Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya bweyabona ng'akomye okuzaala, yaatoola omwiru we Zilipa, yaamugha Yakobo abe mukazi we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.9",
            "verseOrgIds": [
              "GEN.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilipa oyo yaazaalira Yakobo omwana mulenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.10",
            "verseOrgIds": [
              "GEN.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yaakoba ati: “Mbaire n'enkabi!” Kyeyava n'amutuuma eriina Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilipa yaazaalira Yakobo omwana omulenzi owokubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.12",
            "verseOrgIds": [
              "GEN.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yaakoba ati: “Ndi musangaavu, kuba abakazi baidha kundhetanga musangaavu.” Kyeyava n'amweta eriina Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biseera eby'amakungula g'engaano, Reubeni yaja mu nimiro yaazuulayo ebimera ebyetebwa mandurake,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.14",
            "verseOrgIds": [
              "GEN.30.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "30:14",
              "type": "text"
            },
            {
              "text": "Mandurake:",
              "type": "text"
            },
            {
              "text": "ebimera bino nga bidhuubirizibwa okuleetera omuntu atazaala, yaasobola okuzaala. Era nga bikozesebwa ng'obulezi obw'obwende.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaabireetera Leeya inhina. Agho Rakeli yaakoba Leeya ati: “Nkweghembye, mpa ku mandurake w'omwana wo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.14",
            "verseOrgIds": [
              "GEN.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yairamu ati: “Wamala okuntoolaku baze. Ekyo tikikumala? Mpegaano oyenda na kuntoolaku mandurake w'omwana wange.” Rakeli yaamukoba ati: “Bw'ompa mandurake w'omwana wo, Yakobo anaaba n'iwe obwire buno.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo bweyaira ng'ava mu nimiro eigulo eryo, Leeya yaafuluma yaaja y'ali yaakoba ati: “Oli n'okuba ninze obwire buno, kuba mpaireyo mandurake w'omwana wange okukugula.” Kale yaaba naye obwire obwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.16",
            "verseOrgIds": [
              "GEN.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda yaawulira okusaba kwa Leeya. Leeya yaatoola enda, yaazaalira Yakobo omwana mulenzi owokutaanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.17",
            "verseOrgIds": [
              "GEN.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yaakoba ati: “Katonda ampaire empeera yange, kuba nagha baze omwiru wange omukazi.” Kyeyava n'amutuuma eriina Issakari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.18",
            "verseOrgIds": [
              "GEN.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yaatoola enda kabiri, yazaalira Yakobo omwana omulenzi owomukaaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.19",
            "verseOrgIds": [
              "GEN.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leeya yaakoba ati: “Katonda ampaire ekirabo ekirungi. Mpegaano baze aidha kuntaamu ekitiisa, kuba mmuzaaliire abaana abalenzi mukaaga.” Kyeyava n'amweta eriina Zebuluni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.20",
            "verseOrgIds": [
              "GEN.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olumaliira yaazaala omwana omughala, yaamutuuma eriina Dina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Katonda yaidhukira Rakeli, yaawulira okusaba kwe, yaamugha okuzaala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
              "GEN.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli yaatoola enda, yaazaala omwana mulenzi. Yaakoba ati: “Katonda antoireku okuvumwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamutuuma eriina Yosefu ng'akoba ati: “Musengwa Katonda agwananga yaanhongera omwana omulenzi owundi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakeli ng'amaze okuzaala Yosefu, Yakobo yaakoba Labani ati: “Nsiibula ndhireyo eka mu nsi ey'ewaife. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.25",
            "verseOrgIds": [
              "GEN.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpa abakazi bange n'abaana bange, be nakolereranga okufuna, bwenalinga nga nkugheereza. Ondeke nje kuba oidhi nga bwe nakugheereza obukalamu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani yaamukoba ati: “Nganha nkukobere nti naja naalagulwa, bankobera bati Musengwa Katonda yampa enkabi olwa iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.27",
            "verseOrgIds": [
              "GEN.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nsalira empeera y'oyenda, ndidha kugikugha.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaakoba ati: “Iwe mwene oidhi bwe mbairenga nga nkugheereza, era n'ebyayo byo nga bwe bibairenga nga byeyongera nga nze mbirabirira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.29",
            "verseOrgIds": [
              "GEN.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba wali na bitono nga nkaali kwidha, aye mpegaano byeyongeire inho, era Musengwa Katonda yakugha enkabi ku lwange. Aye olwo mpegaano nze ndifuna li zeena eby'amaka agange.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.30",
            "verseOrgIds": [
              "GEN.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani yaabuuza ati: “Kiki kye mbe nkughe?” Yakobo yairamu ati: “Ozira ky'oidha kumpa. Aye ndidha kwongera okulabirira ebyayo byo, bw'onaaganha kino kye nja okukoba: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mbite mu byayo byo byonabyona olwaleero, nje nga ntoolamu buli ntaama na buli mbuzi ya bitanga n'ey'obudholodhondho, na buli ntaama nto endhirugavu. Edho n'edhinaaba empeera yange. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.32",
            "verseOrgIds": [
              "GEN.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olumaliira olimanha nga mbaire wa mazima. Bw'oliidha okwekebeedha empeera yange, n'oyagaanamu embuzi etali ya bitanga oba ya budholodhondho, n'entaama etali ndhirugavu, eyo eribalibwa nga ndhibe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani yaakoba ati: “Kale ndhikiriiza tukole nga bw'okobye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.34",
            "verseOrgIds": [
              "GEN.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ku lunaku olwo, Labani yatoolamu embuzi enume edh'emyalaala n'edha bitanga, n'embuzi enkazi dhoonadhoona edhaali edh'ebitanga n'obudholodhondho, na kiisi eriku kimyamya kyeru, era n'entaama dhoonadhoona endhirugavu, yaadhigemya batabane be okudhirabirira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.35",
            "verseOrgIds": [
              "GEN.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaja nadho ghalala nabo, obuleeyi bwa lugendo lwa nnaku isatu okuva ku Yakobo. Yakobo yaalabirira ebyayo bya Labani ebyasigalagho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaatoola ensaga embisi edh'emiti gino: omupopulari, omwalumondi era n'omupulane. Yaadhisisibulaku ebiwutu ebindi, dhaabaamu emyalaala emyeru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensaga edho dh'asisibwire, yaadhisimba emberi w'ensolo aghali ebintu ensolo mwe dhinhwera, kuba ensolo dhaaghakanga nga dhiidhye okunhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ensolo bwe dhaaghakanga nga dhiringiriire ensaga edho, nga dhizaala obwana obulimu emyalaala n'obulimu ebitanga, n'obulimu obudholodhondho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaayawula entaama ku mbuzi, yaadhiringiriza ensolo edh'emyalaala n'endhirugavu dhoonadhoona edh'omu lugo lwa Labani. Mu nsambo eyo yazaalagania ebyayo bye, era yaaloba kubiyimba na bya Labani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensolo edh'amaani bwe dhaabanga nga dhiri kughaka, nga Yakobo ata ensaga mu bintu ensolo mwe dhinhwera emberi ghaadho, dhisobole okughakira aghali ensaga edho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ensolo enafu bwe dhaabanga nga n'edhiri kughaka, nga tataayo nsaga. Kale ensolo enafu edhaazaalibwanga dhaabanga dha Labani, ate edh'amaani dhaabanga dha Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nsambo eyo Yakobo yaafuuka mukombe inho, yaaba n'ebyayo kamaala, n'abairu abakazi n'abasaadha, n'engamiya era n'endogoyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
      ]
    }
