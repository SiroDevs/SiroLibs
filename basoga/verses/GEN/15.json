          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endhuba bweyamala okugwa enzikiiza ng'egemye, mangu ago agho ghaabonekagho olugyo oluliku amanda nga gali kunioka omwosi, era ghaabonekagho n'engada edhiri kwaka; bino byombi byabita ghagati gh'ebitundu bire eby'ensolo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo, Musengwa Katonda yaakola endagaano ni Aburamu. Yaakoba ati: “Baidhukulu bo mbaghaire ensi eno yoonayoona okuva ku nsalosalo ya Misiri okutuuka ku mwiga omukologho Eufurate.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.18",
            "verseOrgIds": [
              "GEN.15.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
