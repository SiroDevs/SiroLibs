            "number": "5",
            "style": "v",
            "sid": "GEN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaamufulumya kuliya, yaakoba ati: “Lingirira ku igulu, obale emuunienie edhiriku, oba nga osobola okudhibala.” Agho yaamukoba ati: “N'abaidhukulu bo batyo bwe baliba obungi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.5",
            "verseOrgIds": [
              "GEN.15.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
