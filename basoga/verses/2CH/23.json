      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye mu mwaka ogwomusanvu, Yehoiada kabona yaaguma, yeekobaana n'abaduumizi b'abaisirukale, bano: Azaria mutabane wa Yerohamu, ni Ishimaeli mutabane wa Yehohanani, ni Azaria owundi mutabane wa Obedi, ni Maaseia mutabane wa Adaia, ni Elishafati mutabane wa Zikuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaja nga babitabita mu bibuga byonabyona eby'omu Buyudaaya, baatoolayo Abalevi, n'abakulira enda dha balata b'abantu Abaisiraeli, baidha nabo e Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
