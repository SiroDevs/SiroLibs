              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu ab'omu Buyudaaya baalonda Yehoahazi mutabane wa Yosia, baamufuula kyabazinga mu kifo kya lata we oyo mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.1",
            "verseOrgIds": [
              "2CH.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi yali agheza emyaka amakumi abiri n'esatu egy'obukulu ghe yafuukira kyabazinga wa Buyudaaya. Era yaafugira entangama ya myezi esatu mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Neko owa Misiri yaamutoola ku bwakyabazinga mu Yerusalemu, era yaaleetera Buyudaaya okughanga omusolo gwa talanta kikumi edha feeza ni talanta ndala eya zaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.11+JER.22.12"
              },
              "items": [
                {
                  "text": "Yer 22:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kyabazinga Neko oyo yaatoola Eliakimu muganda wa Yehoahazi, yaamufuula kyabazinga wa Buyudaaya ni Yerusalemu. Era yaakyusa n'eriina lya Eliakimu, yaamutuuma Yehoiakimu. Yaagema Yehoahazi muganda wa Yehoiakimu oyo, yaamutwala e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
