        },
        {
          "text": "Zedekia yali agheza emyaka abiri na mulala egy'obukulu ghe yafuukira kyabazinga. Era yaafugira entangama ya myaka ikumi na mulala mu Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakolanga ebibi ebitaasiimya Musengwa Katonda we. Yaaloba n'okugondera Yeremia omulanzi, ng'aidhie okumukobera Musengwa Katonda oyo bye yamutuma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        }
