              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwasooka ogwa kyabazinga Kuro okufuga Perusia, Musengwa Katonda yatuukiriza ekyo kye yayogera ng'abita mu Yeremia omulanzi. Musengwa Katonda oyo yaleetera kyabazinga Kuro oyo okulangirira ekiragiro mu bwakyabazinga bwe bwonabwona, era yaakita mu bughandiike ati: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.22",
            "verseOrgIds": [
              "2CH.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.28"
              },
              "items": [
                {
                  "text": "Isa 44:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kyabazinga Kuro ow'e Perusia akoba ati: Musengwa Katonda, Katonda ow'eigulu, yampa obwakyabazinga bwonabwona obw'oku nsi, era ampaire obuvunaanizibwa okumuzimbira eisinzizo e Yerusalemu ekiri mu Buyudaaya. Kale ni buli muntu ku imwe abantu be, aje eyo. Nsaba Musengwa Katonda oyo abe n'imwe mwenamwena abantu be.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.23",
            "verseOrgIds": [
              "2CH.36.23"
            ]
          }
        }
      ]
