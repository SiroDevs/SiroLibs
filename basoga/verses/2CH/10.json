          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.11",
            "verseOrgIds": [
              "2CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nga ghabiseegho enaku isatu, Yeroboamu n'abantu boonaboona baidha ye kyabazinga Rehoboamu nga bwe yabakoba, ati: “Muliira ye ndi nga ghabiseegho enaku isatu.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.12",
            "verseOrgIds": [
              "2CH.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga yaabairamu na bukambwe, kuba yaava ku magezi abantu abakulu ge baamugha, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.13",
            "verseOrgIds": [
              "2CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaajiira ku g'abaisuka ge baamugha, ng'akoba ati: “Oba nga lata wange yabataaku ekikoligo ekizito, nze ndidha kukyongeraku obuzito. Era oba nga lata wange yabakangaivulanga ng'abakubisa enkoba edhabuliidho, nze ndidha kubakangaivulanga nga mbakubisa enkoba edhiriku obusuna!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.14",
            "verseOrgIds": [
              "2CH.10.14"
            ]
          }
        }
      ]
    },
