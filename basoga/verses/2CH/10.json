              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bwe baabona nga kyabazinga tabawuliriisa, baamwiramu bati:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.10.16",
            "verseOrgIds": [
