          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo yaaloba ati: “Tiidha kulya.” Aye abagheereza be ghalala n'omukazi oyo, baamwikirizisa yaagondera bye baamukoba. Kale yaasituka yaava ku itaka ghansi ghe yali, yaatyama ku buliri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukazi yaligho agho n'ente entototo ye baapiita ensavu mu ndhu. Agho yaayangughaku okugiita, yaatoola engaano yaagikanda, yagifumbamu emigaati egitazimbulukusiibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.24",
            "verseOrgIds": [
              "1SA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaabireetera Saulo n'abagheereza be, baalya. Bwe baamala baasituka baagolola obwire obwo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.25",
            "verseOrgIds": [
              "1SA.28.25"
            ]
          }
        }
      ]
    }
