            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orunani yaakoba kyabazinga ati: “Isebantu kyabazinga, ekifo kitwale okikozese kyonakyona ky'oyenda. N'ente dhiidho ndhikughaire dhibe ekigheebwayo ekyokebwa, n'ekiti ekibairenga kikozesebwa okumulungula engaano kiikyo kikozese ng'enku, ate engaano ebe ekigheebwayo eky'emere ey'empeke.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.23",
            "verseOrgIds": [
              "1CH.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
