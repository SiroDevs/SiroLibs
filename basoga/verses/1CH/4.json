          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hodia yaabayiza mwanhina Nahamu. Batabane ba muka Hodia oyo, baasimukamu Keila ow'e Garumi ni Eshitemoa ow'e Maakathi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.19",
            "verseOrgIds": [
              "1CH.4.19"
            ]
          }
        }
      ]
    },
