            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.40",
            "verseOrgIds": [
              "1CH.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biseera kyabazinga Hezekia bye yafugiramu Buyudaaya, abo beene maina agoogeirwaku baalumba ekiketezo ekyo, baazikiriza weema dh'abatyamye baayo, baazikiriza n'Abameuni be baayagaanayo. Beene baasenga mu kifo kyaibwe ni ye buli eno, kuba ghaaligho eisubi ery'okwayiramu ebyayo byaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.41",
            "verseOrgIds": [
              "1CH.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebikumi bitaanu ku abo baaja ku lusozi Seiri, nga bakulembeirwamu batabane ba Ishi bano: Pelatia, Nearia, Refaia, ni Uzzieli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.42",
            "verseOrgIds": [
              "1CH.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyo baitirayo Abamaleki abaali bawoniegho nga balumukiireyo, beene baasengayo ni ye buli eno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
      ]
    }
