          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ng'ali ghalala n'abaakuliranga eby'okusinza, baalonda ab'oku nda edh'Abalevi dhino okulangiriranga obukwenda bwa Musengwa Katonda nga bemba enhembo bwe bakubiraku endingidi, entongooli, n'ebide: ab'oku nda ya Asafu, n'ab'oku ya Hemani, n'ab'oku ya Yeduthuni. Luno n'olukalala olw'abo be baalonda okukola omulimo ogwo nga bajiira ku mirimo gye baali baja okukolanga: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bantu abaasimuka mu Asafu, baalondamu bano: Zakkuri, Yosefu, Nethania, ni Asharela. Asafu n'eyakulemberanga batabane be abo, baalangiriranga obukwenda bwa Musengwa Katonda, nga kyabazinga bwe yabalagiranga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bantu abaasimuka mu Yeduthuni, baalondamu batabane ba Yeduthuni oyo omukaaga bano: Gedalia, Zeri, Yeshaia, Shimei, Hashabia, ni Mattithia. Iseibwe oyo Yeduthuni n'eyakulemberanga, baalangiriranga obukwenda bwa Musengwa Katonda, nga bemba enhembo edh'okumwebaza n'okumusaaka nga bwe bakubiraku endingidi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 25:3"
          },
          "items": [
            {
