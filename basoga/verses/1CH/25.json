          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boonaboona aghalala ni Balevi banaibwe abaatendekebwa ni baba abakugu mu by'okwembera Musengwa Katonda, baali ebikumi bibiri na kinaana na munaana (288).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
          }
        }
      ]
