          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonaboona abo baabakubiranga bululu okubalonda okubagha emirimo, k'abe omukulu oba omuto, omukugu oba omwega.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.8",
            "verseOrgIds": [
              "1CH.25.8"
            ]
          }
        }
