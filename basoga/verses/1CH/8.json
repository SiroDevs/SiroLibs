          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano n'abaasimuka mu Ehudi, abaakuliranga enda dha badhaadha b'abantu b'e Geba abaatwalibwa mu bunhage e Manahathi: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.6",
            "verseOrgIds": [
              "1CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naamani, ni Ahiya, ni Gera eyabatwala mu bunhage era nga n'eyali lata wa Uzza ni Ahihudi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.7",
            "verseOrgIds": [
              "1CH.8.7"
            ]
          }
        }
      ]
    },
