              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo n'abaali abakulu b'enda dha baiseibwe, ng'ense dhaibwe bwe dhaajanga nga dhiiraganwaku. Era baabanga mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
