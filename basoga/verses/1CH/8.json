              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neri yazaala Kishi, Kishi yaazaala Saulo, Saulo yaazaala Yonathani, ni Malakishua, ni Abinadabu, ni Eshibaali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.33",
            "verseOrgIds": [
              "1CH.8.33"
            ]
          }
