          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaizaaku Noha, ate yaizaaku Rafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.2",
            "verseOrgIds": [
              "1CH.8.2"
