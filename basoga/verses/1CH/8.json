          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esheki muganda wa Azeli oyo yaazaala abaana bano: Ulamu nga n'omuberi, yaizaaku Yeushi, ate yaizaaku Elifeleti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
            "verseOrgIds": [
              "1CH.8.39"
            ]
          }
        }
