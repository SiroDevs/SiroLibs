              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beria ni Shema n'abaali abakulu b'enda dha badhaadha b'abantu ab'e Aiyaloni, abaaja e Gathi ni babingayo abatyamye baayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.13",
            "verseOrgIds": [
