          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moza yazaala Binea, Binea yaazaala Rafa, Rafa yaazaala Eleasa, Eleasa yaazaala Azeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
