          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi yaazaala Yehoadda, Yehoadda yaazaala Alemethi, ni Azimavethi, ni Zimuri. Zimuri yaazaala Moza, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
