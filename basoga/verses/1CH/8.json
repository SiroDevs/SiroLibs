          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elipaali yazaala Eberi, ni Mishamu, ni Shemedi. Shemedi oyo n'eyazimba ebibuga, Ono ni Lodi, era n'obubuga obubyezungulwire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.12",
            "verseOrgIds": [
              "1CH.8.12"
            ]
          }
        }
      ]
    },
