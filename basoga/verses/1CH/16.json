            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Agho abantu baagolola, buli muntu ewuwe. Ni Daudi yeena yairayo eka okuba n'ab'omu ndhu ye.",
          "type": "text",
          "attrs": {
