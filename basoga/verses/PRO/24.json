    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oteegombanga bakozi ba bibi naire, era otagezanga kubafuula bakagwa bo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu myoyo gyaibwe bayiiya kukola bya bukambwe era bye boogera bireeta kutabulatabula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endhu ezimbwa na magezi, era yaaguma bweghabaagho okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumanha kwidhuza ebisenge byayo ebintu eby'omughendo era ebirungi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu omugezi awula ole ow'amaani era ali n'okumanha awula ow'obuyinza. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba okulwana olutalo osooka kwebuuza ku magezi era aghali abawi ab'amagezi kamaala ghabaagho okughangula.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi gaswikiriire inho okutegeera okw'omusiru, era azira ky'ayogera nga bali mu kifo eky'olwekobaano.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ategeka okukola akabi buli kiseera, balimweta, “mwene kubidooma”. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.8",
            "verseOrgIds": [
              "PRO.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusiru by'ategeka okukola byonabyona, bivaamu bibi byereere, era abantu bakyayira irala omuntu omunhoomi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.9",
            "verseOrgIds": [
              "PRO.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'owaamu amaani mu kiseera ekizibu, oba oli munafu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.10",
            "verseOrgIds": [
              "PRO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owonianga abantu be bali kutwala okwita, era waaloberanga abantu okubaghaluudhania, okuja okubatirimbula. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.11",
            "verseOrgIds": [
              "PRO.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osobola okwewuuguusa oti: “Bona eno, ekyo nze tikimanhangaku naire.” Aye Katonda abona ebigendererwa eby'omuntu era yaabimanha. Oyo n'akuuma obulamu bwo, era abona buli kintu. Era aja kusasula buli muntu, ng'ajiira ku bikolwa bye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.12",
            "verseOrgIds": [
              "PRO.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wange, lyanga ku mudheenene ogw'endhuki, kuba mulungi. Nga bwe gudhuudhuula ku lulimi lwo, nga guva mu bisasala byagwo, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.13",
            "verseOrgIds": [
              "PRO.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "manha oti n'amagezi goona gatyo bwe gali amalungi y'oli. Bw'ogafuna, obulamu bwo obw'omu maiso, bwidha kubanga bukalamu, n'ebyo by'osuubira birobenga kukufa busa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.14",
            "verseOrgIds": [
              "PRO.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otabanga ng'ababi abeeteega amaka ag'abatuufu, era ni bagalumba okugakolaku eby'obukambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.15",
            "verseOrgIds": [
              "PRO.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakola ebituufu ni bwe bagwa emikuzi kamaala gitya, bamala baasituka aye abakozi b'ebibi bazikirira buzikirire ng'akabi kabaidhiire.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.16",
            "verseOrgIds": [
              "PRO.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otasagambanga ng'omuzigu wo agwire waire okusanhuka ng'agangaliime. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.17",
            "verseOrgIds": [
              "PRO.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda aidha kukibona anakughale, era alekere agho okusungughalira ole.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.18",
            "verseOrgIds": [
              "PRO.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otafangayo ku abo abakola ebibi, era oteesiimisanga babi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.19",
            "verseOrgIds": [
              "PRO.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubi azira ky'asuubira mu biseera bya mu maiso, era aja kuzikira ng'oti ntaala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.20",
            "verseOrgIds": [
              "PRO.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wange otyanga Musengwa Katonda ni kyabazinga, era otabadheemeranga. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akabi Musengwa Katonda ni kyabazinga ke balisindika, kaja kukugwaku bugwe. Era ghazira aidhi kuzikirira okuliva mu kabi ako ghe kulyaga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
