            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naasaba nti: “Wo Katonda wange, oteerabiranga ngeri ye boonoinemu obwakabona, ni basuula n'ere endagaano ye baakola ey'obwakabona n'Obulevi.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
