              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale, naatukuza abantu okubatoolaku byonabyona eby'abamaghanga agandi. Naasengeka bukalamu emirimo gya bakabona n'Abalevi. Buli muntu yaamanha omulimo gwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era naakola entegeka abantu okuleetanga enku mu biseera ebituufu, edh'okwokya ebigheebwayo ku alutaari. Era n'okuleetanga ebigheebwayo byaibwe eby'ebirime ebisooka okukungulwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naasaba nti: “Wo Katonda wange, oteerabiranga ebyo bye nkoze. Nkweghemba ompenga ebirungi.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
