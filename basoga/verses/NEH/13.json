                "loc": "EXO.34.11+EXO.34.12+EXO.34.13+EXO.34.14+EXO.34.15+EXO.34.16"
              },
              "items": [
                {
                  "text": "Kuv 34:11-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.1+DEU.7.2+DEU.7.3+DEU.7.4+DEU.7.5"
              },
              "items": [
                {
                  "text": "Ma 7:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.23",
            "verseOrgIds": [
              "NEH.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga buli mwana omulala ku baana baibwe ababiri, ayogera lulimi Olushidodi oba olulimi olundi, aye nga tibaidhi Luyudaaya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.24",
            "verseOrgIds": [
              "NEH.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naavumirira inho abasaadha abo, era naabakolimira. Ate abandi naabakuba, era naabakuunhuula n'enviiri. Naabalayiza mu liina lya Katonda nti: “Mutafumbirwagananga nabo, nga mughaayo baghala baimwe okubayira batabane baibwe, oba okutoola baghala baibwe okubayira batabane baimwe, oba okubayira imwe beene.” ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.25",
            "verseOrgIds": [
              "NEH.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabakoba nti: “Timwidhi nga Solomoni kyabazinga wa Isiraeli, abakazi ng'oti n'abo n'abaamuleetera okwonoona? Mu maghanga goonagoona tiyabaayooku kyabazinga eyali ng'oti ni ye, era Katonda we yamwenda inho yaamufuula kyabazinga wa Isiraeli yoonayoona. Aye ate abakazi abamaghanga agandi baamuleetera yeena okwonoona.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.24+2SA.12.25"
              },
              "items": [
                {
                  "text": "2 Sam 12:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.1+1KI.11.2+1KI.11.3+1KI.11.4+1KI.11.5+1KI.11.6+1KI.11.7+1KI.11.8"
              },
              "items": [
                {
                  "text": "1 Bakyab 11:1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.26",
            "verseOrgIds": [
              "NEH.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwo twenatwena tujiire ku kibi ekitakobeka imwe kye mwakola, tughemukire Katonda waife nga tubayiza abakazi okuva mu maghanga agandi?”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.27",
            "verseOrgIds": [
              "NEH.13.27"
            ]
          }
        }
      ]
