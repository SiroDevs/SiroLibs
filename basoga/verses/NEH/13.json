          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owundi ku batabane ba Yehoiada mutabane wa Eliashibu eyali Omukulu wa Bakabona, yali yabayiza mughala wa Saniballati Omuhoroni. Kale naamubinga mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
