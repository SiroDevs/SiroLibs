            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "NEH 7:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaligho n'abandi abaali abaana ba bakabona, nga ni bano: Ab'oku nda ya Habaia, n'ab'oku ya Hakkozi, n'ab'oku ya Barazillai, ye baatuuma eriina eryo olw'okuba yafumbirwa owundi ku baghala ba Barazillai Omugileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.63",
            "verseOrgIds": [
              "NEH.7.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "NEH 7:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo baabanoonia mu nkalala dh'obuzaale aye nga tibabonekamu, kale baabalekeza okukola nga bakabona, nga batwalibwa ng'abatali balongoofu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.64",
            "verseOrgIds": [
              "NEH.7.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "NEH 7:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyali omufuzi mu kiseera ekyo yaabalobera okulyanga ku bigheebwayo eri Katonda okutuusa nga ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.65",
            "verseOrgIds": [
              "NEH.7.65"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Kuv 28:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.33.8"
              },
              "items": [
                {
                  "text": "Ma 33:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bafunie kabona aghanga okwebuuza ku Musengwa Katonda ng'akozesa Urimu ni Thummimu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.65",
            "verseOrgIds": [
              "NEH.7.65"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:65",
              "type": "text"
            },
            {
              "text": "Urimu ni Thummimu:",
              "type": "text"
            },
            {
              "text": "Ebintu bino byombi byateebwanga mu kivaalo eky'omu kifuba kabona kye yavaalanga, era nga bikozesebwa kabona oyo mu kuzuula Katonda ky'ayenda.",
              "type": "text"
            }
          ]
        }
      ]
    },
