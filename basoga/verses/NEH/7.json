            "number": "6",
            "style": "v",
            "sid": "NEH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gano n'amaina ag'abantu ab'omu kiketezo eky'e Buyudaaya abaira nga bava e Babilonia mu bunhage, kyabazinga waayo Nebukadinezzari ye yali abatwaire nga basibe. Abantu abo baira e Yerusalemu n'e Buyudaaya, buli muntu ng'airayo mu kibuga eky'ewaibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.6",
            "verseOrgIds": [
              "NEH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze baibwe baali bano: Zerubbabeli, Yeshua, Nehemia, Azaria, Raamia, Nahamani, Morodekai, Bilishani, Misiperethi, Bigivai, Nehumu, ni Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.7",
            "verseOrgIds": [
              "NEH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
