          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baira n'abembi abasaadha n'abakazi ebikumi bibiri n'ana na bataanu (245). ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.67",
