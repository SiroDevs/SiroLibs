            "number": "61",
            "style": "v",
            "sid": "NEH 7:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu baira okuva mu bunhage mwalimu abaava e Telimela, n'e Teliharisha, n'e Kerubu, n'e Addoni, n'e Immeri aye ng'abantu abo tibeekakasa nda dha baiseibwe dhe baavaaku, waire okukakasa nga Baisiraeli beenebeene. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.61",
            "verseOrgIds": [
              "NEH.7.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "NEH 7:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo ni bano: Ab'oku nda ya Delaia, n'ab'oku ya Tobia, n'ab'oku ya Nekoda. Abo boonaboona aghalala baali lukaaga n'ana na babiri (642).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.62",
            "verseOrgIds": [
              "NEH.7.62"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
