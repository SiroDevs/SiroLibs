          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagheereza b'omu isinzizo n'abagheereza aba Solomoni boonaboona aghalala baali ebikumi bisatu na kyenda na babiri (392).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.60",
            "verseOrgIds": [
              "NEH.7.60"
            ]
          }
        }
      ]
