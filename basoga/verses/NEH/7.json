          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagheereza b'omu isinzizo baali,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.46",
            "verseOrgIds": [
              "NEH.7.46"
            ]
          }
        }
      ]
