          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuumi b'emiryango gy'eisinzizo baali, ba ku nda ya Shallumu, n'ab'oku ya Ateri, n'ab'oku ya Talumoni, n'ab'oku ya Akkubu, n'ab'oku ya Hatita, n'ab'oku ya Shobai boonaboona aghalala baaba kikumi n'asatu na munaana (138). ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.45",
            "verseOrgIds": [
              "NEH.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
