          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baira n'embalaasi dhaibwe lusanvu n'asatu na mukaaga (736), n'enhumbu ebikumi bibiri n'ana na itaanu (245), ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.68",
            "verseOrgIds": [
              "NEH.7.68"
            ]
          }
