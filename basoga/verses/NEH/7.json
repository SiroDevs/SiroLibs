          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guno n'omughendo ogw'Abaisiraeli abaira okuva mu bunhage:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.7",
            "verseOrgIds": [
              "NEH.7.7"
