              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga Solomoni yaazimba olugololiro olw'amaato mu Ezionigeberi ekiriiraine Elothi, ku mbali kw'Enhandha Emyufu, mu nsi Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
        {
