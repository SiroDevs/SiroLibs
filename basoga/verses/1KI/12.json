          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale atyo kyabazinga yaaloba kuwulirisa bantu. Musengwa Katonda n'eyaleetera ebintu okuja bityo, olwo atuukirize kye yakoba Yeroboamu mutabane wa Nebati ng'abita mu Ahiya ow'e Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        }
