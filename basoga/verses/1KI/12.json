          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaataagho ekibinuko, kibengagho mu mwezi ogwomunaana, ku lunaku olweikumi n'eitaanu, nga kye baabanga nakyo mu Buyudaaya. Yaaja ku alutaari e Betheli yaaghaayo emisengo y'ebifaananie eby'ente ento bye yakola, era yaataagho bakabona abaagheerezanga mu masabo ge yazimba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olweikumi n'eitaanu olw'omwezi ogwomunaana, omwezi mwene gwe yalonda ku lulwe, yaaja ku alutaari ye yazimba e Betheli. Yaateeragho Abaisiraeli ekibinuko, yaaja ku alutaari yaaniokeza obubbaani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
