            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.11",
            "verseOrgIds": [
              "1KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nga ghabiseegho enaku isatu, Yeroboamu n'abantu boonaboona baidha ye kyabazinga Rehoboamu nga bwe yabakoba, ati: “Muliira ye ndi nga ghabiseegho enaku isatu.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.12",
            "verseOrgIds": [
              "1KI.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.12",
            "verseOrgIds": [
              "1KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho kyabazinga yaabairamu na bukambwe, kuba yava ku magezi abantu abakulu ge baamugha, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.13",
            "verseOrgIds": [
              "1KI.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaajiira ku g'abaisuka ge baamugha, ng'akoba ati: “Oba nga lata wange yabakaluubiriza ekibitiriire, nze ndidha kwongera bwongere okubakaluubiriza einho. Era oba nga lata wange yabakangaivulanga ng'abakubisa enkoba edhabuliidho, nze ndidha kubakangaivulanga nga mbakubisa enkoba edhiriku obusuna!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.14",
            "verseOrgIds": [
              "1KI.12.14"
            ]
          }
        }
      ]
    },
    {
