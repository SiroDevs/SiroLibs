          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.19",
            "verseOrgIds": [
              "1KI.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu ab'omu Isiraeli yoonayoona, bwe baawulira nga Yeroboamu aize okuva e Misiri, baamwetesa okwidha ghe baali beesololeiza, era baamufuula kyabazinga wa Isiraeli yoonayoona. Ekika kya Yuda kyonka n'ekyasigala nga kikaafugibwa ab'endhu ya Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.20",
            "verseOrgIds": [
              "1KI.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
