            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaia mutabane wa Yehoiada yairamu ati: “Amiina. Era, musengwa wange kyabazinga, neeghemba Musengwa Katonda wo akikakase. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga Musengwa Katonda bw'abairenga n'iwe, Isebantu kyabazinga, era atyo bw'abe abenga ni Solomoni, era aleetere obufuzi bwe okuba obukologho einho okusinga obubwo.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Zadoki kabona, ni Nathani omulanzi, ni Benaia mutabane wa Yehoiada, ni bale abaakuumanga kyabazinga Abakerethi n'Abapelethi, baatyamya Solomoni ku nhumbu ya kyabazinga Daudi, yaagivuga era baaja naye e Gihoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bali eyo, Zadoki kabona yaaja mu Weema ey'Okwagaananirangamu ni Musengwa Katonda, yaatoolayo eiyiga ery'ensolo lye baatangamu omuzigo, yaatoolamu omuzigo, yaagusiiga Solomoni. Olwo baafuuwa eigwala, era abantu boonaboona baakoba bati: “Ghangaala kyabazinga Solomoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu boonaboona baaja nga bamunonereza nga bafuuwa endere, era nga basagambya n'eisanhu lingi inho, n'eitaka kumpi lyeyatiseemu olw'okuwowoigana kwaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya n'abageni be boonaboona be yali nabo, baali nga bali kumaliriza ekibinuko kyaibwe, baawulira okuwowoigana okwo. Era Yoabu bwe yawulira okuvuga kw'eigwala, yaabuuza ati: “Okwasiikana okwo kwonakwona mu kibuga kutegeeza ki?” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali akaayogera, yaja okubona, nga Yonathani mutabane wa Abiathari kabona, aidha. Adoniya yaakoba Yonathani oyo, ati: “Ingira, kuba oli musaadha mukalamu, era n'amawulire g'oleese malungi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonathani yaira mu Adoniya ati: “Busa naire, kuba musengwa waife kyabazinga Daudi atairegho Solomoni okuba kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era atumye Zadoki kabona, ni Nathani omulanzi, ni Benaia mutabane wa Yehoiada, ni bale abaakuumanga kyabazinga Abakerethi n'Abapelethi, baaja baatyamya Solomoni ku nhumbu ya kyabazinga, era yaagivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Zadoki kabona ni Nathani omulanzi, bamusiize omuzigo e Gihoni, abe kyabazinga, era baavaayo baaja mu kibuga nga basagamba, olwo ekibuga kyabaamu okuwowoigana. Kale ni okwo n'okwasiikana kwe muwuliire. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni buti ni kyabazinga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate ekindi, abakungu ba kyabazinga baidhie okweisuusa musengwa waife kyabazinga Daudi, baakoba bati, ‘Tweghemba Katonda wo afuule Solomoni okuba omumanhifu okusinga iwe bw'obaire, era afuule obwakyabazinga bwa Solomoni oyo bube bukologho inho okusinga obubwo bwe bubaire.’ Agho kyabazinga Daudi yeebaliza ku buliri bwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "era yasaaka Katonda ati, ‘Musengwa Katonda, Katonda wa Isiraeli asaakibwe, oyo aghaire omulala ku b'omusaayi gwange okutyama ku kityamo kyange eky'obwakyabazinga, era n'anganha okuba omulamu ni mbona ku ekyo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abageni ba Adoniya baadhugumira era baasituka, buli muntu yaagema engira yiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
