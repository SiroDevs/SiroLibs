          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
