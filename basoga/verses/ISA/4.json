            "number": "1",
            "style": "v",
            "sid": "ISA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, abakazi musanvu balyegema omusaadha mulala baamwesibaku, nga bakoba bati: “Ife tuneeyagaliranga beene eky'okulya n'eky'okuvaala. Aye mala gaikiriza twetebwenga bakazi bo, otuwonie okuswalanga olw'obutafumbirwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.1",
            "verseOrgIds": [
              "ISA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunaku olwo bwe lulituuka, Musengwa Katonda alireetera ebimera byonabyona n'emiti okuboneka obulungi era nga bya kitiisa. N'ebibala eitaka bye liribaza biriba bikalamu, byawoomera inho abo abaliba bawoniegho mu Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.2",
            "verseOrgIds": [
              "ISA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi muntu yeenayeena aliba ng'asigairegho mu Sioni, ng'alondeibwa okusigala nga mulamu mu Yerusalemu, alyetebwa mutukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.3",
            "verseOrgIds": [
              "ISA.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda aliba ng'amaze okukozesa obuyinza bwe okusalira omusango abantu b'omu Yerusalemu, n'okubanaazaaku ebibi byaibwe, n'okutoola ku Yerusalemu omusango ogw'obutemo bwe baakikoleramu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.4",
            "verseOrgIds": [
              "ISA.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda omusana alitaagho ekire ku Lusozi Sioni ni ku boonaboona abaliba balwesololeizaaku. Ate obwire yaataagho omwosi n'okwaka okw'enimi edh'omuliro. Ekitiisa kya Katonda oyo kirimaamira ekibuga kyonakyona, kyakikuuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.4.5",
            "verseOrgIds": [
              "ISA.4.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
