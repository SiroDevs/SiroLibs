              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musengwa Katonda alizikiriza okufa kwasaaniragho irala ebyanda n'ebyanda. Alyeya abantu be boonaboona amaziga, yaatoolagho n'okuswazibwa kwe baali nakwo mu nsi yoonayoona. Musengwa Katonda oyo mwene n'ayogeire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
