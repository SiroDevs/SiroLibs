        },
        {
          "text": " Musengwa Katonda alikuuma olusozi luno Sioni, aye Abamoabu balityankirirwa ng'oti n'eisubi bwe balityankirira mu busa okukolamu ebigimusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
