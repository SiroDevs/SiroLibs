              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda alireetera Abaisiraeli okuwona obulumi n'okudaazibwadaazibwa, n'emirimo egy'olukako gye baabakozesanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
            "verseOrgIds": [
              "ISA.14.3"
            ]
          }
        },
        {
