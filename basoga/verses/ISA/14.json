              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda bw'alituukiriza ekyo, Abaisiraeli baliyeeyereza kyabazinga w'e Babilonia, nga bakoba bati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.4",
