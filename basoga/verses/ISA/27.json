              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo, Musengwa Katonda alikozesa empiima ye enkalangufu enkologho era endhogi einho, yaabonereza ogusota ogwetebwa Leviathani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "Leviathani:",
              "type": "text"
            },
            {
              "text": "Guno n'ogusota ogwogerwaku mu nfumo, nga gudhuubirizibwa okuba akamanhiso akooleka amaani ga Sitaani. Zab 104:26 era ni Isa 27:1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ogwezingulula ni gulumuka. Aliita ogusolo ogwo oguba mu nhandha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
