                "loc": "DEU.28.57"
              },
              "items": [
                {
                  "text": "Ma 28:57",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.4.10"
              },
              "items": [
                {
                  "text": "Kul 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga bwe yawulira omukazi oyo bye yayogera, yaakanulamu ebivaalo bye olw'okunakughala. Abantu abaali agho gha kimante ky'ekibuga ghe yali ali kubita, baabona ng'avaire ekutiya ku mubiri gwe olw'okwebonereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga oyo yaakoba ati: “Katonda agwananga yambonereza n'obukambwe, Elisha mutabane wa Safati bwe bataamutemeku mutwe olwaleero.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaatuma omukwenda okweta Elisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo Elisha yali ng'atyaime mu ndhu ye eka ghalala n'abakulembeze b'abantu abaidha okumubona. Omukwenda wa kyabazinga bweyali ng'akaali kutuuka, Elisha yaakoba abakulembeze abo ati: “Muli kubona omutemo oyo bw'atumye bantemeku omutwe? Kale mubone eno, omukwenda bw'anaatuuka, mwidha kwigalagho olwigi mulukalangule, alobe kwingira. Ni kyabazinga mwene aidha kuba ng'ali kumuvaaku einhuma.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yali akaayogera nabo, kyabazinga ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:33",
              "type": "text"
            },
            {
              "text": "Kyabazinga:",
              "type": "text"
            },
            {
              "text": "mu Luheburayi",
              "type": "text"
            },
            {
              "text": "Omukwenda.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yaatuuka gh'ali, yaamukoba ati: “Musengwa Katonda n'atutuusiisaaku akabi kano. Kale lwaki nhongera okuteega okubona Musengwa Katonda ky'anaakola?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
