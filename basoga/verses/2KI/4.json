              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha yairamu ati: “Iwe gha abantu balye, kuba Musengwa Katonda akoba ati, ‘Baidha kulya balekerere n'okulekerera.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
