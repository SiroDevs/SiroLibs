          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga wa Moabu bwe yabona ng'olutalo luli kumunhigiriza, yaatwala abasaadha lusanvu abalwanisa empiima, baje baghaguze batuuke ku kyabazinga wa Edomu, aye baalemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaatoola mutabane we asinga obukulu eyali ow'okumusikira ku bwakyabazinga, yaamugheerayo ku kimante ekyezungulwire ekibuga, ng'ekigheebwayo ekyokebwa. Abaisiraeli baatya inho, baalekera agho okumulwanisa, bairayo mu nsi y'ewaibwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.27",
            "verseOrgIds": [
              "2KI.3.27"
            ]
          }
        }
      ]
