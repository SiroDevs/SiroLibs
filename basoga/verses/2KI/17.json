              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye abantu aba buli ighanga mu bibuga byaibwe mwe baabanga, baayongeranga okwekolera ebifaananie by'emisambwa gyaibwe, baabita mu bifo ebigulumivu eby'okusinzizaamu, Abasamaria ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:29",
              "type": "text"
            },
            {
              "text": "Abasamaria:",
              "type": "text"
            },
            {
              "text": "Kitegeeza Abaisiraeli abaatoolebwa mu Samaria ni batwalibwa aghandi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bye baaleka nga bazimbye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abaava e Babiloni baakola ebifaananie by'omusambwa Sukkothi Benothi, abaava e Kuthi baakola eby'omusambwa Nerugali, Abaava e Hamathi baakola eby'omusambwa Ashima, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaava mu Avva baakola eby'emisambwa Nibuhazi ni Tarutaki, ate abantu abaava e Sefarivaimu baaghangayo abaana baibwe ng'emisengo egyokebwa eri emisambwa gyaibwe, Adurammeleki ni Anammeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abo baasinzanga ni Musengwa Katonda, era beerondangamu bakabona abaabagheerangayo emisengo mu masabo ag'omu bifo ebigulumivu bye baasinzizangamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni baasinzanga Musengwa Katonda, aye nga era basinza n'emisambwa gyaibwe, nga bajiira ku mpisa dh'ensi ye baava.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
