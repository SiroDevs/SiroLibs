          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "verse",
