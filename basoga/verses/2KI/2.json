              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwene yeeyongerayo yaatuuka ku lusozi Karumeli, ate yaamala yaava eyo yaaja e Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
