              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Eliya yaakoba Elisha ati: “Nkweghemba osigale ghano, kuba nze Musengwa Katonda antumye nje ku mwiga Yorudani.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
