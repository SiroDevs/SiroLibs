            "number": "31",
            "style": "v",
            "sid": "2KI 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.31",
            "verseOrgIds": [
              "2KI.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kiseera ekyo, Musengwa Katonda yaatoolera okukendeeza ku nsi Isiraeli. Hazaeli kyabazinga wa Siria yaaghangula ekiketezo kya Isiraeli kyonakyona: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.32",
            "verseOrgIds": [
              "2KI.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "okuva ku mwiga Yorudani okuja mu bugwandhuba, ekiketezo eky'e Gileadi, n'eky'Abagadi, n'eky'Abareubeni, n'eky'Abamanasse, okuva ku kibuga Aroeri okumpi n'ekiiko ekirimu omwiga Arunoni ekyo nga n'ekiketezo kyonakyona eky'e Gileadi n'e Bashani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.33",
            "verseOrgIds": [
              "2KI.10.33"
            ]
          }
        }
      ]
    },
    {
