                "loc": "EXO.34.6+EXO.34.7"
              },
              "items": [
                {
                  "text": "Kuv 34:6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Kub 14:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.9+DEU.7.10"
              },
              "items": [
                {
                  "text": "Ma 7:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye ndholeka okugonza okutakoma eri abantu enkumi n'enkumi abangonza, ni bagondera ebiragiro byange.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
