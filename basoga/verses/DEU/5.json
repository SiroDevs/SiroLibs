            {
              "text": "Sabbato",
              "type": "text"
            },
            {
              "text": "Kitegeeza olunaku olw'okuwuumula",
              "type": "text"
            }
          ]
        },
        {
          "text": " nga lwange, nga nze Musengwa Katonda waimwe bwe nabalagira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
