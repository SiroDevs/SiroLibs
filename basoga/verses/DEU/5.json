          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Muteekoleranga kibaadhe oba kiwumbe ekifaanana ekintu kyonakyona ekiri ghaigulu ku igulu, oba ghansi ku nsi, oba waire ekiri mu maadhi agali ghansi agh'ensi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
