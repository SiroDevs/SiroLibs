              "type": "text"
            }
          ]
        },
        {
          "text": "waire ensi, kuba ni kw'ata ebigere bye; waire Yerusalemu, kuba n'ekibuga kya Kyabazinga omukulu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.35",
