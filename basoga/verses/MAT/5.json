          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwawulira nga bakoba bati, ‘Eriiso lisasulwa na liiso, n'eriino lisasulwa na liino.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.38",
