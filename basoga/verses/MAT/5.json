        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.26",
            "verseOrgIds": [
              "MAT.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwawulira nga bakoba bati, ‘Toyendanga.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.14"
              },
              "items": [
                {
                  "text": "Kuv 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Ma 5:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.27",
            "verseOrgIds": [
              "MAT.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nze mbakoba nti, buli alingirira omukazi olw'okumwegomba, aba amwenzeeku mule mu mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.28",
            "verseOrgIds": [
              "MAT.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale oba nga eriiso lyo ery'oku mukono omusaadha likusuula mu kibi, litoolemu olisuule ekisingaku n'ekitundu ekirala ku iwe okuzikirira aye omubiri gwo gwonagwona gwaloba kusuulibwa mu geyeena.",
