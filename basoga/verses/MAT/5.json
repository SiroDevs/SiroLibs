              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endhogera yaimwe ebenga eti, ‘Yii,’ oba eti, ‘Busa!’ Kuba ekisinga ku ebyo nga kiviire mu mubi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.37",
            "verseOrgIds": [
