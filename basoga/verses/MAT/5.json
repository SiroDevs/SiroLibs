          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye nze mbakoba nti: Mugonzanga abazigu baimwe, era musabiranga abo ababakiriga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
