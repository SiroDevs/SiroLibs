              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwawulira nga bakoba bati, ‘Ogonzanga mukagwa wo era waakyagha omuzigu wo.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
