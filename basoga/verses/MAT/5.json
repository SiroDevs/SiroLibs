          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "waire okulayira omutwe gwo, kuba n'oluviiri olulala tosobola kulufuula lweru oba lwirugavu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.36",
