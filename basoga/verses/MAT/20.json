          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kityo ti bwekiri mu imwe. Yeenayeena ayenda okuba omukulu mu imwe abe mugheereza waimwe,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
