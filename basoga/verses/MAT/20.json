              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi eikumi bwe baakiwulira, baasungughalira aboluganda bano ababiri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
