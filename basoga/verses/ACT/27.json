          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisirukale baasalagho okwita abasibe boonaboona, nga bakoba bati tomanha abandi ku basibe bwe beewuga, ni beiba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye omukulu ow'ekikunsu eky'abaisirukale yaabalobera olw'okwenda okuwonia Paulo. Yaalagira abo abasobola okwewuga basooke okwesuula mu maadhi, beewuge batuuke ku bukalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasigalagho bajiire ku mbaawo ni ku bikutukutu by'eryato. Batyo boonaboona bwe baatuuka ku bukalu nga balamu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
    }
