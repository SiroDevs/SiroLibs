              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo boonaboona abaali baikiriza, baali n'omutima n'omwoyo mulala. Era nga ghazira akoba ku ebyo bye yabanga nabyo ati kuliku ekikye ku bubwe. Aye nga byonabyona byaibwe ghalala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.32",
            "verseOrgIds": [
              "ACT.4.32"
            ]
          }
        },
        {
          "name": "note",
