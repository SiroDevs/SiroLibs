          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatume baakakasa okuzuukira kwa Musengwa Yesu n'amaani mangi, ni Katonda yaabagha boonaboona enkabi kamaala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tibaabanga na muntu ateesobola, kuba abaabanga n'ebibandha oba n'endhu nga babitunda, baaleeta ebyavangamu ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.34",
            "verseOrgIds": [
              "ACT.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "baabigemya Abatume, buli mulala baamugabira nga bajiira ku bwetaavu bwe yabanga nabwo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.35",
            "verseOrgIds": [
              "ACT.4.35"
            ]
          }
        }
      ]
    },
