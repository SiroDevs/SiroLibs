            }
          ]
        },
        {
          "text": "Ni Yosefu, Abatume ye baatuuma erya Barunaba (ekitegeeza: “Omwana aizaamu amaani”) Omulevi, nga wa mu ighanga ly'e Kupuro, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.36",
            "verseOrgIds": [
              "ACT.4.36"
            ]
          }
