          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "atwale ekifo eky'obugheereza n'obutume Yuda kye yaleka memale n'aja mu kifo kye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
