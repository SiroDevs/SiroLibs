              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'agho ni bataagho abantu babiri: Yosefu ayetebwa Barusabba, era eyatuumibwa erya Yusito, ni Matthia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baasaba bati: “Musengwa, oidhi ebiri mu myoyo egy'abantu boonaboona, ku bano bombi tulage y'olonze, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
