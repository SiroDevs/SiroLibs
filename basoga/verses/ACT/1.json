        },
        {
          "text": "“Kale ni, mu basaadha bano abaabanga n'ife ekiseera kyonakyona Musengwa Yesu bwe yabanga n'ife, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
