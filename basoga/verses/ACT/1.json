          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baakuba obululu, akalulu kaagwa ku Matthia, yaabalirwa ku Batume eikumi n'omulala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.26",
