  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "MRK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu yaatoolera okwogera nabo mu nfumo, ati: “Ghaaligho omuntu, yaasimba eisamba ery'emizabbibu, yaalisitaku olukomera, yaasimamu ekikunhiro eky'omwenge ogw'emizabbibu, yaazimbamu ekituuti ekireeyi, yaataamu abakozi, yaaja mu lugendo olw'eghala.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.1",
            "verseOrgIds": [
              "MRK.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.1+ISA.5.2"
              },
              "items": [
                {
                  "text": "Isa 5:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.1",
            "verseOrgIds": [
              "MRK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekiseera bwe kyatuuka, yaatuma omugheereza we y'abalimi anoneyo ku bibala eby'eisamba ery'emizabbibu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.2",
            "verseOrgIds": [
              "MRK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye baamugema baamukuba era baamwiririzaayo ngalo ndhereere.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.3",
            "verseOrgIds": [
              "MRK.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.3",
            "verseOrgIds": [
              "MRK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kabiri yaabatumira omugheereza owundi, oyo baamukuba oluguma era baamukola ebiswaza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.4",
            "verseOrgIds": [
              "MRK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yaatuma owundi, oyo baamwita era n'abandi kamaala abandi baabakuba, abandi baabaita.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.5",
            "verseOrgIds": [
              "MRK.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.5",
            "verseOrgIds": [
              "MRK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Yali ekaasigaireyo mulala, omwana omugonzi, ye yasembyayo okutuma, mule ng'akoba ati, ‘Omwana wange baidha kumutaamu akanhagansi!’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.6",
            "verseOrgIds": [
              "MRK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye abakozi abo, mule baakoba bati, ‘Ono n'omusika, ka tumwite obusika bube bwaife.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.7",
            "verseOrgIds": [
              "MRK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho nga bamugema, bamwita, bamusuula ku luya okw'eisamba ery'emizabbibu.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.8",
            "verseOrgIds": [
              "MRK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu yaabuuza ati: “Kale mwene isamba alikola ki?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.9",
            "verseOrgIds": [
              "MRK.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bale bairamu bati: “Aliidha yaazikiriza abakozi abo, n'eisamba yaaligha abandi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.9",
            "verseOrgIds": [
              "MRK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaakoba ati: “Timusomanga kino ekyaghandiikibwa kiti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.10",
            "verseOrgIds": [
              "MRK.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.11",
            "verseOrgIds": [
              "MRK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali benda okumugema, kuba baali bamanhie ng'olufumo alugereiza ku beene, aye baatya ekiyindi eky'abantu. Kale baamuleka yaaja.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.12",
            "verseOrgIds": [
              "MRK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatuma abandi ku Bafarisaayo n'abandi ku baine ba Herode bamutege mu by'akoba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.13",
            "verseOrgIds": [
              "MRK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baatuuka baamukoba bati: “Mwegeresa, twidhi oli wa mazima era mpaagho ye weeguya. Mu nkola yo tojiira ku mboneka ya muntu, aye oyegeresa mu mazima engira ya Katonda. Kale ni tukobere, kiikirizibwa okugha Kaisari omusolo oba bbe? Tugughenga oba tutagughanga?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.14",
            "verseOrgIds": [
              "MRK.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.14",
            "verseOrgIds": [
              "MRK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Yesu olw'okumanha obukuusa bwaibwe, yaabakoba ati: “Lwaki mundeba? Mundeetere ghano e dinari mbone!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.15",
            "verseOrgIds": [
              "MRK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagimuleetera. Yaabakoba ati: “Ekifaananie kino ni bino ebighandiiko ebiriku by'ani?” Baamukobera bati: “Bya Kaisari.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.16",
            "verseOrgIds": [
              "MRK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu yaabakoba ati: “Ebya Kaisari mubighe Kaisari n'ebya Katonda mubighe Katonda.” Era baamwewuunhia.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.17",
            "verseOrgIds": [
              "MRK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaddukaayo, abakoba bati ezira kuzuukira, baidha ye Yesu, baamukoba bati:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.8"
              },
              "items": [
                {
                  "text": "Bik 23:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwegeresa, Musa yaleka ng'atughandiikiire ati, ‘Muganda w'omuntu bw'afanga n'aleka omukazi aye nga talese mwana, muganda w'omufu atwalanga omukazi oyo yaafunira muganda we eizaire.’",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Ma 25:5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Agho olwatuuka, nga ghabaagho aboluganda musanvu omuberi yaafuna omukazi, yaafa nga talese izaire. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.20",
            "verseOrgIds": [
              "MRK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'owokubiri yaamubayiza, era yaafa nga talese izaire, n'owokusatu atyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.21",
            "verseOrgIds": [
              "MRK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era batyo omusanvu tibaaleka izaire. Olumaliira omukazi yeena yaafa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.22",
            "verseOrgIds": [
              "MRK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperaano mu mazuukira, abo bwe balizuukira aliba muka ani?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.23",
            "verseOrgIds": [
              "MRK.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
