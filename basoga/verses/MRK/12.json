            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaamwiramu ati: “Ekisooka ni kino, ‘Wulira iwe Isiraeli. Musengwa Katonda waife ni Musengwa yenka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.4+DEU.6.5"
              },
              "items": [
                {
                  "text": "Ma 6:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ogonzanga ni Musengwa Katonda wo n'omutima gwo gwonagwona, n'omwoyo gwo gwonagwona, n'amagezi go goonagoona era n'amaani go goonagoona.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekyokubiri ni kino, ‘Ogonzanga mwino nga iwe mwene bwe weegonza.’ Ezira kiragiro kindi kiwula bino.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Lev 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
