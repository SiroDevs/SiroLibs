          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Daudi mwene amweta ‘Musengwa’ memale obwo aba atya mwidhukulu we!” Olukunkumuli olw'abantu abaali agho baamuwulirisa n'eisanhu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.37",
            "verseOrgIds": [
              "MRK.12.37"
            ]
          }
        }
      ]
    },
