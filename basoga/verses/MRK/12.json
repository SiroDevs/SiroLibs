          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu bwe yabona ng'aizeemu bukalamu, yaamukoba ati: “Obwakyabazinga bwa Katonda tobuli ghala.” Era okuva ku olwo ng'ezira akanaghala kumubuuza kibuuzo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
            "verseOrgIds": [
              "MRK.12.34"
            ]
          }
        }
      ]
