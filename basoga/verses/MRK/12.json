          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yaabakoba ati: “Ti kyemuva mughaba, olw'obutamanha Byaghandiikibwa waire okumanha amaani ga Katonda! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.24",
            "verseOrgIds": [
              "MRK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekituufu kiri nti bwe bazuukira mu bafu, baba nga tibakaabayiza waire okubayira baba ng'oti bamalaika mu igulu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.25",
            "verseOrgIds": [
              "MRK.12.25"
            ]
          }
        }
      ]
    },
    {
