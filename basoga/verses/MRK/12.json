            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaaligho mulala ku Banamateeka yaatuuka yaabawulira bwe baabuuza, era bwe yabona ng'abaizeemu bukalamu yaamubuuza ati: “Kiragiro ki ekisooka mu biragiro byonabyona?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
