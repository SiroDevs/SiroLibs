              "MRK.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaayeta ekiyindi eky'abantu n'Abeegeresebwa be baaseeta gh'ali, yaabakoba ati: “Ole ayenda okuunonereza, alobe kwefaaku naire, abbeede omusalaba gwe, annonereze",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
