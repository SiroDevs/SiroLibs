              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba ayenda okuwonia obulamu bwe, oyo abubuza bubuze aye abuza obulamu bwe ku lwange n'olw'Amawulire Amalungi, oyo abuzaawula.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
