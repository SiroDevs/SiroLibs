            "number": "4",
            "style": "v",
            "sid": "AMO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Abantu ab'e Buyudaaya bakoze ebibi emikuzi kamaala. N'olw'ensonga eyo nteekwa buteekwe okubabonereza kuba baanhooma amateeka gange, n'ebiragiro byange baaloba kubigema. Baatwalirizibwa emisambwa badhaadha baibwe gye baasinzanga. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nja kusindika omuliro gwokye Abayudaaya abo, era gusenkeenhe ebifo byaibwe eby'okwewogomamu eby'omu Yerusalemu.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
