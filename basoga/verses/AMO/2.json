              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati: “Abantu Abaisiraeli bakoze ebibi emikuzi kamaala. N'olw'ensonga eyo nteekwa buteekwe okubabonereza kuba batunda abantu abatuufu mu bwiru, olw'obutasobola kusasula mabandha agababandhibwa. Era baatunda abaavu, olw'obutasobola kusasula waire omughendo ogugula omuyimbo gw'engaito. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batyankirira abaavu ng'oti n'abatyankirira enkungu, baasindika ere abaghafu babaviire mu ngira. Omulenzi n'ise baja ku mukazi mulala, mu nsambo eyo baaba nga boonoona eriina lyange eitukuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batenduka mu masinzizo ku ngoye dhe batoola ku baavu ng'omusingo. Era mu ndhu yange nze Katonda waibwe banhweramu omwenge gwe babaleeteire ng'omutango.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
