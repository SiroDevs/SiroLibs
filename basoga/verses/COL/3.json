          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakazi, mugonderenga baibaimwe, kuba abaikiriza mu Musengwa bwe bagwaine okukola.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.18",
            "verseOrgIds": [
              "COL.3.18"
            ]
          }
        },
        {
