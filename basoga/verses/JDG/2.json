              "JDG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.24.28+JOS.24.29+JOS.24.30+JOS.24.31"
              },
              "items": [
                {
                  "text": "Yosh 24:28-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yoshua bwe yamala okusiibula Abaisiraeli, Abaisiraeli abo baaja, buli muntu okutwala ekiketezo kye yagabana. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.6",
            "verseOrgIds": [
              "JDG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaisiraeli baagheerezanga Musengwa Katonda ekiseera kyonakyona Yoshua kye yamala ng'ali kubakulembera, era n'ekiseera ekyairirira kye baamala nga bakulemberwa abakulu b'ebikunsu Yoshua be yalekagho. Abakulu abo n'abaabona ebyo byonabyona Musengwa Katonda bye yakolera Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.7",
            "verseOrgIds": [
              "JDG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua, mutabane wa Nuni era omugheereza wa Musengwa Katonda, yafa ng'agheziiza emyaka egy'obukulu kikumi na ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.8",
            "verseOrgIds": [
              "JDG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era baamuziika ghe yafuna ng'obutaka bwe e Timunathi Sera, ekiri mu kiketezo eky'oku nsozi eky'Abaefuraimu, ku luuyi olw'omukono omugooda olw'e buvandhuba w'olusozi Gaashi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.9",
            "verseOrgIds": [
              "JDG.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho n'abantu ab'oluse olwo boonaboona baafa. Ghairagho oluse olundi olw'abantu, abataamanha Musengwa Katonda waire okumanha ebyo bye yakolera Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.10",
            "verseOrgIds": [
              "JDG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Abaisiraeli baayonoona ye Musengwa Katonda, baasinza emisambwa egyetebwa Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.11",
            "verseOrgIds": [
              "JDG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava ku Musengwa Katonda, Katonda wa badhaadha baibwe eyabatoola mu nsi Misiri, baasinza emisambwa egy'abantu abaali nga babeezungulwire. Baakubira emisambwa egyo amakiryaivu, era mu nsambo eyo baaleetera Musengwa Katonda okusungughala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.12",
            "verseOrgIds": [
              "JDG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baava ku Musengwa Katonda, baagheereza emisambwa egyetebwa Baali ni Ashitarothi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.13",
            "verseOrgIds": [
              "JDG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obusungu bwa Musengwa Katonda bwatumbukira ku Baisiraeli ng'oti muliro, era yaabaghaayo mu ngalo dh'abanhazi, baabanhagaku ebyaibwe. Yaaleka abazigu baibwe abaali nga babeezungulwire baabaghangula. Olwo Abaisiraeli baaba nga tibakaaghanga kwerwanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.14",
            "verseOrgIds": [
              "JDG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiisi bwe baajanga okulwana olutalo, nga Musengwa Katonda abasindikira akabi, nga bweyali amaze okubeesoomera. Kale baaba mu kabi akataloodheka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.15",
            "verseOrgIds": [
              "JDG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yaabateeragho abakulembeze okubawonia abanhazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.16",
            "verseOrgIds": [
              "JDG.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye Abaisiraeli baaloba kuwulirisa bakulembeze baibwe. Baaloba kuba beesigwa ye Musengwa Katonda, baasinza emisambwa. Waire nga badhaadha baibwe baawuliranga ebiragiro bya Musengwa Katonda, bano tibaakola batyo naire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.17",
            "verseOrgIds": [
              "JDG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda bwe yateerangagho Abaisiraeli omukulembeze, Musengwa Katonda oyo ng'aba ghalala n'omukulembeze oyo, era yaawonianga abantu abazigu baibwe, ekiseera kyonakyona omukulembeze oyo kye yamalanga ng'akaali mulamu. Musengwa Katonda yabagemerwanga ekivunika, kuba baasindanga olw'abo abaabadaazadaazanga ni babatuntuza. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.18",
            "verseOrgIds": [
              "JDG.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye buli mukulembeze bwe yafanga, abantu bairangayo mu mize gyaibwe egy'eira, baabanga babi n'okusinga badhaadha baibwe. Baagheerezanga emisambwa era baagikubiranga amakiryaivu okugisinza, era baalobanga kulekayo mpisa dhaibwe embi naire endala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.19",
            "verseOrgIds": [
              "JDG.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho obusungu bwa Musengwa Katonda bwatumbukira ku Baisiraeli ng'oti muliro, yaakoba ati: “Abantu ab'eighanga lino bamenhie endagaano ye nalagira badhaadha baibwe okukuumanga, era tibakampulira naire. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.20",
            "verseOrgIds": [
              "JDG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale okuva n'olwaleero, bwe banaabanga nga bali kumpi okutuuka mu nsi eyo, tiidhanga kubingamu bamaghanga abaabangayo mu kiseera Yoshua ghe yafiira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.21",
            "verseOrgIds": [
              "JDG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidha kubeeyambisanga okuleba Abaisiraeli, mbone oba nga banaakolanga bye mbalagira, nga badhaadha baibwe bwe baakolanga, oba busa.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.22",
            "verseOrgIds": [
              "JDG.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Musengwa Katonda yaaleka abamaghanga ago mu nsi eyo, yaaloba kubabingamu mangu, era yaaloba kuganha Yoshua kubaghangula.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.23",
            "verseOrgIds": [
              "JDG.2.23"
            ]
          }
        }
      ]
    }
  ],
