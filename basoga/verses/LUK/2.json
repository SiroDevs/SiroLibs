          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yeeyongera mu magezi n'okukula era n'okugonzebwa Katonda n'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
