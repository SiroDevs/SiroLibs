              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ghabiseegho enaku isatu, baamwagaana mu isinzizo ng'atyaime ghagati mu beegeresa ng'abawulirisa, ate nga bw'ababuuza ebibuuzo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.46",
            "verseOrgIds": [
              "LUK.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era boonaboona abaamuwulirisa beewuunhia inho amagezi ge, ni bye yairangamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.47",
            "verseOrgIds": [
              "LUK.2.47"
            ]
          }
        }
      ]
