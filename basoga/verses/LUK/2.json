          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yesu yaaserengeta nabo, yaatuuka e Nazarethi, era yaabawuliranga. Inhina ebintu ebyo byonabyona yaabita ku mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
        {
