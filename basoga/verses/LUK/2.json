              "LUK.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baamala byonabyona eiteeka lya Musengwa bye liragira, bairayo e Galilaaya, mu kyalo eky'ewaibwe e Nazarethi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
