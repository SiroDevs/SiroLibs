        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutasalanga musango era mwena tigulibasalirwa, mutasaliranga muntu musango kumusinga mwena tigulibasalirwa kubasinga. Musonighenga mwena mulisoniyibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.37",
            "verseOrgIds": [
              "LUK.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabenga, era mwena muligheebwa. Ekipimo ekituufu ekitengeeseibwa ni kisiinhirwa, ni kiidhula era n'okuyuyika ni kiyuyika, kye balibagemya; kuba ekipimo kye mupimiramu abandi mwena kye mulipimirwamu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.38",
            "verseOrgIds": [
              "LUK.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
