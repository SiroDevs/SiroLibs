              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayegeresebwa tasinga amwegeresa, aye kiisi ayegeresebwa bw'aba amaze okwegeresebwa mu bwidhuvu, aba ng'oyo amwegereisa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.40",
            "verseOrgIds": [
              "LUK.6.40"
            ]
          }
        },
        {
