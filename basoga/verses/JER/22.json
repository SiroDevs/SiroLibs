          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
              "JER.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda ati bw'akoba ku kisaagaati kya kyabazinga wa Buyudaaya:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.6",
            "verseOrgIds": [
              "JER.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.7",
            "verseOrgIds": [
              "JER.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu kamaala abamaghanga agandi bwe balibitanga ku kibuga kino, balyebuuzanga bati, ‘Lwaki Musengwa Katonda yakola ekintu ng'oti n'ekyo ku kibuga kino ekikologho?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.8",
            "verseOrgIds": [
              "JER.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baamala beiramu bati, ‘Lwa kuba abantu baakyo baava ku ndagaano ye baakola ni Musengwa Katonda waibwe, baaja baasinza era baagheereza bakatonda abandi.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
            "verseOrgIds": [
              "JER.22.9"
            ]
          }
        }
      ]
    },
