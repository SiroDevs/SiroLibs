                  "text": "2 Byom 36:5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kale ni, Musengwa Katonda bino by'akoba ebigema ku Yehoiakimu mutabane wa Yosia, era kyabazinga wa Buyudaaya:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
