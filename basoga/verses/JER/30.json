            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba abantu b'omu Isiraeli n'ab'omu Buyudaaya ati:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
