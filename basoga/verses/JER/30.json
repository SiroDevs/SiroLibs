              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Musengwa Katonda yankoba nze Yeremia ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ghandiika mu kitabo ebintu byonabyona bye nkukobeire, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuba bona eno, ekiseera kiri kwidha lwe ndireetera abantu bange Abaisiraeli n'Abayudaaya ebintu okwiramu okubajiiranga obukalamu. Ndibaiza mu nsi ye nagha badhaadha baibwe, era bairamu okugitwala yaaba yaibwe ku bwaibwe. Nze Musengwa Katonda, ninze nkobye.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
