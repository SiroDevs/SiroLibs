                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka ogwokuna nga Yehoiakimu mutabane wa Yosia ni kyabazinga wa Buyudaaya, Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.1",
            "verseOrgIds": [
              "JER.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Toola enzingo y'ekitabo oghandiikemu ebintu byonabyona bye nkukobeire ebigema ku Isiraeli, ni ku Buyudaaya, ni ku maghanga agandi goonagoona. Ghandiika ebintu byonabyona bye mbairenga nga nkukobera okuviira irala ku lunaku lwe natoolera okwogera n'iwe, nga Yosia ni kyabazinga, okutuusa olwaleero. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba katyo abantu b'omu Buyudaaya bwe baliwulira ku kuzikirira okwo kwonakwona kwe ndi kutegeka okubasindikira, balikyuka baava mu mpisa dhaibwe embi. Olwo naabasonigha olw'obubi bwaibwe n'ebibi bye bakola.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale naayeta Baruku mutabane wa Neria. Naayogeranga, eno nga bw'aghandiika mu nzingo y'ekitabo bye ndhogera, ebyo byonabyona Musengwa Katonda bye yankoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naagha Baruku oyo ebiragiro bino nti: “Nze tibakandhikiriza kuja mu isinzizo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nhenda iwe ojeeyo ku lunaku abantu lwe baba mu kusiiba. Agho osome enzingo y'ekitabo eyo, abantu boonaboona abali mu isinzizo bawulire bukalamu ebyo byonabyona Musengwa Katonda bye yankoba, era bye ndhogeirenga eno nga bw'obighandiika. Oidha kusoma ebintu ebyo nga n'abantu ab'omu Buyudaaya abava mu bibuga byaibwe ebindi bali kuwulira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba katyo balitoolera okusabanga Musengwa Katonda, era baakyuka baaleka empisa dhaibwe embi, kuba Musengwa Katonda yeesoomeire okukola ku bantu abo mu busungu n'ekiruyi ebitaloodheka.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Baruku yaasomera ebibono bya Musengwa Katonda mu isinzizo, mu nsambo yeene nga bwe namukoba asome.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwezi ogwomwenda ogw'omwaka ogwokutaanu nga Yehoiakimu ni kyabazinga wa Buyudaaya, baalangirira ekisiibo olw'okusaba Musengwa Katonda. Abantu boonaboona ab'omu Yerusalemu, n'abo boonaboona abaidha nga bava mu bibuga eby'omu Buyudaaya ebindi, baasiiba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.9",
            "verseOrgIds": [
              "JER.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Baruku yaasoma, ng'abantu boonaboona bali kuwulira, ebyali mu nzingo y'ekitabo bye namukoba okughandiika. Yabisomera mu isinzizo, ng'ali mu kisenge kya Gemaria mutabane wa Shafani era omughandiisi. Ekisenge ekyo kyali ghaigulu gh'oluya olw'eisinzizo, kumpi n'ogwetebwa Omulyango Omuyaaka ogw'eisinzizo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.10",
            "verseOrgIds": [
              "JER.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Mikaia mutabane wa Gemaria era mwidhukulu wa Shafani, yaawulira Baruku ng'asoma mu nzingo y'ekitabo ebyo Musengwa Katonda bye yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.11",
            "verseOrgIds": [
              "JER.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaaja mu kisaagaati kya kyabazinga, mu kisenge eky'omughandiisi abakungu boonaboona ye baali nga batyaime: Elishama omughandiisi, ni Delaia mutabane wa Shemaia, ni Elinathani mutabane wa Akabori, ni Gemaria mutabane wa Shafani, ni Zedekia mutabane wa Hanania, n'abakungu abandi boonaboona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.12",
            "verseOrgIds": [
              "JER.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaia yaabakobera byonabyona bye yawulira nga Baruku asomera abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.13",
            "verseOrgIds": [
              "JER.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abakungu abo baatuma Yehudi mutabane wa Nethania, era nga mwidhukulu wa Shelemia, era nga mwidhukulu wa Kushi, aje akobe Baruku abaleetere enzingo y'ekitabo ye yasomera abantu. Baruku yaagibaleetera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.14",
            "verseOrgIds": [
              "JER.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamukoba bati: “Tyama otusomere ebiri mu nzingo y'ekitabo eyo.” Baruku yaabibasomera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.15",
            "verseOrgIds": [
              "JER.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baamala okubiwulira byonabyona, baalingaganaku nga batiire, era baamukoba bati: “Ebyo tuli n'okubikobera kyabazinga.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.16",
            "verseOrgIds": [
              "JER.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baabuuza Baruku bati: “Aye tukobere, wasobola otya okughandiika ebyo byonabyona? Yeremia n'eyabikukoberanga, eno nga bw'obighandiika?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.17",
            "verseOrgIds": [
              "JER.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruku yairamu ati: “Yeremia n'eyabinkoberanga, eno nga bwe mbighandiika ni bwino mu nzingo eno ey'ekitabo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.18",
            "verseOrgIds": [
              "JER.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho baamukoba bati: “Iwe ni Yeremia muje mwegise, mulobe kuganha muntu yeenayeena kumanha ghe muli.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.19",
            "verseOrgIds": [
              "JER.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakungu baata enzingo y'ekitabo mu kisenge kya Elishama omughandiisi. Baamala baaja mu luya lwa kyabazinga, era baakobera kyabazinga byonabyona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.20",
            "verseOrgIds": [
              "JER.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyabazinga yaatuma Yehudi okunona enzingo y'ekitabo eyo. Yehudi yaaja yaagitoola mu kisenge kya Elishama, yaagisomera kyabazinga n'abakungu boonaboona abaali beemereire agho okumwezungulula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.21",
            "verseOrgIds": [
              "JER.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwali mwezi gwa mwenda, nga kyabazinga atyaime mu ndhu ye y'abaamu mu biseera eby'ekiinhogogo, ng'ali kwota muliro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.22",
            "verseOrgIds": [
              "JER.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho Yehudi bwe yamalanga okusoma ebitundu ebibiri oba ebina ku nzingo y'ekitabo eyo, nga kyabazinga abisalaku n'akambe akatono, ng'abisuula mu muliro. Yaakola atyo okutuusa enzingo y'ekitabo yoonayoona bweyawaagho okuya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.23",
            "verseOrgIds": [
              "JER.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aye k'abe kyabazinga mwene, oba abakungu be abaawulira ebyo nga bisomebwa, tighaaligho naire omulala ati eyatya oba eyakanulamu ebivaalo bye okwoleka nga bw'anakughaire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.24",
            "verseOrgIds": [
              "JER.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era waire nga Elinathani, ni Delaia, ni Gemaria beeghemba kyabazinga alobe kwokya nzingo ya kitabo eyo, kyabazinga oyo tiyabawulirisa naire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.25",
            "verseOrgIds": [
              "JER.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho yaalagira omulangira ayetebwa Yerahameeli ghalala ni Seraia mutabane wa Azarieli, ni Shelemia mutabane wa Abudeeli, batugeme nze n'omughandiisi wange Baruku. Aye Musengwa Katonda yaatugisa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.26",
            "verseOrgIds": [
              "JER.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga kyabazinga Yehoiakimu amaze okwokya enzingo y'ekitabo omwali bye nayogeranga eno nga Baruku bw'abighandiika, Musengwa Katonda yankoba ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.27",
            "verseOrgIds": [
              "JER.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Toola enzingo y'ekitabo eyindi, oghandiikeku byonabyona ebyali ku nzingo y'ekitabo ere, kyabazinga Yehoiakimu owa Buyudaaya ye yayokya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.28",
            "verseOrgIds": [
              "JER.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kyabazinga oyo omukobe oti, ‘Wayokya enzingo y'ekitabo era waabuuza Yeremia lwaki yaghandiika ati kyabazinga ow'e Babilonia aliidha yaazikiriza ensi eno, era yaita abantu baamu n'ensolo dhaamu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.29",
            "verseOrgIds": [
              "JER.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale ni, nze Musengwa Katonda nkukoba iwe kyabazinga Yehoiakimu nti toliba na mwidhukulu yeenayeena alifuga bwakyabazinga bwa Daudi. Omulambo gwo baligusuula kuliya, akasana kaagwokya omusana ate empewo ey'ekiinhogogo yaagufuuwa obwire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.30",
            "verseOrgIds": [
              "JER.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikubonereza iwe, n'abaana bo, ni baidhukulu bo, n'abakungu bo, olw'ebibi mwenamwena bye mukola. Ndibaleetaku akabi ke neesoomera okubatuusaaku imwe, n'abantu b'omu Yerusalemu, n'ab'omu Buyudaaya, kuba nabalabula aye mwaloba kufaayo naire.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.31",
            "verseOrgIds": [
              "JER.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho naatoola enzingo y'ekitabo eyindi, naagigha omughandiisi wange Baruku. Yaaghandiika bire byonabyona, bye nayogeranga eno nga bw'abighandiika, ebyali mu nzingo y'ekitabo kyabazinga Yehoiakimu ye yayokya. Era ku ebyo yaayongeraku n'obukwenda obundi obufaanana n'obwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
      ]
    }
