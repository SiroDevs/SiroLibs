            "number": "6",
            "style": "v",
            "sid": "JER 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Baakoba bati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.6",
            "verseOrgIds": [
              "JER.48.6"
            ]
          }
        }
