        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.46",
            "verseOrgIds": [
              "JER.48.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JER 48:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aye mu biseera eby'oluvainhuma, nze Musengwa Katonda ndireetera ebintu okwiramu okujiiranga Abamoabu obukalamu.” Ebyo byonabyona, Musengwa Katonda bye yakoba okutuuka ku nsi Moabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.47",
            "verseOrgIds": [
              "JER.48.47"
            ]
          }
        }
