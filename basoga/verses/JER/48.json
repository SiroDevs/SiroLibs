        },
        {
          "text": " Bino Musengwa Katonda Afuga Amagye, Katonda wa Isiraeli, by'akoba ku Moabu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
