          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Kale ni, iwe Yeremia, oidha kubakobera ebibono bino. Aye era tibaidha kukuwulirisa. Ni bw'onaabeeta, tibaidha kuvugira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.27",
            "verseOrgIds": [
              "JER.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oidha kubakoba oti eighanga lyaibwe tirimpulira nze Musengwa Katonda waalyo era tiriganha kugalagirwa. Tirikaali na mazima, waire okugoogeraku obwogere.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.28",
            "verseOrgIds": [
              "JER.7.28"
            ]
          }
        }
      ]
