              "JER.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agho abantu beeteesa bati: “Mwidhe tubeeku ni kye tukola Yeremia ono. Ni bwetunaamutoolagho, tituja kubula bakabona ba kutugalagiranga, era tituja kubula bagezi ba kwebuuzangaku, waire okubulwa abalanzi abatukobera obukwenda bwa Katonda. Ka tumuteeku emisango, era tulekere okuwulirisanga by'akoba.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.18",
            "verseOrgIds": [
              "JER.18.18"
            ]
          }
        }
      ]
    },
