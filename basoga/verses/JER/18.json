          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musengwa Katonda akoba ati:",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        }
