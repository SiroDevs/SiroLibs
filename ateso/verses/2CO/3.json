            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai kejai aijaanakin naka atubokinio kaibuses, itelekarit noi aijaanakin naka adolit ajaun kaibuses. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
