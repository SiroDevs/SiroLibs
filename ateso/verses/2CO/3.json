            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam sio kilosikino aomit bonik araut ibore kanukosi; kwabo ebuni aisilosikiniokosi kama ka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
