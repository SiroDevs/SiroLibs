          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai arai naitapalaunio kejai kaibuses, itelekarit noi naesalenenei ajaun kaibuses.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
