            "caller": "#"
          },
          "items": [
            {
              "text": "3:2",
              "type": "text"
            },
            {
              "text": "wadikaete lukapolok ice “kosi” aibois naka “kus”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ejena esiomete da ituŋa kere. ",
          "type": "text",
          "attrs": {
