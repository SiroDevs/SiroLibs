              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema EJAKAIT Musa atiar, “Kolimok isasedotin, odwe luka Aaron, ebe, Siri ituŋanan kayesi kemunaun bon kanuka lukatwak kotuŋake; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimarai lukokekike luipajanas kaŋes, totoke, ka papake, ka okokuke, ka akokuke, ka onaceke; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka inacike naerai abekot, nainacanas kaŋes namam ekiliokit, epedori amunaun bon kanukeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam emunaun bon, korai ekapolon kotuŋake, aitisil bon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.27+LEV.19.28"
              },
              "items": [
                {
                  "text": "Leb 19:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.1"
              },
              "items": [
                {
                  "text": "Ikis 14:1",
