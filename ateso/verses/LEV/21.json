              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kes eyaŋaarete aberu naerai adote, arai naitisilitoi: mam eyaŋaarete da aberu nakireŋea okilenike; naarai erai lokalaunan kama ejai Ekedeke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
