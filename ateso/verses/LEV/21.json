            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.10"
              },
              "items": [
                {
                  "text": "22:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.19"
              },
              "items": [
                {
                  "text": "Mar 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enyami atap naka Ekedeke, nakalaunan noi, ka nakalaunan da kere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye mam elomari neejai aigalisit, karaida aikunyakin otem, naarai eŋwalit; kinyek aitisil aiboisioka nukalaunak: naarai arai eoŋ EJAKAIT loetalauni kes.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Musa kolimok Aaron ŋun, ka odweke, ka idwe kere luka Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.24",
            "verseOrgIds": [
              "LEV.21.24"
            ]
          }
        }
