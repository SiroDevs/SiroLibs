              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Mar 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.64.4"
              },
              "items": [
                {
                  "text": "Sab 64:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kolimok Aaron ebe, Ŋolituŋanan loka aurikon anatar aturiokec loeŋwalit, siri ŋol kikunyaki ainakin atap naka Edekeke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.23"
              },
              "items": [
                {
                  "text": "Leb 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ŋolituŋanan loeŋwalit, mam ŋol ikunyakini: emuduki, arai loicodo, arai ŋol loŋiriony kekume, arai loejai ibore yeniyatakina, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai etuŋanan loebilil akeju, arai loebilil akan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.1"
              },
              "items": [
                {
                  "text": "Ikis 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai arubaŋat, arai loarakaki, arai loeŋwalit akoŋu, arai lokijip, arai lokasalabit, arai loebulul itou; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam etuŋanan loeŋwalit loka aur naka Aaron esasedoti, ikunyakini ainakin ainakineta nuka EJAKAIT nueinakinere kakim: eŋwalit ŋesi, mam ikunyakini ainakin atap naka Ekedeke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.3"
              },
              "items": [
                {
                  "text": "Leb 2:3",
                  "type": "text"
                }
