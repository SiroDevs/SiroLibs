              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam ŋes itisili aurike kotuŋake; naarai arai eoŋ EJAKAIT loetalauni ŋes.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.15",
