              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema EJAKAIT Musa atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
