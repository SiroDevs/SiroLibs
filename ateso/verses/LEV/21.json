            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraunos kesi lukalaunak kama ejai Edekekec, mam itisilete ekiror loka Edekekee: naarai einanakinete ainakineta nuka EJAKAIT, nueinakinere kakim, atap naka Edekekec: kanuka ŋun eraunos lukalaunak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "verse",
