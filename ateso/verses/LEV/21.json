            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karaida alomun kaibois nakalaunan, karaida aitisil aibois nakalaunan naka Edekeke; naarai enapit aboko naka akinyet nakinyonyoanakina naka Edekeke: arai eoŋ EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
