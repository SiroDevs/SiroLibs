              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ŋesi Aaron atiar, “Koyaŋa ijo itaok yenikiliokit araun ainakinet naka adiakaret, ka emerekek araun ainakinet naicweio, lumam eŋwalitos, koinak kes akonyen nuka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.2",
            "verseOrgIds": [
              "LEV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
