              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilimokini idwe luka Isirael ebe, ‘Koyanaasi yesi ekoroi araun ainakinet naka adiakaret; ka itaok ka imerekek, kere luka ekaru ediopet, lumam enwalitos, araun ainakinet naicweio; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
          },
