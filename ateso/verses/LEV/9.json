            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Musa atiar, “Na ŋes akirot naicorakinit EJAKAIT yes aswam: kitaanyikin da yes aibuses naka EJAKAIT.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
