            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijaŋ Aaron atorobusio ka amurwo nakoteten araun ainakinet naijaŋio kakonyen nuka EJAKAIT: kwape kicorakinia Musa.",
          "type": "text",
          "attrs": {
