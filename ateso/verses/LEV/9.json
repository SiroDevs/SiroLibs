          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koar ainakinet naicweio; kijaikis odwe luka Aaron ŋes aokot, kobwatanak otem owaitin kere, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijaikis ŋes ainakinet naicweio, inerio kere ka akou: kicweik kes kotem, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilot lukotoma ka akeje, kicweik kes kaneajai ainakinet naicweio kotem.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.14",
            "verseOrgIds": [
              "LEV.9.14"
            ]
          }
        }
      ]
    },
