          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibwaikis asiepai katorobusio, kieweik asiepai kotem: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
