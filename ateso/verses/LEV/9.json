          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.4.23"
              },
              "items": [
                {
                  "text": "Leb 4:23",
                  "type": "text"
