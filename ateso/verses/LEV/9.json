          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka asiepai naka emoŋ; ka naka emerekek, ka asonyok, ka naerapit lukotoma, ka iŋalur, ka asiepai naka emany: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
