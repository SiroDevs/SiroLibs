              },
              "items": [
                {
                  "text": "Asw 16:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kejukas Timoteo onacekosi ido ekejaanakinan loka Edeke toma Akiro Nukajokak nuka Kristo, tetere iticasi yes ka uitalakar da kotoma aiyuunikus, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
