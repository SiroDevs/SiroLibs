              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Koinunai atany nakitetet, kibwaikis abalaŋ toma.” Koinut ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
