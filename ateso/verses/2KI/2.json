            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma kolot neejai akoŋu naka atan, kocakak abalaŋ, kotema atiar, “Inera EJAKAIT kwanata ebe, Etaŋaleu eoŋ akipi nu; mam bobo elomuni atwanare karaida aimotoikin.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
