                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala ŋes ebe, “Ilipit ijo akirot naetiono: konye, arai kiiany kaalemar eoŋ, ikwaikinos nen; konye arai mam, mam ikwaikinos nen.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
