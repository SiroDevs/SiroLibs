            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iinacan, keŋaiŋair yes, koraut kwape kaeoŋ, naarai arau eoŋ da kwape kayesi. Mam ipotu kikonakis erono kakirot kere; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
