            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai iwadikatai ebe ajaas Aburaam odweke iarei, ediopet loka abulesit, ediopet da loka naijakakai. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.22",
