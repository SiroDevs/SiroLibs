            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere elakuni ŋul lukeyaito ikisila, tetere oni kitaraunio odwe, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
