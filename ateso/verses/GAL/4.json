                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun mam bobo irai ebulesit dimarai okoku, ido arai irai okoku, aso irai ekeruman kanuka Edeke,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
