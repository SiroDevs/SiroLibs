          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwabo Kagar na ŋes erai emoru Sinai kotoma Arabia; erianas ka Yerusalem loka tinenikwana; naarai erai ŋesi abulesit nenipe kikedwe da. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.25",
            "verseOrgIds": [
              "GAL.4.25"
            ]
          }
