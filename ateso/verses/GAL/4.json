            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iricito apaarasia, ka ilapio, ka apakio ka ikar da! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.10",
            "verseOrgIds": [
              "GAL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
