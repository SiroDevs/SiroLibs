          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye apak ya namam ijeniata Edeke, ipotu koraas ibulesin luka ŋul lumam eraas idekesio kauruunet; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.8",
            "verseOrgIds": [
              "GAL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye kwana ijenut Edeke, konye aitelekarit ajenu Edeke yes, ikonakinete ai iboŋorete bobo mama ejaas nugeet nuekalanyaka ka nukibakor nuikotosi yesi kitubulesenoto bobo? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
