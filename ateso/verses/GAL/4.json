              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye abala ebe ekeruman naeriŋar erai ikoku, emamei atiaketait ka ebulesit, karaida kerai ejakait loka kere; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "konye eyaito ŋes ikedarak ka ikeŋadak aitodol apak naetetemit papake. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        },
        {
