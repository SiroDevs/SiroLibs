            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido naarai iraas odwe, abu Edeke kijuk Emoyo loka Okokuke otauonowok, loiworoi ebe, “Abba, Papa!” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
