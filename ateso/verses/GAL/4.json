            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikadwe, luariebar bobo bala nakedounon, aitodol naesubunere Kristo kotomakus, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.19",
            "verseOrgIds": [
