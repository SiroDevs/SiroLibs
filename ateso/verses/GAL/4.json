                {
                  "text": "1 Kor 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye ijenete ebe abu kalimonok yes Akiro Nukajokak irwan nasodit kanuka akalanyanut naka akuan; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
