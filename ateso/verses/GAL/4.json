              },
              "items": [
                {
                  "text": "Pes 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye naadolio apak naabeit, abu Edeke kijuk Okokuke, lokewuruuni aberu, lokewuruunio koyaito ikisila, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.4",
            "verseOrgIds": [
              "GAL.4.4"
            ]
          }
        },
        {
