              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ŋol loka abulesit keurio kwape ejaar akuan, konye loka naijakakai kanuka aisumunet. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.23",
            "verseOrgIds": [
