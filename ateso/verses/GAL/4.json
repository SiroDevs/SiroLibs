            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Oni da kwape kwaŋin, nakirokor kirai idwe, karaas ibulesin luka kanugeet nuka akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.3",
            "verseOrgIds": [
              "GAL.4.3"
            ]
          }
        },
        {
