                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Yerusalem lokokuju ŋes naijakakai, ŋes ŋin totowok. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.26",
            "verseOrgIds": [
