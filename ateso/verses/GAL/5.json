              },
              "items": [
                {
                  "text": "Asw 15:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotoma aosikin ŋin abu Kristo koosik oni; kanuka ŋun kicata, kwabo sirikilomasi bobo ajookot naka ebulesene.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.1",
            "verseOrgIds": [
              "GAL.5.1"
            ]
          }
        }
      ]
