              "type": "text"
            }
          ]
        },
        {
          "text": " Kayau oyekalu, kitem ategerio, alalaukee ikubitin ikanykape epuwai, ka ikubitin ikanykape epuwai, nakerai alalau naka ewema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alalau naka alomaret ikubitin itomon; isiepiort luka alomaret keraas ikubitin ikany epuwai, ka ikubitin ikany da epuwai; kitem aojauke, ikubitin akaisaoŋon, alalauke ikubitin akaisaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi alomar toma, kitem ŋinitegerioit naka alomaret, ikubitin iarei; ka alomaret, ikubitin ikanykape; alalau naka alomaret, ikubitin ikanykaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
