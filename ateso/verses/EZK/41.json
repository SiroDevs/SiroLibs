          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwaŋin kejai ereet loka etuŋanan atereikina edukudukut kepuwai, ka ereet loka ikoku yenika eŋatuny atereikina edukudukut kepuwai. Kiswamatai kwaŋin anatar etogo kere airimor; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
