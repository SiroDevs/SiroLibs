              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitem aojauke, ikubitin akaisaarei, alalauke da ikubitin akaisaarei, koiŋaren keyekalu: katema eoŋ atiar, “Na ŋes aibois nakalaunan noi.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
