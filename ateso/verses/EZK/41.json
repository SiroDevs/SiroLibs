                "loc": "1CO.13.12"
              },
              "items": [
                {
                  "text": "1 Kor 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ariri naka ikekia, ka apedon nuagolokino, ka ibalasan luirimorito aiculetakee auni atereikina ariri naka ekek keraparito akito kowaitin kere, anyoun kokwap aitodol apedon; ido keraparitai apedon: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "aitodol apak nakejai kuju kekek kiton togo lokotoma, kokina da, karwatat da kere airimor kotoma, kokina da, kaitemis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
