          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kegeritai ikerubin ka idukudukun anyoun kokwap kiton kuju okek: kikoni nen arwatat naka eyekalu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
