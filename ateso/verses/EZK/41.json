            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido eyekalu ka aibois nakalaunan da kere ajaas ikekia iarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.23",
            "verseOrgIds": [
