          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araas ikirigin luka abaoi aarei, abaoi aarei nuesukonokinos; abaoi aarei nuka ekirigi ediopet, ka abaoi aarei nuka ekirigi lokiareit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido kegerakinitai okirigin luka eyekalu, ikerubin ka idukudukun, kwape ageritere arwatatin; ido kinaren kagola nalomaret kokina, kejaas abaoi nueburok nuka akito. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
