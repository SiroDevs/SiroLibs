                  "text": "Mat 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tetere kitodoku adedeŋ ainyania, ebwaik eoŋ akeokot atiida naelapat, kinyeis arapara. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.8",
            "verseOrgIds": [
              "EZK.24.8"
            ]
          }
        },
