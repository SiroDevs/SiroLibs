            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalimokis ituŋa ebe, “Kitejenunai sio anyoika akiro nu kamakosi, iswamaa kwana?” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.19",
