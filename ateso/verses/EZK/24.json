            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabala kes ebe, “Abu akirot naka EJAKAIT kobu mama ajai ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.20",
            "verseOrgIds": [
