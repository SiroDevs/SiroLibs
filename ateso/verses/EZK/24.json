                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kidiny, konye eililina; sirikikuudian nakatwan. Koen ekonigoe loka akou, konap akonimuk kakejekon; sirikirapak aituk, karaida ainyam atap naka ikebworok.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.17",
            "verseOrgIds": [
