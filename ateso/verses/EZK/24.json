                "loc": "DEU.12.16"
              },
              "items": [
                {
                  "text": "Ikis 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ejaas akeokot kidinike; ebwaiki atiida naelapat; mam ebukokinit alup, arapar kapua. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.7",
            "verseOrgIds": [
              "EZK.24.7"
            ]
          }
