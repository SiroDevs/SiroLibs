              "items": [
                {
                  "text": "Nak 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.12"
              },
              "items": [
                {
                  "text": "Kbk 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun inera kwanata Ejakait EDEKE ebe: Itukwi ere lokaokot! Etopoloori da atukot nakakito. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.9",
            "verseOrgIds": [
              "EZK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicul akito, kinokok akim, kipo noi akiriŋ, kisidiki acece, kosisioto akojo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.10",
            "verseOrgIds": [
              "EZK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
