              "items": [
                {
                  "text": "Sab 27:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ‘Kolimok ekek loka Isirael ebe, Inera kwanata Ejakait EDEKE ebe: Koany, amunaari akaibois nakalaunan, eitur loka apedorikus, naimielas akonyekus, eipud da loka aijarakus; ibiroros ikusidwe lusap ka lupesur kekilen, luipotu koialakis, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.21",
            "verseOrgIds": [
              "EZK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.16.6"
              },
              "items": [
                {
                  "text": "Yer 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iswamaete yesi da kwape eswamaa eoŋ: mam irapakinete aitukekus, kwabo mam inyamete atap naka ikebworok. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.22",
            "verseOrgIds": [
              "EZK.24.22"
            ]
          }
        },
