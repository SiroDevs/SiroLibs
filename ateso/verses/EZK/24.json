              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kener kituna tupuruc; kotwana akaberu eboŋ. Keswama atupurue naee kwape kecorakinetere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.24.18",
