                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Perusia ka Lud ka Put keiaas aiorekon, ikajiokokon: kikaianakinete ibukui ka akopiran tomakon; kiturito akoniiokis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keiaenenas ituŋa luka Arubad nepepe kaiorekon kuju arwatatinikon airimor, kejaenenas Igamain toma abwasinikon: kikajanakinete ibukuikec arwatatinikon airimor; itodolito ajokisikon.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
