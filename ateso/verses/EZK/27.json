                {
                  "text": "2 Siit 20:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kerai Tarusis ekagwelanaranikon kanuka aipues naka abar nakipoŋesio luipu; kisiceanarete epuesa, ka asua, ka adebe, ka asasin kanuka iborokon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.5"
              },
              "items": [
                {
                  "text": "1 Siit 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "Yok 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yaban, ka Tubal, ka Mesek, keraas ikagwelanarakakon; kisiceanarete kesi awat nuka ituŋa ka iboro luka aisinin kanuka igwelanarakon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.3"
              },
              "items": [
                {
                  "text": "Age 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.6"
              },
              "items": [
                {
                  "text": "1 Siit 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisiceanarete lukokek loka Togaruma ibalasin ka ibalasin luka ejie ka inyubun kanuka iborokon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.7"
              },
              "items": [
                {
                  "text": "Age 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.9"
              },
              "items": [
                {
                  "text": "1 Siit 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keraas ituŋa luko Dedan ikagwelanarakakon: keraas apujana nuipu agwelanaret naka akanikon: kiinununete ikela luka itomei ka eboni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:15",
              "type": "text"
            },
            {
              "text": "eboni ŋes ekitoi lokirionon.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aisiceanar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai Edom ekagwelanaranikon kanuka aipues naka aswamisiokon: kisiceanarete imeralidin, ka lumugeik, ka aswam naesonyitai, ka ebaputa loejok, ka koral,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:16",
              "type": "text"
            },
            {
              "text": "imeralidin ka koral eraas amor nukeriai.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka amor da nukareŋak kanuka iborokon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.9"
              },
              "items": [
                {
                  "text": "1 Ika 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Asw 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yuda ka akwap naka Isirael keraas ikonikagwelanarak: kisiceanarete akima nuka Minit, ka Panag, ka esik ka akinyet, ka emim kanuka igwelanarakon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai Damasiko ekagwelanaranikon kanuk: aipues naka aswamisiokon, kanuka aipues naka abar nakipoŋesio luipu kebino loka Kelubon, ka ajul nuekwanak nuka amerekekin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiecanaret Bedan ka Yaban iusio kanuka iborokon: asua nuepwatat, ekasia, ka akalamu keraas igwelanarakon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.19",
            "verseOrgIds": [
              "EZK.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.3"
              },
              "items": [
                {
                  "text": "Age 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kerai Dedan ekagwelanaranikon loka igoei luketiai lukibwanenis. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.20",
            "verseOrgIds": [
              "EZK.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
