            "sid": "EZK 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.13"
              },
              "items": [
                {
                  "text": "Age 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.29"
              },
              "items": [
                {
                  "text": "1 Siit 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arabia, ka ikapolok kere luko Kedar, keraas ŋul ikagwelanarak luka akanikon; imerekekin ludidik, ka imerekekin ka akinei keraas ikagwelanarakakon luka ŋul. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.21",
            "verseOrgIds": [
              "EZK.27.21"
            ]
          }
        },
        {
