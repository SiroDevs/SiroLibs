            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ikagwelanarak luko Seba ka Raama keraas ikagwelanarakakon: kisiceanarete luitelekarito kere kalueuru maa, ka amor kere nuketiai, ka esabu, kanuka iborokon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.22",
            "verseOrgIds": [
