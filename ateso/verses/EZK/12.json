        },
        {
          "text": "“Okoku loka etuŋanan, konyam ikoninyamat, komarani, komat akipikon komarani, kisorirai, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
