              },
              "items": [
                {
                  "text": "Yak 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kanuka nun inera kwanata Ejakait EDEKE ebe: Naarai itopoloor kanuka aojau, ido ejai aidike odouon, ikeuna eketau kanuka aiceleleke; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.10",
            "verseOrgIds": [
              "EZK.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "eiaikini ŋes akan naka lokapedor loka atekerin; abeit iswamakini ŋes kwape ejaatar nukaronokoke, Ereŋea ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.11",
            "verseOrgIds": [
              "EZK.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.7"
              },
              "items": [
                {
                  "text": "Esk 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.5"
              },
              "items": [
                {
                  "text": "32:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajepata ŋes imo, lusogim luka atekerin, enyekis. Ibiroros atenueikike koronan kaditono da kere, abilas atoromake kotoma alelesia kere nuka akwap; anyoutu atekerin kere nuka akwapin kotolimike, enyekis ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.18.6"
              },
              "items": [
                {
                  "text": "Isa 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iboikinos akweny kere nuka apak akuanake naibiroro, ejaunos itiaŋ kere luka ais atenueikike: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.82.7"
              },
              "items": [
                {
                  "text": "Sab 82:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.18"
              },
              "items": [
                {
                  "text": "Esk 32:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere mam itopoloori imodiokitoi kere yeneapias kakipi kaoiauke, karaida aitodol aidike odouon, karaida lukapedorike aibwo kaicelelekee, kere luemasete akipi: naarai ijaikinio kere atwakare, kiton atutubeta nukokwap nuka akwap, kokidin odwe luka ituŋa, nepepe kanul kaluijesaros Aipany.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.14",
            "verseOrgIds": [
              "EZK.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
