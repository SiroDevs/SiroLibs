            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Okoku loka etuŋanan, kite idwe luka Amon, kodwarak kes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
