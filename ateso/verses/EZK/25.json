              },
              "items": [
                {
                  "text": "Age 45:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " asa do koany, keiaikini jo araun airumet naka idwe lukokide, idukurete kesi tomakon, edukokinete ikeeetogoi tomakon; enyamcte akoniraito, emascte da akonikile, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
