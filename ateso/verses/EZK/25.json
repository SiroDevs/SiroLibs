            "number": "3",
            "style": "v",
            "sid": "EZK 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.17.5"
              },
              "items": [
                {
                  "text": "Awa 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok idwe luka Amon ebe, Kiirasi akirot naka Ejakait EDEKE; Inera kwanata Ejakait EDEKE ebe: Naarai iner atiar, ‘Uus!’ aimwaŋ akaibois nakalaunan, nakemunaaror; aimwaŋ da akwap naka Isirael, nakitisilere; aimwaŋ da ekek loka Yuda, nakiioreorere; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
