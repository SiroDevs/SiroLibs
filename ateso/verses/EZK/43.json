            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma aibuses naka EJAKAIT oyekalu korot loka erute loeseseni kide. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
