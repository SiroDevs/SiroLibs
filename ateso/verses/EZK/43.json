                  "text": "1 Ika 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kadaka Emoyo eoŋ, kayana kiton alaro nakotoma; ido koany, kileleba aibuses naka EJAKAIT togo.",
