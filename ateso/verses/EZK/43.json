              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lo ŋes ekisil loka etogo: kuju aidi naka eronat kiton osaŋeke kere airimor eraun nakalaunan noi. Koany, ŋol ŋes ekisil loka etogo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
