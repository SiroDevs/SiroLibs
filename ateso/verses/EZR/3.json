              "attrs": {
                "loc": "NUM.29.12"
              },
              "items": [
                {
                  "text": "Mar 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koricata epueit loka iswamin, kwape kiwadikatere, koinakis ainakineta nuicweio nuka ŋinipaaran kwape eiaar etiaikec, kwape eiaar aicorakinet, kwape ibusakinitor ninipaaran; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.38"
              },
              "items": [
                {
                  "text": "Any 29:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.3"
              },
              "items": [
                {
                  "text": "Mar 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kokau ainakinet naicweio natir, ka ainakineta nuka nailamununia elap, ka nuka ipueino kere luka EJAKAIT lueeorakinitai luatiakunitai, ka nuka nmitunanan yenabu koinak atai ainakinet naka akot neejai EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaaran nasodit naka elap lokikanyetekaarei ŋes ageuniata ainakin ainakineta nuieweio neejai EJAKAIT: konye korina kesipokina apeteta nuka eyekalu loka EJAKAIT, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "verse",
