              },
              "items": [
                {
                  "text": "Ikis 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kobwo Yesua okoku laka Yosadak, ka ikeinaean isasedotin, ka Serubabel okoku laka Sealutiel, ka ikeinaean, kodukoto etem laka Edeke loka Isirael, ainanakinia kanen ainakineta nuicweio, kwape kiwadikatere kokisila luka Musa etuŋanan loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.38+EXO.29.39+EXO.29.40+EXO.29.41+EXO.29.42"
              },
              "items": [
                {
                  "text": "Any 29:38-42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosipokis etem aiboisike; naarai akuriaka kesi ituŋa luka akwapin kanun: koinanakis kanen ainakineta nuieweio neejai EJAKAIT, ainakineta nuieweio tupuruc ka eboŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
