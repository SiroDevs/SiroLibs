              "items": [
                {
                  "text": "Esr 2:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kobwo Yesua nepepe kodweke ka ikeinaean, Kadumiel da ka odweke, odwe luka Yuda kere nepepe, aroanar ikeswamak luka etogo laka Edeke: odwe luka Kenadad ka odwekec ka ikeceinacan Ilebin.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        }
