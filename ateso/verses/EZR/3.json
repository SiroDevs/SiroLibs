            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinakis da ikadukok ka ikekeok apesan; ka lunyaman ka lumatan ka akinyet neejaas luko Sidon, ka luko Turo, alemun iresia koLebanon ayaun kiton aŋolol kiton Yopa, kwape kejaar aeamakinet naka Kuro eka baka loko Perusia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
