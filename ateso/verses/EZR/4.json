        },
        {
          "text": " Kosodete ituŋa luka akwap kitakalanyanata akanin nuka ituŋa luka Yuda, kisiyalononoto kes kotoma aiduk, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
