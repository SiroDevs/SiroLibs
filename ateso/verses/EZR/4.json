            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete kiwadikata Rekum lokebuku, ka Simisai ekewadikan, ka iukaupakec ice kere; Idinaitin, Iparasatakain, Itarapelin, Ipasian, Irakebain, Ibabulonin, Isusanikin, Idekain, Ilamein, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.9",
            "verseOrgIds": [
              "EZR.4.9"
            ]
          }
        },
