              "items": [
                {
                  "text": "Rom 8:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiwadikata Rekum lokebuku, ka Simisai ekewadikan ebalua mama ejai Aratasasata ekabaka asurokin Yerusalem kopone kalo: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
            "verseOrgIds": [
              "EZR.4.8"
            ]
          }
        },
        {
