          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "koropata ikapetak akiro aluikin kes, aitikokin akeeeinerun, apaarasia kere nuka Kuro ekabaka loko Perusia, aitodol naerumia Dario ekabaka loko Perusia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
