          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kairum naka Akasuero, ageunet naka airumuke, kiwadikata aosan lukiboiete ko Yuda ka Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
