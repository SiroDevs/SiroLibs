                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka atekerin ace kere nukitwobotuni Osunapar lokapolon lokaibuses, kibwaik ore loka Samaria, ka akwap ace da okekwa juwai, ka ace da, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.10",
            "verseOrgIds": [
              "EZR.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikopuna nu kobalua lokijukakinete kesi: “Aratasasata ekabaka: Ikonikejaanakinak, ituŋa luka okekwa juwai, ka ace da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.11",
            "verseOrgIds": [
              "EZR.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 4:12"
          },
          "items": [
