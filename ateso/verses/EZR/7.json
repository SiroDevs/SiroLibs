              "type": "text"
            }
          ]
        },
        {
          "text": " Koloto ice kodwe luka Isirael, ka luka isasedotin, ka Ilebin, ka ikayook, ka ikagolok, ka Inetinim, kopotu Yerusalem, kokaru lokikanyetekaarei loka Aratasasata ekabaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.7",
            "verseOrgIds": [
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobu neai Yerusalem kolap lokikanyet kokaru lokikanyetekaarei loka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8",
            "verseOrgIds": [
              "EZR.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 7:9"
          },
          "items": [
