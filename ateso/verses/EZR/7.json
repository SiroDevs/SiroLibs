            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai abu Esera kibwaikinite eketau amoot ikisila luka EJAKAIT, ka aiswamaenen da, ka aisisianakin toma Isirael ikisila ka itubesia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
