          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ŋes aikopunet naka ebalua loabu ekabaka Aratasasata koinak Esera esasedoti, ekewadikan, ŋes ekewadikan loka akiro nuka aicorakineta nuka EJAKAIT, ka loka ikisilake mama ejai Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
