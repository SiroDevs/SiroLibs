          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiton atalatan akwatat nuka epuesa, ka aitemisio akwatat nuka akima, ka akaalakanya akwatat nuka ebino, ka akaalakanya akwatat nuka akinyet, ka abalaŋ namam ebilunitai etiaike. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
