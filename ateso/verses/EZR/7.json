              },
              "items": [
                {
                  "text": "Esr 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Aratasasata, ekabaka loka ikabakan, mama ejai Esera esasedoti, ekewadikan loka ikisila luka Edeke laka akuj, loedolit, ka ace da. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebwaikini ekisil, mama ejaas ŋul kere lukotuna luka Isirael, ka ikecesasedotin, ka Ilebin, lukotoma ayaetaitika, luekotos alosit Yerusalem kanukec, kouparos kaio, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.1.14"
              },
              "items": [
                {
                  "text": "Est 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kijukarit jo ekabaka ka ikekenerunak ikanykaarei, aiŋitun akiro nuka Yuda ka Yerusalem, kwape ejaatar ikisila luka Edekekon lueiaas akanikon; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
