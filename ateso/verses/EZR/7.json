            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okoku loka Amaria, okoku loka Asaria, okoku loka Meraiot, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
