              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ŋes ibusakinitor ainyikokin noi agwel kiboro kalu imoŋin lutoba, imerekekin, imerekekin ludidik, ka ainakinetakec nuka akiria, ka ainakinetakee numatan, ijaikini kotem loka etogo loka Edekekus loejai Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
