            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epuesa da ka esabu kere loidumuni kobuku kere loko Babulon, nepepe ka ainakineta nuka akot nuka ituŋa ka nuka isasedotin, nuainakinete kanukee kanuka etogo loka Edekekec loejai Yerusalem; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
