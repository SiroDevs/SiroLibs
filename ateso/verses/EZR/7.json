                "loc": "NEH.2.8"
              },
              "items": [
                {
                  "text": "Nek 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kapaaran nasodit naka elap losodit ŋes ageunia ŋesi anyoun koBabulon, kapaaran da nasodit naka elap lokikanyet ŋes adolio Yerusalem, kanuka akan nakaiokan naka Ekedeke naaiai kaŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.9",
            "verseOrgIds": [
              "EZR.7.9"
            ]
          }
        },
        {
