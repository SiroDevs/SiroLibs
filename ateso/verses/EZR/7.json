            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koyana da epuesa ka esa bu, luainakis ekabaka ka ikekenerunak kanukec mama ejai Edeke loka Isirael, loiboienenei koYerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
