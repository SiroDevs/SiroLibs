            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinibore kere yenitojoki jo ka ikoniinaean aitwasamaa epuesa ka esabu loedeuna, kiswamata kwape ekotor Ekusideke, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iboro da lukiinakinio kanuka aijaanakin nakotogo loka Ekusideke, koinak kakonyen nuka Edeke laka Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
