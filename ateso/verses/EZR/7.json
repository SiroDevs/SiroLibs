          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "koku loka Abisua, okoku loka Pinekas, okoku loka Eleasar, okoku loka Aaron esasedoti lopeti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
