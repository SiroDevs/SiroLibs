                  "text": "Kag 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ŋupeŋul etolomuni Kuro ekabaka loko Perusia kakan naka Mituredat ekeŋadan, kimarak Sesebasar, ekapolon laka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lo ŋes etiaikec: atuba akaisauni nuka esabu, atuba alukumit nuka epuesa, ikileŋa akaisaarei ka lukanykaoŋon: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.9",
            "verseOrgIds": [
              "EZR.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "atiboi akaisauni nuka esabu, atiboi nuka epuesa nuka epone lokiareit akwat aoŋon ka itomon, ka iboro ice elukumit. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iboro kere luka esabu ka luka epuesa emwaasi ilukumin ikany ka akwat aoŋon, Abu Sesebasar koyaŋau ŋul kere, nakeyaŋauniata luejoreoritai anyoun koBabulon kiton Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
