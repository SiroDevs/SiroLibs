        },
        {
          "text": " Ŋin yenejai kayes kotuŋake kere, kojai Ekedeke kaŋes, kolot Yerusalem, loejai toma Yuda, koduk etogo loka EJAKAIT, Edeke loka Isirael, ŋes Edeke, loejai Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.3",
            "verseOrgIds": [
              "EZR.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
