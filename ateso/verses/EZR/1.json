            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋul da kere lualukunitos kitogogoŋoto akecekanin kanuka iboro luka epuesa, ka esabu, ka iboro, ka ibaren, ka iboro luka etiai loepol, komam imarakinito kere luainaldnito kanuka akot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
