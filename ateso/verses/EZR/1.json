              "type": "text"
            }
          ]
        },
        {
          "text": " Kitolom Kuro da iboro luka etogo loka EJAKAIT, luabu Nebukadanesar kolem koYerusalem, kibwaik abila naka idekesioke; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
