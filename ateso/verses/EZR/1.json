              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete konyout lukapolok luka ikekia luka Yuda ka Benyamin, ka isasedotin, ka Ilebin, kere luabu Edeke kisidik ikecetauon alosit aiduk etogo loka EJAKAIT loejai Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
