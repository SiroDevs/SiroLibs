          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenesalit da kere, kaŋiniibois naiboiororor, kiŋarakis ituŋa luka aiboisike kepuesa, ka esabu, ka iboro, ka ibaren, komam imarakinito ainakineta nuka akot nuka etogo loka Edeke loejai Yerusalem.’’’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.4",
            "verseOrgIds": [
              "EZR.1.4"
            ]
          }
        }
