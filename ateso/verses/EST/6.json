        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriŋa kesi inerasi kaŋes, kopotu ibwaein luka ekabaka, kisunyasi ayaare Kaman opucit loepoit Esita.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
