                "loc": "EST.2.19"
              },
              "items": [
                {
                  "text": "Est 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.131.1"
              },
              "items": [
                {
                  "text": "Sab 131:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.30"
              },
              "items": [
                {
                  "text": "2 Sam 15:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koboŋo Morudekai orute loka ekabaka. Konye kiwonya Kaman alosit oreke, ekadakinit kimukorite da akekou. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitatamik Kaman Seres akeberu ka ikepapero kere nuadoikinito ŋes kere, Kosodete iketuŋa lukacoa ka Seres akeberu atemar ŋes atiar, “Morudekai loigeu ijo aibiror kakonyeneke, arai erai loka aur naka lyudayan, mam ipikori ijo ŋes, konye abeit ibirori kakonyeneke.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
