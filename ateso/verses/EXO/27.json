              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido icorakini idwe luka Isirael, koinutu akinyet naejok naka eseitun naerukuk kanuka aica, aitonokia atala tiritir. ",
          "type": "text",
          "attrs": {
