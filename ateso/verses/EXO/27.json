              "type": "text"
            }
          ]
        },
        {
          "text": " Iswamauni etem loka akito nuka sita, aoiauke ikubitin ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "ekubit itemi alalau bala 1’ 6”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ikany, alalau ikubitin ikany: korai etem loka agoria aoŋon nueriakanara: akemukurur da korai ikubitin iuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.1",
            "verseOrgIds": [
              "EXO.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 27:2"
          },
