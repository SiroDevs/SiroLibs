                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.28"
              },
              "items": [
                {
                  "text": "2:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.27"
              },
              "items": [
                {
                  "text": "Sab 118:27",
