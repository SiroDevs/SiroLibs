              "type": "text"
            }
          ]
        },
        {
          "text": " Kiyataki eporoto loka arupepe airu noi, kiner Musa, Koboŋok Edeke ŋes keporoto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
