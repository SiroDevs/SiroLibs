                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tetere itemonokino kapaaran kanakiwuniet: naarai kapaaran kanakiwunier edokuni EJAKAIT moru Sinai kakonyen nuka ituŋa kere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
