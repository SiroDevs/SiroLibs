            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodoka Musa mama ejai Edeke, konyara EJAKAIT ŋes moru, kobala ebe, “Itemari kwanata ekek loka Yakob, kolimok idwe luka Isirael ebe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.3",
