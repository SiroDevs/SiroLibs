                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ‘Ipotu koanyutu nuabu keswamak Imisirian, ido kwape kadakuniata yes kabebenoka nuka emorukaalet, ido kwape kayauniata mama ajai. ",
          "type": "text",
          "attrs": {
