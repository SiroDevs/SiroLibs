              "type": "text"
            }
          ]
        },
        {
          "text": " Kitalaunos isasedotin da luikunyakinete EJAKAIT, kinyek EJAKAIT ailamar neejaas kesi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
