              "type": "text"
            }
          ]
        },
        {
          "text": "Kolap kalokiwuniet kedaut idwe luka Isirael anyoun kakwap nako Misiri, kodoloto kapaaran kaŋin amodiŋ naka Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenyout koRepidim, kedoloto da amodiŋ naka Sinai, kibubukis iweman modiŋ; kidukuru Isirael kinaren kemoru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
