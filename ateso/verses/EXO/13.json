                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido imerekek ilakununia ŋinikiyal yenika asigiria; arai mam ipuda alakun, ibili do emurisinike: ilakununei ikiyaik kere luka ituŋa kodwekon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.13",
            "verseOrgIds": [
              "EXO.13.13"
            ]
          }
        },
