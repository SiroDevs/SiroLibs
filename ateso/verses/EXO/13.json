            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Musa ituŋa atiar, “Kiitununete apaaran na, nailomuniata koMisiri, kotogo loka ebulesene; naarai abu EJAKAIT kitolom yes kagogoŋ naka akan kaibois kaŋin: sirikinyama imugatin luitubuunitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.3",
            "verseOrgIds": [
              "EXO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 13:4"
          },
