            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi nakitodolio EJAKAIT jo akwap naka Ekanaanit, kwape kolo eyapoikinia jo ka lukapapaakon, kiinakini da, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.11",
            "verseOrgIds": [
              "EXO.13.11"
            ]
          }
        },
        {
