          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14"
              },
              "items": [
                {
                  "text": "Any 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
