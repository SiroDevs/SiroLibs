              "items": [
                {
                  "text": "Mat 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eluor aanyunet kakanikon, aisiitunet da kokidiŋ kakonyekon, tetere ejaun ekisil loka EJAKAIT aitukukon: naarai abu EJAKAIT kitolom jo koMisiri kakan nakagogon, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.9",
            "verseOrgIds": [
              "EXO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋes ibusakinitor aricenen ekisil ŋol kapakike nolikaru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.10",
            "verseOrgIds": [
              "EXO.13.10"
            ]
          }
        }
      ]
    },
