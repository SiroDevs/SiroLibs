            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun aanyunet kakanikon, ka nakoreet kokidin kakonyekon: naarai abu EJAKAIT kitolom oni koMisiri kagogon naka akan.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.13.16",
