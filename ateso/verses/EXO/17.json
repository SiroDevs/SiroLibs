        },
        {
          "text": " Kolot ekodet kere loka idwe luka Isirael anyoun kamodiŋ naka Sin, kobwosenenete, kwape ajaar aicorakinet naka EJAKAIT, kidukuroto Repidim: konye komamuut akip nuemasete ituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
