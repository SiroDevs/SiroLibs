              "items": [
                {
                  "text": "Yos 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.23"
              },
              "items": [
                {
                  "text": "Yob 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
