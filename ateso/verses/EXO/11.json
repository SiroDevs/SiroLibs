                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.9.4"
              },
              "items": [
                {
                  "text": "Est 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinak EJAKAIT ituŋa aminunio kakonyen nuka Imisirian. Bobo da kitopolooroi Musa kakwap nako Misiri, kakonyen nuka ikejaanakinak luka Parao, kakonyen da nuka ituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.3",
            "verseOrgIds": [
              "EXO.11.3"
            ]
          }
        }
      ]
    },
