              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kolot etuŋanan lokokek loka Lebi komany akoku naka Lebi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.1",
            "verseOrgIds": [
              "EXO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.20"
              },
              "items": [
                {
                  "text": "Asw 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.23"
              },
              "items": [
                {
                  "text": "Bur 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopotuu aberu, kouru ikoku yenitelepat: konye keanyu ebe ejokuna, kibwa ber ŋes ilapio iuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.2",
            "verseOrgIds": [
              "EXO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi keanyu ebc mam epedori aibwait bobo, koyaŋa eijaŋ loka aladoi, kinyonyo erit ka emina, kibwaik ikoku toma, kibwaik okido ariri naka ecor. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.3",
            "verseOrgIds": [
              "EXO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Any 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.59"
              },
              "items": [
                {
                  "text": "Mar 26:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobwoi kinacike kaneelwana, ajenun nuedoikinete ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.4",
            "verseOrgIds": [
              "EXO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Asw 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolot akoku naka Parao ailoŋ ocor; koloto apesuruke ariri naka ecor; koany eijaŋ kokido, kijukak akebulesit alemun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.5",
            "verseOrgIds": [
              "EXO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopuko, koany ikoku; ido ko any, komony ikoku. Kitim, kobala ebe, “Yen ŋes idiopet kodwe luka Iburanian.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.6",
            "verseOrgIds": [
              "EXO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kinacike kotema akoku naka Parao ebe, “Alosi ca kanyarak jo aketanakan kaŋor nuka Iburanian kitanakik ikoku?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.7",
            "verseOrgIds": [
              "EXO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema akoku naka Parao atiar, “Kolot.” Kolot apese konyarau toto naka ikoku alopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.8",
            "verseOrgIds": [
              "EXO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema akoku naka Parao atiar, “Koyaŋa ikoku yen kitanakik, eoŋ da kainakini jo eropitikon.” Koyaŋa aberu ikoku, kitanak. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.9",
            "verseOrgIds": [
              "EXO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.21"
              },
              "items": [
                {
                  "text": "Asw 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopoloor ikoku, koinu akoku naka Parao, koluor ikekoku. Komaik ekekiror Musa, koba la ebe, “Naarai alemuni kakipi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.10",
            "verseOrgIds": [
              "EXO.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 2:10"
          },
          "items": [
            {
