            }
          ]
        },
        {
          "text": " Kolem Musa aokot kobwatanak otuŋa, kobala ebe, “Koanyutu aokot nuka aitutuket, naetutuk EJAKAIT kayes kotoma akiro nu kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.8",
            "verseOrgIds": [
              "EXO.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
