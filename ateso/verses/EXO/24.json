              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyut kesi Edeke loka Isirael; kwap kakejeke kosubite bala aswam naka amor nuepesitai nuka asapiro, nueputos aipioror naka akuj alopet. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
