              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam kereka ijenete ebe loijaikinos bonik arimar kwape ibulesin, iraas do ibulesin luka ŋol kaloirimarito, arai adiakar naeyauni atwanare, arai bo arima naeyauni adolit? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.16",
            "verseOrgIds": [
              "ROM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kimalai Edeke, naarai iraas kolo ibulesin luka adiakar, konye ipotu korimasi kotauonokus aput naka aisisianakin nakiinakinio yes, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
