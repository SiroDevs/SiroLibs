            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kinye adiakar airum awatekus nuetwakete, yes arimar aiŋobelekec, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
