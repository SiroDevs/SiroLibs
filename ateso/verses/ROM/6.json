        {
          "text": "Naarai nakiraatar ibulesin luka adiakar, kiwosikinitai anyoun kadolit. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.20",
            "verseOrgIds": [
              "ROM.6.20"
