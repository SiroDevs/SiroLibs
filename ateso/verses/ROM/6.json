                "loc": "JHN.8.32"
              },
              "items": [
                {
                  "text": "Yok 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ido nakiwosikinere anyoun kadiakar koraut ibulesin luka adolit. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.18",
            "verseOrgIds": [
              "ROM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enera eoŋ kopone loka etuŋanan kanuka akalanyanut naka awatekus. Naarai kwape kijaikiniata kolo atutubetakus aitwasamao kotoma amodokok, ka epali loeyauni epali, kwape kwaŋin kijaikis do kwana atutubetakus aitwasamao kotoma adolit naeyauni aitalaunio.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.19",
            "verseOrgIds": [
              "ROM.6.19"
            ]
          }
        }
      ]
