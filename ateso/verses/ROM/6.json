              "ROM.6.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.10"
              },
              "items": [
                {
                  "text": "Pil 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai arai kirotakinitai kaŋes kotoma aput naka atwanareke, kwape kwaŋin kirotakinio kotoma aput naka ajarunike. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.5",
            "verseOrgIds": [
              "ROM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.24"
              },
              "items": [
                {
                  "text": "Gal 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijeni na ebe aponi etuŋananiwok lokolo kibubukinoi kaŋes, tetere itapalaunio akuan nakadiakanar, komam bobo adiakanar kitubuleseni oni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.6",
            "verseOrgIds": [
              "ROM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.1"
              },
              "items": [
                {
                  "text": "1 Pet 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai yenatwana eosikinitai anyoun kadiakar, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.7",
            "verseOrgIds": [
              "ROM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kipou katwaka nepepe ka Kristo, kiyuunit ebe kijari da nepepe kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.8",
            "verseOrgIds": [
              "ROM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijeni ebe kedau Kristo ajarun kokatwak, mam etwani bobo, mam bobo atwanare eyait ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.9",
            "verseOrgIds": [
              "ROM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.26+HEB.9.27+HEB.9.28"
              },
              "items": [
                {
                  "text": "Bur 9:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.19"
              },
              "items": [
                {
                  "text": "Gal 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.18"
              },
              "items": [
                {
                  "text": "1 Pet 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai atwanare naketwani, abu kotwanik adiakar irwan atipet bon, konye aijar naejari, ejari mama ejai Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.10",
            "verseOrgIds": [
              "ROM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.15"
              },
              "items": [
                {
                  "text": "2 Kor 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yes da kwape kwaŋin koomito bonik araut lukatwak kama ejai adiakar, konye ikajarak mama ejai Edeke kotoma Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.11",
            "verseOrgIds": [
              "ROM.6.11"
            ]
          }
        }
      ]
