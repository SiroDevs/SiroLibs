              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.5"
              },
              "items": [
                {
                  "text": "Pes 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.14"
              },
              "items": [
                {
                  "text": "5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwabo sirijaikinete akusitutubeta mama ejai adiakar aitwasamaa amamus adolit, dimarai kijaikis bonik mama ejai Edeke, kwape ikajarak luanyout kokatwak, akusitutubeta da mama ejai Edeke aitwasamaa adolit; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
