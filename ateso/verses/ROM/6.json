            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Biai bo do? Kadiakasi, naarai mam ikisila kiyaito oni, dimarai asianut? Madi akuj! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
