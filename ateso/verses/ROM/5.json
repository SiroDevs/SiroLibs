            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " amun da mam itisili, naarai ekwamakinitai amin naka Edeke otauonowok kanuka Emoyo Lokalaunan lokiinakinitai oni.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.5",
            "verseOrgIds": [
              "ROM.5.5"
