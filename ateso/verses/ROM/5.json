                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye erumit atwanare ameun ka Adam kiton Musa, erumit da ŋesi lumam apotu kodiakasi kopone loka apaar naka Adam, loerai aput naka ŋol kaloebunit.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
