            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.23"
              },
              "items": [
                {
                  "text": "Rom 3:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanukeŋ kidumu erot loka aiyuun lokitodoli asianut ŋin nakibwoia, kiwoloboboi da kotoma amun aibuses naka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 5:3"
          },
          "items": [
