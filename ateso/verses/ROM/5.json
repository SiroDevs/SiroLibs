            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso naarai kitojokitai araun luedolito kanuka aiyuun, kajaut kainapakin mama ejai Edeke kanuka Ejakaitiwok Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
