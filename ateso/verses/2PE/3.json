              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " inerasi ebe, “Ejai bo ai aisumunet naka abunoreke? Naarai ageun netikolo ajotoorotor lukapapaawok, esalito iboro kwape ajaatar kageunet naka asubio.” ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.4",
            "verseOrgIds": [
              "2PE.3.4"
            ]
          }
        },
        {
