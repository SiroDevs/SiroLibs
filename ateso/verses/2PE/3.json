          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye iŋadakinitai akuj ka akwap nukatinenikwana akim, kanuka akirot kaŋin, idaritere kiton apaaran naka atubokinio ka amudiario naka ituŋa lumam eyoŋito Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
