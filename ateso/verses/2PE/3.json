                {
                  "text": "1 Tim 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam iyapia Ejakait aisumuneteke, kwape eomitotor ice aiyapia, konye etitiŋikinit mamakus, komam ekoto idio kayesi aolior, konye kodoloto kere aitoronikin. ",
          "type": "text",
          "attrs": {
