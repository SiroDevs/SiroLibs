              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " komunos, kimielas da noi abunore naka apaaran naka Edeke, naecalarere akuj naitonokunio, ka nugeet da ecalaros kamwanis kanaidopit. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.12",
            "verseOrgIds": [
