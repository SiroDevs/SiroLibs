                {
                  "text": "Sab 90:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye luminan, sirikimurwok akirot na adiopet, ebe, esubit adiopepaaran kama ka Ejakait, bala ikar elukumit, ka ikar elukumit da bala adiopepaaran. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.8",
            "verseOrgIds": [
              "2PE.3.8"
            ]
          }
        },
        {
