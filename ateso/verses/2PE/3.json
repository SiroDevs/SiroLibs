            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kojenutu na nasodit ebe epote ikesekelok kapaarasia nukawasia isekelete, etuparete aiŋobelekec bonik, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.3",
            "verseOrgIds": [
              "2PE.3.3"
            ]
          }
        },
