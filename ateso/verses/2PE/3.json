                {
                  "text": "2 Pet 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ŋes ainakini akwap nakolosek amudiario kakalele naka akipi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.6",
            "verseOrgIds": [
              "2PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
