          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicorak ekabaka, kobokata amor nuepolok, nuka akais nuipu, apetanakin apetetait naka etogo kamor nuikeitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
