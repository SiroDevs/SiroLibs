          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ikadukok luka Solomon ka ikadukok luka Kiram ka Igebalin kitetenata kes, kitemonokis akito ka amor adukio etogo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
