          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kogelara iiaka luka Solomon luapolokinito aswam, ilukumin iuni ka akwat auni, luayaito ituŋa lueswamaete aswam. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
