                "loc": "PRO.19.10"
              },
              "items": [
                {
                  "text": "Awa 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kaany ibulesin ibwanenito ibalasin, ka ikapolok elosete kakeie bala ibulesin kakwap.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
