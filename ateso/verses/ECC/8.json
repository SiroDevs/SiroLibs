            "verseId": "ECC.8.15",
            "verseOrgIds": [
              "ECC.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naebwaikinia ekatau aijen acoa, aanyun da aswamisio nuiswamao kakwap: (naarai ejai lomam iiri ajo kakonyeke paaran ka kuare da:) ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.16",
            "verseOrgIds": [
              "ECC.8.16"
            ]
          }
        },
        {
