                "loc": "ROM.13.5"
              },
              "items": [
                {
                  "text": "Rom 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kainakinit akirot ebe, Koricenenei aicorakinet naka ekabaka, ido kiswama ŋun kwaŋin kanuka aiyaposit naka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.2",
            "verseOrgIds": [
              "ECC.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirisunyanari anyoun kaneejai; siridonit akirot naerono: naarai iswamai ŋesi nuekoto kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.3",
            "verseOrgIds": [
              "ECC.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.34.18"
              },
              "items": [
                {
                  "text": "Yob 34:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai akirot naka ekabaka ejai apedor: iŋai da epedori atemar ŋes atiar, “Iswamai inyo?” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.4",
            "verseOrgIds": [
              "ECC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋin yenerieenenei aicorakinet mam ejenuni akirot naerono; emisiikini etau loka etuŋanan lokaeoa apak ka etube: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.5",
            "verseOrgIds": [
              "ECC.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.1"
              },
              "items": [
                {
                  "text": "Lim 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ŋinikirot ejai apakike ka etube; naarai elanirikinito noi etuŋanan icano ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.6",
            "verseOrgIds": [
              "ECC.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.22"
              },
              "items": [
                {
                  "text": "Awa 24:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.6.12"
              },
              "items": [
                {
                  "text": "Lim 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam ejeŋi nueiaunos; naarai iŋai bo epedori alimokin ŋes kwape eiaunotor? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.7",
            "verseOrgIds": [
              "ECC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.49.6"
              },
              "items": [
                {
                  "text": "Sab 49:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.5"
              },
              "items": [
                {
                  "text": "Yob 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei etuŋanan loejai apedor komoyo aitikokin emoyo; kwabo emamei ŋes apedor kapaaran naka atwanare; emamei atwario kojie, aronis da mam eyuuni ŋol loanaiki. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.8",
            "verseOrgIds": [
              "ECC.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.12"
              },
              "items": [
                {
                  "text": "1 Sam 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋun kere abu kaany, abu kebwaik ekatau toma niniswam naiswamao kokwap kakoloŋ; naeyaitor etuŋanan ediopet loce aiswamakin ŋes aronis,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.9",
            "verseOrgIds": [
              "ECC.8.9"
            ]
          }
        }
      ]
    },
    {
