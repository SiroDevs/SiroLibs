              "items": [
                {
                  "text": "Awa 1:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.3.10"
              },
              "items": [
                {
                  "text": "Isa 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.34"
              },
              "items": [
                {
                  "text": "Mat 25:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karaida iswamaenenei ekadiakanaran aronis aatenak akwatat, kosodi kobut noi, konye ajeni abeit ejaunos ejok nul lueyonito Edeke, lueyonito kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.12",
            "verseOrgIds": [
              "ECC.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye mam lokaronon ejaun ejok, kwabo mam ebusi apaarasia nuipu nuesubito bala etoribe; naarai mam eyonit kakonyen nuka Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.8.13",
            "verseOrgIds": [
              "ECC.8.13"
            ]
          }
        }
      ]
    },
