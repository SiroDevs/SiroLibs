              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai iŋai bo epedori ainyam, iŋai da epedori aiyalama adepar eoŋ? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
