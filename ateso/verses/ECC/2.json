        },
        {
          "text": " Abu katema nuka akiena atiar, “Ikerep”: ka nuka alakara da atiar, “Ajokis anyoin?” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
