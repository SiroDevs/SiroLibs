                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.28"
              },
              "items": [
                {
                  "text": "9:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ido abu katukok epuesa ka esabu ka abar naka ŋinikwap naka ikabakan ka naka lukibukui; kadum ikayook ka akayook, ka abusian nuipu noi nuisiyalamikinete odwe luka ituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        }
      ]
