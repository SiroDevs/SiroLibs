            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Yob 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.1"
              },
              "items": [
                {
                  "text": "14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai akepaarasia kere eraas ican, aitaaritoike da ŋes akadakin: eebo, kuare da mam eketau iyenuni. Ŋun da aamameak.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
