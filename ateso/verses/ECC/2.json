              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kala aitaaritoika kere naetaaritor kokwap kakoloŋ; naarai kebusakinit ainyeinia etuŋanan lokatupakini. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
