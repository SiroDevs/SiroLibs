            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.58.8"
              },
              "items": [
                {
                  "text": "Sab 58:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai keuri etuŋanan idwe akwatat, kobut da ikar luipu, kipuakaros apaarasia nuka ikekaru, konye komam eketau imonikin aiokis, ido komam enukio; abala eoŋ ebe, Ikoku yenikijecuna da itelekarit ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ebuni nin kaamameak, elosi da kamuton, erapario da ekekiror kamuton; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo da mam eanyunit akoloŋ, kwabo mam ejeŋi; ibworari nin adepar ŋol. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eebo, karaida kebut ŋesi ikar elukumit irwan aarei, komam isiyalamikinit aiokis: mam kereka eboŋokinete kere aibois adiopet?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
