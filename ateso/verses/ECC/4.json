              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi aanyun aitaaritoi kere ka niniswam kere nakapirianut, kanuka ŋun ŋes ikokotikinio etuŋanan ekeidunyet. Ŋun da eraas aamameak ka ainyam ekwam.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.4",
            "verseOrgIds": [
              "ECC.4.4"
            ]
          }
        }
      ]
    },
