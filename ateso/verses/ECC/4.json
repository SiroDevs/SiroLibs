                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋes keturio lukatwak luadaut atwakare aitelekarit lueiarete lueroko eiarete, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.2",
            "verseOrgIds": [
              "ECC.4.2"
            ]
          }
