              "items": [
                {
                  "text": "Luk 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eebo, kaomoom aitelekarit kere nin yeneroko ejauna, yenimam ber eanyunit aswamisio nukaronok nuiswamas kokwap kakoloŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.3",
            "verseOrgIds": [
              "ECC.4.3"
            ]
          }
        }
