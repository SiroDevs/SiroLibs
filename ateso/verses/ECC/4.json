              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi bobo kaany aimwaŋ kere naiswama kokwap kakoloŋ: ido koany, akiyo nuka nul kalukemwanitai, kwabo emameete luitalakarete kes; koiai da apedor neejaas luemwanito kes, konye komameete luitalakarete kes. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
              "ECC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
