                  "text": "2 Pet 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Balaam Balak atiar, “Kodukokinai itemwan ikanykaarei, kitemonok kane imoŋin ikanykaatei ka imerekekin ikanykaarei.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.29",
            "verseOrgIds": [
              "NUM.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswama Balak kwape abalar Balaam, koinak kaŋolitem emoŋ ka emerekek.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.30",
            "verseOrgIds": [
              "NUM.23.30"
            ]
          }
        }
      ]
