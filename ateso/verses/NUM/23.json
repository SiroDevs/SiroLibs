        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
            "verseOrgIds": [
              "NUM.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
