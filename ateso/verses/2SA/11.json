              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen eboŋ, konyou Daudi kaperitike, kosakasak koswi loapadalal loka etogo loka ekabaka: koswi koany aberu iloŋi; ajokuna noi aberu asesen. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.29"
              },
              "items": [
                {
                  "text": "2 Sam 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kijuka Daudi kiŋit nuka aberu. Kolimokinai ebe, “Mere ŋin Bat-seba, akoku naka Eliam, aberu naka Uria Ekitit?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
