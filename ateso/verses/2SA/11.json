                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Uria Daudi atiar, “Iboie asaduku, ka Isirael, ka Yuda koswamin; idukurito ejakaitika Yoab, ka ikejaanakinak luka ejakaitika ais; alomari kereka eoŋ togoka ainyam, ka aimat, ka apero kaberuka? Kwape ijaria ijo, kwape ejaria ekonitau da, mam eswamai kwaŋin.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        },
