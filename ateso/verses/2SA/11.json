          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijuka Daudi mama ejai Yoab ebe, “Kijukakinai eoŋ Uria Ekitit.” Kijuka Yoab Uria mama ejai Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.6",
            "verseOrgIds": [
              "2SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedolu Uria neejai ŋesi, kiŋit Daudi ŋes kwape ajaar Yoab, ka ituŋa, ido kwape ajaar ejie. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.7",
            "verseOrgIds": [
              "2SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 11:8"
          },
          "items": [
            {
