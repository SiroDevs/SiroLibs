              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Isa 28:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma Abiner okoku loka Ner, ka ibulesin luka Is-boset okoku loka Saul, anyoun koMakanaim kolot Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.12"
              },
              "items": [
                {
                  "text": "Yer 41:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloma Yoab okoku loka Seruia ka ikeiaanakinak luka Daudi, kiriamunos kakes eiduny katapar naka Gibeon; kiboikinos, lu epuai katapar, kwi da epuai katapar, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.23"
              },
              "items": [
                {
                  "text": "Awa 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Abiner Yoab atiar, “Keŋaiŋait, konyout ikatumunak abolia kakonyenewok.” Kotema Yoab atiar, “Aso konyoutu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyout kodokasi imaritai; itomon ka luarei kanuka Benyamin, ka Is-boset okoku loka Saul, ka itomon ka luarei luka ikejaanakinak luka Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitiŋ ŋinituŋanan akou naka aupake, kicum kekileŋike osiep loka aupake; kibiroros nepepe: kanuka ŋun ŋes amaikinere aibois ŋin Kelakat-kasurim, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:16",
              "type": "text"
            },
            {
              "text": "Kelakat-kasurim Apolouke Emanikor loka iltileŋa luekwaka.",
              "type": "text"
            }
          ]
        },
        {
          "text": " naejai Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        },
        {
