                "loc": "ACT.7.26"
              },
              "items": [
                {
                  "text": "Asw 7:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Abiner aiworo Yoab ebe, “Edanyi kereka ekileŋ ikar kere? Mam jo ijeni ebe awasiake ŋes adwaris? Aso do kitodoli ai eriŋa ieorakinia iluŋa aboŋor katupakin iinacanakec?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
