                "loc": "PRO.17.14"
              },
              "items": [
                {
                  "text": "Awa 17:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.20.18"
              },
              "items": [
                {
