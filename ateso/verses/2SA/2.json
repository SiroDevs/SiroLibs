              "type": "text"
            }
          ]
        },
        {
          "text": " Konye apotu Yoab ka Abisai korukioto Abiner: koloma akoloŋ nakedolioto kesi oukot loka Ama, loitei Gia korot loka amodiŋ naka Gibeon, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotukonokinos idwe luka Benyamin neajai Abiner, koraut erioŋet ediopet, kobwaata kokuju keukot. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        },
        {
