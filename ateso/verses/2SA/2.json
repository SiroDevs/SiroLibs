                  "text": "8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ajaas kanen odwe iuni luka Seruia, Yoab ka Abisai, ka Asakel: ketirono Asakel akerit kwape kamori. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korukitor Asakel Abiner; mam abu kibelokin teten arai kediany kotoma alositeke naatupitor Abiner. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Abiner aŋoliar kauke, kotema atiar, “Ŋes ijo, Asakel?” Koboŋok ebe, “Eoŋ ca lo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.42"
              },
              "items": [
                {
                  "text": "1 Sam 17:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Abiner ŋes atiar, “Kibelokin ijo teten arai kediany, kikam ediopet kokatumunak, kolem luijisike.” Konye koŋer Asakel aibelokin katupit ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema bobo Abiner Asakel ebe, “Kibelokin kinyek atupit eoŋ: kanukinyo kebirokinia jo kwap? Ekonakini ai aseseni onacekon Yoab?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.27"
              },
              "items": [
                {
                  "text": "2 Sam 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.6"
              },
              "items": [
                {
                  "text": "4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye koŋer aibelokin: tape Abiner icumi ŋes akoik ekaukau kakwara, kipelun akwara kokauke; kibirokin nen, kotwanik aibois ŋin: kosodi kanen, luadolunete kere aibois naebirokin Asakel kotwanite, kobwout.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
