              "items": [
                {
                  "text": "46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodum kotoma oyekalu lukegwelanarete imoŋin ka amerekekin ka ajeleik da, ka ikesiecanarak arupian iboiete. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosub edaset kaunoi, kireŋea kes kere koyekalu, amerekekin ka imoŋin da; kobuko arupian nuka ikesiecanarak, kobuburiana imesanakec, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.49"
              },
              "items": [
                {
                  "text": "Luk 2:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok ŋul lukegwelanarete ajeleik ebe, “Kolemasi ŋun; sirikituluosi etogo loka Papaka araut logwelanaret.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Sab 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiitut ikekesisiak ebe iwadikatai ebe, “Kaari ekokote loka ekonitogo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.23"
              },
              "items": [
                {
                  "text": "Mat 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "Yok 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete koboŋokis Iyudayan kotemasi ŋes atiar, “Aanyunet anyoin nakitodikini ijo sio naarai iswama nu?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        },
