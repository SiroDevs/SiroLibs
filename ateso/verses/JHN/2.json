              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete kotemasi Iyudayan atiar, “Eyekalu lo lokedukokinio ikar akaisaoŋon ka lukanykape, iduki tope ijo kotoma apaarasia auni?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
