              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye enera ŋesi nuka eyekalu loka akuanake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
