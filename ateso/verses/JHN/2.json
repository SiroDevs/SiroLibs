              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.7.3"
              },
              "items": [
                {
                  "text": "Yok 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokau kaŋun kijesar kiton Kaparanaum, ŋes ka totoke, ka ikeinacan ka ikekesisiak da; kosala ŋina apaarasia nuikidioko.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
