            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keapie Aleleŋ naka lyudayan, kodoka Yesu Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
