            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋol ŋes ekesisian ŋol loitejenuni akiro ŋun, loewadikai ŋun; kijeni oni ebe akeitejenun erai nakabeit. ",
          "type": "text",
          "attrs": {
