            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaulo kaŋun kitakanikin bobo Yesu ikesisiak kaŋolol naka Tiberia; kitakanikin kwanata: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.1",
            "verseOrgIds": [
              "JHN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.45"
              },
              "items": [
                {
                  "text": "Yok 1:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kejaas nepepe Simon Petero, ka Tomas loenyaritai Didumo, ka Natanael, loko Kana loko Galilaya, ka odwe luka Sebedayo, ka ice iarei kokesisiakake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.2",
            "verseOrgIds": [
              "JHN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.5"
              },
              "items": [
                {
                  "text": "Luk 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Simon Petero kes atiar, “Alosi ailok.” Kotemasi atiar, “Isio da kiupari kajo.” Kolomasi, kodokasi ataker; konye kakuar kaŋin mam ikamuna ibore.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.3",
            "verseOrgIds": [
              "JHN.21.3"
            ]
          }
        }
      ]
    },
    {
