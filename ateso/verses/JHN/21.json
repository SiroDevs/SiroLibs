              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinera ŋun itodikini atwanare naetopolooria Edeke. Nakedaunia einer ŋun, kotema atiar, “Kotupunai.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.19",
