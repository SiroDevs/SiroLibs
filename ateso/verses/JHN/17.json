            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " tetere eraunete kere ipe; kwape ijo Papa ijaar tomakaŋ, eoŋ da tomakon, ŋul da kojaut tomawok: tetere iyuunete akwapin ebe ijo ŋes kijukunit, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
