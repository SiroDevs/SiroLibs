            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da ainak kes aibuses nakiinakinit eoŋ; tetere eraunete ipe, kwape kiraar oni ipe: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
