          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wu Papa Ekadoliton, mam akwapin kijenete, konye kajeni jo; ejenete lu ebe ijo ŋes kijukunit. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.25",
            "verseOrgIds": [
              "JHN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
