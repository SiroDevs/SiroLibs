                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Papa, akoto kes lukiinakinit ajaut nenipe keoŋ kere neajai; koanyutu akaibuses nakiinakinit; naarai ibu komina eoŋ eriŋa epesikina apetetait naka akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
