                  "text": "Isa 60:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejaun do ebe nin yenika ikekia kere luka akwap yenimam elosi Yerusalem aima Ekabaka, EJAKAIT loka aioresio, mam akiru etepakini kes. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.17",
            "verseOrgIds": [
              "ZEC.14.17"
            ]
          }
        },
        {
