              "items": [
                {
                  "text": "Kos 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.5"
              },
              "items": [
                {
                  "text": "Ikis 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etuŋanan loeninik, komam epupuni esasedoti loebwoi aijaanakin kanen kakonyen nuka EJAKAIT Ekonideke, arai ekatubon, eario etuŋanan ŋol: ilemari aronis koIsirael. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epupunete ituŋa kere, eyoŋete, komam bobo eninikaros.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
