                  "text": "Esk 44:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idolokini isasedotin Ilebin, ka ekatubon loejaun kapaarasia kaŋun: iŋituni; kilimokinete jo akirot naka etube: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iswamai ijo cut kwape ejaar akirot nakilimokinete kesi jo, kaibois kaŋin naeseuni EJAKAIT; irici ijo aiswamaenen kwape ejaatar kere nukisisianakinete kesi jo: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iswamaenenei cut kwape ejaar ekisil lokisisianakinete kesi jo, kwape ejaar etube lokilimokinete: sirikipaa teten arai kediany, ainyein akirot nakilimokinete kesi jo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.30"
              },
              "items": [
                {
                  "text": "Mar 15:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.10.8"
