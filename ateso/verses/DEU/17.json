                {
                  "text": "Sab 122:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Arai ketakanu akirot nakitionikinit ijo aitub, kidiŋ aokot ka aokot, kidiŋ akirot ka akirot, kidiŋ aromait ka aromait, koraas akiro nuka epeget koruteikon: ŋes konyet inyounio alosit aibois naeseuni EJAKAIT Ekonideke; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
