            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kicorak EJAKAIT aiswamaenen ikisila ŋul kere, ayoŋenen EJAKAIT Ewokodeke, kanuka ajokisiwok apaarasia kere, tetere kidarenenei kijarete, kwape lolo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
