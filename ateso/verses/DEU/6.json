            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Sirikodununete EJAKAIT Ekusideke, kwape kikoduniata ŋes koMasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
