            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka itogoi luileleba iboro Iukajokak kere, lumam jo ilelebit, ka amototin nuebokok, numam jo ibokit, imanikoria luka emusabibu ka iseitunin, lumam irait, konyam kimonikin; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋes konyet icoitor sirikiimurwok EJAKAIT, lokitonyouni kakwap nako Misiri, kotogo loka ebulesene. ",
          "type": "text",
          "attrs": {
