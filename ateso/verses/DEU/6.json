                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun da adolit kamawok, arai kikokit aswam aicorakinet na kere kakonyen nuka EJAKAIT Ewokodeke, kwape kicorakinia.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
