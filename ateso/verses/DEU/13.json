            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Arai ketakanu enabi kamakon arai ekerujan airujasia koinak jo aanyunet arai aumokinet, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
