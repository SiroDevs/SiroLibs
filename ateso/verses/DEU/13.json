              "type": "tag",
              "attrs": {
                "loc": "1JN.1.7"
              },
              "items": [
                {
                  "text": "1 Yok 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.6"
              },
              "items": [
                {
                  "text": "2 Yok 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotupenenete EJAKAIT Ekusideke, koyoŋito ŋes, koricito aicorakinetake, korimarito ekeporoto, kijaanakis ŋes, kimorikikinos da kaŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
