                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.19"
              },
              "items": [
                {
                  "text": "1 Kor 11:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.11"
              },
              "items": [
                {
                  "text": "2 Ses 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.14"
              },
              "items": [
                {
                  "text": "Apu 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikipupok akiro nuka enabi kaŋol, arai nuka ekerujan kaŋol lokairujasia: naarai kigimori EJAKAIT Ekusideke yes, ajenun arai iminas EJAKAIT Ekusideke kekusitau kere ka akusiijar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.3"
              },
              "items": [
                {
                  "text": "2 Ika 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.31"
              },
              "items": [
                {
                  "text": "2 Siit 34:31",
