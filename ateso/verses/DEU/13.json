            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Arai kipupu ijo korekon ediopet lokiinakinit jo EJAKAIT aiboienen kotoma, ebakai ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
