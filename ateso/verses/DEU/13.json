              "items": [
                {
                  "text": "Mik 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Arai kiijodijod onacekon, okoku loka totokon, arai okokukon, arai akokukon, arai aberu naka atorobukon, arai opaperokon loesubit bala aijarakon alopet, kaiyeiyea, ebe, ‘Kaloto kejaanakisi icedekesio,’ lumam ijenunit, ijo, karaida lukapapaakon; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idekesio luka ituŋa lukirimorito jo, luidunyas kajo, arai luelwaka kaneijai ijo, ameun kosaŋe ediopet loka akwap kiton osaŋe loce loka akwap; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
