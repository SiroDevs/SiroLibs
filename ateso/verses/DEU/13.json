                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Kor 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eario enabi ŋol arai ekerujan ŋol lokairujasia; naarai ener nukepali mama ejai EJAKAIT Ekusideke lokitolomuni yes kakwap nako Misiri, lokilakuni yes kotogo loka ebulesene, aitapaar yes korot lokicorakinit EJAKAIT Ekusideke aitorit. Ilemari kwaŋin aronis kamakon.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        }
      ]
