        },
        {
          "text": " “Koany, ebwaik lolo akonyenekon aijar ka ajokis, atwanare ka aronis; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kecorak jo lolo aminenena EJAKAIT Ekonideke, alosenen koponesioke, airic aicorakinetake, ka ikisilake ka itubesiake, tetere ijari, kouriar, tetere da kisirereŋi EJAKAIT Ekonideke jo kakwap nailomari airum. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kepaa ekonitau, komam ipupuni, konye kijodijodoor aima idekesio ice, aijaanakin da kes; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
