          ]
        },
        {
          "text": " Kalimokinit yes lolo ebe abeit itwakete; mam akusipaarasia iyatakinos kakwap naidokarete airum kokekwa loka Yorodan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
