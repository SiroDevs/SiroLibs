        },
        {
          "text": " “Kosodi kanen, nakibunokiniata jo akiro ŋun kere, arereŋ ka ekenit, nuebwaik akonyenekon, kosodi ijo akiitun katekerin kere, nukireŋeikini EJAKAIT Ekonideke jo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.9"
              },
              "items": [
                {
                  "text": "Nek 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi aboŋun mama ejai EJAKAIT Ekonideke; arimar ekeporoto kwape ejaatar kere nukecorak ijo lolo, ijo ka idwekon, ketaukon kere, ka aijarakon kere; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
