                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.11"
              },
              "items": [
                {
                  "text": "Yok 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiinakini EJAKAIT Ekonideke jo akerianut kaswamisio kere nuka akanikon, ka aur naka akuanakon, ka aur naka ibarenikon, ka araito naka alupokon, kanuka ajokis: naarai isiyalamikini bobo EJAKAIT jo kanuka ajokis, kwape esiyalamikinia lukapapaakon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kirima ijo eporoto loka EJAKAIT Ekonideke airic aicorakinetake ka ikisilake luiwadikatai oitabo lo loka ikisila; arai kibelokin neejai EJAKAIT Ekonideke ketaukon kere, ka aijarakon kere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
