          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "3JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kewadikak ekanisa ece; konye Dioterepes loekot aiŋarenikin mam abu kisukunyik sio. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.9",
            "verseOrgIds": [
              "3JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuka ŋun, arai kabu, esiituni akeswamisio nuiswamai; kidacanakini sio akiro nueroko, Komam ŋun edaunete ŋes, eŋeri ŋesi aisukunyun iinacan, itikokini da ŋul luekotosi aisukunyikin kes, ireŋeari kokanisa,",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
