            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.35"
              },
              "items": [
                {
                  "text": "Yok 19:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.24"
              },
              "items": [
                {
                  "text": "21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Itejenunete ituŋa kere nuka Demeterio, itejenuni da abeit alopet; isio da kitejenuni, ido ijeni ebe erai aitejenunikosi nakabeit.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
