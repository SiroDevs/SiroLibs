                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.2"
              },
              "items": [
                {
                  "text": "1 Yok 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ketejenuni yes ebe emamei ituŋanan yeninera kOmoyo loka Edeke ebe, “Kikenoi Yesu!” kwabo mam epedori ituŋanan atemar ebe, “Yesu ŋes Ejakait,” dimarai kOmoyo Lokalaunan.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.3",
            "verseOrgIds": [
              "1CO.12.3"
            ]
          }
        }
      ]
    },
    {
