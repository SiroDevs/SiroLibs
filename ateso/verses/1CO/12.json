              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuka ainakineta nuka emoyo, iinacan, mam akoto yes koolik aijen.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.1",
            "verseOrgIds": [
