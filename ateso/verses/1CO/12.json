                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ijenete ebe nairaatar ikapirin kitapaaritai mama ejaas aputosia numam ineras, kwape kiŋarenikinitere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.2",
