              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso iraas yesi akuan naka Kristo, ka atutubetake, ŋinituŋanan kanukeŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
