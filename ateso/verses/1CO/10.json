                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai amori kaimal, kanukinyo kamoromoroere kanuka ŋin yenemalai? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.30",
            "verseOrgIds": [
              "1CO.10.30"
            ]
          }
        },
