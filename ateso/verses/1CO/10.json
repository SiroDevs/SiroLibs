                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai “erai akwap naka Ejakait, ka ailelebake.” ",
          "type": "text",
          "attrs": {
