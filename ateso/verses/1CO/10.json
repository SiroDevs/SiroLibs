            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso akiro ŋun apotu kodoikis ŋul aikwenyar, iwadikatai aituutooria oni, lukidoloki awasia naka ikar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.11",
            "verseOrgIds": [
              "1CO.10.11"
            ]
          }
