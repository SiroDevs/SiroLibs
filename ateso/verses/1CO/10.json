                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikitiguikis Iyudayan, karaida Iyonanin, karaida ekanisa loka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.32",
            "verseOrgIds": [
