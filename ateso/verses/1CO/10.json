              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyutu kwape kiswamaa Isirael; mam kereka eraas luenyamete asuban ikamorak luka etem? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.18",
