            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sirikiraut luimaete aputosia, kwape ice kakesi; kwape kiwadikatere ebe, “Kiboikinos ituŋa ainyam ka aimat, kosodete konyout abolia.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.7",
            "verseOrgIds": [
              "1CO.10.7"
            ]
