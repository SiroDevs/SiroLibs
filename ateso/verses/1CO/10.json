                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwabo sirikidoteata, kwape ice kakesi, kibiroros da ituŋa ilukumin akaisaarei ka luuni kapaaran adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.8",
            "verseOrgIds": [
              "1CO.10.8"
            ]
          }
        },
