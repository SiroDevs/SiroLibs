            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kiinyara yes lomam iyuunit, ikotosi da alosit, konyamata ŋinibore yenibwaikinio kakonyenekus, komam iŋisete kanuka abuonokin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.27",
            "verseOrgIds": [
