            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyam ŋinibore kere yenegwelario kagwelaret naka akiriŋ, komam iŋisete kanuka abuonokin. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.25",
            "verseOrgIds": [
              "1CO.10.25"
            ]
