                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwabo sirikikodut Ejakait, kwape kekoduniata ice kakesi, komudiasi imunwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.9",
