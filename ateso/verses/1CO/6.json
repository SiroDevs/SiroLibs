            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.23"
              },
              "items": [
                {
                  "text": "1 Kor 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ibus iboro kere kamakaŋ”; konye mam iboro kere isigalikinete.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.12",
            "verseOrgIds": [
              "1CO.6.12"
            ]
