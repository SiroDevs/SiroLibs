                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.9"
              },
              "items": [
                {
                  "text": "1 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kwana ejai aŋwal kotomakus, naarai iwosanakinos bonik, Kanukinyo gwai mam kikonakinere erono? Kanukinyo gwai mam kinasere iborokus. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.7",
            "verseOrgIds": [
              "1CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye yes ikonakinete erono, ido iŋasete, kiton iinacanakus da.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.8",
            "verseOrgIds": [
              "1CO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.8",
            "verseOrgIds": [
              "1CO.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam kereka ijenete ebe lumam edolito mam irumete ajakanut naka Edeke? Sirikiŋalas; karaida idotea, karaida luemaete aputosia, karaida lueeloko, karaida ikiliok luituluoros bala aŋor, karaida iketepak ikiliok, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.9",
            "verseOrgIds": [
              "1CO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.19+GAL.5.20+GAL.5.21"
              },
              "items": [
                {
                  "text": "Gal 5:19-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " karaida ikokolak, karaida ikeraŋak, karaida ikamerak, karaida ikamoromorok, karaida ikaŋatak, mam irumete ajakanut naka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.10",
            "verseOrgIds": [
              "1CO.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.3+TIT.3.4+TIT.3.5+TIT.3.6+TIT.3.7"
              },
              "items": [
                {
                  "text": "Tit 3:3-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ice kayesi da ipotu koraas kwaŋin; konye aponi kilotar, konye aponi kitalaun, konye aponi kitojoki araut luidolito, kokiror loka Ejakait Yesu Kristo, kotoma Emoyo da loka Edekewok.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.11",
            "verseOrgIds": [
              "1CO.6.11"
            ]
          }
        }
      ]
    },
    {
