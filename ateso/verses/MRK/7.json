                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogita ŋes bon awai kama ejai ekodet, kibwaik ikebokor akike, kimuik aimul kotiro akeŋajep; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
          }
        },
