                  "text": "Mk 1:43-45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikwenya kes sirikelimokis idiotuŋanan; konye kwape kiyatanakinia aikwenyar, kwape kwaŋin eyatanakiniata aitisiarikin akiro. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.36",
