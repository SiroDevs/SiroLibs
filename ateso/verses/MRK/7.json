                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koinunai ekimiŋ loiŋejiŋeja; kiŋaiŋaata ŋes aidokokin akekan, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.32",
