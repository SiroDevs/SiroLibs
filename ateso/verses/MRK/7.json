                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Yesu bobo katutubeta nuka Turo, kitor kidiŋ Sidon kolot kiton aŋolol naka Galilaya, itorit atutubeta nuka Dekapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
