            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kosesen akuj, kiyeŋak, kotema ŋes atiar, “Epata,” apolouke ebe, “Kopukor.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopukoros akike, kolacar aŋajepeke, kiner kotenan. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
            "verseOrgIds": [
              "MRK.7.35"
            ]
