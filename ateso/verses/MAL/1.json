                {
                  "text": "6:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT laka ajoresio yes ebe, “Eyonit ikoku papake, ka ebulesit da ekeiakait, Arai do arai eoŋ papa, ani bo akapolou? Arai arai eoŋ eiakair, ani bo akayonio? Wu yes isasedotin luimwanito ekakiror. Ibalas yesi ebe, “Kimwanit biai ekonikiror?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.6",
            "verseOrgIds": [
              "MAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.41.22"
              },
              "items": [
                {
                  "text": "Esk 41:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iinakinete emugati loitisilitoi kotemuka. Ibalas ebe, ‘Kitisil isio jo biai?’ Naarai ibalas ebe, Emenen emesa laka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.7",
            "verseOrgIds": [
              "MAL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.21"
              },
              "items": [
                {
                  "text": "Ikis 15:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naiinakiniata ibarasit yenimuduk araun asubanit, mam erai aronis! Naiinakiniata da inwalas ka ikadekan, mam erai aronis! Ebala EJAKAIT loka aioresio ebe, Koinakisi do ekayaitonikus; kisiyalamikini kereka ŋeai jo? Ecamuni kereka jo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.9"
              },
              "items": [
                {
                  "text": "Kos 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kenainait, kilip asianut naka Edeke, tetere esianiar mamawok. Ebala EJAKAIT laka aioresio ebe, Alomunete nun kakaninikus: ecamuni kereka ŋesi idio kayesi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.9",
            "verseOrgIds": [
              "MAL.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.13"
              },
              "items": [
                {
                  "text": "1 Kor 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.18"
              },
              "items": [
                {
                  "text": "Pil 3:18",
                  "type": "text"
                }
