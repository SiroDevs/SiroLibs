                "loc": "ISA.1.11"
              },
              "items": [
                {
                  "text": "Isa 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ti ejok arai kojaun idiopet kayesi yenegolokini ikekia tetere mam yes isinepunete akim kotemuka titai! Ebala EJAKAIT loka aioresio ebe, Mam kesiyalamikinit yes, karaida acamun ainakinet naka akanikus. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.10",
            "verseOrgIds": [
              "MAL.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 1:11"
          },
          "items": [
