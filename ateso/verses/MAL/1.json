                "loc": "REV.8.3"
              },
              "items": [
                {
                  "text": "Apu 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ameun kaneelomunia akoloŋ kiton neelomaria ŋesi epol ekakiror kama ka lukaeekwapin; ido kaniniibois einakinio lukisupurununo mama ejai ekakiror, ka ainakinet naelai: ebala EJAKAIT laka aioresio ebe, Naarai epol ekakiror kama ka lukacekwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.11",
            "verseOrgIds": [
              "MAL.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye imunaunete yesi ŋes, naarai ibalas ebe, Esi! emesa laka EJAKAIT, emenen da ikenyamat, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.22.20"
              },
              "items": [
                {
                  "text": "Leb 22:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.12"
              },
              "items": [
                {
                  "text": "Isa 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibalas da ebe, Koany, epol ca ma aitapasitoi! Ebala EJAKAIT laka aioresio ebe, Isuanasi ŋes. Iyaut luademunio kagogon, ka inwalasik, ka luedekas; iyaut kwaŋin ainakinet! Ebala EJAKAIT ebe, Acamuni tope eoŋ ŋin kakanikus? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.1"
              },
              "items": [
                {
                  "text": "Asw 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ikenitoi ekamodan loejai ibarasit yenikiliokit osipanike, kiyapoi, kosodi ainakin EJAKAIT yenenwalit. Naarai ebala EJAKAIT loka ajoresio ebe, Arai eoŋ Ekabaka loapol, esogim da ekakiror kama ka lukacekwapin.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.14",
            "verseOrgIds": [
              "MAL.1.14"
            ]
          }
        }
      ]
    }
