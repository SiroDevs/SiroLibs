              "items": [
                {
                  "text": "Rom 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT ebe, “Kamina yes.” Konye ibalas yesi ebe, “Kimina ijo sio biai?” Ebala EJAKAIT ebe, “Mam kereka Esau arai onaee loka Yakob? Konye amina Yakob; ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.2",
            "verseOrgIds": [
              "MAL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.35.3"
              },
              "items": [
                {
                  "text": "Esk 35:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kwabo alait Esau, ketuluo da ikeroŋan luiswapito, kainak da airumeteke ikuwei luka amodiŋ,” ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karaida kebala Edom ebe, “Kitiyakin kwap, konye kiboŋori aiduk aiboisio nuatiyanakinos”; inera EJAKAIT loka ajoresio kwanata ebe, “Edukete kesi, konye atiyakini eoŋ kwap: emaikinete ituŋa kes Eikor loka aronis, ido Ituŋa luenyunyurikinit EJAKAIT ikar kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.27"
              },
              "items": [
                {
                  "text": "Sab 35:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.18"
              },
              "items": [
                {
                  "text": "83:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eanyunete akusikonye, itemarete ebe, “Kitopolooritete EJAKAIT adepar eikor loka Isirael!”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
            "verseOrgIds": [
              "MAL.1.5"
            ]
          }
        }
      ]
    },
