              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kogogoŋoor do Yotam, naarai kitemonok ikeponesio kakonyen nuka EJAKAIT Ekedeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswamisio ace nuka Yoram, ka ijiisioke kere, ka ikeponesio, koany, iwadikatai oitabo loka ikabakan luka Isirael ka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai ŋesi loka ikar akaisaarei ka lukany egeuni airum, kirumak ikar itomon ka lukanykape ko Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojotoor Yoram ka lukapapaake, aponi kidaikinai ore loka Daudi: kirum Akas okokuke aiboisike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
