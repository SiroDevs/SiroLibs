                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitiji da ekabaka loka idwe luka Amon, kipiko kes. Kokaru kaŋol koinakis idwe luka Amon ŋes atalatan akwatat nuka epuesa, ka aitemisio alukumin atomon nuka akima, ka alukumin atomon nuka esairi. Kotacakis idwe luka Amon ŋes etiai ŋol kokaru lokiareit, ido kokaru lokiwuniet da. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
