        },
        {
          "text": " Kerai Yotam loka ikar akaisaarei ka lukany egeuni airum; kirumak ikar itomon ka lukanykape koYerusalem: ekiror loka totoke kerai Yerusa akoku naka Sadok. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.1",
            "verseOrgIds": [
              "2CH.27.1"
            ]
          }
        },
