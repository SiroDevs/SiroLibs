              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, nakiticasere ajakanut naka Rekoboam, kogogoŋor, kojal ikisila luka EJAKAIT, ka Isirael kere nepepe kaŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.1",
            "verseOrgIds": [
              "2CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
