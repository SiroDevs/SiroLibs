            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamau ekabaka Rekoboam ibukui luka aisinin aiboisikec, kijaik akanin nuka ikapolok luka ikedarak, luedarete ekek loka etogo loka ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi naalomanaria ekabaka togo loka EJAKAIT, kopotu ikedarak kodakanarete kes, kinyakanarete agola naka ikedarak, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        },
