                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kasodi eoŋ aiticat eicoloŋ loka ajakanutukon, kwape ketutukio kaDaudi papakon ebe, ‘Mam kimamikini ijo etuŋanan araun ekayaiton loka Isirael.’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
