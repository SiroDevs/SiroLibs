            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.136.1"
              },
              "items": [
                {
                  "text": "136:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosesenata idwe kere luka Isirael, naabunio akim, kojaun aibuses naka EJAKAIT togo; kokukumoto, kituluroto akecekonyen kwap neitutuitoi, komaata, kimalata EJAKAIT ebe,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
