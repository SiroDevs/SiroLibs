            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitaanyikin EJAKAIT Solomon kuare, kotema ŋes atiar, “Eira eoŋ ailipikon, aseu aibois na araun ekatogo loka asuban. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
