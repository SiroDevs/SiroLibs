              "items": [
                {
                  "text": "Yos 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kipo Solomon epucit kapak katŋin adaun apaarasia akanykaarei, ka Isirael kere nepepe kaŋes, ekodet loepol noi, anyoun ka neelomarere Kamat kiton aguurut nako Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran nakikanyetekauni kojaun atukonokin nakayamakin: naarai koricito atiakunio naka etem apaarasia akanykaarei, ka epucit apaarasia akanykaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.66"
              },
              "items": [
                {
                  "text": "1 Ika 8:66",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran naka akaisaarei ka nuuni naka elap lokikanyetekaarei kotwara ŋesi ituŋa alosit owemanakec, elelete, kiyalamas kotauon ajokis kere naabu EJAKAIT kitodik Daudi, ka Solomon, ka Isirael iketuŋa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
