              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ekabaka ka ituŋa kere ainakin asuban kakonyen nuka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ekabaka Solomon koinak asuban imoŋin ilukumin akaisaarei ka luarei, ka imerekekin ilukumin akwatat ka ilukumin akaisaarei, Kwaŋin kotiaku ekabaka ka ituŋa kere etogo loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.16"
              },
              "items": [
                {
                  "text": "1 Siit 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.12"
              },
              "items": [
                {
                  "text": "2 Siit 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobwaata isasedotin, kwape ejaar aswamukec; Ilebin da, ejaas kiboro lueruos luka EJAKAIT, luabu Daudi ekabaka kiswamau aimalaa EJAKAIT, naarai ejaenena akeitim ikar kere, nakituritor Daudi kotoma aijaanakinikec; kokuta isasedotin arupepen koiŋarenikec; kobwaata do luka Isirael kere,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
