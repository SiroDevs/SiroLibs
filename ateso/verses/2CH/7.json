              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.26"
              },
              "items": [
                {
                  "text": "2 Siit 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kagol eoŋ akuj komam ejaun akiru, arai ecorakini emaase ainyam akwap, arai kejuka atular otuŋaka; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
