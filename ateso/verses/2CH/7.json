            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.27"
              },
              "items": [
                {
                  "text": "2 Siit 6:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arai kitasonikinos ikatuŋa luemaikinitai ekakiror, kilipete, komoete akakonyen, kibelokinos anyoun koponesiokec lukaronok; kasodi do eoŋ apupokin kes kajai toma akuj, esionie kes aronisikec, etaŋaleuni da akwapukec. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
