              "attrs": {
                "loc": "2CH.6.6"
              },
              "items": [
                {
                  "text": "2 Siit 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aseu eoŋ etogo lo, etalau da, tetere ejaunun nen ekakiror ikar kere: ejaununos nen akakonye ka etauka tiritir. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        },
