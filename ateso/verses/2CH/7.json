            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bobo da kitalau Solomon kidiŋ alaro nakejai kiŋaren ketogo loka EJAKAIT; naarai koinak kanen ainakineta nuicweio, ka asiepai nuka ainakineta nuka ainapakin: naarai mam epedori etem loka aisinit loabu Solomon kiswamau ailosikin ainakinet naicweio, ka ainakinet naka akiria, ka asiepai.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
