              "items": [
                {
                  "text": "1 Ika 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ka jo da arai ilosenenei kakonyeneka kwape alosenenoo Daudi papakon, iswamaenenei kwape ejaatar kere nukecorak jo, iricenenei ikakisila ka itubesiaka; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
