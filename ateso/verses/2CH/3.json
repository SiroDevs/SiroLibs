            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15"
              },
              "items": [
                {
                  "text": "1 Ika 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.21"
              },
              "items": [
                {
                  "text": "Yer 52:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiswamau da koiŋaren ketogo ipirin iarei lueojak ikubitin akaisauni ka lukany, ka akwes nukejaas kujukec kere aojau ikubitin ikany. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiswamau irikoi neinerenenere akirot, kibwaik kes kuju kipirin; kiswamau akamamagan akwatat kibwaik kes korikoi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosipok ipirin koiŋaren keyekalu, ediopet kakan nakoteten, ece kakan nakokediany; komaik ekiror loka ŋol kakan nakoteten Yakin, ekiror loka ŋol kakan nakokediany Boas.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        }
      ]
