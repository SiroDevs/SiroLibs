              "items": [
                {
                  "text": "Sab 119:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋo da, okokuke, wu Belesasar, mam itasonikino kotaukon, karaida ibu kojen nun kere; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
