                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kipoik ekabaka Belesasar elukumit loka ijakake epucit, komat ebino kakonyen nuka elukumit ŋol. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.20.1"
              },
              "items": [
                {
                  "text": "Awa 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiir ŋesi ebino, kicorak Belesasar ayaun iboro luka esabu ka luka epuesa luabu Nebukadenesar papake konat koyekalu loajai Yerusalem; tetere emasi ekabaka ka ijakake, ka akenor ka akebusian da kotomakec. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi koyaunai iboro luka esabu luaponi konatarai koyekalu loka etogo loka Edeke loajai Yerusalem; komasia ekabaka ka ijakake, ka akenor ka akebusian da. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.4+PSA.115.5+PSA.115.6+PSA.115.7+PSA.115.8"
              },
              "items": [
                {
                  "text": "Sab 115:4-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.20"
              },
              "items": [
                {
                  "text": "Apu 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Komasete ebino, kituritos idekesio luka esabu, ka luka epuesa, ka luka aisinin, ka luka asua, ka luka akito, ka luka amor da.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi koyaunai Daniel akonyen nuka ekabaka. Kotema ekabaka Daniel atiar, “Ŋo kereka Daniel ŋol, loirai lokodwe luka aijoreunio naka Yuda, luejoreuni papaka koYuda? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apupu eoŋ nukon, ebe ejai emoyo loka idekesio kotomakon, ido ejai aica ka aijen ka acoa da naitelekarit tomakon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwana do aponi kitolomunai lukacoa, ikasupok, akonyeneka tetere esiomete nuiwadikatai ŋun, ketejenikis da eoŋ apoloukee: konye mam apedorete aitodikin apoloukee. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye apupu nukon ebe ipedori ijo aitejen apolou, ka ailae ilomorun; asa arai ipedori ijo asoman nuiwadikatai ŋun, ka aitejenikin eoŋ apoloukee, kitanapi lomuge, ka erikot loka esabu omurisinikon, iraun ekayaiton lokiwuniet loka ajakanut.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Daniel aboŋokin ekabaka ebe, “Koraut ainakinetakon nukon, koinak da ece iropitokon; konye asomakini eoŋ ekabaka nuiwadikatai, etejenikini ŋes apoloukee da. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.37"
              },
              "items": [
                {
                  "text": "Dan 2:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wu jo ekabaka, abu Edeke loejai kuju kakuj koinak Nebukadenesar papakon ajakanut, ka apolou, ka aibuses, ka apedor: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.9"
              },
              "items": [
                {
                  "text": "Yer 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.4"
              },
              "items": [
                {
                  "text": "Dan 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ido kanuka apolou naabu koinak ŋes, komaranata koyonito ituŋa kere, ka atekerin ka aŋajepa kakonyeneke: yenakoto ŋesi aiar, abu koar, yenakoto aidar ejari, abu kidar; yenakoto adakakin, abu kodakak, ka yenakoto da aitisil, abu kitisil. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
