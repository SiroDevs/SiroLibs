            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye naeomiaror eketau, koninikiar da ekemoyo tape iswamai nukeitur, aponi kolemarai koicoloŋoke loka ekabakane, kodemarai da akeibuses: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.17"
              },
              "items": [
                {
                  "text": "Dan 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.14+EXO.9.15+EXO.9.16"
              },
              "items": [
                {
                  "text": "Any 9:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kirenearai kodwe luka ituŋa; korau eketau kwape kitian, kiboienenei kitukoi; kitanyamai anya kwape imoŋin, kopalal akekuan kakopyo nuka akuj: aitodol naajenunia ebe irumit Edeke loejai kuju kakuj ajakanut naka ituŋa, ido edakakini ŋin yenekoto ŋesi, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
