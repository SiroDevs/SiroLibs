        },
        {
          "text": " Kosodete lukibukui, ka luketeok, lukitemwan, ka ikerabak, ka ikeŋadak, ka ikenerunak ka iricakisila ka ijaka kere lukobukui, kotukonokinos kanuka asuban nuka aput naabu eka baka Nebukadenesar kosipokinite; kobwaata kesi kakonyen nuka aput, naasipokinit ekabaka Nebukadenesar. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
