              "items": [
                {
                  "text": "Apu 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ido yenimam isudedei aima apak nipenin, ecakakinio kidin oupa loesarani noi.” ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kapak kaŋin kepuput ituŋa kere aruo naka arupepe, ka alamaru, ka adeudeu, ka ajosi, ka etida, ka ŋolipone kere loeruo, kosodete ituŋa kere, atekerin, ka aŋajepa, aisuded aima aput naka esabu naabu ekabaka Nebukadenesar kosipokinite.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
