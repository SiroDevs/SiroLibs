                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai kikwaik nen, epedori Edekekosi lokijaanakini ayuun sio kotoma oupa loesarani noi, kiyuuni da kakanikon, wu ekabaka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
