              "items": [
                {
                  "text": "Dan 2:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejaas Iyudayan ice luibu ijo kitopoloo kotoma akiro nuka ebuku loko Babulon, Sadurak, ka Mesak, ka Abed-nego; ituŋa ŋul, wu ekabaka, mam kipodosi jo; mam ijaanakinete idekesiokon, karaida aima aput naka esabu naibu kosipok.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
