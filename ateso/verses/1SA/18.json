          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kelimokis ikekejaanakinak Daudi akiro nun, kitoiok noi Daudi araun ekamuran loka ekabaka, Eroko apaarasia ketuboro, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
