        },
        {
          "text": " Kosodi kanen kenetaki einer kaSaul, kimorikikinos etau loka Yonatan ketau loka Daudi, kominakin Yonatan ŋes bala etauke elopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
