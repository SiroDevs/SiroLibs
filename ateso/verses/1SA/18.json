          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany Saul, kojenu da ebe ejai EJAKAIT kaDaudi; kominakin Mikal akoku naka Saul ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
