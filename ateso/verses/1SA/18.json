              },
              "items": [
                {
                  "text": "2 Sam 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka nun kisukunya Saul ŋes kamake, kodakak ŋes apolokin elukumit; kolomanari kolomununei da kakonyen nuka ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
