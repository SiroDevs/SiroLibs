            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, tupuruc kobunok Saul kagogon emoyo lokaronon loabuni kama ejai Edeke, kodwar ŋesi kokidin togo: koram Daudi kakekan, kwape eswamaenena ninipaaran: ido kitinite Saul akwara kakanike. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
