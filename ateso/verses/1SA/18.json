                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koremo Saul akwara; naarai abala ebe, “Aremi Daudi aiminaikin arwatat.” Kigaikin Daudi irwan aarei kakonyeneke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
