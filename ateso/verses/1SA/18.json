                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Daudi kolot, ŋes ka iketuŋa, koarata ituŋa akwat aarei luka Ipilisitian; koyau Daudi amunyinikee, koinakis ekabaka etiai kere, tetere eraun ekamuran loka ekabaka, Kokorak Saul ŋes Mikal akokuke aimany. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
