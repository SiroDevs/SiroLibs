                "loc": "1SA.8.11"
              },
              "items": [
                {
                  "text": "1 Sam 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.52"
              },
              "items": [
                {
                  "text": "14:52",
