              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.11.3"
              },
              "items": [
                {
                  "text": "Tub 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotukonokinos mamakeŋ ŋinituŋanan yenareitai, ka nimtunanan yenajai apesen, nmirunanan da yenakadakinit kotau; koraun ŋesi ekapolonikee: kojaas kaŋes ituŋa kwape akwat aoŋon.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
