        },
        {
          "text": " Ŋes do anyounio Daudi kanen, koku alosit abua naka Adulam: ido nakepuput iinaeanake, ka ekal kere loka papake, apotu koloto mamakeg. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
