              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema ekabaka atiar, “Abeit itwani ijo, Akimelek, ijo ka ekek kere loka papakon.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
