            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.11"
              },
              "items": [
                {
                  "text": "2 Sam 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.21.9"
              },
              "items": [
                {
                  "text": "1 Siit 21:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.25"
              },
              "items": [
                {
                  "text": "2 Siit 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema enabi Gad Daudi atiar, “Sirikiboi kabua; konyou kolot akwap naka Yuda.” Kosodi Daudi anyoun kobu amagoro naka Keret.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
