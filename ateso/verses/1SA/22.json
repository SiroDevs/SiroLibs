          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolimok Abiatar Daudi kwape aaria Saul isasedotin luka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
