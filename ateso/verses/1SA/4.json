          ]
        },
        {
          "text": "Kerai Eli loka ikar akaisakanykaoŋon ka lukanykauni, awariwarete akekonye, komam epcdori asesen. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
