                {
                  "text": "2 Sam 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema etuŋanan Eli atiar, “Eoŋ ŋol loabuni kaiore, akeruni eoŋ lolo kaiore.” Kotema atiar, “Ikote akiro ai, okokuka?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok loayaun akiro ebe, “Aker Isirael kakonyen nuka Ipilisitian, ajaun da earit loepol kotuna, odwekon da luarei, Kopuni ka Pinekas atwaka, anatar da asaduku naka Edeke.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kelimu ŋesi nuka asaduku naka Edeke, kibiror Eli eidedia koicoloŋoke kariri naka erute, kobila emurisinike, kotwana; naarai amoionit ido alaŋir, Abu kirabakinite Isirael ikar akaisaoŋon.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
