        },
        {
          "text": " Kijukasi ituŋa Silo, koyaut asaduku naka aitutuket naka EJAKAIT loka ajoresio, loiboie kokidin kikerubin: odwe da luarei luka Eli, Kopuni ka Pinekas, ajaas nina kasaduku naka aitutuket naka Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
