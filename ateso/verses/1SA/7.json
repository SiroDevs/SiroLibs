                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwaŋin kitononokai Ipilisitian, mam bobo apotu kolomut oikorun luka Isirael: koluik akan naka EJAKAIT Ipilisitian apaarasia kere nuka Samuel. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
