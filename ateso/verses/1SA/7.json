              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.6"
              },
              "items": [
                {
                  "text": "Sab 99:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.1"
              },
              "items": [
                {
                  "text": "Yer 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolem Samuel imerekek yenenaki, koinak ŋes araun ainakinet naicweio mama ejai EJAKAIT: komony Samuel mama ejai EJAKAIT kanuka Isirael; Koboŋok EJAKAIT ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
