              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.11"
              },
              "items": [
                {
                  "text": "1 Sam 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraun na da aanyunet kamakon, naedoikini odwekon luarei, Kopuni ka Pinekas; etwakete kere apaaran ‘adiopet. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
