              "items": [
                {
                  "text": "Any 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kobu etuŋanan loka Edeke mama ejai Eli, kobala ŋes ebe, “Inera kwanata EJAKAIT atiar, Mere abu kapukokin bon okek loka papaakon, naajaatar Misiri obulesene kotogo loka Parao? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
