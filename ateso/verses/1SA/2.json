            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.3"
              },
              "items": [
                {
                  "text": "2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mam abu kaseu ŋes katekerin kere nuka Isirael, araun ekasasedoti, adokanar otemuka aisupuruunun lukisupurununo, anapenen da epod kakonyeneka? Mam abu kainak ekek loka papakon ainakineta kere nuka idwe luka Isirael nueinakinere kakim? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
