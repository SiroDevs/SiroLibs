                {
                  "text": "Luk 2:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyana EJAKAIT Kana, kopotuu, kidou isap iuni ka apesur aarei. Kopolok ikoku Samuel akonyen nuka EJAKAIT.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.21",
