              "items": [
                {
                  "text": "Rom 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kopoloor aronis naka ikatumunak kakonyen nuka EJAKAIT: naarai kitapianata ituŋa ainakinet naka EJAKAIT,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.17",
            "verseOrgIds": [
              "1SA.2.17"
            ]
          }
        }
