                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keraas odwe luka EH odwe luka Belial; mam ajenete EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.12",
            "verseOrgIds": [
              "1SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekoni kwanata epone loka isasedotin mama ejaas ituŋa ebe, naeinakinia ituŋanan asubanit, abuni ebulesit loka esasedoti itinit kakanike egolu loajaas ikel iuni, napekulai akiriŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.13",
            "verseOrgIds": [
              "1SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi akiinor toma asepulia, arai abinika, arai amot, arai atido; kere naeeumuni egolu nm ayaŋaari esasedoti. Kiswamanakinai kwaŋin Isiraelin kere luapote nen Silo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.14",
            "verseOrgIds": [
              "1SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eebo, eriŋa icweikina asiepai, kobuni ebulesit loka esasedoti, kobala ituŋanan yeneinakini asubanit ebe, “Koinakinai akiriŋ, kapeik esasedoti; naarai mam ekoto akiriŋ naipoo kamakon, konye naejon.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.15",
            "verseOrgIds": [
              "1SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kelimoki ŋes ituŋanan ebe, “Abeit icweikinio asiepai kwape kwana, ŋes konyet iyaŋaaria naipuda akoniijar kere”: eboŋokini ŋesi da ebe, “Mam, konye kiinakini ijo eoŋ kwape kwana: arai kiner, ayaŋaari kagogon.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.16",
            "verseOrgIds": [
              "1SA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.11"
              },
              "items": [
                {
                  "text": "Age 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.2.8"
