              "items": [
                {
                  "text": "1 Sam 9:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyarau Yese kobu asuban, ketodikini jo nuiswamai: inyonyoikini akinyet ŋol lokalimokini jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        },
