        {
          "text": " Kiswama Samuel nuabu EJAKAIT kiner, kobu Bet-lekem, Kopotu imakio lukore emaranete airiamun kaŋes, kotemasi atiar, “Ibunit ijo kainapakin?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
