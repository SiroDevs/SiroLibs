          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.10"
              },
              "items": [
                {
                  "text": "Any 19:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Kainapakin: abunit ainakin EJAKAIT asuban: kitalaunos, kauparos keoŋ asuban.” Kitalau Yese ka odweke, konyarau kes aponare asuban.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
