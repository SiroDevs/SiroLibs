                "loc": "1SA.20.29"
              },
              "items": [
                {
                  "text": "1 Sam 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Samuel atiar, “Ekwaikini ai alosi? Arai kiira Saul, kaari eoŋ.” Kotema EJAKAIT atiar, “Koyana ataok, kiner atiar, ‘Abunit ainakin EJAKAIT asuban.’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
