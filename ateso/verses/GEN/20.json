                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.8"
              },
              "items": [
                {
                  "text": "Yob 42:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.14+JAS.5.15+JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Yok 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kinyaka aberu naka etuŋanan, naarai erai ŋesi enabi, ŋes da kilipakini, ijo da ijari; konye arai mam inyakarit, kojen ebe mam iswaki atwanare, ijo ka luijaatar kere.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.7",
            "verseOrgIds": [
              "GEN.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
