            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ketolot Edeke anyoun kotogo loka papaka, kasodi alimokin ŋes ebe, ‘Na ŋes arerenukon nakitodianakini eoŋ: kotoma niniibois nakidolenenei kinerenena mama ajai eoŋ ebe erai onaceka.’” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.13",
            "verseOrgIds": [
              "GEN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.16"
              },
              "items": [
                {
                  "text": "Age 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyana Abimelek amerekekin ka aituk ka ibulesin ka abulesin, koinak Aburaam, kinyakak ŋes akeberu Sara, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.14",
            "verseOrgIds": [
              "GEN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.9"
              },
              "items": [
                {
                  "text": "Age 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.47.6"
              },
              "items": [
                {
                  "text": "47:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Abimelek atiar, “Koany, akwapuka ejai akonyenekon; kiboikin neikoto ijo kere.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 20:16"
