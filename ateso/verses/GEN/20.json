                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Aburaam kaŋina kolot akwap naka ari naka Eŋalakimak, kiboikin kidin ka Kades ka Sur; kiboikin toma Gerar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.1",
            "verseOrgIds": [
              "GEN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.11+GEN.12.12+GEN.12.13+GEN.12.14+GEN.12.15"
              },
              "items": [
                {
                  "text": "Age 12:11-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.7"
              },
              "items": [
                {
                  "text": "26:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinera Aburaam nuka Sara aberuke ebe, “ŋes kinacika.” Ido kiyakia Abimelek ekabaka loka Gerar, koyana Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.2",
            "verseOrgIds": [
              "GEN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.14"
              },
              "items": [
                {
                  "text": "Sab 105:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.12"
              },
              "items": [
                {
                  "text": "Yob 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
