                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.7"
              },
              "items": [
                {
                  "text": "Age 19:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu Edeke mama ejai Abimelek kotoma airuja naka akuare, kolimok ebe, “Koany, irai ijo bala ekatwan, kanuka aberu naibu koyana, naarai ejai ŋes okilenike.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.3",
            "verseOrgIds": [
              "GEN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.23+GEN.18.24+GEN.18.25"
              },
              "items": [
                {
                  "text": "Age 18:23-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido eroko Abimelek ikunyakina neejai ŋesi; kotema atiar, “EJAKAIT, ibuni aiar ateker karaida kedolit? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.4",
            "verseOrgIds": [
              "GEN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam abu elopet kotema atiar, ‘Ŋes kinacika’? Aberu da alopet kotema atiar, ‘Ŋes onaceka.’ Eswamai eoŋ ŋin ketau loedolit, ka akanin nuemameete aronis.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.5",
            "verseOrgIds": [
              "GEN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.5"
              },
              "items": [
                {
                  "text": "Age 35:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.4"
              },
              "items": [
                {
                  "text": "Any 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.26"
              },
              "items": [
                {
                  "text": "1 Sam 25:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok Edeke ŋes kairujasit ebe, “Eebo, ajeni ebe iswamai ŋun ketau loedojit, ŋes ketikokinia kinye amunaun kaneajai eoŋ: ŋes da kesimikia atiror ŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.6",
            "verseOrgIds": [
              "GEN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.5"
              },
              "items": [
                {
                  "text": "1 Sam 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
