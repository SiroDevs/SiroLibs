        },
        {
          "text": " Kojai EJAKAIT ka Yosep, kokerianar, kiboie kotogo loka ekapolonike Emisiriat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
