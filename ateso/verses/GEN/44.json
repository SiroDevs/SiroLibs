              "items": [
                {
                  "text": "Age 41:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Yuda aikunyakin mama ejai, kiner ebe, “Wu ejakaitika, kenainait, mere kiner ekonibulesit akirot aki nuka ejakaitika, ido kinyek akoninyunyura anomor ekonibulesit; naarai isubit ijo cut bala Parao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.18",
            "verseOrgIds": [
              "GEN.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ejakaitika kinit ikebulesin ebe, “Ejai yes papakus, arai onacekus?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.19",
            "verseOrgIds": [
              "GEN.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
