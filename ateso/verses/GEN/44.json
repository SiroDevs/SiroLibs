            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.15"
              },
              "items": [
                {
                  "text": "1 Kor 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.17"
              },
              "items": [
                {
                  "text": "Gal 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kinera ŋesi ebe, “Madi akuj mam eoŋ eswamai kwaŋin: etuŋanan loatakanu ejai aikopo akanike, ŋes eraun ebulesitika: konye yes, konyout koloto mama ejai papakus kainapakin.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.44.17",
            "verseOrgIds": [
              "GEN.44.17"
            ]
          }
        }
      ]
