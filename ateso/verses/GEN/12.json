                {
                  "text": "Age 13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konyou Aburam kiyatak akelosit kari naka Eŋalakimak.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
