              "type": "text"
            }
          ]
        },
        {
          "text": " Kojai ebeli kakwap: kolot Aburam Misiri aiboi nina; naarai kepol ebeli kotoma akwap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
