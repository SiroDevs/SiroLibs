            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitor Aburam akwap kodol aibois naka Sekem, neejai elua loka More. Kojai Ekanaanit akwap kapaarasia kanun, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
