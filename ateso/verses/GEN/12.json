                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koanyut ŋes ijaka luka Parao: kituro ŋes kaneejai Parao; koyanaarai aberu togo loka Parao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
