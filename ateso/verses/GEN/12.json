        },
        {
          "text": "Kwaŋin kolot Aburam, kwape kelimokinia ŋes EJAKAIT: kolot Lot nepepe kaŋes: kedaunit Aburam ikar akaisakanykaarei ka lukany nakenyounio koKaran. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
