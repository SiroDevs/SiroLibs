              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.8"
              },
              "items": [
                {
                  "text": "Bur 11:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyana Aburam akeberu Sarai, ka Lot okoku loka onaceke, ka ikeceboro kere luatukokinitos, ka ituŋa luapotu kodumut koKaran; konyout alosit akwap naka Kanaan; kodolot akwap naka Kanaan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
