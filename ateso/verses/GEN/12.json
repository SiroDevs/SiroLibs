              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kedol Aburam Misiri, koanyut Imisirian aberu itemelel noi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
