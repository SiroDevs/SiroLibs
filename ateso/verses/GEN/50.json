              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kicorak Yosep ikebulesin luaraas imurwok aitoono papake: kitoonoto imurwok Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.29"
              },
              "items": [
                {
                  "text": "Mar 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.8"
              },
              "items": [
                {
                  "text": "Ikis 34:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodautu apaarasia akaisaoŋon itoonete; naarai kwape kwaŋin apaarasia nuka aitoon etia nepenen: kibworoto Imisirian ŋes adaun apaarasia akais akanykaarei.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
