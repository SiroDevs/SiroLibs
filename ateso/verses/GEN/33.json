              "items": [
                {
                  "text": "Age 32:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiteluo Yakob akekonye konolia, ido koany, ebunit Esau, ka ikiliok akwat aoŋon eupas kaŋes, Kokoranak idwe neejai Lea ka Rakel ka abulesin nuarei. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisinaren abulesin ka ikecedwe, kitutupik Lea ka ikedwe, kinyck Rakel ka Yosep kokau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.2"
              },
              "items": [
                {
                  "text": "Age 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.6"
              },
              "items": [
                {
                  "text": "42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotubor ŋesi da elopet kiŋarenikec, Kokukokin kwap irwan akanykaarei, aitodol naekunyakinia die mama ejai onaceke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
