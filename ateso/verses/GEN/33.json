                {
                  "text": "Yer 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koker Esau airiamun kaŋes, kotun ŋes, kibirokin omurisiŋike konu: komonyata akiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.4",
            "verseOrgIds": [
              "GEN.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.9"
              },
              "items": [
                {
                  "text": "Age 48:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.127.3"
              },
              "items": [
                {
                  "text": "Sab 127:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Isa 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiteluo akekonye, koany aŋor ka idwe; kobala ebe, “Lukaŋai lu lueiaas kajo?” Koboŋok ebe, “Lu kes idwe luabu Edeke koinak ekonibulesit kanuka asianut.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.5",
            "verseOrgIds": [
              "GEN.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete kikunyut abulesin, kes nepepe kikecedwe, kokukokinos. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.6",
            "verseOrgIds": [
              "GEN.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikuny Lea da ka ikedwe, kokukokinos: kokau kikuny Yosep ka Rakel, kokukekinos. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.7",
            "verseOrgIds": [
              "GEN.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.5"
              },
              "items": [
                {
                  "text": "Age 32:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala ebe, “Ekodet ŋol kere lokiriamun keoŋ apolouke inyo?” Koboŋok ebe, “Adumunia asianut kakonyen nuka ejakaitika.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.8",
            "verseOrgIds": [
              "GEN.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala Esau ebe, “Onac, luejaas keoŋ kadaunito; luejaas kajo koraunos lukon.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.9",
            "verseOrgIds": [
              "GEN.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
