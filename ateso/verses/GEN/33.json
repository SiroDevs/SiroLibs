              "GEN.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobala ebe, “Kageut erot, kaloto, eoŋ da kenarenikini jo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.12",
            "verseOrgIds": [
              "GEN.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema atiar, “Ekajakait, ijeni ebe emameete idwe agogoŋ, ido kwape kamerekekin ka aituk nukiiaa keoŋ itanakete: ido arai kemeata noi apaarit adiopet, etwakete isipanin kere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.13",
            "verseOrgIds": [
              "GEN.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.3"
              },
              "items": [
                {
                  "text": "Age 32:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kenainait, kiŋarenik ejakaitika ekebulesit, eoŋ da alosi motimot, kwape kalosit naka ibaren luejaas kakonyeneka, ido kwape ejaar alosit naka idwe, aitodol neadolunio eoŋ Seir mama ejai ejakaitika.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.14",
            "verseOrgIds": [
              "GEN.33.14"
            ]
          }
        }
      ]
    },
