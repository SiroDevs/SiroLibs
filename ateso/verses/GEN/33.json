                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.15"
              },
              "items": [
                {
                  "text": "2 Ika 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.18"
              },
              "items": [
                {
                  "text": "Pil 4:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.23"
              },
              "items": [
                {
                  "text": "2 Ika 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kenainait, kocam akainakinet nakiinun; naarai keswamak Edeke nukasianut, ido naarai Iukijaa keoŋ kadaunito.” Kisidik, kocam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.11",
            "verseOrgIds": [
              "GEN.33.11"
            ]
          }
        }
      ]
    },
    {
