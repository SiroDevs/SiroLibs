                "loc": "JDG.1.15"
              },
              "items": [
                {
                  "text": "Tub 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.27"
