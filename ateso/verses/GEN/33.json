                "loc": "GEN.43.3"
              },
              "items": [
                {
                  "text": "Age 43:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.13"
              },
              "items": [
                {
                  "text": "2 Sam 3:13",
