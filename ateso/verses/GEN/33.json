                "loc": "RUT.2.13"
              },
              "items": [
                {
                  "text": "Rus 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala Esau ebe, “Aso do kenyekinia ice kotuna lukijaa keoŋ.” Kobala ebe, “Mam akiro; kadum asianut kakonyen nuka ejakaitika.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.15",
            "verseOrgIds": [
              "GEN.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Esau aboŋor kapaarit kaŋin kobea Seir. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.16",
            "verseOrgIds": [
              "GEN.33.16"
            ]
          }
        },
        {
