              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naapukoria ŋesi aipucet nakiareit, keira lokajaran lokiareit ebala ebe, “Bia!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
