              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kaany, ido koany, ebalasit lokakwaŋan, kejai ekebwaneniton da akabwa; koinakinai aboko, koloma da aipikor, ido ipikori.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
