              "items": [
                {
                  "text": "6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolom do ebalasit ece, loereŋ; koinakinai ekebwanenitonike alemar ainapakin kotoma akwap, tetere ituŋa earas; koinakinai da ŋes ekileŋ loepol.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
