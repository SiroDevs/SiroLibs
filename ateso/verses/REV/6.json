            }
          ]
        },
        {
          "text": " Naapukoria ŋesi aipucet nakiwuniet, keira lokajaran lokiwuniet ebala ebe, “Bia!” Kaany, ido koany, ebalasit lokirionon, kejai ekebwanenitonike aitemis akanike. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keira bala eporoto kokidiŋ lukajarak luoŋon ebala ebe, “Aitemis naka akiria naka adenari, ka aitemisio auni nuka esairi nuka adenari, kwabo mam imunaari akinyet karaida ebino!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
