        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.26+EZK.1.27+EZK.1.28"
              },
              "items": [
                {
                  "text": "Esk 1:26-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋol da lokiboie kotakani koputosi bala amoru naka ayaseper, ka naka sarudio, kirimorite etaluka eicoloŋ, kotakani koputosi bala emeralid. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
