        },
        {
          "text": "Kokidiŋ keicoloŋ, kowaitin da kere luka eicoloŋ, kejaas lukajarak iwoŋon, lukileleba akonye kiŋaren kokau da. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
