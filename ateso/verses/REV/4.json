        {
          "text": " Atipet abu kajai kotoma Omoyo, ido koany, kibwaikinitete eicoloŋ toma akuj, ka loiboie koicoloŋ kaŋol! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
