              "items": [
                {
                  "text": "Apu 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kobu ediopet komalaikan ikanykaarei luajaas atanyia akanykaarei, kenerata keoŋ ebe, “Bia, ketodikini jo atubokinio naka naadote nakapolon naiboie kakipi nuipu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Apu 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.3"
              },
              "items": [
                {
                  "text": "18:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naadoteata ikabakan luka akwap, ka ŋul da luiboiete kotoma akwap amerikinos ebino loka adoteuke.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Apu 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kadaka eoŋ modiŋ kotoma Omoyo; kaany da aberu iboie kotiaŋ loereŋ, loileleba ikiroria luka ainyanakin, kojaas akwes akanykaarei ka amumwara da atomon, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Esk 28:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konapit aberu anapito namuge ka nakareŋan kisiritete esabu ka amor nuka akais nuipu, ka ilulun, kojai aikopo naka esabu akanike, naileleba italesia, ka asilianut naka adoteuke; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.7"
              },
              "items": [
                {
                  "text": "2 Ses 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.30"
              },
              "items": [
                {
                  "text": "Dan 4:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Apu 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.19"
              },
              "items": [
                {
                  "text": "16:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " iwadikatete da oreeteke ekiror loka aiyeiyea ebe: “Babulon lokapolon, toto naka nudotea, ka italesia da luka akwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.24"
              },
              "items": [
                {
                  "text": "Apu 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abu kaany aberu ŋin emera aokot nuka lukalaunak ka aokot nuka ikajenak luka Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaanyunia ŋes abu kaumok aumokin naepol. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabala emalaika eoŋ ebe, “Kanukinyo iwumokinitor? Kalimokini jo aiyeiyea naka aberu, ka naka etiaŋ loedakit ŋes, loejaas akwes akanykaarei, ka amumwara da atomon. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.3"
              },
              "items": [
                {
                  "text": "Dan 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Apu 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1+REV.13.2+REV.13.3"
              },
              "items": [
                {
                  "text": "13:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.5"
              },
              "items": [
                {
                  "text": "3:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Sab 69:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejai etiaŋ loibu koany, ido emamei, ido ebuni adokun kotoma aipany naemamei enaŋe, elosi da amudiario; eumokinete da ŋul luiboiete kotoma akwap, lumam iwadikatai ikiroriakec oitabo loka aijar ameun kapetetait naka akwap, naeanyuniata etiaŋ, naarai kejai, ido emamei, ido ejaun. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Apu 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ne ŋes ejai aijen naejai acoa: akwes akanykaarei kes iroŋan ikanykaarei, luiboikino aberu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eraas da ikabakan ikanykaarei, ebiroros ikany, ejai ediopet, eriŋa ece ebuno, ido naebunio ibusakinit ŋes asalakinit apak naedit. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.20"
              },
              "items": [
                {
                  "text": "Apu 19:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Etiaŋ da lokejai, ido emamei, erai ŋol lokikanyetekauni, konye erai lokokanykaarei, elosi da amudiario. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.20"
              },
              "items": [
                {
                  "text": "Dan 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amumwara da atomon nuibu koany eraas ikabakan itomon lueriŋa edumuna ajakanut, konye edumunete apolou kwape ikabakan adaun esawa ediopet, nepepe ketiaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejai kes ainerun adiopet, einakinete etiaŋ apedorikec ka apoloukec da. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Ikis 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.47"
              },
              "items": [
                {
                  "text": "Dan 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.14"
              },
              "items": [
                {
                  "text": "Apu 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejiosi ŋul ka Imerekek, ipikori Imerekek kes, naarai erai ŋesi Ejakait loka ijaka, ka Ekabaka da loka ikabakan, ŋul da luejaas kaŋes eraas luenyaritai, lueseunitai, ka lumunon da.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        }
      ]
    },
    {
