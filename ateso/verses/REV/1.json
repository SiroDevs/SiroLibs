          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu kajai kotoma Omoyo kapaaran naka Ejakait, kasodi apupun eporoto loepol kokaukaŋ, bala loka arupepe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
