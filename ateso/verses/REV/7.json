          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok ediopet komakio, kalimok eoŋ ebe, “Lukaŋai bo lu, luitanapitai inapen Iukakwaŋak, ai bo da keponiata kesi?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
