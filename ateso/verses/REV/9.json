              },
              "items": [
                {
                  "text": "20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kokut emalaika lokikanyet akerupepe, abu kaany da aacerit naebirun kakuj toma akwap, aponi koinakinai ŋes elacetait loka aipany naemamei enaŋeke. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.1",
            "verseOrgIds": [
              "REV.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.28"
              },
              "items": [
                {
                  "text": "Age 19:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.18"
              },
              "items": [
                {
                  "text": "Any 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.2"
              },
              "items": [
                {
                  "text": "Yok 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolaca aipany naemamei enaŋeke, kolom apuru kaipany, kwape apuru naka eupa loepol. Kitumuton apuru naalomuni kaipany akoloŋ ka apak da. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.2",
            "verseOrgIds": [
              "REV.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.12+EXO.10.13+EXO.10.14+EXO.10.15"
              },
              "items": [
                {
                  "text": "Any 10:12-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolom emaase kapuru toma akwap, aponi koinakinai ŋes apolou, kwape ejaatar ikiritona luka akwap apolou. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.3",
            "verseOrgIds": [
              "REV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Esk 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Apu 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aponi kolimokinai ŋes ebe mam emunaari anya nuka akwap, karaida ikiot kere yenepalal, karaida ekitoi kere, dimarai ituŋa bonik luemamei aipucet naka Edeke koreetakec; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.4",
            "verseOrgIds": [
              "REV.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "aponi koinakinai ŋes aisirieb kes noi, ilapio ikany, kwabo mere aiar kes; korai aisiriebeke kwape aisirieb naka ekiriton naekonyia ituŋanan. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.5",
            "verseOrgIds": [
              "REV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.21"
              },
              "items": [
                {
                  "text": "Yob 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.3"
              },
              "items": [
                {
                  "text": "Yer 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.30"
              },
              "items": [
                {
                  "text": "Luk 23:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaarasia kaŋun da emoete ituŋa atwakare, konye mam edumunete, imielas atwakare, ekeri da atwanare kamakec,",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.6",
            "verseOrgIds": [
              "REV.9.6"
            ]
          }
        }
      ]
    },
    {
