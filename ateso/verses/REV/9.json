            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.13"
              },
              "items": [
                {
                  "text": "Apu 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.14"
              },
              "items": [
                {
                  "text": "11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atuboros ican lusodit; koany eriŋa eponito iarei akaulo kaŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.12",
            "verseOrgIds": [
              "REV.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.1+EXO.30.2+EXO.30.3"
              },
              "items": [
                {
                  "text": "Any 30:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.3"
              },
              "items": [
                {
                  "text": "Apu 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kokut emalaika lokikanyetekape akerupepe, abu keira da eporoto loalomuni kamumwar aoŋon nuka etem loka esabu loejai akonyen nuka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.13",
            "verseOrgIds": [
              "REV.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.18"
              },
              "items": [
                {
                  "text": "Age 15:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.7"
              },
              "items": [
                {
                  "text": "Ikis 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.4"
              },
              "items": [
                {
                  "text": "Yos 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Apu 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loalimokini emalaika lokikanyetekape, lokejai arupepe ebe, “Kolac imalaikan iwoŋon lueenitai kocor lokapolon Eupurate.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.14",
            "verseOrgIds": [
              "REV.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.8.7+REV.8.8+REV.8.9+REV.8.10+REV.8.11+REV.8.12"
              },
              "items": [
                {
                  "text": "Apu 8:7-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolacakinai imalaikan iwoŋon luetemokinitoi esawa, ka apaaran, ka elap, ka ekaru da, tetere earete atutubet nakiwuniet naka ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.15",
            "verseOrgIds": [
              "REV.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiai loka ajoresio nuka ikebwanenok emwaasi ilukumin itomon irwan ilukumin itomon irwan aarei; abu kapup etiaikec. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.16",
            "verseOrgIds": [
              "REV.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
