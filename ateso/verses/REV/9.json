              "REV.9.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.4"
              },
              "items": [
                {
                  "text": "Yok 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotakan aput naka emaase bala ibalasin luisikapikinitai ejie, kakwesikec da kojaas nuesubito bala abokoi nuka esabu, koputosi akecekonyen bala akonyen nuka ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.7",
            "verseOrgIds": [
              "REV.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.6"
              },
              "items": [
                {
                  "text": "Yok 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kejaas kes itima kwape itima luka aŋor, ikelakec da kwape ikel luka iŋatunyo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.8",
            "verseOrgIds": [
              "REV.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.5"
              },
              "items": [
                {
                  "text": "Yok 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kejaas kes iboro lukatorob, bala luka aswa, airurum da naka abebenokakec kerai kwape airurum naka agalin nuipu nuka ibalasin luekuboros ojie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.9",
            "verseOrgIds": [
              "REV.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejaas kes ikorio lueputosi ikiritona, ka itido, toma okoriokec ŋes ejai apedorikec aisirieb ituŋa ilapio ikany. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.10",
            "verseOrgIds": [
              "REV.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kejai kes ekabakakec ŋes emalaika loka aipany naemamei enaŋe, ekekiror kAburanian Abadon, ka Ayonanin da ekekiror Apoluon.",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.11",
            "verseOrgIds": [
              "REV.9.11"
            ]
          }
        }
      ]
    },
    {
