        },
        {
          "text": "Kide irutei iuni, agolitomei irutei iuni, eŋalakimak irutei iuni, to da irutei iuni, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
