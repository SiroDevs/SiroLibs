                  "text": "Dan 2:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kasodi kaany eicoloŋ loepol loekwaŋ, ka ŋol da lokiboie kotoma; kokera akuj ka akwap kakonyeneke, mam bobo kes edumuna aibois. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.11",
            "verseOrgIds": [
              "REV.20.11"
            ]
          }
        },
