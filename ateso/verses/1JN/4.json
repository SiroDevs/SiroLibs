              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.1",
            "verseOrgIds": [
              "1JN.4.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.21"
              },
              "items": [
                {
                  "text": "1 Ses 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.15"
              },
              "items": [
                {
                  "text": "Mat 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luminan, sirikiyuut ŋolimoyo, konye kitemoto imoyon arai eraas luka Edeke; naarai alomasi inabin luipu lukeŋalak toma akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.1",
            "verseOrgIds": [
              "1JN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.12.3"
              },
              "items": [
                {
                  "text": "1 Kor 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kana ŋes ijenuniata Emoyo loka Edeke; ŋolimoyo loelimori ebe abu Yesu Kristo toma akuan, erai loka Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.2",
            "verseOrgIds": [
              "1JN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.18"
              },
              "items": [
                {
                  "text": "1 Yok 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.17"
              },
              "items": [
                {
                  "text": "Yok 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋolimoyo da lomam elimori Yesu, mam erai loka Edeke, ŋol erai lokasurup loka Kristo, loipuput ebe ebunit, kwana da ejai toma akwapin, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.3",
            "verseOrgIds": [
              "1JN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.29"
              },
              "items": [
                {
                  "text": "Mat 12:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idwe ludidik, iraas yesi luka Edeke, ipikosi kes, naarai epol ŋol loejai tomakus adepar ŋol loejai toma akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.4",
            "verseOrgIds": [
              "1JN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.19"
              },
              "items": [
                {
                  "text": "Yok 15:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eraas kesi luka akwapin, kanuka ŋun inerasi nuka akwapin, iirarete da akwapin kes, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.5",
            "verseOrgIds": [
              "1JN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.47"
              },
              "items": [
                {
                  "text": "Yok 8:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kirai oni luka Edeke. Yenejeni Edeke kiirari oni, yenimam erai yenika Edeke mam kiirari oni. Kana ŋes kijenunia emoyo loka abeit ka emoyo loka apaar, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.6",
            "verseOrgIds": [
              "1JN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.29"
              },
              "items": [
                {
                  "text": "1 Yok 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luminan, kaminanaros, naarai amin erai naka Edeke, ŋin da kere yenemina eurio kama ejai Edeke, ejeni da Edeke. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.7",
            "verseOrgIds": [
              "1JN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenimam emin mam ejeni Edeke, naarai erai Edeke amin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.8",
            "verseOrgIds": [
              "1JN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.16"
              },
              "items": [
                {
                  "text": "Yok 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kana ŋes etakanunia amin naka Edeke mamawok, naarai abu Edeke kijuk Okokuke loteluna toma akwapin tetere kijari kanukeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.9",
            "verseOrgIds": [
              "1JN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.2"
              },
              "items": [
                {
                  "text": "1 Yok 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kana ŋes ejaar amin, mere ebe kimina oni Edeke, konye abu ŋesi komina oni, kijuk da Okokuke araun alucet naka adiakanaretawok. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.10",
            "verseOrgIds": [
              "1JN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.33"
              },
              "items": [
                {
                  "text": "Mat 18:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luminan, arai kimina Edeke oni kwaŋin, kiburao oni da aminanara. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.11",
            "verseOrgIds": [
              "1JN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.18"
              },
              "items": [
                {
                  "text": "Yok 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei cut ituŋanan yeneanyunit Edeke apaarasia kere; arai kiminanara, esalit Edeke tomawok, akemin da apoloor kotomawok.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.13",
            "verseOrgIds": [
              "1JN.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.24"
              },
              "items": [
                {
                  "text": "1 Yok 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.5"
              },
              "items": [
                {
                  "text": "Rom 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kana ŋes kijenunia ebe kisalit tomakeŋ, ka ŋes da tomawok, naarai abu koinak oni nuka Emoyoke. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.13",
            "verseOrgIds": [
              "1JN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.17"
              },
              "items": [
                {
                  "text": "Yok 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kianyunit, kitejenuni da ebe abu Papa kijuk Okokuke araun Eketajaran loka akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.14",
            "verseOrgIds": [
              "1JN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.5"
              },
              "items": [
                {
                  "text": "1 Yok 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arai elimori ituŋanan ebe Yesu ŋes Okoku loka Edeke, esali Edeke tomakeŋ, ŋes da toma Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.15",
            "verseOrgIds": [
              "1JN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijeni, kipou keyuut da, amin naejai Edeke mamawok. Edeke ŋes amin; ŋin da yenesalit toma amin, esalit toma Edeke, Edeke da esalit tomakeŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.16",
            "verseOrgIds": [
              "1JN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.28"
              },
              "items": [
                {
                  "text": "1 Yok 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kana ŋes apolooror amin nepepe kaoni, tetere kija katitiŋ kapaaran naka aitub akiro; naarai kwape eraar ŋesi, kirai oni da kwaŋin toma akwapin nu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.17",
            "verseOrgIds": [
              "1JN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emamei akurian kotoma amin, naarai amin naapoloor ireŋeari akurian. Naarai ejai akurian aiticanio, yenekuriana da mam epolooro kotoma amin. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.18",
            "verseOrgIds": [
              "1JN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimina oni, naarai ŋes kigei amin oni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.19",
            "verseOrgIds": [
              "1JN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
