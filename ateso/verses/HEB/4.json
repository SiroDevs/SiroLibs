                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Sab 95:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai oni lukidau aiyuun, kilomari toma aibworaret ŋin, kwape abalar ebe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
