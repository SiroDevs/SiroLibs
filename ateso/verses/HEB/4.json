                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai emamei oni esasedoti lopeti lomam epedori arieba nepepe kaoni akalanyanutuwok, konye lokecodunio kakiro kere ariaka kaoni, komam adiakar. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
