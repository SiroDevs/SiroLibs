        },
        {
          "text": "Kija kakiro nuipu einer kamakeŋ, ido nuetioko aitejenun, naarai ikimiŋakaros yesi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
