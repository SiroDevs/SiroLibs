            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kosodi nakedaunia aitodolikinio, korau loeinakini ŋul kere luerimarete ŋes aitajario naka ikar kere, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
