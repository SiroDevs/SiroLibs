              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai ŋolisasedoti lopeti loketiakunio kotuŋa ibwaikinio kanuka ituŋa kakiro nuka Edeke, tetere ijaikini ainakineta ka asuban da kanuka adiakanar, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.15"
              },
              "items": [
                {
                  "text": "Bur 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epedori aiyamiyamar lueolito ka luepaarito, naarai ŋes da elopet igogoleori akalanyanut. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
