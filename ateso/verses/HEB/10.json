                "loc": "HEB.3.13"
              },
              "items": [
                {
                  "text": "Bur 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kenyeis apalun atukonokin nepepe, kwape iswamaata ice, konye kecoras; ido keyatanakinito ŋun kwape ianyuniata apaaran ŋin eyapuunit adolun.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
