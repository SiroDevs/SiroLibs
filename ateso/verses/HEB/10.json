                "loc": "PSA.40.6+PSA.40.7+PSA.40.8"
              },
              "items": [
                {
                  "text": "Sab 40:6-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai naalomunia Kristo toma akwapin abala ebe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
