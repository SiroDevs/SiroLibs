              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekadeke da itekori luipudasi kere kwape ejaar akebar kotoma aibuses toma Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.19",
