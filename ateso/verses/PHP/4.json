          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋaiŋait Euodia, eŋaiŋait da Suntuke, koiaas kaomit adiopet, kotoma Ejakait. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.2",
