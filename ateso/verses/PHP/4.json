              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai koSesalonika da ipotu kijukakis eoŋ irwan atipet ka nakiareit kanuka eipudika. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.16",
