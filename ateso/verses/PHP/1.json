                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Karidakinito akiro ŋun aarei, emiela alosit ajaut ka Kristo, naarai ŋes ejok aitelekarit. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
