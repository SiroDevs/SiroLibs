          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elimonokinete ice Kristo kanuka ekokote ka epeget, konye ice ketau kaloejok, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elimonokinete lu kanuka amin, kojenete kwape kebwaikinere ne kanuka aiyar naka Akiro Nukajokak, ",
          "type": "text",
          "attrs": {
