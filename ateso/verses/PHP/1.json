          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "luipu da luka iinacan agogonoros kotoma Ejakait kanuka aenioka, etitiŋikinete aitelekarit einer akirot naka Edeke komam ekuriaka.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
