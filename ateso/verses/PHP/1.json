              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emalaenenei Ekadeke nakeitununoo yes, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
