          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido naarai etogogoŋit kwaŋin, ajeni ebe asali, ido asalenenei nepepe kayes kere, tetere iyatanakinos yesi kaiyalama kotoma aiyuun, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
