            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eoŋ da etogogoŋit ebe ŋol loabu kogeu aswam naejok kotomakus, itodoli kiton apaaran naka Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwape eraar naedolit eoŋ aomit ŋin kanukus kere, naarai ijaas yesi otauka, naarai iraas yesi kere luidicakina keoŋ kotoma asianut, kotoma aenioka, ka aiyar kaitogogoŋ da Akiro Nukajokak. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
