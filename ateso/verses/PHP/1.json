            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiton akaenio atakanun ebe ejai kotoma Kristo, kokidiŋ oserikalei kere, ka ice da kere; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
