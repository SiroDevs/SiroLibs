              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "tetere ilapar akusiwolobobot kanukaŋ kotoma Kristo Yesu, kanuka ajaun kayes bobo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
