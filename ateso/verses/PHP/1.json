            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye arai aijar toma akuan ŋes araito naka aswam kamakaŋ, aso mam ajeni nuaseuni. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
