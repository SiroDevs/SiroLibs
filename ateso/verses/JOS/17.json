              "items": [
                {
                  "text": "1 Sam 31:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.12"
              },
              "items": [
                {
                  "text": "1 Ika 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Adumunit Manase kotoma Isakar ka Aser Bet-sean ka ireriake, Ibileam ka ireriake, ka Iueboiete koDor ka ireriake, ka lueboiete koEn-dor ka ireriake, ka lueboiete koTaanak ka ireriake, ka lueboiete koMegido ka ireriake, kes amukuran auni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.27+JDG.1.28"
              },
              "items": [
                {
                  "text": "Tub 1:27-28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.29+EXO.23.30+EXO.23.31+EXO.23.32+EXO.23.33"
              },
              "items": [
                {
                  "text": "Any 23:29-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.52"
              },
              "items": [
                {
                  "text": "Mar 33:52",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam idwe luka Manase apotu kopedosi aireŋear lueboiete koreria kanul; konye kiketakinos Ikanaanin aiboi kakwap kaŋin, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.10"
              },
              "items": [
                {
                  "text": "Yos 16:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kegogonioto idwe luka Isirael, apotu kitaraut Ikanaanin ikeswamak lukailolitoi, komam irenearere kes cut.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
