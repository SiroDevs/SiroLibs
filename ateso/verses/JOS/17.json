            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageunit eikor loka Manase koAser kiton Mikimetat, loitei Sekem; kitor eikor akan nakoteten, kiton neajaas lueboiete koEn-tapua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.17"
              },
              "items": [
                {
                  "text": "Yos 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.34"
              },
              "items": [
                {
                  "text": "15:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Korai akwap naka Tapua naka Manase: konye Tapua loejai oikor laka Manase korai loka idwe luka Epuraim, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.8"
              },
              "items": [
                {
                  "text": "Yos 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiiesar eikor kiton aguurut naka Kana, ari naka eŋalakimak naka aguurut: araas ireria lu luka Epuraim koreria luka Manase: ajai eikor loka Manase ari naka agolitomei naka aguurut, kosan aŋolol: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kari naka eŋalakimak korau naka Epuraim, kari da naka agolitomei korai naka Manase, aŋolol ŋes arai eikorukee; kodolokis Aser kari naka agolitomei, ka Isakar kari nakokide. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
