              },
              "items": [
                {
                  "text": "36:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Selopekad, okoku loka Keper, okoku loka Gilead, okoku loka Makir, okoku loka Manasc, amameete idwe lusap, dimarai apesur: lu kes ikiroria luka adweke, Mala, ka Noa, ka Kogila, ka Milika, ka Tirusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1+NUM.27.2+NUM.27.3+NUM.27.4+NUM.27.5+NUM.27.6+NUM.27.7"
              },
              "items": [
                {
                  "text": "Mar 27:1-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.1"
              },
              "items": [
                {
                  "text": "Yos 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apotu kesi kikunyut akonyen nuka Eleasar esasedoti, akonyen nuka Yosua okoku loka Nun, akonyen da nuka ikapolok, kotemasi atiar, “Abu EJAKAIT kicorak Musa akorakin sio airumet kama cjaas iinacanakosi:” kanuka ŋun abu kokorak kes airumet kama ejaas iinaean luka papakee kwape ajaar aicorakinet naka EJAKAIT. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobeata Manase aturubeta atomon, kogelara akwap naka Gilead ka Basan, naejai okekwa loka Yorodan; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.29"
              },
              "items": [
                {
                  "text": "Mar 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.39"
              },
              "items": [
                {
                  "text": "32:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.41"
              },
              "items": [
                {
                  "text": "41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai adumunito adwe nuka Manase airumet kama ejaas odweke: akwap da naka Gilead arai naka odwe luka Manase kere luedeuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
