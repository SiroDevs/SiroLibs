              "items": [
                {
                  "text": "Yos 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.7.29"
              },
              "items": [
                {
                  "text": "1 Siit 7:29",
                  "type": "text"
                }
              ]
            },
