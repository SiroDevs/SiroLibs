              "items": [
                {
                  "text": "Ikis 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lo ŋes eroet loabeit ateker naka Manase; naarai ŋes arai ekiyai loka Yosep. Naarai arai Makir ekiyai loka Manase, papa loka Gilead, etuŋanan lokajiot, ŋes akorakinere Gilead ka Basan, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
