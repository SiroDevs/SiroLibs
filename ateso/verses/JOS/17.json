              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.29+NUM.26.30+NUM.26.31+NUM.26.32"
              },
              "items": [
                {
                  "text": "Mar 26:29-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.7.18"
              },
              "items": [
                {
                  "text": "1 Siit 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abeit eroet idwe kere luka Manase luedeuna kwape ajaatar ikekiakec; idwe luka Abieser, ka idwe luka Kelek, ka idwe luka Asuriel, ka idwe luka Sekem, ka idwc luka Keper, ka idwe luka Semida: nul kes idwe lukiliok luka Manase okoku loka Yosep kwape ajaatar ikekiakec.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
