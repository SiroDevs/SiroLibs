              "items": [
                {
                  "text": "Yer 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere eoŋ kecorak jo? Kicat, kotitiŋior; sirikikurianar karaida aiyaloŋoŋ: naarai ejai EJAKAIT Ekonideke kajo kama ilosenenei kere.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        }
