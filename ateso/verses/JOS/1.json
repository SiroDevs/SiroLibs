              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.5"
              },
              "items": [
                {
                  "text": "Ikis 34:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atwana Musa ekejaanakinanika; aso kwana konyou, kodok ecor lo Yorodan, ijo ka ituŋa lu kere, kolomasi akwap naainakinit eoŋ kes, idwe luka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.2",
            "verseOrgIds": [
              "JOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.24+DEU.11.25"
              },
              "items": [
                {
                  "text": "Ikis 11:24-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋiniibois neicakete akusikeje, kainak yes, kwape kolo alimokinia Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.3",
            "verseOrgIds": [
              "JOS.1.3"
            ]
          }
        },
        {
