              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen kedau Musa ekejaanakinan loka EJAKAIT atwanare, kotema EJAKAIT Yosua okoku loka Nun, ekejaanakinan loka Musa atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.1",
            "verseOrgIds": [
