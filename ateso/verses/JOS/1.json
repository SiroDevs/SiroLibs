                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ameuni kamodiŋ, ka Lebanon lo, aitodol ocor lokapolon, ecor Eupurat, akwap kere naka Ikitin, kiton aŋolol nati ape neelomanari akoloŋ, ŋes eraun ekusiikor; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.4",
            "verseOrgIds": [
              "JOS.1.4"
            ]
          }
        },
        {
