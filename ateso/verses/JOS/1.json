                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eitabo lo loka ikisila sirenyoununei kaitukukon, konye koomoomoenenei ŋes paaran ka akuare da, tetere iricit aswam kere kwape ejaatar nuiwadikatai toma: naarai kwaŋin ŋes erereŋior ekonirot, ikerianaror da; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.8",
            "verseOrgIds": [
              "JOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
