                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitoro kidiŋ oidukurun, kieorakis ituŋa atiar, ‘Kitemonokisi inyamat, naarai eriŋa apaarasia auni etuboro idokete ecor lo Yorodan, alomar airum akwap, nakiinakini EJAKAIT Ekusideke airum.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        }
