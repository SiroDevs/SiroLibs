            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emameun ituŋanan kere yenepedori abwoikin jo apaarasia kere nuka akoniijar: kwape ajaar kolo ka Musa, ajaikin kwape kwaŋin kajo da: mam ketukurwori jo, karaida aijal. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.5",
            "verseOrgIds": [
              "JOS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 1:6"
          },
          "items": [
