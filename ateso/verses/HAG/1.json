            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kisidik EJAKAIT emoyo loka Serubabel okoku loka Sealutiel, ekayaiton loka Yuda, ka emoyo loka Yosua okoku loka Yekosadak, esasedoti lopeti, ka imoyon da luka luedeuna kere kotuŋa; kopotu kiswamata aswam kotogo loka EJAKAIT loka ajoresjo, Ekecedeke, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.14",
            "verseOrgIds": [
              "HAG.1.14"
            ]
          }
        },
