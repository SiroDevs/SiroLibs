        },
        {
          "text": " Kodiekenenei ainapakin naka Kristo kotoma otauonokus, nakinyarakinio da toma akuan adiopet, kimalaenenete da. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.15",
