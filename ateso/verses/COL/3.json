            }
          ]
        },
        {
          "text": " Aso kitwataniasi akusitutubeta nuejaas akwap; adoteu, asilianut, ainekit, eimiel loerono, ka airaŋaanut, ŋes aima aputosia. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.6"
              },
              "items": [
                {
                  "text": "Pes 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanuka ŋun ŋes ebunokinia anyunyura naka Edeke odwe luiulaka. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipotu yesi da kolosenenete kolo kaŋun, naijariata kotomakec. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 3:8"
          },
          "items": [
