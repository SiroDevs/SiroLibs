              },
              "items": [
                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei kanen Eyonanit, karaida Eyudayat, akepio ka amamus akepio, imoit, Esukusit, ibulesit, karaida yenijakakai, konye Kristo ŋes kere, ejai da kotoma kere,",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        }
