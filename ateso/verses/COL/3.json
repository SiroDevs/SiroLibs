          ]
        },
        {
          "text": " Aso konapenenete etau loka aitim, asianut, aitasono, aiyapepera, atitiŋikin, kwape luseuna luka Edeke, lukalaunak ka luminan da; ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.12",
            "verseOrgIds": [
              "COL.3.12"
            ]
          }
        },
