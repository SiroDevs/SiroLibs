                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " koŋirionokinos, kisionionoros, arai ejai ituŋanan kere aŋurian kayenice, ido kwape kisionio yes Ejakait, yes da kisioniete kwape kwaŋin. ",
          "type": "text",
          "attrs": {
