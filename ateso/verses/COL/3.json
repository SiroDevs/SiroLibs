          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeniswamaete kere, kiswamaenenete kaijar kere, bala iswamanakinete Ejakait kwabo mere ituŋa, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
