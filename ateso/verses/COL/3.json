                "loc": "1CO.15.43"
              },
              "items": [
                {
                  "text": "1 Kor 15:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.21"
              },
              "items": [
                {
                  "text": "Pil 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.20"
              },
              "items": [
                {
                  "text": "Gal 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naetakanunia Kristo, ŋes aijarawok, kosodete yesi da itakanunete nepepe kaŋes kotoma aibuses.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
      ]
    },
