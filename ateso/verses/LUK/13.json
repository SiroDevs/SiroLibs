            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Apak naanyounio elopet etogo agoloki da ekek, igeunete yesi aibwo kokiŋa, ka aikuŋukuŋ ekek, kobalas ebe, ‘Wu okwe Ejakait, koŋaarai;’ eboŋokini ŋesi etemari atiar, ‘Mam ajeni nekiponiata.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.25",
            "verseOrgIds": [
              "LUK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
