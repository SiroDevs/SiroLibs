                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanen ejaun aimony ka airiamanakin ikel, naianyuniata Aburaam, ka Isaak, ka Yakob, ka inabin kere, kotoma ajakanut naka Edeke, ka yes da ikulepek kicakario kiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
