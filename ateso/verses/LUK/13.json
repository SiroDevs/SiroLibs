              "items": [
                {
                  "text": "1 Tim 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kokokito alomar kokek kaloedidiŋ: naarai katemari yes atiar, Ekotokinos luipu alomar kwabo mam epedorete. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
