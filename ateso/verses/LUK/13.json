              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyatak akelosit aitor koreria lukapolok ka ludidik, isisianakini, ebei Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
