          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit ŋes etuŋanan ediopet ebe, “Ejakait, ikidioko ca luitaiario?” Kotema kes atiar, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.23",
            "verseOrgIds": [
              "LUK.13.23"
            ]
          }
        },
