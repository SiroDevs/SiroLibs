            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " etemari ŋesi atiar, ‘Katemari yes atiar, Mam ajeni nekiponiata; irwa kamakaŋ, yes kere lukeswamak numam adolit.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
