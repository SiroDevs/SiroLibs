                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido koany, ejaas lukawasia lueraunos lusodit, ejaas da lusodit, lueraunos lukawasia.”",
          "type": "text",
          "attrs": {
