              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema bobo atiar, “Etupusi kinyo ajakanut naka Edeke? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eputosi kaitubuunet nakelemari aberu kibwa kotoma aitemisio auni nuka akiria, kiton neabuunioto kere.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.21",
            "verseOrgIds": [
              "LUK.13.21"
            ]
          }
        }
