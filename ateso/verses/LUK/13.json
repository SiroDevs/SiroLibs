                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanen igeunete atemar atiar, ‘Kipou kanyama kamata da kakonyenekon, ijo da kisisianakini korotinikosi;’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.26",
            "verseOrgIds": [
              "LUK.13.26"
            ]
          }
        },
