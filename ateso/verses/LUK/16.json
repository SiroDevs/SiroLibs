            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema kes atiar, “Iraas yesi luitojokas araut ikadolitok kakonyen nuka ituŋa, konye ejeŋi Edeke ikusitauon; naarai yenitopolooritai kotuŋa erai yeniketal kakonyen nuka Edeke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
