                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiwalaria akwap, kobur iserikalei kanuadoikis Petero, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.18",
            "verseOrgIds": [
              "ACT.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakemoia Kerode komam edumuni, kiŋitiŋit ikedarak, kicorak aario. Kosodi kijesar anyoun koYudaya alosit Kaisarea, kosalak nen.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.19",
            "verseOrgIds": [
              "ACT.12.19"
            ]
          }
        }
      ]
