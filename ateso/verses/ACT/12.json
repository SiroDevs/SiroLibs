                "loc": "ACT.15.37"
              },
              "items": [
                {
                  "text": "15:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedaunia aomoom ŋun, kolot togo loka Mariam, toto naka Yokana ŋol loerai ekekiror lokiareit Marako; ketukokina ituŋa luipu nen, ilipete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakikuŋukuŋio ekek loka erute, kobu apese ekekiror Roda ajaar. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakejenunia eporoto loka Petero, mam eŋaara ekek kanuka aiyalama, konye koker koloma toma, kobala ebe, “Ebwoi Petero kokek.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.24"
              },
              "items": [
                {
                  "text": "Asw 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.37"
              },
              "items": [
                {
                  "text": "Luk 24:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotemasi ŋes atiar, “Kikerepiki ca ijo.” Konye kitogogoŋ noi ebe ikote nen. Kotemasi atiar, “Erai ekemalaika.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kiyatak Petero aikuŋukuŋ; kiton neaŋaariata, koanyutu ŋes, koumokis. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kisililin kes kakekan, kitatamik kes kwape kelemunia ŋes Ejakait kotoma aidaris. Kotema atiar, “Kolimokis Yakob ka iinacan da akiro ŋun.” Kosodi konyou kolot aibois ace.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        }
      ]
    },
