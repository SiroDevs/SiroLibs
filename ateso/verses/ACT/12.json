                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kakuar kaŋin naakotor Kerode aitolomun ŋes, kojotoi Petero kokidiŋ kiserikalei iarei, eenitai kirikoi iarei, kojaas ikedarak okek idarete aidaris; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.6",
            "verseOrgIds": [
              "ACT.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.19"
              },
              "items": [
                {
                  "text": "Asw 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ido koany, kobwo emalaika loka Ejakait aapu kaŋes, kocau aica kagola; kinom Petero osiep kitwekeny, kobala ebe, “Konyou atipet.” Kodooto irikoi kakaninike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.7",
            "verseOrgIds": [
              "ACT.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema emalaika ŋes atiar, “Konap, kirupak da akonimuk.” Kiswama kwaŋin, Kotema ŋes atiar, “Kimukok ekonilou, kotupunai.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.8",
            "verseOrgIds": [
              "ACT.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koloma kotup ŋes; mam abu kojen ebe nueswamai emalaika eraas nukabeit, konye aomit ŋesi ebe aanyu aitapoet. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.9",
            "verseOrgIds": [
              "ACT.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naketuborotor kaidaret nasodit ka nakiareit, kodoloto okek lokasua lolomaret kiŋa toma ore; koŋaari bon, kolomasi kiŋa kitoroto orot ediopet; atipet kinye ŋes emalaika. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.10",
            "verseOrgIds": [
              "ACT.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi nakejenunia kotema atiar, “Kwana ajeni abeit ebe ejuku Ejakait ekemalaika alemun eoŋ kakan naka Kerode ka kere nuemuno ateker naka Iyudayan.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.11",
            "verseOrgIds": [
              "ACT.12.11"
            ]
          }
        }
      ]
    },
