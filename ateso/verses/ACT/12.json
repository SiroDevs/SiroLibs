              },
              "items": [
                {
                  "text": "Asw 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapak kaŋin korio Kerode ekabaka akekanin aikonakin erono ice lukokanisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koar Yakob onace loka Yokana kekileŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakeanyunia ebe itojokito Iyudayan, kiyatak aikamun Petero da. Keraas apaarasia ŋun nuka Imugatin lumam itubuunitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20+EXO.12.21+EXO.12.22+EXO.12.23+EXO.12.24+EXO.12.25+EXO.12.26+EXO.12.27"
              },
              "items": [
                {
                  "text": "Any 12:1-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakedaunia aikamun, kogolok aidaris, kibwaik akanin nuka irioŋeta iwoŋon luka iserikalei iwoŋon iwoŋon, tetere idarete; kokoto aitolomun ŋes neejaas ituŋa kedaun Aleleŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kidarai Petero kaidaris; konye kinyikokis noi lukokanisa ailip Edeke kanukeŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
