          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye koyaŋaasi ikekesisiak ŋes kuare, kitodokasi karwatat, kijoliliosi kobukit.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
