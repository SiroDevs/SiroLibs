              "items": [
                {
                  "text": "Gal 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye nakejenuniata iinacan, koyaŋaasi ŋes Kaisarea, kijukasi alosit Taruso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
