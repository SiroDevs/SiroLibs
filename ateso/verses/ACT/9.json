            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.20"
              },
              "items": [
                {
                  "text": "Asw 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye Baranaba koyaŋa ŋes, kitoloma mama ejaas ikiyakia, kitejen kes kwape keanyunia Ejakait koroto, ebe da kinera kaŋes, ido kwape kelimonokinia katitiŋ kokiror loka Yesu koDamasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kojau kakes kolomanari kolomununei da koYerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "elimonokini katitiŋ kokiror loka Ejakait; inera ka apeg ka Iyonanin; konye komootos kesi aiar ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
