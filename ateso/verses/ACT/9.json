            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kedol ŋesi Yerusalem, abu kotam aimorikikin kikesisiak; kokuriakaros ŋes kere, naarai mam eyuunito ebe kerai ekesisian, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
