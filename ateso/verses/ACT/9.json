            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kotema Ejakait ŋes atiar, “Kolot, naarai erai ŋol ibore yeneseunitai kamakaŋ adakar ekakiror kakonyen nuka atekerin ka ikabakan ka idwe luka Isirael; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
