            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye kojenu Saul ekecebotet. Kidarata korutei paaran ka kuare da tetere earete ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
