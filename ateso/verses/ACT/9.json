              },
              "items": [
                {
                  "text": "1 Kor 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.16"
              },
              "items": [
                {
                  "text": "Asw 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.22"
              },
              "items": [
                {
                  "text": "2 Tim 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiton ne da ejai ŋes apolou naebuni kaneejaas lusasedotin lupeti ajen kere lukiwoneete ekonikiror.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        },
        {
