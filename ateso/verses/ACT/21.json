            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso kiswama nukilimokini jo, Ejaas sio ikiliok iwoŋon lueenit aiyaposit; ",
          "type": "text",
          "attrs": {
