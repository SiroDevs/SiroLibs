              "items": [
                {
                  "text": "Luk 23:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " naarai ketupit ekodet loka ituŋa luipu, ecelasi, kobalas ebe, “Kicutasi ŋes!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
