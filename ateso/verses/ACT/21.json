                  "text": "Esk 44:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kocelut ebe, “Yes ikiliok luka Isirael, kiŋarakinai sio! Lo ŋes etuŋanan loisisianakini ituŋa kere kaiboisio kere asurokin atekerewok ka ikisila ka aibois na da; ido da ayau ŋesi Iyonanin toma oyekalu, amunaa aibois na nakalaunan.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
