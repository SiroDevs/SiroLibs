          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kibwaa ere kere, kokerut ituŋa; kikamutu Paul kibwosasi kiŋa keyekalu, atipet kogolokinoi ikekia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakemoototor epone loaret, kodolokis akiro ekapolon loka erioŋet ebe enyalinyalun Yerusalem kere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atipet kolem iserikalei ka ikapolokitokokec, koker mamakec; kosodete nakeanyuniata ekapolon ka iserikalei kinyeis aibuŋa Paul. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
