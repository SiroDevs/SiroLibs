            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mere kereka ijo Emisiriat je, loitonyounit pac ituŋa ilukumin iwoŋon lukenyaritai Ikaarak, kiŋarenik amodiŋ?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
