                  "text": "2 Tim 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai keanyunitos Toropimo Epesot nepepe kaŋes kore, koomitos da ebe ayau Paul ŋes toma oyekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
