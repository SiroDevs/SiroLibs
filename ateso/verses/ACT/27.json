            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ibusakinit aipok kapujan.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
