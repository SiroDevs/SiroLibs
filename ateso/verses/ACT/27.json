              "ACT.27.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.25"
              },
              "items": [
                {
                  "text": "2 Kor 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.29"
              },
              "items": [
                {
                  "text": "Leb 16:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kiilonya apaarasia, kojau aronis alosit naarai atuboros apaarasia nuka Ailuŋ, kidelu Paul, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kobala kes ebe, “Lukipa, aanyunit eoŋ ebe ejaun amunaar ka atwaniar alosit na, mere iboro bon ka ataker, konye aijarawok da.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye abu ekapolokiton kopupok ekekwaŋan lokapolon ka elopet ataker aitelekarit ŋun nuenera Paul. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido da mam ebusakinit edoket ŋol aiboio apak naka aaterot, kidelut luipu kakesi aikwaŋar anyoun kanen, tetere elemuni edolete Poenike, edoket loka Kurete, loetereikina agolitome nakokide, ka egalakimak nakokide, kasala nen kapak naka aaterot.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi napekusi ekwam lokeŋalakimak kiyamakina, koomitos ebe adumutu nukekotos, kibwosut edobo lokitapaikinet, kikwaŋaros aapu koitolima loka Kurete. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ketubor apak naedit kokut ekwam lokagogon, loenyaritai Eurakulon ebuni kaneonit, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kokutar ataker, mam epedoro atereikina ekwam, kajalakisi kikutario, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanen ketoro atipet ariri naka apujan naedit naenyaritai Kulauda, kekurautu ajen itaker. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kekiasi ŋes, kitwasamata aisigalikineta, koenikis kwap ataker; ido naarai kokuriaka aipok koSuritis, kijoliliosi iboro, kwaŋin kokutarai. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kiiliilit ekwam, apaaran naatupakini kogeut acakar iboro aŋolol; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "apaaran nakiwuniet da kocakanasi kakaninikec ikulepek iboro luka ataker. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam atakani akoloŋ karaida aacer apaarasia nuipu, kokuta sio ekwam loededeŋ, kokau kodaun amun kere naka aitajario.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakiboioto apak naapol mam enyamete, kosodi kobwo Paul kokidiŋikec, kotema atiar, “Lukipa, ti ebusakinit yes aiirar eoŋ, amamus aikwaŋar anyoun koKurete, adumun amunaar ka atwaniar na. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso kwana kecori yes kolakaros; naarai emameun yenetwaniari akeijar, dimarai ataker bon. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naarai kakuar kana abu emalaika loka Edeke, loarai eoŋ lokeŋ, loamaenenei da, kobwo aapu keoŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.11"
              },
              "items": [
                {
                  "text": "Asw 23:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kalimok eoŋ ebe, ‘Paul, sirikikurianar; ibusakinit ijo aibwo kakonyen nuka Kaisar; ido koany, kiinak Edeke ituŋa lu kere luiupatar.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso, lukipa, kolakaros, naarai eyuunit eoŋ Edeke, ebe ejaun kwape kalimokinitere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
