              "items": [
                {
                  "text": "Asw 27:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Napiwalari, kiŋaiŋa Paul kes kere ainyam inyamat, kobala ebe, “Lolo ŋes apaaran nakitomonet kaoŋon aidaret kailuŋ, komam inyamete ibore. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
