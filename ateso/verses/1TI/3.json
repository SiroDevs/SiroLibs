                "loc": "2TI.2.20"
              },
              "items": [
                {
                  "text": "2 Tim 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.19+EPH.2.20+EPH.2.21+EPH.2.22"
              },
              "items": [
                {
                  "text": "Pes 2:19-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye arai etumori, tetere ijenuni kwape ibusakinitor ituŋa ajaut kotoma otogo loka Edeke, loerai ekanisa loka Edeke lokajaran, epir ka eigaŋet loka abeit. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
        },
        {
