          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kewadikakini jo nu amuno abunore mamakon atipet, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
