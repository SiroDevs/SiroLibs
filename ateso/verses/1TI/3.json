            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.28"
              },
              "items": [
                {
                  "text": "Asw 20:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namunot akirot na ebe: Arai eŋaŋat etuŋanan araun ekaanyanaran, imiela aswam naejok. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.1",
            "verseOrgIds": [
              "1TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.6+TIT.1.7+TIT.1.8+TIT.1.9"
              },
              "items": [
                {
                  "text": "Tit 1:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso ibusakinit ekaanyanaran araun loemamei aitoronet, ekiliokit loka aberu adiopet, loitikokina, loecoit, loiyapaara, loisukunyikini ipejok, loejeni aisisianakin, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.2",
            "verseOrgIds": [
              "1TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lomam emer, lomam ibuŋai; dimarai lokaiyapepera, lomam eŋolopana, lomam emin apesan; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.3",
            "verseOrgIds": [
              "1TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.12"
              },
              "items": [
                {
                  "text": "1 Sam 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " loeyait ejok lukokaleke, loitononokikini ikedwe kaiyapaara kere; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.4",
            "verseOrgIds": [
              "1TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naarai arai mam etuŋanan ejeŋi ayait lukokaleke, ikwaikini ai imukei ekanisa loka Edeke? ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.5",
            "verseOrgIds": [
              "1TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mere ekeyuunan lokitetet, kinyek adakunun, ka aibirokin otube loka Satan. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.6",
            "verseOrgIds": [
              "1TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.10"
              },
              "items": [
                {
                  "text": "1 Tim 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.21"
              },
              "items": [
                {
                  "text": "2 Kor 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.12"
              },
              "items": [
                {
                  "text": "1 Kor 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ibusakinit lukokiŋa aitejen nukajokak kamakeŋ, kinyek aibirokin amorosit, kotoma atacit da naka Satan.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
