                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye jo, wu etuŋanan loka Edeke, koker ŋun, kotupenenei adolit, ayoŋit Edeke, aiyuun, amin, atitiŋikin, ka aiyapepera da. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.11",
            "verseOrgIds": [
