            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kecori jo kakonyen nuka Edeke loeinakini kere aijar, ka Kristo Yesu loetejenuni alimoret naejok mama ejai Pontio Pilato, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
