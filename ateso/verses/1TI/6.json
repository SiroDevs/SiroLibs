            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kidarenenei aicorakinet komamei akemer, komamei da aitoronet, kiton atakanun naka Ejakaitiwok Yesu Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
