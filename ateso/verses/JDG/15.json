          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodete Ipilisitian alosit, kidukuroto Yuda, kisiarakinos toma Leki, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.9",
            "verseOrgIds": [
              "JDG.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotemasi ituŋa luka Yuda atiar, “Kanukinyo iponiata yesi asurokin sio?” Kotemasi atiar, “Kiponit ajen Samuson, aiswamakin ŋes kwape abu ŋesi kiswamakinia sio.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.10",
            "verseOrgIds": [
              "JDG.15.10"
            ]
          }
        },
