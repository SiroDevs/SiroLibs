                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.29"
              },
              "items": [
                {
                  "text": "Luk 15:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen ketubor apak, kapak naka aidweny akima, abu Samuson kipejok akeberu kikalol; kotema atiar, “Alomari agola mama ejai akaberu.” Konye mam papake abu kisiik ŋes alomar. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.1",
            "verseOrgIds": [
              "JDG.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.20"
              },
              "items": [
                {
                  "text": "Tub 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema papa loka nin atiar, “Abeit abu kaomite ebe ila ijo ŋes eut; kanuka nun abu kakorak ŋes aupakon: mam kinaeike nadidi ejok adepar ŋes? Kenainait, koyana nin aiboisike.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.2",
            "verseOrgIds": [
              "JDG.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Samuson kes atiar, “Emameun eoŋ akirot irwan na kaneeiaas Ipilisitian, naameŋerekinia kes.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.3",
            "verseOrgIds": [
              "JDG.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.2.15"
              },
              "items": [
                {
                  "text": "Eko 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.4"
              },
              "items": [
                {
                  "text": "Esk 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolot Samuson kikam ikuei akwat auni, kolem akalasia, kiteteik ikorio, koenik akalas kidin kanulukorio iarei. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.4",
            "verseOrgIds": [
              "JDG.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kedau ŋesi aisinepikin akalasia, abu koosik kes alosit akima nuka Ipilisitian, kiewe ikes, ka akima nuabwoete, ka iseitunin da. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.5",
            "verseOrgIds": [
              "JDG.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.15"
              },
              "items": [
                {
                  "text": "Tub 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodete Ipilisitian atemar ebe, “Iŋai eswama nu?” Kotemasi atiar, “Samuson, ekamuran loka Etimunit, naarai abu koyana akeberu, kosodi akorakin aupake.” Kopotu Ipilisitian, kieweata ŋes ka papake kakim. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.6",
            "verseOrgIds": [
              "JDG.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Samuson atiar, “Arai iswamaete yesi nuikote nen, abeit enyanar eoŋ kamakus, kasodi konyet apalar.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.7",
            "verseOrgIds": [
              "JDG.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.4.3"
              },
              "items": [
                {
                  "text": "1 Siit 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.6"
              },
              "items": [
                {
                  "text": "2 Siit 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodany kes noi, jokan, aiar naepol: kolot kiboikin acilet naka emoru loka Etam,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.8",
            "verseOrgIds": [
              "JDG.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
