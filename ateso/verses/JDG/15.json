                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kodum abokony nakitetet naka asigiria, korio akekan, kitin, kodanyia ituŋa elukumit. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
