          "items": [
            {
              "text": "17:5",
              "type": "text"
            },
            {
              "text": "iterapim kes aputosia nuka idekesio.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kotiak ediopet kodweke, koraun do ŋol esasedotike. ",
          "type": "text",
          "attrs": {
