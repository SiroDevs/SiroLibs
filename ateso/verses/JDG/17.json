                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kinyakaki ŋesi totoke apesan, abu totoke kolem atutubeta akwat aarei nuka cpuesa, kijaik ekatatan, loeswamaunia nun aput naegerer ka aput nacaluna: koiaun togo loka Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        },
