            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kobu Kanani, ediopet koinaeanaka koYuda, ŋes ka icetuŋa; keŋitata nuka Iyudayan kaluakuete, luapotu kosalakinitos toma aijoreorio, ka akiro da nuka Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
