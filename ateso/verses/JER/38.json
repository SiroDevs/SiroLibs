              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi ilimokini kes ebe, ‘Abu kenaina ekabaka, kenyek ainyakar togo loka Yonatan, kenyek atwanikin ŋina.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
