          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kiirasi lukapolok ebe kinere kaio, epote kesi neiiai atemar ebe, ‘Aso cani kolimokinai nuibu kolimok ekabaka; bobo da nukilimok eka baka jo; sirikiimunonik sio, mam sio kiari jo’; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
