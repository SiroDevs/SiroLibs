          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye arai kiŋer alomar, na ŋes akirot naabu EJAKAIT ketodik eoŋ: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
