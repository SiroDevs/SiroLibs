          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koany, aŋor kere nukinyeinio kotogo loka ekabaka loka Yuda itolomunio mama ejaas ikapolok luka ekabaka loko Baulon, iŋerete aŋor kwa ebe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
