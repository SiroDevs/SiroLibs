              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.1"
              },
              "items": [
                {
                  "text": "43:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ido kwape etini loerono, lomam epedori anyamio, naarai erono noi, abeit ebala EJAKAIT ebe, Ekonakini kwaŋin Sedekia ekabaka loka Yuda, ka ikapolokoke, ka luapianunos koYerusalem, luasalakinete akwap na, ka nul da luibojete kakwap nako Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.44.13"
              },
              "items": [
                {
                  "text": "Sab 44:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejaikini kes aisiarisiario kanuka aronis toma ajakanuto kere nuka akwapin; araun amorosit, agaracio, ainyanakinio ka ekenit, kaiboisio kere nuereneari kes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiukari da ekileŋ, ka eteŋei, ka atular, mamakec, aitodol naemudiarotor kakwap naainakinit kes ka lukapapaakec.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
