                "loc": "PSA.119.2"
              },
              "items": [
                {
                  "text": "Sab 119:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ainakini kes etau lokajenun eoŋ, ebe Eoŋ EJAKAIT: kes da eraunos ikatuŋa, eoŋ da araun Ekecedeke: naarai eboŋunete mamakan kikecetauon kere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
