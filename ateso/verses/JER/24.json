                  "text": "33:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai ebwaikini akakonye mamakec kanuka ajokis, enyakuni bobo kiton akwap na. Eoŋ da aduki kes, kwabo mere aibiror; erai kes, kwabo mere arutor. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
