                  "text": "Aku 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Idokwape kwaŋin Iyudayan kere luajaas toma Moab, ka lukotoma odwe luka Amon, kotoma Edom, ka luajaas toma akwapin kere, nakiirariata kwape esidonio ekabaka loko Babulon aatoŋot kotoma Yuda, ido adakaki Gedalia okoku loka Akikam, okoku loka Sapan ayait kes, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kosodete koboŋut Iyudayan kere anyoun kaiboisio kere nuerenearitai, kopotu toma akwap naka Yuda, mama ejai Gedalia, Misipa, kotukonokis ebino ka araito nuka akamu nuipu noi teni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
