                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiirariata ikapolok kere lukorioneta luajaas okitui, kes ka ikecetuŋa, ebe, ainak ekabaka loko Babulon Gedalia okoku loka Akikam, ayait akwap, ido etitin ikiliok ka aŋor ka idwe ludidik, kaijul lukican luka akwap, lumam eioreoritai Babulon; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
