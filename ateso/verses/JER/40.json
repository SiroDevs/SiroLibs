              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.13"
              },
              "items": [
                {
                  "text": "Ikis 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, ajaenena eoŋ Misipa, abwoenen kakonyen nuka Ikaludean, luepote mama kija oni. Konye yes, korukonokinete ebino, ka araito nuka akamu ka akinyet, kibwaanakinete oborokus, kiboienenete koreriakus luiruma.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        },
        {
