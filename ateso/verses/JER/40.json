            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi Gedalia okoku loka Akikam, okoku laka Sapan, kiyapoik kes ka ikecetuŋa kinera atiar, “Sirikiyoŋa aiiaanakin Ikaludean. Kiboikinos akwap, kijaanakis ekabaka loko Babulon, ido ijaununete ejok, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
