              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kopotu mama ejai Gedalia Misipa, Isimael okoku loka Netania, ka Yokanan ka Yonatan odwe luka Karea, ka Seraia okoku loka Tanumet, ka odwe luka Epai Enetopatit, ka Yesania okoku loka Emaakatit, kes ka ikecetuŋa da. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
