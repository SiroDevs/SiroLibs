        {
          "text": " Kosodi Yeremia alosit mama ejai Gedalia okoku loka Akikam, Misipa, kiboikin oreke otuŋa luasalito kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.6",
