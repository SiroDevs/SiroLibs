              "items": [
                {
                  "text": "Mik 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kolimok kes ebe: Kiirasi yesi akirot naka EJAKAIT, yes ikabakan luka Yuda, ka Yuda kere, ka luibojete kere koYerusalem, luelomununete korutei kalu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.32"
              },
              "items": [
                {
                  "text": "Mar 15:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.15+NEH.13.16+NEH.13.17+NEH.13.18+NEH.13.19+NEH.13.20+NEH.13.21+NEH.13.22"
              },
              "items": [
                {
                  "text": "Nek 13:15-22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJAKAIT kwanata ebe: Kocoito bonik, siribwokenenete lubwokon kapaaran naka asabato, karaida aitolomun korutei luka Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.8+EXO.20.9+EXO.20.10"
              },
              "items": [
                {
