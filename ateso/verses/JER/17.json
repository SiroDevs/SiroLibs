              "type": "text"
            }
          ]
        },
        {
          "text": "Kabala EJAKAIT eoŋ kwanata ebe: “Kolot, kobwo korute loka idwe luka ituŋa, neelomununiata ikabakan luka Yuda neelomanariata da, korutei kere luka Yerusalem, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
