                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.31"
              },
              "items": [
                {
                  "text": "Esk 18:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kanukinyo ikototor atwakare, ijo ka ikonituŋa, kanuka ekileŋ, ka eteŋei, ka atular, kwape ineritor EJAKAIT nuka ateker naeneri aijaanakin ekabaka loko Babulon? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
