            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kabala EJAKAIT kwanata ebe: “Kiswamau aunoi ka aiookon, koenik omurisinikon, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
