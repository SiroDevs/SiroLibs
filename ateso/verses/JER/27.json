            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Atekerin da kere ijaanakincte ŋes ka okokuke, ka orataitike, aitodol needolioto apaarasia nuka akekwap: kosodete itubusianete ŋes atekerin nuipu ka ikabakan lukapolok.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
