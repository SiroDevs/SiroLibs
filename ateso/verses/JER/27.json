            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kijukak ace mama ejai ekabaka loka Edom, ka ekabaka loka Moab, ka ekabaka loka idwe luka Amon, ka ekabaka loka Turo, ka eka baka loka Sidon, kakanin nuka ikiyakia luepote Yerusalem mama ejai Sedekia ekabaka loka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitetemik kes akiro nu ainar ikapolokokec kobala ebe: Inera kwanata EJAKAIT loka aioresio, Edeke loka Isirael ebe: Ilimokinete lukapolokokus kwanata ebe: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
