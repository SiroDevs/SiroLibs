            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do koany, abeit kekeuni yes, kacakari yes, ka ere da loabu kainak yes ka lukapapaakus, aolior kama ajai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.39",
            "verseOrgIds": [
              "JER.23.39"
            ]
          }
        },
