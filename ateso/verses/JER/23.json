                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.10"
              },
              "items": [
                {
                  "text": "1 Pet 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Enabi loerujai, mere kolimok airujasit; ka ŋin da yenika akakirot, kinera akakirot teni. Ebala EJAKAIT ebe, Ikwaikinete ai agugu eriakakinos alos? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.28",
            "verseOrgIds": [
              "JER.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala EJAKAIT ebe, Mere esubit akakirot akim? Ido bala anyul naebwanabwanal amor? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.29",
            "verseOrgIds": [
              "JER.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
