                "loc": "JER.33.16"
              },
              "items": [
                {
                  "text": "Yer 33:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.30"
              },
              "items": [
                {
                  "text": "1 Kor 1:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eyuunio Yuda kotoma apaarasiake, Isirael da iboienenei kainapakina. Emaikinio rwaru ŋes ekiror lo ebe, ‘EJAKAIT ŋes adolitewok.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.6",
            "verseOrgIds": [
              "JER.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aso do koany, ebala EJAKAIT ebe, Ŋes eponitotor apaarasia numam bobo ebalananatar ebe, ‘Kwape ejaria EJAKAIT lokolo etolomuni idwe luka Isirael kakwap nako Misiri’; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.7",
            "verseOrgIds": [
              "JER.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.5"
              },
              "items": [
                {
                  "text": "Isa 43:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " konye ebe, ‘Kwape eiaria EJAKAIT lokolo etolomuni kinarenik da aur naka ekek loka Isirael akwap naka ari naka agolitomei; ido anyoun kakwapin da kere nuabu kereŋeanarite kes.’ Kosodete aiboikin akwapukee obe.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.8",
            "verseOrgIds": [
              "JER.23.8"
            ]
          }
        }
      ]
    },
