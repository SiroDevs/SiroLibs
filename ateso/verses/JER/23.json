                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido kainuni yes amorosit namam edaun ka ileic lumam enaŋete, lumam imurwokinio.’’’",
          "type": "text",
