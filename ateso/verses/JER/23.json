              "type": "text"
            }
          ]
        },
        {
          "text": " “Koany, ebala EJAKAIT ebe, Eponito apaarasia, nuetilibikinia rwaru Daudi Atenu naedolit, ido kirumite kwape ekabaka, kokeriana, ido ipiori itubesia kabeit kotoma akwapin. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.5",
            "verseOrgIds": [
              "JER.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 23:6"
