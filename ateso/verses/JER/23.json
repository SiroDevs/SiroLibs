              "items": [
                {
                  "text": "Sek 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.11"
              },
              "items": [
                {
                  "text": "Mik 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Elimonokinete tiritir ŋul luemwanito akirot naka EJAKAIT ebe, ‘Ŋaunos ejok’; kolimonokinete ŋin yenelosi kaninik naka etauke ebe, ‘Mam aronis kidoikini jo.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.17",
            "verseOrgIds": [
              "JER.23.17"
            ]
          }
        }
