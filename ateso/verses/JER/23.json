              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ebala EJ AKAIT ebe, Aso koany, asurokini inabin, luekokoanakinos akakiro, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.30",
            "verseOrgIds": [
              "JER.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala EJAKAIT ebe, Asurokini inabin, luitwasamaete aŋajepakec kobalas ebe, ‘Ebala EJAKAIT ebe’. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.31",
            "verseOrgIds": [
              "JER.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.4"
              },
              "items": [
                {
                  "text": "Sep 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, ebala EJAKAIT ebe, asurokini ŋul luedwarete airujasia nukainal, aitatamanakin, aitapaar ikatuŋa kanuka ainalakec, kanuka ailabilabanutukec naatai, kwabo mam eoŋ ejukarit kes, karaida aicorakin, Ebala EJAKAIT ebe, mam eyaunete adiojokis otuŋa lu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.32",
            "verseOrgIds": [
              "JER.23.32"
            ]
          }
        }
      ]
