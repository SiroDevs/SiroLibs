                "loc": "MAL.1.1"
              },
              "items": [
                {
                  "text": "Mal 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“N akinisiata jo ituŋa lu, arai enabi, arai esasedoti kineras ebe, ‘Anyoin abwokon naka EJAKAIT?’ kosodi ijo ilimokini kes ebe, ‘Abwokon ani? Ebala EJAKAIT ebe, Kacakari yes.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.33",
            "verseOrgIds": [
              "JER.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye enabi ka esasedoti ka ituŋa luetemarete ebe, ‘Abwokon naka EJAKAIT,’ eticani eoŋ etuŋanan ŋol ka ekekal. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.34",
            "verseOrgIds": [
              "JER.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemanaros ŋinituŋanan kikeidunyet, ka ŋinituŋanan konaeeke atiar, ‘Biai bo abonoki EJAKAIT?’ ido ‘Biai bo atema EJAKAIT?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.35",
            "verseOrgIds": [
              "JER.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 23:36"
          },
          "items": [
