              "items": [
                {
                  "text": "Tub 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Luelosikinito aisimurwokin ikatuŋa ekakiror kanuka airujasiakec nuelimonokini ŋinituŋanan ekeidunyet, kwape kimurwokiniata lukapapaakec ekakiror kanuka Baal. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.27",
            "verseOrgIds": [
              "JER.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 23:28"
          },
          "items": [
