            }
          ]
        },
        {
          "text": " Kosodi nakiiraria Yokana kaidaris aswamisio nuka Kristo, kijuka ikekesisiak aiŋit, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
