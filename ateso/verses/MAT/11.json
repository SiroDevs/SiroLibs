                "loc": "JHN.3.6"
              },
              "items": [
                {
                  "text": "Yok 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobala ebe, “Itukwi ijo Korasin! Itukwi ijo Betesaida! Naarai arai kiswamatai koTuro ka Sidon nukaumokin nukiswamatai kamakus, ti kitoronikinos ŋo sek, ka ainap da ipukoi ka ekurwon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye katemari yes atiar, Epatanikini rwaru Turo ka Sidon atitiŋikin kapaaran naka etube aitelekarit yes. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
