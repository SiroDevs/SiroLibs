                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobalas ebe, “Irai kereka ijo ŋol loebunit, arai bo kedarata ece?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok Yesu kotema kes atiar, “Koloto, kolimokis Yokana akiro nuiirasi ka nuianyut: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.5+ISA.35.6"
              },
              "items": [
                {
                  "text": "Isa 35:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.1"
              },
              "items": [
                {
                  "text": "61:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ekwenyunete imudukiok, elosete iŋwalasik, iswagio lukatapon, epupete ikimiŋiok, itajario lukatwak, elimonokinio da lukican akiro nukajokak. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.57"
              },
              "items": [
                {
                  "text": "Mat 13:57",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.31"
              },
              "items": [
                {
                  "text": "26:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Isirereŋitoi da ŋol lomam itiguikin kanukaŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.6",
            "verseOrgIds": [
              "MAT.11.6"
            ]
          }
        }
      ]
