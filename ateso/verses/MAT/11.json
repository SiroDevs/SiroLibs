        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Konye etupusi kinyo atur na? Eputos kidwe luiboiete kagwelanaret luenyaritos ipaupakec kobalas ebe,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.16",
            "verseOrgIds": [
              "MAT.11.16"
            ]
          }
        }
      ]
