                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kobu Yesu neejaas kinera kakes, kotema atiar, “Kainakin eoŋ apedor kere kokuju kakwapin da. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
