                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akaulo kasabato, napecila kide kapaaran nasodit nakasabato, koloto Mariam Magadalene ka Mariam ace aanyun ates. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kejai amaran naka akwap; naarai kodok emalaika loka Ejakait kokuju, kobu kikokoro amoru awai, kiboikin kujuke. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.2",
            "verseOrgIds": [
              "MAT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.2"
              },
              "items": [
                {
                  "text": "Mat 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.10"
              },
              "items": [
                {
                  "text": "Asw 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotakanu bala eimilia, ikenapen da kiliacanito kiac. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komaranata ikedarak kanuka akurianar ŋes, kosubata bala lukatwak, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koboŋok emalaika kotema aŋor atiar, “Sirikikuriakaros yesi; naarai ajeni ebe imootos Yesu lokibubukinitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.23"
              },
              "items": [
                {
                  "text": "17:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.20.19"
              },
              "items": [
                {
                  "text": "20:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.36"
              },
              "items": [
                {
                  "text": "Asw 2:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Emamei kane; naarai ajaru, kwape eneritor. Kopotu koanyut aibois naeperikinitoi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.6",
            "verseOrgIds": [
              "MAT.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.32"
              },
              "items": [
                {
                  "text": "Mat 26:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koloto yesi da atipet, kolimokis ikekesisiak ebe, ‘Ajaru kotoma okatwak’; ido koany, kiŋarenikini yes alosit Galilaya; ianyikinete ŋes ŋina; koany kadau alimokin yes.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.7",
            "verseOrgIds": [
              "MAT.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyout atipet kates kakurian ka aiyalama naepol, kokerata alimokin ikekesisiak. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.8",
            "verseOrgIds": [
              "MAT.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido koany, kiriamakin Yesu kakes, kobala ebe, “Yoga!” Kikunyakis kitiŋata akekejen komaata ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.9",
            "verseOrgIds": [
              "MAT.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.11"
              },
              "items": [
                {
                  "text": "Bur 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.45.4"
              },
              "items": [
                {
                  "text": "Age 45:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.19"
              },
              "items": [
                {
                  "text": "50:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Yesu kotema kes ariar, “Sirikikuriakaros; koloto kolimokis ikainacan koloto Galilaya, ŋina kaanyikinete.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.10",
            "verseOrgIds": [
              "MAT.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napelosete, koany, kolomasi ice kokedarak ore, kolimokis isasedotin lupeti akiro nukedoikinete, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.11",
            "verseOrgIds": [
              "MAT.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotukokinos nepepe kimakio kinerut, koinakis iserikalei arupiyan nuipu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.12",
            "verseOrgIds": [
              "MAT.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.64"
              },
              "items": [
                {
                  "text": "Mat 27:64",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kobalas ebe, “Kinerata yesi ebe, ‘Apotu ikekesisiak kopotu kuare, kokokwasi ŋes kiiotoi isio.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.13",
            "verseOrgIds": [
              "MAT.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai kiirar akirot na kama ekayaiton, kimaimai isio ŋes, kinyeis yes aiticanio.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.14",
            "verseOrgIds": [
              "MAT.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kolemasi arupiyan kiswamata kwape kisisianakinitere; kisiarakin akirot na toma oYudayan kiton lolo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.15",
            "verseOrgIds": [
              "MAT.28.15"
            ]
          }
        }
      ]
    },
    {
