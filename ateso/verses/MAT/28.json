                {
                  "text": "Mat 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye kolot ikesisiak itomon ka lodiopet Galilaya, oroŋat lokicorakinit kes Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.16",
            "verseOrgIds": [
              "MAT.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakeanyuniata ŋes, komaata; konye kobuonokinos ice kakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.17",
            "verseOrgIds": [
              "MAT.28.17"
            ]
          }
        },
        {
          "name": "verse",
