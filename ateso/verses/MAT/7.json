            }
          ]
        },
        {
          "text": "“Kolomasi aitor orute loedidiŋ; naarai elal erut, ipajajai da erot, loebei amudiario, luelomarete da kotomake eraas luipu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
