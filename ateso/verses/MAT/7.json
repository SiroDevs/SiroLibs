              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kotep akiru, kolelek akalele, kokuta ikwamin, koleata etogo ŋol; mam ibiroro: naarai kepesikinitai atiida. ",
          "type": "text",
          "attrs": {
