                  "text": "Mat 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Sirikiinakis iŋokwo ibore yenikalaunan, ido sirikicakakis akusilulun kakonyen nuka ipegei, kinyeis aicakacak kakejekec, ka aibelokin agwaragwar yes.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        }
      ]
