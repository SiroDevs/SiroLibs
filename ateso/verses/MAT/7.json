              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋin da yeniirari akakiro nu, komam iswamai, ituputoorio ketuŋanan lobaŋ, lokeduki eketogo asiŋe: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
