            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kocoito inabin Iukeŋalak, lukiponikinete enapito inapen luka amerekekin, konye kotoma eraas ipeen luededeŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.15",
