            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.13.8+ROM.13.9+ROM.13.10"
              },
              "items": [
                {
                  "text": "Rom 13:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso nuikotosi ituŋa aikonakin yes, kikonakis yesi da kes kwape kwaŋin: naarai ŋun kes ikisila ka inabin da.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.12",
            "verseOrgIds": [
              "MAT.7.12"
            ]
          }
        }
