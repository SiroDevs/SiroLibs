          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.24"
              },
              "items": [
                {
                  "text": "Mat 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.22"
              },
              "items": [
                {
                  "text": "Asw 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Edidiŋ erut, eridid da erot loebei aijar, luedumunete da eraas luikidioko.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.14",
            "verseOrgIds": [
              "MAT.7.14"
            ]
          }
        }
      ]
