              "items": [
                {
                  "text": "2 Pet 1:17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ketuboros apaarasia akanykape abu Yesu koyaŋa Petero ka Yakob ka Yokana onaceke, kogitaros bonik, kitodoka ŋesi kes oroŋat loeoja.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        }
      ]
