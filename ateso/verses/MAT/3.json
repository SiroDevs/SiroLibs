                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi konyou Yesu koGalilaya, kobu Yorodan mama ajai Yokana aibatisao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye kokoto Yokana aitikokin, ebala ebe, “Epuda jo aibatis eoŋ, ijo da ibuni mamakaŋ?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye Koboŋok Yesu, kolimok ŋes ebe, “Kocam do kwana; naarai kwaŋin ibusakinitor oni aitodol adolit kere.” Kosodi kocam. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
