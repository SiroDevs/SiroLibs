            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Abeit eoŋ ebatisai kakip kanuka aitoronikin: konye loebuni atupakin eoŋ ketelekarit eoŋ agogoŋ, mam kebusakinit akodit akemuk; kibatisai ŋol yes kEmoyo Lokalaunan, ka akim. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.30"
              },
              "items": [
                {
                  "text": "Mat 13:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ejai ekeritei akanike, epiari cut ekepejal; etukonokini akimake odula, konye icwei agugu kakim namam itudeŋio.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
