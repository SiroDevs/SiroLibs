            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema atiar, “Alu?” Kotema Yesu atiar, “Siriari, Siridote, Sirikokoi, Sirisabanakinenei, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.18",
            "verseOrgIds": [
