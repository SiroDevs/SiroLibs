              },
              "items": [
                {
                  "text": "Bur 10:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ŋinituŋanan yenikinyeini itogoi, arai iinacan, arai ainacan, arai papa arai toto, arai idwe arai amanat, kanuka ekakiror, edumuni irwan akwatat ka airum da aijar naka ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
