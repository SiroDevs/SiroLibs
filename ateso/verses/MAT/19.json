              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen nakedaunia Yesu akiro ŋun, konyou koGalilaya, kodol oikorun luka Yudaya okekwa Yorodan. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
              "MAT.19.1"
            ]
          }
        },
        {
