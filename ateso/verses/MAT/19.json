            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye luipu lueraas lusodit eraunete lukawasia, ka lukawasia da eraunete lusodit.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
