                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema ŋes atiar, “Kanukinyo kiŋisia eoŋ nuka ajokis? Ejai ediopet loerai loejok. Konye arai ikoto alomar aijar, koricite ikisila.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.17",
            "verseOrgIds": [
              "MAT.19.17"
            ]
          }
        },
