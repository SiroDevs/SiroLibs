              "items": [
                {
                  "text": "Leb 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koyoŋitenenei papakon ka totokon, Komina da ikoniidunyet kwape iminar bon.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
            ]
          }
        },
        {
