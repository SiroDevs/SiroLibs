          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Yesu ikekesisiak atiar, “Abeit katemari yes atiar, etionikini ekabaran alomar toma ajakanut naka akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
