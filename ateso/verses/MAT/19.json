            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nakiiraria etelepat ŋun kolot itururwei; naarai kejaas iboro luipu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
