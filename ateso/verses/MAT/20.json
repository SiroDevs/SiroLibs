                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye mam ikote nen kamakus; konye ŋinituŋanan yenekoto araut yenikapolon kamakus korau ikusikejaanakinan, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
