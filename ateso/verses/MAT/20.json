          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema kes atiar, “Imasete bo akolika, konye aiboikin akanika nakoteten ka nakokediany, mere nakaŋ aikor, konye erai nakec kaŋul kaluitemokinit Papaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
