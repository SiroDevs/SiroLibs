            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.18"
              },
              "items": [
                {
                  "text": "Isa 30:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.5+JER.17.6+JER.17.7+JER.17.8"
              },
              "items": [
                {
                  "text": "Yer 17:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotitinior, ketodiasi ekiliokone kanuka ituŋawok, ka ireria luka Edekewok: kiswama EJAKAIT nuitojokit ŋesi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.13",
            "verseOrgIds": [
              "1CH.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 19:14"
          },
          "items": [
