                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.7"
              },
              "items": [
                {
                  "text": "Ikis 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kikunyak do Yoab ka ituŋa lukejaas kaŋes aitiji Isurian; kokerata kakonyeneke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.14",
            "verseOrgIds": [
              "1CH.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keanyut idwe luka Amon ebe akerata Isurian, kokerata kesi da kakonyen nuka Abisai onaceke, kolomasi ore, Kosodi Yoab abunore Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.19.15",
            "verseOrgIds": [
              "1CH.19.15"
            ]
          }
        }
      ]
    },
