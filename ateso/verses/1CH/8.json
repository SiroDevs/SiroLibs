              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosa kouri Binea; Rapa ŋes okokuke, Eleasa okokuke, Asel okokuke: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
