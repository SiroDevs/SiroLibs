              "type": "text"
            }
          ]
        },
        {
          "text": "Akas kouri Yekoada; Yekoada kouri Alemet, ka Asamabet, ka Simiri; Simiri kouri Mosa: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
