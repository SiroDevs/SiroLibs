            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi Gad atiar, “Katiokikis noi: mere kebirokin akan naka EJAKAIT: naarai, epol noi akeitim: kenyek aibirokin akan naka ituŋanan.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.13",
            "verseOrgIds": [
              "1CH.21.13"
            ]
          }
        }
      ]
