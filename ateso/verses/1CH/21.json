                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai kapak kaŋin kejai ewema lokalaunan loka EJAKAIT, loabu Musa kosub kamodiŋ, ka etem loka ainakineta nuieweio aibois naicelelei koGibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
