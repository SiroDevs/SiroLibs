              "items": [
                {
                  "text": "1 Siit 28:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.25"
              },
              "items": [
                {
                  "text": "1 Ika 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.4"
              },
              "items": [
                {
                  "text": "5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Koany, kiwurikinio jo esapat, loeraun etuŋanan loka ainapakin: esinapikini eoŋ ŋes kama kalukasurupoke kere luirimorito: naarai emaikinio ekekiror Solomon, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:9",
              "type": "text"
            },
            {
              "text": "Solomon Ebe Lokainapakin.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ainakini eoŋ Isirael ainapakin ka aiyamakin kapaarasiake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
