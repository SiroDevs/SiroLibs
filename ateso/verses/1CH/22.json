                {
                  "text": "Ikis 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.9"
              },
              "items": [
                {
                  "text": "1 Ika 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.1"
              },
              "items": [
                {
                  "text": "Sab 72:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye ca koinak EJAKAIT jo acoa ka ajenun, kicorak jo nuka Isirael; tetere iricit ekisil loka EJAKAIT Ekonideke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
