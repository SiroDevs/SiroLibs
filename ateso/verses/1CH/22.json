        },
        {
          "text": " Kosodi Daudi atemar atiar, “Lo ŋes etogo loka EJAKAIT Edeke, lo ŋes etem loka ainakineta nuieweio loka Isirael.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
