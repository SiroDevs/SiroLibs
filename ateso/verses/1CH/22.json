                {
                  "text": "Rom 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso, ikakoku, koiai EJAKAIT kajo; kokerianar, koduk etogo loka EJAKAIT Ekonideke, kwape alimokinia ŋesi nukon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
