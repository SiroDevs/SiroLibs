              "items": [
                {
                  "text": "1 Ika 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kicorak Daudi atukonokin imo lukeiaas akwap naka Isirael; kibwaik ikadukok aike amor aiduk etogo loka Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.47"
              },
              "items": [
                {
                  "text": "1 Ika 7:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kitemok Daudi asua nuipu noi nuka isumalin luka ikirigin luka irutei, ka luimorikikinete; ka aisinin nuipu noi numam ininos; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.6"
              },
              "items": [
                {
                  "text": "1 Ika 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ka iresia lumam imarunos; naarai apotu Isidonin ka luka Turo koyaut iresia luipu noi mama ejai Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.7"
              },
              "items": [
                {
                  "text": "1 Ika 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.1"
              },
              "items": [
                {
                  "text": "1 Siit 29:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kotema Daudi atiar, “Edit Solomon okokuka, enonok, kibusakinit etogo loekotoi adukokin EJAKAIT korai loitopolooritai, loka eemut, ka loka aibuses anatar akwapin kere: kanuka ŋun etemokini eoŋ iboroke.” Kitemok Daudi luipu noi eroko ketwana,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
