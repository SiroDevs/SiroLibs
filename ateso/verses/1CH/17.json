              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aso do wu EJAKAIT, irai ijo Edeke, isumunik ekonikeiaanakinan akirot nin naejok: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
