                {
                  "text": "Asw 7:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen, kiboikin Daudi togoke, kotema Daudi Natan enabi atiar, “Koany, eboie eoŋ kotogo loka eres, konye iboie asaduku naka aitutuket naka EJAKAIT kotoma aigalisio.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotema Natan Daudi atiar, “Kiswama kere nuejaas otaukon; naarai ejai EJAKAIT kajo.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen kakuare kaŋin, kobu akirot naka Edeke mama ejai Natan ebe, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.3",
            "verseOrgIds": [
              "1CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kolot kolimok Daudi ekakeiaanakinan ebe, ‘Inera EJAKAIT kwanata ebe, Mam jo idukokini eoŋ etogo loeboieneno: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.4",
            "verseOrgIds": [
              "1CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.2"
              },
              "items": [
                {
                  "text": "Any 40:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.17"
              },
              "items": [
                {
                  "text": "2 Sam 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.4"
              },
              "items": [
                {
                  "text": "1 Ika 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai mam eoŋ eboikino togo ageun kapaaran naetolomunia Isirael kiton lolo: konye alosenenei anyoun kowema kiton owema, anyoun kowema lokalaunan kiton ece da. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.5",
            "verseOrgIds": [
              "1CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaiboisio kere nualosenen kaIsirael kere, abu eoŋ kener akirot kedio kokatubok luka Isirael, lueeorakinit aitanyam ikatuŋa ebe, “Kanukinyo mam yes kidukokiniata eoŋ etogo loka eres?’” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.6",
            "verseOrgIds": [
              "1CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aso do kolimok Daudi ekakejaanakinan kwanata ebe, ‘Inera EJAKAIT loka ajoresio kwanata ebe, Abu kalem jo korony, katupit amerekekin, tetere iraun ekapolon ayait ikatuŋa Isirael: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.7",
            "verseOrgIds": [
              "1CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajaenena eoŋ kaio kama ilosenenei kere, amudia lukasurupokon kere kakonyenekon; etuluor jo ekiror, kwape ekiror loka lukapolok luejaas kakwap. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.8",
            "verseOrgIds": [
              "1CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.12"
              },
              "items": [
                {
                  "text": "Yer 31:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.14"
              },
              "items": [
                {
                  "text": "Esk 34:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.2"
              },
              "items": [
                {
                  "text": "2 Siit 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.17"
              },
              "items": [
                {
                  "text": "Isa 49:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aseikini ikatuŋa Isirael aibois, eraikini kes, tetere iboiete aiboisikec, komam bobo itwobosete; komam bobo idwe luka aronis iticanete kes, kwape lem sek, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.9",
            "verseOrgIds": [
              "1CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape kapaaran naeeorakinia eoŋ ikatubok ayait ikatuŋa Isirael; etonokokiari lukasurupokon kere. Bobo da alimokini jo ebe kidukokini EJAKAIT etogo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.10",
            "verseOrgIds": [
              "1CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kedoloto apaarasiakon, ilosi ijo ajaut kalukapapaakon, adakakini eoŋ aurikon naetupakini naelomuni kodwekon; etieasi da ajakanutuke. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.11",
            "verseOrgIds": [
              "1CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋol ŋes kadukokini etogo, etieasi eoŋ ekeicoloŋ loka ajakanut ikar kere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.12",
            "verseOrgIds": [
              "1CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
