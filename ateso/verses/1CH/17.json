                  "text": "Bur 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Araun eoŋ papake, ŋes da eraun okokuka: mam alemari akaitim kamake, kwape abu kalemaria kama kanol kalokinarenikinit jo: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.13",
            "verseOrgIds": [
              "1CH.17.13"
            ]
          }
        },
