              "attrs": {
                "loc": "HEB.1.8"
              },
              "items": [
                {
                  "text": "Bur 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Konye etogogoŋi eoŋ ŋes kotoma togoka, kaiakanutuka da ikar kere; itieasio ekeicoloŋ loka ajakanut ikar kere.’’’ ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.14",
            "verseOrgIds": [
              "1CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwape ejaatar akiro ŋun kere, kwape ejaar aitapoet ŋin kere, kolimok Natan Daudi kwaŋin,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.15",
            "verseOrgIds": [
              "1CH.17.15"
            ]
          }
        }
      ]
