              "items": [
                {
                  "text": "Yob 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi Daudi ekabaka alomar, kiboikin kakonyen nuka EJAKAIT: kotema atiar, “Eoŋ iŋai, wu EJAKAIT Edeke; ekatogo da inyo, ijo aitodolun eoŋ kiton kwana? ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.16",
            "verseOrgIds": [
              "1CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kerai ŋin da akirot naedit kakonyenekon, wu Edeke; konye iner ijo nuka ekek loka ekeiaanakinanikon kokar luipu noi luepote, isesen eoŋ kwape araar etuŋanan loitopolooritai, wu EJAKAIT Edeke, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.17",
            "verseOrgIds": [
              "1CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.139.1"
              },
              "items": [
                {
                  "text": "Sab 139:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.17"
              },
              "items": [
                {
                  "text": "Yok 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inyo bobo epedori Daudi alimokin jo nuka aibuses naisubakinitai ekonikejaanakinan? Naarai iieni ekonikeiaanakinan. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.18",
            "verseOrgIds": [
              "1CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.26"
              },
              "items": [
                {
                  "text": "Mat 11:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.11"
              },
              "items": [
                {
                  "text": "Pes 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wu EJAKAIT, iswama ijo apolou na kere, kanuka ekejaanakinanikon, kwape ejaar ekonitau da, aiteienun akiro nu kere nukapolok. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.19",
            "verseOrgIds": [
              "1CH.17.19"
            ]
          }
        },
