        },
        {
          "text": " Kapaaran kaya esubi Misiri kwape kaŋor: emarani ekurianari kanuka aijaŋijaŋ naka akan naka EJAKAIT loka ajoresio, naijaŋijaŋakini ŋes, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluor akwap naka Yuda naketasuro koMisiri, ekurianari ŋinituŋanan yenepupuni nukeŋ, kanuka alosikinit naka EJAKAIT loka ajoresio, naelosikinit ŋeasi asurokin.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
