        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapaaran kaya ejaunos ireria ikany kakwap nako Misiri luineras aŋajep naka Kanaan, luiyapoikinete EJAKAIT loka ajoresio; komaikinai ediopet ebe Ere loka amudiario.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
