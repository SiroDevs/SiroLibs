        {
          "text": " Kapaaran kaya ejaun etem loka EJAKAIT kidiŋ kakwap nako Misiri, ido epiri loka EJAKAIT koikoruke. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
