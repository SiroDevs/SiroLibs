        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
