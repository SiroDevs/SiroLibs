            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Siit 28:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kanen kapaarasia nuka Akas okoku loka Yotam, okoku loka Usia, ekabaka loka Yuda, apotu Resin ekabaka loka Suria, ka Peka okoku loka Remalia, ekabaka loka Isirael koloto Yerusalem aitiji; konye kokurwokis. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi kolimokinai ekek loka Daudi ebe, “Emorikikinos Suria ka Epuraim.” Komaran eketau, ka itauon luka iketuŋa da, kwape kikito luka amagoro luitamarani ekwam.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
