              "items": [
                {
                  "text": "Nek 9:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.7"
              },
              "items": [
                {
                  "text": "Isa 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.16"
              },
              "items": [
                {
                  "text": "1 Ika 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eyauni EJAKAIT mamakon, ka ikonituŋa, ka ekek loka papakon apaarasia numam lem edoluno, ameun kapaarasia nukenyounio Epuraim koYuda; ŋes ekabaka loka Asuria.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
