            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kapaaran kaŋin, ebareni EJAKAIT kebarenit loeropioro loejai juwai naka Ecor, ŋes ekabaka loka Asuria, akou ka ajul nuka akeje: epiari da epenek,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
