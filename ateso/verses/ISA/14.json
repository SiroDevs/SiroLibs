              "type": "text"
            }
          ]
        },
        {
          "text": "Kosodi kanen, kapaaran nakisibworaria EJAKAIT jo kaitururukon, ka icanikon, ka aitaaritoi kere nakitaaritere, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.3",
