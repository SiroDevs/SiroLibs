              },
              "items": [
                {
                  "text": "Awa 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Epupunete da akoniki akirot kokaukon naebala ebe, “Lo ŋes erot, kitoroto kotoma”; naipaariata kakan nakoteten, ido naipaariata kediany. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.21",
            "verseOrgIds": [
              "ISA.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.1"
              },
              "items": [
                {
                  "text": "2 Siit 31:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.20"
              },
              "items": [
                {
                  "text": "Isa 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imunaasi ailadad naka akusiputosia nuegerer nuka epuesa, ka arapeta nuka esabu nuka aputosiakus nuecalara: icakarete kes kwape ibore yenimam elai; ilimokinete ebe “Irwa!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
            "verseOrgIds": [
              "ISA.30.22"
            ]
          }
        }
      ]
