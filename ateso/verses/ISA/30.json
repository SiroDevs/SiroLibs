          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konye yes inerito. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.15",
            "verseOrgIds": [
              "ISA.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konyc ipotu kobalas ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.16",
            "verseOrgIds": [
              "ISA.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
