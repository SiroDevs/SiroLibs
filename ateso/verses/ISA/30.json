                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.8"
              },
              "items": [
                {
                  "text": "1 Tim 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Isitepi ŋesi akiru kanuka ikinyomokus, luiweete alup; inyamat da luka eiyas loka alup, ituraŋaŋas, ipuakaros: kapaaran kaŋin edakas ibarenekus oronyia luepolok, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imoŋin da ka asigirian nuekoriete alup enyamete lunyaman lueiaas abalaŋ, luepjesitai keritei ka ipukupuket. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejaunos da icorin ka aguuruto nuka akipi toma ŋoliroŋat loeoj, ka ŋoliukot loeoj, kapaaran naka earit loepol, naibirunotor itogoi lueojak. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.19"
              },
              "items": [
                {
                  "text": "Isa 60:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.2.5"
              },
              "items": [
                {
                  "text": "Sek 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.23"
              },
              "items": [
                {
                  "text": "Apu 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido da eraun aica naka elap kwape aica naka akoloŋ, aica da naka akoloŋ iyatakina irwan akanykaarei, kwape aica naka apaarasia akanykaarei, kapaaran naeenia EJAKAIT ariebo naka ituŋake, naitaŋaleunia amusuŋunukec nukinomonomoo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.26",
            "verseOrgIds": [
              "ISA.30.26"
            ]
          }
        }
      ]
    },
    {
