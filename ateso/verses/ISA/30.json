              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
            "verseOrgIds": [
              "ISA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ljaunos yesi kekosio kwape loka akuar naka epucit lokalaunan; ailele da nakotau, kwape naelosio ituŋanan kalamaru abunore oroŋat loka EJAKAIT, Atiiba naka Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiirari da EJAKAIT ekeporoto loka aibuses, itodikini aijesun naka akanike, aisiop naka anyunyurakeŋ, airian naka akim naidopori, ajielelitoi naka akiru, ka ekwam, ka akako da. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebilibilio Eyasuriat kanuka eporoto loka EJAKAIT, loinomi kebela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiniinometait da naka ebela loeseunitai, loinomi EJAKAIT ŋes, ejaun kisiman ka adeudeun: ejiikinos ŋesi ka kes kojiisio luka aijaŋijaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Yer 7:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Naarai aponi Topet kitemokinitete sek; eebo, etemonokinitoi kanuka ekabaka; etemoki kidul kopol: oupake ejai akim ka akito nuipu; isinepi eiyeŋane loka EJAKAIT ŋes, kwape aleles naka acukuman.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.33",
            "verseOrgIds": [
              "ISA.30.33"
            ]
          }
        }
      ]
    }
