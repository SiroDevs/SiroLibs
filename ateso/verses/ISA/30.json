          ]
        },
        {
          "text": " Naarai inera kwanata EJAKAIT Edeke, Lokalaunan loka Isirael, ebe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.15",
            "verseOrgIds": [
