                {
                  "text": "Apu 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ido komaranata ategerio nuka ekek kanuka eporoto laka ŋol kalokiworoi, etogo da kilelebun apuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasodi atemar atiar, “Wu okwe! Abei ai? Naarai atwana, naarai arai eoŋ etuŋanan loka aituk namam elai: eboie da kokidiŋ otuŋa luka aituke numam elaete: naarai aanyut akakonye Ekabaka, EJAKAIT loka ajoresio.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
