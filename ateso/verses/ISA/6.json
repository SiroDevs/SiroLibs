              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kopor ediopet koserapin mama ajai, kojaas katotolet naesarani kakanike, nakelemuni karidet kotem. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotiroria akaituk, kobala ebe, “Koany, atiro na akoniituk: kilemar numam adolitekon, ka akonironis da aluci.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
