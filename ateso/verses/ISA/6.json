            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Toma okaru ŋol loatwania ekabaka Usia abu kaany EJAKAIT iboie koicoloŋ, loikeara, loiceleleoritai, ereret da loka akenapito kileleba eyekalu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobwoete Iserapin kokujukeŋ; nolidiopet kojaas abebenoka akanykape; abu korapak aarei akonyeneke, korapak aarei akejeneke, aarei da kopororia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Apu 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kosodi kiworo ediopet mama ejai loce, kotema atiar,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
