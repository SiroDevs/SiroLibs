              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento atinni-ni ka obino, ame doŋ obalo limmi ducu i kom mon ame ococo, yin inekke atin twon olobakino!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
