          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogamo doge ni, ‘Atinna, yin nino ducu itye keda, jami mera luŋ megi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
