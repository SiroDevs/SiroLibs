              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "En obedo ka pwony i ot Obaŋa nino luŋ. Olamdog adoŋo kede opwonycik kede jo adoŋo i akina lwak oyenyo yo me neke; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
              "LUK.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "cite gin mom onwoŋo ginnoro a myero otim i kome, pien jo luŋ oketo cunygi i winyo koppere.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.48",
            "verseOrgIds": [
              "LUK.19.48"
            ]
          }
        }
      ]
