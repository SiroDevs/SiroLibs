          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot okobo ni, “I kare-naca abino bedo Obaŋa a jo me doggola Icrael luŋ, gin bino bedo jona.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.22",
            "verseOrgIds": [
              "JER.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony, ame obedo Obaŋa a jo Icrael okobo ni, “Jo man dok bino kobo kop magi i lobo Juda kede i boma luŋ me Juda, i kare ame adwoggogi cen i kucgi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
              "JER.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mannono bino miyo jo kobo ni onino aber meicel dok i kare ame ocoo onwoŋo komgi yot atek.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot okobo ni, “Kare tye abino ame abino miyo dano kede lee bedo adwoŋ meicel i lobo a jo Icrael kede i lobo a jo Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare tye abino ame abino gwokogi i kare me pitogi kede miyogi doŋo malo kite ame rik agwokogi kede i kare me mukogi, me putogi, me turogi, me tyekogi kede i kare me keto can i komgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.2"
              },
              "items": [
                {
                  "text": "Ejek. 18.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I kare-naca gin mom dok obino medde kobo ni,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
      ]
    },
