          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien Rwot okobo ni, “Lobo luŋ bino doŋ nono, cite mom abino miyo gik oko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.27",
            "verseOrgIds": [
