                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot te kobba ni, “Kadi bed Muca kede Camwiri rik ocuŋ i nyima, mom atwero loko cunya i kom jo man kadi acel. Cwagi oko teŋe i nyima; migi owot oko teŋe! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Nyut 13.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ka ce gin openyi ni, Kara owot kwene? Yin ibino gamo kopgi ni, Rwot okobo ni ba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
