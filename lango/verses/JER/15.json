          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lonyowu kede ginnoro luŋ ame ikano wunu abino miyo bedo me ayaka, kun mom oculo ginnoro pirgi, pi balwu, ame doŋ otyeko lal oromo lobowu luŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino miyo itio wunu pi okworwu i lobo ame mom iŋeo wunu, pien akemo doŋ omio mac ocako lyel oko, mac ame bino waŋowu nakanaka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    }
