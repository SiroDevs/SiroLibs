                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Jer. 25.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan. 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rwot okobo ni, “Kare ame mwakki pyerabiro doŋ otum ame atyeko miyo pi Babulon, an abino limowu ate co bo gin a rik aciko baŋwu, ate dwogowu baŋa i kabedo man. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien an aŋeo gin ame atyeko yiko pirwu, yik me ber bedowu, pe me timowu rac, yik ame tye pi anyimwu dok ame tye iye gen. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-naca ite bedo lwoŋo wunu nyiŋa, kun ibino wunu baŋa me bino kwaya, an abino winyo kwacwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.29"
              },
              "items": [
                {
                  "text": "Lodo 4.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ibino yenya wunu ite nwoŋa wunu; ka ce iyenya wunu kede cunywu ducu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibino nwona wunu gire, an ate dwogo kucwu ate daŋ cokowu oko i akina rok ocele luŋ kede i kabedo luŋ ame rik aryemowu aterowu iye, ate dwogowu cen i kabedo man, ame rik akwanyowu iye me cwalowu iyi opii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pien wun ikobo wunu ni, ‘Rwot omiowa odwarpiny i Babulon,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mannono omio Rwot okobo kop i kom abaka ame bedo i wi kom loc a Daudi kede i kom jo luŋ ame bedo i boma man, watiwu ame mom rik obin otero oko iyi opii. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony okobo ni, ‘Nen ba, acwayo i komgi pala me romo, kec, kede too edeke, dok abino miyogi bedo calo nyig oduro ame otop, ame doŋ rac odoco, a mom romo camere. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abino ryemogi i pala lweny, i kec, kede too edeke, dok abino miyogi obedo gin ame rok ame tye i wi lobo apapat lworo, gin bino doko gin me ceno jo, gin a jo lworo, ame jo jwio ajwia kede gin ame ocao i akina rok ducu, i kabedo luŋ ame acwaogi iye, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "pien gin rik okwero winyo koppa ame abedo cwayo baŋgi tere i tere, kun amio omirona odwarpiny kobbigi, cite gin gigi ote kwero winyo oko. Man kop a Rwot okobo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winy wunu kop a Rwot wun luŋ ame itye wunu acalo opii ame rik acwaowu i Babulon, kun akwanyowu i Jerucalem: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot me mony, ame obedo Obaŋa a jo Icrael okobo kop i kom Akab wot a Kolaya kede Jedekia wot a Maceya ame tye ka rabo kop me goba baijwu, kun orabo-gu i nyiŋa ni. Nen ba, abino miyogi i cin Nebukadnejar, ame bino nekogi kun ineno wunu kede wanwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Juda luŋ ame tye acalo opii i Babulon bino tic i nyiŋgi me ceno jo kun okobo ni, ‘Rwot bino miyi ibedo calo Jedekia kede Akab ame abaka me Babulon obulogi abula i mac. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en can ame obino keto i komgi pien gin otimo tim me miŋo iyi Icrael, gin ocodo mon owotegi, dok daŋ okobo kop me goba i nyiŋa, kun an mom acikogi gira. An en aŋeo, dok daŋ an en abedo acaden ame ŋeo gin a gin otimo. Man kop a Rwot okobo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aco baŋ Cemaya ame obedo dano me Neklam, obino kobbe ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rwot me mony, ame obedo Obaŋa a jo Icrael. Yin ityeko cwayo waraga apol apola kede nyiŋi kun icwao baŋ jo ame tye i Jerucalem kede baŋ Jepania wot a Cemaya, ame obedo alamdog, kede baŋ olamdog ocele luŋ, kun ikobbigi ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot otyeko keti me bedo alamdog ocele luŋ, kun ikobbigi ni, Rwot otyeko keti me bedo alamdog akaka Yekoyada alamdog, me ilo ot a Rwot, kun iloo ŋat acel acel ame wie oballe ame rabo koppi i nyiŋ Rwot, me wek imakgi itwegi kede kol, kun daŋ irwako nyonyo i ŋutgi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara doŋ ŋo omoni juko Jeremia me Anatot i kare-ni ame tye ka rabbiwu kop? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pien en ocwao kop baŋwu i Babulon kan, kun kobo ni, Ibino ri wunu kare alac iyi opii; doŋ myero iger wunu wudi me bedowu, pit wunu daŋ cam i potowu me inwon wunu gi-acama.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jepenia alamdog rik te kwano waraga man kun Jeremia adwarpiny winyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot te kobbi Jeremia ni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cwal kop baŋ jo ame oterogi iyi opii, kobbigi ni, ‘Rwot okobo kop ikom Cemaya me Neklam, ni, pien Cemaya orabbiwu kop kun an gira mom acwae, omio ibedo wunu i gen nononono. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mannono omio Rwot okobo ni, Nen ba, abino keto can i kom Cemaya me Neklam karacel kede ikwae, ŋattoro i akina jo mere mom bino doŋ akwo me neno gin aber ame abino tiyo i kom jona, pien en okobo kop ame kela jem i kom Rwot. Man kop a Rwot okobo’.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
      ]
    }
