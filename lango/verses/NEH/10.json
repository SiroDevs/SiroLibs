              "items": [
                {
                  "text": "Lodo 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wan otyeko miye me tero i ot a Rwot Obaŋawa mwaka i mwaka kit cam luŋ ame ogeo cek i pottiwa, kede nyig yen luŋ ame ogeo nyak i yenwa ame ocamo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
