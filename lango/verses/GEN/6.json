                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kare ame dano ocako medde i lobo, kun daŋ onywalo anyira, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "awobe Obaŋa ocako neno ni anyira a dano beco. Gin ocako yero mogo i akinagi, ote nyomo me bedo mongi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot te kobo ni, “Cunya mom bino ri i kom dano nakanaka, pien en obedo kom nono, ento en bino ri pi mwaka mia acel kede pyeraryo keken.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Wel 13.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jo Nepili onwoŋo tye i lobo i kare-nono; icennere doki, i kare ame awobe Obaŋa odonyo baŋ anyira a dano, te nywalligi itino, onwoŋo gin daŋ tye. Magi gin twoni jo otego me kare-naca, ame nyingi rwo meicel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
