              "type": "text"
            }
          ]
        },
        {
          "text": "Pien man en kop ame Rwot okobba, ni, “Odoŋ doŋ mwaka acel keken, acalo mwaka me pakaca, kwogo me Kedar luŋ bino doko gi-acaa; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.16",
            "verseOrgIds": [
              "ISA.21.16"
            ]
          }
        },
        {
