              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare-naca wi jo bino wil oko i kom jo Turo pi mwakki pyerabiro twal, ame rom aroma i kare me kwo abaka acel. Kare ame mwakki pyerabiro doŋ otum, Turo bino bedo acalo alaya ame owero ni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ame mwakki pyerabiro doŋ otum, Rwot dok te bino limo Turo, te dok dwoke i ticcere. En dok bino tic i lobo apapat ame tye i wi podo, kun tio kedgi acalo alaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agoba luŋ ame en bino nwoŋo icato willere-nono, mom bino gwoko, akadi kano me nono, ento en bino jalo oko me bedo gin acil baŋ Rwot, obino wilo i cam abup kede boŋŋi abeco pi jo ame tio ticgi i nyim Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
