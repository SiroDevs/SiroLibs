        },
        {
          "text": "Man en kop ame Obaŋa okobo ame otiko Turo. Kok wunu ba, wun mel me Tarcic, pien Turo doŋ odoŋ oko nono, aboŋo ottoro onyo waŋ kwaŋŋoro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
