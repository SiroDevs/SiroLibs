            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.17.6"
              },
              "items": [
                {
                  "text": "Oŋol. 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo Icrael rik onwoŋo mom ru tye kede abaka moro i kare-nono, dano acel acel onwoŋo gire timo gin ame en oneno ni ber baŋe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.25",
            "verseOrgIds": [
              "JDG.21.25"
            ]
          }
