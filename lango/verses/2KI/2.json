              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "I kare ame Rwot doŋ mito tero Elia oko i polo i yamo ajuru, onwoŋo Elia kede Erica ocako wotgi me wot i Gilgal. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elia te kobbi Erica ni, “Tim ber koŋ ibed kan; pien Rwot okobo ni myero an koŋ awot i Betel.” Ento Erica te gamo ni, “Kite acalo Rwot tye kwo-ni, dok yin daŋ itye kwo-ni, an gire mom abino pokkere kedi.” Gin luŋ doŋ ote wot naka i Betel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
