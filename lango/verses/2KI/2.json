        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odwarpinnyogo ame onwoŋo rik bedo i Betel kuno, te wot baŋ Erica te penye ni, “Yin iŋeo ni Rwot tin bino kwanyo adwoŋŋi oko i baŋi te tero oko?” En te gamo ni, “Ee, an aŋeo; ento wek wunu kobo koppere bedi.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
