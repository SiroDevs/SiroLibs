          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.26"
              },
              "items": [
                {
                  "text": "Rom. 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cite wel a jo Icrael bino bedo acalli kwoyo me dog nam, ame mom pimere, dok a mom romo akwana; dok daŋ i kabedo ame rik okobbigi iye ni “Wun mom i jona wunu,” obino kobbigi iye ni, “Itino Obaŋa akwo.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo me Juda kede jo me Icrael bino cokere karacel, ote keto ŋat acel ame telo wigi, eka gm te ya oko i lobo-nono, pien nino a Jejreel bino bedo nino adwoŋ meicel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
