            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino me agege me dwe me aryo, i mwaka me aryo ame jo Icrael oya kede i Miciri, Rwot rik okobo i Muca i kema me rwatte, i tim me Cinai, kun kobbe ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwan wel jo Icrael luŋ kun ilubo i doggola a kwarigi, dok daŋ co nyiŋ co luŋ acel acel, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "cakere i kom jo ame mwaka me ditogi oromo pyeraryo dok kede malo, jo Icrael luŋ a romo lweny. Ibino kwanogi wunu kede Aron kun ikwano wunugi eryoŋet eryoŋet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dano acel ame oya iyi atekere acel acel bino konyowu, kun dano-nono bedo acalo adwoŋ a loo doggola a kwarogi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiŋ jo ame bino konyowunono ene:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
