          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka te dok lokere neno Amalek, te cako wero koppere ni,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
            "verseOrgIds": [
              "NUM.24.20"
            ]
          }
        }
      ]
    },
