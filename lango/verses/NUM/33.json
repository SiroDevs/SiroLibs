          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Mocerot, ote wot guro kemagi i Bene-jaakan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.31",
            "verseOrgIds": [
              "NUM.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Bene-jaakan, ote wot guro kemagi i Koraggidgad. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.32",
            "verseOrgIds": [
              "NUM.33.32"
            ]
          }
        },
        {
