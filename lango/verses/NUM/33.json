          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin dok te ya i tim me Cinai, ote wot guro kemagi i Kibrot-atava. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.16",
            "verseOrgIds": [
              "NUM.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Kibrot-atava, ote wot guro kemagi i Kajerot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.17",
            "verseOrgIds": [
              "NUM.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin te ya i Kajerot, ote wot guro kemagi i Ritma. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.18",
            "verseOrgIds": [
              "NUM.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin te ya i Ritma, ote wot guro kemagi i Rimmonperej. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.19",
            "verseOrgIds": [
              "NUM.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Rimmonperej, ote wot guro kemagi i Libini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.20",
            "verseOrgIds": [
              "NUM.33.20"
            ]
          }
        }
      ]
