          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Ricca, ote wot guro kemagi i Kekelata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.22",
            "verseOrgIds": [
              "NUM.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Kekelata, ote wot guro kemagi i kidi me Ceper. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.23",
            "verseOrgIds": [
              "NUM.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i kidi me Ceper ote wot guro kemagi i Karada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.24",
            "verseOrgIds": [
              "NUM.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Karada, ote wot guro kemagi i Makelot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.25",
            "verseOrgIds": [
              "NUM.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Makelot, ote wot guro kemagi i Takat. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.26",
            "verseOrgIds": [
              "NUM.33.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Takat, ote wot guro kemagi i Tera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.27",
            "verseOrgIds": [
              "NUM.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Tera, ote wot guro kemagi i Mitka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.28",
            "verseOrgIds": [
              "NUM.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
