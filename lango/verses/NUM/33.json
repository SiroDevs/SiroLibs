          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Mitka, ote wot guro kemagi i Kacmona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.29",
            "verseOrgIds": [
              "NUM.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Kacmona, ote wot guro kemagi i Mocerot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.30",
            "verseOrgIds": [
              "NUM.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
