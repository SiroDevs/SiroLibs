          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Libna, ote wotguro kemagi i Ricca. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.21",
            "verseOrgIds": [
              "NUM.33.21"
