          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin oya i Koraggidgad, ote wot guro kemagi i Jotbata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.33",
            "verseOrgIds": [
              "NUM.33.33"
            ]
          }
