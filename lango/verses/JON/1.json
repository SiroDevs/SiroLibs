          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat. 12.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwot te miyo twon reccoro adwoŋ meicel mwonyo Yona oko; Yona rik te tyeko nino adek iyi rec, dyewor kede dyeceŋ.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
            "verseOrgIds": [
              "JON.1.17"
            ]
          }
        }
      ]
