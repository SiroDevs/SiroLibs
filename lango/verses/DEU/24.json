                "loc": "MRK.10.4"
              },
              "items": [
                {
                  "text": "Mar. 10.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ka ce lo moro otero dako, eka te nyomo bedo cege; ka ce icennere en te nwoŋo ni mom oyomoro cunye pien ginnoro me lewic tye i kome, en myero coye waraga me keto nyom, te miyo i ciŋe eka te ryeme kede oko i tuŋe, dako-nono doŋ te ya oko i paco mere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ce en owoto te doko wot nwoŋo cware ocele, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ce cware-naca te ryeme oko i tuŋe, onyo ka cware ame dok onyome-naca oto oko, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "cware ame rik ogeo nyome myero dok kur bed kede acalo cege, pien en doŋ oballe oko. Kodi timmono obedo gin me lewic i nyim Rwot, dok myero kur dok ikel bal i lobo ame Rwot Obaŋani amiyowu me bedo megwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ce lo moro pwod onyomere nyen, en myero kur wot i lweny dok daŋ myero kur mie ticcoro; en myero bed paco tuŋe mwaka acel, ocob mittere gin kede dako mere ame enyomo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋattoro myero kur jeŋ kidi rego onyo anya kidi, pien mannono rom ame ojeŋo kwo a dano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
    {
