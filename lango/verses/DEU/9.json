              "items": [
                {
                  "text": "Yaa 17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Medo i kom mannono, rik daŋ imio wunu akemo omako Rwot i Tabera kede i Maca kede i Kibirotatava, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
