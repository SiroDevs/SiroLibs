                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibino kwano wunu cabit abiro kun icako kwano wunu i nino ame icako wunu kac iye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwer wunu koŋ ecuban me cabit abiro kite ame Rwot Obaŋawu mito kun ikelo wunu motwu me ber a yic a lubere kede kite ame Rwot Obaŋawu omiowu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yin karacel kede wodi, kede nyari, opiini kede aŋecani kede Alevi moro ame bedo i bomawu, arokkoro ame bedo i akinawu kede atin kic kede dako a cware oto ame bedo i akinawu, ibino lelo wunu i nyim Rwot Obaŋawu i kabedo kan ame Rwot Obaŋawu bino yero me keto iye nyiŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero ipo wunu ni yam wun daŋ ibedo wunu opii i lobo me Miciri; dok daŋ myero igwokere wunu igwoko icwil magi luŋ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
