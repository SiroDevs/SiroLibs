              "items": [
                {
                  "text": "Mat. 5.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Ka ce ikwoŋo kwoŋŋoro baŋ Rwot Obaŋani, myero iru cobo; pien Rwot Obaŋani bino penyi pire, eka te doko bal baŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka ibedo aboŋo kwoŋo kwoŋŋoro, bal mom bino bedo i komi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero igwokere meicel icobo gin ame oya i dogi, pien yin giri ikwoŋo piri keni baŋ Rwot Obaŋani, i gin ame iciko giri i dogi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
