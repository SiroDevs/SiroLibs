      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋat ame odino mane oko onyo lon ame oŋolo keme me co oko mom bino donyo i cokere a Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atinnoro ame onywalo i nyom ame cik ogeŋo mom bino donyo icokere a Rwot, akadi naka iyi ikwae a tye i lwagi me apar, moro iye mom bino donyo i cokere a Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
