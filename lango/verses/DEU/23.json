              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwero miyo arok kopporo banya baŋi pi mito agoba, ento ominni mom ibino miyo kopporo baŋ ya pi mito agoba; wek Rwot Obaŋani omi gum i kom ticcoro ducu ame ciŋi ogudo i lobo ame iwot donyo iye me bedo megwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
