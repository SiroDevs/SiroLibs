            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Olev. 25.36-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Lodo 15.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mom ibino miyo ominni moro kopporo ginnoro i baŋi pi mito agoba, mom ibino mito agoba i kom lim, i kom cam, onyo i kom ginnoro ocele ame oculo iye agoba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
