              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Lak. 13.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "15.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.23"
              },
              "items": [
                {
                  "text": "1 Lak. 3.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.5"
              },
              "items": [
                {
                  "text": "2 Lak. 5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Man en cik mera, ni imarre wunu kenwu acalo rik an amarowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom tye ŋattoro ame tye kede mar adwoŋ ame kato man, dano ijalo kwo mere pi awottere. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun owotena ka ce itio wunu gin ame an acikowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom dok abino lwoŋowu ni wun opii, pien opii mom ŋeo gin ame adwoijnere tio; ento an alwoŋowu ni wun owotena, pien doŋ atyeko nyuttiwu gin ducu ame rik awinyo i baŋ Pappa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mom wun en iyera wunu, ento an en ayerowu, dok aketowu me iwot, inyak wunu nyigwu, dok me nyigwu perakino, wek gin ducu ame ibino wunu kwayo i baŋ Papo i nyina, en miwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ame acikowu iye en ene ni, marre wunu kenwu kenwu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.17",
            "verseOrgIds": [
              "JHN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka lobo odagowu, myero iŋe wunu ni rik okwoŋo daga, a kun pe ru odagowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono ibedo wunu jo me lobo, kono lobo omaro wun jo mere; ento wun mom ibedo wunu jo me lobo, ento ayerowu i lobo, mannono omio lobo odagowu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.24"
              },
              "items": [
                {
                  "text": "Mat. 10.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.40"
              },
              "items": [
                {
                  "text": "Luk. 6.40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.16"
              },
              "items": [
                {
                  "text": "Lak. 13.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Po wunu kop a rik akobbiwu, ni, ‘Opii mom bedo dwoŋ ame kato adwoŋŋere.’ Ka rik oliba, wun daŋ obino libowu; ka rik ogwoko koppa, wun daŋ obino gwoko megwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.20",
            "verseOrgIds": [
              "JHN.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi-nono ducu obino timo i komwu pi nyina, pien gin mom ŋeo ŋat ame rik oora. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.21",
            "verseOrgIds": [
              "JHN.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono ce rik mom abino akobo baŋgi, kono gin mom i balloro; ento amanni kopporo ame gin bino pido pi balgi mom tye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.22",
            "verseOrgIds": [
              "JHN.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat ame odaga, nwoŋo odago Pappa daŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.23",
            "verseOrgIds": [
              "JHN.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kono rik mom atio ticcoro ame dano moro ocele mom otio i akinagi, kono gin mom i balloro; ento amanni gin doŋ onena, dok odaga, karacel i Pappa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.24",
            "verseOrgIds": [
              "JHN.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.19"
              },
              "items": [
                {
                  "text": "Jab. 35.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.4"
              },
              "items": [
                {
                  "text": "69.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Man otimere me kop a con ocoo i cik megi cobere kakare ni, ‘Gin odaga nono.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.25",
            "verseOrgIds": [
              "JHN.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ento ka Akony bino tuno, ame abino oro baŋwu iiya i baŋ Papo, en Cuny me ateni ame ya i baŋ Papo, en bino bedo cadenna. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.26",
            "verseOrgIds": [
              "JHN.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wun daŋ ibedo wunu cadenna, pien ibedo wunu baŋa cakere i ageyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.27",
            "verseOrgIds": [
              "JHN.15.27"
            ]
          }
        }
      ]
    }
  ],
