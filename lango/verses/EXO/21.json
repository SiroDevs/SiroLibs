              "type": "text"
            }
          ]
        },
        {
          "text": "“Ka ŋattoro ogoo dano, ce oto oko, en daŋ obino neke oko, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.12",
            "verseOrgIds": [
              "EXO.21.12"
            ]
          }
