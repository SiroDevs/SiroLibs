            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.1+JOS.20.2+JOS.20.3+JOS.20.4+JOS.20.5+JOS.20.6+JOS.20.7+JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yoc. 20.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Cite ka onwoŋo mom obedo kiye akia, ento Obaŋa omio dano-nono opoto i ciŋe, abino yero kabedo moro a myero en riŋ lar, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aco ka dano moro oero lweny me akaka i kom ŋattoro ocele kun tye i cuny me neko oko i ryeko, obino kwanyo dano-nono oko i kom keno me lam ma, ote neko oko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
