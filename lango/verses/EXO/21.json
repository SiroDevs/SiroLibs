                "loc": "LEV.24.19+LEV.24.20"
              },
              "items": [
                {
                  "text": "Olev. 24.19-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.21"
              },
              "items": [
                {
                  "text": "Lodo 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.38"
              },
              "items": [
                {
                  "text": "Mat. 5.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "waŋ kede waŋ, lak kede lak, ciŋ kede ciŋ, tyen kede tyen, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mac kede mac, awano kede awano, apwoda kede apwoda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
