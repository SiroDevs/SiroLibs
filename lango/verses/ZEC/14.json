              "items": [
                {
                  "text": "Lak. 7.38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Nyut 22.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "I nino-nono pii akwo bino mollo kun ya i Jerucalem, nucu mere tuŋ cel bino mollo i nam me tuŋ kide, eka nucu mere ocele te mollo i nam me tuŋ to; bino daŋ timere amannono i oro, kite ame obedo timere kede i cwir.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino-nono Rwot bino doko abaka ame loo lobo ducu, en bino bedo abaka kene, kun nyiŋe kene en atye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.9",
            "verseOrgIds": [
              "ZEC.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lobo luŋ bino doko bar, cakere i Geba tuno naka i Rimmon ame tye tutuŋ anyarolum me Jerucalem, Cite Jerucalem bino dyedde gire kakare cakere i dogcel a Benjamin tuno anaka i dogcel acon, naka i dogcel me Gul kede dok cakere i pem me Kananel tuno anaka i bur nyono olok abaka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
