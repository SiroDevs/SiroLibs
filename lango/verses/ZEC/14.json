            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino-nono obino goro coc i kom olaŋ me aguragura ni, “Okwero obedo acil pi Rwot.” Gulli ame tye i ot Rwot bino bedo acalo tabo ame tye i nyim ke ŋo lam. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
          "items": [
            {
              "text": "21",
