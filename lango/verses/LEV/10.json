              "LEV.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 10:12"
          },
          "items": [
            {
              "text": "12",
