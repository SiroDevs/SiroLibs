          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Man en cik a mako leyi kede winnyi kede gin akwo luŋ ame kwaŋ i pii, kede ginnoro luŋ ame corre, nya i wi lobo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "me poko gin a cik ogeŋo kede gin a cik oye, kede gin akwo ame myero cam kede a mom myero cam.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
