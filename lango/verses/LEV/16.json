                "loc": "EZK.44.19"
              },
              "items": [
                {
                  "text": "Ejek. 44.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aron dok bino donyo i kema me rwatte, te gonyo boŋŋi camanini ame onwoŋo en oruko i kare ame donyo i kabedo acil, te weko oko kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "En bino lwoko kome kede pii i kakannoro acil te ruko boŋŋi mere i kome, eka te doŋ donyo oko yalo Obaŋa i mot awaŋa ame tye pire, kede mot awaŋa ame tye pi lwak, kun tio tic me kwanyo bal i keme kede i kom lwak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwol me mot awaŋa en bino waŋo i wi keno lam. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat otero dyel te wot cwayo baŋ Ajajel bino lwoko boŋŋi mere, tec lwoko daŋ kome kede pii, i ŋe mano en doŋ twero bino i gony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Eb. 13.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Twon kede dyel me yalo Obaŋa pi bal ame onwoŋo otero remogi i kabedo acil me tiyo tic me kwanyo bal, obino tero i ŋe gony; pyengi kede riŋogi kede weegi obino waŋo i mac. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋat owaŋo bino lwoko boŋŋi mere, te lwoko daŋ kome kede pii, i ŋe mano en doŋ twero donyo i gony.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
