              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myero cam i nino ame omio iyenono; myero kur wek moro iye doŋ tuno naka odiko; an a Rwot.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
