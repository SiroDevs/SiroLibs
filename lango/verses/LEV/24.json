          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muca daŋ te cako kop baŋ jo Icrael; gin te tero lon oceno Obaŋanono oko i ŋe gony, ote nanapo oko i gweŋe. Jo Icrael daŋ otimo kittono, kite ame Rwot ociko kede Muca.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
          }
        }
      ]
    }
  ],
