          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "I nino-nono ote neko jo Piriciti cakere i Mikmac tuno kede i Aijalon. I kare-nono kec onwoŋo doŋ ociro jo oko, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.31",
            "verseOrgIds": [
              "1SA.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "jo te cako mwomere i kom lim ame oyako, ote mako rommi, twoni, kede roce, ote nekogi oko, jo te cako mwodo oko anumu kun ocamo anakaremo mere. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.14.32",
            "verseOrgIds": [
              "1SA.14.32"
            ]
          }
        },
