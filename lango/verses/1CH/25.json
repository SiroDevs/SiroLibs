            "sid": "1CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "me abicellere te poto i kom Bukia, kun awobe mere kede omego mere tye iye, gin luŋ jo apar wie aryo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
