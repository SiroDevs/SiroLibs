          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "me abiro mere te poto i kom Jacarela, kun awobe mere kede omego mere tye iye, gin luŋ jo par wie aryo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.14",
            "verseOrgIds": [
              "1CH.25.14"
            ]
          }
