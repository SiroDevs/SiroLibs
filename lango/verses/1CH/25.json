            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "me aboŋwennere te poto i kom Matania, kun awobe mere kede omego mere tye iye, gin luŋ jo apar wie aryo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
