          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "me aboro mere te poto i kom Jecaya, kun awobe mere kede omego mere tye iye, gin luŋ jo apar wie aryo; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.15",
            "verseOrgIds": [
              "1CH.25.15"
            ]
