              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ame Akab doŋ owinyo kop ame Elia okobbe, oyeyeco boŋŋi mere oko, te daŋ cako ruko boŋo cola oko i kome i caa-nono, te kanyo kec. Akab te bedo wot kun kome doŋ oto oko, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
