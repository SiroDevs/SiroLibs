              "type": "text"
            }
          ]
        },
        {
          "text": "Yekoyakim ocako loc ame mwaka me dittere oromo aboro, en te bedo loc i Jerucalem dwete adek kede nino apar keken, En obedo timo gin ame nen arac i nyim Rwot. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
