            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kop i kom Yekoyakim odoŋŋere ducu, timmogo me kwer ame en obedo timo, kede koppogo ame onwoŋo i kome ame mom ocoo kan, gin luŋ tye ocoo i buk Obakki me Icrael kede Juda. Wode Yekoyakim en ame te leyo kakare.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
