        },
        {
          "text": "Nebukadnejar abaka me Babulon rik te bino cako lweny i kome ame te make tweye oko kede jegere, te tere naka i Babulon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadnejar te daŋ tero jami mogo me tic i ot a Rwot i Babulon, te wot ketogi i paco mere i Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
