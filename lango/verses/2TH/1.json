            }
          ]
        },
        {
          "text": "Waraga man oya i baŋ Paulo gin i Silvano, kede Temoteo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
