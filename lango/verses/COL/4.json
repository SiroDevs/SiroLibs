            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti wunu i ryeko meicel i nyim jo ame tye oko; caa ame inwoŋo wunu, ti wunu kede aber. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.5",
            "verseOrgIds": [
              "COL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kopwu myero bed ame kado oromo aber dok amit, me iŋe wunu kite a myero idok wunu kede i peny a ŋat acel acel.",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.6",
            "verseOrgIds": [
              "COL.4.6"
            ]
          }
        }
      ]
