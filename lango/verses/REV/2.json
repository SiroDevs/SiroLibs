                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Baŋ amalaika a lwak oye an ame tye i Cumurna co ni mano:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
