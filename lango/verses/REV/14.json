                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ejek. 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.3"
              },
              "items": [
                {
                  "text": "Nyut 7.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Rik dok ate neno Atin romo kun ocuŋ i wi kidi me Cion, dok karacel kede onwoŋo tye jo tutumia mia acel kede pyeraŋwen wie aŋwen, ame doŋ ocoo nyiŋe kede nyiŋ Pappere i tur nyimgi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.1",
            "verseOrgIds": [
              "REV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ate winyo dwonnoro ame oya i polo ame mor winyere bala acucur pii, kede bala kot a mor atek. Dwon ame awinyo-naca rik cal i dwon ogo tum ame agoyo tumegi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.2",
            "verseOrgIds": [
              "REV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onwoŋo gin awero wer anyen i nyim kom loc, kede i nyim leyi akwo aŋwen ca, kede odoŋe. Mom tye ŋattoro a twero pwonyo werrono, kono ka jo tutumia mia acel kede pyeraŋwen wie aŋwen ca ame doŋ olakorogi oko i lobo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.3",
            "verseOrgIds": [
              "REV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mano gin jo ame mom olille kede mon, pien gin jo ame ogwokere obedo acil; daŋ gin jo ame lubo Atin romo kan a en woto iye luŋ. Jo-ni gin jo ame olakorogi oko i akina jo luŋ, me gin bed bala cam ame ogeo cek ame oyakki Obaŋa kede Atin romo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.4",
            "verseOrgIds": [
              "REV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.13"
              },
              "items": [
                {
                  "text": "Jep. 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Goba moro mom owinyere doggi; gin obedo aboŋo roccoro.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.5",
            "verseOrgIds": [
              "REV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ate neno amalaika ocele ame atwarre i dye polo, kun tye kede amut aber ame perakino me araba baŋ jo a bedo i lobo, baŋ rok kede atekere kede leb kede jo apapat luŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.6",
            "verseOrgIds": [
              "REV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okobo i dwon aloŋo ni, “Lwor wunu Obaŋa, imie wunu kwogo, pien kare mere me ŋolo kop doŋ oromo. Wor wunu ŋat ame oketo polo kede lobo kede nam kede akoŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.7",
            "verseOrgIds": [
              "REV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
