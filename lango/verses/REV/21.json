          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "me abic onik, me abicel kamelio, me abiro kuricolit, me aboro berul, me aboŋwen topaj, me apar kuricoparac, me apar wie acel jacint, me apar wie aryo ameticito. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
