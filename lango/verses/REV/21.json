                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ceŋ onyo dwe mom mitte i bomanono me ryeny iye, pien kwogo Obaŋa en ame menyo, tara mere en Atin romo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
