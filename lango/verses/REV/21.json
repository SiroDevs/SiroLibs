          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gi-geŋo dogcel apar wie aryo obedo tiggi atar me wel apar wie aryo, gi-geŋo dogcel acel acel obedo kodi tigo-nu acel keken; yo ducu me yi boma otio kede jabu agili, ame cil bala gilaci.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
