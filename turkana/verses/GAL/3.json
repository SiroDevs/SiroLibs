                  "text": "Rom 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani kiraakasi esi ngitunga a Kiristo, iraakasi esi ngalesea ka Aburaam, kotere nguna, ianyunete esi nakichikak Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.29",
