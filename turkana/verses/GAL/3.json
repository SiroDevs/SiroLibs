              "items": [
                {
                  "text": "Siak 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.5",
            "verseOrgIds": [
              "GAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitamasi eger ka Aburaam, loger lo igiritere nagiran kona, “Anupi ngesi Akuj ani kotere anupit ngina, tacham Akuj ngesi atamar etenoono eboyor keng.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echamit esi iyenete robo atamar ngalesea ka Aburaam na iteni dir kesi ngitunga lu enupito Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aberakinoi kolong akidwar anagiran atamar echamuni Akuj ngibukui lu nyerai Ngiyaudi kotere eger a anupit. Sodi tolimok Akuj Aburaam Ngakiro Naajokak anagiran tama, “Epiari Akuj ngitunga daang kotere iyong.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.26"
              },
              "items": [
                {
                  "text": "Etal 27:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anupi Aburaam Akuj, topiarae, nakaneni daang lu enupete Akuj, epiario loger keng. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Aba 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilamam ngitunga daang lu igienosi akiwapit etal, kainyo igiritae nagiran kona, “Itwaan cha daang ni nyenupi ngakiro daang na igiritae nakitab a etal, ilamam!” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona, etakani dir atamar emam itwaan echamun ka Akuj kotere etal. Kainyo igiritae nagiran kona, “Itwaan ni echamuni Akuj kotere anupit keng, ngesi bon eyari.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.11",
            "verseOrgIds": [
              "GAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lawi 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni etiakak etal ka anupit. Erai ikoni eger lo igiritere nagiran kona, “Itwaan cha daang ni esubi ibore daang ni esakit etal, eyari.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Etal 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilachuni ngoni Kiristo alolamit a etal, ani etiliworea ngesi ngilam lu araakasi ngiyok ngikeng, kainyo igiritae nagiran kona, “Ilamit Akuj itwaan daang ni inenekino lokitoe.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubasi ngakiro nguna sodi taanyuneta ngibukui lu nyerai Ngiyaudi apiaro ani a Yesu Kiristo. Apiaro ngina ngesi nakolong echikakini Akuj Aburaam, sodi ataanyuneta ngoni Etau lokichikakini Akuj ani kinupitor.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etal ka Akichikakinet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikaitotoi kang, esisauni ekitetemes lo iyenete esi daang, ngitunga ngiarei na echamuneta akiroit kikongo, emam ipei kech ni esaki akiloch ngakiro nguna kori akisech ngache. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona, ekong Akuj ka Aburaam ta ales keng echikakin. Nyigiritae nagiran elalak atamar, “Ngalesea”, nakaneni erai, “ales”, ngesi atamar itwaan ipei bon ni erai Kiristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eger a ngakiro ana asaki alimun ngesi lo atamar, ekongete Akuj ka Aburaam sodi kichikak atamar etemokini ngakiro nguna. Nyinyasuni etal lo esidiun ngikaru ngamiae ngoomwon ka ngatomwon-uni achamunet ngina, kikisa akikonget a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Siak 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kainyo ani kerai ainakinet a Akuj aka etal, ikwa nyeringa erai aka achamunet. Nakaneni, arai kotere achamunet ngesi ainakinea Akuj Aburaam ainakinet ngina. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Apud 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
