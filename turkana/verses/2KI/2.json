          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torei ngesi tokienyik kesi sodi kilam kesi elimit ekiro a Ekapolon Akuj. Apot ngibuin ngiarei luberu topudut anamoni taara ngide lusapa ngulu ngitomwon-omwon ka ngiarei.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
