            }
          ]
        },
        {
          "text": "Abu Elija tolimok Elicha tama, “Kidong tokona nege kainyo kadungoki Ekapolon Akuj ayong atamar tolot Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
