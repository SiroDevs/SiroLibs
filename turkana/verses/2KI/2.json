          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Elicha tama, “Emam, nyiilot.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
