              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni kirichakinos kesi atamar kilosi tanang ngesi echamuni. Toloto lutomwon-kan ngulu akisak Elija wadaang a ngirwa a nguuni, tongopik, nyeanyuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tobongosi kesi nia Elicha lo edarunit kesi alo Yeriko. Abu ngesi kingit kesi tama, “Aberakin ngoon ayong alimokin esi atamar nyiilot.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakitoodikinet nakailiilok a Elicha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
