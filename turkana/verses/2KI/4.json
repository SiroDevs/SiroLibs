  "reference": "2 Ngikapolok 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
