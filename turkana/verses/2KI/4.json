              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Elicha ngesi tama, “Nak tanyama kainyo ebala Ekapolon Akuj enyamete kesi kidong tani ache.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
