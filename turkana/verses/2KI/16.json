              },
              "items": [
                {
                  "text": "2 Ngirwa 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tosubak Uria nguna adungokini ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        },
        {
