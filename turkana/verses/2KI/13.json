              "type": "text"
            }
          ]
        },
        {
          "text": "Ekapolon a Siria lo anyaritae Asael, aboliar Ngisirael ngirwa daang lu araakar Yeowaas ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni apatana Ekapolon Akuj anikech arai loa ngisien. Nyimiekina Ekapolon Akuj kesi emunyario, pearai abu kingarak kesi kotere achamunet nakolong achamakin ngesi ka Aburaam, ka Isaka, ta Yakobo. Eringa ngesi nyitwarakina kesi anikeng tani tokona.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
    },
