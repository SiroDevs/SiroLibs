                "loc": "GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8"
              },
              "items": [
                {
                  "text": "Siak 19:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani eringa kesi imujete, elakara, pot ngikiliok a ere kangolo lu itepereenete",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:22",
              "type": "text"
            },
            {
              "text": "itepereenete;",
              "type": "text"
            },
            {
              "text": "emalaenete ngikiliok ngulu ngikiliok luche ani iiunete, kitopero loger a ngaberu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ngikiliok luche kiriama akai. Kidichakis kesi ekidor a akai isuruorete ekasukout lolope a akai ebalasi, “Kipud itwaan nitete abuni kai kon! Kisaki sua etopero ngesi!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni topudo ekasukout ngolo tolimok kesi tama, “Meere kongina talopaekang! Nyiisubakis kare akisech naaronon noi, a ngileech naga! Abe erai bo itwaan epeyonon kang! ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.23",
            "verseOrgIds": [
              "JDG.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kingolikis a, eyei apese keng na a ngabwes nege, ka nakookang na eringa nyepero ka ekile a ache. Kimiekisi kepudok kesi, tosubeta ngakiro daang na isakete. Nakaneni nyiisubeta itwaan en akisech naaronon noi naga!” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.24",
            "verseOrgIds": [
              "JDG.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni apot ngikiliok ngulu nyiirasi ngakiro keng. Sodi kipudok Elawit ngolo kesi apese keng na a ngabwes. Totikoonosi kesi apese ngina akwaar kiiya kiwala.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.25",
            "verseOrgIds": [
              "JDG.19.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.25",
            "verseOrgIds": [
              "JDG.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iwalari, tonyou aberu ngina tolot tadakakin lokidor a akai a ekasukout, ana ayei lokile keng tooma.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toper ngesi kaneni tanang ipiripiruuni akolong. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.26",
            "verseOrgIds": [
              "JDG.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyou lokile keng nataparach esaki alosit. Ani engaari ngesi ekidor, toriam ngesi apese keng eperi alongaren akai itorwarit ngakan enangunito lokidor a akai. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ngesi tama, “Tonyou atoloto!” Nakaneni nyetachuna apese ngakiro. Sodi kidokok ngesi akwaan a apese losikiria tolot nawi keng. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enanguni ngesi nawi keng, toloma kai tolem ekileng. Tolem ngesi akwaan a apese keng totubutubu ngatubet ngatomon ka ngaarei. Yaa ngesi ngatubet nguna a ngapei-pei lotela lutomon ka ngiarei a Ngisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.7"
              },
              "items": [
                {
                  "text": "1 Sam 11:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolimut ngitunga daang lu engolikinete tamasi, “Nyeanyuna nugu nakanuan! Nyesubakina na ikote nugu nakanuan, napei kolong apudunioto Ngisirael anakwap a Misiri! Kitamakisi pan ngakiro nugu ataanyutu ibore nikisubakini! Ekoe, kikokini ai?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.30",
            "verseOrgIds": [
              "JDG.19.30"
            ]
          }
        }
      ]
    }
