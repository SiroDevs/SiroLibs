    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolem Manoa ikale ka akipeyos a ngalemet kipeye alokidiama ataaba, kipeyok Ekapolon Akuj na esubi ngakiro nakitalarete.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
