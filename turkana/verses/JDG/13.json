            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.29"
              },
              "items": [
                {
                  "text": "Siak 32:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kingit emalaikat ngesi tama, “Nyo ingitar iyong ekiro kang, kitee atamar erai lo kitalari?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        }
