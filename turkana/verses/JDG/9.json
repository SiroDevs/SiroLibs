  "bookId": "JDG",
  "reference": "Ngikatubok Ngakiro 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
