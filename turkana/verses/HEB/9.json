                "loc": "LEV.16.15+LEV.16.16"
              },
              "items": [
                {
                  "text": "Lawi 16:15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.9"
              },
              "items": [
                {
                  "text": "Ekim 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.17+NUM.19.18+NUM.19.19"
              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni, esubasi ngakiro natenoik noi anaakot a Kiristo! Kotere agogongu a Etau a Akuj alokajik, alemun Kiristo ani a Akuj toliwor ngakipeyos na ikiuna. Itosegete ngaakot keng ngitai yok alotalio alu pasiek, sodi atosubeta ngoni etich a Akuj ana eyari.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
