              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotere nguna, Kiristo ngesi eree ngakiro a achamunet anakitetet, sodi taanyuneta lu anyarae Akuj apiaro nakajik nakichikak Akuj. Esubakinio nguna kainyo ayei akitu na elachakini ngitunga dir kitulung naaronok na asubete kesi eringa achamunet na a ekingaren eyei.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
