              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni abu kolong Kiristo lo erai Emuron Loapolon a akai a Akuj a ngakiro anaajokak adolut ne. Esubi ngesi etich keng aloeam alo ejok noi nabo kikiuna noi, lo nyesubio a ngakan a ngitunga. Ngesi atamar, meere eka ngakwapea ana kolong asubio kanu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomari kolong Yesu ni Italeuno Noi alomaret apei bon, nabo dang, peatingit ngesi ngaakot a ngakinei kori na a ngaatuk esaki alemun erai ngakipeyos. Alomari ngesi a ngaakot keng a elope sodi kitoyuu ngoni jik. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwasakinio ngitunga lu esechito etal ngaakot a ngakinei ka ngimongin ta ngimuudui a itaok ani epeitoe, sodi tomookere ngawat kitaleunos. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
