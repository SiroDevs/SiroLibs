              "HEB.13.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.6"
              },
              "items": [
                {
                  "text": "Etal 31:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.5"
              },
              "items": [
                {
                  "text": "Yoch 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ejoikinit akuuta erimasi ngitunga daang, toliwor ekile ka aberu lu irichuna. Irirae Akuj lukiliok ka luberu lu epereenete peiutut, ta ngikalomak.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiiliworosi ngitunga lu eminasi ngaropiyae. Kitemokin esi ngiboro lu itingito. Kainyo alimu Akuj alope ebala, “Nyekemiekini jik, kori nyakachakari.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.5",
            "verseOrgIds": [
              "HEB.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.6"
              },
              "items": [
                {
                  "text": "Eosio 118:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngesi kititinyoror atolimutu atamasi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.6",
            "verseOrgIds": [
              "HEB.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitamutu ngikarikok kus lu kolong kilimokinete esi ngakiro a Akuj. Kitama epit a elote kech sodi kirokut anupit kech. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.7",
            "verseOrgIds": [
              "HEB.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu Kiristo ngesi erai lopei been ka akolongit na ta lokajik. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.8",
            "verseOrgIds": [
              "HEB.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi ngakitatamet ngakaalak nagelagelae kitowoliorete esi alorot alo etenoono. Ejoikinit ngitai yok itogogongio a ajokis a Akuj, meere a ngitalio alu a epit a akimuj. Emam itwaan ni ewap ngitalio ngulu ni apot kingarakis.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.9",
            "verseOrgIds": [
              "HEB.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyechamit ngimurok a akai a Akuj lu esubete etich ani ilipitotor Ngiyaudi Akuj enyamete akipeyos na ipeyokinitoe Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.10",
            "verseOrgIds": [
              "HEB.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyauni Emuron Loapolon a akai a Akuj a Ngiyaudi ngaakot a ngitieng ni Italeuno Noi sodi tolemu ngalemikinet kotere ngasechesea. Nakaneni ipeyoe akiring a ngitieng kangulu anikalapatan a adakar. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibore ngini ngesi atoanea Yesu dang anikalapatan a ere, sodi kitiliworea ngitunga lu ikiuna anakisech a ngaakot keng a elope. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.12",
            "verseOrgIds": [
              "HEB.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoloto tokona ngoni nikeng nikalapatan a adakar, sodi ataanyutu ka ngesi ngileech aapei. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.13",
            "verseOrgIds": [
              "HEB.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo emam ngoni ere lokajik kane anakwap. Kidarit ngoni ere lo ebuni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
              "HEB.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epuruutu robo ngoni jiik Akuj toliwor akipeyos yok ani a Yesu. Ibore ngini ngesi ekipur lo elimunete ngitunga lu elimorito ekiro keng. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.15",
            "verseOrgIds": [
              "HEB.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warasi nyikimuriak akisub naajokak ingaranakinosi, kainyo nguna eraakasi ngalemunet na ejoikinito Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.27"
              },
              "items": [
                {
                  "text": "Lawi 16:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tokera ngikarikok kus kiwapa ngitalio kech. Echoikinito kesi ngitai kus nakwaare ka naparan, nabo elimuunete ngakiro a etich alo asubete kesi alongaren Akuj. Ani kiwap esi ngakiro kech, esubete kesi etich kech elakara. Ani pekiwap ngakiro kech, esubete etich ialolongete nakaneni emam ibore ianyunete esi alopit kangolo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torubakisi kilipakinito. Kiyeni sua dir atamar ejok sua ngitai, kainyo kisaki atosuba ibore ni eriyan jiik. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.18",
            "verseOrgIds": [
              "HEB.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kemaimai esi noi atamar kilipakinae Akuj sodi abunio nikus atipei.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akilip na a esal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteyaru Akuj Ekapolon yok Yesu lo erai Ekeyokon Loapolon a ngamesekin ani abukorea ngaakot keng na eyookinete achamunet nakajik. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimiekisi Akuj na a ekisil kiinak esi ibore daang niajokon ni isakete esi tosubeta na echamit ngesi. Kimiekisi ngesi nabo dang tosub na echamit ngesi anikosi, ani a Yesu alo erai Kiristo. Nabo kipuruunoe Yesu Kiristo jik nakajik! Aamen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakiro na a esal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
