        },
        {
          "text": "Kemaimai esi ngikaitotoi kang atamar tanaikisi kare topupokis ngakiro nakitititinyete nu. Kainyo nyewoi abarua nakegirak ayong esi naga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.22",
            "verseOrgIds": [
