          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaki ayong esi toyena atamar alachakin lokaatoyok Timoteo alojela. Ani kebu ngesi atipei, kirukuni ayong ka ngesi na abunio aanyun esi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
            "verseOrgIds": [
