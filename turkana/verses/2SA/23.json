          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Ira, ka Gareb, lu araakasi daang ngika emachar a Yatir, ka Uria lo arai Eitit.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.38",
            "verseOrgIds": [
              "2SA.23.38"
            ]
          }
        }
