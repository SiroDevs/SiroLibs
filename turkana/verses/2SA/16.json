          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi torei Abusalom kingit Aisopel kingit tama, “Ani kona tokona kinangunea ngoni nege a, isaki iyong ekokisi ai?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
