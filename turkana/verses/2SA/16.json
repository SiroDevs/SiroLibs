          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Aisopel tama, “Kape topero ka ngaberu napesur a ngabwes daang nangoon emiekini apakon iyokiyete akai a ekapolon. Sodi toyen itwaan daang alo Isirael atamar eyeni apakon atamar irai iyong emoit keng. Kotere ngakiro nguna elakarosi ngirukitos kon.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
              "2SA.16.21"
            ]
          }
        },
