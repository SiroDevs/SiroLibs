              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam ibore ni ipotori ngesi kilokonyuunio akiyar keng. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
