              "items": [
                {
                  "text": "Mar 6:14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.7+LUK.9.8"
              },
              "items": [
                {
                  "text": "Luk 9:7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachakis tamasi, “Ebaasi ngiche irai iyong Yoana Ekebatisan. Tabaas ngiche irai iyong Elija. Tabaas nabo ngiche irai iyong epei a ngikadwarak a Akuj.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
