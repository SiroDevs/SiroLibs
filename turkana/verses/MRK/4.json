                {
                  "text": "Mat 7:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.38"
              },
              "items": [
                {
                  "text": "Luk 6:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Itwaan ni eyei ibore, einakinio nikaalan, itwaan ni emam ibore, edemario tani nidiochichi ni etingit.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
            "verseOrgIds": [
              "MRK.4.25"
            ]
          }
        },
        {
