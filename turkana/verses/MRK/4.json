              "items": [
                {
                  "text": "Luk 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani keya ngaki nakiiraret kiira robo!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        },
