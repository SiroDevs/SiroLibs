        },
        {
          "text": "Tolimok nabo tama, “Tochoikisi nguna ipupete! Ngitalio lupei iriraata esi luche kesi lupei kirira esi Akuj nabo kirirao esi niaronon noi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
