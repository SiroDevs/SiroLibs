              "MRK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Yesu kesi tama, “Ichwangakinito esi nguna dir! Iyenete esi ibore nikisichwangakinit esi a? Erai ni nyiyeneta esi ngagiran kori agogongu a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.24",
            "verseOrgIds": [
              "MRK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo na eyaruneta ngikatoak. Ikokinete kesi ngimalaikae lu eya nadis, nyiutanarete. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.25",
            "verseOrgIds": [
              "MRK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo akiroit ngina ebeyo eyarunete ngikatoak, nyisoma esi anakitab ana igirit Musa ngakiro a amoni anaarirae a? Igiritae neni atamar alimokini Akuj Musa tama, ‘Arai ayong Akuj ka Aburaam ka Isaka ta Yakobo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.26",
            "verseOrgIds": [
              "MRK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "Apud 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Erai ngesi Akuj alu eyarete meere Akuj alu etoakito. Ichwangakinito esi dir!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.27",
            "verseOrgIds": [
              "MRK.12.27"
            ]
          }
        }
      ]
    },
