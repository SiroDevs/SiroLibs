                {
                  "text": "Etal 6:4-5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Yesu tama, “Lo epolot noi ngesi lo: ‘Topupokisi Ngisirael! Ekapolon Akuj yok ngesi bon erai Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tominak Ekapolon Akuj kon a etau kon kadaang, a akiyar kon kadaang, a ngitamen kon kadaang ta ngikilinga kon daang.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Lawi 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Lo a ngiarei loapolon ngesi lo: ‘Tominak ekidunyet kon loger lo iminar iyong ilope akwaan kon.’ Emam etal eche epolot noi idwangit luarei lu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
