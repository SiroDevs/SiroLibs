              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.25+LUK.10.26+LUK.10.27+LUK.10.28"
              },
              "items": [
                {
                  "text": "Luk 10:25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bu eketataman a etal neni kiira kesi ebolosi. Toyen ngesi atamar atachaki Yesu Ngisadukayo niajokon, sodi bu kingit ngesi tama, “Alital epolot noi alotalio kadaang?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.28",
            "verseOrgIds": [
              "MRK.12.28"
            ]
          }
        },
        {
          "name": "note",
