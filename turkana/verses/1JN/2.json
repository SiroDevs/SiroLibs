              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo itwaan cha daang ni engerit Lokookeng a Akuj, engerit tani Akuj Apa, itwaan cha daang ni echamunit Lokookeng a Akuj, echamunit tani Akuj Apa.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.23",
            "verseOrgIds": [
              "1JN.2.23"
            ]
          }
        }
