          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona bocha, kirichakisi alotai kus ngakiro na kolong iirarete esi anakisiakinet, ani kirichakis esi ngakiro na kolong iirarete anakisiakinet nguna, iboikinosi esi jiik iraakasi ngipei ka Lokookeng a Akuj ta Akuj Apa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1JN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiyar na nyedaun ngesi kichikak Kiristo ngoni.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        }
      ]
