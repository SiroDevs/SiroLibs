              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anawiyei kadaang a Ngiyaudi, analesea kadaang, alowaitin kadaang a akwap, ka ngirerea daang, apon totiakunae atamar ejoikinit ngirwa lua Purim itamunio kirichunae jiik.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
