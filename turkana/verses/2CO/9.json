                "loc": "PSA.112.9"
              },
              "items": [
                {
                  "text": "Eosio 112:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Loger lo igiritere nagiran kona,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
