            "number": "7",
            "style": "v",
            "sid": "COL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lokaatokosi lominat Tukiko, lo erai ekasuban etich lo emunoi nabo kisubi ka sua etich a Ekapolon Yesu aapei, ngesi kisisakini esi ngakiro kang daang. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.7",
            "verseOrgIds": [
              "COL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nguna ngesi ameunitor ayong ngesi nikus sodi talakarotor esi ani iirareta eger kirotokinitor sua daang ngaren. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.8",
            "verseOrgIds": [
              "COL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "Tich 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.12"
              },
              "items": [
                {
                  "text": "2 Tim 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Erukito ngesi ka Onesimo, lokaatokosi lominat lo kimuno sua, lo erai epeikus. Kisisakinete kesi esi ngakiro daang na asubasi kane. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.4.9",
            "verseOrgIds": [
              "COL.4.9"
            ]
          }
        },
