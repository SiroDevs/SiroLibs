            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.23+ACT.21.24"
              },
              "items": [
                {
                  "text": "Tich 21:23-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Eraakasi ngulu ngitalio a itwaan ani ikongit akitaleun ani a Akuj. Nakaneni ani kelimu ngesi atamar alemuni alemunet ache na nyerai nakolong ekongio ngesi, ejoikinit ngesi elemuni loger lokolong sek alimunio.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
