          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arai nacha erotokinio asaduku a achamunet, tolim Musa tama, “Tonyou Ekapolon Akuj, kieala ngimoe kon nabo kirita ngulu kiremokino iyong!” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani nacha ewaar asaduku a achamunet tolim Musa tama, “Tobong Ekapolon Akuj, tobong ni eyakasi Ngisirael",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:36",
              "type": "text"
            },
            {
              "text": "tobong ni eyakasi Ngisirael;",
              "type": "text"
            },
            {
              "text": "kori tobongu Ekapolon Akuj, iyong na ikwaan ka ngasigerea a Ngisirael na eraakasi ngamilionio.",
              "type": "text"
            }
          ]
        },
        {
          "text": " lu eraakasi ngabunge.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
            "verseOrgIds": [
              "NUM.10.36"
            ]
          }
        }
      ]
