    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngalesea a Tera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngirora lugu ngika ngalesea a Tera. Auriuni Tera Aburam, ka Naor, ta Aran. Touriu Aran Loti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisiau Aran totoan eringa apakeng Tera nyetoana. Atoani ngesi alore alo kolong edounere alo enyaritae Ur, alo eyei nakwap a Babilonia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuutasi Aburam ka Naor. Anyaritae aberu a Aburam Sarai. Anyaritae aberu a Naor Milika. Arai Milika nakookeng a Aran alo arai apakeng a Isika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni akolupana Sarai, amam ikoku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toriko Tera Aburam lo arai lokookeng, ka Loti lo arai lokookeng a Aran, alo arai lokookeng a Tera. Toriko tani Sarai na arai aberu a Aburam, alo arai lokookeng. Torotokis kesi alo Ur Anakwap a Babilonia, toloto nakwap a Kanaan. Ani enangete Aran, toloma neni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eraunete ngikaru a Tera ngamiae ngaarei ka ngikan, sodi totoan Tera alo Aran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
    }
