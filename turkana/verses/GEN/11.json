        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngirora lugu ngika ngalesea a Chem. Ani enangete ngikaru a Chem amiat apei, touriu Aripakichad, ngikaru ngiarei adaunet a akaale. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akidounet a Aripakichad, kiboi Chem ngikaru ngamiae ngakan. Touriu ngesi ngide ngiche lusapa ka lupesur. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araunet a ngikaru a Aripakichad ngitomwon-uni ka ngikan, touriu Sela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani akidounet a Sela, kiboi Aripakichad ngikaru ngamiae ngoomwon ka nguuni. Touriu ngide ngiche lusapa ka lupesur.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
    },
