                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolimok itwaan ngini ngesi tama, “Nyikinyarao iyong nabo Yakobo jik, eliwor ekiro kon Isirael,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
