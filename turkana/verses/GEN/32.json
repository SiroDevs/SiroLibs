              "type": "text"
            }
          ]
        },
        {
          "text": "Kingit itwaan ngini ngesi tama, “Ngae ekiro kon?” Tatachak ngesi tama, “Kanyaritae ayong Yakobo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
