                  "text": "Yuda 7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nakaneni kingolia aberu a Loti naabor sodi kibelei toliwor amoru a amakat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
