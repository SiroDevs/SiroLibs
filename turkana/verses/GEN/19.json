      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arotokini Loti alo Sodom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
