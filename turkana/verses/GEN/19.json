              "GEN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni tatachak Loti ngesi tama, “Mam kare ekapolon kang, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kingolik a, kisubeta esi ayong naajokak ani kiyuuneta, nakaneni nyamatar ayong lomukur kainyo eloka. Kadolete ayong ngakiro ngache naaronok alorot sodi atotoan eringa nyenanga inaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itee iyong nyire nidiochichi ia? Eapi nyire ngini. Kimiekinae ayong atolot inaa. Itee iyong atamar erai nyire nidiochichi. Ayari ayong kaneni.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
            "verseOrgIds": [
              "GEN.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak emalaikat ngesi tama, “Awaa, achamu ayong. Nyenyasuni ayong nyire ngini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamatar atipei! Emam ibore asubakini ayong eringa iyong nyenanga inaa.” Ani kona abalar Loti edit nyire ngini, tolimokinae ekiro a ere kangolo Soar.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:22",
              "type": "text"
            },
            {
              "text": "Soar;",
              "type": "text"
            },
            {
              "text": "esibit ekiro lo a Ngaeburaniae eger keng atamar “Edit.”",
              "type": "text"
            }
          ]
        }
      ]
    },
