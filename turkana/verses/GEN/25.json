        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngalesea a Aburaam ngache",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuut Aburaam aberu ache na anyaritae Ketura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidoik Ketura Aburaam ngide lu anyaritae Simuran, ka Yokichan, ka Medan, ka Midian, ka Ichibak, ta Chua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Touriu Yokichan Cheba ka Dedan. Ngalesea a Dedan kesi Ngiachurim, ka Ngiletuch, ta Ngileum. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesea a Midian kesi ta Epa, ka Eper, ka Anok, ka Abida, ta Elidaa. Araakasi ngulu daang ngalesea a Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimiekinea Aburaam Isaka ngiboro keng daang. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni inanak Aburaam talokookeng a ngapesur keng ana a ngabwes ngainakinet. Ani ngirwa lu aringaakar ngesi eyari, kitwarak kesi totena nakwap na ayei kide, tachadaros ani ayei lokookeng lo anyaritae Isaka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atoanet a Aburaam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru lu ayarea Aburaam amiat apei ka ngitomwon-kaarei ka ngikan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totoan Aburaam akitu ajokon, erai ekasukout lo amojongit noi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot talokookeng a Aburaam lu anyaritae Isaka ka Ichimael, tonukakis apakech naburibur a Makipela, na ayei mana a Epiron alo arai lokookeng a Soar alo arai eka ekitela a Ngiiti. Arai neni kide a Mamure. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amana ngina ngesi nasek agieluni Aburaam alotunga a Ngiiti. Neni ngesi anukakinio Aburaam ka aberu keng na anyaritae Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.23"
              },
              "items": [
                {
                  "text": "Siak 25:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani ketoana Aburaam kerumor, topia Akuj Isaka lo arai lokookeng a Aburaam. Alomit Isaka Beer-laai-roi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngalesea a Ichimael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichimael lo edoikini Agar Namisirit na arai akasuban etich a Sara, kidoik Aburaam, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.12",
            "verseOrgIds": [
              "GEN.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayakasi talokookeng. Ngirora a talokookeng a Ichimael kesi lugu, iwapap a eger alo kolong edounere kesi. Anyaritae lo ekingaren Nebayos. Ngirora aluche kesi ta Kedar, ka Adibeel, ka Mibisam, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Michima, ka Duma, ka Masa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.14",
            "verseOrgIds": [
              "GEN.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Adad, ka Tema, ka Yetur, ka Napich, ta Kedema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngulu talokookeng a Ichimael, lu erai nikech etorunete ngitela lutomon ka ngiarei, anyaritae ngirerea kech ka ngadakarin, a ngirora kech. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.16",
            "verseOrgIds": [
              "GEN.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru a Ichimael amiat apei ka ngitomwon-uni ka ngikan-kaarei na atoanea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomito ngalesea a Ichimael nakwap na ayei nakidingos a Apila ka Chur, kide a Misiri, lowae lo etenere Asiria. Tachadaros kesi toloma nikalonan ani eyakasi ngalesea a Aburaam nache.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akidounet a Esau ka Yakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi nugu ngakiro a Isaka, alo erai lokookeng a Aburaam. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru a Isaka ngitomwon-omwon na eusea ngesi Rebeka, na arai nakookeng a Besuel, alo arai Emaramit a akwap a Mesopotamia. Arai Rebeka nakaatokeng a Laban. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.20",
            "verseOrgIds": [
              "GEN.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotere ni araakar Rebeka akolup, kilip Isaka Ekapolon Akuj. Kiik Ekapolon Akuj akilip keng, sodi topoti Rebeka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Topotiu ngesi ngimuu. Tobolokin ngide anakook keng, tolim ngesi tama, “Ani kikote ngakiro nege a, nyoni ayarea ayong?” Sodi tolot ngesi akingit Ekapolon Akuj eger a ngakiro kanguna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.12"
              },
              "items": [
                {
                  "text": "Rom 9:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolimok Ekapolon Akuj ngesi tama,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enangi ngirwa keng lu idounio, kidou Rebeka ngide lusapa lumuu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areng lo ekingaren, ekoni akwaan keng eleu lo eyakasi ngajul, sodi tolimokinae ekiro keng Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:25",
              "type": "text"
            },
            {
              "text": "Esau;",
              "type": "text"
            },
            {
              "text": "ekiro eche a Seir ana erai akwap na alomete ngalesea a Esau ekisidi; ikwaan Seir ka akiroit a Ngaeburaniae na erai eger keng atamar “ngini elalak ngajul.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidounoe loa ngiarei etingit atitinyo a Esau, sodi tolimokinae ekiro keng Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:26",
              "type": "text"
            },
            {
              "text": "Yakobo;",
              "type": "text"
            },
            {
              "text": "ikwaan ekiro logo ka akiroit a Ngaeburaniae na erai eger keng atamar “atitinyo.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " Araakasi ngikaru a Isaka ngitomwon-kapei na edounere Esau ka Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agielari Esau apolou keng",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
