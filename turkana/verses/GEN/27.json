          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tokona bocha lokookang, kiwap ngakiro kang, todok tolot ni eyei lokaatokang Laban lo eyei nakwap a Aran, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
