          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kibooyoto ka ngesi kaina tanang ngirwa lu edaunor anyunyura a lokaatokon. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
