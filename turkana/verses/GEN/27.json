          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani napei arumorea Isaka apiar Yakobo, napei arotokinio Yakobo, tobongu Esau lo arai lokaatokeng a Yakobo alorika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.30",
