          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirari Esau ngakiro a apakeng, kikalou iute tokuniikinite, ani erumor tolimok ngesi apakeng tama, “Topiarae kare ayong dang apa!”",
          "type": "text",
          "attrs": {
