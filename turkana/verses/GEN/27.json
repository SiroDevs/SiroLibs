          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kidorok Esau dang akimuj nakaabon, inaa apakeng tolimok tama, “Tonyou robo apa tanyam akiring a etiengit alo aari ayong lokookon alorika, sodi kitopia!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.31",
            "verseOrgIds": [
              "GEN.27.31"
            ]
          }
        }
