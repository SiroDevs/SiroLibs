              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru a Ichimael alo arai lokookeng ngitomon ka nguuni na elengerere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
