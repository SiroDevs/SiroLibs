              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit napei ngina, kilengerae Aburaam ka lokookeng Ichimael. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
