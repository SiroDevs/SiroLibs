              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi ngikaru a Aburaam ngitomwon-koomwon ka ngikan-koomwon na elengerere. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
