            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolim eyenet tama, “Kililing! Atochoito kilimuni tani ni erai ekiro a Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
