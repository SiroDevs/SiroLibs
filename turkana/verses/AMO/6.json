              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keyakasi ngikiliok ngitomon lu idongito nawi apei, etoakete daang. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyenet a itwaan ani atoana, ni erai ngesi enuki akwaan, ipuduni akwaan alokai. Ingisi ngesi itwaan ni eringa eyei kai tama, “Eyei itwaan iche eringa irukito ka iyong a?”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
