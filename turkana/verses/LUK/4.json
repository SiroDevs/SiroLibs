                  "text": "Etal 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachak Yesu ngesi tama, “Igiritae kona, ‘Kilip Ekapolon lo erai Akuj kon sodi tosub etich keng bon!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.8",
            "verseOrgIds": [
              "LUK.4.8"
            ]
          }
        }
