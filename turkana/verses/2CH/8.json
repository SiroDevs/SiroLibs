              "items": [
                {
                  "text": "29:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Etal 16:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Apot kesi tosubakis ngakiro daang nakolong adungokinit Daudi ngimurok ka Ngilawi alowae a ngakais ana ekachio ngiboro ta ngakiro nache.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arumorit Solomon etich keng daang lo a adukuoru napei anakisiakinet tanang narumoret akai a Ekapolon Akuj. Arumoro etich daang niajokon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tolot Solomon lorerea a Esionigeber ka Elas lu ayakasi lodoket lo ekwaas a apas a Akaba, anakwap a Edom. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomeu ekapolon Iram ngatubwae na aweikinito ngitunga a arieng keng, nabo ameto ngikameak lu ayenete amere ngatubwae. Tometa kesi ngatubwae na adokito ngikaweikinak a arieng nguna, tananga nakwap a Opir. Inut kesi Solomon egolit lo eporit ngakiloi 15,000.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
