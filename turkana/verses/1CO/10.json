              "attrs": {
                "loc": "EXO.13.21+EXO.13.22"
              },
              "items": [
                {
                  "text": "Apud 13:21-22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29"
              },
              "items": [
                {
                  "text": "14:22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tani kikote neni, nyesuba kesi lukaalak ngakiro na ejoikinito Akuj, sodi topetakin ngawat alu atoakete ariet wadaang. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.5",
