                "loc": "DEU.32.21"
              },
              "items": [
                {
                  "text": "Etal 32:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.22",
            "verseOrgIds": [
              "1CO.10.22"
            ]
          }
        },
        {
          "name": "note",
