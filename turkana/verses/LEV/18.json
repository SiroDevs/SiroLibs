              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.23",
            "verseOrgIds": [
              "LEV.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Warasi nyiitiliworosi lu nyitaleuno a ngakiro kanu, kainyo ekokinete kolong ngibukui itiliworosi lu nyitaleuno neni. Ngibukui ngulu kesi lu esiaunete toloma neni nakaneni etwarakini tokona ayong Ekapolon Akuj kesi anakwap kangina sodi tolometa esi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.24",
            "verseOrgIds": [
              "LEV.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiliwori eboyor kech akwap na nyitaleuno, nakaneni erirae ayong akwap sodi tongerio akwap ngitunga keng. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.25",
            "verseOrgIds": [
              "LEV.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni kiwapa esi ngakiro kang ka ngitalio kang, warasi nyiisuba ngakiro naaronok nguna, esi kori ngitunga a ngakwapea anache lu irukito ka esi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo asubete kolong ngitunga lu esiaunete toloma nakwap a Kanaan eringa esi ngakiro naaronok nugu daang, sodi kitiliwosi akwap na nyitaleuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni nyiisuba esi na ikote nguna. Ani kisuba esi na ikote nguna, kingeri esi akwap ngina loger lokolong angerio ngibukui lu esiaunete toloma nakwap ngina eringa esi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyenete esi atamar itwaan cha daang ni esubi ngakiro naaronok ikote nguna, nyeringa imarunitae atamar erai ipei a ngitunga a Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.29",
            "verseOrgIds": [
              "LEV.18.29"
            ]
          }
        }
      ]
    },
