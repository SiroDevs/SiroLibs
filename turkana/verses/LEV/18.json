            "number": "6",
            "style": "v",
            "sid": "LEV 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Engeritoe anikus eperete ekile ka aberu na eyanatar. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.6",
            "verseOrgIds": [
              "LEV.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiisurum apakon ngileech ani iperieto ka itiokon nakolong kidouni iyong. Nyiisurum itiokon ngileech. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.7",
            "verseOrgIds": [
              "LEV.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiisurum apakon ngileech ani iperioto ka ngaberu keng nache. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiipero ka nakaatokon kori nakaatokon na a aberu anache, kerai nawi apei kitanunitere esi kori meere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiipero ka nakookeng a nakookon. Eliwor ibore ngini ngileech anikon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiipero ka nakaatokon na a aberu anache, kainyo erai ngesi dang nakaatokon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara Nyiipero ka eyaakon, kainyo erai ngesi nakaatokeng a apakon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiipero ka eyaakon kainyo erai ngesi itiokon naapolon kori naachi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiipero ka aberu a apakon aloapolon, kori aloochi, kainyo erai ngesi dang itiokon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiipero ka aberu a lokookon ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
            "verseOrgIds": [
              "LEV.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kori ka aberu a lokaatokon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiipero ka nakookeng kori atatait a aberu anasek iperito ka iyong. Eraakasi kesi ngiyenet kon, nabo eliworosi nguna ngakiro aronok. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
