              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolim Ekapolon Akuj tama, “Kiwapa ngitalio lu kadungokini ayong esi, warasi nyiiwap eboyor a ngitunga alu kolong esiaunete toloma nakwap a Kanaan eringa esi. Nabo warasi nyiiliworosi lu nyitaleuno ani isubeta ngakiro nguna ngadi. Ayong arai Ekapolon Akuj na arai Akuj kus.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        }
      ]
