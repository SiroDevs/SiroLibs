              "items": [
                {
                  "text": "Lawi 20:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wara nyiiut nakaatokeng a aberu kon ngirwa daang lu eyarea aberu kon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
