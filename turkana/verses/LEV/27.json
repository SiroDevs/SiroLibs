            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kitaleu itwaan amana toliwor aka Ekapolon Akuj, tarai amana ngina na agieli ngesi meere nakolong erumi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "itemi emuron a Akuj etiae a ngaropiyae a amana kangina alokaru alu eringa idongito tanangea ekaru loa ngitomwon-kan. Nakaneni ejoikinit itwaan ngini elemuni ngaropiyae akolongit napei ngina. Eraakasi ngaropiyae ngaka Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani enangi ekaru lo a ngitomwon-kan, ebuakinio amana ngina itwaan nikolong sek arai ilope, ka ngalesea keng.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        }
      ]
    },
