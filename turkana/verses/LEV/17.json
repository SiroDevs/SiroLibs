          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ilimokini iyong kesi atamar itwaan cha daang a Ngisirael kori itwaan cha daang a akwap anache ni irukito ka esi, ni elemuni akipeyos na inomio kori akipeyos ache, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
