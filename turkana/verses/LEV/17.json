            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Ekapolon Akuj Musa tama, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.1",
            "verseOrgIds": [
              "LEV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tolimok Aron ka talokookeng, ta Ngisirael daang atamar, ngitalio lugu kesi adungu Ekapolon Akuj atamar kiwapae.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.2",
            "verseOrgIds": [
              "LEV.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kear itwaan idio Alosirael emong kori imesek, kori akine alotooma adakar kori anikalapatan a adakar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.3",
            "verseOrgIds": [
              "LEV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ejoikinit itwaan ngini eyauni mono akipeyos nia Ekapolon Akuj alongaren eam a Akuj. Itwaan cha daang ni nyikokini neni, erai ekasechan, nakaneni echamit etachi ngaakot na abukor. Nyeringa itwaan ngini imarunitae atamar erai ipei a ngitunga a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.4",
            "verseOrgIds": [
              "LEV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erai eger a etal kalo atamar eyaunete Ngisirael nia Ekapolon Akuj ngibaren daang lukolong aareenete kesi anaroatin. Eyaunete tokona kesi nia emuron a Akuj anakituk a eam sodi taara eraakasi ngakipeyos a ekisil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.5",
            "verseOrgIds": [
              "LEV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewatakini emuron ngaakot lokwaasea a ekeno alo a ngakipeyos anakituk eam, sodi topee nikataronon ni ejoikinit akukuny keng Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.6",
            "verseOrgIds": [
              "LEV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyejoikinit Ngisirael eliworosi lu nyemunosi Ekapolon Akuj ani eareta ngibaren alomoding kipeyokis ngipean a ngaanei. Ejoikinit Ngisirael irichakinete etal logo jiik.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.7",
            "verseOrgIds": [
              "LEV.17.7"
            ]
          }
        }
      ]
    },
    {
