            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kenyam itwaan idio a Ngisirael kori itwaan a akwap anache ni irukito ka esi ngaakot, engeri Ekapolon Akuj itwaan ngini nyeringa nabo imaruni ngesi atamar erai ipei a ngitunga keng. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiyar a ibore kadaang ani eyari, eyei naakot. Ngakiro nguna kesi edungunitor Ekapolon Akuj atamar tobukokinae ngaakot daang lokeno tolemarere ngasechesea a ngitunga. Ngaakot na eraakasi akiyar, kesi elemarete ngasechesea a ngitunga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Ebura 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngakiro nguna kesi alimokinea Ekapolon Akuj Ngisirael ka ngitunga a ngakwapea anache erukitotor kesi atamar nyeenyam akiring.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
