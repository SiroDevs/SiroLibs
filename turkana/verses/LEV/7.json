              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi ngulu robo ngitalio a ngakipeyos ana inomio tonomiasi, ka ngakipeyos a ngalemet, ka ngakipeyos a akisech, ka ngakipeyos a atachanot, ka ngakipeyos a akitaleun, ta ngakipeyos a ekisil. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon Akuj todungok Musa ngitalio ngulu alomoru a Sinai alo ayei nariet, akolongit na alimokinea Musa Ngisirael atamar yaut ngakipeyos.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
