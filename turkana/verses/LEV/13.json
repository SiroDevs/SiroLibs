            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kemin ekile kori aberu ajeme nakou kori nabokony, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
            "verseOrgIds": [
              "LEV.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "iseme emuron. Ani kichukuliyoro ajeme ngina tonyangaaniyarito ngitim keng todiseak, erai enomokere. Elimuni emuron atamar nyitaleunitoe itwaan ngini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.30",
            "verseOrgIds": [
              "LEV.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiseme emuron ngesi, kingolik atamar nyichukuliyoro ajeme, nakaneni eringa ngitim nyiriokera, echadari ngesi a ngirwa a ngikan-kaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.31",
            "verseOrgIds": [
              "LEV.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseme emuron ajeme nabo akolongit na a ngakan-kaarei. Ani keringa nyenyaara, tamam ngitim lunyangayek, nabo nyiichukuliyoro, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.32",
            "verseOrgIds": [
              "LEV.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebanyi itwaan ngini akou kimiek ewae lo eyakasi ngitim. Echadari emuron ngesi nabo a ngirwa a ngiche a ngikan-kaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
              "LEV.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseme emuron ajeme akolongit na a ngakan-kaarei. Ani pekenyaara nabo nyiichukuliyoro, elimuni emuron atamar italeuno itwaan ngini. Ilotari itwaan ngini ngiworui keng, sodi toseger ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
              "LEV.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kenyaar ajeme erai kelimu emuron atamar italeuno itwaan ngini kerumor ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.35",
            "verseOrgIds": [
              "LEV.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "iseme emuron itwaan ngini nabo. Ani kenyaara ajeme, nyeesak nabo emuron aanyungar ngitim lunyangayek, etakani atamar erai itwaan ngini ni nyitaleunitoe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.36",
            "verseOrgIds": [
              "LEV.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kingolik emuron atamar nyenyaara ajeme nabo keruput ngitim lukirionok kaneni, kengaleki ajeme ngina. Elimuni emuron atamar italeuno itwaan ngini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.37",
            "verseOrgIds": [
              "LEV.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
