              "LEV.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kepean ekile kori aberu ngakemera naakwaak nakwaan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "iseme emuron itwaan ngini. Ani kingolik emuron atamar ekwangikinit cha ngakemera nguna, erai ibore ngini loper. Italeuno itwaan ngini.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.39",
            "verseOrgIds": [
              "LEV.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ekile lo edaunosi ngitim tapaloror, italeuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
              "LEV.13.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 13:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kedaunosi itwaan ngitim a akou lua ereet kori lua alokiding akou, kori min angole namedo, epalor itwaan ngini nakaneni italeuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
            "verseOrgIds": [
              "LEV.13.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 13:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kemin ajeme nakori-akwaan napalore, erai enomokere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.42",
            "verseOrgIds": [
              "LEV.13.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 13:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iseme emuron itwaan ngini ani keyei ajeme nakori-akwaan, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.43",
            "verseOrgIds": [
              "LEV.13.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 13:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "elimuni emuron atamar nyitaleunitoe itwaan ngini, kotere enomokere lo eyei nakou keng.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.44",
            "verseOrgIds": [
              "LEV.13.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
