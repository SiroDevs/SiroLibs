              "LEV.26.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 26:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eraakasi lugu daang ngitalio ka ngakiro na adungokini Ekapolon Akuj Musa alokidiama emoru lobe Sinai kotere Ngisirael.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
