              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Esukukuu a Adeparet lo erimare Ekapolon Akuj, isiakini adooyoret a akolong akolongit na a ngatomon ka ngoomwon a elap alo a ekingaren. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit na a ngatomon ka ngakan, isiakini esukukuu a ngamugati anapadok. A ngirwa a ngikan-kaarei napei ngina jik, tanyama ngamugati na emam ekitoe lo itubui. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit na a ekingaren a esukukuu, ejoikinit esi ichunakinosi kilipa, sodi nyiisuba edio a ngitichisio alupalem sek isubete esi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13"
              },
              "items": [
                {
                  "text": "Apud 12:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.1+DEU.16.2"
              },
              "items": [
                {
                  "text": "Etal 16:1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " A ngirwa a ngikan-kaarei, tolemikisi Ekapolon Akuj kus ngakipeyos na epeyo. Ani akolongit na a ngikan-kaarei tochunakinos nabo kilipa, nakaneni nyiisuba edio a ngitichisio alupalem sek isubeenete esi.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        },
        {
          "name": "note",
