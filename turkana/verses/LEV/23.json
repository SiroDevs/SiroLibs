                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akolongit ngina, nyiisuba etich lopalem sek isubeenete, nakaneni tochunakinos kilipa. Irichakinete ngalesea kus etal logo jiik, awadaang anicha elomete kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.21",
            "verseOrgIds": [
              "LEV.23.21"
            ]
          }
        },
