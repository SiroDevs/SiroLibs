              "items": [
                {
                  "text": "Ep 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kol 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ekoni Sara neni, ewapi ngesi ngakiro a Aburaam sodi tanyara ngesi ekapolon keng. Iraakasi tokona esi tanakookeng, erai kisuba na iyookino nabo kemam ibore ikerito. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        },
        {
