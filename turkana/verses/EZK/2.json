              },
              "items": [
                {
                  "text": "Tood 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tanganya ngesi akitab ngina alongaren kang. Egiritae ewae lo alongaren ka lo aabor akigoro ka akialolong, ka akuutere ta ariaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
            "verseOrgIds": [
              "EZK.2.10"
