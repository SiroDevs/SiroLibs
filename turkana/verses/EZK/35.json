          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon arai Ekapolon Akuj kona, “Ketiliwori ayong iyong alaireng kichurok akwap daang kotere aukor kon, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
