                "loc": "LUK.10.13+LUK.10.14"
              },
              "items": [
                {
                  "text": "Luk 10:13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Itwaan, ekianatar ngitunga a Tiro Yerusalem ebalasi, ‘Ekoe! Ere lokolong arai ekidor a ngibukui! Adaun emuchuruseenu keng! Nyeringa nabo erai emoit yok!’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.2",
            "verseOrgIds": [
              "EZK.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tokona bocha, abala ayong Ekapolon lo arai Ekapolon Akuj kona, ere a Tiro, kanyoikinit ayong iyong. Ameuni ayong ngibukui lukaalak kitijikis iyong. Eneteunosi kesi loger a ngitoroi a anam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.3",
            "verseOrgIds": [
              "EZK.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyasunete kesi ngawasea kon, toukosi ngipemin kon lu iyokiyere ere. Ani erumor atopia apua keng daang, emiek ataaba nilapat. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.4",
            "verseOrgIds": [
              "EZK.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elukakin kiding anam toliwor ngesi eloanakinete ngikechiemak ngipuutei kech. Ayong Ekapolon Akuj na arai Akuj alimu nguna. Eremete ngibukui Tiro, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.5",
            "verseOrgIds": [
              "EZK.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "eari akwara ngitunga lu elomito lorerea a Tiro, lowae a akwap anakoonon. Toyeneta kesi atamar arai ayong Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.6",
            "verseOrgIds": [
              "EZK.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon lo erai Ekapolon Akuj kona, “Ayauni ayong ekapolon lo idwangit ngikapolok daang kitijik Tiro. Enyaritae ngesi Nebukadinesa lo erai ekapolon a Babilonia. Irukunete ngesi ka ngasigerea nakaalak alokwap, edokito ngangolei, tometo ngaurukukui na iritae, toloose luche a ngakejen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.7",
            "verseOrgIds": [
              "EZK.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngulu elomito lorerea a akwap anakoonon, eario alojie. Ebokarete ngimoe ngaduon ka ngakatiputipui ta ngawasea na kigagarete esi anikech. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.8",
            "verseOrgIds": [
              "EZK.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eukorete kesi ngawasea kon a ngasua anabwanget, toukosi ngipemin a ngaepe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.9",
            "verseOrgIds": [
              "EZK.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elalak ngangolei a Nebukadinesa. Kirapi iyong apua a ngakejen kech. Erue a ngangolei kech ka ngaurukukui na iritae, itamaranikini ngawasea kon na elomuneta lodorin kus, loger lo elomunere lore lo enyasun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.10",
            "verseOrgIds": [
              "EZK.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ipudaate lua ngangolei ngirotin kon, taara ngitunga kon a ngakwaaras. Eukokinio ngapirio kon naapolok nalup. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.11",
            "verseOrgIds": [
              "EZK.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Engatarete kesi ebari kon ka ngiboro a emuchuruseenu. Erimaunete ngawasea kon, toukosi ngakais kon naajokak. Elemunete kesi ngamoru ka ngakito ta echoto tachakakis nanam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atubori ayong ngieosio kon, nyeringa nabo iirario erue a ngibunei kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22"
              },
              "items": [
                {
                  "text": "Tood 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kemiekini ayong iyong irai ataaba nilapat, ni eloanakinete ngikechiemak ngipuutei kech. Nyeringa nabo iyong kidukokinio jik. Ayong Ekapolon lo arai Ekapolon Akuj alimu nguna.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elimokinit Ekapolon lo erai Ekapolon Akuj ere a Tiro ebala, “Nakidwangere iyong, emaranikinete ngitunga lu elomito lokwaas a anam kotere erue lo idakaror iyong ka akigoro a ngitunga alu eario. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.15",
            "verseOrgIds": [
              "EZK.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikapolok daang lua ngakwapea ana eyakasi lokwaas a anam, etiyaunosi alokicholongo kech a apolou, tobutosi ngiworui kech lua apolou ka lu esiritoe. Ebuloi ngesi eliwor ngiworui kech. Iboikinosi kesi nalup torubakis emaranete, tatalarito naaronok na ianyu iyong. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.16",
            "verseOrgIds": [
              "EZK.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kieonokinete kesi iyong eeos lo igorore ebalasi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.17",
            "verseOrgIds": [
              "EZK.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.18",
            "verseOrgIds": [
              "EZK.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala Ekapolon lo erai Ekapolon Akuj kona, “Ketiliwori ayong iyong alaireng loger a ngirerea alu enyasun, alu emam itwaan elomit. Kaburuchiari ayong iyong a ngakipi ana eponito anituluk a anam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.19",
            "verseOrgIds": [
              "EZK.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katiyaari ayong iyong nakipany kiruko ka ngikatoak lu alomasi nakipany, lotunga lungorok. Kewaakini ayong iyong tolom lokatoak jik, nakwap a nginyas alukajik. Nyeringa iyong imini nakwap na eyakasi ngitunga lu eyarete. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.20",
            "verseOrgIds": [
              "EZK.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.21"
              },
              "items": [
                {
                  "text": "Tood 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ketiliwori ayong iyong ekitetemes loketubulon, toliwor esal kon ngolo. Kisakete ngitunga iyong nakaneni nyitakanuuni nabo jik. Ayong Ekapolon lo arai Ekapolon Akuj alimu nguna.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.21",
            "verseOrgIds": [
              "EZK.26.21"
            ]
          }
        }
      ]
    }
  ],
