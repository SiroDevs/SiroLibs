            "caller": "#"
          },
          "items": [
            {
              "text": "26:1",
              "type": "text"
            },
            {
              "text": "a elap alo:",
              "type": "text"
            },
            {
              "text": "Nyileere Anaeburaniae atamar erai elap ali.",
              "type": "text"
            }
          ]
        },
        {
          "text": " a ekaru alo a ngitomon ka epei a arikonot kosi, katolimok ayong Ekapolon Akuj akiroit tama, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
