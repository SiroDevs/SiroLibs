        },
        {
          "text": "Akolongit na ekingaren a elap alo ...,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.1",
            "verseOrgIds": [
              "EZK.26.1"
            ]
          }
        },
        {
