                "loc": "REV.7.17"
              },
              "items": [
                {
                  "text": "Tood 7:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Emini ayong ka kesi achamunet a ekisil ka akitwarakin ngitieng a moding anakwap, sodi kiboikinotor ngamesekin kang naroatin akaalimon nabo topero namon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.25",
            "verseOrgIds": [
              "EZK.34.25"
            ]
          }
        },
