              "items": [
                {
                  "text": "19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ayei etoil lo eruoro alokidiama atorite na ayei kidiama kech, ani ewaasi kesi, tobilakis ngabeben kech.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
