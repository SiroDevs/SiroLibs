              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomito ngitunga a ekitela a Benjamen lorerea a Geba, ka Mikimach, ka Ai, ka Besel ta ngadakarin na edunyatar. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alomito ngiche Anasos, ka Nob, ka Anania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Asor, ka Rama, ka Gitaim, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Adid, ka Seboim, ka Nebalat, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Lod, ka Ono, ta adipo a ngikechiak ngiboro. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilawi ngiche lusek alomito nakwap a Yuda, apon totiakakinae akilom ka ngitunga a Benjamen wapei.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
          }
        }
      ]
