            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngilawi 284 kesi alomito Yerusalem lo arai ere a Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
