              "items": [
                {
                  "text": "1 Ngirwa 25:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.12"
              },
              "items": [
                {
                  "text": "26:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngirwa nabo lua Serubabel ka Neemia, alemuuniyete Ngisirael daang ngalemunet na einakinio ngikaeok ka ngasigerea a akai a Akuj. Alemanakinete ngitunga Ngilawi akipeyos sodi totiakakis Ngilawi ngimurok nginerin kech.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
