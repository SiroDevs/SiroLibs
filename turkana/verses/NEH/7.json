        },
        {
          "text": "Apot ngikapolok ngiche a ngimacharin alu abongunete anarikonot tolemunos alotich a akiduk. Abu ekapolon a ewae kangolo tolem ngakiloi ngakan-kauni a egolit, ka ngatubwae ngatomwon-kan ta ngiworui lukooyak 530 lua ngimurok a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.70",
            "verseOrgIds": [
              "NEH.7.70"
            ]
          }
        },
