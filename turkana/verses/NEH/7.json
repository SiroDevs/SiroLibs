          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Yaala, ka Darkon, ka Gidel, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.58",
            "verseOrgIds": [
              "NEH.7.58"
            ]
          }
