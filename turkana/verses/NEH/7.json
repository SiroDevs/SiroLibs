          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kesi Sotai, ka Soperes, ka Perida, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.57",
            "verseOrgIds": [
              "NEH.7.57"
