          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngimacharin 642 kesi apote alorerea alu enyaritae Tel Mela, ka Tel Aricha, ka Kerub, ka Adon ta Imer, nakaneni peapedorete kesi akidodiun atamar kirai ngalesea a Ngisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.61",
            "verseOrgIds": [
              "NEH.7.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "NEH 7:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngimacharin ngulu kesi lua Delaya, ka Tobia ta Nekoda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.62",
            "verseOrgIds": [
              "NEH.7.62"
            ]
          }
        }
