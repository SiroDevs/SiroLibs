            "number": "5",
            "style": "v",
            "sid": "NEH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.5",
            "verseOrgIds": [
              "NEH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apot ngitunga lukaalak lusek arikitoe nakwap nagela a Babilon torotokis tobongosi Yerusalem ka Yuda, tolot itwaan daang lore keng. Alomito ngitunga a ngawiyei kech nakwap a Babilonia napei kolong arikio ekapolon Nebukadinesa kesi erai ngirikon. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.6",
            "verseOrgIds": [
              "NEH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaritae ngikarikok kech Serubabel, ka Yochua, ka Neemia, ka Asaria, ka Raamia, ka Naamani, ka Mordekai, ka Bilichan, ka Misiperes, ka Bigipai, ka Neum ta Baana.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.7",
            "verseOrgIds": [
              "NEH.7.7"
            ]
          }
        }
      ]
    },
    {
