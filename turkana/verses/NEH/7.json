              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngalesea a ngikasubak etich alokai a Akuj, ka ngikasubak etich a Solomon, alu abongunete anarikonot arai ekimar kech daang 392.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.60",
