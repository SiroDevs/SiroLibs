          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngirora a ngimacharin a Ngisirael lugu ka ekimar a ngitunga a emachar kadaang alu abongunete anakwap anagela.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.7.8",
            "verseOrgIds": [
              "NEH.7.8"
            ]
          }
        }
