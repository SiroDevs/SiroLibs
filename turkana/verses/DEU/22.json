              "DEU.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.19"
              },
              "items": [
                {
                  "text": "Lawi 19:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nyiinap ngiworui lu edonyunitoe anajul ka ngawarui aapei. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.37+NUM.15.38+NUM.15.39+NUM.15.40+NUM.15.41"
              },
              "items": [
                {
                  "text": "Ekim 15:37-41",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
            "verseOrgIds": [
              "DEU.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Todonyokisi ngawarui na isanasanasi lowaitin luomwon a ngiworui kus.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eboyor loajokon a ngikiliok ka ngaberu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
            "verseOrgIds": [
              "DEU.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Epedori itwaan kiut apese ani ekisidi tasak akinger ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.13",
            "verseOrgIds": [
              "DEU.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor kitingak ngesi aberu ngina atamar eperito sek ka ekile eche eringa kesi nyiriamuna. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.14",
            "verseOrgIds": [
              "DEU.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kesubakin ngakiro nguna, elemunete ngikauriak a aberu kangina eworu lodapal lokolong aperioto ekile ngolo ka aberu keng na eutatar. Eyaarete kesi eworu lodapal eyakasi ngakemera a ngaakot nitubet ngakiro kidodikis ngikarikok a ere. Idodiuni eworu lodapal ngolo atamar nyepero ngesi ka ekile a ache. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.15",
            "verseOrgIds": [
              "DEU.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elimokini apakeng a aberu kangina kesi tama, ‘Ainakini kolong ayong ekile logo nakookang kiut, nakaneni anger tokona ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.16",
            "verseOrgIds": [
              "DEU.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etingak ngesi nakookang atamar eperito kolong sek ka ekile eche eringa nyiriamuna ka ngesi. Nakaneni ibore en ngesi idodiunit atamar eringa nakookang nyepero ka ekile eche. Kingolikisi ngaakot na eyakasi loworu logo lokolong aperioto kesi akwaar na akuuta!’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.17",
            "verseOrgIds": [
              "DEU.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni erikorete ngikarikok a ere ekile ngolo kideta ngesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.18",
            "verseOrgIds": [
              "DEU.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitelemunae nabo ngaropiyae amiat apei nakinae apakeng a aberu kangina, kainyo ayau ekile ngolo ngileech napese na erai Asiraelit. Nabo eliwor aberu ngina akeng jik, nyelaki ngesi jik ngirwa daang lu eyarea ngesi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.19",
            "verseOrgIds": [
              "DEU.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakaneni ani kerai ngakiro a ekile iteni, nabo tamam ibore ni idodiunit atamar peaperito aberu ngina ka ekile sek, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "erikorio aberu ngina tanang nakituk a akai a apakeng, ani enangi neni, kimasa ngikiliok a ere kangolo ngesi a ngamoru totoan. Asub ngesi ngakiro na a ngileech alotunga yok ani aperioto ka ekile eringa ngesi nyiuta, ngirwa lu aringaakar eyei nawi ka apakeng. Kotere eger ngolo, ilemarete esi ngakiro naaronok nguna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
      ]
    },
    {
