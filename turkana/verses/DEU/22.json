          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keriamun ekile eperete ka aberu a ekile aloche, eario kesi daang. Kotere eger ngolo, ilemarete esi ngakiro naaronok nguna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
      ]
    },
