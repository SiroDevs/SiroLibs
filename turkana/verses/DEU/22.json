          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keriamun ekile alore eperete ka apese na enerit ekile loche, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.23",
            "verseOrgIds": [
              "DEU.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kipudosi kesi alore sodi kimasa a ngamoru totoan. Echamit apese dang etoani kainyo nyiremara ngesi esaki atamar katoyuun, tarai ayei lore ni adikino ngitunga luche iirareta ngesi irema. Nabo echamit ekile etoani kainyo aperete ngesi ka apese na eneritoe. Kotere eger ngolo, ilemarete esi ngakiro naaronok nguna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
