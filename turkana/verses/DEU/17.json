              },
              "items": [
                {
                  "text": "Apud 22:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Warasi nyiipeyokis Ekapolon Akuj na erai Akuj kus ngaatuk ka ngamesekin na eyakasi ni ichwangakina, kainyo eremokino Ekapolon Akuj ibore ngini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.1",
            "verseOrgIds": [
              "DEU.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keyei itwaan alorerea kus nikile kori niberu ni asechaki Ekapolon Akuj ani echwangakinea achamunet a Ekapolon Akuj, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.2",
            "verseOrgIds": [
              "DEU.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani elipea ngakujo nache ka akisub etich kech, keraakasi ngakujo nguna akolong, kori elap, kori ngikanyer, tarai nyitemem nguna ka ngakiro nakolong adunguni Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.3",
            "verseOrgIds": [
              "DEU.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiirasi esi ngakiro na ikote nguna, tongichutu lokojokon. Ani kesubakina dir ngakiro naaronok nguna anakwap a Ngisirael, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.4",
            "verseOrgIds": [
              "DEU.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kipudosi itwaan ngini nikalapatan a ere kimasa a ngamoru totoan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.5",
            "verseOrgIds": [
              "DEU.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echamitae ngesi eario eraakasi ngikaanyunak ngiarei kori kelalak. Nyechamitae ngesi eario erai ekaanyunan epei bon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.6",
            "verseOrgIds": [
              "DEU.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.30"
              },
              "items": [
                {
                  "text": "Ekim 35:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Etal 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "Mat 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.28"
              },
              "items": [
                {
                  "text": "Ebura 10:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngikaanyunak kesi isiaunete kimasa itwaan ngini, ani erumor kimasa ngitunga luche. Kotere eger ngolo, ilemarete esi ngakiro naaronok nguna anikus. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Kor 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.7",
            "verseOrgIds": [
              "DEU.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Epedorete ngikesio ngiche agogongikin ngikatubok ngakiro lu iseut esi. Ngikesio ngulu kesi lu ikote akitiak ngiboro a ngitunga, ka eger lo ewanatar ngitunga, kori akitiak kerai akitu a itwaan na iyechakinitae kori na nyiyechakinitae. Ani kikokis ngakiro neni toloto ni echamakinit Ekapolon Akuj na erai Akuj kus ilipeenere, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.8",
            "verseOrgIds": [
              "DEU.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kisisaut ngakiro kus ani a ngimurok a Akuj alu eraakasi Ngilawi, ta ekatubon ngakiro lo esubi etich esaa ngolo, sodi kimiekis kesi totubo ngakiro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.9",
            "verseOrgIds": [
              "DEU.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etubete kesi ngakiro sodi tosuba esi ngakiro nakilimokinete kesi esi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.10",
            "verseOrgIds": [
              "DEU.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tachamutu ngakiro na edungunete kesi alokies, sodi kiwapa ngakiro na elimunete kesi daang lokojokon. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.11",
            "verseOrgIds": [
              "DEU.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwaan cha daang ni nyiwapi ngakiro a ngikatubok ngakiro ka emuron lo esubi etich esaa ngolo, eario. Kotere eger ngolo, ilemarete ngakiro naaronok nguna anakwap a Ngisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.12",
            "verseOrgIds": [
              "DEU.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni iirarete ngitunga daang ngakiro nguna toema, toliwor emam itwaan nabo iyechakini tosubak ngakiro nugu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekapolon lo eseunio",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.13",
            "verseOrgIds": [
              "DEU.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani ilemarete esi akwap nakiinakini Ekapolon Akuj na erai Akuj kus, sodi toloma neni, itiakunete esi atamar kisaki ekapolon loger a ngibukui aluche kadaang. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.14",
            "verseOrgIds": [
              "DEU.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyena atamar esakitae esi iseunete itwaan ni aseu Ekapolon Akuj. Nyiitiliwosi itwaan a akwap anache ekapolon kus, ejoikinit erai itwaan nia akwap kus. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.15",
            "verseOrgIds": [
              "DEU.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyesakitae ekapolon eyakasi ngangolei a ngasigerea keng nakaalak, nabo nyesakitae ngesi emeari ngitunga Misiri akigiel ngangolei,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:16",
              "type": "text"
            },
            {
              "text": "akigiel ngangolei;",
              "type": "text"
            },
            {
              "text": "kori kilokonyuunere ngangolei.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kainyo alimu Ekapolon Akuj atamar nyebongete ngitunga keng inaa nabo jik. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.16",
            "verseOrgIds": [
              "DEU.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyesakitae ekapolon eriki ngaberu nakaalak, kainyo ibatarete ngaberu ngesi ani a Ekapolon Akuj. Nabo nyesakitae ngesi ebari ngaropiyae ka egolit. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.17",
            "verseOrgIds": [
              "DEU.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eliwor ngesi ekapolon, esakitae ngesi toting akitab na igiritae ngitalio a Akuj, lu elemunitae anakitab ana kolong a ekingaren a etal ana etingito ngimurok a Ngilawi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.18",
            "verseOrgIds": [
              "DEU.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esakitae ngesi iwaakini akitab ngina diyete, sodi kisoma ngirwa daang lu eyarea ngesi, kitatamar ngesi akiker Ekapolon Akuj ka akiwap ngakiro daang na edungunit ngesi anakitab. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.19",
            "verseOrgIds": [
              "DEU.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.5"
              },
              "items": [
                {
                  "text": "1 Sam 8:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iratakinete ngakiro nguna ekapolon ngolo nyiitam atamar ajok ngesi noi edwangit Ngisirael luche, nabo nyeenger ngitalio a Ekapolon Akuj. Ani kikok neni, epolokini ngesi akwap ngikaru lukaalak. Epolokinete ngesi ka ngalesea keng akwap a Ngisirael ngikaru lukaalak. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.17.20",
            "verseOrgIds": [
              "DEU.17.20"
            ]
          }
        },
