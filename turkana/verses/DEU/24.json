            "sid": "DEU 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyechamit ngikauriak eario kotere ngisech a ngide kech, nabo nyechamit ngide eario kotere ngisech a ngikauriak kech. Echamit itwaan eario kotere akisech na esubi ngesi ilope bon.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        }
