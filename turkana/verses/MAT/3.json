              "items": [
                {
                  "text": "Luk 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kiirarae etoil anadis ebala, “Lokookang lominat ngesi lo, ketalakarit ngesi ayong.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
