                "loc": "GEN.4.24"
              },
              "items": [
                {
                  "text": "Siak 4:24",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu Yesu tama, “Mam, meere ngakan-kaarei nakaneni erai ngatomwon-kaarei ngakimarunet ngakan-kaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.22",
            "verseOrgIds": [
              "MAT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo ikoni Apolou a Akuj ne. Ayei kolong ekapolon lo asaki akimichare ngamichae na aarito ngikasubak etich keng. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.23",
            "verseOrgIds": [
              "MAT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napei esiakinea ngesi akimichare, torikunoe epei lo aarit ngaropiyae ngabunge ngatomon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.24",
            "verseOrgIds": [
              "MAT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amam ekasuban etich ngolo ngaropiyae nakaalak na etemokino etachea amicha keng. Nakaneni todung ekapolon ngolo atamar togielarae ngesi ka aberu ka ngide ta awi keng daang taraut ngirikon sodi tatachere amicha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.25",
            "verseOrgIds": [
              "MAT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toriedik ekasuban etich kimaima ekapolon tama: ‘Kiapakinae kare! Atachi ayong amicha kon daang’. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.26",
            "verseOrgIds": [
              "MAT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisieni ekapolon ngolo ekasuban etich keng torimak, tajalak amicha keng, sodi kimiek ngesi tolot. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.27",
            "verseOrgIds": [
              "MAT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Topudo ekile ngolo nikalapatan torukau ekasuban etich loche lorukitos keng lo aarit ngadinari amiat apei anikeng. Torwakin ngesi tomied ebala, ‘Tatach amicha kang daang’. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.28",
            "verseOrgIds": [
              "MAT.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tadakakin ekasuban etich lorukitos keng ngolo nalup toriedik kimaima ngesi tama, ‘Kiapakinae kare. Kimiekinae katachakini ayong iyong amicha kon daang’. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.29",
            "verseOrgIds": [
              "MAT.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakaneni towou ngesi arimakin loche, tama toinikisi loche lojela tanang ni etachea amicha keng. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.30",
            "verseOrgIds": [
              "MAT.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na engolikineta ngikasubak etich luche ngakiro na asubakin, apot tongoa noi sodi toloto tolimokis ekapolon ngakiro daang na asubasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.31",
            "verseOrgIds": [
              "MAT.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tanyarau ekapolon ekasuban etich tooma akai tolimok tama, ‘Irai iyong ekasuban etich loaronon, kajalakini ayong iyong amicha kang daang kotere ani kimaimaea iyong ayong. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.32",
            "verseOrgIds": [
              "MAT.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejoikinit iyong dang kisieni ekasuban etich erukitos kon loger lo kisienio iyong ayong.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.33",
            "verseOrgIds": [
              "MAT.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tongo ekapolon noi sodi torikok ekasuban etich ngolo asiger a ejela toenae tanang akolongit na etachea amicha keng daang.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Yesu ngakiro narumoret ebala, “Ngakiro napei nguna ngesi kisubea esi Apakang lo eyei nadis erai pekerimaki ipeikus lokaatokeng alotau keng kadaang.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
    }
