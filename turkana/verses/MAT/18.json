                "loc": "LUK.17.3+LUK.17.4"
              },
              "items": [
                {
                  "text": "Luk 17:3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bu Petero nia Yesu kingit tama, “Ekapolon arimakini ayong lokaatokang lo kasechanakini ayong jiik ngarimanakinet ngai? Ngakan-kaarei ngakimarunet ngakan-kaarei a?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
