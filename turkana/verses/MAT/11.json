          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kongina Apa, isub iyong nguna daang loger lo ichamitor iyong alope a ajokis kon. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        },
