          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwoko eegos kang, kitatamas anikang kainyo apalaana ayong nabo etiditeuna nakaneni iangarete esi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
