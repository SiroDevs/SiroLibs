        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi toisik Ekipe Yesu, pot ngimalaikae kingarakis ngesi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.11",
            "verseOrgIds": [
              "MAT.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akisiakinet a Yesu etich keng anakwap a Galilaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
