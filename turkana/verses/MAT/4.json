          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toriko Ekipe Yesu moru lokooyen noi kidodik ngesi ngapolosio daang a ngakwapea ka apolou kech. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Ekipe tama, “Kainakini ayong iyong nugu daang kiriedik iyong kilip ayong.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.9",
            "verseOrgIds": [
              "MAT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
