                  "text": "4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi toreea Etau a Akuj Yesu nariet kiningio ngesi Ekipe kaina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na aronitor Yesu ngakwaarisea ka ngapaaranisea ngatomwon-omwon, tanyam akoro. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu Ekipe nikeng tolimok ngesi tama, “Ani kirai iyong Lokookeng a Akuj, kitiliwo chene ngamoru nugu akimuj.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        }
      ]
    },
    {
