                  "text": "Etal 8:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachak Yesu ngesi tama, “Igiritae nakitab a Akuj kona:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.4",
            "verseOrgIds": [
              "MAT.4.4"
