          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.13"
              },
              "items": [
                {
                  "text": "Etal 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi tatachak Yesu tama, “Kape iyong Esiitan. Igiritae kona:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.10",
            "verseOrgIds": [
              "MAT.4.10"
            ]
