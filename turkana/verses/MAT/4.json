                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tatachak Yesu tama, “Igiritae nabo kona: ‘Nyiining Ekapolon Akuj kon.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.7",
            "verseOrgIds": [
              "MAT.4.7"
