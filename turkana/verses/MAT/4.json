                "loc": "PSA.91.11+PSA.91.12"
              },
              "items": [
                {
                  "text": "Eosio 91:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " tolimok tama, “Ani kirai iyong Lokookeng a Akuj kimasar chene kwap, kainyo igiritae kona:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
