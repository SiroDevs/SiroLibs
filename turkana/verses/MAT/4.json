              },
              "items": [
                {
                  "text": "Luk 3:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani iirari Yesu atamar aen Yoana alojela, tolot ngesi Galilaya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Yoa 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abu ngesi nyiiboikin Nasaret, nakaneni tolot akiboi alore a Kaperinaum alo eyei diyete anam a Galilaya. Erai neni akwap a Sebulun ka Naputal. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubasi nugu sodi kiyookinitor nguna kolong alimuni ekadwaran a Akuj Isaya ebala:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
