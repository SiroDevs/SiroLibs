          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayong Paulo lo kaseuni Akuj atoliwor emeanara a Yesu Kiristo ngesi egirunit abarua naga. Kaseunio ayong atolimo ngakiro a akiyar ana kolong kichikakinio ngoni ani kimorikinor aapei ka Yesu Kiristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
