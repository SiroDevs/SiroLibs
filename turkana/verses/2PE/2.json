                {
                  "text": "Siak 19:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.3",
            "verseOrgIds": [
              "2PE.2.3"
            ]
          }
        },
        {
