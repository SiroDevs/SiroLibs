              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomea ekapolon Iram ngitunga keng lu ayenete amere ngatubwae ananam toloto akisub etich ka ngitunga lua Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
