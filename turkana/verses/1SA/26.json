              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Saul Daudi tama, “Kitopia Ekapolon Akuj iyong lokoku! Ejokearosi ngakiro na isubi iyong daang!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
