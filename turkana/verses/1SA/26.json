              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu Daudi tama, “Akwara kon naga, ekapolon! Tomeu ipei a ngitunga alukon kangulu bu omu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
          }
        },
        {
          "name": "verse",
