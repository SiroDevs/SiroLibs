            "number": "23",
            "style": "v",
            "sid": "1SA 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Einanakini Ekapolon Akuj lu emunoi ka lu etenooko ebachit. Akolongit naga, kiwaakinit iyong Ekapolon Akuj nakan kang, nakaneni nyewana ayong iyong, lokolong kiseuni Ekapolon Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loger lo kajalunea ayong iyong akolongit naga, kimiek Ekapolon Akuj katajalu ayong katoyuu alochan kadaang!”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        }
