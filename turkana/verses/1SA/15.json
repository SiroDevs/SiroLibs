              "1SA.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim Samuel tama, “Anukiro esaki Ekapolon Akuj, akiwap ngakiro keng kori ngalemunet ka ngakipeyos? Ejok akiwap ngakiro keng akidwang akipeyonokin ngesi ngimesekin luatumak. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.22",
            "verseOrgIds": [
              "1SA.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kainyo akinger ngakiro keng, ikwaan ka akapel. Nabo ikwaan ngiwog ka akilipit ngakujo nasubuna. Ani aloger ingerio iyong ngakiro a Ekapolon Akuj, kinger ngesi dang iyong iliwor ekapolon.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachak Saul Samuel tama, “Asech ayong ani angerio na adungit Ekapolon Akuj ka ngakiro kon. Aemi ayong ngitunga kang dio atosub na asakete kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kelipit tokona iyong atamar torimakinae kare akisech kang, atobongosi Giligal atopedorea ayong akilip Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatachu Samuel tama, “Nyikibongori ayong ka iyong kainyo inger iyong ngakiro a Ekapolon Akuj nabo kinger Ekapolon Akuj iyong aliwor ekapolon a Ngisirael.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erea Samuel ebala atorotok, torwakin Saul ewaru a Samuel tochil. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok Samuel ngesi tama, “Achilichilia Ekapolon Akuj akolongit naga apolou kon alo Isirael, ainaki ekidunyet kon, lo ejok kidwangit iyong. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.17"
              },
              "items": [
                {
                  "text": "1 Sam 28:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.30+1KI.11.31"
              },
              "items": [
                {
                  "text": "1 Kapol 11:30-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuj a Isirael na erimae, nyingalae kori nyilochi ngakiro keng. Meere ngesi itwaan, nyilocheene ngesi ngakiro keng.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
