              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eringa ekapolon iruorikinit, totiyaun etoil anadis tama, “Ee ekapolon Nebukadinesa, kiira akiroit nakang naga. Alemar apolou anikon! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitwarakinio iyong ani eyakasi ngitunga! Irukete iyong ka ngitieng a moding anachokor, tadak nginyia loger a emong! Iboikin iyong loger ngolo a ngikaru a ngikan-kaarei, ani adaunet a ngikaru kangulu toyen atamar Akuj na Epol Noi ngesi eyei agogongu anapolosio kadaang a ngitunga, nabo ipotori apolou nak itwaan cha daang ni esaki ngesi.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
