                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Yoch 19:49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tonukakinae ngesi nakwap keng na enyaritae Timunas Sera. Eyei neni nakwap ngimukur a Epiraim, na eyei lowae lokwap emoru a Gaach.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
