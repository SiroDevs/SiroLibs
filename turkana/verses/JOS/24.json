          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokis ngitunga Yochua tamasi, “Meere kongina! Kisubi sua etich a Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        }
