            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todung Yochua tama, “Tachakasi robo tokona ngakujo nagelayek na itingito esi, sodi toreikis ngitai kus nia Ekapolon Akuj ana erai Akuj a Isirael.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tolimokis ngitunga Yochua tamasi, “Kisubi sua etich a Ekapolon Akuj ana erai Akuj kosi. Kiwapi sua ngakiro na edungunit ngesi.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.24",
            "verseOrgIds": [
              "JOS.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tachamakin Yochua ka ngitunga akolongit ngina, dio ainakin kesi ngitalio lu iwapete ani enyaritae Chekem.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
            "verseOrgIds": [
              "JOS.24.25"
            ]
          }
        }
      ]
    },
    {
