              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.25",
            "verseOrgIds": [
              "JOS.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigir Yochua ngitalio ngulu nakitab a etal a Akuj. Sodi tolem ngesi amoru naapolon kitowo alokwap echoke alotooma akai a Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok ngesi ngitunga daang tama, “Amoru naga eliwor akaanyunan yok. Eira ngesi ngakiro daang nakilimok Ekapolon Akuj ngoni. Ngesi eliwor akaanyunan kus nyiingerioto esi Akuj kus.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi kieala Yochua ngitunga, tobongo itwaan daang nakwap keng.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
            "verseOrgIds": [
              "JOS.24.28"
            ]
          }
        }
      ]
    },
