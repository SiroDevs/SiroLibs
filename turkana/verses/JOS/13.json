            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eger ngolo ngesi kolong atiakea Musa akwap na ayei kide Yeriko ka Yorudan na ayakar naroatin a Moab. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
