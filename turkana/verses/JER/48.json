        },
        {
          "text": " Ngakiro nugu alimuni Akuj Namerikanyer na erai Akuj a Isirael kotere Moab,",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
          }
        }
