              "items": [
                {
                  "text": "1 Sam 7:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ani kingita kesi iyong ebalasi, ‘Aliwae kilosi sua?’ Itachakini iyong kesi atamar abala ayong Ekapolon Akuj kona,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
