            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngikapolok daang alokwap, lu eloka ka lu eapiyete, napei ani eyei epei kiporok loche. Emaase ngikapolok daang anakwap. Ani erumor tamat ekapolon a Babilon dang.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
