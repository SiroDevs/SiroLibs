          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tokona bocha iyong Yeremia, todwar ngakiro daang na alimu ayong. Tolimok ngitunga lugu kona,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
