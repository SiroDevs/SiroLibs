              },
              "items": [
                {
                  "text": "Lawi 18:21",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani erumor tobwang iyong agulu alongaren ngitunga lu irukorete ka iyong ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "sodi tolimok kesi atamar abala ayong Akuj Namerikanyer kona, ‘Abilibili ayong ngitunga lugu, atobwang ere logo, kikokis agulu naga nabwangang na emam kona irumeikin. Enukakinio ngitunga Topes, kainyo engopi nabo wache enukakinio. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakiro nguna asubakinea ayong akwap naga ka ngitunga keng. Asubakinea ere logo ngakiro na asubea Topes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakais na eyakasi Yerusalem ka ngakais a ngikapolok a Yuda, eliworosi na nyitaleuno loger a Topes. Tani ngakais daang nakolong enomanakinere ngikanyer emitina alokidiama kech, ka akidokanakin ngakujo nache emuna erai akipeyos, ikokinete neni.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisidi kanguna, torotok Yeremia alo Topes, anisek amearit Ekapolon Akuj alosit akidwar ngakiro. Tolot towo analaar a akai a Akuj tolimok ngitunga daang tama, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Akuj Namerikanyer na erai Akuj a Isirael, ebala kona, ‘Kingolikisi a, ayauni ayong lore logo ka ngadakarin daang na idunyatar, eriras lokolong abala ayong ayauni, kainyo ichanaka kesi, awout akiirar ngakiro kang.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    }
