                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Kapol 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31+JER.7.32"
              },
              "items": [
                {
                  "text": "Yer 7:30-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.34+JER.32.35"
              },
              "items": [
                {
                  "text": "32:34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iriamete ngimoe ere, tasaka akiar ngitunga a ere kangolo. Eroner eboyor a ere kangolo noi. Elomakinete ngitunga anyama make alotooma ere, tanyama tani ngide kech a ngikulepek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
