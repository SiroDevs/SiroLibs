            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi eira ayong nabo etoil eche iruoro anadis ebala,",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.4",
            "verseOrgIds": [
              "REV.18.4"
