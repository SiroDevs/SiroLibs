                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " lu ekitela a Sabulon, araakasi ngabunge ngatomon ka ngaarei, lu ekitela a Yosep, araakasi ngabunge ngatomon ka ngaarei, lu ekitela a Benjamen, araakasi ngabunge ngatomon ka ngaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
