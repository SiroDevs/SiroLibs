                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.13.19"
              },
              "items": [
                {
                  "text": "Mar 13:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atatachak ayong atama, “Nyayeni ayong ekaapaan. Iyong ngesi iyeni.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katolimok ngesi ayong tama, “Ngitunga lugu kesi apuunosi anaboliaro anaaronon noi. Elotasi kesi ngiworui kech a ngaakot a Imesek, akwangeta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibore ngini ngesi ewaatar kesi alongaren ekicholong a Akuj, esubete etich keng naparan ka akwaar alokai a Akuj. Eyuuni ngolo ibooyi alokicholong kesi ani eyakar ngesi neni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.15",
            "verseOrgIds": [
              "REV.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyenyami kesi akoro ka akure nabo jik, nyenomi kesi akolong kori nyichanyun ka nikariran, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.10"
              },
              "items": [
                {
                  "text": "Isa 49:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kainyo Imesek ni erai ngesi ekidingikino lokicholong a apolou, eliwor ekeyokon kech, eriki ngesi kesi lolelea a ngakipi ana a akiyar. Emiatari Akuj kesi ngakiyo anakonyen kech.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.17",
            "verseOrgIds": [
              "REV.7.17"
            ]
          }
        },
