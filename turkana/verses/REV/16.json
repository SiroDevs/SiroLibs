                "loc": "REV.3.3"
              },
              "items": [
                {
                  "text": "Tood 3:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Topupok! Abuni ayong loger a ekokolan! Epiaritae noi itwaan ni ekienyi irichakinit ngiworui keng, sodi nyilaa ngesi emuner taanyu ngileech alokiding ngitunga!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
