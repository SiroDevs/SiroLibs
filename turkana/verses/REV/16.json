                "loc": "EXO.9.10"
              },
              "items": [
                {
                  "text": "Apud 9:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tolot emalaikat lo a ekingaren tobukok atubwa keng nakwap. Tatakanuut ngajemei nakariabak noi ani eya ngulu ayei emachar a etiengit ka ngulu elipete ekisikwaane keng losubuna.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
