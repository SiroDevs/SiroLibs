            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi tochunut ngipean ngikapolok wapei ni enyaritae a Ngaeburaniae Arimagedon. ",
          "type": "text",
          "attrs": {
