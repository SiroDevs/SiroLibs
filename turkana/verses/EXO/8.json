              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi tanyarau ekapolon Musa ka Aron tolimok tama, “Kipeyonokisi Akuj kus ngakipeyos anakwap kana.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.25",
            "verseOrgIds": [
              "EXO.8.25"
            ]
          }
        }
