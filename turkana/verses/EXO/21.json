        {
          "text": " anomat nanomat nache, ajeme najeme nache, ni ebutoro ni eyei niche ebutoro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
