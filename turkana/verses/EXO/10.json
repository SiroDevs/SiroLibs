            }
          ]
        },
        {
          "text": "Kitiliwo Ekapolon Akuj ekapolon a Misiri lo ichanana noi, towou akimiekin kesi toloto. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
