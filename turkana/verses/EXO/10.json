          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok ekapolon Musa tama, “Kape kane! Tochoite kisingolikin ayong nabo! Akolongit nakengolikinea ayong iyong, itoani iyong!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
