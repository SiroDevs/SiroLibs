              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwaar ngina, toyuu Ekapolon Akuj Ngisirael ani a Ngimisiri, taanyungasi Ngisirael kesi eperete alokwaas a anam etoakito. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
