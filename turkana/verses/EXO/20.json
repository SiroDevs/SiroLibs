            "number": "4",
            "style": "v",
            "sid": "EXO 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiisubak ngakisikwaanet a ibore a idio ani eyei nadis kori nakwap, kori ni eyei tooma nakipi kwap ngalup. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wara nyiiriedikok akuj nasubuna kori nyiilip, kainyo ayong Ekapolon Akuj kus, arai Akuj a etereku. Erirae ayong lu karemokino ayong nabo erirae ngalesea kech tanang nalesea na ngauni ka na ngoomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
