                {
                  "text": "Tood 15:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sodi toeokis Musa ka Ngisirael Ekapolon Akuj eeos logo ebalasi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.1",
            "verseOrgIds": [
              "EXO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eeos a Miriam",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.18",
            "verseOrgIds": [
              "EXO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etorete Ngisirael nikoonon alokiding anam. Nakaneni ani elomarete ngaurukukui na irito ngangolei ka ngangolei kech ta ngikameak ngangolei tooma nanam, tobuu Ekapolon Akuj ngakipi sodi toburuchiasi kesi daang.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolem akadwaran a Akuj na anyaritae Miriam, na arai nakaatokeng a Aron aekiek, sodi kiwapakis ngesi ngaberu daang ideese ngaekieke, kidongaate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toeok Miriam kimaranak ebala,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngakipi naadwarak tel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Musa toriko Ngisirael nanam a Chamu tananga nariet na enyaritae Chur. Toloto kesi anariet ngirwa nguuni, nakaneni tongopikis ngakipi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanangut kesi ni enyaritae Mara. Nyemata kesi ngakipi na ayakasi Mara kainyo adwarak tel. Ngakiro nguna enyaritere neni Mara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:23",
              "type": "text"
            },
            {
              "text": "Mara;",
              "type": "text"
            },
            {
              "text": "erai eger a ekiro kalo a Ngaeburaniae ngesi atamar “Edwar”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisuburata ngitunga Musa kingita tamasi, “Nyoni kimasi sua?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilip Musa Ekapolon Akuj kikaloik, sodi kidodik Ekapolon Akuj ngesi akitoe na achakakini ngesi nakipi, sodi tojoketa ngakipi toliworos namatan.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nak Ekapolon Akuj kesi kaneni ngitalio lu iwapete, sodi nabo kining ngesi kesi kaneni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolim ngesi tama, “Ani kiwap esi ngakiro kang lokojokon tosuba na abala ayong iyookino ka akirichun ngitalio kang, nyekerirae ayong esi a ngidekesinei alu ayauni ayong nia Ngimisiri. Arai ayong Ekapolon Akuj naketedeki esi tangalekis.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erumor tanangut kesi ni enyaritae Elim. Ayakasi neni ngileleae ngitomon ka ngiarei ta ngingolea ngitomwon-kaarei. Toloma kesi diyete ngakipi kaneni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
    }
  ],
