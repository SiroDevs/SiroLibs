              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todukok Musa alaar kisiriam eam ka ekeno a ngakipeyos kinenek awaru na ekidor a alaar. Sodi torumo ngesi etich daang.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Edou alokidiama eam a Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
