          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sodi kimuk edou eam a Akuj, kilelebun akwangis naakwaan kea a Ekapolon Akuj loeam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
            ]
          }
        },
        {
