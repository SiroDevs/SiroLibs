              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani esaa daang lo emukitor edou eam, peachamakinitae Ngisirael eramakinete. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
