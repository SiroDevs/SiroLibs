          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araakasi Ngisirael nyenyounete awosit wache mati kikeun edou aloeam. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
            "verseOrgIds": [
              "EXO.40.36"
            ]
          }
        },
