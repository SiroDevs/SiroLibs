            }
          ]
        },
        {
          "text": "Tanyarata talokaatokus, “Ngitunga kang” ani tanakaatokus tanyarata “Emina Ekapolon Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
