              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akolongit ngina, kanyarae ngesi ayong “Lokile kang” nyeringa nabo kanyarae “Baal kang.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
