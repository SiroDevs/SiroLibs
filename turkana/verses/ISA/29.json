          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idaitae eger angakitoodikinet kadaang ana ngikadwarak. Ekokis akitab na agol emachar. Ani kiyaa iyong nitwaan ni eyeni akisomare tolimok tama, “Kisomakinae pan akitab naga,” elimuni ngesi tama, “Nyapedori ayong akisomakin kainyo egolitoe a emachar.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiyaa iyong nitwaan ni nyeyeni akisomare tolimok tama, “Kisomakinae pan akitab naga,” elimuni ngesi tama, “Nyayeni ayong akisomare.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akigieno na isidiun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Achamakin ka Misiri pas",
          "type": "text"
        }
      ]
    }
