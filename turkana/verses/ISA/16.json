              "type": "text"
            }
          ]
        },
        {
          "text": "Ituburuna ngitunga a Moab pas edokete kidiama akilip, kori elomete nakais kech na ilipeta kainyo nyechamunio ngakilipasinei kech.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
