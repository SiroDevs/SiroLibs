            "sid": "ISA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.5",
            "verseOrgIds": [
              "ISA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanege alomoru alo a Sion, esubakini Akuj Namerikanyer ekimuje a ngibukui kadaang anakwap. Epete ngamuja nakatumak ka emuna loajokon. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.6",
            "verseOrgIds": [
              "ISA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moru lopei ngolo, ngesi elemarea Ekapolon Akuj edou a esinyoi lokolong emukit ngakwapea daang. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.7",
            "verseOrgIds": [
              "ISA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.54"
              },
              "items": [
                {
                  "text": "1 Kor 15:54",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.7.17"
              },
              "items": [
                {
                  "text": "Tood 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.4"
              },
              "items": [
                {
                  "text": "21:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ikisari Ekapolon lo erai Ekapolon Akuj akitu jik! Emiatari ngesi ngakiyo anakonyen a ngitunga kadaang sodi tolema ngileech lu atingito ngitunga keng anakwapea kadaang. Alimu Ekapolon Akuj nguna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.8",
            "verseOrgIds": [
              "ISA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani esubakin ngakiro nguna, elimuni itwaan daang tama, “Akuj kosi naga! Ngesi kolong kidarit kitoyuu. Ngesi erai Ekapolon Akuj! Ngesi kigieno sua. Atalakaros tokona echurokisi kainyo kiyuu ngesi ngoni.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irirae Akuj Moab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.9",
            "verseOrgIds": [
              "ISA.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyoki Ekapolon Akuj emoru lo a Sion, nakaneni ipudao ngitunga a Moab loger a ngatunyeny ana ipudao anawaar a ngibaren. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.10",
            "verseOrgIds": [
              "ISA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itorwaarete kesi ngakan kech tosub esakete akilulumare, nakaneni isurumi Akuj kesi ngileech, kitedepa ekunonoonu a akilulumare. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.25.11",
            "verseOrgIds": [
              "ISA.25.11"
            ]
          }
        },
