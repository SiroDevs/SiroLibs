          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.19",
            "verseOrgIds": [
              "EZR.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarî ya Imeri maarî: Hanani na Zebadia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
