        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarî ya Harimu maarî: Maaseia, Elija, Shemaia, Jehieli, na Uzia.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
