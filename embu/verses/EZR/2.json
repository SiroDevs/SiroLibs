          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbarî ya Pahathi Moabu (aya nî njiarwa cia Jeshua na Joabu) andû ngiri igîrî magana manana ma îkûmi na aîrî (2,812), ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.6",
