          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû a mîvîrîga ya Isiraeli arîa maacokire kuuma îthamîriorî maarî: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.2",
            "verseOrgIds": [
              "EZR.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbarî ya Peroshi andû ngiri igîrî na îgana rîmwe rîa mîrongo mûgwanja na igîrî (2,172), ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.3",
            "verseOrgIds": [
              "EZR.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbarî ya Shefatia magana mathatû ma mîrongo mûgwanja na aîrî (372), ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.4",
            "verseOrgIds": [
              "EZR.2.4"
            ]
          }
        },
        {
