            "style": "v",
            "sid": "EZR 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbarî ya Ara andû magana mûgwanja ma mîrongo mûgwanja na atano (775), ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.5",
            "verseOrgIds": [
              "EZR.2.5"
