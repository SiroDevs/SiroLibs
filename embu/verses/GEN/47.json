              },
              "items": [
                {
                  "text": "50.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kavinda ka Jakovu gûkua gakûvîvîria, nîwetire mûvîcî Josefu na akîmwîra atîrî, “Ethîrwa nie nîmbîtîkîrîkîte nîwe, tonyia njara ciaku gatagatî ga ciaû ciakwa na wîranîre nama atî ndûkanthika Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.29",
            "verseOrgIds": [
              "GEN.47.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 47:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrenda ngaathikwa kûrîa aa vava marî. Ûkaanguua ûndute gûkû Misiri, ûkanthike kûrîa maathikirwe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
    },
