              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Josefu nîwacokirie atîrî, “Nîngeka wata ûrîa wambûria.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
