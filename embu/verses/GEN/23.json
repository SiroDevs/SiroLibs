    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sara nîwakwire na Iburahimu akîgûra vandû va kûmûthika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara nîwatûûrire mîaka îgana rîa mîrongo îrî na mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
              "GEN.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire agîkuîra Heburoni vûrûrirî wa Kanaani, na Iburahimu nîwacakaire nîûndû wa gîkuû gîake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nîwaumire kûu kimba Kîam mûka Sara Kîamrî, akîthiî kûrî Ahiti na akîmeera atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.3",
            "verseOrgIds": [
              "GEN.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.9"
              },
              "items": [
                {
                  "text": "Ahib 11.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.16"
              },
              "items": [
                {
                  "text": "Ciîko 7.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Nie nîrî mûgeni na ndûûraga gûkû kwenyu. Kwoguo menderieni kîthaka nîguo mone vandû nîngîthika Sara mûka wakwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.4",
            "verseOrgIds": [
              "GEN.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Ahiti nîmaamûcokerie atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.5",
            "verseOrgIds": [
              "GEN.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûthuuri ûyû, ta tûthikîrîrie; tue tûonaga ûrî mûtongoria mûnene. Thika mûkaguo mbîrîrarî yetû îrîa mbaro mûno. Gûtirî mûndû wanarî ûmwe gatagatîrî getû ûtangîkûva mbîrîra ya kûthika mûkaguo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.6",
            "verseOrgIds": [
              "GEN.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Iburahimu nîwenamîrîre mbere yao ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.7",
            "verseOrgIds": [
              "GEN.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akiuga atîrî, “Ethîrwa nîmûrenda nthike mûka wakwa ava, namûthaitha mûrie Efironi mûvîcî wa Zohari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.8",
            "verseOrgIds": [
              "GEN.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "aamenderie mbîrîra ya Makipela, îrîa îrî vakuvî na rûtere rwa mûgûnda wake. Mwîreni aamenderie guo wa ûrîa ûngîthîrwa ûkiuma, na nîngûûgûra mue mûrî vo nîguo ngîe na vandû va kûthikanaga.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.9",
            "verseOrgIds": [
              "GEN.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efironi ke mwene meekarîte na Ahiti arîa engî varîa vacemanagîrua kîvingorî Kîam îtûûra rîrîa rînene. Nake nîwacokerie Iburahimu andû acio engî makîgucaga atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.10",
            "verseOrgIds": [
              "GEN.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûthuuri ûyû, tanthikîrîria; Nie nîngûkûva mûgûnda wakwa wonthe wana mbîrîra îrîa îrî kuo. Nîngûva yo mbere ya andû akwa, nîguo ûthike mûkaguo vo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Iburahimu nîwenamîrîrie ûthiû wake mbere ya Ahiti ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.12",
            "verseOrgIds": [
              "GEN.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akîra Efironi andû ake makîgucaga atîrî, “Nakûthaitha ûnthikîrîrie Mûthuuri ûyû; Nie nîngûgûra mûgûnda ûcio wonthe. Rîu amûkîra îrîvi rîakwa nîguo nthiî ngathike mûka wakwa kuo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efironi nîwerire Iburahimu atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.14",
            "verseOrgIds": [
              "GEN.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwathi wakwa, mûgûnda wa sîlûva magana mana nî kîndû kînini mûno gatagatîrî getû nawe? Thika mûkaguo mûgûndarî ûcio.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nîwetîkîrire na akîthimîra Efironi mbeca irîa ke aagwetete andû onthe marî vo. Nacio ciarî sîlûva magana mana ithimîtwe na kîthimi kîrîa kîegucanîrîtwe nî andû arîa magûraga makîendagia indo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.16",
            "verseOrgIds": [
              "GEN.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo mûgûnda ûcio wa Efironi ûrîa warî Makipela, mwena wa îrathîro wa Mamure watuîkire wa Iburahimu. Mûgûnda ûcio warî na ngurunga na warî na mîtî wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahiti onthe arîa maarî kûu mûcemaniorî ûcio nîmaamenyire atî mûgûnda na indo cionthe irîa ciarî kuo nî cia Iburahimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iburahimu nîwacokire akîthika mûka Sara ngurungarî îo yarî mûgûndarî wa Makipela (Heburoni) mwena wa îrathîro wa Mamure vûrûrirî wa Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.19",
            "verseOrgIds": [
              "GEN.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûgûnda ûcio wa Ahiti vamwe na ngurunga îrîa yarî kuo, nîwatuîkire wa Iburahimu wa kûthikanaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.20",
            "verseOrgIds": [
              "GEN.23.20"
            ]
          }
        }
      ]
    }
