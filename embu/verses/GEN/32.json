          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nginya ûmûnthî Aisiraeli matirîcaga nyama ya ngunguro ya nyamû wa yonthe nîûndû nîvo Jakovu aaringirwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
