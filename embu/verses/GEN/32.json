            "caller": "#"
          },
          "items": [
            {
              "text": "32.30",
              "type": "text"
            },
            {
              "text": "Penieli:",
              "type": "text"
            },
            {
              "text": "Rîîtwa rîrî nî ta rîa Kîhibirania rîrîa riugaga “Ûthiû wa Ngai.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
