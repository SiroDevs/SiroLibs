          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûndû ûcio nîwerire Jakovu atîrî, “Tiga nthiî nîûndû kûthiîte gûkîa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        }
      ]
    },
