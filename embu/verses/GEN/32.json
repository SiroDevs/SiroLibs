          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûndû ûcio oonire atî nîakûvootwa nî Jakovu, nîwamûringire ngunguro, nakuo kûgûrû kwa Jakovu gûkîvenûka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
