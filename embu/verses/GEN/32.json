              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakovu nîwaugire atîrî, “Nie nîmonanîte na Ngai ûthiû kwa ûthiû, na nîrî wa mwoyo.” Kwoguo Jakovu nîwetire vandû vau Penieli",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "note",
