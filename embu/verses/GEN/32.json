          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jakovu nîwamûcokerie atîrî, “Ndingîkûrekereria ûthiî ûtandathimîte.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
