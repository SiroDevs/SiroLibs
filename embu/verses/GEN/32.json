          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riûa nîrîarathire Jakovu arî njîrarî aumîte Penieli, na nîwathuaga nîûndû ngunguro yake yarî mvenûku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
