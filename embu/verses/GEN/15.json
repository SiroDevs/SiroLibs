                "loc": "JOB.4.13"
              },
              "items": [
                {
                  "text": "Ayu 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na vîndî îrîa riûa rîathûaga, Aburamu nîwamamire toro mûnene mûno, na akîgîa na guoya na kîmako kînene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.1+EXO.1.2+EXO.1.3+EXO.1.4+EXO.1.5+EXO.1.6+EXO.1.7+EXO.1.8+EXO.1.9+EXO.1.10+EXO.1.11+EXO.1.12+EXO.1.13+EXO.1.14"
              },
              "items": [
                {
                  "text": "Ntha 1.1-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.6"
              },
              "items": [
                {
                  "text": "Ciîko 7.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Ngai-Mûnene nîwerire Aburamu atîrî, “Njiarwa ciaku nîikethîrwa irî ng'eni vûrûrirî mûgeni. Nîigaatuîka ngombo kuo na ivinyîrîrue îvinda rîa mîaka magana mana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.13",
            "verseOrgIds": [
              "GEN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40+EXO.12.41"
              },
              "items": [
                {
                  "text": "Ntha 12.40-41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.7"
              },
              "items": [
                {
                  "text": "Ciîko 7.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî nie nîngaaverithia mavûrûri marîa makaamatua ngombo. Makiuma vûrûrirî ûcio mûgeni, nîmagaakuua ûtonga mwîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.14",
            "verseOrgIds": [
              "GEN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî we nîûgaatûûra mîaka mîngî, na nîûgaakua ûrî na thayû na ûthikwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.15",
            "verseOrgIds": [
              "GEN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiarwa ciaku igaacooka gûkû irî rûciarorî rwa kana, na ndikeengata Aamori arîa matûûraga vûrûrirî ûyû nîûndû îvinda rîao rîa kûverithua rîtikethîrwa rîrî rîkinyu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.16",
            "verseOrgIds": [
              "GEN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa riûa rîathûire na gûgîtuka, mwaki mûnene watogaga ndogo na kîmûrî gîakanîte nîciavîtûkîrîre gatagatîrî ka nyamû icio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.17",
            "verseOrgIds": [
              "GEN.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
