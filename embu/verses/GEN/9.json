              "type": "text"
            }
          ]
        },
        {
          "text": " Ngai nîwarathimire Nuhu na avîcî ake na akîmeera atîrî, “Ciaranani, mwîngîve, na mwîcûrie nthî yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamû cionthe, iconi, nthamaki, nîitûûra imwîtigagîra. Nîmue mûgaciathaga cionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nînamûva nyamû cionthe ituîke irio cienyu, wata ûrîa namûveere mîmera îtuîke irio cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
