          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake nîwamûcokerie atîrî, “Nî nie Esaû mûvîcîguo ûrîa mûkûrû.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
