          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîra Esaû eegwire ûguo nîwarîrire augîrîrîtie na marakara akiugaga “Ûûi Vava, wa nanie ndathima!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Isaka nîwamwîrire atîrî, “Mûrwanyûkwe aûkire amveenia na oca kîrathimo gîaku.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
