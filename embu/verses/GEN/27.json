          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nîwambîrîrie gûtetema mwîrî wonthe na akîûria atîrî, “Nîûrîkû ûragire nyamû na andetere? Nînarîa nyamû îo wa rîu ûtarî ûrakinya na nînamûrathima, na nîatûûra arî mûrathime tene na tene.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        }
      ]
    },
