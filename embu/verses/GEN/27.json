          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Isaka nîwaugire atîrî, “Ndetere nyama ndîe nîguo narîkia kûrîa ngûrathime.” Jakovu nîwamûvirîre nyama, na agîcoka akîmûvirîra ndivei nîguo anyue.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        }
      ]
    },
    {
