            "caller": "#"
          },
          "items": [
            {
              "text": "27.36",
              "type": "text"
            },
            {
              "text": "Jakovu:",
              "type": "text"
            },
            {
              "text": "Rîîtwa rîrî rîguîkaga ta rîa Kîhibirania rîrîa riugaga, “Kûvenania.”",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Nîwocire ûrikithathi wakwa, na rîu nîwoca kîrathimo gîakwa. Vava, ndûnandigarîria kîrathimo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
