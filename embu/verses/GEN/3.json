          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene, Ngai nîwacokire akîra mûndûmûka atîrî, “Nîngaakwongerera mathîna vîndî îrîa yonthe ûkethagîrwa ûrî îvu, na ngwongagîrîre ûrûrû vîndî ya gûciara. Wana kûnekariî ûguo, we ûkeriragîria mûthuuriguo, nake agaakwathaga.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
