          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu eetire mûka Awa nîûndû nîke warî ng'ina wa andû onthe arîa marî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene, Ngai nîwarûthîre Adamu na mûka nguo ya rûûo na akîmekîra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
