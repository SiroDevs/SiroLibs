    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngai nîwamatuîrîre",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
