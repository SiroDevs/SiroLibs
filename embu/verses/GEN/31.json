              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakovu nîwaitire nyamû na akîrutîra Ngai kîgongoona kûu kîrîmarî na agîîta andû ake marîcanîre. Marîkia kûrîa, nîmaararire kûu kîrîmarî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.54",
            "verseOrgIds": [
              "GEN.31.54"
            ]
          }
        },
        {
