          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aa mûrwang'ina na Josefu nîmaathiîre kûgûra irio Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jakovu aamenyire atî Misiri kwarî na irio, nîwaûririe avîcî ake atîrî, “Nîndûî kîratûma mwîkare mûroranîtie mûtagwîka ûndû? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.12"
              },
              "items": [
                {
                  "text": "Ciîko 7.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîregua atî Misiri kûrî na irio; ûkîrani mûthiî kuo mûkagûre irio nîguo tûtigakue nî yûra.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo anake îkûmi arîa maaciaranîrîtue na Josefu nîmaathiîre Misiri kûgûra irio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Jakovu ndetîkîra gûtûma Benjamini mûrwang'ina na Josefu, nîûndû nîwetigagîra avota kwona ûgwati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avîcî a Jakovu, vamwe na andû arîa engî nîmaathiîre kûgûra irio, nîûndû kwarî na yûra vûrûrirî wa Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îo Josefu nîke warî mûnene wa maûndû monthe vûrûrirî wa Misiri na nîke wendagîria andû onthe a vûrûri ûcio irio. Kwoguo aa mûrwang'ina nîmaathiîre mbere yake na magîturumithia mothiû mao nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.6",
            "verseOrgIds": [
              "GEN.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Josefu oonire aa mûrwang'ina nîwamamenyire, nwatî nîwamerigithirie na akîmarîria na rûtûrîko na akîmaûria atîrî, “Mumîte kû?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaacokirie atîrî, “Tumîte vûrûrirî wa Kanaani na tûkîte kûgûra irio.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana ethîrwa Josefu nîwamenyire aa mûrwang'ina, o matiamûmenyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.8",
            "verseOrgIds": [
              "GEN.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.5+GEN.37.6+GEN.37.7+GEN.37.8+GEN.37.9+GEN.37.10"
              },
              "items": [
                {
                  "text": "Kîam 37.5-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîwaririkanire iroto irîa aarotete imegiî na akîmera atîrî, “Mue mûrî athigani na mûkîte gûtuîria nîguo mwone varîa vûrûri wetû ûtarî na vinya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaacokirie atîrî, “Naarî mwathi wetû. Tûkîte kûgûra irio twîkariî ta ngombo ciaku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.10",
            "verseOrgIds": [
              "GEN.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuonthe tûrî a îthe ûmwe na tûrî andû evokeku. Mwathi wetû, tûtirî athigani.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Josefu nîwamerire atîrî, “Naarî! Mûkîte gûtuîria mwone varîa vûrûri wetû ûtarî na vinya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaamwîrire atîrî, “Mwathi wetû, tue tûrî anake îkûmi na aîrî, tûrî a mûthuuri ûmwe wa vûrûri wa Kanaani. Mûrwaiya ûrîa mûnini matigirwe marî na vava mûciî na ûmwe ndarî vo nîwakwire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu nîwamerire wa rîngî atîrî, “Mue mûrî athigani wata ûrîa nîmwîrire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.14",
            "verseOrgIds": [
              "GEN.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûndû ûcio nîguo mûkaagerua naguo. Nîngwîvîta na rîîtwa rîa mûthamaki wa Misiri atî mûtingiuma gûkû mûrwanyûkwe ûrîa mûnini atarî gûkû. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.15",
            "verseOrgIds": [
              "GEN.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûmani ûmwe wenyu athiî akamûgîre. Nao acio engî matigwe marangîrîtwe nginya rîrîa ûma wa ûvoro ûcio mûraria ûkaamenyekana waro. Ethîrwa tîguo, nînîvîta na rîîtwa rîa mûthamaki wa Misiri atî mue mûrî athigani.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu nîwacokire akîmavingîrithia onthe njeera îvinda rîa mîthenya îthatû.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa kathatû Josefu nîwamerire atîrî, “Nie nîrî mûndû wîtigîrîte Ngai, kwoguo nîmûgûtûûra mwoyo mweka ûndû ûyû ûmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûrî andû evokeku, ûmwe wenyu nîagûtigwa njeera gûkû mûrî, nao acio engî mathiî mavirîre andû enyu arîa marî na yûra irio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûcoke mûndetere mûrwanyûkwe ûrîa mûnini. Ûndû ûcio ûkoonania atî ûvoro ûcio mwarîtie nî wa ma, na tînîmûragithia.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmeetîkîre ûvoro ûcio, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makîrana atîrî, “Nî ma tûrathînîka nîûndû wa maûndû marîa twekire mûrwaiya. Nîtwonire arî na thîna nyîngî na agîtûthaitha tûmûtethie tûkîrega. Kîu nîkîo gîtûmîte twîthîrwe tûrî na thîna ûyû rîu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        },
        {
          "name": "verse",
