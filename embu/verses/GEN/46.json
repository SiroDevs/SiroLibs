              },
              "items": [
                {
                  "text": "Ciîko 7.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Josefu aarî na avîcî aîrî arîa aagîte nao arî Misiri. Kwoguo andû onthe a Jakovu arîa maathiîre Misiri maarî mîrongo mûgwanja (70).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakovu na andû a mûciî wake marî Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
