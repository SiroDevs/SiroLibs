              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akîra Jakovu atîrî, “Tanûmia tûirio tûu twaku tûtune nîûndû nîrî mûvûtu.” (Kîu nîkîo gîatûmire etwa Edomu).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
