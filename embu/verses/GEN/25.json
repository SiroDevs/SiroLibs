          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa tûvîcî tûu tuoîrî twakûrire, Esaû nîwatuîkire mûguîmi mwaro, kwoguo aatindaga kîthakarî. Nwatî Jakovu aarî mûkiri na kwoguo aatindaga mûciî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka nîwendete Esaû nîûndû nîwakenaga akîrîa nyama cia nyamû irîa Esaû aaûragaga, nwatî Rebeka eendete Jakovu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
