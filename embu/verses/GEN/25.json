          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jakovu nîwamwîrire atîrî, “Mbere nwa wambire kûmenderie ûrikithathi waku.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
