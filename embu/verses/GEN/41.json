              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîaka mûgwanja ya maketha vûrûrirî wa Misiri nîyathirire. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
