          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû kuuma nthî yonthe nîmaathiîcaga Misiri kûrî Josefu kûgûra irio nîûndû kwarî na yûra înene nthî yonthe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
            "verseOrgIds": [
              "GEN.41.57"
            ]
