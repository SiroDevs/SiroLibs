      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.10",
            "verseOrgIds": [
              "HEB.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîke ûtûmaga andû matherue mevia. Ke vamwe na arîa matuîtwe atheru nî a îthe ûmwe. Kwoguo Jesû ndegucaga nthoni akîmeta ariû na aarî a îthe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.22.22"
              },
              "items": [
                {
                  "text": "Tha 22.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ke eraga Ngai atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.12",
            "verseOrgIds": [
              "HEB.2.12"
            ]
          }
        }
