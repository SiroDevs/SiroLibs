              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Na njîra wata îo, Kristû wa nake ndeetîkîra kwînenevia nîûndû atî aarî Mûthînjîri-Ngai ûrîa mûnene. Vandû va ûguo, Ngai aamwîrire atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
