            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue mûtikinyîte vandû mûngîvutia ta ûrîa andû a Isiraeli maakinyire kîrîmarî gîa Sinai kîrîa gîaakanaga mwaki mûnene kûrî na nduma nene na rûkûngi rûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtirî mûregua mûgambo wa karumbeta na mûgambo ûkiugîrîria. Rîrîa andû a Isiraeli meegwire mûgambo ûcio, nîmaaugire matikwenda kwîgua mûgambo wîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
