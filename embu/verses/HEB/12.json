                "loc": "GEN.4.10"
              },
              "items": [
                {
                  "text": "Kîam 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmûkîte kûrî Jesû ûrîa mwîgwithania wa kîrîkanîro kîrîa gîcerû, na kûrî nthakame yake îrîa yetûrûrirwe. Nthakame îo nî îranagîra maûndû maro gûkîra ya Abili.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.24",
            "verseOrgIds": [
              "HEB.12.24"
            ]
          }
        }
