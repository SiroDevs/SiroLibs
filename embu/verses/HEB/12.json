                "loc": "ISA.35.3"
              },
              "items": [
                {
                  "text": "Isa 35.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwoguo ûkîrîriani njara cienyu na îgûrû icio nogu na mûkûnjûre maru mau menyu maratetema. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Nthi 4.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Thiîrîrani njîrarî nûngarû nîguo kûgûrû kûrîa kwonju gûtikagonyoke, vandû va ûguo kûvonue.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
