                  "text": "Gûco 9.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûrîa andû moonire nîwatûmire manyitwe nî guoya mûno, nake Musa nîwaugire atîrî, “Nînîrainaina na ngetigîra!”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.21",
