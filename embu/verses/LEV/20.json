              },
              "items": [
                {
                  "text": "Gûco 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme angîkaamenyana kîîmwîrî na mûka wa mûndû ûrîa wîngî, mûndûmûrûme ûcio wana mûndûmûka ûcio nîmakaaûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.8"
              },
              "items": [
                {
                  "text": "Ala 18.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Gûco 22.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme ûrîa ûkaamenyana kîîmwîrî na ûmwe wa aka a îthe, nîagaaconorithia îthe. Mûndûmûrûme ûcio na mûndûmûka ûcio nîmakaaûragwa. Ikuû cia andû acio oîrî ikaaumana na gîîko Kîamo o ene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Ala 18.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme angîkaamenyana kîîmwîrî na mûka wa mûvîcî, andû acio wa oîrî nîmakaaûragwa. Andû acio nîmamenyanîte kîîmwîrî marî a nthakame îmwe, na ikuû ciao ikaaumana na gîîko Kîamo o ene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Ala 18.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme angîkaamenyana kîîmwîrî na mûndûmûrûme wîngî, andû acio oîrî makethîrwa mekîte ûndû mûcûku, nao oîrî nîmakaaûragwa. Ikuû ciao ikaaumana na gîîko Kîamo o ene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.17"
              },
              "items": [
                {
                  "text": "Ala 18.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Gûco 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme angîkaavikia mwîrîtu na avikie ng'ina wa mwîrîtu ûcio, andû acio wa o athatû nîmakaavîvua makue, nîûndû wa ûndû ûcio mûcûku makethîrwa mekîte. Ûndû ta ûcio ndwagîrîrwe nî gwîkîka gatagatîrî kenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
