              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Gûco 27.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndûmûrûme angîkaamenya nyamû kîîmwîrî, mûndû ûcio nî akaaûragwa, wana nyamû îo nîkaaûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûka angîkaamenya nyamû kîîmwîrî, mûndûmûka ûcio nî akaaûragwa, wana nyamû îo nîkaaûragwa. Gîkuû Kîam mûndûmûka ûcio wana Kîam nyamû îo gîkaaumana na ciîko icio.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
