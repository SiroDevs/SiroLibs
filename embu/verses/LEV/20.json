          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûrûme angîkaamenyana kîîmwîrî na mûka wa mamawe, kûu nî gûconorithia mamawe. Andû acio wa oîrî nîmakaaverithua nîûndû wa mevia mao, na gûtirî wanarî ûmwe wa ciao ûkaagîa na njiarwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
            "verseOrgIds": [
              "LEV.20.20"
            ]
          }
        },
        {
          "name": "verse",
