          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.19"
              },
              "items": [
                {
                  "text": "Ntha 22.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.23"
              },
              "items": [
                {
                  "text": "Ala 18.23",
