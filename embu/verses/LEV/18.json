                "loc": "LEV.20.18"
              },
              "items": [
                {
                  "text": "Ala 20.18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mûtikamenyane kîîmwîrî na mûndûmûka vîndî îrîa arî îvindarî rîake rîa mweri, nîûndû vîndî îo ndethagîrwa arî mûtheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.19",
            "verseOrgIds": [
              "LEV.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.10"
              },
              "items": [
                {
                  "text": "Ala 20.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûtikamenyane kîîmwîrî na mûka wa mûndû wîngî; ûndû ûcio nwa ûtûme we wîthîrwe ûtarî mûtheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.20",
            "verseOrgIds": [
              "LEV.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.1+LEV.20.2+LEV.20.3+LEV.20.4+LEV.20.5"
              },
              "items": [
                {
                  "text": "Ala 20.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûtikanenganîre ciana cienyu ciamûrîrwe ngai îrîa îtagwa Moleku, na mwaki, nîûndû kûu nî gûconorithia rîîtwa rîa Ngai-Mûnene, Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.21",
            "verseOrgIds": [
              "LEV.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
