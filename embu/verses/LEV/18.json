              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.1",
            "verseOrgIds": [
              "LEV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ere andû a Isiraeli atîrî, “Nie nînie Ngai-Mûnene, Ngai wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
              "LEV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigekage ta ûrîa andû a Misiri, kûrîa mwatûûraga meekaga, kana mwîka ta andû a vûrûri wa Kanaani, kûrîa ngûmûvira. Mûtikarûmîrîre mawatho mao. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.3",
            "verseOrgIds": [
              "LEV.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîrîrani mawatho makwa na mwîkage ûrîa maugîte. Nie nînie Ngai-Mûnene, Ngai wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.4",
            "verseOrgIds": [
              "LEV.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
