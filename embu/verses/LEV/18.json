              "items": [
                {
                  "text": "Ala 20.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûtikamenyane kîîmwîrî na mûka wa mûrwanyûkwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
              "LEV.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.14"
              },
              "items": [
                {
                  "text": "Ala 20.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Gûco 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ethîrwa mwanamenyana kîîmwîrî na mûndûmûka wa wonthe, mûtikamenyane kîîmwîrî na mwîrîtu wake kana mwana wa mwîrîtu wake; acio nî andû a mûciî wenyu, na ûcio nî mûtugo mûcûku. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtikavikie aa mwarwang'ina na aka enyu îvinda rîrîa rîonthe aka enyu marî mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.18",
            "verseOrgIds": [
              "LEV.18.18"
            ]
          }
        }
      ]
