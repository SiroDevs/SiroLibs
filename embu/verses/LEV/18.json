              "LEV.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwoguo rûmagîrîrani mawatho marîa nîmûvete na mûtikagîe na mîtugo mîcûku ta îrîa yarî na andû arîa maatûûraga vûrûrirî ûcio mbere yenyu, kana mwîvaka gîko mûkîmîka. Nie nînie Ngai-Mûnene, Ngai wenyu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.30",
            "verseOrgIds": [
              "LEV.18.30"
            ]
          }
        }
