          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa nguo îrî na gîko kiumanîte na mûrimû mûcûku wa ngothi wana yethîrwa îrî ya guoya, nguo ndaca, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
