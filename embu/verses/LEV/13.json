          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndûmûrûme angîthira njuîrî kîongo agîe na kîvara, ethagîrwa arî mûtheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
