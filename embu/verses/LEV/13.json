          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûthînjîri-Ngai nîakaauga atî mûndû ûcio tî mûtheru nîûndû wa mûrimû mûcûku wa ngothi ûcio ûrî kîongorî gîake.",
          "type": "text",
