          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa mûndûmûrûme kana mûndûmûka agîa na kûndû kûthererûku ngothirî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
