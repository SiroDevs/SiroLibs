          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "nguo ya gîtambaa Kîam guoya, rûûo kana kîndû wa kîonthe gîtumîtwe na rûûo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.48",
            "verseOrgIds": [
              "LEV.13.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "ethîrwa gîko kîu gîkîonania rangi ya mathangû kana îno ndune, kîu nî gîko kiumanîte na mûrimû mûcûku wa ngothi na nwanginya îkoonanua kûrî mûthînjîri-Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.49",
            "verseOrgIds": [
              "LEV.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaaroria kîndû kîu kîgwatîtwe nî gîko kîu na akige kîrî kîonga îvinda rîa mîthenya mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîagaacoka arorie kîndû kîu mûthenya wa mûgwanja, na ethîrwa gîko kîu kîrî kîongerereku, kîu nî gîko kiumanîte na mûrimû mûcûku wa ngothi, na nguo îo tî ntheru. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaavîvia nguo îo nîûndû kîu nî gîko kiumanîte na mûrimû mûcûku wa ngothi na gîtingîthira nwa kîthirirue na mwaki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.52",
            "verseOrgIds": [
              "LEV.13.52"
            ]
          }
        }
      ]
