                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîwerire andû a Isiraeli atîrî, “Mûtikerûthîre ngai cia mîvuanano kana mûvuanano wa îthiga rîrî riumie atî nîguo mûigoocage. Nie nînie Ngai-Mûnene, Ngai wenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîrîrani mîthenya yakwa ya thavatû na mûtîîage vandû varîa ngoocagîrwa. Nie nînie Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
