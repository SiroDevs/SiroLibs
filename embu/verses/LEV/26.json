        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa mûkethîrwa mûrî mavûrûrirî ma nthû cienyu, mîgûnda yenyu nîkaavurûka na îkûngûîre thavatû irîa mûtaakûngûagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa rîonthe vûrûri wenyu ûka ethîrwa ûrî îganjo nîûkaavurûka, nîûndû ndwavurûkaga kavinda karîa mwatûûraga kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngaatûma andû enyu arîa marî îthamîriorî mecûrwe nî guoya nginya mamakague nî mûgambo wa îthangû rîkinainua nî rûkûngi. Mûkaaûraga takwa mûvinyûrîtue mûkîûrîra mbaara, na mûkaagûcaga wana gûtarî nthû imûvinyûrîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûkaavîngîcanaga mue ene takwa mûrîte mûtikaûragwe vîndî îrîa gûtarî mûndû ûmûvinyûrîtie, na mûtikaavota kûrûa na nthû cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthiiarî mûgaakuîra îthamîriorî na mûthikwe kûu vûrûrirî wa nthû cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû enyu anini arîa magaatigara nî makoorera mavûrûrirî ma nthû cienyu nîûndû wa mevia mao na mevia ma methe mao.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
