              "LEV.9.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.22+NUM.6.23+NUM.6.24+NUM.6.25+NUM.6.26"
              },
              "items": [
                {
                  "text": "Nda 6.22-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa Aroni aarîkirie kûruta magongoona monthe, nîwaûkîrîrie njara ciake erekerete andû na akîmarathima. Nîwacokire akiuma varîa metha ya kîgongoona yarî. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Aroni nîmaatonyire îgemarî rîa Ngai-Mûnene, na rîrîa maaumire kuo, nîmaarathimire andû naguo riiri wa Ngai-Mûnene nîwaumîrîre andû onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.23",
            "verseOrgIds": [
              "LEV.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
