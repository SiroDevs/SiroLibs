              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwaugire atîrî, “Menyagîrîrani Maathani makwa. Nie nînie Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigaconorithie rîîtwa rîakwa rîtheru. Andû onthe a Isiraeli nwanginya mandîîage nîûndû nîrî mûtheru. Nie nînie Ngai-Mûnene, ûrîa ûmûtheragia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nînie naamûrutire vûrûri wa Misiri nîguo nduîke Ngai wenyu. Nie nînie Ngai-Mûnene.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        }
      ]
