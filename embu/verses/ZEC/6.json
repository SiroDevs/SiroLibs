          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Andû arîa matûûraga kûraca nîmagaûka na matethererie gûtuma hekarû ya Ngai-Mûnene. Namue nîmûkaamenya atî Ngai-Mûnene mwene vinya wonthe nîke ûndûmîte kûrî mue. Maûndû mau monthe makavinga ethîrwa nîmûkaathîkîra Ngai-Mûnene Ngai wenyu.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
          }
        }
      ]
    }
