              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a mûvîrîga wa Benjamini wanao maatûûraga kuuma Geba kûthiî na mbere, Mikimashi, Aija, Betheli na icagi cia rîo, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
