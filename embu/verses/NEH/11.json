          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pethahia mûvîcî wa Meshezabeli wa mbarî ya Zera mûvîcî wa Juda nîke warî mwarîrîria wa mûthamaki maûndûrî monthe megiî andû a Juda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
