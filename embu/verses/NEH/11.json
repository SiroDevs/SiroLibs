              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikundi imwe cia Alawi irîa ciatûûraga vûrûrirî wa Juda nîmaatukanîrwe vamwe na andû a Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
