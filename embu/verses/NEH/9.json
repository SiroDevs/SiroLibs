            "number": "38",
            "style": "v",
            "sid": "NEH 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû wa maûndû monthe marîa mekîkîte, nîtwathondeka kîrîkanîro kîrûmu na twandîkanîra. Nao atongoria etû, Alawi, athînjîri-Ngai wetû nîmekîra mîvûri yao kîrîkanîrorî kîu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.38",
            "verseOrgIds": [
              "NEH.9.38"
            ]
          }
        }
      ]
