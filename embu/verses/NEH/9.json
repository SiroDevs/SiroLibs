          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezira nîwavoire akiuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.9.6",
            "verseOrgIds": [
              "NEH.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9.6",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe matirî ‘Ezira nîwavoire akiuga atîrî.’",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andû a Isiraeli nîmaathondekire kîrîkanîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
