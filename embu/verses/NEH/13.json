            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînaamatheririe kuuma kûrî ûndû wonthe mûgeni. Nînagaaire mawîra ma athînjîri-Ngai na Alawi, wa mûndû ngîmûgaîra wîra wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.30",
            "verseOrgIds": [
              "NEH.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînavangire ûrîa ngû ikaaretagwa mavinda marîa maagîrîru, na matega ma matunda ma mbere vîndî îrîa matunîva.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.31",
            "verseOrgIds": [
              "NEH.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndirikana we Ngai wakwa, nîûndû wa maûndû mau monthe.",
          "type": "text",
          "attrs": {
