            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ûmwe wa avîcî a Jehoiada, mûvîcî wa Eliashibu, Mûthînjîri-Ngai mûnene aavikîtie mwîrîtu wa Sanibalati. Sanibalati aarî wa kuuma Horoni. Kwoguo nînengatire Jehoiada aume Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.28",
            "verseOrgIds": [
              "NEH.13.28"
            ]
