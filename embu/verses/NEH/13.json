          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndirikana Ngai wakwa. Ndûkariganîrwe nî maûndû maro marîa mbîkîte nîûndû wa nyomba yaku na ûtungata waku.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.14",
            "verseOrgIds": [
              "NEH.13.14"
            ]
          }
        }
      ]
