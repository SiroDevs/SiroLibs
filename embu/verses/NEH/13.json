            "verseOrgIds": [
              "NEH.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai wakwa, ririkana andû acio nîûndû nîmagwatîtie ûthînjîri-Ngai mûgiro wa vamwe na kîrîkanîro Kîam ûthînjîri Ngai na Kîam Alawi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.13.29",
            "verseOrgIds": [
              "NEH.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
