          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ateri, Hezekia, Azuru, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.17",
            "verseOrgIds": [
              "NEH.10.17"
