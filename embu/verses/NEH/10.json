          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelatia, Hanani, Anaia, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.22",
            "verseOrgIds": [
              "NEH.10.22"
            ]
