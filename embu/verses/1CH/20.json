            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.4+1SA.17.5+1SA.17.6+1SA.17.7"
              },
              "items": [
                {
                  "text": "1Sam 17.4-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nîkwagîre mbaara rîngî na Afilisiti. Nake Elihanani mûvîcî wa Jairi nîwaûragire Lahimi mûrwang'ina na Goliathu ûrîa warî wa kuuma Gathu. Mûtî wa îtumû rîa Goliathu wegana ta mûtî mûtungu ûrîa wovagîrîrwa ndigi cia gûtuma nguo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaara îngî nîyagîre kuo Gathu vîndî kwarî na mûndû mûnene mûno warî na njara yarî na ciara ithathatû wa njara. Namo magûrû, wa kûgûrû kwarî na ciara ithathatû. Cionthe ciarî ciara mîrongo îîrî na inya (24) na aarî wa njiarwa cia andû a tene arîa maarî anene mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.6",
            "verseOrgIds": [
              "1CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa aaririe ûndû ûtaarî mwaro wîgiî andû a Isiraeli, Jonathani mûvîcî wa Shimea mûrwang'ina na Daudi nîwamûragire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû acio maarî njiarwa cia andû arîa maarî anene mûno a kuuma Gathu, maaûragirwe nî Daudi na ndungata ciake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
          }
        }
      ]
    }
