                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.3+GEN.49.4"
              },
              "items": [
                {
                  "text": "49.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ino nîcio njiarwa cia Reubeni îrikithathi rîa Isiraeli. (Reubeni nîwamenyanire kîîmwîrî na mûka ûmwe wa îthe wa kwiga, kwoguo îgai rîrîa aagîrîrwe nî kûvewa arî ke îrikithathi nîwacunirwe na nîrîaverwe avîcî a Josefu. Josefu aarî mûvîcî wa Isiraeli. Nîûndû wa ûguo mûtaratararî wa avîcî a Isiraeli, Reubeni tîke wa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.8+GEN.49.9+GEN.49.10"
              },
              "items": [
                {
                  "text": "Kîam 49.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Juda nîke wagîre vinya gatagatî ka aa mûrwang'ina acio engî, na mûthamaki aaumire mûvîrîgarî ûcio. Nwatî maûndû marîa maagîrîrwe kwîthîrwa marî ma Reubeni ma ûrikithathi maaverwe avîcî a Josefu.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.2",
            "verseOrgIds": [
              "1CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni îrikithathi rîa Isiraeli aarî na avîcî ana. Marîîtwa mao maarî: Hanoku, Palu, Hezironi na Karimi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.3",
            "verseOrgIds": [
              "1CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avîcî a Joeli maarî; Shemaia, Gogu mûvîcî wa Shemaia, Shimei mûvîcî wa Gogu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.4",
            "verseOrgIds": [
              "1CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemei aarî îthe wa Mika, Mika aarî îthe wa Reaia, Reaia aarî îthe wa Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.5",
            "verseOrgIds": [
              "1CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.29"
              },
              "items": [
                {
                  "text": "2Atha 15.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Beera aarî mûvîcî wa Baali na aarî mûtongoria wa mûvîrîga wa Reubeni. Tigilathi Pileseri mûthamaki wa Asîria nîwarûire na Beera, akîmûnyita na akîmûvira îthamîriorî.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.6",
            "verseOrgIds": [
              "1CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûyû nî mûtaratara wa atongoria a mbarî cia mûvîrîga wa Reubeni ta ûrîa maandîkirwe marûmanîrîrîte na njiarwa ciao. Wa mbere nî Jeieli, Zakaria, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.7",
            "verseOrgIds": [
              "1CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela mûvîcî wa Azazi, Azazi mûvîcî wa Shema wa mbarî ya Joeli, arîa maatûûraga Aroeri kûthiî nginya Nebo mwena wa rûgûrû na nginya Baali Meoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.8",
            "verseOrgIds": [
              "1CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû aya nwa matûûraga na mwena wa îrathîro nginya rûtere rwa werû vakuvî na rûnjî rwa Farati nîûndû maarî na indo nyîngî cia kûrîthia irîa ciongererekete marî vûrûrirî wa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.9",
            "verseOrgIds": [
              "1CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî ya Mûthamaki Saûlo mûvîrîga wa Reubeni nîwarûire na andû a Hagiri na makîmavoota. Mûvîrîga wa Reubeni nîwatûûrire vûrûrirî ûrîa watûûragwa nî andû acio ûrîa ûrî mwena wa îrathîro wa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njiarwa cia Gadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.10",
            "verseOrgIds": [
              "1CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîrîga wa Gadi watûûraga vûrûrirî wa Bashani kûthiî nginya Seleka mwena wa îrathîro. Maariganîtie na andû a mûvîrîga wa Reubeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.11",
            "verseOrgIds": [
              "1CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joeli nîke warî mûtongoria wao na wa kaîrî aarî Shafamu. Nao Janai na Shafati nîo maarî atongoria a mbarî icio ciîngî vûrûrirî wa Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.12",
            "verseOrgIds": [
              "1CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû acio engî a mûvîrîga wa Gadi maarî a kuuma kûrî mbarî ciîngî mûgwanja. Marîîtwa ma mbarî icio nî: Mikaeli, Meshulamu, Sheba, Jorai, Jakani, Zia, na Eberi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.13",
            "verseOrgIds": [
              "1CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya nîo maarî njiarwa cia Abihaili mûvîcî wa Huri, Huri aarî mûvîcî wa Jaroa, Jaroa aarî mûvîcî wa Gileadi, Gileadi aarî mûvîcî wa Mikaeli, Mikaeli aarî mûvîcî wa Jeshishai, Jeshishai aarî mûvîcî wa Jahido, Jahido aarî mûvîcî wa Buzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.14",
            "verseOrgIds": [
              "1CH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahi aarî mûvîcî wa Abudieli, Abudieli aarî mûvîcî wa Guni. Ahi nîke warî mûtongoria wa mbarî ciao, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.15",
            "verseOrgIds": [
              "1CH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nao maatûûraga vûrûrirî wa Gileadi, vûrûrirî wa Bashani na matûûrarî ma kuo na Sharoni vûrûrirî ûrîa mwaraganu wa kûrîthia nginya mîvakarî yaguo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.16",
            "verseOrgIds": [
              "1CH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû aya onthe maandîkirwe mûtaratararî wa njiarwa cia Gadi vîndî îrîa Jothamu aarî mûthamaki wa Juda, nake Jeroboamu arî mûthamaki wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Athigari a mbaara a mîvîrîga ya mwena wa îrathîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.17",
            "verseOrgIds": [
              "1CH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîvîrîgarî ya Reubeni, Gadi na Manase ya mwena wa îrathîro kwarî na athigari a mbaara arîa maaicî kûrûa magîtûmagîra ngo, mviû, na mota. Athigari acio onthe maarî ngiri mîrongo îna na inya, na magana mûgwanja ma mîrongo îtandatû (44,760). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.18",
            "verseOrgIds": [
              "1CH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaarûire mbaara na mûvîrîga wa Hagiri, Jeturi, Nafishi na Nodabu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.19",
            "verseOrgIds": [
              "1CH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaaigire mwîvoko wao kûrî Ngai na makîmûvoya amatethie. Nake Ngai nîwegwire mavoya mao na nîwamatethirie makîvoota andû a Hagiri vamwe na andû arîa maarî ngwatanîro nao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.20",
            "verseOrgIds": [
              "1CH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaatavire nyamû cia kûrîthua kuuma kûrî nthû ciao. Nacio ciarî: ngamîîra 50,000, ng'ondu 250,000 na mvunda 2,000 na andû 100,000 marî mîgwate. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.21",
            "verseOrgIds": [
              "1CH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaaûragire andû a Hagiri eengî nîûndû nîmaatethagua mbaararî nî Ngai. Nao nîmaatûûrire vûrûrirî ûcio nginya rîrîa maavirirwe îthamîriorî.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.22",
            "verseOrgIds": [
              "1CH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andû a Manase ya mwena wa îrathîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
