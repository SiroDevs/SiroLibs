          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongoria a mbarî ciao maarî: Eferi, Ishi, Elieli, Azirieli, Jeremia, Hodavia na Jahidieli. Maarî andû marî îgweta na njamba cia mbaara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.24",
            "verseOrgIds": [
              "1CH.5.24"
            ]
          }
        }
      ]
