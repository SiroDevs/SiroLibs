            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efiraimu aarî na mûvîcî wetagwa Shuthela. Mûvîcî wa Shuthela eetagwa Beredi, mûvîcî wa Beredi eetagwa Tahathi, mûvîcî wa Tahathi eetagwa Eleadi. Mûvîcî wa Eleadi eetagwa Tahathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîcî wa Tahathi eetagwa Zabadi, mûvîcî wa Zabadi eetagwa Shuthela. Efiraimu aarî na avîcî engî aîrî meetagwa, Ezeri na Eleadi. Ezeri na Eleadi nîmaaûragîtwe nî andû arîa maatûûraga Gathu mathiî kwîa ndîthia ciao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îthe wao Efiraimu nîwamacakaîre îvinda rîa mîthenya mîngî na andû ao nîmaaûkire kûmûmîrîria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efiraimu nîwamenyanire kîîmwîrî na mûka rîngî na agîciara mûvîcî ûrîa maatuîrîre rîîtwa Beria",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.23",
              "type": "text"
            },
            {
              "text": "Beria:",
              "type": "text"
            },
            {
              "text": "Rîîtwa rîîrî nîta rîa Kîhibirania rîrîa riugaga thîna.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", nîûndû wa mathîna marîa maaûkîte kwao mûciî.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
