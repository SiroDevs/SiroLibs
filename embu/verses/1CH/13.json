    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îthandûkû rîa kîrîkanîro nîrîarutirwe Kiriathi-jearimu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwaranîrie na anene a athigari ngiri, îgana na mûndû wa wonthe warî mûtongoria. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire akîra andû onthe a Isiraeli arîa maagomanîte atîrî, “Ethîrwa nîmûkwona kwagîrîrîte na wîthîrwe nîguo wendi wa Ngai-Mûnene, Ngai wetû, tigani tûtûme anjaama kûrî andû etû arîa engî marî vûrûrirî wonthe wa Isiraeli. Na tûtûme anjaama kûrî athînjîri-Ngai na Alawi arîa marî matûûrarî marîa marî na kûndû gwa kûrîthua tûgomane vamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûcoke tûthiî tûgîre îthandûkû rîa kîrîkanîro Kîam Ngai wetû rîcoke kûrî tue. Nîûndû nîtwarîtiganîrie vîndî îrîa Saûlo aarî mûthamaki.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû onthe nîmeetîkanirie na Daudi nîûndû nîmoonire ûguo arî guo kwagîrîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
