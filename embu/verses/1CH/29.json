      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaacokire magîtua Solomoni mûvîcî wa Daudi mûthamaki riita rîa kaîrî. Nîmeetîrîrie Solomoni maguta mbere ya Ngai-Mûnene makîmûtua mwathi wao na Zadoku agîtuîka mûthînjîri-Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Solomoni nîwekarîre gîtî Kîam ûthamaki wa Ngai-Mûnene na agîtuîka mûthamaki vuva wa îthe Daudi. Ûthamaki wake nîwevandire na andû onthe a Isiraeli nîmaamwathîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene onthe, andû arîa maarî vinya na andû onthe a mûthamaki Daudi nîmeranîre atî makaathîkagîra mûthamaki Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwatûmire Solomoni avewa gîtîîo mûno nî andû onthe a Isiraeli, na agîtûma agîa ngumo mûno gûkîra athamaki arîa maarî mbere yake vûrûrirî wa Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûthamaki wa Daudi na njîra nguvî",
          "type": "text"
        }
      ]
    },
