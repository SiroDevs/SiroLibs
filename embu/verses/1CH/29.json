          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi mûvîcî wa Jesii aarî mûthamaki wa vûrûri wonthe wa Isiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
