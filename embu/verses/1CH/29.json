              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.5"
              },
              "items": [
                {
                  "text": "1Maû 22.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûthamaki Daudi nîwacokire akîra andû onthe arîa maagomanîte atîrî, “Mûvîcîwa Solomoni ûrîa Ngai athuurîte, nî mûndû mwîthî na ndarî na kîrîra kîîngî na wîra nî mûnene nîûndû nyomba îno tî ya mûndû, nwatî nî hekarû ya Ngai-Mûnene, Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngeretie wata ûrîa nîngîvota kûvarîria indo cia gûtuma hekarû ya Ngai. Indo icio nîta: Thaavu nîûndû wa indo cia thaavu, sîlûva nîûndû wa indo cia sîlûva, gîcango nîûndû wa indo cia gîcango, cuuma nîûndû wa indo cia cuuma, na mbaû nîûndû wa indo cia mbaû. Nîmvecanîte mathiga meengî ma goro metagwa onigithi, mathiga ma kûgemia, mathiga ma rangi cia mîthemba mîîngî, mathiga ma goro ma mîthemba yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma mûthithûrî wakwa nie mwene nîmvecanîte thaavu na sîlûva nîûndû wa wendo ûrîa nîrî naguo wa hekarû ya Ngai wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmvecanîte taranda ngiri ithatû (3,000) cia thaavu ya Ofiri, taranda ngiri mûgwanja (7,000) cia sîlûva cia kûgemia nthingo cia hekarû, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.4",
            "verseOrgIds": [
              "1CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na cia indo cia thaavu na cia sîlûva irîa ikaarûthwa nî andû arîa marî wara wa kûirûtha. Rîu nîûrîkû wîvarîrîtie kwîvecana kûrî Ngai-Mûnene arute indo ciake ûmûnthî na njîra ya kwîyendera?”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongoria a mbarî, anene a mîvîrîga, anene a athigari ngiri a mbaara, magana na arûngamîrîri a wîra wa mûthamaki nîmaarutire indo ciao na njîra ya kwîyendera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaarutire indo cia gûtuma hekarû makîria ma tani îgana rîa mîrongo mûgwanja (170) cia thaavu, tani magana mathatû ma mîrongo îna (340) cia sîlûva, na tani magana matandatû ma mîrongo îîrî (620) cia gîcango, na makîria ma tani ngiri ithatû na magana mana (3,400) cia cuuma. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao arîa maarî na mathiga ma goro nîmaarutire nîguo maigwe mûthithûrî wa hekarû ûrîa wamenyagîrîrwa nî Jehieli wa mbarî ya Gerishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû nîmaakenire nîûndû wa ûrîa andû maarutire indo na njîra ya kwîyendera. Mûthamaki Daudi wanake nîwakenire mûno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi nîwakumirie Ngai-Mûnene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwakumirie Ngai-Mûnene arî mbere ya andû onthe arîa maagomanîte akiuga atîrî, “Ûrokumua we Ngai-Mûnene, Ngai wa Isiraeli îthe wetû! ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.13"
              },
              "items": [
                {
                  "text": "Mat 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûnene, vinya, riiri, ûvootani na gîtîîo nî ciaku we Ngai-Mûnene. Îgûrû na nthî na indo cionthe irîa irî kuo, nî ciaku nîûndû ûthamaki nî waku we Ngai-Mûnene, na nîwe mûnene gûkîra anene onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtonga na gîtîîo ciumaga kûrî we, nîûndû we nîwe mwathi wa indo cionthe. We ûrî na vinya na ûvoti wa gûtûma mûndû atuîke mûnene na ûrî vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu, Ngai wetû, nîtûgûgûcokeria ngatho na nîtûgûkumia rîîtwa rîaku rîrîa rîrî riiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî nîrî û nie na andû akwa nî arîkû atî nîguo tûkûrutîre na ûtana? Indo cionthe ciumaga kûrî we na twagûcokeria irîa watûveere. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.14",
            "verseOrgIds": [
              "1CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûrî ageni na evîtûkîri methorî maku, wata ûrîa methe metû mekariî. Kavinda getû gûkû nthî gekariî ta kîruru, tûtirî na kîîrîgîrîro. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.15",
            "verseOrgIds": [
              "1CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "We Ngai-Mûnene, Ngai wetû tûnganîtie indo ino cionthe na wîngî nîguo tûgûtumîre hekarû nîguo tûve rîîtwa rîaku rîtheru gîtîîo. Cionthe ciumîte kûrî we, na nî ciaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.16",
            "verseOrgIds": [
              "1CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai wakwa, nîmbicî atî nîûtuîragia ngoro cia andû na nîûkenaga vîndî îrîa andû marûtha maûndû marîa magîrîrîte. Indo ino cionthe naruta ngenete na ngoro yakwa na nîrî na wendo, na nînîrona ûrîa andû aku arîa magomanîte ava makûretera matega mao makenete. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene, Ngai wa methe metû ma tene, Iburahimu, Isaka na Jakovu, tûma wendi ûyû ûtûûre ngororî cia andû aku tene na tene na ûtûme vîndî cionthe mekarage makwîvokete. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îkîra ngororî ya mûvîcîwa Solomoni wendi wa gûtûûra avingagia maathani maku, kîrîra na watho waku nîguo avote gûtuma nyomba îrîa mvarîrîtie.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nîwacokire akîra andû arîa onthe maagomanîte atîrî, “Kumiani Ngai-Mûnene, Ngai wenyu!” Nao andû onthe arîa maagomanîte nîmaakumirie Ngai-Mûnene, Ngai wa methe mao ma tene. Nîmeenamîrîrie ciongo ciao, makîgooca Ngai-Mûnene na makîva mûthamaki gîtîîo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio warûmîrîrîte nîmaarutîre Ngai-Mûnene magongoona. Nîmaarutîre Ngai-Mûnene matega ma kûvîvua ma ndegwa ngiri îmwe (1,000), ndûrûme ngiri îmwe, (1,000) na tûgondu ngiri îmwe (1,000), na matega ma ndivei, na matega mengî nîûndû wa andû onthe a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.12"
              },
              "items": [
                {
                  "text": "1Atha 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwoguo mûthenya ûcio andû nîmaarîre na makînyua makenete mûno marî mbere ya Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
