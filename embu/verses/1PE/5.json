                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kanitha wa Babuloni ûrîa wa naguo ûthuurîtwe nî Ngai, nîwamûkethia. Nginya Maariko mûvîcîwa, nîwamûkethia. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kethaniani na ngethi cia kûmumunyana mûrî na wendani.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
      ]
