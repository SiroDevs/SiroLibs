        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
