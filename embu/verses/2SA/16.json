              "items": [
                {
                  "text": "2Sam 9.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa Daudi aavîtûkire kîrîma kîu vandû vanini, nîwatûngirwe nî Ziba ndungata ya Mefiboshethu. Ziba aarî na mvunda igîrî ikuîte mîgate magana maîrî, ikundi îgana rîmwe cia thavibu, ikundi îgana rîmwe cia matunda ma gûtuuwa wa rîo na mbooro îcûrîte ndivei. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.1",
            "verseOrgIds": [
              "2SA.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Daudi nîwaûririe Ziba atîrî, “Indo ino cionthe nî ciakî?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ziba nîwacokirie atîrî, “Mvunda ino nî cia gûkuuaga andû a mûciî wa mûthamaki, mîgate na matunda nî cia kûrîwa nî anake, nayo ndivei nî ya kûnyunyagwa nî andû arîa mathira vinya marî werûrî.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
