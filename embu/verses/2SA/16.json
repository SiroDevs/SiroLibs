              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa ûguo, Abusalomu nîwerire Ahithofeli atîrî, “Rîu twîre ûrîa twagîrîrwe nî gwîka.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
      ]
