            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ngombo îo nîyamûcokerie atîrî, “Mwathi wakwa mûthamaki, nthû ciaku cionthe wana arîa mareganaga nawe makîenda gûgwîka maûndû macûku maroekwa ta ûguo Abusalomu ekîtwe ûmûnthî.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
