            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî wa îo, Mûethiopia ûrîa warî ngombo nîwakinyire na akîra mûthamaki atîrî, “Mwathi wakwa Mûthamaki, nîrî na ûvoro mwaro nakûretere! Naguo nî atî, ûmûnthî Ngai-Mûnene nîatûmîte ûvoote nthû ciaku cionthe.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
      ]
    },
