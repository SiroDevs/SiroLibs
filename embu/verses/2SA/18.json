        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwerire Abusalomu atîrî, “Rûngama wa varîa.” Nake Ahimaazi nîwathiîre na akîrûngama vo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
