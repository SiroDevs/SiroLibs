          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwaûririe atîrî, “Mwanake ûrîa wîtagwa Abusalomu nwa mwaro?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
