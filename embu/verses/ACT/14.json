          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaacokire makîvîtûkîrîra vûrûrirî wa Pisidia, na magîkinya Pamufilia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.24",
            "verseOrgIds": [
              "ACT.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîrîa maarîkirie kûvunjia kiugo Kîam Ngai kûu Periga nîmaanyûrûrûkire makîthiî Atalia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.25",
            "verseOrgIds": [
              "ACT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuuma kûu nîmaatwîre meri magîcoka Antiokia kûrîa etîkia mamaigîte wegarî wa Ngai nîûndû wa wîra ûcio maarîkîtie kûruta.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.26",
            "verseOrgIds": [
              "ACT.14.26"
            ]
          }
        }
      ]
