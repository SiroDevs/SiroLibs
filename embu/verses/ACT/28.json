          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Rîrîa Paûlo aarîkirie kuga ûguo, Ayahudi acio nîmaathiîre magîkararanagia na vinya mûno.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
