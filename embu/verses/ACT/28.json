          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paûlo nîwekarire îvinda rîa mîaka îîrî nyombarî îrîa ke mwene aakomborete, na andû onthe arîa maamûceragîra nîwamanyitaga ûgeni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.30",
            "verseOrgIds": [
              "ACT.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
