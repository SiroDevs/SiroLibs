          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwoguo nînîrenda mûmenye atî Ngai nîatûmîte ûvoro wake wa ûvonokio kûrî andû a ndûrîrî, na o nîmakûthikîrîria!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.28",
            "verseOrgIds": [
              "ACT.28.28"
            ]
          }
        }
