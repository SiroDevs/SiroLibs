              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.4",
            "verseOrgIds": [
              "MAL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene mwene vinya wonthe arauga atîrî, “Nîngaacoka nîmûkuvîvîrie nîguo nîmûtuîre cira. Ngethîrwa nîrî wa mbere kûruta ûira îgûrû rîgiî arogi, itharia, arîa marutaga ûira wa maveeni, arîa mavinyagîrîria arîa mandîkîte, aka a ndigwa, ciana cia ngoriai, arîa matonanagia kîvooto kûrî ageni, na arîa matangoocaga.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maruta na gîcunjî gîa îkûmi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.5",
            "verseOrgIds": [
              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nie Ngai-Mûnene ndicenjagia. Kwoguo mue andû a rûciaro rwa Jakovu, mûtirî acûkangie mûkathira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma vîndî ya methe menyu, mue nîmûtiganîrîtie maathani makwa na mûkarega kûmarûmîrîra. Kwoguo nie Ngai-Mûnene, mwene vinya wonthe nîrauga atîrî: Njokererani, nanie nîngûmûcokerera. Nwatî mue mûragia atîrî, ‘Nîtûgûcokerera atîa?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû nwa aîe Ngai? Nwatî mue nîmûmbîaga na vinya. Nwatî mûragia atîrî, ‘Tûkwîyaga na njîra îrîkû?’ Mûmbîyaga rîrîa mûkûruta gîcunjî gîa îkûmi na matega menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrî arume, nîûndû mue na vûrûri wonthe mwîthîrîtwe mûkînjuna indo icio na vinya.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        }
      ]
    },
