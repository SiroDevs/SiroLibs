        },
        {
          "text": "Îno nî ndûmîrîri îrîa Ngai-Mûnene aveere mûrathi Malaki nîguo ere andû a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.1",
            "verseOrgIds": [
