              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.5",
            "verseOrgIds": [
              "GAL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.17"
              },
              "items": [
                {
                  "text": "Gûco 10.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nwatî andû arîa moonekaga ta o atongoria gatagatîrî ka etîkia matianyongerera ûndû mûgeni. (Nîrauga ûguo nîûndû ndiramaka wana ethîrwa maarî atongoria kana mataarî, Ngai ndarî kîmenyano.) ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.6",
            "verseOrgIds": [
              "GAL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandû va ûguo, andû acio nîmoonire atî Ngai nîwamvete wîra wa kûvunjia ûvoro mwaro kûrî andû a Ndûrîrî wata ûrîa aaveete Petero wîra wa kûvunjîria Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.7",
            "verseOrgIds": [
              "GAL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai ûcio watûmire Petero atuîke mûtûmwa kûrî Ayahudi, nwake watûmire nduîke mûtûmwa kûrî andû a Ndûrîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.8",
            "verseOrgIds": [
              "GAL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Jakuvu, Petero na Johana, arîa moonekaga marî atongoria nîmaamenyire waro viû atî Ngai nîwamveete wîra ûyû wa mwanya. Kwoguo nîmaakethirie Baranaba na makîngethia. Ngethi ciao ciarî ta kîonereria gîa atî tuonthe tûrutaga wîra ûmwe. Nîtwetîkanirie atî Baranaba nanie tûrute wîra gatagatîrî ka andû a Ndûrîrî, nao marute wîra gatagatîrî ka Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.9",
            "verseOrgIds": [
              "GAL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûndû ûrîa maatûririe nî atî tûririkanage andû arîa marenda ûtethio marî ikundirî ciao, ûndû ûrîa mbîthîrîtwe ngîrirîria.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paûlo nîwerire Petero atî nîmûvîtiu marî Antiokia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîrîa Petero aûkire Antiokia, nînaareganire nake tûrî mbere ya etîkia onthe nîûndû nîwekîte naaî. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naareganire na Petero nîûndû nîwarîcanagîra na andû a Ndûrîrî, wana mbere ya andû arîa maatûmîtwe nî Jakuvu makinye kûu Antiokia. Nwatî rîrîa andû acio maakinyire Petero nîwatigire kûrîcanîra na andû a Ndûrîrî na akîthenguta kûrî o. Nîwetigagîra andû arîa maaugaga atî nwanginya andû a Ndûrîrî marue. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayahudi acio engî wana o nîmaambîrîrie gwîka maûndû na ûvinga ta Petero nîûndû wa gwîtigîra. Baranaba wanake nîwekire wata andû acio na kwoguo agîtuîka mvinga wata o. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa nonire atî andû acio tîarûngîrîru kûringana na ûma wa ûvoro mwaro, nînerire Petero andû onthe marî vo atîrî, “We wî Mûyahudi, nwatî wîthîrîtwe ûgîtûûra ta andû a Ndûrîrî na tî ta Mûyahudi. Nî atîa vi ûngîvota kûringîrîria andû a Ndûrîrî gûtûûra ta Ayahudi?”",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayahudi na andû a Ndûrîrî mavonokaga na njîra ya gwîtîkia.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama tue tûrî Ayahudi, na tûtirî andû a ndûrîrî arîa evia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Tha 143.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.20"
              },
              "items": [
                {
                  "text": "Aro 3.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî nîtûmenyete atî mûndû atucagwa mûthingu nîûndû wa gwîtîkia Jesû Kristû nwatî tî ûndû wa gwîka ûrîa watho ugîte. Natue twatuirwe athingu nî Ngai nîûndû wa gwîtîkia Kristû, nwatî tî ûndû wa ûrîa watho ugîte. Nîûndû gûtirî mûndû wanarî ûmwe ûtucagwa mûthingu nîûndû wa gwîka ûrîa watho ugîte. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa tue arîa tûtuîtwe athingu nî Kristû nî twonagwa tûrî evia, ûguo nî kuga Kristû athîkagîra mevia? Naarî ûguo tîguo! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa nwa njoke gwîka maûndû ma watho ûrîa naregire, nwa monwe nîrî mûndû unîte watho. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûvororî wîgiî watho, mbîkariî ta mûndû mûkuû; mbûragîtwe nî watho guo mwene nîguo ndûûre ngîtungatagîra Ngai. Nie mbîkariî ta mûndû ûkuîte vamwe na Kristû mûtharavarî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo rîu tî nie ndûûraga mwoyo, nwatî nî Kristû ûtûûraga ndaarî yakwa. Ûtûûro ûrîa ndûûraga rîu, ndûûraga na njîra ya gwîtîkia Mûriû wa Ngai ûrîa wamendire na akîîvecana akue nîûndû wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndireganîte na wega wa Ngai. Nwatî ethîrwa mûndû nwa atuwe mûthingu nî Ngai na njîra ya watho, ûguo nîta kuga Kristû aakwire mana.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
