              "items": [
                {
                  "text": "Aro 4.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ethîrwa mûrî a Kristû, mûrî a rûciaro rwa Iburahimu na nîmûkagaa kîrîa Ngai eeranîre.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.29",
