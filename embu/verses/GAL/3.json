              "items": [
                {
                  "text": "Gûco 21.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nwatî Kristû nîwatuîkire kîrumi nîûndû wetû nîguo atûkûûre kuuma kûrî kîrumi kîrîa kîretagwa nî watho. Nîûndû Mandîko matheru maugîte atîrî “Mûndû wa wonthe mwambe mûtharavarî nî mûrume nî Ngai.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû eekire ûguo nîguo kîrathimo kîrîa Ngai eerîre Iburahimu, gîkinyîre andû a Ndûrîrî na njîra ya Jesû Kristû nîguo na njîra ya wîtîkio tûvote kwamûkîra Roho ûrîa Ngai eeranîre.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Watho na Kîîranîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
