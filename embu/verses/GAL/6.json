            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngîrîkia, mûndû wana ûrîkû ndakanthînie nîûndû irema irîa nîrî nacio mwîrîrî cionanagia atî nie nîrî ngombo ya Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariû na aarî a îthe wetû, mûrogîa na wega kuuma kûrî Mwathani wetû Jesû Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    },
    {
