                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26.9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue nîmwîguîte ûvoro wîgiî mûtûûrîre wakwa wa na vau mbere rîrîa naarûmagîrîra ndini ya Ayahudi. Nînaanyariraga kanitha wa Ngai ndarî na ntha na nînaageragia mûno kûûthiria. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Ciîko 22.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naarî na kîîo mûno gûkîra Ayahudi a riika rîakwa ûvororî wîgiî kûrûmîrîra ndini ya Ayahudi, na nînerutanagîria mûno kûrûmîrîra mîtugo ya kîndûîre ya methe metû ma tene.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        }
      ]
