                  "text": "10.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbere ya gîtî kîu Kîam ûthamaki kwarî kîndû kîonekaga gîkariî ta îria rîa icicio na rîtheru ta îra.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
