                "loc": "EZK.10.1"
              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na wa rîmwe nînecûrirwe nî Roho. Na rîrîa naaroririe Îgûrû nînoonire gîtî Kîam ûthamaki gîkarîrîtwe nî mûndû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ûrîa wekarîrîte gîtî kîu Kîam ûthamaki aakengaga ta mathiga ma goro ma rangi njerû na ma rangi ndune. Nakîo gîtî kîu Kîam ûthamaki, nîkîathiûrûrûkîrîtue nî mûkûngambura wakengaga mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navo vaarî na itî ciîngî mîrongo îîrî na inya cia ûthamaki ciathiûrûrûkîrîtie gîtî kîu Kîam ûthamaki. Nao athuuri mîrongo îîrî na ana nîmaaciîkarîrîte. Athuuri acio meekîrîte nguo cia rangi njerû na ciongorî ciao maarî na nthûmbî cia thaavu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
