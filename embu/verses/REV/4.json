            "number": "1",
            "style": "v",
            "sid": "REV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa ûguo nie nînagîre na kîoneki kîngî, nînoonire mûrango ûrî mûvingûre kûu îgûrû. Naguo mûgambo wa ûrîa neguîte ûkîmbarîria na mûgambo ta wa karumbeta, nîwambîrire atîrî, “Unûkia ûûke ava, nanie nîngûkwonia maûndû marîa mageekîka vuvarî.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.1",
            "verseOrgIds": [
              "REV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 4:2"
          },
          "items": [
