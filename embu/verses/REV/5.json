                "loc": "GEN.49.9"
              },
              "items": [
                {
                  "text": "Kîam 49.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.1"
              },
              "items": [
                {
                  "text": "Isa 11.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake ûmwe gatagatîrî ka athuuri acio nîwambîrire atîrî, “Tiga kûrîra. Ta roria! Mûnyambû wa mûvîrîga wa Juda; na wa nyomba ya Daudi, nîavootanîte, na ke nwa avote gûtumûra ndumo icio mûgwanja na akûnjûre îvuku rîu rîa gîkûnjo.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
