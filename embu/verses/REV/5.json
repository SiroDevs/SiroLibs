                  "text": "Isa 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nacio ciûmbe icio na athuuri acio nîmaainire rwîmbo rûcerû makiugaga atîrî:",
          "type": "text",
          "attrs": {
