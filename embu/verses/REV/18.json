            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Athamaki a nthî arîa meekire maûndû ma ûtharia na nîmaagwatanîre merirîria macûku nake nîmakaarîra na maugîrîrie mona ndogo îrîa yaumaga kûrî rîo rîkîvîa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmakaarûngama varaca, nîûndû nîmagetigagîra matikaverithue take. Nao nîmakaauga atîrî, “Uui! Uui! Babuloni îtûûra rîrîa rînene kavinda ka îthaa rîmwe tu nîrîaverithua!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
