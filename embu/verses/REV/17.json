              "items": [
                {
                  "text": "Jer 51.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ûmwe wa araika arîa mûgwanja maarî na mbakûri mûgwanja nîwaûkire kûrî nie na akîmbîra atîrî, “Ûka, nanie nîngaakwonia ûrîa Ngai akaaverithia mûmaraa ûcio ûrî ngumo. Mûmaraa ûcio nî îtûûra rîrîa rîtumîtwe vakuvî na nyûnjî nyîngî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
