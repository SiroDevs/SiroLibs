                  "text": "Isa 60.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mîîrîga yarîo ndîkaavingwa wa naarî mûthenya ûmwe, nîûndû gûtikethagîrwa na ûtukû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
