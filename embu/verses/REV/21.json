              },
              "items": [
                {
                  "text": "2Pet 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînacokire ngîona îgûrû rîcerû na nthî njerû. Îgûrû rîa mbere na nthî ya mbere nîciathengutire na îria rîkîthira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
