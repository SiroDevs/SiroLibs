        "style": "s1"
      },
      "items": [
        {
          "text": "Mûndûmûka na Njûnamatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo ûrirû mûnene na wa magegania nîwaumîrire kûu îgûrû. Nî kwarî na mûndûmûka wekîrîte riûa rîrî ta nguo, na akinyithîtie magûrû make mwerirî. Na aarî na nthûmbî ya njata îkûmi na igîrî kîongorî gîake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûka ûcio aarî na îvu, na nîwarîrire nîûndû wa ûrûrû ûrîa eegucaga nîûndû aarî vakuvî gûciara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
