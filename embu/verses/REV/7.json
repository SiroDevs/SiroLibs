                  "text": "Mar 13.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nanie nînamûcokerie atîrî, “Mwathani, nie ndiîcî, we nîwe wîcî.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
