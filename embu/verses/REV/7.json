          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake ûmwe gatagatîrî ka athuuri acio nîwambûririe atîrî, “Andû aya mekîrîte nguo cia rangi njerû nî arîkû na nî a kuuma kû?”",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        }
      ]
