              "items": [
                {
                  "text": "Isa 49.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nao matikaavûta kana manyonde. Na matigaacoka kûvîvua nî riûa rîngî kana ûrugarî wa rîo ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
