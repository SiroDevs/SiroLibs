              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îrîa Gatûrûme gaatumûrire rûtumo rwa mûgwanja, nîgwakirirwe kivi kûu îgûrû îvinda ta rîa nuthu îthaa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîona araika mûgwanja arîa marûngamaga mbere ya Ngai. Nao nîmaanengerwe tûrumbeta mûgwanja.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
