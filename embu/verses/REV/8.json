              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûraika wa kaîrî nîwavuvire karumbeta gake. Nakîo kîndû kîonekaga gîkariî ta kîrîma kînene Kîamvîcaga nî mwaki, nîgîaikirue îriarî. Nakîo gîcunjî kîmwe Kîam ithatû Kîam îria nîgîatuîkire nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakîo gîcunjî kîmwe Kîam ithatû gîa ciûmbe irîa irî mwoyo itûûraga îriarî nîciakwire. Na gîcunjî kîmwe Kîam ithatû Kîam meri nîciacûkangirue.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
