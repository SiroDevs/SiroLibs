              "items": [
                {
                  "text": "Jer 9.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Rîîtwa rîa njata îo nî “Ûrûrû”.) Gîcunjî kîmwe Kîam ithatû Kîam manjî nîmaatuîkire marûrû. Nao andû eengî nîmaakwire manyua manjî mau maatuîkîte marûrû.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
