              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîona Gatûrûme gagîtumûra rûtumo rûmwe rwa icio mûgwanja, na ngîgua kîûmbe kîmwe Kîam irîa inya irî mwoyo gîkiuga na mûgambo wagambaga ta ngwa, “Ûka!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
