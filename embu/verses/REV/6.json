              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Gatûrûme aatumûrire rûtumo rwa kana, nînegwire kîûmbe gîa kana Kîam irîa irî mwoyo gîkiuga atîrî, “Ûka!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.7",
            "verseOrgIds": [
              "REV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
