              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nako Gatûrûme nîgaacokire gagîtumûra rûtumo rwa kaîrî, na ngîgua kîûmbe gîa kaîrî Kîam irîa irî mwoyo gîkiuga atîrî, “Ûka!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.3",
            "verseOrgIds": [
              "REV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
