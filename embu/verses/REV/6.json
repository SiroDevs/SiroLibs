          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.21"
              },
              "items": [
                {
                  "text": "Ezek 14.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînaroririe na ngîona mbarathi ya rangi îno nthererûku. Nake ûrîa wathiîte amîkarîrîte eetagwa Gîkuû na Vûrûri wa arîa akuû nîwamûrûmîrîrîte. Nao nîmaaveerwe ûvoti wa kwatha kîmwe gîa icunjî inya cia nthî nîguo maûrage andû na njîra ya mbaara, yûra, mîrimû, na nyamû cia kîthaka.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.8",
            "verseOrgIds": [
              "REV.6.8"
            ]
          }
        }
      ]
