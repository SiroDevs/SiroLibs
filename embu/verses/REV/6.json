              },
              "items": [
                {
                  "text": "Luka 21.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Gatûrûme gatumûrire rûtumo rwa gatandatû, nî kwagîîre na kîthingithia kînene. Riûa nîrîatigire kwara na gûkîgîa nduma. Naguo mweri nîwatunîvire ta nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nacio njata cia îgûrû nîciagwîre nthî wata ûrîa mûkûyû ûgwîthagia ngûû irîa nthatu vîndî îrîa wainainua nî rûkûngi rûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Kûguû 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Narîo îgûrû nîrîekûnjire ta îvuku rîa gîkûnjo na rîkîthirîkîra. Nacio irîma cionthe na icîgîrîra nîciathengutirue varîa ciethagîrwa irî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
