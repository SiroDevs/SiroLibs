                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînaroririe na ngîona mbarathi ya rangi njerû. Nake ûrîa wathiîte amîkarîrîte nîwanyitîte ûta, nake nîwaverwe nthûmbî. Nake ûcio wathiîte amîkarîrîte aathiîte ta mûvootani athiîte kûvootana.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
