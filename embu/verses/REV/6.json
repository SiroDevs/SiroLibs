                {
                  "text": "Zak 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "6.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo mbarathi îngî ya rangi ndune nî yaumîrire. Nake ûrîa wathiîte amîkarîrîte nîwaverwe rûtha athengutie thayû gûkû nthî nîguo andû maûragane. Nake nîwaverwe rûviû rûnene",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.4",
            "verseOrgIds": [
              "REV.6.4"
            ]
          }
        }
      ]
    },
