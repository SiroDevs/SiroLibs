                  "text": "Ntha 15.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nao nîmaainire rwîmbo rûrîa Musa, ndungata ya Ngai aainire, na rûrîa Gatûrûme aainire, akiuga atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
