              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Jesû nîwonire wara wao na akîmeera atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tamoniani mbeca îmwe ya sîlûva",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20.24",
              "type": "text"
            },
            {
              "text": "Mbeca îmwe ya sîlûva:",
              "type": "text"
            },
            {
              "text": "Kîngiriki kiugaga dinarii (Thoma Mat. 20.2).",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Mbica îno na rîîtwa rîîrî rîandîkîtwe vo nî rîa û?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaamûcokerie atîrî, “Nî cia mûthamaki wa Roma.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nîwamerire atîrî, “Kwoguo rutagîrani mûthamaki wa Roma kîndû kîrîa kîthagîrwa kîrî gîake, na mûrutagîre Ngai kîndû kîrîa kîthagîrwa kîrî gîake.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
              "LUK.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao matiavota kûmûgwatithia na mîario îrîa aarîtie arî mbere ya andû. Kwoguo nîmaamakire na magîkira kivi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kîûria kîgiî kûriûka gwa akuû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 20:27"
          },
          "items": [
            {
              "text": "27",
