            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.24"
              },
              "items": [
                {
                  "text": "Mat 6.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Gûtirî ndungata îngîvota gûtuîka ngombo ya athani aîrî. Nîûndû nwa yende ûmwe na îkamena ûcio wîngî, kana yathîkîre ûmwe na iire ûcio wîngî. Ndûngîvota gûtungatîra Ngai na ûtungatîre ûtonga.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maûndû mamwe ma marîa Jesû aaririe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 16:13"
          },
          "items": [
