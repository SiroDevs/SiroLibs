              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.12+MAT.11.13"
              },
              "items": [
                {
                  "text": "Mat 11.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Maûndû marîa mandîkîtwe Wathorî wa Musa na mavukurî ma arathi nîmaavunjirue nginya vîndî ya Johana Mûvatithania. Kuuma vîndî îo, Ûvoro Mwaro wa Ûthamaki wa Ngai nî ûvunjagua, na mûndû wa wonthe nî ageragia na vinya ûrîa angîtonya kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî kûthira kwa îgûrû na nthî nî kûvûthû gûkîra kûthengutia gatiring'o wana kamwe ka Watho.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
    },
