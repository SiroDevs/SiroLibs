              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.13",
            "verseOrgIds": [
              "LUK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Afarisai meegwire maûndû mama monthe, nîmaanyûrûririe Jesû nîûndû maarî akorokeru mbeca mûno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamerire atîrî, “Mue mwendaga gwîtua ûrîa mûrî aro methorî ma andû, nwatî Ngai nîwîcî ngoro cienyu. Nîûndû maûndû marîa monekanaga marî na vata methorî ma andû matirî vata methorî ma Ngai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
