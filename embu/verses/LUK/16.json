            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.10+1CO.7.11"
              },
              "items": [
                {
                  "text": "1Akor 7.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mûthuuri wa wonthe ûtecaga mûka na akavikia mûndûmûka wîngî nîatharagia. Nake mûthuuri wa wonthe ûvikagia mûndûmûka ûrîa ûtetwe nî mûthuuriwe, nîatharagia.",
          "type": "text",
          "attrs": {
