          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokerie Musa atîrî, “Andû arîa meevirie nîo ngaavuta marîîtwa mao îvukuurî rîakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.33",
            "verseOrgIds": [
              "EXO.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu thiî ûgatongorie andû mathiî kûrîa naakwîrire. Ririkana, mûraika wakwa nîakaamûtongoria, nwatî kavinda nîgagaakinya rîrîa ngaaûka kûverithia andû aya nîûndû wa mevia mao.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.34",
            "verseOrgIds": [
              "EXO.32.34"
            ]
          }
        }
      ]
    },
    {
