        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio Ngai-Mûnene nîwavonokirie andû a Isiraeli kuuma kûrî andû a Misiri. Nao andû a Isiraeli nîmoonire andû a Misiri mamamîte rûtere rwa îria marî akuû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îrîa andû a Isiraeli moonire vinya mûnene ûrîa Ngai-Mûnene aavootire andû a Misiri naguo, nîmeetigîre Ngai-Mûnene, makîmwîtîkia na magîtîkia ndungata yake Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
