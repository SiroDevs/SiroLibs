              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwaumire varî mûthamaki wa Misiri na akîthiî nja ya îtûûra rînene. Na rîrîa aaûkîrîrie njara ciake na îgûrû akîvoya Ngai-Mûnene, ngwa na mbura ya mbembe nîyatigire kuura gûkû nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî vîndî îrîa mûthamaki wa Misiri oonire atî ngwa na mbura ya mbembe nîyatiga kuura, nîwevirie rîngî. Ke mwene wana anene ake nîmaaûmirie ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ngoro ya mûthamaki wa Misiri nîyaûmire, na akîrega gwîtîkîra andû a Isiraeli mathiî wata ûrîa Ngai-Mûnene aarîtie na njîra ya Musa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
