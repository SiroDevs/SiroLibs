          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîtî ya ndigi cia kûthondeka nguo na cairi nîciacûkangirue, nîûndû ngano ya cairi yarî ngûrû, nayo mîtî ya ndigi cia kûthondeka nguo yarî na marao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî ngano itîacûkangua nîûndû ikûraga vuva.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        }
