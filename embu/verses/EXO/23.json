        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûtikandutîre matega ma mîgate mîkîre ndawa ya kwimbia rîrîa mûkûndutîra îgongoona rîa nyamû. Maguta ma nyamû irîa ndutîrîtwe îgongoona matikaarare nginya kîraûko Kîam mûthenya ûcio wîngî.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
    },
    {
