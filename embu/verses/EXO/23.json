                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Ala 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ndûkonanie mûthutûkanio ciirarî wa mûthîni.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
