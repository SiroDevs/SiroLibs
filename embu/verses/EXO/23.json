            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Vandaga mûgûnda waku na ûgaketha maciaro ma guo îvinda rîa mîaka îtandatû. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.10",
            "verseOrgIds": [
              "EXO.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mwaka wa mûgwanja rekaga ûvurûke. Kîndû kîrîa kîonthe kîngîkûra kuo ndûgakethe nîguo andû enyu arîa athîni moonage gîa kûrîa. Nakîo kîrîa matigaria nyamû cia kîthaka ikarîcaga. Mûgekaga wa ûguo mîgûndarî yenyu ya mîthavibu na ya mîtamaiyû îrîa îciaraga matunda.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        }
      ]
