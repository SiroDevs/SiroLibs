                "loc": "DEU.14.21"
              },
              "items": [
                {
                  "text": "Gûco 14.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Retageni nyombarî ya Ngai-Mûnene, Ngai wenyu maketha marîa maro ma mbere ma irio cia mîgûnda yenyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
