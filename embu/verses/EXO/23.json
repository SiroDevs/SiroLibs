              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rûmagîrîra maûndû marîa monthe nie Ngai-Mûnene nakwîra. Ndûkavoe ngai ciîngî kana ûgwete marîîtwa ma cio na kanyua gaku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        }
      ]
    },
