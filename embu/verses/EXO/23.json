        },
        {
          "text": " “Ûngîona ndegwa kana mvunda ya nthû yaku yûrîte, mûcokerie. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûngîona mvunda ya nthû yaku îgwîte nîûndû wa kûremererwa nî mûrigo, mûtethie kûmîûkîria; tiga kûmûvîtûka wa ûguo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
