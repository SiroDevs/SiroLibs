          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwerire Ngai-Mûnene atîrî, “Andû matingîvota kunûkia gûkû kîrîmarî nîûndû nîwatwîrire tûtucage kîrîma gîkî gîa Sinai kîtheru na tûrûthe mûvaka ûkîthiûrûrûkîrîtie.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        }
      ]
    },
