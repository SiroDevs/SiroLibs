          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.11+DEU.4.12"
              },
              "items": [
                {
                  "text": "Gûco 4.11-12",
                  "type": "text"
                }
              ]
            },
            {
