      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngai-Mûnene nîwathire andû a Isiraeli maume kîrîmarî gîa Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
