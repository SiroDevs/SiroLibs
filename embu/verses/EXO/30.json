              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa ûgaatara andû a Isiraeli, wa mûndû nîakaarîva kîndû gîa kûtheria mwoyo wake kûrî Ngai-Mûnene nîguo rîrîa ûkethîrwa ûkîmatara matikanyitwe nî mûthiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.25+EXO.38.26"
              },
              "items": [
                {
                  "text": "Ntha 38.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mat 17.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûndû wa wonthe ûgaatarwa nwanginya akaarîva mwîgana wa mbeca irîa ikendekana ithimîtwe na kîthimi kîrîa kîtheru gîtîkanîrie. Mûndû wonthe nwanginya akaarîva îrîvi rîu rîrî îtega kûrî nie, Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe ûgaatarwa na arî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere, nîakaarutîra Ngai-Mûnene matega. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû arîa atongu matikaaruta nyîngî makîria nao arîa athîni matikaaruta nini makîria ya kîthimi kîrîa gîtîkanîrîtue kîrî îtega rîa kûtheria mwoyo wake kûrî Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkaaûngania mbeca icio kuuma kûrî andû a Isiraeli na ûivûthîre na wîra wa kûmenyerera îgema rîa Ngai-Mûnene. Îrîvi rîu nî rîa kûtheria mîoyo ya andû a Isiraeli nanie nîngaaririkana kûmagitîra.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kîraî kîa gîcango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
