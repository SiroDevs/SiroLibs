                {
                  "text": "Ntha 6.2-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nake Musa nîwerire Ngai atîrî; “Nîngîthiî kûrî andû a Isiraeli nîmere, ‘Ngai wa methe menyu ma tene nîke ûndûmîte kûrî mue’, na mambûrie, ‘Ke etagwa atîa?’ Ngaameera atîa?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.13",
            "verseOrgIds": [
              "EXO.3.13"
            ]
          }
        }
