              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûndû angîrakara na aûrage mûndû wîngî, ke nî akaaûragwa wana angîthîrwa nî aûrîte akathiî metharî yakwa ya kîgongoona nîguo ndakaûragwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
