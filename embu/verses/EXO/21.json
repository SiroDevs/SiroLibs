          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûndûmûka ûcio angîthîrwa arî mûgurarie, mwoyo nîûrîvagwe na mwoyo, ",
          "type": "text",
          "attrs": {
