      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nduma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîra Musa atîrî, “Ûkîrîria njara yaku îroretie na îgûrû maturî. Na nîgûkûgîa nduma nene mûno îngîvota kûnyitîka na îîgûkunîka vûrûri wonthe wa Misiri.” ",
          "type": "text",
          "attrs": {
