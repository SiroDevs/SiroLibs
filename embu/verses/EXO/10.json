            "number": "27",
            "style": "v",
            "sid": "EXO 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwatûmire ngoro ya mûthamaki wa Misiri îtuîka nyûmû na mûthamaki akîrega gwîtîkîria andû a Isiraeli mathiî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.27",
            "verseOrgIds": [
              "EXO.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire akîra Musa atîrî, “Uma varî nie! Menyerera ndigakwone rîngî. Nîngîgaakwona, mûthenya ûcio we nîûgaakua!”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        }
      ]
