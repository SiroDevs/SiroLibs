            "verseId": "EXO.10.28",
            "verseOrgIds": [
              "EXO.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwacokire akîmwîra atîrî, “Wata ûguo wauga, ndûkaamona rîngî.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.29",
            "verseOrgIds": [
              "EXO.10.29"
            ]
