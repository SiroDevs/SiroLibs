            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Tathikîrîriani mue andû a Isiraeli! Ngai-Mûnene, Ngai wetû nî Ngai-Mûnene ûmwe tu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.37"
              },
              "items": [
                {
                  "text": "Mat 22.37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.30"
              },
              "items": [
                {
                  "text": "Mar 12.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.27"
              },
              "items": [
                {
                  "text": "Luka 10.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Endani Ngai-Mûnene, Ngai wenyu na ngoro yonthe na mwoyo wonthe, na vinya wenyu wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.5",
            "verseOrgIds": [
              "DEU.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.18+DEU.11.19+DEU.11.20"
              },
              "items": [
                {
                  "text": "Gûco 11.18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûtikariganîrwe nî maathani mama ngûmûva ûmûnthî. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîrîrani mûmathomithanagie kûrî ciana cienyu vîndî cionthe, rîrîa mûrî mîciî, rîrîa mûrî kûraca na mîciî, rîrîa mûkûthiî toro na rîrîa mûkûramûka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moverereni njararî cienyu, na mothiûrî menyu nîguo mûmaririkanage. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mandîkeni itugîrî cia mîrango ya nyomba cienyu na ivingorî cienyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûkaanua ûvoro wîgiî kûrega kwathîka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
