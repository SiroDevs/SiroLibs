        "style": "s1"
      },
      "items": [
        {
          "text": "Rîathani rîrîa rîa vata Mûno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
