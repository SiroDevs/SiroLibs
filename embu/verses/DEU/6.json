              "items": [
                {
                  "text": "Luka 4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mûtikagerie Ngai-Mûnene, Ngai wenyu ta ûrîa mwekire mûrî Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîrîrani mûvingagie Maathani monthe ma Ngai-Mûnene, Ngai wenyu na kinyi, kîrîra gîake na mawatho marîa amwathîte. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îkagani maûndû marîa magîrîre na marîa maro methorî ma Ngai, nîguo maûndû menyu methîrwe marî maro na mûvote kwîgwatîra vûrûri mwaro ûrîa Ngai-Mûnene eerîre methe menyu na mwîvîtwa atî nîakaamava, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwîngate nthû cienyu cionthe wata ûrîa Ngai-Mûnene eeranîre.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
