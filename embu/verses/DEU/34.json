              "DEU.34.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Ntha 33.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuuma vîndî îo, gûtirî kwagîa mûrathi wîngî ta Musa vûrûrirî wa Isiraeli, mûndû maaranagîria na Ngai-Mûnene metho kwa metho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî mûrathi wanaringa ciama na kwonania morirû ta ûrîa Ngai-Mûnene aatûmire Musa eke kûrî mûthamaki wa Misiri, ndungata ciake na vûrûri wake wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtirî mûrathi wîngî wanavota gwîka maûndû manene na ma gwîtigîrwa gûkîra marîa Musa eekire mbere ya andû onthe a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
