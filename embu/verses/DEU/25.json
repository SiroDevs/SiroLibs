                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Taririkanani ûrîa Amaleki maamwîkire rîrîa mwarî rûgendorî mumîte Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririkanani ûrîa maamûtharîkîre mûrî anogu na mûkathira vinya; na matagwîtigîra Ngai, nîmaaûragire arîa onthe maarî vuva. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo rîrîa Ngai-Mûnene, Ngai wenyu akaamûva vûrûri ûrîa aamwîrîîre, na amûgitîre kuuma kûrî nthû cienyu irîa ikethîrwa îmûthiûrûrûkîrîtie, nwanginya mûkaaûraga Amaleki onthe mathire viû na mariganîre. Mûtikariganîrwe nî gwîka ûguo!",
