                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ndûkove ndegwa kanyua rîrîa îravûûra ngano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
