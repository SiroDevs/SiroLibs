      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wîra wa mûndû kûrî mûrwang'ina ûrîa ûkuîte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
