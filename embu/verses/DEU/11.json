        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ûmûnthî nîrenda mûthuure kîrîa mûkwenda: kîrathimo kana kîrumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa nî mûkwathîkîra maûndû marîa Ngai-Mûnene Ngai wenyu amwathîte, nîmûkwamûkîra kîrathimo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwarega kwathîkîra maathani ma Ngai-Mûnene Ngai wenyu, na mûgooce ngai ciîngî irîa mûtaaicî mbere, nîmûkaaverithua. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "Gûco 27.11-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Josh 8.33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwakinyua nî Ngai-Mûnene Ngai wenyu vûrûrirî ûrîa aamwîrîîre na mûwîgwatîre, nî mûkaanîrîra mûrî kîrîmarî Kîam Gerizimu ûrîa akaamûrathima, na mûrî kîrîmarî Kîam Ebali, mwanîrîre ûrîa akaamûverithia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irîma icio cioîrî irî mwena wa îthûîro wa rûnjî rwa Jorodani vûrûrirî wa andû a Kanaani arîa matûûraga Kîamndarî Kîam Jorodani. Irîma icio irî vakuvî na mîtî ya mîvuru îrîa mîamûre ya More kûrigania na îtûûra rîa Giligali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûrî vakuvî kûringa rûnjî rwa Jorodani mûthiîte kwîgwatîra vûrûri ûrîa Ngai-Mûnene Ngai wenyu akûmûva. Mwegwatîra vûrûri ûcio na mûtûûre kuo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwîmenyagîrîreni mûvingagie na kinyi maathani monthe marîa namûva ûmûnthî.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
