            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.6+DEU.6.7+DEU.6.8+DEU.6.9"
              },
              "items": [
                {
                  "text": "Gûco 6.6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mûtikariganîrwe nî maathani mama makwa na mûmaigage ngororî cienyu na mîoyorî yenyu. Moverereni njararî cienyu na mothiûrî menyu nîguo mûmaririkanage. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thomithagiani ciana cienyu maathani mama. Thomithagiani ciana cienyu rîrîa mûrî mîciî, rîrîa mûrî kûraca na mîciî, mûkîthiî toro na rîrîa mwaramûka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mandîkeni itugîrî cia mîrango ya nyomba cienyu na ivingorî cienyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweka ûguo, mue vamwe na ciana cienyu nî mûgaatûûra vîndî ndaca vûrûrirî ûrîa Ngai-Mûnene eerîre methe menyu atî nîakaamava, na mûgaatûûra kuo tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
