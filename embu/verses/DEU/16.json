            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.12+NUM.29.13+NUM.29.14+NUM.29.15+NUM.29.16+NUM.29.17+NUM.29.18+NUM.29.19+NUM.29.20+NUM.29.21+NUM.29.22+NUM.29.23+NUM.29.24+NUM.29.25+NUM.29.26+NUM.29.27+NUM.29.28+NUM.29.29+NUM.29.30+NUM.29.31+NUM.29.32+NUM.29.33+NUM.29.34+NUM.29.35+NUM.29.36+NUM.29.37+NUM.29.38"
              },
              "items": [
                {
                  "text": "Nda 29.12-38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mwarîkia kûvûûra ngano cienyu cionthe na kûviva thavibu, kûngûagîrani kîrugo gîa tûnyomba îvinda rîa mîthenya mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûngûagîrani kîrugo kîu mûkenete mûrî na ciana cienyu, ndungata cienyu, Alawi, ageni, ciana cia ndigwa, na aka a ndigwa arîa matûûraga matûûrarî menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûgaakûngûagîra kîrugo gîkî îvinda rîa mîthenya mûgwanja mûrî varîa Ngai-Mûnene Ngai wenyu akaathuura va kûgoocagîrwa, îrî njîra ya kûmûva gîtîîo. Kenagani nîûndû Ngai-Mûnene Ngai wenyu nîakaarathima maketha ma mîgûnda yenyu na wîra wonthe ûrîa mûrutaga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
