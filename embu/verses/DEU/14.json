        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûtikariganîrwe nî Alawi arîa matûûraga matûûrarî menyu, nîûndû matiagaîrwa kûndû gwa gûtûûra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.27",
            "verseOrgIds": [
              "DEU.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthiiarî wa mwaka wa kathatû, viragani gîcunjî gîa îkûmi kuuma mîgûndarî yenyu na mûciigage matûûrarî menyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irio ino nî cia Alawi nîûndû matiagaîrwa kûndû gwa gûtûûra gatagatîrî kenyu, ageni, ciana cia ndigwa, na aka a ndigwa arîa matûûraga matûûrarî menyu, nîguo monage gîa kûrîa makavaa. Mwîkage ûguo nîguo Ngai-Mûnene Ngai wenyu amûrathimage na akarathima wîra wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
            "verseOrgIds": [
              "DEU.14.29"
            ]
          }
        }
      ]
