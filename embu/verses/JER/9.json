        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî, “Mîthenya nîgaakinya rîrîa ngaverithia andû onthe arîa maruîte mwîrî tu: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Misiri, Juda, Edomu, njiarwa cia Amoni, Moabu na andû onthe arîa matûûraga werûrî na menjaga njuîrî ciao igakuvîva mîena. Andû a ndûrîrî ino cionthe na andû onthe a Isiraeli tî aruu ngororî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
      ]
