          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî wana mîthenyarî îo, nie Ngai-Mûnene ndikamûcûkangia mûthire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.18",
            "verseOrgIds": [
              "JER.5.18"
            ]
          }
        },
