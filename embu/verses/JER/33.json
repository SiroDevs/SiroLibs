            }
          ]
        },
        {
          "text": "Kiugo Kîam Ngai-Mûnene nîgîakinyîre Jeremia akîrwa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
