            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ethîrwa nwa ûvote kûgarûra kîrîkanîro kîrîa naarûthire na mûthenya na ûtukû nîguo gûtikagîe mavinda ma mûthenya na ma ûtukû, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
