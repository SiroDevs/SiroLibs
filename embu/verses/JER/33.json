                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîûndû nie Ngai-Mûnene nîrauga atî, gûtigatura mûndû wa rûciaro rwa Daudi wa kwathana Isiraeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
