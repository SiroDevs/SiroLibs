          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ino nîcio ciugo irîa Ngai-Mûnene aririe ciîgiî Isiraeli na Juda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
