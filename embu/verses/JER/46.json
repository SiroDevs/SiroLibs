                  "text": "Isa 19.1-25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "Ezek 29.1—32.32",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ûvoro wîgiî Misiri: aaugire atî, athigari a mbaara a mûthamaki wa Misiri arîa marî vakuvî na Karikemishi vakuvî na rûnjî rwa Farati, arîa Nebukadinezarû mûthamaki wa Babuloni aavotire mwakarî wa kana wa wathani wa Jehoiakimu mûvîcî wa Josia, mûthamaki wa Juda. Ngai-Mûnene augîte atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
