          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.10"
              },
              "items": [
                {
                  "text": "Kûguû 13.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na mangîkûûria, ‘Nîtûthiî kû?’ Ûkaamera, ‘Nie Ngai-Mûnene mbugîte atî:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
