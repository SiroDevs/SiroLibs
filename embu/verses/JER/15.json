              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.1+2KI.21.2+2KI.21.3+2KI.21.4+2KI.21.5+2KI.21.6+2KI.21.7+2KI.21.8+2KI.21.9+2KI.21.10+2KI.21.11+2KI.21.12+2KI.21.13+2KI.21.14+2KI.21.15+2KI.21.16"
              },
              "items": [
                {
                  "text": "2Atha 21.1-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.1+2CH.33.2+2CH.33.3+2CH.33.4+2CH.33.5+2CH.33.6+2CH.33.7+2CH.33.8+2CH.33.9"
              },
              "items": [
                {
                  "text": "2Maû 33.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîngatûma matuîke andû a kûmakia mothamaki monthe ma nthî, nîûndû wa maûndû marîa Manase mûvîcî wa Hezekia ekire kûu Jerusalemu rîrîa aarî mûthamaki wa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia nîwatetire arî mbere ya Ngai-Mûnene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyanya, kaî nîrî na thîna-î! Wanjiarire nîkî, nîûndû ndûûraga ngucanagia na andû vûrûrirî wonthe? Ndianakombithia mûndû kana ngoba kûrî mûndû, nwatî andû onthe nîmaranuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "We Ngai-Mûnene, ethîrwa ndianagûtungatîra ûrîa kwagîrîrîte kana ngûthaitha vandûrî va nthû ciakwa rîrîa maarî na thîna na ruuo, nîronyitwa nî irumi ciao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî mûndû ûngîvota kuna cuuma, makîria îrîa yumîte mwena wa rûgûrû; kana gîcango?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî, “Nîngatûma ûtonga wenyu na mîthithû yenyu îtavwe, nîûndû ûcio nîguo mûcara wa mevia menyu marîa mwîkîte vûrûrirî wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîngatûma mûtungatagîre nthû cienyu mûrî vûrûrirî mûgeni, nîûndû nîrî na marakara mekariî ta mwaki ûtavorekagia tene na tene.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
