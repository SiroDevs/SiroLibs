              "JER.50.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.6"
              },
              "items": [
                {
                  "text": "Kûguû 18.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Îrani andû arîa marûaga na mîguî makatharîkîre Babuloni. Rigicîriani îtûûra rîu na mûtikareke mûndû wana ûmwe ethare. Rîverithieni kûringana na ciîko ciarîo, mûrîke wata ûrîa rîkîte mavûrûri marîa mengî, nîûndû rîthîrîtwe rîkînyarararithie Ngai-Mûnene Ûrîa Mûtheru wa Isiraeli na mwîtîîo warîo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo anake a îtûûra rîu makaûragîrwa ivaarorî ciarîo na athigari onthe a rîo nîmagacûkangua mûthenya ûcio. Ûguo nîguo nie Ngai-Mûnene nauga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
