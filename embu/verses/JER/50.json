            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.21",
            "verseOrgIds": [
              "JER.50.21"
            ]
          }
        }
