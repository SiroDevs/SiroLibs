            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.24",
            "verseOrgIds": [
              "JER.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.25",
            "verseOrgIds": [
              "JER.13.25"
            ]
          }
        }
      ]
    }
