              "HOS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Gomeri aatigithirie mwana ûcio wîtagwa, “Ûtegucagîrwa ntha” kwonga, nîwagîre îvu na agîciara mwana wa kaîrî wa kavîcî. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Ngai-Mûnene nîwerire Hosea atuîre mwana ûcio rîîtwa “ ‘Tî andû akwa,’ nîûndû mue mûtirî akwa, na nie ndi wenyu.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
