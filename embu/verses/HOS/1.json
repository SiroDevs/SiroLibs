                  "text": "Aro 9.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nwatî andû a Isiraeli nîmakengîva ta mûthanga ûrîa ûrî îriarî ûrîa ûtangîthimîka kana ûtarîka; navo varîa Ngai-Mûnene amerire, “Mue mûtirî andû akwa” nîagaacoka ameere, “Mue mûrî ciana cia Ngai mûtûûra mwoyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a Juda na Isiraeli nîmakaagomana vamwe na nîmakathuura mûtongoria wao ûmwe; nao nîmakoongereka kûu vûrûrirî wao. Mûthenya ûcio ûkethîrwa ûrî mûnene kûrî Jezireeli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
