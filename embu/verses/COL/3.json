              },
              "items": [
                {
                  "text": "Tha 110.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mue nîmwariûkirue vamwe na Kristû kwoguo îriragîrieni kîrîa kîrî îgûrû, kûrîa Kristû ekarîte mwena wa ûrîo wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.1",
            "verseOrgIds": [
              "COL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îciragieni ûvoro wîgiî kîrîa kîrî îgûrû, na tî kîrîa kîrî gûkû nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.2",
            "verseOrgIds": [
              "COL.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû nîmwakwire na rîu mwoyo wenyu ûthithîtwe vamwe na Kristû kûrî Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.3",
            "verseOrgIds": [
              "COL.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtûûro wetû wa ma nî Kristû na rîrîa ke agaaûka rîngî gûkû nthî, wa namue nîmûkoonekana mûrî vamwe nake na mûrî na riiri ta wake.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûtûûro mûkûrû na ûrîa mûcerû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.4",
            "verseOrgIds": [
              "COL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ûragani merirîria marîa mûrî namo ma maûndû ma gûkû nthî. Namo nî: ûmaraa, ûûra nthoni, ûtûrîka, kûgîa na merirîria macûku na gûkoroka (nîûndû gûkoroka nî ta kûvoya ngai cia mîvuanano). ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.5",
            "verseOrgIds": [
              "COL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nîûndû wa maûndû mama, marakara ma Ngai nîmagaakinyîra andû arîa matamwathîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.6",
            "verseOrgIds": [
              "COL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îmwe wa namue nîmwekaga maûndû ta mau nîûndû mwatongoragua nî merirîria macûku.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.7",
            "verseOrgIds": [
              "COL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîu nwanginya mûtigane viû na maûndû mama: marakara, mang'ûrîka, kwîgucanîra naaî, kûrumana na kwaranîria naaî. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.8",
            "verseOrgIds": [
              "COL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.22"
              },
              "items": [
                {
                  "text": "Aef 4.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tigagani kûveenania, nîûndû nîmweyaûrire ûmûndû wenyu ûrîa mûkûrû wa vamwe na mîtugo yaguo ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.9",
            "verseOrgIds": [
              "COL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Kîam 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.24"
              },
              "items": [
                {
                  "text": "Aef 4.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " na nîmwekîrire ûmûndû mûcerû. Naguo ûmûndû wenyu ûyû mûcerû wîkaraga ûgîcerûvagua vîndî cionthe nîguo ûvanane na Ngai ûrîa waûûmbire, nîguo ûgîe na ûmenyo wa ma wake. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.10",
            "verseOrgIds": [
              "COL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû wa ûguo, rîu gûtirî na ngûrani ya andû a ndûrîrî na Ayahudi, ya mûndû mûruu na ûtarî mûruu, ya mûndû mûkingitaru na ya mûvoi mîvuanano, ya mûndû ngombo na ûtarî ngombo. Nwatî Kristû nîke maûndû monthe, kûrî andû onthe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.11",
            "verseOrgIds": [
              "COL.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
