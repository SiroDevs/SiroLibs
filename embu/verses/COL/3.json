              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûndû wa wonthe ûrîa mûgekaga, wîkageni na wendi takwa mûrarutîra Mwathani wîra nwatî tî andû. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.23",
            "verseOrgIds": [
              "COL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "COL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagani atî Mwathani nîke ûkaamûva îgai rîrîa aigîrîte andû ake kîrî kîveo, nîûndû Kristû nîke Mwathani wa ma ûrîa mue mûtungatagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.3.24",
            "verseOrgIds": [
              "COL.3.24"
            ]
          }
