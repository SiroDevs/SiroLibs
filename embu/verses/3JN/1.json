                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nie mûthuuri, nîrakwandîkîra we Gayo mûrata wakwa ûrîa mendete na ma.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
