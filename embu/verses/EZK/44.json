                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Athînjîri-Ngai matikenjwe njuîrî cia ciongo ciao kana marera njuîrî iracava mûno. Makaigaga njuîrî yao îrî nenge waro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.20",
