                }
              ]
            }
          ]
        },
        {
          "text": " Athînjîri-Ngai matikanyue ndivei magîtonya kîvarorî Kîam ndarî. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
