                "loc": "LEV.21.13+LEV.21.14"
              },
              "items": [
                {
                  "text": "13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûtirî mûthînjîri-Ngai ûkaavikia mûndûmûka matiganîte na mûrûme, nwa avikirie mwîrîtu nthingi Mûisiraeli kana mûndûmûka wa ndigwa wa mûthînjîri-Ngai wîngî akuîte.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
