            }
          ]
        },
        {
          "text": "Kwoguo nie Ngai-Mûnene Ngai nîngaatambûrûkia njara yakwa îgûrû rîa Afilisiti na mbûrage andû onthe a Kerethi na nthirie andû arîa matûûraga rûtere rwa îria. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.16",
            "verseOrgIds": [
              "EZK.25.16"
            ]
          }
