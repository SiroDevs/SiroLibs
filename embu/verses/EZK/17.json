            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwacokire akîmbîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
