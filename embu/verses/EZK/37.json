              "items": [
                {
                  "text": "Kûguû 21.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîngaatûûranagia nao na nduîke Ngai wao, nao matuîke andû akwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
