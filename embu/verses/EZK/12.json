          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwambîrire atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndû, taroria andû a Isiraeli maugaga atî cioneki ciaku ciîgiî îvinda rîa tene, na ûrathaga maûndû marî kûraca mûno! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo meere nie Ngai-Mûnene, mbugîte atî ciugo ciakwa cionthe gûtirî gîgeekarîrîria rîngî. Ûrîa mbarîtie nwanginya wîkîkage. Ûguo nîguo nie Ngai-Mûnene mbugîte!”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.28",
            "verseOrgIds": [
              "EZK.12.28"
            ]
          }
        }
      ]
