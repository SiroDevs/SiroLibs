              "attrs": {
                "loc": "JER.39.2+JER.39.3+JER.39.4+JER.39.5+JER.39.6+JER.39.7+JER.39.8"
              },
              "items": [
                {
                  "text": "Jer 39.2-8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.4+JER.52.5+JER.52.6+JER.52.7+JER.52.8+JER.52.9+JER.52.10+JER.52.11+JER.52.12+JER.52.13+JER.52.14"
              },
              "items": [
                {
                  "text": "52.4-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûthenya wa gatano wa mweri wa îkûmi, mwaka wa îkûmi na îîrî kuuma twavirwa îthamîriorî, mûndû ûmwe nîwaûrire akiuma Jerusalemu agîûka akîmbîra atî, îtûûra rînene rîa Jerusalemu nîrîgwîu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîvwaî mbere ya mûndû ûcio aûka nînagîte na vinya wa Ngai-Mûnene. Kwoguo rîrîa mûndû ûcio waûrîte aûkire kîraûko Kîam mûthenya ûcio warûmîrîrîte, Ngai-Mûnene nîwamûvere ûvoti wa kwaria.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mevia ma andû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
