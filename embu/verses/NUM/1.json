              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.15",
            "verseOrgIds": [
              "NUM.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nîo atongoria arîa maathuurîtwe kuuma kûrî mwîngî, na kûrî mîvîrîga ya tene ya Isiraeli na kuuma kûrî atongoria a icunjî irîa ciagaanîtue cia Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arûme aya îkûmi na aîrî nîo maatethereerie Musa na Aroni gûtarana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya wa mbere wa mweri wa kaîrî, nîmeetire andû onthe vamwe na makîmandîka onthe wa mûndû kûringana na mûvîrîga wake na nyomba yake. Arûme arîa maarî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere nîmaatarirwe na makîandîkwa mûtaratara wao onthe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "wata ûrîa Ngai-Mûnene aathîte Musa. Musa aandîkîthirie andû acio arî werûrî wa Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtaratara wa arûme arîa maarî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere na mangîatuîkire athigari a mbaara maandîkîtwe mavangîtwe wa mûndû na mûvîrîga wake, nyomba yake, na maambîrîrîtie na andû a mûvîrîga wa Reubeni mûvîcî wa Jakovu ûrîa warî mûkûrû. Mwîgana wa andû acio kuuma kûrî wa mûvîrîga wekariî ta û: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîrîga wa Reubeni warî na arûme ngiri mîrongo îna na ithathatû na magana matandatû (46,600). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîrîga wa Simeoni nîwatarirwe na arûme onthe arîa maarî na ûkûrû wa kuuma mîaka mîrongo îîrî kûthiî na mbere na mangîatuîkire athigari a mbaara nîmaandîkirwe marîîtwa mao wa mûndû kûringana na mbarî yake, nyomba yake, na mûciî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo warî na arûme ngiri mîrongo îtano na kenda na magana mathatû (59,300.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîrîga wa Gadi nîwatarirwe na arûme onthe arîa maarî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere na mangîatuîkire athigari a mbaara nîmaandîkirwe marîîtwa mao wa mûndû kûringana na mbarî yake, nyomba yake, na mûciî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naguo warî na arûme ngiri mîrongo îna na ithano na magana matandatû ma mîrongo îtano (45,650). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.25",
            "verseOrgIds": [
              "NUM.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûvîrîga wa Juda nîwatarirwe na arûme onthe arîa maarî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere na mangîatuîkire athigari a mbaara nîmaandîkirwe marîîtwa mao wa mûndû kûringana na mbarî yake, nyomba yake, na mûciî wake. ",
          "type": "text",
          "attrs": {
