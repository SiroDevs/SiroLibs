          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acio nîo andû arîa Musa na Aroni maatarire magîtethagîrîrua nî atongoria îkûmi na aîrî a kuuma Isiraeli, wa mûndû arûngamîrîrîte nyomba ya îthe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
              "NUM.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo arûme onthe a Isiraeli arîa maarî na ûkûrû wa mîaka mîrongo îîrî kûthiî na mbere na mangîatuîkire athigari a mbaara, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "maarî ngiri magana matandatû ma ithatû na magana matano ma mîrongo îtano (603,550).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
          }
