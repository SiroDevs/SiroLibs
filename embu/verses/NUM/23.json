          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Balaki nîwavirire Balaamu mûgûndarî wa Zofimu îgûrû rîa kîrîma Kîam Pisiga. Nîwatumire metha mûgwanja cia kîgongoona, na kûrî wa metha ya kîgongoona nîwategire ndegwa na ndûrûme.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.14",
            "verseOrgIds": [
              "NUM.23.14"
            ]
          }
        }
      ]
