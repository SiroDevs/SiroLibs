              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki nîwacokire akîra Balaamu atîrî, “Nîkwa wambîka atîa? Nie nakûretire gûkû nîguo ûrume nthû ciakwa, nwatî ûrîa weka nîkwa wamarathima.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.11",
            "verseOrgIds": [
              "NUM.23.11"
            ]
          }
        }
      ]
