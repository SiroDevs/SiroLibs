            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwaumîrîre Balaamu na akîmwîra ûrîa akûthiî kwîra Balaki, na akîmwatha acoke kûrî Balaki akamûve ndûmîrîri îo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.16",
