            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki nîwacokire akîra Balaamu atîrî, “Ndûkamarume kana ûmarathime wana vanini.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
            "verseOrgIds": [
              "NUM.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Balaamu nîwacokerie Balaki atîrî, “Na kinthî ndiakwîrire atî ngeka ûrîa wonthe Ngai-Mûnene akambîra mbîke?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
