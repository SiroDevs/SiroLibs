              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki nîwacokire akîra Balaamu atîrî, “Ûka tûthiî nawe vandû vengî varîa we ûkûvota kwona amwe ao. Numîra o ûrî vau.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.13",
            "verseOrgIds": [
              "NUM.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
