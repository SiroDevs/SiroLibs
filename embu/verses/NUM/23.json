          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu nîwacokirie atîrî, “Mbagîrîrwe nî kuga ûrîa tu Ngai-Mûnene ambîra mbuge.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.12",
