          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mau nîmo mawatho ma Mûnazari. Nwatî Mûnazari angîranîra kîndû kînene makîria, nwanginya avingie ciîranîro cionthe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa Athînjîri-Ngai makaarathimanaga",
          "type": "text"
        }
      ]
    },
