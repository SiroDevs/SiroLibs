        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaavira indo icio cionthe kûrî Ngai-Mûnene irî matega ma mevia na matega ma kûvîvua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaaruta ndûrûme îo kûrî Ngai-Mûnene îrî îgongoona rîa thayû, vamwe na gîkavu Kîam mîgate îtekîrîtwe ndawa ya kwimbia, na îtega rîa irio cia mûgûnda na îtega rîa indo cia kûnyuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnazari nîakaathiî mûromorî wa îgema rîa Ngai-Mûnene, enje njuîrî ciake, na acikie mwakirî ûrîa ûravîvia matega ma thayû.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        }
      ]
    },
    {
