              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îrîa kûgûrû kwa mbere kwa ndûrûme gûkaatherûkua mûthînjîri-Ngai nîakaagwoca vamwe na geki îmwe na kamûgate kamwe gaceke kuuma gîkavurî na acigîrîre njararî cia Mûnazari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthînjîri-Ngai nîakaanenganîra indo icio irî matega ma mwanya kûrî Ngai-Mûnene. Indo icio nî ntheru cia gûtûmîrwa nî mûthînjîri-Ngai. Vamwe na indo icio, nîgûkethîrwa na kîthûri na kûgûrû kwa ndûrûme. Vuva wa ûguo Mûnazari nwa anyue ndivei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
