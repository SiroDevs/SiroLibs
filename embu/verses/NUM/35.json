            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mûndû wa wonthe ûkaaûraga mûndû wîngî nîagaatuîrwa kûragwa ethîrwa aira aîrî kûthiî na mbere nîmakaaruta ûira wa kwonania atî nîaûraganîte. Ûira wa mûndû ûmwe tî mwîganu nîguo mûndû atuîrwe atî nîaûraganîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe ûkaaûragana na vinya nwanginya akaaûragwa. Gûtirî îrîvi rîngîrutwa nîûndû wa wîvia ta ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigetîkîre îrîvi kuuma kûrî mûndû ûthiîte îtûûrarî rîa kwîthitha atî nîguo acoke mûciî mbere ya mûthînjîri-Ngai mûnene akue. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigacûkangie vûrûri ûrîa mûtûûraga na njîra ya kûragana, nîûndû nthakame ya mûndû aûragîtwe nîcûkagia vûrûri. Gûtirî njîra îngî ya kûtheria vûrûri kuumana na wîvia ûcio tiga kûraga mûndû ûcio ûraganîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtigatûme vûrûri ûrîa mûtûûraga ûgîe gîko kûrîa wananie ndûûraga, nîûndû Nie Ngai-Mûnene ndûûranagia na andû a Isiraeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
