            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.1+JOS.20.2+JOS.20.3+JOS.20.4+JOS.20.5+JOS.20.6+JOS.20.7+JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Josh 20.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ngai-Mûnene nîwerire Musa atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îra andû a Isiraeli atî vîndî îrîa mûkaaringa rûnjî rwa Jorodani na mûtonye vûrûrirî wa Kanaani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîmûkaathuura matûûra marîa mûndû angîthiî kwîthitha angîûraga mûndû ûrîa wîngî atakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matûûra mau nî ma kûthiî kwîthitha nîguo mûndû ûcio ûraganîte ndakaûragwe nî ûrîa ûngîenda kûrîvîrîria ûrîa ûûragîtwe, ûcio ûûraganîte atacirithîtue. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmûkaavecana matûûra menyu matandatû ma kwîthitha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.13",
            "verseOrgIds": [
              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matûûra mathatû makeethîrwa marî mwena wa îrathîro wa rûnjî rwa Jorodani na mathatû methîrwe marî vûrûrirî wa Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matûûra mau matandatû nî ma kwîthithwa nî andû a Isiraeli, ageni arîa mûtûûranagia nao na evîtûkîri.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî mûndû ûrîa ûkaaringa mûndû ûrîa wîngî na cuuma akue, mûndû ûcio nî mûragani na nwanginya wanake akaaûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû ûrîa ûkaaringa mûndû ûrîa wîngî na îthiga akue, mûndû ûcio nî mûragani, na nwanginya wanake akaaûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kana mûndû ûrîa ûkaaringa mûndû ûrîa wîngî na mûtî akue, mûndû ûcio nî mûragani na nwanginya wanake akaaûragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûndû ûmwe wa arîa metanîtue na mûndû ûcio ûragîtwe nîakaamûrîvîrîria na njîra ya kûraga mûndû ûcio ûraganîte.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mûndû angîthîrwa arî na ûthû na ûrîa wîngî na amwîthithîre amûmunde, kana amwikie kîndû kîmûringe akue, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana amûringe na ngundi akue, mûndû ûrîa ûringîte ûcio wîngî nî mûragani na nwanginya akaaûragwa nî mûndû ûmwe wa arîa metanîtue na mûndû ûcio ûragîtwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nwatî mûndû angîmunda ûrîa wîngî atakwenda na atarî na ûthû kana amwikie kîndû amûringe atamwîthithîrîte, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana, aringe mûndû na îthiga atakwenda na mûndû ûcio waringwa akue na ûcio wamûringa ethîrwe atarî nthû yake, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "andû onthe nîmagaatua ciira gatagatî ka mûragani na mûrîvîrîria kûringana na mawatho mau. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû nîmagaatethûra mûndû ûcio ûraganîte atakwenda kuuma kûrî mûndû ûrîa wîtanîtue na mûndû ûcio ûragîtwe. Andû nîmagaacokia mûndû ûcio ûraganîte atakwenda îtûûrarî rîa kwîthitha, kûrîa aarî mbere. Mûndû ûcio ageekara îtûûrarî rîu nginya rîrîa Mûthînjîri-Ngai mûnene ûrîa wathuurîtwe na njîra ya kûvakwa maguta mamûre agaakua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûndû ûcio ûraganîte angîkaauma îtûûra rîu rîa kwîthitha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nake mûndû ûrîa metanîtue na mûndû ûrîa ûragîtwe oone ûcio ûraganîte arî vau nja ya mûvaka wa îtûûra rîu rîa kwîthitha na acoke amûrage, ke akeethîrwa atekîte wîvia wa kûragana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû ûcio ûraganîte nwanginya ekare îtûûrarî rîa kwîthitha nginya rîrîa mûthînjîri-Ngai ûrîa mûnene agakua; nwatî rîrîa mûthînjîri-Ngai ûcio mûnene agaakua, mûndû ûcio ûraganîte nwa acoke mûciî. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawatho mama nîmatûûra marûmagîrîrwa nî njiarwa cienyu cionthe kûrîa kuonthe mûgaatûûra.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        }
