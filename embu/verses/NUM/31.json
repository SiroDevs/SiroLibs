          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indo irîa ciatigarire athigari marîkia gwoca ciao nî: mbûri na ng'ondu ngiri magana matandatû ma mîrongo mûgwanja na ithano (675,000), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
