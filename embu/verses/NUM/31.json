          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andû ngiri îkûmi na ithathatû (16,000), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nîwocire nyamû îmwe na mûndû ûmwe kuuma kûrî wa nyamû mîrongo îtano na andû mîrongo îtano arîa maatavîtwe kuuma kûrî gîcunjî kîrîa Kîamgaîrîtwe andû a Isiraeli na akîva Alawi arîa maamenyagîrîra îgema rîa Ngai-Mûnene. Ûguo nîguo Ngai-Mûnene aathîte Musa eke.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
