          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû maanengerwe ng'ondu na mbûri magana mathatû ma mîrongo îthatû na mûgwanja na magana matano (337,500), ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
