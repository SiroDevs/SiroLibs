          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Aroni atîrî, “Ndûkagaa wanarî kîndû vûrûri wa andû a Isiraeli, kana ûvewe gîcunjî wanarî kîmwe Kîam vûrûri ûcio. Nie nînie gîcunjî gîaku na îgai rîaku.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        }
      ]
