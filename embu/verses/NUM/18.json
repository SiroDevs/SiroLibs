        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nînakûva we avîcî aku na erîtu aku matega monthe ma mwanya marîa andû a Isiraeli makaandutagîra matûûre marî menyu. Gîkî nîgîtûûra kîrî kîrîkanîro gîakwa nawe na njiarwa ciaku na gîtikaagarûrwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        }
      ]
