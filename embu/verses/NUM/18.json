                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Indo cionthe irîa nyamûre na irî Isiraeli nî cienyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
