        "style": "s1"
      },
      "items": [
        {
          "text": "Mawatho megiî mevîta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
