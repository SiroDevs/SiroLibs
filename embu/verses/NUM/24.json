            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu nîwerire Balaki atîrî, “Rîu nie nthiîte kûrî andû etû. Nwatî mbere ya nthiî tiga ngûtaare ûvororî wîgiî ûrîa andû a Isiraeli mageeka andû aku mavinda marîa magaaûka.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
