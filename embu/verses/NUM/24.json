          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu nîwerire Balaki atîrî, “Kinthî ndierire anjaama arîa watûmîte gwakwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "atî wana ûngîamvere nyomba yaku îcûrîte thaavu na sîlûva, ndingîekire ûndû ûreganîte na ûrîa Ngai-Mûnene aambathîte na njîra ya gwîka ûndû wakwa. Nie ngaragia wa ûrîa tu Ngai-Mûnene ambîrîte mbarie.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrathi wa Balaamu wa mûthiia",
          "type": "text"
        }
      ]
    },
