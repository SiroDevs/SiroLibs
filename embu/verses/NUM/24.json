              "NUM.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki nîwarakarire mûno nî Balaamu, na agikia njara na akîra Balaamu atîrî, “Nie nagwîtire ûke ûrume nthû ciakwa, nwatî vandû va ûguo, maita mathatû wîthîrîtwe ûkîmarathima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu, thiî wînûke! Nînakwîrîrîte iveo nyîngî, nwatî ndwarî wendi wa Ngai-Mûnene ûgîe na iveo icio.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
