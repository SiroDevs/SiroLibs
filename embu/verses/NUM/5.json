          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûyû nîguo watho ûrîa ûgaatûmagîrwa rîrîa mûndûmûka agîa na meciria matarî maro na amenyane kîîmwîrî na mûndûmûrûme wîngî tiga mûthuuriwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29",
            "verseOrgIds": [
              "NUM.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndûmûka akaarûngamagua mbere ya metha ya kîgongoona nake mûthînjîri-Ngai akaruta îgongoona rîu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthuuri ndakeethagîrwa arî na mavîtia, nwatî mûka nîke ûkaaverithagua nîndû wa mavîtia make.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.31",
            "verseOrgIds": [
              "NUM.5.31"
            ]
          }
