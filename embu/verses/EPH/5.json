            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû mûthuuri nîke wathaga mûndûmûka wata ûrîa Kristû arî ke wathaga kanitha. Na Kristû ke mwene nîke Mûvonokia wa Kanitha, ûrîa arî guo mwîrî wake. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûndûmûka nîathîkagîre mûthuuri wake maûndûrî monthe wata ûrîa kanitha wathîkagîra Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
