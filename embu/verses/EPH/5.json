                  "text": "1Pet 3.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mue aka, athîkagîrani athuuri enyu wata ûrîa mûngîathîkîra Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
