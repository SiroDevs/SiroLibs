              "items": [
                {
                  "text": "1Atha 10.23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.22+2CH.9.23+2CH.9.24+2CH.9.25+2CH.9.26+2CH.9.27"
              },
              "items": [
                {
                  "text": "2Maû 9.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînarutire mawîra manene. Nînatumire nyomba na ngîvanda mîthavibu mîgûndarî yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînarîmire mîgûnda ya matunda na ngîvanda mîtî ya matunda ma mîthemba yonthe kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînenjire iriko cia manjî ma gwîtîrîria mîtî îo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.23"
              },
              "items": [
                {
                  "text": "1Atha 4.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînaagûrire ngombo nyîngî cia aka na cia arûme na naarî na ciîngî ciaciarîrîtwe gwakwa mûciî. Naarî na ndîthia nyîngî cia ng'ombe na mbûri gûkîra andû onthe arîa maatûûraga Jerusalemu mbere yakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.10"
              },
              "items": [
                {
                  "text": "1Atha 10.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.10.14+1KI.10.15+1KI.10.16+1KI.10.17+1KI.10.18+1KI.10.19+1KI.10.20+1KI.10.21+1KI.10.22"
              },
              "items": [
                {
                  "text": "14-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nînaagîre na sîlûva na thaavu kuuma mîthithûrî ya athamaki a mavûrûri marîa naathaga. Nînaagîre na aini a nyîmbo a aka na arûme na aka eengî a kwigwa arîa mûndûmûrûme angîenda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.25"
              },
              "items": [
                {
                  "text": "1Maû 29.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kwoguo nînagîre na ngumo nene gûkîra andû onthe arîa maatûûraga Jerusalemu mbere yakwa, na nekire maûndû monthe nîrî na ûûgî. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaagîre na kîndû wa kîonthe kîrîa nendaga, na nînageririe mîthemba yonthe ya ikeno. Nînetîîagîra mawîra monthe marîa narutire, na ûcio nîguo warî mûcara wa wîra wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîciria ûvoro wîgiî maûndû monthe marîa nekîte na mînoga îrîa nagîre ngîmeka. Nînaamenyire atî ûcio wonthe warî wîra wa mana na nîta kûvinyûrania na rûkûngi na warî ûndû ûtarî na umithio gûkû nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînaacokire ngîciria ûvoro wîgiî kûgîa na ûûgî, ûrimû ka ûgûrûki.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki angîka tu wa ûrîa athamaki arîa maarî mbere yake meekire. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîmenya atî ûûgî nî mwaro gûkîra ûrimû, wata ûrîa ûtheri ûrî mwaro gûkîra nduma. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû mûûgî nî onaga kûrîa athiîte, nakîo kîrimû gîtionaga kûrîa kîthiîte. Nwatî nînaamenyire atî mûthiia wa andû acio wa oîrî nî gîkuû. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaacokire ngîîra na ngoro atîrî, “Wa ûguo kîrimû gîgaakua, nwaguo wananie ngaakua. Kwoguo ûûgî ûcio wakwa wandethia na ndûî?” Nînaacokire ngîmenya atî ûûgî ûcio nî wa mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû gûtirî mûndû ûririkanaga mûndû mûûgî kana kîrimû. Vuvarî tuonthe mûndû mûûgî wana kîrimû nîtûgaakua na tûriganîre. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînaamenire ûtûûro nîûndû maûndû monthe marîa mekagwa gûkû nthî maambîgwithagia kîeva. Maûndû mau monthe maarî ma mana; nî takwa naageragia kûvinyûrania na rûkûngi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaamenire wîra wonthe ûrîa naarutîte gûkû nthî namenya atî nwanginya ngaaûtigîra mûndû wîngî ûrîa ûgaaûka vuva wakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nû wicî kana akethîrwa arî mûûgî kana arî kîrimû? Kûnarî ûguo, indo cionthe irîa naacaririe gûkû nthî ngîtûmagîra ûûgî wakwa nwanginya ngaamûtigîra cio. Ûyû wana guo nî wîra wa mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîneririre neciria ûvoro wa wîra wonthe ûrîa naarutîte na kîîo gûkû nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî mûndû ûrutaga wîra wa gûcaria indo na ûûgî, arî na ûmenyo na ûvoti. Nwatî mûthiiarî indo icio agaatigîra mûndû wîngî ûtaanairutîra wîra. Ûcio nî wîra wa mana na mûcûku! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa kûruta wîra na kwînogia ûtûûrorî ûyû mûndû agunîkaga na ndûî? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Ayu 5.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
