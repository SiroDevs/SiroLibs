      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîneîrire na ngoro atî nîngwîkenia nîguo menye gîkeno nîndûî. Nwatî nînaamenyire atî wana ûcio nî ûndû wa mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînaamenyire atî wana kûtheka nî ûrimû, na gûkena gûtirî vata. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîneciririe mûno ûrîa ngwîkenia na ndivei wa ndongoretue nî ûûgî, na ngîrûmagîrîra ûrimû nginya rîrîa ngaamenya maûndû maro mûno marîa andû mekaga kavinda kanini karîa matûûraga mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
