          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî na ûndû mûcûku menyete gûkû nthî. Naguo wîkagwa nî anene. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû arîa irimû nîo mavecagwa ngathî cia ûtongoria nacio itonga ikavewa ngathî cia mûthiia. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmonete ngombo ikîthiî itwîte mbarathi, nao anene mathiîte na magûrû ta ngombo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
