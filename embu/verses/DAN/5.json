          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtukû wa mûthenya ûcio, Belishazaru, mûthamaki wa Babuloni nîwaûragirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
              "DAN.5.30"
            ]
          }
        },
