              "DAN.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.3"
              },
              "items": [
                {
                  "text": "Kûguû 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Na wandoretie, nyamû ya kana nîyaumîrire. Nayo yarî ya kûmakania na ya magegania, nîûndû wa ûrîa yanenevete. Yarî na magego manene mûno ma cuuma. Nîyatamburûrangire nyamû icio ciîngî inuku, îgîcoka îgîikinyanga na magûrû mayo. Nyamû îo yarî ngûrani na nyamû icio ciîngî cionthe irîa noonete mbere yayo, nîûndû yarî na mvîa îkûmi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Kûguû 13.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Na vîndî îrîa naaroretie mvîa cia nyamû îo, nînoonire karûvîa kanini keyumîria gatagatî ka mvîa icio ciîngî, na gagîkûûra mvîa icio ciîngî ithatû. Karûvîa kau kaarî na metho ta ma mûndû, na kanyua kaaragia na mwîtîîo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.8",
            "verseOrgIds": [
              "DAN.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îtuîro rîa Ngai",
          "type": "text"
        }
      ]
    },
    {
