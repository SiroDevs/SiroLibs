                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwaka wa kathatû Jehoiakimu arî Mûthamaki wa Juda, Nebukadinezarû, Mûthamaki wa Babuloni nîwatharîkîre îtûûrarî rîa Jerusalemu na akîrîthiûrûrûkîria. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
