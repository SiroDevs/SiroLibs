                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.7+ISA.29.8"
              },
              "items": [
                {
                  "text": "Isa 29.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Mwathani nîwarekererie Jehoiakimu anyitwe nî Nebukadinezarû. Nebukadinezarû nîwocire indo imwe irîa ciarî hekarûrî ya Ngai. Mûthamaki Nebukadinezarû nîwacokire Babuloni vamwe na mîgwate na nîwaigire indo icio hekarûrî ya ngai ciake.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Nebukadinezarû nîwathire Ashipenazi ûrîa warî mûnene wa ndungata ciake, athuure anake a Isiraeli, kuuma mîciî ya anene na ya andû arîa atîîkanu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anake matarî na wonje, athaka, marî na ûûgî na wara wa mîthemba yonthe, athomu, na marî na ûmenyo, nîguo methîrwe marî agîrîru a gûtungata kwa Mûthamaki mûciî. Mûthamaki nîwaugire mathomithue kwaria na kwandîka rûthiomi rwa Akalidei. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwathanire mavecagwe irio irîa mbaro aarîcaga na ndivei îrîa aanyunyaga. Anake acio maagîrîrwe nî kûthomithua îvinda rîa mîaka îthatû, na vuvarî mavirwe kûrî mûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatagatîrî ka anake onthe arîa maathuurirwe kwarî na Danieli, Hanania, Mishaeli na Azaria kuuma mûvîrîgarî wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Mûnene wa ndungata cia kwa Mûthamaki nîwavere anake acio marîîtwa ma Babuloni ta û: Danieli eetirwe Beliteshazaru; Hanania eetirwe Shadiraka; Mishaeli eetirwe Mîsheki, na Azaria agîîtwa Abedinego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Danieli nîwatuire atî ke ndangîîgwatia gîko na njîra ya kûrîa irio, kana kûnyua ndivei ya Mûthamaki. Kwoguo Danieli nîwaûririe Ashipenazi amwîtîkîrie ndakarîe irio icio nîguo ndakagwatwe nî gîko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai nîwatûmire Ashipenazi ende Danieli na amwîguîre ntha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Ashipenazi nîwerire Danieli atîrî, “Nie nînîretigîra, nîûndû mûthamaki nîwatua kîrîa ûkaarîcaga na ûkanyunyaga, na ethîrwa tî woneka ûrî mwaro na mûthaka ta anake arîa engî, nîakûmbûraga.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Danieli nîwathiîre kûrî mûrangîri ûrîa wathuurîtwe nî Ashipenazi amenyagîrîre Danieli, Hanania, Mishaeli na Azaria na akîmwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nakûthaitha ûtûve irio cia manyenyi matheri cia kûrîa, na manjî ma kûnyua kavinda ka mîthenya îkûmi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûcoke ûtwige vamwe na ûtûringithanie na anake acio engî, arîa marîcaga na makanyua ndivei ya Mûthamaki, ûcoke wîke na ndungata ciaku ûrîa ûkwona kwagîrîrîte.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mûrangîri nîwetîkîrire mathiî mageeke ûrîa maavoire mageeke na akîmageria mîthenya îkûmi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mîthenya îkûmi yathira, Danieli, Mîsheki, Shadiraka na Abedinego nîmonekire marî athaka na anoru gûkîra arîa maarîcaga irio na makanyua ndivei ya mûthamaki mûciî. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo kuuma mûthenya ûcio, mûrangîri wa anake acio nîwametîkîririe kûrîa manyenyi matheri vandûrî va irio na ndivei îrîa yaumaga kwa Mûthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai nîwavere anake aya ana ûtaûku na wara kîthomorî na ûgîîrî wao. Îgûrû rîa mau, nîwavere Danieli kîveo gîa gûtaûra cioneki na iroto.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthiia wa mîaka îthatû, îrîa mûthamaki aathanîte atî makaavirwa kûrî ke, Ashipenazi nîwavirire anake acio kûrî mûthamaki Nebukadinezarû. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki nîwamarîrie onthe, na gatagatîrî kao, gûtirî wamûkenirie ta Danieli, Hanania Mishaeli na Azaria. Kwoguo mûthamaki nîwamathuurire matungatage gwake mûciî. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndûrî monthe megiî ûûgî na ûtaûki marîa mûthamaki angîendire kûmenya kuumana nao, nîwonire marî aro maita meengî mûno gûkîra aragûri kana aringi mbûgû, arîa maarî kûrîa kuonthe aathanaga. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.20",
            "verseOrgIds": [
              "DAN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli aatungatire kwa mûthamaki mûciî nginya mwaka wa mbere Cairasi atuîka mûthamaki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
            "verseOrgIds": [
              "DAN.1.21"
            ]
          }
        }
      ]
    }
  ],
