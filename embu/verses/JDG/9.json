              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo Ngai aarîvirie Abimeleki waganu ûrîa eekîte îthe rîrîa aûragithirie aa mûrwang'ina acio mîrongo mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.56",
            "verseOrgIds": [
              "JDG.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
