          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Joshua nîwamerire atîrî, “Mue nîmwatuîka aira enyu mue ene atî nîmwathuura gûtungatagîra Ngai-Mûnene.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
