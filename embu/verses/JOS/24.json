          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaacokirie atîrî, “Ii tûrî aira.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.22",
            "verseOrgIds": [
              "JOS.24.22"
            ]
