          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû a Isiraeli nîmeerire Joshua atîrî, “Naarî! Tue tûgatungatagîra Ngai-Mûnene.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        }
