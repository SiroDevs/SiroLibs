          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matûûra manene marîa maaverwe mbarî icio ciîngî cia Kohathu maarî îkûmi wa vamwe na kûndû gwa kûrîthia.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
            "verseOrgIds": [
              "JOS.21.26"
            ]
          }
        }
