      },
      "items": [
        {
          "text": "Vûrûri wa mwena wa îthûîro rîa rûnjî rwa Jorodani nîwagaîrwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
