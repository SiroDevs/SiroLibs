            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.13"
              },
              "items": [
                {
                  "text": "34.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nîwathîtwe nî Ngai-Mûnene atî vûrûri ûyû ûkaagaanua na njîra ya kûthîrwa. Naguo nîwagaîrwe mîvîrîga kenda na nuthu ya andû a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.2",
            "verseOrgIds": [
              "JOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Nda 32.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.14+NUM.34.15"
              },
              "items": [
                {
                  "text": "34.14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12+DEU.3.13+DEU.3.14+DEU.3.15+DEU.3.16+DEU.3.17"
              },
              "items": [
                {
                  "text": "Gûco 3.12-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa nîwarîkîtie kûgaania vûrûri ûrîa warî mwena wa îrathîro wa rûnjî rwa Jorodani wagaîrîtwe mîvîrîga îrî na nuthu ya andû a Isiraeli, nwatî mûvîrîga wa Lawi ndwagaîrwa kûndû vamwe nao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.3",
            "verseOrgIds": [
              "JOS.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njiarwa cia Josefu nîciagaanirue igîtuîka mîvîrîga îrî: Mûvîrîga wa Manase na mûvîrîga wa Efiraimu. Mûvîrîga wa Lawi ndwagaîrwa vûrûri ûtuîka wao. Vandû va ûguo Musa nîwamavere matûûra nîguo matûûrage kuo na kûndû gwa kûrîthagua nîûndû wa ndîthia yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.4",
            "verseOrgIds": [
              "JOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû a Isiraeli maagaire vûrûri ûcio kûringana na ûrîa Ngai-Mûnene aathîte Musa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Heburoni nîyaverwe Kalebu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
