          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Marîkia kûruithua onthe nîmeekarire kûu maambîte magema nginya rîrîa maavonire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai-Mûnene nîwerire Joshua atîrî, “Ûmûnthî nînamûthengutîria gîconoko gîa kwîthîrwa mûrî ngombo vûrûrirî wa Misiri.” Kwoguo Joshua agîtuîrîra vandû vau rîîtwa Giligali na nwaguo vetagwa wana ûmûnthî.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
