          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Petero aatonyire nyomba, Jesû nîwamwarîrie mbere na akîmûria atîrî, “Simoni ûreciria nî andû arîkû marîvaga gooti kûrî athamaki a nthî? Nî ene vûrûri kana nî ageni?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
              "MAT.17.25"
            ]
          }
        }
      ]
    },
