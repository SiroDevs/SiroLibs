              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwagûkîre ndaimono îo na îkiuma kûrî kamwana kau. Na kavinda wa kau kamwana kau nîkaavonire.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
