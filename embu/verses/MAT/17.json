              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Petero nîwamacokerie atîrî, “Ii, nîarîvaga.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.25",
            "verseOrgIds": [
