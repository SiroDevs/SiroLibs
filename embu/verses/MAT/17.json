              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa arutwa onthe maagomanire vamwe kûu Galili, Jesû nîwamerire atîrî, “Mûrû wa Mûndû nîakaanenganîrwa kûrî andû, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
