              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaimono ya mûthemba ûyû ndîngîrutûrûrîka na njîra îngî tiga na njîra ya mavoya na kwînyerekia.]” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.21",
            "verseOrgIds": [
              "MAT.17.21"
            ]
          }
        },
        {
