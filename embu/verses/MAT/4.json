              "items": [
                {
                  "text": "Mat 3.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuuma vîndî îo Jesû nîwambîrîrie kûvunjia, akaugaga atîrî, “Îîrireeni mevia menyu, nîûndû ûthamaki wa îgûrû ûrî vakuvî!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.17",
            "verseOrgIds": [
              "MAT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû nîwetire ategi ana a nthamaki",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
