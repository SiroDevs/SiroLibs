        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.3"
              },
              "items": [
                {
                  "text": "Mat 14.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17"
              },
              "items": [
                {
                  "text": "Mar 6.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.19+LUK.3.20"
              },
              "items": [
                {
                  "text": "Luka 3.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Jesû eegwire atî Johana Mûvatithania aarî mwikie njeera, nîwathiîre vûrûrirî wa Galili. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.12",
            "verseOrgIds": [
              "MAT.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.12"
              },
              "items": [
                {
                  "text": "Joh 2.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû nîwaumire îtûûrarî rîa Nazarethi, na akîthiî gûtûûra Kaperinaumu itûûra rîrîa rîarî vakuvî na îria rîa Galili vûrûrirî wa Zebuluni na Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.13",
            "verseOrgIds": [
              "MAT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûndû ûyû wekirwe nîguo maûndû mavinge marîa Ngai aarîtie na njîra ya mûrathi Isaia atî:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.14",
            "verseOrgIds": [
              "MAT.4.14"
            ]
          }
        }
      ]
    },
