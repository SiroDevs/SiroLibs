              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.39"
              },
              "items": [
                {
                  "text": "Mar 1.39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nake Jesû nîwathiîre kûndû kuonthe vûrûrirî wa Galili, akîthomithanagîria mavoerorî, akîvunjagia Ûvoro Mwaro wîgiî Ûthamaki wa Ngai, na akîvonagia andû arîa maarwarîte mîrimû ya mîthemba yonthe, wana arîa maarî na wonje wa mîthemba yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ngumo yake nîyatambire vûrûrirî wonthe wa Sîria. Kwoguo andû nîmaamûvirîre andû onthe arîa maarî arwaru na maarî na mîrimû ya mîthemba yonthe: ndaimono, kîvava na kwonja ciîga cia mwîrî. Jesû nîwamavonirie onthe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû eengî mûno a kuuma Galili, Dekapoli",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4.25",
              "type": "text"
            },
            {
              "text": "Dekapoli:",
              "type": "text"
            },
            {
              "text": "na rûthiomi rwa Kîngiriki nî kuga ‘matûûra îkûmi.’",
              "type": "text"
            }
          ]
        },
        {
          "text": ", Jerusalemu, Judea na mûringo ûcio wîngî wa rûnjî rwa Jorodani, nîmaamûrûmîrîre.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        }
      ]
