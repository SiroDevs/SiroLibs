        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.21",
            "verseOrgIds": [
              "MAT.18.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
