          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.34",
            "verseOrgIds": [
              "MAT.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû akîrîkîrîria nîwamerire atîrî, “Ûguo nwaguo Ngai Vava ûrîa wî îgûrû ageeka kûrî mûndû wa wonthe wa cienyu, mûngîrega kûrekera aa mûrwanyûkwe kuuma ngororî cienyu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.35",
            "verseOrgIds": [
              "MAT.18.35"
            ]
          }
        }
      ]
    }
