              "items": [
                {
                  "text": "Joh 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kwoguo nie nîramwîra nama atîrî, ûndû wa wonthe mûkarega gûkû nthî, wana îgûrû nîûkaaregwa. Naguo ûndû wa wonthe mûgeetîkîra gûkû nthî, wana îgûrû nî ûgeetîkîrwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na rîngî nîramwîra atî, ethîrwa andû aîrî gatagatîrî kenyu magetîkanîria ûndû ûrîa makûvoya, nîmakaavingîrua ûndû ûcio nî Vava ûrîa ûrî îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû varîa andû aîrî kana athatû magomanîte nîûndû wa rîîtwa rîakwa, ngeethagîrwa nîrî vamwe nao.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya ndungata îrîa yaregire kûovanîra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
