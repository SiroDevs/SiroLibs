              "MAT.18.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.3"
              },
              "items": [
                {
                  "text": "Luka 17.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ethîrwa Mûrwanyûkwe nwa akûvîtîrie, thiî ûmwîre mavîtia make mûrî aîrî tu. Ke angîkûthikîrîria, nîmwacokanîrîra. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Gûco 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nwatî angîrega gûkûthikîrîria, thiî kûrîke mûrî na mûndû ûmwe kana aîrî, nîguo ûndû wa wonthe mûkaaria wîkîrwe vinya nî ûira wa andû aîrî kana athatû. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ethîrwa mûrwanyûkwe tîamathikîrîria, îra kanitha ûvoro ûcio; na angîrega kûthikîrîria kanitha, mûtue ta mûndû ûtetîkîtie kana ta mwîtia mbeca cia gooti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûndû ûrîa mûrege na ûrîa mwîtîkîrie",
          "type": "text"
        }
      ]
    },
    {
