              },
              "items": [
                {
                  "text": "Isa 40.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Johana aarî mûndû ûrîa Mûrathi Isaia aaragia ûvoro wake rîrîa aaugire atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
          }
        }
      ]
