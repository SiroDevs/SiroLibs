          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.8"
              },
              "items": [
                {
                  "text": "2Atha 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Johana eekagîra nguo yathondeketwe na guoya wa ngamîîra. Eeyovaga mûcivi wa rûûo kîûnûrî, na irio irîa aarîcaga ciarî ngige na ûûkî wa kîthaka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû nîmaathiîre kûrî ke maumîte îtûûrarî rîa Jerusalemu vûrûrirî wa Judea kuonthe na kuuma vûrûri wonthe ûrîa ûrî vakuvî na rûnjî rwa Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andû acio nîmaaumbûrire mevia mao, na Johana akîmavatithîria rûnjîrî rwa Jorodani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
