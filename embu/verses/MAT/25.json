                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.28"
              },
              "items": [
                {
                  "text": "19.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Vîndî îrîa Mûrû wa Mûndû agaacoka arî Mûthamaki, na arî na araika ake onthe, nîagekarîra gîtî gîake Kîam ûthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû a mavûrûri monthe nîmagacokanîrîrua vamwe vau mbere yake. Nake nîagaacoka amagaanie ikundi igîrî, wata ûrîa mûrîthi aamûranagia ng'ondu kuuma kûrî mbûri. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ke nîakaaiga andû arîa athingu mwena wake wa ûrîo, na acio engî amaige mwena wake wa ûmotho. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki nîagaacoka ere andû arîa makeethîrwa marî mwena wake wa ûrîo atîrî, ‘Ûkani mue arîa mûrathimîtwe nî Vava! Ûkani mûgwate Ûthamaki ûrîa wavarîrîtue nîûndû wenyu kuuma wa Kîammbîrîria gîa kûmbwa kwa nthî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû nie naarî mûvûtu na mûkîmva kîndû gîa kûrîa, naarî mûnyondu na mûkîmva kîndû gîa kûnyua, naarî mûgeni na mûkûnyita ûgeni kwenyu mûciî, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "na naarî njaga na mûkîmva nguo ya gwîkîra. Nie naarî mûrûaru na mûkîmenyerera, na rîrîa naarî njeera nîmwaûkire kûmona.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
