        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Na vîndî îrîa mûrenyerekia tigagani kwiria mothiû menyu ta ûrîa mvinga ciîkaga. Mvinga ciragia mothiû ma cio nîguo cionwe nî andû onthe atî nîirenyerekia. Nîramwîra na ma atî, mvinga icio nîirîkîtie kûvewa mûcara wacio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî vîndî îrîa mûrenyerekia, îthambagieni mothiû menyu na mûgacanûra njuîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîguo andû arîa engî matikamenye atî nîkwa mûrenyerekia. Îthe wenyu ûrîa ûtonekaga nîke tu ûkaamenya. Nake Îthe wenyu ûrîa wonaga maûndû marîa mekagîrwa nthithorî nîakaamûva mûcara wenyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îigîreni ûtonga îgûrû kwa Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
