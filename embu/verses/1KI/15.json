          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû marîa mengî monthe marîa Nadabu eekire nîmandîke îvukuurî rîa maûndû ma tene ma Athamaki a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa, mûthamaki wa Juda na Baasha, mûthamaki wa Isiraeli maatûûraga marûaga îvindarî rîao rîonthe rîrîa maarî athamaki.",
          "type": "text",
