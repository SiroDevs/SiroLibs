              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa kaîrî Asa arî mûthamaki wa Juda, Nadabu, mûvîcî wa mûthamaki Jeroboamu nîwatuîkire mûthamaki wa Isiraeli, na nîwathanire Isiraeli îvinda rîa mîaka îîrî (2). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwekire maûndû macûku mbere ya Ngai-Mûnene, na akîrûmîrîra mîtugo mîcûku ya îthe, na mevia make magîtûma Aisiraeli mevie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        }
      ]
    },
    {
