              "1KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakarî wa mîrongo îîrî (20) Jeroboamu arî mûthamaki wa Isiraeli, Asa nîwatuîkire mûthamaki wa Juda, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.9",
            "verseOrgIds": [
              "1KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akîathana îvinda rîa mîaka mîrongo îna na ûmwe (41) arî Jerusalemu. Ng'ina eetagwa Maaka, mwarî wa Abusalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.10",
            "verseOrgIds": [
              "1KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa nîwekire maûndû marîa maakenagia Ngai-Mûnene wata ûrîa Daudi eekaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.11",
            "verseOrgIds": [
              "1KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.8+2CH.15.9+2CH.15.10+2CH.15.11+2CH.15.12+2CH.15.13+2CH.15.14+2CH.15.15"
              },
              "items": [
                {
                  "text": "2Maû 15.8-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîwengatire kuuma vûrûrirî arûme na aka onthe arîa maarî maraa ma ndini na akîruta mîvuanano yonthe îrîa yarûthîtwe nî methe mao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.12",
            "verseOrgIds": [
              "1KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwacokire agîtigithia ng'ina kûthiî na mbere arî mûthamaki wa mûndûmûka, nîûndû nîwarûthire mûvuanano wa ngai ya mûndûmûka ya Ashera. Asa nîwatemangire mûvuanano ûcio na akîûvîvîria Kîamndarî gîa karûnjî ga Kidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.13",
            "verseOrgIds": [
              "1KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana ethîrwa Asa ndaacûkangia kûndû kuonthe kûrîa gûtûgîru gwa kûgoocagîrwa, nîwatûûrire arî mwîvokeku kûrî Ngai-Mûnene ûtûûrorî wake wonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.14",
            "verseOrgIds": [
              "1KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwaigire hekarûrî indo cionthe irîa îthe aamûrîrîte Ngai-Mûnene, wa vamwe na indo cia thaavu na sîlûva na indo ciîngî irîa ke mwene aamûrîrîte Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.15",
            "verseOrgIds": [
              "1KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa mûthamaki wa Juda na Baasha, mûthamaki wa Isiraeli maatûûraga marûaga îvindarî rîao rîonthe rîrîa maarî athamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.16",
            "verseOrgIds": [
              "1KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha, mûthamaki wa Isiraeli nîwathiîre nîguo akarûe na Juda. Nîwatumire rûthingo rwa vinya Rama, nîguo arigîrîrie andû matikaume kana matonye Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.17",
            "verseOrgIds": [
              "1KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa nîwacokire akîruta sîlûva yonthe na thaavu irîa ciatigîtwe hekarûrî na nyombarî ya mûthamaki. Nîwainenganîre kûrî ndungata ciake na agîciîra ivirîre mûthamaki Benihadadi, mûvîcî wa Tabirimoni. Tabirimoni aarî mûvîcî wa Hezioni, mûthamaki wa Sîria, ûrîa watûûraga Damesiki. Nîwerire ndungata icio ciîre Benihadadi atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.18",
            "verseOrgIds": [
              "1KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiga tûgwatanîre wata ûrîa aa vava maagwatanîrîte. Kîveo gîkî gîa sîlûva na thaavu nîkîo nagûtûmanîra; rîu thiî ûthûkie ngwatanîro yenyu na Baasha, mûthamaki wa Isiraeli, nîguo atige kûntharîkîra.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.19",
            "verseOrgIds": [
              "1KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake mûthamaki Benihadadi nîwetîkîre ûrîa mûthamaki Asa aamwîrire, na nîwatûmire anene a athigari ake a mbaara mathiî makatharîkîre matûûra marîa manene ma Isiraeli. Nîmaavootire Ijoni, Dani, Abeli-bethi-maaka na kûndû kûrîa kwarî vakuvî na Îria rîa Galili, vamwe na vûrûri wonthe wa Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.20",
            "verseOrgIds": [
              "1KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûthamaki Baasha eegwire ûvoro ûcio, nîwatigire gûtuma rûthingo rwa Rama na akîthiî gûtûûra Tiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.21",
            "verseOrgIds": [
              "1KI.15.21"
            ]
          }
        }
      ]
    },
