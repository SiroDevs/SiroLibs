          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.8",
            "verseOrgIds": [
              "1KI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benidekeri, ûrîa wathanaga matûûrarî ma Makazu, Shalubimu, Bethishemeshi, Eloni, na Bethi-hanani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
