        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.9",
            "verseOrgIds": [
              "1KI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihesedi, ûrîa wathanaga matûûrarî marîa manene ma Arubathu, Soko na vûrûri wonthe wa Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.10",
            "verseOrgIds": [
              "1KI.4.10"
            ]
          }
        }
      ]
    },
    {
