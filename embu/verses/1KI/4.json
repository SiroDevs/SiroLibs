          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benigeberi aathanaga îtûûrarî rîa Ramothi rîrîa rîarî Gileadi na icagi cia Gileadi cia mûvîrîga wa Jairi. Jairi aarî wa rûciaro rwa Manase. Nwa wathaga vûrûri wa Arigobu kûrîa Bashani na kûu nîkuo kwarî na matûûra mîrongo îtandatû marîa manene mairigîrîtwe na nthingo, na ivingo ciathondeketwe na cuuma cia gîcango.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.13",
            "verseOrgIds": [
              "1KI.4.13"
            ]
          }
        }
