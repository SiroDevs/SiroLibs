    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûthamaki wa Solomoni nîwanenevire",
          "type": "text"
        }
      ]
    },
    {
