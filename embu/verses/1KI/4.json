              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai nîwavere Solomoni ûûgî na ûmenyo ûtarî kîthimi vamwe na ûtaana wa ngoro mwîngî ta mûthanga ûrîa wîthagîrwa ûrî rûtererî rwa îria. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.29",
            "verseOrgIds": [
              "1KI.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni aarî na ûûgî mwîngî gûkîra andû onthe a mwena wa îrathîro, na ûûgî mwîngî gûkîra andû onthe a Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.30",
            "verseOrgIds": [
              "1KI.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
