            "sid": "1KI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benabinadabu ûrîa wavikîtie Tafathu mwarî wa Solomoni nake aathaga vûrûri wonthe wa Dori.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.11",
            "verseOrgIds": [
              "1KI.4.11"
            ]
          }
        }
