                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîwatungire nthimo ngiri ithatû (3,000), na akina nyîmbo ngiri îmwe na ithano (1,005). ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.32",
            "verseOrgIds": [
              "1KI.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwagwetire ûvoro wîgiî mîtî, ambîrîrîtie na mûtarakwe ûrîa ûrî Lebanoni, nginya hisofu ûrîa ûmeraga rûthingorî. Wana nîwagwetire ûvoro wîgiî nyamû cia kîthaka, iconi, nyamû irîa ikurumaga nthî, wana nthamaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.33",
            "verseOrgIds": [
              "1KI.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athamaki onthe a nthî nîmegwire ûvoro wîgiî ûûgî wa Solomoni na magîtûma andû mathiî makamûthikîrîrie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
