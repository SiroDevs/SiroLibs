            "number": "27",
            "style": "v",
            "sid": "1KI 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anene acio nîmaaviragîra mûthamaki Solomoni irio, na makavirîra andû onthe arîa maatûûraga kwa mûthamaki Solomoni. Wa mûndû aaviraga irio mweri ûmwe na nîmaaviraga indo cionthe irîa ciavataranagia. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.27",
            "verseOrgIds": [
              "1KI.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana nîmaaviraga gîcunjî gîa cairi na irio cia mbarathi cia ikaari cia mbaara na cia mbarathi irîa ciîngî wa kûrîa ciavataranagia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.28",
            "verseOrgIds": [
              "1KI.4.28"
            ]
          }
        }
      ]
