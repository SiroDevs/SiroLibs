                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2Maû 9.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîwathiîre na indo cionthe irîa ciarî hekarûrî, na irîa ciarî nyombarî ya mûthamaki, wa vamwe na ngo cia thaavu irîa Solomoni aarûthîte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.26",
            "verseOrgIds": [
              "1KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vandûrî va cio Solomoni nîwarûthire ngo cia gîcango na akîinenganîra kûrî anene a agitîri a kîvingo Kîam mûciî wa mûthamaki nîguo maimenyagîrîre. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.27",
            "verseOrgIds": [
              "1KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî cionthe rîrîa mûthamaki aatonyaga hekarûrî, agitîri a kîvingo nîmaakuuaga ngo icio na makaivira nyombarî ya agitîri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.28",
            "verseOrgIds": [
              "1KI.14.28"
            ]
          }
        }
