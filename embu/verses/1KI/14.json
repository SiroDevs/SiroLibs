              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû marîa mengî monthe marîa mûthamaki Rehoboamu eekire nîmandîke îvukuurî rîa maûndû ma tene ma Athamaki a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.29",
            "verseOrgIds": [
              "1KI.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vîndî îo yonthe Rehoboamu na Jeroboamu maatûûraga marûaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
              "1KI.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehoboamu nîwakwire na akîthikwa mbîrîrarî îrîa ciathikagwa athamaki îtûûrarî rîa Daudi. Mûvîcî Abija nîwatuîkire mûthamaki vuva wake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.31",
