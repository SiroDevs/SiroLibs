          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariû na aarî a îthe wetû, ethîrwa gatagatîrî kenyu nîkûrî mûndû wana ûmwe ûûrîte akauma ûvororî wa ma nake mûndû wîngî akamûcokia, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.19",
            "verseOrgIds": [
              "JAS.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JAS 5:20"
          },
          "items": [
