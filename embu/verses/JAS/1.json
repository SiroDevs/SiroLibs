              ]
            }
          ]
        },
        {
          "text": " Nie Jakuvu ndungata ya Ngai na ya Mwathani Jesû Kristû:",
          "type": "text",
          "attrs": {
            "verseId": "JAS.1.1",
            "verseOrgIds": [
              "JAS.1.1"
