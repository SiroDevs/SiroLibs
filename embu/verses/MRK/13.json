            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tathomani kuumana na mûkûyû mwone atî kavinda karîa mvûa ciaguo ciambîrîria kûruta mathangû, nîmûmenyaga atî vîndî ya mbura",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13.28",
              "type": "text"
            },
            {
              "text": "vîndî ya mbura:",
              "type": "text"
            },
            {
              "text": "Kîrîkanîro kiugîte vîndî ya riûa, nwatî gûkû Afirika ya gatagatî mîtî îrutaga mathangû rîrîa mbura îrî vakuvî kuura nwatî tî vîndî ya riûa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " îrî vakuvî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo rîrîa mûkoona maûndû mama magîkîka nîmûkaamenya atî Mûrû wa Mûndû arî vakuvî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîramwîra na ma atî, rûciaro rûrû rûtikaathira maûndû mama monthe matarî mekîku. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgûrû",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13.31",
              "type": "text"
            },
            {
              "text": "Îgûrû:",
              "type": "text"
            },
            {
              "text": "Kiugo gîkî gîtironania îkenero nwatî kîronania kîrîa kîonthe kîrî matuurî.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na nthî nîikaathira, nwatî ciugo ciakwa itikaathira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûtirî mûndû wîcî mûthenya kana îthaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
