                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mîthenyarî îo vîndî ya mathîna yavîtûka riûa nîrîgaatuîka nduma mweri ûtige kwara, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.24",
