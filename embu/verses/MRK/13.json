                "loc": "ACT.6.13"
              },
              "items": [
                {
                  "text": "Ciîko 6.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " njata igwe nthî kuuma îgûrû, na maavinya marîa marî îgûrû mainainue. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
