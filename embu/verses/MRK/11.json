            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Jesû nîwamacokerie atîrî, “Nîngûmûria kîûria kîmwe tu, na mwanjokeria nîngûmwîra mbîkaga maûndû mama na wathani ûrîkû. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambîrani atîrî, Johana aavatithanagia na wathani ûrîkû, warî wa kuuma kûrî Ngai kana kûrî andû?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.30",
            "verseOrgIds": [
              "MRK.11.30"
            ]
          }
        }
      ]
