          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî mûngîrega kwovanîra, wana îthe wenyu ûrîa wî îgûrû ndangîmwovera mevia menyu.]",
          "type": "text",
          "attrs": {
