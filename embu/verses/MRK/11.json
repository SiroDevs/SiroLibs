          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîramwîra atî, ûndû wa wonthe mûngîtia rîrîa mûkûvoya, îtîkagiani atî nîmûrîkîtie kûvingîrua, namue mûkaavecagwa kîndû wa kîonthe kîrîa mûkaavoyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
