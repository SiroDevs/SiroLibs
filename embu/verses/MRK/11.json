          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nîmaacokerie Jesû atîrî, “Tue tûtiîcî.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
      ]
    },
