              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû na arutwa ake nîmaakinyire Jerusalemu rîngî. Rîrîa Jesû aathiîrîrîte kûu hekarûrî, anene a athînjîri-Ngai, arimû a Watho na athuuri, nîmaathiîre kûrî ke ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
