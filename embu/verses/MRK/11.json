          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na makîmûûria atîrî, “Ûreka maûndû mama na wathani ûrîkû, na nû ûkûvete wathani ûcio?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.28",
            "verseOrgIds": [
              "MRK.11.28"
            ]
          }
        }
      ]
