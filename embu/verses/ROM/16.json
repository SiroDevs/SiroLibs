              "text": "16.24",
              "type": "text"
            },
            {
              "text": "Wega wa Mwathani wetû Jesû Kristû ûrogîa namue:",
              "type": "text"
            },
            {
              "text": "Mandîko mamwe matirî mûvari ûyû.",
              "type": "text"
            }
