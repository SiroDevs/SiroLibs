              "items": [
                {
                  "text": "Ciîko 16.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nîmwakethua nî Timotheo, ûrîa tûrutaga wîra vamwe nake, wana Lukio, na Jasoni, na Sosipateri arîa tûrî a rûrîra rûmwe nîmamûkethia.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
