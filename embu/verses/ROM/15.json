              "items": [
                {
                  "text": "1Akor 9.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O ene nîmaakenere gwîka ûguo na nî ma nîmaagîrîrwe nî kûmatethia. Nîûndû ethîrwa Ayahudi nîmagaanîte kîrathimo Kîamo gîa kîîroho na andû a Ndûrîrî, andû a Ndûrîrî wanao nîmagîrîrwe nî kûruta indo ciao nîguo matethie Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narîkia kwona atî andû a kanitha wa Jerusalemu nîmamûkîra ûtethio ûrîa wavecanîtwe nîûndû wao, nîngaaûkîrîra kûu kwenyu ngîthiî Sipania. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nîmbîcî atî rîrîa ngaûka kûrî mue, nîngaamûretera kîrathimo gîcûru kuuma kûrî Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        }
      ]
