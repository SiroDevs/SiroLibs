          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.13"
              },
              "items": [
                {
                  "text": "Aro 1.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nîûndû wa gîtûmi gîkî, nie nînaaremirwe nî gûka kwenyu mavinda meengî. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.22",
            "verseOrgIds": [
              "ROM.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîu nîndîkîtie wîra wakwa wonthe gîcunjîrî gîkî. Na nîûndû vandû va mîaka mîngî mbîthîrîtwe ngîenda gûka kûmwona, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.23",
            "verseOrgIds": [
              "ROM.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîmbîrîgîrîrîte gwîka guo rîu. Mbere ya gûkinya Sipania, nwa mende kûmwona na narîkia gûkenanîra na mue gwa kavinda, mûndethereria kûthiî kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.24",
            "verseOrgIds": [
              "ROM.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.1+1CO.16.2+1CO.16.3+1CO.16.4"
              },
              "items": [
                {
                  "text": "1Akor 16.1-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu nthiîte Jerusalemu kûvirîra andû a Ngai ûtethio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.25",
            "verseOrgIds": [
              "ROM.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû etîkia arîa marî Makedonia na Akaia nîmarutîte indo ciao matakûringîrîrua nîguo matethie andû a Ngai arîa athîni kûu Jerusalemu. ",
          "type": "text",
          "attrs": {
