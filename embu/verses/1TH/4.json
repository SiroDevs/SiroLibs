            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.51+1CO.15.52"
              },
              "items": [
                {
                  "text": "1Akor 15.51-52",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maûndû mama tûramûthomithia nî ndûmîrîri ya Mwathani, nîûndû tue arîa tûkethîrwa tûrî mwoyo rîrîa Mwathani agaaûka, tûtikaathiî mbere ya arîa maakuire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû Mwathani nîakaanyûrûka kuuma îgûrû Kîamthanaga augîrîrîtie na mûgambo wa mûraika ûrîa mûnene na karumbeta ka Ngai. Vîndî îo, arîa makeethîrwa maakuire metîkîtie Kristû nîo makamba kûriûka. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vuva wa ûguo, tue arîa tûkethîrwa tûrî mwoyo nîtûgaacokanîrîra vamwe nao matuurî nîguo tûtûnge Mwathani rîerarî. Kwoguo tûgatûûraga na Mwathani tene na tene. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ûmanagîrîriani na ciugo ino.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
