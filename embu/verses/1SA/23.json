{
  "id": "1SA.23",
  "number": "23",
  "bookId": "1SA",
  "reference": "1Sam 23",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
