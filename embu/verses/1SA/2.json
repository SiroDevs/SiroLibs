            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nake Samueli nîwathiîre na mbere gûkûra akîendagwa nî Ngai-Mûnene wana andû.",
          "type": "text",
          "attrs": {
