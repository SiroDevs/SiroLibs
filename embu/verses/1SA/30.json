          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroeri, Sifimothu, Eshitemo, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
