          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakali, matûûrarî ma Ajerameeli, matûûrarî ma Aakeni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
