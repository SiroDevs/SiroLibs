          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Daudi aacokire Zikilagi, nîwavecanire indo imwe cia irîa ciatavîtwe kûrî arata ake arîa maarî atongoria a Juda, na akîmeera atîrî, “Gîkî nîkîo kîveo kîenyu kîrîa kiumîte kûrî indo irîa itavîtwe kuuma kûrî nthû cia Ngai-Mûnene.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîwavecanire indo imwe kûrî andû a Betheli, kûrî andû a Ramothu arîa marî mwena wa îveti wa Juda, kûrî andû a Jatiru, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
