            "sid": "2JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nie nînakenire mûno nona ciana imwe ciaku ikîrûmîrîra ûvoro wa ma wata ûrîa twathirwe nî Vava wetû. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.4",
            "verseOrgIds": [
              "2JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
