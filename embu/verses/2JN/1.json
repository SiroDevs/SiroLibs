          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciana cia mwarwanyûkwe ûrîa mûtîîe nîciagûkethia.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
