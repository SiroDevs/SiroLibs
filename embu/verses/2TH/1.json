            }
          ]
        },
        {
          "text": " Kuuma kûrî tue Paûlo, Sailasi na Timotheo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
