            "sid": "2TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî andû a kanitha ûrîa ûrî Thesalonike. Andû aya nî a Ngai îthe wetû na Mwathani wetû Jesû Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.1.1",
            "verseOrgIds": [
              "2TH.1.1"
            ]
          }
        }
      ]
    },
    {
