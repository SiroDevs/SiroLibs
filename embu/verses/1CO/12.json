              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo îîriragîrieni na vinya kûgîa na iveo irîa irî vata mûno makîria.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.31",
