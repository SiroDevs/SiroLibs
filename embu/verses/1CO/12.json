              "items": [
                {
                  "text": "Aef 4.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kanitharî Ngai nîathuurîte: amwe matuîke atûmwa, engî arathi, na kathatû akathuura arimû. Nîacokete akathuura aringi ciama; makarûmîrîrwa nî arîa mavetwe ûvoti wa kûvonania, arîa matethagia arîa engî, atongoria na arîa maragia na nthiomi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.28",
            "verseOrgIds": [
              "1CO.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tî andû onthe methagîrwa marî atûmwa, kana arathi, kana arimû, kana aringi ciama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.29",
            "verseOrgIds": [
              "1CO.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tî andû onthe methagîrwa mavetwe ûvoti wa kûvonia mîrimû, kana ûvoti wa kwaria na nthiomi ng'eni kana ûvoti wa gûtaarîria nthiomi icio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.30",
            "verseOrgIds": [
              "1CO.12.30"
            ]
          }
        },
        {
