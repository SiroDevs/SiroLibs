              "type": "text"
            }
          ]
        },
        {
          "text": "Mue muonthe vamwe mûrî mwîrî wa Kristû na wa ûmwe gatagatîrî kenyu nî kîîga Kîam mwîrî ûcio. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.12.27",
