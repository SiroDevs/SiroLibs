            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo ariû na aarî a îthe wetû, vîndî îrîa mûcemanîtie kûrîa Irio cia Mwathani cia Kîvwaî, etanagîrîrani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûndû wa wonthe mûvûtu, nîambage kûrîa mûciî, nîguo rîrîa tûcemanîtie vamwe Ngai ndagatûtuîre. Rîrîa ngaaûka kûrî mue nîngamwatha ûrîa mûgeeka maûndû mau mengî.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.34",
            "verseOrgIds": [
              "1CO.11.34"
            ]
          }
        }
      ]
