              },
              "items": [
                {
                  "text": "Afil 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îîgerekanagieni nanie wata ûrîa nîgerekanagia na Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
        }
