            "verseId": "1CO.6.11",
            "verseOrgIds": [
              "1CO.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
