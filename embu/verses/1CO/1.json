                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Jer 9.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kwoguo wata ûrîa mandîko matheru maugîte: “Mûndû wa wonthe ûngîenda gwîtîîa nîetîîe na maûndû marîa Mwathani ekîte.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        }
      ]
