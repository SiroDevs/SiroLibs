                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "19.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.23"
              },
              "items": [
                {
                  "text": "Aro 16.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nie nîracokia ngatho kûrî Ngai nîûndû ndiavatithia mûndû wana ûmwe gatagatîrî kenyu tiga Kirisipo na Gayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo gûtirî mûndû wana ûmwe gatagatîrî kenyu ûngiuga atî mue mwavatithirue na rîîtwa rîakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.15"
              },
              "items": [
                {
                  "text": "1Akor 16.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (Îni, nie nînavatithirie Sitefana na andû a gwake mûciî. Nwatî ndiraririkana kana nînavatithirie mûndû wîngî wana ûmwe.) ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû ndaandûma nîguo mvatithanie. Nwatî aandûmire nîguo ngavunjie Ûvoro Mwaro. Aandûmire ngavunjie ûvoro ûcio ndagûtûmîra ûûgî ûrîa umanîte na ûûmûndû. Nekire ûguo nîguo gûkua gwa Kristû mûtharavarî gûtigaatuîke kwa mana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristû nîke vinya na ûûgî wa Ngai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû Ndûmîrîri îrîa îgiî gûkua gwa Kristû mûtharavarî nî ûrimû kûrî arîa maraûra, nwatî kûrî tue arîa tûravonokua ndûmîrîri îo nîyo vinya wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.14"
              },
              "items": [
                {
                  "text": "Isa 29.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mandîko matheru maugîte atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûringana na ûûgî wake, Ngai nîwatûmire andû matikaamûmenye na njîra ya ûûgî wao. Vandû va ûguo, na njîra ya ndûmîrîri îo îtucagwa ya “ûrimû” îrîa tue tûvunjagia, Ngai nîwatuire atî nîakaavonokia arîa mamwîtîkîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayahudi mendaga maringîrwe ciama nao Angiriki macaragia ûûgî. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
            "verseOrgIds": [
              "1CO.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî tue tûvunjagia ûvoro wîgiî Kristû ûrîa mwambe. Ayahudi monaga ûvoro ûcio ûrî mûvînga, nao andû a Ndûrîrî makawona ûrî ûrimû. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.23",
            "verseOrgIds": [
              "1CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî kûrî arîa Ngai etîte, Ayahudi na andû a Ndûrîrî, ndûmîrîri ya Kristû nî vinya na ûûgî wa Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.24",
            "verseOrgIds": [
              "1CO.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîûndû ûndû ûrîa wonekaga takwa ûrî ûrimû wa Ngai, wîthagîrwa ûrî na ûûgî mwîngî gûkîra ûûgî wa mûndû. Naguo ûndû ûrîa ûtûmaga Ngai onekane takwa atarî na vinya, ûndû ûcio wîthagîrwa ûrî na vinya îkîrîte vinya ya mûndû.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.25",
            "verseOrgIds": [
              "1CO.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariû na aarî a îthe wetû, taririkanani ûrîa mwekariî rîrîa Ngai aamwîtire. Kûringana na woni wa andû, tî eengî gatagatîrî kenyu maarî aûgî kana maarî na vinya wana kana maaciarîrwe mîciîrî ya vata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.26",
            "verseOrgIds": [
              "1CO.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Ngai nîwathuurire maûndû marîa andû matucaga nî ma ûrimû nîguo aconorithie arîa aûgî, na nîwathuurire arîa matucagwa nî andû atî matirî vinya nîguo aconorithie arîa methagîrwa marî na vinya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.27",
            "verseOrgIds": [
              "1CO.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai nîwathuurire maûndû marîa andû monaga matarî vata na makamanyarara na meciragîrua atî tî kîndû varî nîguo acûkangie kîrîa gîtucagwa nî andû atî nî Kîam vata. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.28",
            "verseOrgIds": [
              "1CO.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai eekire ûguo nîguo gûtikagîe na mûndû wana ûmwe ûgwîtîîa arî mbere ya Ngai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.29",
            "verseOrgIds": [
              "1CO.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî Ngai nîke kiumo Kîam ûûrûmwe wenyu na Jesû Kristû. Na njîra ya Kristû Ngai nîatûvecaga ûûgî na agatûtua athingu. Natue nîtûtuîkaga andû a Ngai na tûgakûrwa kuuma meviarî metû. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.30",
            "verseOrgIds": [
              "1CO.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
