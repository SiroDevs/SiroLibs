          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao nîmaaugîrîrie atîrî, “Îno nî nthakame! Nama, athamaki acio athatû nîmarûîte na makaûragana o ene! Tûthiîni tûgatave indo ciao!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.23",
            "verseOrgIds": [
              "2KI.3.23"
            ]
          }
        }
