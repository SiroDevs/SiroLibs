          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Amoabu maaramûkire kîraûko tene mûthenya ûcio warûmîrîrîte, nîmoonire riûa rîmûrîkîte manjî, namo manjî makonekaga matunîvîte ta nthakame. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.22",
            "verseOrgIds": [
              "2KI.3.22"
            ]
          }
        },
