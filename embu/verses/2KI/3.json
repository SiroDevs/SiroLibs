              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîrîa Amoabu maathiîre kûrîa andû a Isiraeli maambîte magema mao, andû a Isiraeli nîmaatharîkîre Amoabu nginya makîûra. Andû a Isiraeli nîmaarûmîrîrie Amoabu wa makîmaûragaga, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.24",
            "verseOrgIds": [
              "2KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
