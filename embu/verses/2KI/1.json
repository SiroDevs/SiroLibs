          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwamaûririe atîrî, “Mûndûmûrûme ûcio ûmûtûngire na amwîra maûndû mau arekariî atîa?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.7",
            "verseOrgIds": [
              "2KI.1.7"
            ]
          }
        }
      ]
    },
