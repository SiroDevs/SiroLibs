          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki nîwacokire agîtûma mûnene wa athigari mîrongo îtano na athigari acio mathiî makagîre Elija. Mûnene ûcio nîwethîre Elija ekarîte nthî gacûmbîrî ga kîrîma na akîmwîra atîrî, “Mûndû wa Ngai, mûthamaki akwîra ûnyûrûrûke.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
