          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî nîmaamûringîrîrie nginya akîgua nthoni na akîmetîkîria mathiî. Arûme acio mîrongo îtano nîmaathiîre na magîcaria Elija îvinda rîa mîthenya îthatû, nwatî matiamwona. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîmaacokire kûrî Elisha, ûrîa wetererete arî Jeriko na akîmaûria atîrî, “Kinthî ndiamwîrire mûtikathiî?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciama irîa Elisha aaringire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
