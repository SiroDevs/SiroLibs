              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nake Elisha nîwamerire atîrî, “Naarî, tîmûthiî.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
