          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha nîwaumire Jeriko na akîthiî Betheli. Arî njîrarî, tûvîcî tûnini nîtwaumire na kûu îtûûrarî rînene tûkîmûthekerera tûkiugagîrîria atîrî, “Uma gûkû, kîvara gîkî! Uma gûkû, kîvara gîkî!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
