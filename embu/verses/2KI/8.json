            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Vîndî ya ûthamaki wa Jehoramu, andû a Edomu nîmaaregire kwathwa nî mûthamaki wa Juda na nîmaathuurire mûthamaki wao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
