            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo Jehoramu na anene ake onthe a ikaari ciake cia mbaara nîmaambîrîrie rûgendo ûtukû na makîthiî Zairi, na makîûraga andû a Edomu arîa maamûthiûrûrûkîrîtie. Nwatî athigari a mbaara a Edomu nîmaaûrire makîthiî kwao mîciî. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo andû a Edomu nîmaaregire kwathagwa nî mûthamaki wa Juda nginya ûmûnthî. Îvindarî wa rîu nwarîo andû a îtûûra înene rîa Libuna wanao maareganire na wathani wa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
