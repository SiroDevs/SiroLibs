              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Solomoni nîwacokire akiuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
