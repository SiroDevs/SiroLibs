          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûndû wa wonthe angîkaavoya kana andû aku onthe a Isiraeli makûvoe wa mûndû arî na mathîna make na ruuo rwa ngoro na avoe atambarûkîtie njara ciake erekerete hekarûrî îno, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
