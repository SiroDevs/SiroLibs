          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ûkegua mavoya mao ûrî kûu îgûrû. Ûcoke ûmovere nîûndû we, nîwe wicî ngoro cia andû. Ûgeeka kûringana na ûrîa wa mûndû agîrîrwe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
