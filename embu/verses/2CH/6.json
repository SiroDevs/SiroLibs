              "text": "6.28",
              "type": "text"
            },
            {
              "text": "milideu:",
              "type": "text"
            },
            {
              "text": "mûrimû wekariî ta mûrimû mûcûku wa ngothi.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kana ndavaîki, kana ngige, kana igunyû, kana andû matharîkîrwe nî nthû ciao, kana kwîthîrwe na mûthiro, kana mûrimû wa wonthe, ",
          "type": "text",
          "attrs": {
