              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "mangîkeerira na makûvoe makiumbûraga ûrîa mevîtie na makarûtha maûndû macûku marî kûu maavirirwe marî mîgwate, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
