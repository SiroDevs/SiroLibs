          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "we Ngai-Mûnene nakûthaitha ûkaathikîrîria ûrî kûu îgûrû na ûtue ciira wa ndungata ciaku. Ûkaaverithia mûndû ûrîa ûkethîrwa avîtîtie na ûkaarekereria mûndû ûrîa ûkethîrwa atarî na mavîtia kûringana na ûthingu wake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
