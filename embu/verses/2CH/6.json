        },
        {
          "text": "“Mûndû angîvîtîria mûndû ûrîa wîngî na avirwe mbere ya metha yaku ya kîgongoona hekarûrî îno na evîtithue, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
