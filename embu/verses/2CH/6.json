          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ûkeegua mavoya mao ûrî kûu îgûrû. Ûkaamovera mevia mao na ûmacokie vûrûrirî ûrîa wamaveere na ûkîva methe mao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
