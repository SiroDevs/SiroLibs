              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîguo andû aku magwîtigagîre na makwathîkagîre vîndî cionthe rîrîa magûtûûra vûrûrirî ûyû waveere methe metû.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
