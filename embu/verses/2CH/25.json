        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazia ûrîa warî mûthamaki wa Juda nîwatûûrire îvinda rîa mîaka îkûmi na îtano (15) kuuma Joashi mûvîcî wa Jehoahazi, ûrîa warî mûthamaki wa Isiraeli akua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû marîa mengî monthe marîa mûthamaki Amazia eekire kuuma ma mbere nginya ma mûthiia nîmandîke îvukuurî rîa athamaki a Juda na a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma rîrîa Amazia aatiganîrie Ngai-Mûnene andû a Jerusalemu nîmaavangire maregane nake. Mûthiiarî nîwaûrire akîthiî îtûûrarî rîa Lakishi. Nwatî andû acio maareganaga nake nîmaatûmire andû mathiî mamûrûmîrîrie kûu Lakishi na nîmaamûragîre kuo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwîrî wake nîwakuuirwe na mbarathi na ûkîvirwa Jerusalemu, ûkîthikwa mbîrîrarî irîa ciathikagwa athamaki îtûûrarî rîa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
