          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.4",
            "verseOrgIds": [
              "2CH.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
