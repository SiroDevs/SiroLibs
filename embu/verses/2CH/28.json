          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû marîa mengî monthe marîa eekire na mîthiîre yake yonthe arî mûthamaki kuuma Kîammbîrîria nginya mûthiia, nîmandîke îvukuurî rîa ng'ano cia athamaki a Juda na a Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.26",
            "verseOrgIds": [
              "2CH.28.26"
            ]
          }
        },
        {
