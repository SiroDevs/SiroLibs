          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni nîwathaamirie mûka, mwarî wa mûthamaki wa Misiri kuuma îtûûrarî rîa Daudi akîmûvira nyombarî îrîa aamûtumîrîte. Nîwaugire atîrî, “Mûka wakwa ndagûtûûra nyombarî ya Daudi mûthamaki wa Isiraeli, nîûndû vandû wa vonthe varîa îthandûkû rîa kîrîkanîro Kîam Ngai-Mûnene rîanethîrwa rîrî nî vatheru.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni nîwarutîre Ngai-Mûnene matega ma kûvîvua metharî ya kîgongoona îrîa aatumîte îrî kîthakurî gîa hekarû. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
