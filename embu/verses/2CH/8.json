            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûguo nîguo wîra wonthe ûrîa Solomoni aarî naguo wa gûtuma hekarû ya Ngai-Mûnene wathirire kuuma mûthenya ûrîa mûcingi wayo wambîrîrue. Kwoguo hekarû ya Ngai-Mûnene nîyarîkire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Solomoni nîwacokire akîthiî Ezioni-geberi na Elothi, matûûra marîa maarî rûtere rwa îria vûrûrirî wa Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Huramu nîwatûmîre Solomoni meri itongoretue nî anene ake na ndungata ciake irîa ciaicî kûthiîrîra îriarî mûno. Nao, marî vamwe na andû a Solomoni nîmaathiîre vûrûrirî wa Ofiri na makîretere Solomoni thaavu ya ûrito wa makîria ma kilo ngiri îkûmi na ithano (15,000).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
