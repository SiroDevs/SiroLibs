              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa mûthamaki Solomoni aarîkirie kûvoya, mwaki nîwanyûrûrûkire kuuma îgûrû na ûkîvîvia magongoona na matega marîa maarutîtwe. Naguo riiri wa Ngai-Mûnene nîwecûrire hekarûrî. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athînjîri-Ngai nîmaaremirwe nî gûtonya hekarûrî nîûndû nîyecûrîtwe nî riiri wa Ngai-Mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
