        "style": "s1"
      },
      "items": [
        {
          "text": "Josia, mûthamaki wa Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
