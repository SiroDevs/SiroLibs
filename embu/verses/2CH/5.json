          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.34+EXO.40.35"
              },
              "items": [
                {
                  "text": "Ntha 40.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aini a nyîmbo, ngita, ithaani irîa iringithanagua, tûrumbeta na indo irîa ciîngî cia kwina nîmaagwatanîre na makina na mûgambo ûmwe magîkumia Ngai-Mûnene na kûmûcokeria ngatho makiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hekarû ya Ngai-Mûnene nîyecûrirwe nî îtu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na athînjîri-Ngai matingîavotire kûthiî na mbere na wîra wao nîûndû hekarû nîyecûrirwe nî ûkengu wa riiri wa Ngai-Mûnene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
