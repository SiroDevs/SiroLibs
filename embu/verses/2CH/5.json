                  "text": "1Maû 18.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûguo nîguo mûthamaki Solomoni aarîkirie wîra wonthe wa hekarû. Nîwacokire akîrete indo cionthe irîa îthe Daudi aamûrîrîte Ngai-Mûnene na agîciga tûnyombarî twa hekarû twa kwigwa indo. Indo icio ciarî sîlûva, thaavu na indo cionthe cia hekarû.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îthandûkû rîa kîrîkanîro nîrîaretirwe hekarûrî",
          "type": "text"
        }
      ]
    },
