              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrî andû arîa metîtwe nî Ngai na arîa matwîre mendetwe nî Ngai Vava na mûkamenyererwa nî Jesû Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.1",
