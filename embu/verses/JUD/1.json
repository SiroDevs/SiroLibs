        },
        {
          "text": "Mûrotuîka a kwîngîvîrwa nî ntha, thayû na wendani.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.2",
            "verseOrgIds": [
              "JUD.1.2"
            ]
