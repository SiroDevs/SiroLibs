            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthamaki Ahasuerusi nîwathanire andû onthe a vûrûri wake na arîa matûûraga rûtere rwa îria marîve gooti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maûndû monthe marîa mûthamaki Ahasuerusi eekîte na rûgano ruonthe rwa ûrîa aanenevirie Moridekai agîkinya ngathî îrîa nene viû wathanirî wake, nîmandîke îvukuurî rîa maûndû ma tene ma athamaki a Media na Perisia. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moridekai aarî wa kaîrî wathanirî kuuma kûrî mûthamaki Ahasuerusi. Aarî mûtîîe mûno na akendwa nî Ayahudi arîa engî. Nîwarutaga wîra mwaro mûno kûrî andû ake nîguo magîe na ûtûûro mwaro na njiarwa ciake cionthe ciîthagîrwe irî na thayû.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
