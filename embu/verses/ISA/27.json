                }
              ]
            }
          ]
        },
        {
          "text": " Mûthenya ûcio, Ngai-Mûnene nîagooca rûviû rwake rûrîa rûnene na averithie Leviathani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27.1",
              "type": "text"
            },
            {
              "text": "Leviathani:",
              "type": "text"
            },
            {
              "text": "Ciarî ciûmbe cia tene irîa ciarî mîvuano ya mavûrûri marîa maavinyagîrîria Isiraeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " njoka îrîa îgûrûkaga, njoka îrîa îîthioraga, na aûrage njûnamatu îrîa îtûûraga îriarî.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
