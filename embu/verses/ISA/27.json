        },
        {
          "text": "Mûthenya ûcio Ngai-Mûnene nîakaaina rwîmbo rwîgiî mûgûnda wake mwaro wa mîthavibu atîrî:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
