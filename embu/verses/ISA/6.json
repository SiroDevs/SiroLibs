                "loc": "2CH.26.23"
              },
              "items": [
                {
                  "text": "2Maû 26.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwaka ûrîa mûthamaki Uzia aakwire, nînonire Mwathani ekarîrîte gîtî gîake Kîam ûthamaki kîrî vandû îgûrû mûno; nayo nguo yake ndaca yecûrîte hekarûrî yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgûrû rîake kwarûngamîte Aserafi, wa serafi ûmwe aarî na mathagu matandatû; mathagu maîrî maakunîkîte ûthiû wake, maîrî magakunîka magûrû make namo maîrî akîgûrûka namo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Kûguû 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wa ûmwe wa Aserafi acio etaga ûrîa wîngî akiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
