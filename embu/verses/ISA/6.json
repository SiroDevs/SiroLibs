        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo nînaugire atîrî, “Kaî nîrî na thîna-î! Nînathira, nîûndû mîromo yakwa tî mîtheru na ndûûranagia na andû matarî atheru. Kûnarî ûguo, nîmonete Mûthamaki, Ngai-Mûnene, mwene vinya wonthe!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
