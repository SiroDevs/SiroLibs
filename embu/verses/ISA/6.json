              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mîgambo yao nîyatûmire mîcingi ya hekarû inaine, nayo hekarû îgîcûra ndogo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
          }
        }
