          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nînacokire ngîgua Mwathani akîûria atîrî, “Nîûrîkû ngûtûma? Nîûrîkû ûgûtuîka mûnjaama wetû?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
