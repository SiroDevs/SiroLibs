          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îno nîyo ndûmîrîri îrîa Ngai-Mûnene aavecanire mbere îgiî Moabu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwatî rîu Ngai-Mûnene arauga atîrî, “Vuva wa mîaka îthatû, ta îrîa îtaragîrwa mûruti wa wîra, riiri wa Moabu nîûkaathira. Wana ethîrwa andû a kuo nî eengî, nî andû anini tu magaatigara na matarî na vinya.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
