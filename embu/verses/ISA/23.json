              "type": "text"
            }
          ]
        },
        {
          "text": "Akalidei nîo maarekererie nyamû cia kîthaka itharîkîre îtûûra rîa Turo nwatî tî Asîria. Akalidei maatumire nyomba ndaca na îgûrû ithiûrûrûkîrîtie îtûûra rîu, makîomomora nyomba cia kuo na magîtiga îtûûra rîu rîrî îganjo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.13",
              "type": "text"
            },
            {
              "text": "Mûvari ûyû na Kîhibirania ndwereekaga.",
              "type": "text"
            }
          ]
        }
      ]
    },
