        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio, Ngai-Mûnene mwene vinya wonthe nîke ûkethîrwa arî nthûmbî ya riiri, na arî nthûmbî ya ûthaka kûrî andû ake arîa magaatigara marî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.5",
            "verseOrgIds": [
              "ISA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîagaatongoria atucanîri ciira nîguo marûmagîrîre kîvooto marî magootirî, na nîakaava arangîri a îtûûra vinya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.6",
            "verseOrgIds": [
              "ISA.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaia na arathi a Juda arîa maarî mîrîu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
