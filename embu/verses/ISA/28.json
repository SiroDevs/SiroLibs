          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manthekagîrîra makîûragia atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.9",
            "verseOrgIds": [
              "ISA.28.9"
            ]
          }
        }
