          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûnarî ûguo, nîwerîrîte andû aya atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îthiga rîa mûcingi rîa Zayuni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
