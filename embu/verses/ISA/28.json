          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwoguo mue andû aya ang'endu mue mwathaga andû mûrî Jerusalemu, thikîrîriani ûrîa Ngai-Mûnene arauga!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
