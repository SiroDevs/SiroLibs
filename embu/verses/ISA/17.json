              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthenya ûcio, matûûra mao marîa magitîre magaatigwa marî maganjo ta matûûra marîa maatiganîrue nî Ahivi na Amori",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17.9",
              "type": "text"
            },
            {
              "text": "Ahivi na Amori:",
              "type": "text"
            },
            {
              "text": "Kîhibirania kiugaga, ‘mûtitûrî kana kîrîma îgûrû.’",
              "type": "text"
            }
          ]
        },
        {
          "text": " rîrîa maaûrire nî andû a Isiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mavûrûri marîa nthû nîmaavootirwe.",
          "type": "text"
        }
      ]
