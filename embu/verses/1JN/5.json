            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.17",
            "verseOrgIds": [
              "1JN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîtwîcî atî gûtirî mwana wa Ngai wîkaraga akîvagia, nîûndû Mûriû wa Ngai nîamûgitagîra, na ûrîa mûcûku ndangîmwîka naaî.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîtwîcî atî tûrî a Ngai wana ethîrwa nthî yonthe îrî rungu rwa wathani wa Ûrîa Mûcûku.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        }
      ]
    },
