        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tue nîtwîcî atî Mûriû wa Ngai nî mûku na atî nîatûmîte tûtaûkîrwe, nîguo tûmenye Ngai Ûrîa wa ma. Ûtûûro wetû ûrî kûrî Ngai ûrîa wa ma na kûrî Mûriû Jesû Kristû. Ûyû nîke Ngai ûrîa wa ma na nwake mwoyo wa tene na tene.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        }
      ]
    },
