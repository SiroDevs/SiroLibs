          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wa rîngî Ayahudi nîmaageririe kûnyita Jesû nwatî ke nîwaûrire.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.39",
            "verseOrgIds": [
              "JHN.10.39"
            ]
          }
        }
