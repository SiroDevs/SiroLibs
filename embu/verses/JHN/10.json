            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wa rîngî Jesû nîwacokire mûringo wa rûnjî rwa Jorodani kûrîa Johana aavatithanagîria mbererî. Jesû nîwekarire kuo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "na andû eengî makîthiî kûrî ke na makîmwîra atîrî, “Johana ndaatûringîra ciama, nwatî maûndû monthe marîa aaririe megiî mûndû ûyû nî ma ma.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andû onthe arîa maarî kuo nîmeetîkirie Jesû.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.42",
            "verseOrgIds": [
              "JHN.10.42"
            ]
          }
        }
