              "items": [
                {
                  "text": "Ala 24.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nao nîmaamûcokerie atîrî, “Tûtirenda gûkûûraga nîûndû wa gwîka maûndû maro, nwatî nîûndû nîwaruma Ngai! We wî mûndû tu, nwatî ûrageria gwîtua Ngai!”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.33",
            "verseOrgIds": [
              "JHN.10.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
