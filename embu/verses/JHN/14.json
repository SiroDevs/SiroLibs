          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ûkîrani rîu tûthiî tuume ava.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.31",
            "verseOrgIds": [
              "JHN.14.31"
            ]
          }
