                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.25+1KI.21.26"
              },
              "items": [
                {
                  "text": "21.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîmûrûmîrîrîte mîtugo mîcûku ya mûthamaki Omuri na maûndû monthe marîa meekagwa nî andû a mûciî wa Ahabu, na mûkarûmîrîra ûtaari wao. Kwoguo nîngaamûretithîria mûthiro na mûnyararwe nî andû onthe. Andû a kûndû kuonthe makaamwonaga makamûciva.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
