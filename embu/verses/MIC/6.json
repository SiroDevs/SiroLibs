                "loc": "1KI.16.23+1KI.16.24+1KI.16.25+1KI.16.26+1KI.16.27+1KI.16.28+1KI.16.29+1KI.16.30+1KI.16.31+1KI.16.32+1KI.16.33+1KI.16.34"
              },
