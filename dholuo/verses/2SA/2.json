  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2SA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi owir mondo obed ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kinde moko Daudi nopenjo Jehova Nyasaye wach niya, \"Bende anyalo dhi e achiel kuom miech Juda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ne odwoke niya, \"Dhiyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Daudi nopenjo niya, \"Adhi kanye?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:1"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ne odwoke niya, \"Dhi Hebron.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Daudi nodhi kuno gi monde ariyo, Ahinoam nyar Jezreel gi Abigael ma dhako ma chwore otho mane jaod Nabal ja-Karmel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi bende nodhi gi joma ne ni kode ka moro ka moro nigi joode, kendo negidak Hebron gi dalane.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Juda nobiro Hebron, kendo ne giwiro Daudi obedo ruodh dhood Juda kanyo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:4"
      },
      "items": [
        {
          "text": "Kane onyis Daudi ni jo-Jabesh Gilead ema ne oiko Saulo,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nooro joote ni jo-Jabesh Gilead mondo owachnegi niya, \"Jehova Nyasaye mondo ogwedhu kuom timo tim ngʼwono ni Saulo ma ruodhu ka uike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye otimnu ngʼwonone gi adierane makare, kata an bende abiro timonu tim ngʼwonono machal kamano nikech ma musetimo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To koro sani beduru motegno kendo ma jochir, nimar Saulo ruodhu osetho, kendo dhood Juda osewira abed ruodhgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lweny e kind dhood Daudi gi dhood Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno noyudo ka Abner wuod Ner, jatend lwenj Saulo, osekawo Ish-Boseth wuod Saulo motere nyaka Mahanaim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.8",
            "verseOrgIds": [
              "2SA.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokete ruodh Gilead, Ashuri gi Jezreel, to gi Efraim gi Benjamin kod Israel duto.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.9",
            "verseOrgIds": [
              "2SA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ish-Boseth wuod Saulo ne ja-higni piero angʼwen kano bedo ruodh Israel, nobedo ruoth kuom higni ariyo. Dhood Juda, to ne luwo Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.10",
            "verseOrgIds": [
              "2SA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nobedo ruodh dhood Juda kuom higni abiriyo, gi dweche auchiel kane en Hebron.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.11",
            "verseOrgIds": [
              "2SA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abner wuod Ner, kaachiel gi jo-Ish-Boseth wuod Saulo, nowuok Mahanaim mi gidhi Gibeon.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab wuod Zeruya gi jo-Daudi nodhi moromo kodgi e yawo man Gibeon. Negibet ka gingʼiyore jomoko koni to jomoko kocha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Abner nowachone Joab niya, \"We yawuowi oa malo mondo omakre achingʼ gachingʼ e nyimwa ka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:14"
      },
      "items": [
        {
          "text": "Joab nodwoko niya, \"Kare gitim kamano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negia malo mokwan-gi mi giromo ji apar gi ariyo ma jo-Benjamin ma ruodhgi ne en Ish-Boseth wuod Saulo, to gi apar gariyo mag Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negirado ka moro ka moro mako wadgi gi wiye eka ochwoyo ngʼetne gi ligangla; eka giduto negiruombore piny. Omiyo nochak kar lwenyno mane ni Gibeon ni Helkath Hazurim ma tiende ni paw ligangla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
            "verseOrgIds": [
              "2SA.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼno lweny ne ger ahinya, kendo joma ne nigi Daudi noloyo Abner gi jo-Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.17",
            "verseOrgIds": [
              "2SA.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Zeruya adek ne gin Joab, Abishai gi Asahel. Koro Asahel ne tiende yot e ngʼwech mana ka mwanda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.18",
            "verseOrgIds": [
              "2SA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olawo Abner, ka ok obaro korachwich kata koracham kolawe alawa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.19",
            "verseOrgIds": [
              "2SA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abner nongʼiyo chien mopenjo niya, \"Mano in, Asahel?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 2:20"
      },
      "items": [
        {
          "text": "Modwoko niya, \"Ee en an.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.20",
            "verseOrgIds": [
              "2SA.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Abner nowachone niya, \"Bar korachwich kata koracham; mak achiel kuom yawuowigo mondo imaye gige mag lweny.\" To Asahel notamore weyo lawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.21",
            "verseOrgIds": [
              "2SA.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abner nosiemo Asahel niya, \"We lawa! En angʼo momiyo danegi? To katimo kamano, ere kaka dachungʼ e nyim Joab owadu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.22",
            "verseOrgIds": [
              "2SA.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Asahel nodagi weyo lawe; mi Abner nochwowo ii Asahel gi tongʼ mi tongʼ nowuok yo ka ngʼee Asahel. Nogore piny kanyo mi otho gisano. Kendo ji duto nochungʼ ka gichopo kama Asahel nogore piny motho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.23",
            "verseOrgIds": [
              "2SA.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Joab gi Abishai nolawo Abner, kendo ka chiengʼ ne podho, negichopo e got Ama, machiegni gi Gia e yo mochiko thim mar Gibeon.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.24",
            "verseOrgIds": [
              "2SA.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Benjamin nochungʼ bangʼ Abner. Negichokore e migepe kendo negiikore ne lweny ewi got.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.25",
            "verseOrgIds": [
              "2SA.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abner noluongo Joab matek kowacho niya, \"Chuno ni ligangla biro neko nyaka chiengʼ koso? Donge ingʼeyo ni wachni biro kelo sigu? Biro kawo kinde maromo nade mondo ikwer jogi owe lawo owetegi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab nodwoke niya, \"Akwongʼora gi nying Nyasaye mangima, ni ka dine ok iwuoyo, to jogi dodhi nyime gi lawo owetegi nyaka gokinyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Joab nogoyo tungʼ mi ji duto nobiro mochungʼ, ne ok gimedo lawo jo-Israel, kata lweny bende ok ne gidhiyogo nyime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otienono duto Abner gi joge nowuotho ka gingʼado Araba. Negiyoro aora Jordan, negimedo dhi ka gikadho gwengʼ Bithron duto mi gichopo Mahanaim.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.29",
            "verseOrgIds": [
              "2SA.2.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Joab noduogo koa lawo Abner mi ochoko joge duto kanyakla. Ji apar gochiko mag Daudi ne onge ka ok okwan Asahel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.30",
            "verseOrgIds": [
              "2SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jo-Daudi nosenego jo-Benjamin mia adek gi piero auchiel mane nigi Abner.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.31",
            "verseOrgIds": [
              "2SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negitingʼo ringre Asahel mi giike e liend wuon-gi e Bethlehem. Eka Joab gi joge nowuotho otieno duto mi gichopo Hebron ka piny yawore.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.32",
            "verseOrgIds": [
              "2SA.2.32"
            ]
          }
        }
      ]
    }
