  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi okwano jolweny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirima nochako omako Jehova Nyasaye kod Israel omiyo nochwalo Daudi motimo gimoro madihinygi, kowachone niya, \"Dhiyo mondo ikwan jo-Israel gi jo-Juda.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.1",
            "verseOrgIds": [
              "2SA.24.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ruoth nowachone Joab kod jotend jolweny mane ni kode niya, \"Dhiuru e dhoudi duto mag Israel kochakore Dan nyaka Bersheba mondo ukwan jolweny, eka angʼe ni gin ji adi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.2",
            "verseOrgIds": [
              "2SA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Joab nodwoko ruoth niya, \"Mad Jehova Nyasaye ma Nyasachi med jolweny nyadi mia achiel ka ruodha ma en ruoth neno gi wangʼe. To en angʼo momiyo ruoth ma en ruodha didwar timo gima chal kama?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.3",
            "verseOrgIds": [
              "2SA.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano ruoth notamo Joab gi jotelo mag lweny; kuom mano ne giwuok e nyim ruoth mondo gidhi gikwan jolweny e Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.4",
            "verseOrgIds": [
              "2SA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kane gisengʼado aora Jordan, negibuoro machiegni gi Aroer, man yo milambo mar dala manie geng holo, eka negikadho Gad ma gidhi nyaka Jazer.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.5",
            "verseOrgIds": [
              "2SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidhi Gilead kod gwenge mag Tatim Hodshi, mi gikadho nyaka Dan Jaan kendo negigomo ka gichiko Sidon.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.6",
            "verseOrgIds": [
              "2SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe negichiko dala mochiel gohinga mar Turo kod dala duto mag jo-Hivi kod mago mag jo-Kanaan. Mogik, negidhi Bersheba man Negev e piny Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.7",
            "verseOrgIds": [
              "2SA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ dweche ochiko gi ndalo piero ariyo kane gisewuotho e piny duto, negidwogo Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.8",
            "verseOrgIds": [
              "2SA.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab nokelo ne ruoth kar kwan jolweny kama: Kuom jo-Israel ne nitie ji alufu mia aboro maroteke mane nyalo kedo gi ligangla to kuom jo-Juda ne nitie ji alufu mia abich.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.9",
            "verseOrgIds": [
              "2SA.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi chunye nochandore bangʼ kane osekwano jolweny, mi nowachone Jehova Nyasaye niya, \"Asetimo richo maduongʼ kuom gima asetimoni. Yaye Jehova Nyasaye, akwayi mondo igol richoni kuom jatichni, nimar asetimo gima ofuwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.10",
            "verseOrgIds": [
              "2SA.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Daudi pok ochiewo kinyne gokinyi, wach Jehova Nyasaye nosebiro ne Gad janabi, mane en jakor wach mar Daudi:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.11",
            "verseOrgIds": [
              "2SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dhiyo iwach ni Daudi ni, 'Ma e gima Jehova Nyasaye wacho: Aketo weche adek e nyimi, yier achiel kuomgi monego atimni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.12",
            "verseOrgIds": [
              "2SA.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Gad nodhi ir Daudi mowachone niya, \"Diyier mondo kech omak piny kuom higni adek? Koso diyier dweche adek kiringo wasiki malawi? Koso diyier ndalo adek mag masira? Koro par ane mondo imiya dwoko matero ni ngʼama ne oora.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.13",
            "verseOrgIds": [
              "2SA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nodwoko Gad niya, \"An-gi chuny lit ahinya. Ber mondo alwar e lwet Jehova Nyasaye, nikech ngʼwonone duongʼ, to kik iweya alwar e lwet ji.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.14",
            "verseOrgIds": [
              "2SA.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehova Nyasaye nokelo masira kuom jo-Israel chakre okinyino nyaka kinde mane oketi norumo, kendo ji alufu piero abiriyo notho chakre Dan nyaka Bersheba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.15",
            "verseOrgIds": [
              "2SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane malaika orieyo bade mondo oketh Jerusalem, chuny Jehova Nyasaye ne lit nikech masirano mi nowacho ni malaika mane nego ji niya, \"Oromo! Dwok lweti piny.\" Malaika mar Jehova Nyasaye noyudo ochungʼ e kar dino cham mar Arauna ja-Jebus.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.16",
            "verseOrgIds": [
              "2SA.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Daudi oneno malaika mane nego ji, nowachone Jehova Nyasaye niya, \"An ema asetimo richo kendo aseketho. Magi to mana rombe, angʼo magiseketho? Akwayi ni an ema ikuma kaachiel gi joga to kik iwe masira odongʼ kuom jogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.17",
            "verseOrgIds": [
              "2SA.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ogero kendo mar misango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiengʼno Gad nodhi ir Daudi mowachone niya, \"Dhi malo mondo iger kendo mar misango ni Jehova Nyasaye e laru mar dino mar Arauna ja-Jebus.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.18",
            "verseOrgIds": [
              "2SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Daudi nodhi malo mana kaka Jehova Nyasaye nosechike kokadho kuom Gad.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.19",
            "verseOrgIds": [
              "2SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Arauna ogoyo wangʼe moneno ruoth gi joge kabiro ire, nowuok mokulore e nyim ruoth nyaka e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.20",
            "verseOrgIds": [
              "2SA.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna nopenje niya, \"Angʼo mokelo ruodha ma en ruoth ir jatichne?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:21"
      },
      "items": [
        {
          "text": "Daudi nodwoke niya, \"Abiro ngʼiewo laru mar dino cham, mondo agerie kendo mar misango ni Jehova Nyasaye, eka tho manego ji orum.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.21",
            "verseOrgIds": [
              "2SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arauna nowacho ne Daudi niya, \"We ruodha ma en ruoth okawe kendo otim kode gima chunye dwaro mondo otimgo misango. Rwedhi mag timo misango miwangʼo pep kod yiend dino kaachiel gi jok minyalo tigo kaka yien nika.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.22",
            "verseOrgIds": [
              "2SA.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gigi duto, yaye ruoth, Arauna ema osechiwo ne ruoth.\" Arauna nomedo wachone niya, \"Mad Jehova Nyasaye ma Nyasachi yie kodi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.23",
            "verseOrgIds": [
              "2SA.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ruoth nodwoko Arauna niya, \"Ooyo, nyaka achuli. Ok abi timo ne Jehova Nyasaye ma Nyasacha misango miwangʼo pep gi gik mayudo nono.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 24:24"
      },
      "items": [
        {
          "text": "Omiyo Daudi nochulo fedha madirom nus kilo kongʼiewogo laru mar dino kaachiel gi rwedhi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.24",
            "verseOrgIds": [
              "2SA.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nogero kendo mar misango ni Jehova Nyasaye kanyo kendo nochiwo misengini miwangʼo pep kaachiel misengini mag lalruok. Eka Jehova Nyasaye nowinjo lamo mane olemogo ni piny, kendo nogengʼo masira mane ni e piny Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.24.25",
            "verseOrgIds": [
              "2SA.24.25"
            ]
          }
        }
      ]
    }
  ],
