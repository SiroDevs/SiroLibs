  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ISA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wach mokor kuom Babulon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e wach mane Nyasaye onyiso Isaya wuod Amoz e fweny kuom Babulon:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunguru bandera ewi got motwo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "kendo gouru koko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "gwelgiuru mondo gidonj e dhorangeye joma ogen.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asegolo chik ne joga maler;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "asechiko joga ma jolweny kakecho mondo gitim gima adwaro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "jogo mamor kaloyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru kaka koko wuok e gode;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "machalo mar oganda mangʼongo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "en koko maduongʼ magore e kind pinjeruodhi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "machalo mana gi ogendini mangʼeny mochokore kaachiel!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Jehova Nyasaye Maratego choko oganda mangʼongo mar lweny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibiro ka gia e pinje man mabor,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "manie tungʼ piny mogik,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "Jehova Nyasaye kod gige mager mag lweny,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "biro mondo otiekgo pinyno duto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Denguru nimar odiechieng Jehova Nyasaye chiegni;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:6"
      },
      "items": [
        {
          "text": "odiechiengno biro ka gir kethruok maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:6"
      },
      "items": [
        {
          "text": "mawuok e lwet Jehova Nyasaye Maratego.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech wachni, lwet ngʼato ka ngʼato ne jony,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:7"
      },
      "items": [
        {
          "text": "kendo kihondko nogo chuny ji duto ma aa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibaji nogogi malich,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "rem gi kuyo bende noneg-gi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "ginibed gi rem mana ka dhako mamuoch kayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "Ngʼato ka ngʼato nongʼi wadgi malich ka midhiero omako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neuru, odiechieng Jehova Nyasaye biro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "en odiechiengʼ malich man-gi mirima kod kum mager,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "mabiro weyo piny gunda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "kendo joricho manie iye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulwe mag polo kod lergi ok nonenre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "Wangʼ chiengʼ nolokre mudho,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "kawuok kendo dwe bende ok norieny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro kumo piny kuom timbene mamono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "joricho kuom richogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "Abiro tieko wich teko ka mar josunga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "kendo abiro thiro sunga mar joma wangʼ-gi tek.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro miyo ji doko manok moloyo dhahabu mopwodhi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:12"
      },
      "items": [
        {
          "text": "manok mana ka dhahabu ma aa Ofir.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Jehova Nyasaye Maratego nomi polo tetni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:13"
      },
      "items": [
        {
          "text": "kendo piny noyiengni milengʼre;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.13",
            "verseOrgIds": [
              "ISA.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:13"
      },
      "items": [
        {
