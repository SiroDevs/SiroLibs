  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "51",
        "style": "c",
        "sid": "ISA 51"
      },
      "items": [
        {
          "text": "51",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Resruok manyaka chiengʼ ne dala Sayun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 51:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjauru, un mumanyo tim makare",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:1"
      },
      "items": [
        {
          "text": "kendo udwaro Jehova Nyasaye:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:1"
      },
      "items": [
        {
          "text": "Ngʼi aneuru lwanda mane ogolue,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:1"
      },
      "items": [
        {
          "text": "ranganeuru kama ne okuny mogolue;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.1",
            "verseOrgIds": [
              "ISA.51.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 51:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "paruru Ibrahim wuonu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:2"
      },
      "items": [
        {
          "text": "kod Sara mane onywolou.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:2"
      },
      "items": [
        {
          "text": "Ne en mana ngʼat achiel kende kane aluonge",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:2"
      },
      "items": [
        {
          "text": "kendo nagwedhe mi aloke oganda maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.2",
            "verseOrgIds": [
              "ISA.51.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 51:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro hoyo chuny Sayun adier;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:3"
      },
      "items": [
        {
          "text": "kendo obiro bedo gi kech kuom kuondene mokethore;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:3"
      },
      "items": [
        {
          "text": "enolok kuondene motimo ongoro chal ka Eden,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:3"
      },
      "items": [
        {
          "text": "kendo kuondene modongʼ gunda chal ka puoth Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:3"
      },
      "items": [
        {
          "text": "Mor gi ilo kaachiel gi erokamano",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:3"
      },
      "items": [
        {
          "text": "gi wer mamit noyud kuome.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.3",
            "verseOrgIds": [
              "ISA.51.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 51:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjauru un joga, chikuru itu un ogandana:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:4"
      },
      "items": [
        {
          "text": "Abiro golo chik kendo bucha makare nobed ler ne ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.4",
            "verseOrgIds": [
              "ISA.51.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 51:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiera mara sudo machiegni piyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:5"
      },
      "items": [
        {
          "text": "warruokna chiegni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:5"
      },
      "items": [
        {
          "text": "kendo abiro ngʼado bura makare ne ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:5"
      },
      "items": [
        {
          "text": "Joma odak e dho nembe biro ngʼiya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:5"
      },
      "items": [
        {
          "text": "ka gin gi geno ni abiro resogi gi tekona.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.5",
            "verseOrgIds": [
              "ISA.51.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 51:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tingʼ wangʼi malo ingʼi polo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "bende rang piny gie polo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "nikech polo nolal nono mana ka iro,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "to piny bende biro ti mana ka law",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "kendo oganda modak e iye notho mana ka lwangʼni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "To resruok makelo nosiki nyaka chiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:6"
      },
      "items": [
        {
          "text": "kendo adiera mara ok norum.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.6",
            "verseOrgIds": [
              "ISA.51.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 51:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjauru un joma ongʼeyo tim makare,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:7"
      },
      "items": [
        {
          "text": "un oganda mondiko chikena e chunyu:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:7"
      },
      "items": [
        {
          "text": "Kik uluor weche midiro mag dhano kata luoro ayany mag ji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.7",
            "verseOrgIds": [
              "ISA.51.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 51:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar olwenda biro chamogi duto ka law;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:8"
      },
      "items": [
        {
          "text": "kendo kudni nochamgi mana ka yie rombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:8"
      },
      "items": [
        {
          "text": "To adiera mara nosiki manyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:8"
      },
      "items": [
        {
          "text": "kendo resruok makelo ok norum e kind tienge gi tienge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.8",
            "verseOrgIds": [
              "ISA.51.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 51:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aa malo, Aa malo! Jiw badi motegno,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:9"
      },
      "items": [
        {
          "text": "yaye Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:9"
      },
      "items": [
        {
          "text": "aa malo kendo ijiwri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:9"
      },
      "items": [
        {
          "text": "mana kaka ne ijiwori chon e ndalo mokadho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 51:9"
      },
      "items": [
        {
          "text": "Donge in ema nitieko ondiek nam miluongo ni Rahab,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:9"
      },
      "items": [
        {
          "text": "mingʼado matindo tindo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.9",
            "verseOrgIds": [
              "ISA.51.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 51:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge in ema nomiyo nam oduono,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.10",
            "verseOrgIds": [
              "ISA.51.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 51:10"
      },
      "items": [
        {
