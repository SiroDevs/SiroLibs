              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma Jehova Nyasaye osereso nodwogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.51.11",
            "verseOrgIds": [
              "ISA.51.11"
