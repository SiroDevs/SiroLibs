  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "55",
        "style": "c",
        "sid": "ISA 55"
      },
      "items": [
        {
          "text": "55",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luong ne joma riyo oloyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 55:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Biuru un duto ma riyo oloyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "biuru mondo umodh pi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "adier biuru un ma uonge pesa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "mondo ungʼiew kendo uchiem!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:1"
      },
      "items": [
        {
          "text": "Biuru ungʼiew divai gi chak nono maonge chudo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.1",
            "verseOrgIds": [
              "ISA.55.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 55:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo utiyo gi pesa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "kungʼiewo gik ma ok chiemo kendo utiyo matek gi luchi ne gima ok yiengʼu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "Winjuru, ee winjauru kendo ucham gima ber,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:2"
      },
      "items": [
        {
          "text": "mi unubed gi mwandu mar chuny.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.2",
            "verseOrgIds": [
              "ISA.55.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 55:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik iti kendo ibi ira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "winj gima awacho mondo chunyi obed gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "Abiro loso singruok mosiko kod",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:3"
      },
      "items": [
        {
          "text": "herana mar adier mane asingone Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.3",
            "verseOrgIds": [
              "ISA.55.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 55:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ne, asemiyo obedo janeno e kind ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:4"
      },
      "items": [
        {
          "text": "kendo asekete obedo jatelo mar ogendini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.4",
            "verseOrgIds": [
              "ISA.55.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 55:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chutho iniluong pinjeruodhi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "mane ok ingʼeyo mabi iri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "kendo pinjeruodhi mane ok ongʼeyi malongʼo nobi iri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "nikech Jehova Nyasaye ma Nyasachi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:5"
      },
      "items": [
        {
          "text": "Jal Maler mar Israel osewiri kod duongʼne.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.5",
            "verseOrgIds": [
              "ISA.55.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 55:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwar Jehova Nyasaye ka pod thuolo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:6"
      },
      "items": [
        {
          "text": "nitie minyalo yudego;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:6"
      },
      "items": [
        {
          "text": "chutho luonge kapod en machiegni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.6",
            "verseOrgIds": [
              "ISA.55.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 55:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama timbene achach mondo owe yorene,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "kendo ngʼama parone opongʼ gi timbe richo mondo owe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "Onego oduog ir Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:7"
      },
      "items": [
        {
          "text": "kendo enobed gi ngʼwono kuome mi enowene richone.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.7",
            "verseOrgIds": [
              "ISA.55.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 55:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nimar parona ok e paroni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "bende yorena ok e yoreni,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:8"
      },
      "items": [
        {
          "text": "Jehova Nyasaye owacho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.8",
            "verseOrgIds": [
              "ISA.55.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 55:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mana kaka polo bor gi piny e kaka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "bende yorena boyo maloyo mau,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:9"
      },
      "items": [
        {
          "text": "kendo e kaka parona ohewo parou.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.9",
            "verseOrgIds": [
              "ISA.55.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka koth gi pe lwar koa e polo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "kendo ok dog nono ka ok omiyo piny ngʼich,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "ma cham twi kendo nyag kothe ne jachwoyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:10"
      },
      "items": [
        {
          "text": "kendo cham ne jachiemo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "e kaka wachna mawuok e dhoga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "ok noduogna nono ka ok otiyo tije,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "to nyaka ochop dwarona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 55:11"
      },
      "items": [
        {
          "text": "kendo otiek tijno mane omiyo aore.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unuwuog kuno gi mor",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
