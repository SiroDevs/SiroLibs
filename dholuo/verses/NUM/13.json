              "type": "text"
            }
          ]
        },
        {
          "text": "To joma nodhi kode kuno nowacho niya, \"Ok wanyal monjo jogo; gitek moloyowa.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
              "NUM.13.31"
            ]
          }
        },
        {
