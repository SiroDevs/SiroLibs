          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ne gilandone jo-Israel dwoko marachni kuom piny mane gidhi nono. Negiwacho niya, \"Piny mane wadhi nono nego joma odak eigi. Ji mane waneno kuno gin joma robede.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.32",
            "verseOrgIds": [
              "NUM.13.32"
            ]
          }
        },
        {
          "name": "verse",
