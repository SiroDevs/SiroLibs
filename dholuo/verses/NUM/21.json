          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwongʼi, yaye Moab,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "otieku duto, yaye jo-Kemosh!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "Oseweyo yawuote e lwet nono mobedo jonjore",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "kendo nyige obedo joma oter e twech,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:29"
      },
      "items": [
        {
          "text": "ir Sihon ruodh jo-Amor.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.29",
            "verseOrgIds": [
              "NUM.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
