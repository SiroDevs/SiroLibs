            "sid": "NUM 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mach nowuok Heshbon,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "en mach makakni moa e dala maduongʼ mar Sihon.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "Nowangʼo Ar man Moab,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 21:28"
      },
      "items": [
        {
          "text": "ma gin jokanyo mag kuonde motingʼore malo mag Arnon.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.28",
            "verseOrgIds": [
              "NUM.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
