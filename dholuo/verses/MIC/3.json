  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "MIC 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwed jotelo kod jonabi mag Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ne awacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "\"Winjuru un jotelo maka Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "un jotelo mag dhood Israel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:1"
      },
      "items": [
        {
          "text": "Donge onego ungʼe ngʼado bura kare.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.1",
            "verseOrgIds": [
              "MIC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umon gi gik mabeyo to uhero gik maricho;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "ukidho pien joga oko",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:2"
      },
      "items": [
        {
          "text": "ka uyiecho ringʼo oko e chokegi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.2",
            "verseOrgIds": [
              "MIC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uchamo ringre joga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "uyiecho pien dendgi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "kendo utoyo chokegi matindo tindo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "Ukengogi ka ringʼo midwa chielo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:3"
      },
      "items": [
        {
          "text": "ka ringʼo midwa tedo e agulu?\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.3",
            "verseOrgIds": [
              "MIC.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinde biro ma giniywag ne Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "to ok enodwokgi ngangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "Kindeno enopandnegi wangʼe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:4"
      },
      "items": [
        {
          "text": "nikech gik maricho magisetimo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.4",
            "verseOrgIds": [
              "MIC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "\"Ne jonabi mane omiyo joga obaro oweyo yo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "ka ngʼato omiyogi chiemo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "to giwacho ni, 'kwe nitie,'",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "to ka ok omiyogi chiemo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:5"
      },
      "items": [
        {
          "text": "to giikore tugo kode lweny.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.5",
            "verseOrgIds": [
              "MIC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano otieno biro choponu ma ok nune fweny,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "mudho nojuku ma ok nungʼe weche mopondo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "Chiengʼ biro podho ne jonabi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:6"
      },
      "items": [
        {
          "text": "kendo odiechiengʼ nolokrenegi mudho.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.6",
            "verseOrgIds": [
              "MIC.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokor wach wigi biro kuot",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "kendo jo-nyakalondo none wichkuot.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "Dhogi nomoki",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:7"
      },
      "items": [
        {
          "text": "nikech ok giniyud dwoko moa kuom Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.7",
            "verseOrgIds": [
              "MIC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "An to apongʼ gi teko,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "apongʼ gi Roho mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "kod adiera kod nyalo mar hulo ne joka Jakobo kethogi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "mar nyiso jo-Israel richogi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:8"
      },
      "items": [
        {
          "text": "gi kethogi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.8",
            "verseOrgIds": [
              "MIC.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru wachni, un jotelo mag dhood Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "un jotelo mag dhood Israel,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "un ma usin gadiera",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:9"
      },
      "items": [
        {
          "text": "kendo uriambo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.9",
            "verseOrgIds": [
              "MIC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "un mugero Sayun gi remo,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:10"
      },
      "items": [
        {
          "text": "to Jerusalem gi timbe mamono.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.10",
            "verseOrgIds": [
              "MIC.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jotende ngʼado bura ka omigi asoya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.11",
            "verseOrgIds": [
              "MIC.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 3:11"
      },
      "items": [
        {
          "text": "Jodolo mag-gi bende puonjo weche mag chik komigi chudo,",
