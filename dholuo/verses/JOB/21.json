      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 21:19"
      },
      "items": [
        {
          "text": "An to awacho ni ber moloyo ka Nyasaye okumo jaketho owuon,",
          "type": "text",
          "attrs": {
