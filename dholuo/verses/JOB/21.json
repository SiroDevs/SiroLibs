          "text": "\"Bende nitiere ngʼama nyalo ngʼadone Nyasaye rieko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.21.22",
            "verseOrgIds": [
              "JOB.21.22"
            ]
