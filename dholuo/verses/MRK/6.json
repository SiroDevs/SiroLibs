  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MRK 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Janabi maonge duongʼ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noa kanyo modhi dalagi kaachiel gi jopuonjrene.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.1",
            "verseOrgIds": [
              "MRK.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka Sabato nochopo nochako puonjo ei sinagogi. Ji mangʼeny mane owinje nohum nono, ka gipenjore ni,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.2",
            "verseOrgIds": [
              "MRK.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:2"
      },
      "items": [
        {
          "text": "\"Ngʼatni ogolo gigi kure? Koso rieko manade mosemiyeni, momiyo otimo koda ka honni?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.2",
            "verseOrgIds": [
              "MRK.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Donge en fundi bao-cha ma wuod Maria kendo ma owetene gin Jakobo gi Josef kod Judas gi Simon? Nyiminene donge nikodwa ka?\" Kamano negichwanyore kode.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.3",
            "verseOrgIds": [
              "MRK.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Yesu nowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.4",
            "verseOrgIds": [
              "MRK.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Janabi imiyo duongʼ kuonde duto, makmana e kind jogwengʼ-gi gi wedene kod joode owuon.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.4",
                "verseOrgIds": [
                  "MRK.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.4",
            "verseOrgIds": [
              "MRK.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Yesu koro ne ok nyal timo honni kanyo, makmana ni noketo lwete kuom joma tuo manok mi ochangogi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.5",
            "verseOrgIds": [
              "MRK.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nowuoro kaka jogo ne onge gi yie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.6",
            "verseOrgIds": [
              "MRK.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "MRK 6:6"
      },
      "items": [
        {
          "text": "Yesu ooro ji apar gariyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:6"
      },
      "items": [
        {
          "text": "Bangʼ mano Yesu nomedo dhi nyime gipuonjo e gwengʼ ka gwengʼ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.6",
            "verseOrgIds": [
              "MRK.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kindeno noluongo ji apar gariyo ire, mi oorogi ji ariyo ariyo, kendo omiyogi teko kuom jochiende maricho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.7",
            "verseOrgIds": [
              "MRK.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomiyogi chik machal kama:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.8",
            "verseOrgIds": [
              "MRK.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik utingʼ gimoro ka udhi e wuoth makmana ludh wuoth. Makati, kata ofuku kata pesa mikano e ofuku kik utingʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.8",
                "verseOrgIds": [
                  "MRK.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.8",
            "verseOrgIds": [
              "MRK.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Opato ema urwaki, to kik utingʼ kata law machielo miloko.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.9",
                "verseOrgIds": [
                  "MRK.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.9",
            "verseOrgIds": [
              "MRK.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ot moro amora mudonje, to dagieuru nyaka udar e dalano.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.10",
                "verseOrgIds": [
                  "MRK.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.10",
            "verseOrgIds": [
              "MRK.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaponi udhi e dala moro to ok orwaku kata ka jo-dalano otamore winjo wachu, to mondo utengʼ buch tiendeu bangʼe ua kanyo. Mano nobednigi ranyisi ni bura oseloyogi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.11",
                "verseOrgIds": [
                  "MRK.6.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidhi ma gilando wach ji mondo olokre owe richo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.12",
            "verseOrgIds": [
              "MRK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende negigolo jochiende mathoth kuom ji kendo ne giolo mo kuom joma tuo mathoth mi gichangogi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.13",
            "verseOrgIds": [
              "MRK.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ongʼad wi Johana Ja-batiso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth Herode nowinjo wechegi, nikech nying Yesu koro noselandore mongʼere malach. Jomoko ne wacho kuom Yesu niya, \"Johana Ja-batiso osechier oa kuom joma otho, kendo mano emomiyo teko mar timo honni ni e ngimane.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.14",
            "verseOrgIds": [
              "MRK.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma moko to ne wacho niya, \"En Elija.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.15",
            "verseOrgIds": [
              "MRK.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:15"
      },
      "items": [
        {
          "text": "To joma moko bende noramo niya, \"En janabi machal gi jonabi machon gi lala.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.15",
            "verseOrgIds": [
              "MRK.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane ruoth Herode owinjo wechegi, nowacho niya, \"Johana ngʼat mane asengʼado wiye osechier oa kuom joma otho!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.16",
            "verseOrgIds": [
              "MRK.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode ne chunye chandore nikech en owuon ema nogolo chik mondo omak Johana, kendo kuom chikneno askechene nomako Johana moketo e od twech. Notimo kamano nikech wach Herodia mane en chi owadgi ma nyinge Filipo. Herode nomayo owadgino dhako mi oloko chiege owuon.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.17",
            "verseOrgIds": [
              "MRK.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Johana nosebedo ka kwero Herode kawachone niya, \"Chik ok oyieni mondo ibed gi chi owadu.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.18",
            "verseOrgIds": [
              "MRK.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano dhako ma nyinge Herodia nomako sadha gi Johana, kendo nodwaro mondo onege. To kata kamano ne ok onyal,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.19",
            "verseOrgIds": [
              "MRK.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech Herode ne oluoro Johana kendo ne ok odwar ni ngʼato ohinye, nikech nokawe kaka ngʼama kare kendo maler. Kinde ka kinde ka Herode nowinjo yalo Johana to dhoge ne moko; to pod nogombo mana mondo omed winjo yalone.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.20",
            "verseOrgIds": [
              "MRK.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achien thuolo nochopo mondo Herodia otim dwarone. Chiengʼ rapar mar nywol Herode nochopo, kendo ne oloso chiemo moyiedhi ne jotend ogandane madongo gi jotend jolweny mage kod jok midewo duto moa Galili.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.21",
            "verseOrgIds": [
              "MRK.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kane budho dhi nyime, nyar Herodia nobiro momiel e nyim Herode mi miendeno nomoro ruoth gi wende.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.22",
            "verseOrgIds": [
              "MRK.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:22"
      },
      "items": [
        {
          "text": "Ruoth nowachone nyakono niya, \"Kwaya gimoro amora ma chunyi dwaro mondo amiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.22",
            "verseOrgIds": [
              "MRK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herode nosingore ne nyakono e yor kwongʼruok niya, \"Gimoro amora mikwaya abiro miyi, kata obed mana nus pinyruodha.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.23",
            "verseOrgIds": [
              "MRK.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakono nowuok modhi openjo min mare gima dokwa ruoth kowacho niya, \"En angʼo manyalo kwayo?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.24",
            "verseOrgIds": [
              "MRK.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:24"
      },
      "items": [
        {
          "text": "To min mare nodwoke niya, \"Wi Johana Ja-batiso.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.24",
            "verseOrgIds": [
              "MRK.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gikanyono nyakono nodok ir ruoth koreto mi okwaye kowacho niya, \"Adwaro ni mondo imiya wi Johana ja-batiso sani sani e san.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.25",
            "verseOrgIds": [
              "MRK.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth ne chunye ochandore ahinya ka nowinjo kwayono, to nikech noyudo osesingore e yor kwongʼruok, kendo nikech wende mane ni e nyasineno, ne ok odwar tuono nyakono gima nosekwayo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.26",
            "verseOrgIds": [
              "MRK.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano nooro janek piyo piyo kendo nomiyo janekno chik mondo odhi okelne wi Johana Ja-batiso. Ngʼatno nodhi mongʼado wi Johana e od twech kama ne entie,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.27",
            "verseOrgIds": [
              "MRK.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bangʼe nokelo wiye koketo e san. Ne ochiwe ne nyakono, mi nyakono nochiwe ni min mare.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.28",
            "verseOrgIds": [
              "MRK.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane giwinjo wachni, jopuonjre Johana nobiro mokawo ringre kendo ne giike e bur.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.29",
            "verseOrgIds": [
              "MRK.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu opidho ji alufu abich",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joote noduogo onyiso Yesu gik moko duto mane gisetimo kendo puonjo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.30",
            "verseOrgIds": [
              "MRK.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nikech ji mathoth ne biro irgi kendo aa ma ok giwenegi thuolo kata mar chiemo, Yesu nowacho ni jopuonjrene niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.31",
            "verseOrgIds": [
              "MRK.6.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wawuoguru ka mondo wadhi kamoro mopondo ma ji ongee mondo waywe kuno.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.31",
                "verseOrgIds": [
                  "MRK.6.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano ne giwuok gidhi kama opondo ka gin kendgi giwegi e yie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.32",
            "verseOrgIds": [
              "MRK.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano ji mangʼeny ma nonenogi kagiwuok nofwenyo gisano ni ne en gin, omiyo ne giwuok e mier mokiewo machiegni duto ka giringo e yor tielo magikwongo ne Yesu gi jopuonjrene kama negidhiye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.33",
            "verseOrgIds": [
              "MRK.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Yesu ogowo loka, noneno oganda maduongʼ, nokechogi nikech ne gichal kaka rombe maonge gi jakwath. Omiyo nochako puonjogi gik mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.34",
            "verseOrgIds": [
              "MRK.6.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ka sa koro ne oniangʼ, jopuonjrene nobiro ire mowachone niya, \"Ka en thim kendo sa koro olewo ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.35",
            "verseOrgIds": [
              "MRK.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "We jogi owuogi mondo gidhi e gwenge kod mier machiegni mondo gingʼiew gima digicham.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.36",
            "verseOrgIds": [
              "MRK.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Yesu nodwokogi kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.37",
            "verseOrgIds": [
              "MRK.6.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Un uwegi migiuru gimoro gicham.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.37",
                "verseOrgIds": [
                  "MRK.6.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:37"
      },
      "items": [
        {
          "text": "Gin to negidwoke ka gipenje niya, \"Ere kaka dwadhi mwangʼiew makati ma nengone oromo chudo mar ngʼato mar dweche aboro mondo wapidhgo oganda machal kama?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.37",
            "verseOrgIds": [
              "MRK.6.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.38",
            "verseOrgIds": [
              "MRK.6.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Un gi makati adi? Dhi ungʼi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.38",
                "verseOrgIds": [
                  "MRK.6.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:38"
      },
      "items": [
        {
          "text": "Kane gisekwano kar romb makati mane gin-go neginyiso Yesu niya, \"Abich, gi rech ariyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.38",
            "verseOrgIds": [
              "MRK.6.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nochiko jopuonjrene mondo ochan ji e migepe matindo tindo, ka gibet e lum mangʼich.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.39",
            "verseOrgIds": [
              "MRK.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano ji nobedo piny e migepe, ka migepe moko otingʼo ji mia achiel to moko otingʼo ji piero abich.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.40",
            "verseOrgIds": [
              "MRK.6.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe nokawo makati abichgo gi rech ariyogo nongʼiyo polo malo, kogoyo erokamano. Nongʼingo makatigo mi omiyo jopuonjrene mondo opog ji. Rech ariyo ka bende nopogo matindo tindo ni ji duto.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.41",
            "verseOrgIds": [
              "MRK.6.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giduto negichiemo mi giyiengʼ chuth,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.42",
            "verseOrgIds": [
              "MRK.6.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 6:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo bangʼ chiemo jopuonjre nochoko ngʼinjo mag chiemo mane ji ochamo oweyo okepe apar gariyo mopongʼ mag makati gi rech.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.43",
            "verseOrgIds": [
              "MRK.6.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 6:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kar romb chwo mane ochiemo ne gin ji alufu abich.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.44",
            "verseOrgIds": [
              "MRK.6.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu owuotho ewi pi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 6:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gisano Yesu nochiko jopuonjrene mondo odonji e yie kendo gitel nyime gingʼad gidhi loka nam e dala mar Bethsaida, ka en to ne pod odongʼ chien kogonyo oganda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.45",
            "verseOrgIds": [
              "MRK.6.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 6:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ goyone oganda oriti, noidho modhi e bath got malo mondo olem.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.46",
            "verseOrgIds": [
              "MRK.6.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 6:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane piny chiegni imore, yie koro ne ni e chuny nam to Yesu to ne ni kende oko e lowo motwo kuma ne odongʼie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.47",
            "verseOrgIds": [
              "MRK.6.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MRK 6:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noneno kaka jopuonjrene ne chandore gi chiko yie, nikech yamo ne kedo kodgi. To kar sa apar kogwen, Yesu nobiro irgi kowuotho ewi pi. Kochopo irgi to nochalo ka gima odwa kalo akala odhi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.48",
            "verseOrgIds": [
              "MRK.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MRK 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "to kane ginene kowuotho ewi pi, negiparo ni en jachien. Omiyo ne gibuok mi gikok matek,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.49",
            "verseOrgIds": [
              "MRK.6.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MRK 6:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech giduto ne ginene ma luoro nomakogi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.50",
            "verseOrgIds": [
              "MRK.6.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 6:50"
      },
      "items": [
        {
          "text": "To Yesu noloso kodgi gisano kowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.50",
            "verseOrgIds": [
              "MRK.6.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru gi chir! En mana An! Kik uluor.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.6.50",
                "verseOrgIds": [
                  "MRK.6.50"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.50",
            "verseOrgIds": [
              "MRK.6.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MRK 6:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka nodonjo e yie mobet kodgi, kendo yamo nokwe mos. Jopuonjrene nohum nono,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.51",
            "verseOrgIds": [
              "MRK.6.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MRK 6:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech tiend hond makati ne pok odonjonigi. Pachgi ne pod odinore.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.52",
            "verseOrgIds": [
              "MRK.6.52"
            ]
          }
        }
