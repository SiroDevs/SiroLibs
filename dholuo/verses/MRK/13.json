  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MRK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ranyisi mag ndalo giko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oyudo Yesu oa e hekalu, achiel kuom jopuonjrene nokone niya, \"Neye, Japuonj! Kitegi dongo manade! Magi gedo malich manade!\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.1",
            "verseOrgIds": [
              "MRK.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nodwoke niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.2",
            "verseOrgIds": [
              "MRK.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ineno ute madongo malichgi? Onge kidi kata achiel mabiro dongʼ kochungʼ ewi wadgi; gibiro redhore piny duto.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.2",
                "verseOrgIds": [
                  "MRK.13.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oyudo Yesu obet ewi Got Zeituni, momanyore gi hekalu, Petro gi Jakobo, gi Johana kod Andrea nopenje lingʼ-lingʼ ni,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.3",
            "verseOrgIds": [
              "MRK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wachnwa ane, gigi biro timore karangʼo, koso en ranyisi mane manotimre ma nonyis ni gigi duto chiegni chopo kare?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.4",
            "verseOrgIds": [
              "MRK.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.5",
            "verseOrgIds": [
              "MRK.13.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru motangʼ mondo ngʼato kik wuondu.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.5",
                "verseOrgIds": [
                  "MRK.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.5",
            "verseOrgIds": [
              "MRK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji mangʼeny nobi e nyinga ka hedhore ni, 'An e en,' kendo giniwuond ji mangʼeny.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.6",
                "verseOrgIds": [
                  "MRK.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.6",
            "verseOrgIds": [
              "MRK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka uwinjo ka pinje gore koni gi koni kod humbe mag lwenje to kik kibaji gou. Gik ma kamago nyaka timre, to giko piny to pod ni nyime.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.7",
                "verseOrgIds": [
                  "MRK.13.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.7",
            "verseOrgIds": [
              "MRK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oganda noked gi oganda machielo, kendo pinyruoth noked gi pinyruoth machielo. Piny noyiengni kuonde mopogore opogore kendo kech nobedi e piny. Magi e chakruok mar rem mar muoch ma nobedie.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.8",
                "verseOrgIds": [
                  "MRK.13.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nyaka ubed motangʼ, nikech nochiwu e lwet buche mag gwengʼ kendo norodhu gi del e sinagoke. Unuchungʼ kiyalou e nyim jotelo gi ruodhi nikech An, kendo unulandnegi Injili.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.9",
                "verseOrgIds": [
                  "MRK.13.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.9",
            "verseOrgIds": [
              "MRK.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To Injili nyaka kuong landi e pinje duto.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.10",
                "verseOrgIds": [
                  "MRK.13.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.10",
            "verseOrgIds": [
              "MRK.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "E sa asaya momakue moteru e bura, kik uparru motelo kuom gima duwachi. Wachuru awacha gima omiu mondo uwachi e sa nogono, nikech Roho Maler ema nobed kawuoyo kuomu, to ok un uwegi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.11",
                "verseOrgIds": [
                  "MRK.13.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngʼato nondhogi gi owadgi mondo onegi, kendo wuoro nondhog nyathine. Nyithindo nongʼany ne jonywolgi kendo nomi neg-gi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.12",
                "verseOrgIds": [
                  "MRK.13.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.12",
            "verseOrgIds": [
              "MRK.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ji duto nochau nikech an, to ngʼat ma ochungʼ motegno nyaka giko ema noresi.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.13",
                "verseOrgIds": [
                  "MRK.13.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To ka uneno 'gima kwero makelo kethruok'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.14",
                "verseOrgIds": [
                  "MRK.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kochungʼ kama ok onego obedie, to dwarore ni jasomo owinj tiend wachni maber, eka joma ni Judea oring odhi ewi gode.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.14",
                "verseOrgIds": [
                  "MRK.13.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngʼat manie wi tat ode bende kik lor piny kata donji ei ot mondo okaw gimoro amora oago.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.15",
                "verseOrgIds": [
                  "MRK.13.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kata ngʼat manie puodho kik dog dala mondo okaw kode.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.16",
                "verseOrgIds": [
                  "MRK.13.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mano kaka nodok malit ne mon ma yach kod mago madhodho nyithindo e ndalogo!",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.17",
                "verseOrgIds": [
                  "MRK.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lamuru Nyasaye mondo gino kik timre e ndalo chwiri,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.18",
                "verseOrgIds": [
                  "MRK.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nikech ndalogo nobed kinde mag chandruok ma ok nyal pim gi moro nyaka aa chakruok, chiengʼ mane Nyasaye ochweyoe piny, nyaka sani; kendo onge chandruok moro mibiro pimo kode kendo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.19",
                "verseOrgIds": [
                  "MRK.13.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka Ruoth dine ok ongʼado ndalogo machiek, onge ngʼama dine otony; to nikech joma oyier, joge owuon ma osewalo, osengʼado ndalogo odoko machiek.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.20",
                "verseOrgIds": [
                  "MRK.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "E kindeno ka ngʼato owachonu ni, 'Ne, Kristo ni ka!' kata ni, 'Ne, En kucha!' to kik uyie wachno.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.21",
                "verseOrgIds": [
                  "MRK.13.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar joma wuondore ni gin Kristo to ok gin kod joma wuondore ni gin jonabi to ok gin nothinyre mi tim ranyisi kod honni mondo giwuondgo koda ka joma oyier, ka dipo mano ditimre.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.22",
                "verseOrgIds": [
                  "MRK.13.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
              "MRK.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Emomiyo ritreuru un uwegi; asenyisou gik moko duto motelo kapok kindego ochopo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.23",
                "verseOrgIds": [
                  "MRK.13.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To e ndalono, bangʼ masirano maduongʼno,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MRK 13:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Wangʼ chiengʼ noimre,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 13:24"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kendo dwe ok norieny;",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.24",
                "verseOrgIds": [
                  "MRK.13.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sulwe nolwar koa e polo,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.25",
                "verseOrgIds": [
                  "MRK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MRK 13:25"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kendo chwech mag polo noyiengni!'",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.25",
                "verseOrgIds": [
                  "MRK.13.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To gie kindeno ji none Wuod Dhano kabiro koa e boche polo gi teko mangʼongo kod duongʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.26",
                "verseOrgIds": [
                  "MRK.13.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kendo enoor malaikege mi ochok joge moyiero moa e tunge piny nyaka chop giko polo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.27",
                "verseOrgIds": [
                  "MRK.13.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To puonjreuru wachni kuom yiend ngʼowu. Mapiyo ka bedene chako loth kendo itgi chako wuok to ungʼeyo ni ndalo oro chiegni.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.28",
                "verseOrgIds": [
                  "MRK.13.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kata kamano, ka uneno ka gigi timore to ngʼeuru ni kindeno chiegni, mana ka gima en e dhoot.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.29",
                "verseOrgIds": [
                  "MRK.13.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Awachonu adier ni tiengʼni ok norum ngangʼ kapok gigi duto otimore.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.30",
                "verseOrgIds": [
                  "MRK.13.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Polo gi piny norum to wechena ok norum ngangʼ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.31",
                "verseOrgIds": [
                  "MRK.13.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Odiechiengʼ kod sa ok ongʼere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Onge ngʼato mongʼeyo odiechiengno kata sa, obed malaike manie polo kata Wuowi, makmana Wuoro kende.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.32",
                "verseOrgIds": [
                  "MRK.13.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.32",
            "verseOrgIds": [
              "MRK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Beduru motangʼ kendo ritreuru, nikech ok ungʼeyo sa manotimre.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.33",
                "verseOrgIds": [
                  "MRK.13.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.33",
            "verseOrgIds": [
              "MRK.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nobed mana machal gi ngʼat mowuok e dalane odhi wuoth moro mabor, moweyo jotichne e tich mar rito gige, kosemiyo moro ka moro kuomgi gima onego otim, kendo koseketo jarito mondo orit dhoot.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.34",
                "verseOrgIds": [
                  "MRK.13.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omiyo ritreuru nikech ok ungʼeyo sa ma wuon ot nyalo biroe: kata nobi odhiambo kata chuny otieno, kata kogwen, kata ka piny yawore.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.35",
                "verseOrgIds": [
                  "MRK.13.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.35",
            "verseOrgIds": [
              "MRK.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kaponi obiro apoya nono to kik oyudi kinindo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.36",
                "verseOrgIds": [
                  "MRK.13.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.36",
            "verseOrgIds": [
              "MRK.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gima awachonu ema, awacho ni ji duto ni, 'Nenuru!' \"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.13.37",
                "verseOrgIds": [
                  "MRK.13.37"
                ]
              }
            }
          ]
        }
