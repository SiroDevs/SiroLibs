{
  "id": "MRK.8",
  "number": "8",
  "bookId": "MRK",
  "reference": "Mariko 8",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "MRK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu opidho ji alufu angʼwen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindego oganda maduongʼ machielo nochokore. To nikech ne gionge gi gima digicham, Yesu noluongo jopuonjrene ire mowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.1",
            "verseOrgIds": [
              "MRK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Akecho jogi nikech koro gisebedo koda kae kuom ndalo adek to gionge gima digicham.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.2",
                "verseOrgIds": [
                  "MRK.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.2",
            "verseOrgIds": [
              "MRK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka agonyogi gidhi thuchegi ka gidenyo kama to ginyalo podho e yo, nikech moko kuomgi oa mabor.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.3",
                "verseOrgIds": [
                  "MRK.8.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopuonjrene nodwoke niya, \"Ere kuma ngʼato diyudie makati manyalo pidho jogi mayiengʼ e dier thim machal kama?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.4",
            "verseOrgIds": [
              "MRK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Un gi makati adi?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.5",
                "verseOrgIds": [
                  "MRK.8.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:5"
      },
      "items": [
        {
          "text": "Negidwoke niya, \"Abiriyo kende.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachone ogandago mondo obed piny e lum. Bangʼ mano nokawo makati abiriyogo, kendo kane osegoyo erokamano, nongʼingogi bangʼe omiyogi jopuonjrene mondo opog ji, mine gitimo kamano.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "To ne gin gi rech moko manok bende. Rechgi bende Yesu nogwedho momiyo jopuonjrene mondo opog ni ji.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nochiemo moyiengʼ. Bangʼ chiemo jopuonjre nochoko ngʼinjo mag chiemo mane ji ochamo oweyo moromo okepe abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kar romb joma chwo mane ni kanyo ne dirom alufu angʼwen. To ka nosegonyogi,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nodonjo e yie, kaachiel gi jopuonjrene, mi gidhi e gwengʼ mar Dalmanutha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Farisai nobiro mochako mino wach gi Yesu. Ne gikone mondo omigi ranyisi moa e polo, ka giteme.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noomo chunye amingʼa bangʼe owacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tiengʼni dwaro ranyisi mar hono nangʼo? Awachonu adier ni onge ranyisi moro amora mibiro migi.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.12",
                "verseOrgIds": [
                  "MRK.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu noweyogi mi odok odonjo e yie mongʼado nam odok loka machielo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thowi mar jo-Farisai gi mar Herode",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jopuonjrene wigi nowil ma ok gitingʼo makati, makmana makati achiel kende ema ne gin-go e yie.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.14",
            "verseOrgIds": [
              "MRK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nosiemogi kawachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.15",
            "verseOrgIds": [
              "MRK.8.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Beduru motangʼ kendo ritreuru maber kuom thowi mar jo-Farisai gi mar Herode.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.15",
                "verseOrgIds": [
                  "MRK.8.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne giwuoyo kendgi kuom wachni kagiwacho niya, \"Owuoyo kamano nikech waonge gi makati.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.16",
            "verseOrgIds": [
              "MRK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kaka nongʼeyo gima negiwacho, Yesu nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Angʼo momiyo uwacho ni uonge gi makati? Kare pok uneno kata wach pok odonjonu? Dipo ni chunyu odinore?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.17",
                "verseOrgIds": [
                  "MRK.8.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.17",
            "verseOrgIds": [
              "MRK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Marangʼo un gi wengeu to ok unyal neno, kendo un gi it to ok unyal winjo? Donge uparo gik mane atimo?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.18",
                "verseOrgIds": [
                  "MRK.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.18",
            "verseOrgIds": [
              "MRK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kane angʼingo makati abich mondo ji alufu abich ocham, ne uchoko ngʼinjo mopongʼo okepe adi?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.19",
                "verseOrgIds": [
                  "MRK.8.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:19"
      },
      "items": [
        {
          "text": "Negidwoke niya, \"Apar gariyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.19",
            "verseOrgIds": [
              "MRK.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To kane angʼingo makati abiriyo ne ji alufu angʼwen, nuchoko okepe adi mag ngʼinjo?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.20",
                "verseOrgIds": [
                  "MRK.8.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:20"
      },
      "items": [
        {
          "text": "Negidwoke niya, \"Abiriyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.20",
            "verseOrgIds": [
              "MRK.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu nowachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.21",
            "verseOrgIds": [
              "MRK.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pod ok uwinjo tiend wach?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.21",
                "verseOrgIds": [
                  "MRK.8.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ochango muofu Bethsaida",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negichopo Bethsaida, kendo jomoko nokelo ne Yesu muofu moro mi gikwayo mondo omule.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nomako lwet ngʼatno mi otere oko mar dalano. Ka nosengʼulo olawo e wangʼ muofuno noketo lwete kuome, eka nopenje niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bende ineno gimoro?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.23",
                "verseOrgIds": [
                  "MRK.8.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼatno notingʼo wiye, mongʼicho bangʼe owacho ni Yesu niya, \"Aneno ji, ka gichalo gi yiende mawuotho koni gi koni.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nochako oketo lwetene e wenge ngʼatno kendo, mi wengene noyawore mi koro nonyalo neno gik moko duto maler.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano Yesu nochike mondo odhi pacho, kowachone niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kik iraw e dala mar Bethsaida.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.26",
                "verseOrgIds": [
                  "MRK.8.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petro ohulo ni Yesu e Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼe Yesu gi jopuonjrene ne jowuok modhi e gwenge mag Kaisaria Filipi. To kane gin e yo gidhi, nopenjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Uwinjo ji wacho ni An ngʼa?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.27",
                "verseOrgIds": [
                  "MRK.8.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negidwoke niya, \"Jomoko wacho ni in Johana Ja-batiso, to jomoko wacho ni in Elija, to jomoko bende wacho ni in achiel kuom jonabi machon.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nomedo penjogi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"To un to? Uwacho ni An ngʼa?\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.29",
                "verseOrgIds": [
                  "MRK.8.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MRK 8:29"
      },
      "items": [
        {
          "text": "Petro nodwoke niya, \"In e Kristo.\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano Yesu nosiemogi ni kik ginyis ngʼato angʼata ngʼama en.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu okoro tho mare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa kanyo Yesu nochako puonjogi ni Wuod Dhano nyaka yud sand mangʼeny kendo ibiro kwede gi jodong oganda gi jodolo madongo kod jopuonj chik, bende nyaka nonege kendo chiengʼ mar adek nochier kendo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wechegi nowacho ayanga, mi Petro nokawe otere tenge mi okwere ni owe wuoyo kamano.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Yesu nolokore mongʼiyo jopuonjrene, bangʼe to okwero Petro kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wuog oko e nyima Satan! Iketo pachi kuom dwaro dhano, to ok kuom dwach Nyasaye.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.33",
                "verseOrgIds": [
                  "MRK.8.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Yesu noluongo oganda ire, kaachiel gi jopuonjrene mi owachonegi niya,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka ngʼato dwaro luwo bangʼa to nyaka okwedre kende owuon kendo otingʼ msalape eka oluwa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.34",
                "verseOrgIds": [
                  "MRK.8.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nimar ngʼama dwaro reso ngimane, ngimane biro lalne, to ngʼatno mowito ngimane nikech an kendo nikech Injili nores ngimane.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.35",
                "verseOrgIds": [
                  "MRK.8.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ere ber ma ngʼato yudo ka piny duto obedo mare to ngimane to olalne?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.36",
                "verseOrgIds": [
                  "MRK.8.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koso en angʼo ma ngʼato dichiw mondo owil gi ngimane?",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.37",
                "verseOrgIds": [
                  "MRK.8.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka ngʼato wiye kuot koda kod wechena e kind tiengʼ mobam kendo matimo richoni, to Wuod Dhano bende wiye nokuod kode chiengʼ manoduogi gi duongʼ mar Wuoro, kaachiel gi Malaike maler.\"",
              "type": "text",
              "attrs": {
                "verseId": "MRK.8.38",
                "verseOrgIds": [
                  "MRK.8.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
