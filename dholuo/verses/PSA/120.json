  "verseCount": 7,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "120",
        "style": "c",
        "sid": "PSA 120"
      },
      "items": [
        {
          "text": "120",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 120",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer miwero ka ji dhi e hekalu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 120:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka an e chandruok to aluongo Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:1"
      },
      "items": [
        {
          "text": "kendo odwoka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.1",
            "verseOrgIds": [
              "PSA.120.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 120:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa, yaye Jehova Nyasaye, kuom dho joma riambo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:2"
      },
      "items": [
        {
          "text": "kendo kuom lew joma wuondore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.2",
            "verseOrgIds": [
              "PSA.120.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 120:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ingʼeyo gima Nyasaye biro timoni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:3"
      },
      "items": [
        {
          "text": "bende ingʼeyo gik mochomi adier, yaye lep mawuondore?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.3",
            "verseOrgIds": [
              "PSA.120.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 120:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiro kumi gi aserni mabitho mag jakedo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:4"
      },
      "items": [
        {
          "text": "ee, obiro wangʼi gi maka maliel mager,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:4"
      },
      "items": [
        {
          "text": "mowangʼ gi yiend adugo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.4",
            "verseOrgIds": [
              "PSA.120.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 120:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malit ochoma adier nikech adak Meshek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:5"
      },
      "items": [
        {
          "text": "hapa rach nikech adak e dier hembe mag Kedar!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.5",
            "verseOrgIds": [
              "PSA.120.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 120:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asedak amingʼa ahinya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:6"
      },
      "items": [
        {
          "text": "e dier joma ok dwar kwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.6",
            "verseOrgIds": [
              "PSA.120.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 120:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "An ngʼat kwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 120:7"
      },
      "items": [
        {
          "text": "to ka awuoyo, to giikore ni lweny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.120.7",
            "verseOrgIds": [
              "PSA.120.7"
            ]
          }
        }
      ]
    }
  ],
