            "number": "1",
            "style": "v",
            "sid": "PSA 123:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atingʼo wangʼa ka arango,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:1"
      },
      "items": [
        {
          "text": "in ma kom lochni ni e polo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 123:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka wenge wasumbini rango lwet ruodhgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "kendo kaka wenge jatich ma nyako mar ot rango lwet ruodhe madhako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "e kaka wengewa rango Jehova Nyasaye ma Nyasachwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "nyaka chop okechwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
