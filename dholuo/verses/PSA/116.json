  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "116",
        "style": "c",
        "sid": "PSA 116"
      },
      "items": [
        {
          "text": "116",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 116",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 116:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahero Jehova Nyasaye nikech nowinjo kwayona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:1"
      },
      "items": [
        {
          "text": "nowinjo ywakna kane adwaro kech.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 116:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ne ochikona ite,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:2"
      },
      "items": [
        {
          "text": "abiro luonge kinde duto ma angima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 116:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonde mag tho norida, lit mar liel nochopona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:3"
      },
      "items": [
        {
          "text": "kendo chandruok gi chuny lit noloya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 116:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka naluongo nying Jehova Nyasaye, ne aywakne niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:4"
      },
      "items": [
        {
          "text": "\"Resa, yaye Jehova Nyasaye!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 116:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ngʼwon kendo timo maber;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:5"
      },
      "items": [
        {
          "text": "Nyasachwa opongʼ gi kech.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 116:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye rito joma chunygi obolore;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:6"
      },
      "items": [
        {
          "text": "kane an-gi chando maduongʼ to ne oresa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 116:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed abeda mos, yaye chunya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:7"
      },
      "items": [
        {
          "text": "nimar Jehova Nyasaye osebedo katimoni maber ndalo duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 116:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar in ema isegolo chunya e tho, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "wengena bende isereso e ywak,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "kendo tiendena isegengʼo mondo kik okier,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 116:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "isetimo kamano mondo awuothi e nyim Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:9"
      },
      "items": [
        {
          "text": "e piny joma ngima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 116:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ayie; emomiyo ne awacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:10"
      },
      "items": [
        {
          "text": "\"Sand oromo chunya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 116:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo kane achiedh-nade omaka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:11"
      },
      "items": [
        {
          "text": "to ne awacho niya, \"Dhano duto riambo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 116:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ere kaka dachul Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:12"
      },
      "items": [
        {
          "text": "kuom berne duto mosetimona?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 116:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro tingʼo okumba mar warruok malo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:13"
      },
      "items": [
        {
          "text": "kendo abiro luongo nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 116:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro chopo singruokga ma asetimo ne Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:14"
      },
      "items": [
        {
          "text": "e nyim ji duto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 116:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tho mar nyithind Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:15"
      },
      "items": [
        {
          "text": "en gima ber miwuoro e nyim Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 116:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, an jatichni adier;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "an jatichni, ma wuod jatichni ma nyako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:16"
      },
      "items": [
        {
          "text": "isegonya mi igola e nyorochena.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 116:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro timoni misango mar erokamano",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:17"
      },
      "items": [
        {
          "text": "kendo abiro luongo nying Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
