  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "111",
        "style": "c",
        "sid": "PSA 111"
      },
      "items": [
        {
          "text": "111",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 111",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 111:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pak ne Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "Abiro miyo Jehova Nyasaye duongʼ gi chunya duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "abiro miye duongʼ e buch joma kare kendo e dier chokruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 111:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tije Jehova Nyasaye dongo adier;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:2"
      },
      "items": [
        {
          "text": "joma mor kodgi osiko kaparo kuomgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 111:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbene nigi duongʼ kod luor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:3"
      },
      "items": [
        {
          "text": "kendo timne makare osiko nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 111:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo waparo kuom honni mage;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:4"
      },
      "items": [
        {
          "text": "nikech Jehova Nyasaye ngʼwon kendo okecho ji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 111:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochiwo chiemo ne joma omiye luor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:5"
      },
      "items": [
        {
          "text": "kendo oparo singruok mare nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 111:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osenyiso joge tekre kuom gik motimo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:6"
      },
      "items": [
        {
          "text": "komiyogi lope mag ogendini moko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 111:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tije motimo gi lwetene nikare",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:7"
      },
      "items": [
        {
          "text": "kendo beyo kendo buchene duto inyalo geno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 111:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gingirore kendo ok gilokre mochwere manyaka chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:8"
      },
      "items": [
        {
          "text": "nikech osetimgi gi adiera kendo moriere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 111:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ochiwo warruok ne joge,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "kendo ne oguro singruokne mosiko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "nyinge ler kendo lich miwuoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 111:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro Jehova Nyasaye e chakruok mar rieko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "ji duto moluwo buchene nigi winjo maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "En kende ema owinjore yudo pak manyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    }
  ],
