        "sid": "PSA 80"
      },
      "items": [
        {
          "text": "80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 80",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. E dwol mar \"Ondanyo mar Singruok.\" Mar Asaf. Zaburi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 80:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiknwa iti, yaye Jakwadh jo-Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "in mitelo ne Josef ka kweth mar dhok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "In mibet e kom loch e kind kerubi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "koro rieny ane",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 80:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "e nyim Efraim, gi Benjamin gi Manase.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "Nyis tekri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "kendo bi mondo ireswa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 80:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwogwa iri, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "mi wangʼi orienynwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "eka mondo wayud warruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 80:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, ma Nyasaye Maratego,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "mirimbi biro siko koyienyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "gi lamo mar jogi nyaka karangʼo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 80:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isemiyo gichamo pi wangʼ ka kuon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:5"
      },
      "items": [
        {
          "text": "kendo isemiyo gimodho pi wangʼ agwetni modhuro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 80:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isemiyo wadoko rachwany ne jobutwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:6"
      },
      "items": [
        {
          "text": "kendo wasikwa jarowa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 80:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwogwa iri, yaye Nyasaye Maratego;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "mi wangʼi orienynwa, eka mondo wayud warruok.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne igolo mzabibu moro e piny Misri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:8"
      },
      "items": [
        {
          "text": "kendo ne iriembo ogendini mi ipidhe kargi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 80:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ilosone lowo maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "kendo nochwoyo tiendene piny mi opongʼo piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 80:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tipo Nyasaye noimo gode duto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:10"
      },
      "items": [
        {
          "text": "mana ka yiende sida ma odongo ma bedene olak.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 80:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noyaro bedene madongo nyaka e Nam Mediterania",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:11"
      },
      "items": [
        {
          "text": "kendo noloth mochweyo nyaka e Aora Yufrate.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 80:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro angʼo momiyo isemuko ohinga mage,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:12"
      },
      "items": [
        {
          "text": "momiyo ji duto makadho pone ka olemo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 80:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbithe moa e bungu kethe, kendo le mag bungu chame.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 80:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duog irwa, yaye Nyasaye Maratego!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Ngʼi piny gie polo mondo ine!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "Ngʼi mzabibu maber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 80:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yien ma lweti ma korachwich ema nopidho gi tiende,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:15"
      },
      "items": [
        {
          "text": "ma en wuodi misepidho in iwuon.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 80:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mzabibu mari osetongʼ mi owangʼ gi mach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.16",
            "verseOrgIds": [
              "PSA.80.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:16"
      },
      "items": [
        {
          "text": "jogi lal nono nikech isekwerogi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.16",
            "verseOrgIds": [
              "PSA.80.17"
            ]
          }
        }
      ]
