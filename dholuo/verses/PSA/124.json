      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 124:1"
      },
      "items": [
        {
          "text": "jo-Israel mondo owach kamano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.124.1",
            "verseOrgIds": [
              "PSA.124.1"
            ]
          }
        }
      ]
    },
