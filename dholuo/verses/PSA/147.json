          "text": "147",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 147",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 147:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuru Jehova Nyasaye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "Mano kaka en gima ber wero wende pak ne Nyasachwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:1"
      },
      "items": [
        {
          "text": "mano kaka en gima longʼo kendo mowinjore mondo ji opake!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.1",
            "verseOrgIds": [
              "PSA.147.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 147:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye gero Jerusalem kendo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:2"
      },
      "items": [
        {
          "text": "ochoko jo-Israel mane otwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.2",
            "verseOrgIds": [
              "PSA.147.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 147:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochango joma chunygi tuo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:3"
      },
      "items": [
        {
          "text": "kendo othiedho adhondegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.3",
            "verseOrgIds": [
              "PSA.147.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 147:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osekwano kendo ongʼeyo kar romb sulwe duto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:4"
      },
      "items": [
        {
          "text": "kendo oluongo moro ka moro kuomgi gi nyinge.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.4",
            "verseOrgIds": [
              "PSA.147.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 147:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruodhwa duongʼ kendo en gi teko kendo nyalo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:5"
      },
      "items": [
        {
          "text": "ngʼeyone onge gikone.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.5",
            "verseOrgIds": [
              "PSA.147.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 147:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye tingʼo joma obolore malo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:6"
      },
      "items": [
        {
          "text": "to joma timbegi richo to ochwado piny e lowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.6",
            "verseOrgIds": [
              "PSA.147.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 147:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weruru ne Jehova Nyasaye kugoyone erokamano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:7"
      },
      "items": [
        {
          "text": "weruru wer mamit ne Nyasachwa kugoyo nyatiti.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.7",
            "verseOrgIds": [
              "PSA.147.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 147:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oumo kor polo gi boche polo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "kendo oromo piny gi koth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:8"
      },
      "items": [
        {
          "text": "bende omiyo lum twi ewi thuche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.8",
            "verseOrgIds": [
              "PSA.147.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 147:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochiwo chiemo ne dhok",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:9"
      },
      "items": [
        {
          "text": "kendo ne agege ka giywakne.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.9",
            "verseOrgIds": [
              "PSA.147.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 147:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Morne ok ni kuom teko farase",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:10"
      },
      "items": [
        {
          "text": "kata kuom ogwand dhano;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.10",
            "verseOrgIds": [
              "PSA.147.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 147:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "to Jehova Nyasaye mor gi joma omiye luor;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:11"
      },
      "items": [
        {
          "text": "joma oketo genogi kuom herane ma ok rem.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.11",
            "verseOrgIds": [
              "PSA.147.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 147:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dhial Jehova Nyasaye, yaye Jerusalem;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:12"
      },
      "items": [
        {
          "text": "pak Nyasachi, yaye Sayun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.12",
            "verseOrgIds": [
              "PSA.147.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 147:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omedo sirni manie dhorangeyeni teko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:13"
      },
      "items": [
        {
          "text": "kendo ogwedho jogi modak e iyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.13",
            "verseOrgIds": [
              "PSA.147.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 147:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo kwe bedo e tongʼ pinyu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:14"
      },
      "items": [
        {
          "text": "kendo oromou gi ngano mabeyoe mogik.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.14",
            "verseOrgIds": [
              "PSA.147.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 147:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ooro chikne e piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.15",
            "verseOrgIds": [
              "PSA.147.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:15"
      },
      "items": [
        {
          "text": "kendo wachne ringo matek ka diemo wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.15",
            "verseOrgIds": [
              "PSA.147.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 147:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyaro pe ka yie rombo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.16",
            "verseOrgIds": [
              "PSA.147.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:16"
      },
      "items": [
        {
          "text": "kendo okeyo ongʼwengʼo ka buru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.16",
            "verseOrgIds": [
              "PSA.147.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 147:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiro pe mage e piny ka kit ombo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.17",
            "verseOrgIds": [
              "PSA.147.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 147:17"
      },
      "items": [
        {
          "text": "En ngʼa manyalo ngino sa ma odiro pe kamano?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.147.17",
            "verseOrgIds": [
              "PSA.147.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
