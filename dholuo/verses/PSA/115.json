          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 115",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 115:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok wan, ok wan, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "to In ema nyingi oyud duongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "nikech herani kod adierani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 115:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angʼo momiyo ogendini penjo niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:2"
      },
      "items": [
        {
          "text": "\"Nyasachgino ere?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 115:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasachwa ni e polo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:3"
      },
      "items": [
        {
          "text": "otimo gimoro amora mohero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 115:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "To nyisechegi mopa gin fedha gi dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:4"
      },
      "items": [
        {
          "text": "molos gi lwet dhano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 115:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gi dhogi, to kata kamano ok ginyal wuoyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:5"
      },
      "items": [
        {
          "text": "gin gi wenge to ok ginyal neno gimoro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 115:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gi it, to ok ginyal winjo wach,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:6"
      },
      "items": [
        {
          "text": "kendo gin gi um, to ok ginyal ngʼwecho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 115:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin gi lwetegi, to ok ginyal mulo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "kendo gin gi tiende to ok ginyal wuotho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "bende ok ginyal kata temo loso gi dwondgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 115:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma losogi nobed machal kodgi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:8"
      },
      "items": [
        {
          "text": "kendo joma oketo genogi kuomgi bende biro chalo kodgi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 115:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye dhood jo-Israel, genuru kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:9"
      },
      "items": [
        {
          "text": "En e konyruokgi kendo okumbagi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 115:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye dhood joka Harun, genuru kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:10"
      },
      "items": [
        {
          "text": "En e konyruokgi kendo okumbagi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 115:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Un joma omiyo Jehova Nyasaye luor, keturu genou kuome,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.11",
            "verseOrgIds": [
              "PSA.115.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:11"
      },
      "items": [
        {
          "text": "En e konyruokgi kendo okumbagi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.11",
            "verseOrgIds": [
              "PSA.115.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 115:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye parowa kendo obiro gwedhowa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:12"
      },
      "items": [
        {
          "text": "obiro gwedho dhood Israel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:12"
      },
      "items": [
        {
          "text": "obiro gwedho dhood joka Harun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 115:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "obiro gwedho joma oluoro Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.13",
            "verseOrgIds": [
              "PSA.115.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:13"
      },
      "items": [
        {
          "text": "ji ajia kod joma igeno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.13",
            "verseOrgIds": [
              "PSA.115.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 115:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad Jehova Nyasaye mi imedri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.14",
            "verseOrgIds": [
              "PSA.115.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:14"
      },
      "items": [
        {
          "text": "in kaachiel gi nyithindi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.14",
            "verseOrgIds": [
              "PSA.115.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 115:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad iyud gweth moa kuom Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.15",
            "verseOrgIds": [
              "PSA.115.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:15"
      },
      "items": [
        {
          "text": "jachwech polo gi piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.15",
            "verseOrgIds": [
              "PSA.115.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 115:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo malo mogik en mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.16",
            "verseOrgIds": [
              "PSA.115.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:16"
      },
      "items": [
        {
          "text": "to piny to osechiwo ne dhano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.16",
            "verseOrgIds": [
              "PSA.115.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 115:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma osetho ok ema pak Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.17",
            "verseOrgIds": [
              "PSA.115.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:17"
      },
      "items": [
        {
          "text": "joma oseiki molingʼ thi e bur ok pake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.17",
            "verseOrgIds": [
              "PSA.115.17"
            ]
          }
        }
      ]
    },
