  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "PSA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer. Zaburi mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Polo hulo duongʼ mar Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:1"
      },
      "items": [
        {
          "text": "kor polo nyiso tich mar lwete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.1",
            "verseOrgIds": [
              "PSA.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odiechiengʼ kodiechiengʼ gilando wach;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:2"
      },
      "items": [
        {
          "text": "otieno kotieno ginyiso rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.2",
            "verseOrgIds": [
              "PSA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gionge dhok kata weche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:3"
      },
      "items": [
        {
          "text": "kata dwondgi ok winji.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.3",
            "verseOrgIds": [
              "PSA.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano dwondgi chopo kuonde duto e piny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "wechegi osechopo nyaka e tunge piny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:4"
      },
      "items": [
        {
          "text": "Osechungo hema e kor polo ne wangʼ chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.4",
            "verseOrgIds": [
              "PSA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "machalo gi wuon kisera mothinyore oko kawuok e ode mar mor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:5"
      },
      "items": [
        {
          "text": "kendo mana ka jangʼwech mongirore moil moikore ni chako ngʼwech.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.5",
            "verseOrgIds": [
              "PSA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owuok gie tungʼ polo konchiel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "kendo olworore nyaka komachielo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:6"
      },
      "items": [
        {
          "text": "onge gima opondo ne liet mare.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.6",
            "verseOrgIds": [
              "PSA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chik Jehova Nyasaye longʼo chuth,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "odwogo chuny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "Buche mag Jehova Nyasaye gin adiera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:7"
      },
      "items": [
        {
          "text": "gimiyo joma riekogi tin bedo mariek.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.7",
            "verseOrgIds": [
              "PSA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chike mag Jehova Nyasaye nikare,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "gichiwo mor ne chuny.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "Chike mag Jehova Nyasaye rieny,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:8"
      },
      "items": [
        {
          "text": "gichiwo ler ne wangʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.8",
            "verseOrgIds": [
              "PSA.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro Jehova Nyasaye en gima ber,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "mosiko nyaka chiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "Buche mag Jehova Nyasaye gin adier",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:9"
      },
      "items": [
        {
          "text": "kendo gin kare kargi giduto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.9",
            "verseOrgIds": [
              "PSA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gibeyo moloyo dhahabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "moloyo dhahabu malerie moloyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "gimit moloyo mor kich",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:10"
      },
      "items": [
        {
          "text": "moa e pedni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.10",
            "verseOrgIds": [
              "PSA.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gin ema gimiyo jatichni bedo motangʼ; kendo bedogi kanyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:11"
      },
      "items": [
        {
          "text": "kelo pok maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.11",
            "verseOrgIds": [
              "PSA.19.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa manyalo ngʼeyo kethone mopondo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:12"
      },
      "items": [
        {
          "text": "Wena kethoga mopondo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.12",
            "verseOrgIds": [
              "PSA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende gengʼ jatichni kuom richo mag wich teko;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "mad kik gibed gi loch kuoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "Eka anabed maonge ketho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 19:13"
      },
      "items": [
        {
          "text": "anabed ka aonge gi ketho chik moro maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.13",
            "verseOrgIds": [
              "PSA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad weche mawuok e dhoga, kod paro manie chunya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.19.14",
            "verseOrgIds": [
              "PSA.19.15"
            ]
          }
        }
      ]
    },
