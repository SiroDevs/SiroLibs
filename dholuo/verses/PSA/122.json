  "verseCount": 9,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "122",
        "style": "c",
        "sid": "PSA 122"
      },
      "items": [
        {
          "text": "122",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 122",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Wer ma ji wero kadhi e hekalu. Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 122:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amor gi joma nowachona niya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:1"
      },
      "items": [
        {
          "text": "\"Wadhiuru e od Jehova Nyasaye.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.1",
            "verseOrgIds": [
              "PSA.122.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 122:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendewa ochungʼ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:2"
      },
      "items": [
        {
          "text": "e dhorangeyeni, yaye Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.2",
            "verseOrgIds": [
              "PSA.122.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 122:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jerusalem oger ka dala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:3"
      },
      "items": [
        {
          "text": "ma ji odakie machiegni motenore.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.3",
            "verseOrgIds": [
              "PSA.122.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 122:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyo e kama ogendini idho dhiye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "ogendini mag Jehova Nyasaye dhi kuno,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "mondo opak nying Jehova Nyasaye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:4"
      },
      "items": [
        {
          "text": "ka giluwo chike mane omi Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.4",
            "verseOrgIds": [
              "PSA.122.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 122:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyo ema kombe loch mag ngʼado bura nitie",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:5"
      },
      "items": [
        {
          "text": "gin kombe loch mag jood Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.5",
            "verseOrgIds": [
              "PSA.122.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 122:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamuru mondo Jerusalem obed gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:6"
      },
      "items": [
        {
          "text": "Lamuru niya, \"Mad joma oheri bed gi kwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.6",
            "verseOrgIds": [
              "PSA.122.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 122:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad kwe yudre ei alworani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:7"
      },
      "items": [
        {
          "text": "adier kwe mondo obedi ei ohinga mochieli.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.7",
            "verseOrgIds": [
              "PSA.122.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 122:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech owetena gi osiepena modak e iyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:8"
      },
      "items": [
        {
          "text": "awacho niya, \"Jerusalem mondo obed gi kwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.8",
            "verseOrgIds": [
              "PSA.122.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 122:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech wach od Jehova Nyasaye ma Nyasachwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 122:9"
      },
      "items": [
        {
          "text": "adwaro ni idhi maber.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.122.9",
            "verseOrgIds": [
              "PSA.122.9"
            ]
          }
        }
      ]
    }
  ],
