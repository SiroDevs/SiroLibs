  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "141",
        "style": "c",
        "sid": "PSA 141"
      },
      "items": [
        {
          "text": "141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 141",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zaburi Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 141:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aluongi, yaye Jehova Nyasaye, yie ibi ira piyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:1"
      },
      "items": [
        {
          "text": "Yie iwinj dwonda ka aluongi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.1",
            "verseOrgIds": [
              "PSA.141.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 141:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad lamona osiki e nyimi mana ka ubani miwangʼo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:2"
      },
      "items": [
        {
          "text": "kendo bedena osik koriere kochomo malo mana ka misango mitimoni godhiambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.2",
            "verseOrgIds": [
              "PSA.141.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 141:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye Jehova Nyasaye, ket jarit e dhoga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:3"
      },
      "items": [
        {
          "text": "ketna jarit mondo okonya umo dhoga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.3",
            "verseOrgIds": [
              "PSA.141.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 141:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iyie gimoro amora marach ywa chunya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "ma dimi an bende atim timbe maricho,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "kaachiel gi joma timbe gi richo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:4"
      },
      "items": [
        {
          "text": "rita mondo kik acham chiembgi mabeyonegi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.4",
            "verseOrgIds": [
              "PSA.141.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 141:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onego ngʼat makare ema ogoya, nikech mano chalo tim ngʼwono motimona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "onego en ema okwera, nikech mano chalo mo mool e wiya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "ok anyal dagi mondo ngʼama kare otimna kamano.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 141:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 141:5"
      },
      "items": [
        {
          "text": "To kata kamano obiro kwedo timbe joma richo e lemona;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.5",
            "verseOrgIds": [
              "PSA.141.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 141:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiengʼ ma nowit ruodhigi piny koa ewi got mabor,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:6"
      },
      "items": [
        {
          "text": "eka joma timbegi richo nongʼe ni kare wechena ne gin adier.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.6",
            "verseOrgIds": [
              "PSA.141.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 141:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giniwach niya, \"Mana kaka ngʼato puro kendo toyo lowo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:7"
      },
      "items": [
        {
          "text": "e kaka chokewa osekere e dho bur liel.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.7",
            "verseOrgIds": [
              "PSA.141.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 141:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anto atego wangʼa kuomi, yaye Jehova Nyasaye Manyalo Gik Moko Duto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:8"
      },
      "items": [
        {
          "text": "In e kar pondona, omiyo kik iwe atho.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.8",
            "verseOrgIds": [
              "PSA.141.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 141:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iwe obadho ma gisechikona maka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:9"
      },
      "items": [
        {
          "text": "ee, resa kuom otegu ma joma timbegi richo ochikona.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.9",
            "verseOrgIds": [
              "PSA.141.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 141:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad joma timbegi richogo moki e gokegi giwegi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 141:10"
      },
      "items": [
        {
          "text": "ka anto akadho maber mak gimoro otima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.141.10",
            "verseOrgIds": [
              "PSA.141.10"
            ]
          }
        }
      ]
    }
  ],
