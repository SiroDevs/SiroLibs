  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "69",
        "style": "c",
        "sid": "PSA 69"
      },
      "items": [
        {
          "text": "69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Zaburi 69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kuom jatend wer e dwol mar \"Ondanyo.\" Mar Daudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 69:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Resa, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:1"
      },
      "items": [
        {
          "text": "nikech pi oseima nyaka e ngʼuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 69:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asechako nimo e chwodho matut,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "kama onge lowo motegno ma ngʼato nyalo chungʼie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "Asechopo e chuny pi kama tut,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "kendo apaka olwora oketa diere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 69:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro aseywak mondo okonya mi aol;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "dwonda rewni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "Wengena pek,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "ka amanyo Nyasacha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 69:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma ochaya maonge gima omiyo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "ngʼeny moloyo yie wiya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "joma olokore wasika kayiem thoth adier,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "jogogo madwaro mondo otieka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "Ichuna mondo adwok",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "gima ne ok akwalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 69:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingʼeyo fupa, yaye Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:5"
      },
      "items": [
        {
          "text": "kethona ok opondoni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 69:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mad joma ogeno kuomi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "kik ne wichkuot nikech an,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "yaye Ruoth, Jehova Nyasaye Maratego;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "mad joma manyi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "kik ne wichkuot nikech an,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "yaye Nyasach Israel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 69:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimar ji yanya to alingʼ alingʼa nikech in,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:7"
      },
      "items": [
        {
          "text": "kendo wichkuot obako lela wangʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 69:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achalo wendo ne owetena",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:8"
      },
      "items": [
        {
          "text": "an kaka jamwa ne yawuot minwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 69:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech hera matut ma aherogo odi tieka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:9"
      },
      "items": [
        {
          "text": "kendo ayenje mag joma yanyi lwar kuoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 69:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aywak kendo atweyo chiemo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:10"
      },
      "items": [
        {
          "text": "to pod nyaka ayud ayany;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 69:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka arwako law ywak,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:11"
      },
      "items": [
        {
          "text": "to ji oloka ngero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 69:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma obet e rangach jara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:12"
      },
      "items": [
        {
          "text": "kendo alokora wer ma jokongʼo wero.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 69:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "To alami, yaye Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "e kinde ma iikori mar konya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "kuom herani maduongʼ, yaye Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "dwoka gi resruok mari mar adier.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
