        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Emomiyo ngʼato angʼata mawinjo wechenagi kendo otimogi chalo gi ngʼama riek mane ogero ode e lwanda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.24",
                "verseOrgIds": [
                  "MAT.7.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
