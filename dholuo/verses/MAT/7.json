        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ngʼato angʼata mawinjo wechenagi to ok otimgi chalo gi ngʼat mane ogero ode e kwoyo.",
