        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koth nochwe maduongʼ, aore nopongʼ mogingore kendo yamo nokudho matek mogoyo odno, mi norwombore piny gi ruombruok matek.\"",
