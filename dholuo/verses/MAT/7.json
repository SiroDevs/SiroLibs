            "style": "wj"
          },
          "items": [
            {
              "text": "Koth nochwe maduongʼ, aore nopongʼ mogingore, kendo yamo nokudho matek mogoyo odno; to kata kamano ne ok opodho, nikech mise mare ne ni e lwanda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.25",
                "verseOrgIds": [
                  "MAT.7.25"
                ]
