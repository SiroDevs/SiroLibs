          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "To ananyisgi e wangʼ-gi ni, 'Akiau nyaka aa chakruok, ayeuru e nyima, un jorichogi!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.7.23",
                "verseOrgIds": [
                  "MAT.7.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jogedo mariek gi jogedo mofuwo",
          "type": "text"
        }
      ]
    },
    {
