              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo beduru motangʼ kutimo gik moko duto ma Jehova Nyasaye ma Nyasachu ochikou, ka ok udok korachwich kata koracham.",
          "type": "text",
          "attrs": {
