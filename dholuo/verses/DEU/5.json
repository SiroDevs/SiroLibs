              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "To in dongʼ koda ka mondo amiyi chike gi buche duto manyaka ipuonjgi giriti e piny mamiyogi mondo gidagie.\"",
          "type": "text",
          "attrs": {
