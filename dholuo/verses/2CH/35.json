  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "2CH 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josia otimo Sap Pasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josia notimo Sap Pasaka ni Jehova Nyasaye e Jerusalem kendo ne oneg nyarombo mar Pasaka chiengʼ mar apar gangʼwen mar dwe mokwongo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noketo jodolo e tijegi kendo nojiwogi kuom tich hekalu mar Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowachone jo-Lawi mane osepwodhi ni Jehova Nyasaye mondo opuonj jo-Israel duto niya, \"Keturu Sanduku Maler e hekalu mane Solomon wuod Daudi ruodh Israel nogero. Ok onego utingʼe e goku. Omiyo tineuru Jehova Nyasaye ma Nyasachu kendo ni joge Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanreuru e migepe kaluwore gi anywolau kaka chik mane Daudi ruodh jo-Israel kod Solomon wuode ondiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chunguru Kama Ler gi jo-Lawi moko e kind migepe matindo mag anywola mar joweteu mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yangʼuru nyiromb Pasaka kendo pwodhreuru mondo ukony joweteu timo gima Jehova Nyasaye nochiko gi dho Musa mondo utim.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Josia nochiwo ni joma nochokore nyirombe gi diek moromo alufu piero adek kod rwedhi alufu adek mondo otimgo misango mar Pasaka. Magi duto nochiwo kogolo kuom mwandune owuon.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodonge bende nokelo chiwo kuom herogi ni ji gi jodolo kod jo-Lawi. Hilkia gi Zekaria kod Jehiel ma jotelo madongo mag hekalu mar Nyasaye nochiwo ni jodolo nyirombe kod diek alufu ariyo gi mia auchiel kod dhok mia adek mondo otimgo misango mar Pasaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konania bende, kaachiel gi Shemaya kod Nethanel ma owetene kod Hashabia gi Jeyel kod Jozabad mane jatend jo-Lawi nomiyo jo-Lawi nyirombe kod diek alufu abich kod dhok mia abich mondo otimgo misango mar Pasaka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane gige tich duto oseikore, jodolo nochungʼ keregi kendo jo-Lawi nobedo e migepegi kaka ne ruoth osechiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyirombe mag Pasaka nochinji kendo jo-Lawi nomiyo jodolo remo kapod giyangʼo chiayogo mi jodolo nokiro remogo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negiwalo mago mane mag misengini miwangʼo pep ma gimiyo migepe matindo tindo mag ariyo mar anywola mar ji mondo gichiwgi ni Jehova Nyasaye kaka ondiki e kitap Musa. Kamano bende e kaka negitimo kod dhok.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne gibulo jamni mag Pasaka ewi mach kaka chik owacho to ring misengini maler ne gitedo e agulni gi pipni kod sufuriache kendo negipogo ji mapiyo piyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano negiloso mag-gi giwegi kod misango mag jodolo nikech jodolo mane gin Nyikwa Harun ne timo misengini miwangʼo pep kod misango mag boche nyaka otieno, omiyo jo-Lawi noloso mag-gi giwegi kod mag jodolo ma nyikwa Harun.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jower ma nyikwa Asaf ne nitiere keregi kaluwore gi chik mar Daudi gi mar Asaf gi mar Heman kod mar Jeduthun janen mar ruoth. Jorit dhorangeye ne ok owuok kuondegi mag rito nikech owetegi ma jo-Lawi nosetedonigi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamano tije Jehova Nyasaye duto mar Sap Pasaka kod mar timo misengini miwangʼo pep e kendo mar misango mar Jehova Nyasaye notim chiengʼono, kaka ruoth Josia nochiko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Israel duto mane nitiere nochamo Pasaka e ndalono kendo negitimo Sap Makati ma ok oketie Thowi kuom ndalo abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasaka machal kamano ne pok otim e Israel chakre ndalo mag Samuel janabi; kendo onge ruodh Israel moro amora ma nosetimo Pasaka machal gi mane Josia kaachiel gi jodolo, jo-Lawi kod jo-Juda duto gi jo-Israel mane oriwore gi jo-Jerusalem otimo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasakani notim e higa mar apar gaboro mar loch Josia.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tho mar Josia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kane Josia osetieko loso hekalu, Neko ruodh Misri nodhi mondo oked e dala mar Karkemish man but Yufrate mi Josia nodhi mondo orad kode e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Neko noorone joote mondo owachne niya, \"En angʼo ma walaro kodi yaye ruodh Juda? In ok ema abiro amonji e kindeni, to amonjo dhoot ma wakedogo. Nyasaye osenyisa mondo atim piyo omiyo kik ipiem gi Nyasaye ma jakora ka ok kamano to obiro tieki.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, Josia ne ok oweye, omiyo nodhi korwakore magalagala mondo oked kode. Ne ok odewo gima Neko nonyise kaluwore gi gima Nyasaye ochiko to nodhi mokedo kode e paw Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jodir asere nochielo ruoth Josia mi nowacho ni jotichne niya, \"Golauru ka nimar asehinyora marach.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo ne gigole e gache ma gikete e gari machielo mane en-go ma gikele Jerusalem kama nothoe. Noyike e liete mag kwerene kendo jo-Juda kod jo-Jerusalem duto noywage.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nochwogo wend ywak ni Josia kendo jower duto machwo gi mamon pod wero wendno ka giparogo Josia nyaka chil kawuono. Gino oselokore tim jo-Israel kendo wendno ondik e kitap Ywagruok.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mag ndalo mamoko mag loch Josia kod tichne maber manotimo koluwore gi gima ondiki e Chik mar Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "gigo manotimo duto aa chakruokgi nyaka gikogi ondik e kitap ruodhi mag Israel kod Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2CH.36",
