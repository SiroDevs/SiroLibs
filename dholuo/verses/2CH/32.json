              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche mamoko duto mag ndalo loch Hezekia kod timbene mabeyo ondiki e fweny mar janabi Isaya wuod Amoz e kitap ruodhi mag Juda kod Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
