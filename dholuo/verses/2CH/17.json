{
  "id": "2CH.17",
  "number": "17",
  "bookId": "2CH",
  "reference": "2 Weche Mag Ndalo 17",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2CH 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafat ruodh Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat wuode nobedo ruoth kare kendo nogurore motegno mondo osir Israel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noketo jolweny e mier mochiel duto mag Juda kendo nogero kuonde jolweny Juda kaachiel gi miech Efraim mane Asa wuon mare okawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ne ni kod Jehoshafat nikech e ndaloge mokwongo nowuotho e yore mane Daudi wuon mare owuothoe. Ne ok oluwo Baal",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "to nomanyo Nyasach wuon mare kendo noluwo chikene kopogore gi kaka jo-Israel ne timo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye noguro lochne motegno kendo jo-Juda duto nokelo mich ni Jehoshafat mi nobedo kod mwandu mangʼeny kod huma maduongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunye nomako weche Jehova Nyasaye, to bende nogolo e Juda kuonde motingʼore gi malo mag lemo e Juda kaachiel gi sirni milamo mag Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar adek mar lochne nooro jotelo mage kaka Ben-Hail, Obadia, Zekaria, Nethanel gi Mikaya mondo opuonj e mier mag Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaachiel kodgi ne nitie jo-Lawi moko kaka: Shemaya gi Nethania gi Zebadia gi Asahel gi Shemiramoth gi Jehonathan gi Adonija gi Tobija kaachiel gi Tob-Adonija kod jodolo Elishama gi Jehoram.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Negipuonjo e piny Juda duto ka gitingʼo Kitap Chik mar Jehova Nyasaye ka gilworore e miech Juda duto kendo ka gipuonjo ji.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luoro mar Jehova Nyasaye nomako pinyruodhi mag pinje molworo Juda, omiyo ne ok gitugo lweny kod Jehoshafat.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Filistia nokelone Jehoshafat mich mopogore opogore to gi fedha; to jo-Arabu nokelone jamni madirom imbe alufu abiriyo gi mia abiriyo kod diek alufu abiriyo gi mia abiriyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafat nomedo bedo gi teko kendo nogero mier mochiel gohinga motegno kod mier mag keno e Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo nokano gik moko mangʼeny e miech Juda. Noketo e Jerusalem jolweny man kod lony mangʼeny e lweny.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e kaka nondikgi kaluwore gi anywolagi:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CH 17:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2CH 17:14"
      },
      "items": [
        {
          "text": "Koa kuom jo-Juda jotend migepe mag jolweny alufu achiel (1,000) ne en",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 17:14"
      },
      "items": [
        {
          "text": "Adna mane otelo ne jolweny maroteke alufu mia adek (300,000);",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "maluwe ne en Jehohanan mane jatend jolweny alufu mia ariyo gi piero aboro (280,000);",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "maluwe ne en Amasia wuod Zikri mane ochiwore kende owuon ne tij Jehova Nyasaye kendo notelo ne ji alufu mia ariyo (200,000).",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koa e dhood Benjamin ne gin",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "2CH 17:17"
      },
      "items": [
        {
          "text": "Eliada, jalweny mathuon ka en gi ji alufu mia ariyo (200,000) motingʼo atungʼ kod okumbni;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "maluwe ne en Jehozabad mane ni kod ji alufu mia achiel gi piero aboro (180,000) moikore ne lweny.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e joge mane tiyo ne ruoth ka ok okwan jolweny mane oketo e mier madongo mochiel motegno gohinga e piny Juda duto.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
      ]
    }
  ],
