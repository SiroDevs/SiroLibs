      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "e kinde ka kinde madwaro changoe Israel,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "to richo mag Efraim elore",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "kendo timbe mahundu mag Samaria fwenyore.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "Gihero wacho miriambo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "jokwoge turo udi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:1"
      },
      "items": [
        {
          "text": "jonjore mayo ji e yore;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.1",
            "verseOrgIds": [
              "HOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ok gisefwenyo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "ni aparo timbegi duto maricho.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "Richogi oduodogi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:2"
      },
      "items": [
        {
          "text": "kendo ni e wangʼa ndalo duto.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.2",
            "verseOrgIds": [
              "HOS.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gimoro ruoth gi timbegi marichogo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:3"
      },
      "items": [
        {
          "text": "yawuot ruoth bende gimiyo mor gi miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.3",
            "verseOrgIds": [
              "HOS.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giduto gin joma terore,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "giore ka kendo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "ma jated makati oweyo chwaloe mach",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:4"
      },
      "items": [
        {
          "text": "nyaka otiek dwelo mi makati kuodi moromo tedo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.4",
            "verseOrgIds": [
              "HOS.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ mar nyasi ruodhwa",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "yawuot ruoth madho divai mamer,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:5"
      },
      "items": [
        {
          "text": "mi riw lwetgi gi jo-ajara.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.5",
            "verseOrgIds": [
              "HOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chunygi chalo gi kendo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "gidhi ire ka gisechano timo timbe mochido.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "Gombogi liet ka maa otieno,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:6"
      },
      "items": [
        {
          "text": "kochopo okinyi to omuoch ka mach maliel.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.6",
            "verseOrgIds": [
              "HOS.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giduto giliet ka kendo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "gikidho jotendgi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "Ruodhigi bende gitieko,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:7"
      },
      "items": [
        {
          "text": "to onge ngʼato kuomgi maluonga.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efraim riwore gi ogendini,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:8"
      },
      "items": [
        {
          "text": "kendo ochalo gi makati ma ok okuot.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.8",
            "verseOrgIds": [
              "HOS.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogendini tieko tekone,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "to ok ofweny.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "Lwar okuorore e yie wiye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:9"
      },
      "items": [
        {
          "text": "to ok ongʼeyo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.9",
            "verseOrgIds": [
              "HOS.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tok teko mar jo-Israel bedonegi janeno ka ngʼadonegi bura,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "to kata magi duto timorene,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "to ok oduogi ir Jehova Nyasaye ma Nyasache,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:10"
      },
      "items": [
        {
          "text": "kata mana manye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.10",
            "verseOrgIds": [
              "HOS.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Efraim chalo kaka akuch odugla",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "mawuondo yot kendo mofuwo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "giluongo Misri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 7:11"
      },
      "items": [
        {
          "text": "to gilokore gidhi Asuria.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.11",
            "verseOrgIds": [
              "HOS.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka gidhi, to abiro bolo goka kuomgi;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
