  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1KI 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka wach Jehova Nyasaye nobiro ni Jehu wuod Hanani kuom Baasha mowachone niya, \"Nayieri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne atingʼi malo ka agoli e buru mi aketi jatend joga Israel to niwuotho e yore mag Jeroboam mi nimiyo joga Israel otimo richo kendo ne uchwanya mi imiyo abet gi mirima nikech richo magu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo koro achiegni tieko Baasha kod ode kendo abiro keto odi kaka mano mar Jeroboam wuod Nebat.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guogi biro chamo joka Baasha motho e mier madongo, kendo winy mae kor polo biro chamo mago motho e pewe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe duto mag loch Baasha gi gik mane otimo, donge ondikgi e kitepe ruodhi mag Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha noyweyo gi kwerene mi noyike Tirza. Kendo Ela wuode nokawo lochne kaka ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, wach Jehova Nyasaye nobiro gi dho janabi Jehu wuod Hanani ni Baasha kod ode, nikech richo duto mane osetimo e nyim Jehova Nyasaye, komiye mirima gi gik moko mane osetimo, kendo kobedo machal gi od Jeroboam, kendo bende nikech mano nokethe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ela ruodh Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar piero ariyo gauchiel mar loch Asa Ruodh Juda, Ela wuod Baasha nodoko ruodh Israel kendo nobedo ruodh Tirza kuom higni ariyo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiel kuom jotende miluongo ni Zimri mane otelo ni nus gechene nochano mar nege. Ela ne nitie Tirza e kindeno, komer e dala Arza, ngʼat motelo ni od ruoth man Tirza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimri nodonjo e ot mogoye kendo onege e higa mar piero ariyo gabiriyo mar loch Asa ruodh Juda, kendo nokawo lochne kaka ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mapiyo ka osechako locho kendo mobetie e kom loch, nonego anywola Baasha duto. Ne ok ongʼwono kata ni nyathi ma wuowi, bed ni ne en wat kata osiep.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Zimri noketho od Baasha, kaluwore gi wach Jehova Nyasaye mane owacho ni Baasha kawuok kuom Jehu janabi",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech richo duto mane Baasha kod wuode Ela nosetimo kendo mane gimiyo Israel otimo, omiyo ne giwangʼo ii Jehova Nyasaye, Nyasach Israel, ka gimiye mirima gi nyiseche manono.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamoko mag loch Ela kaachiel gi gik moko duto mane otimo, donge ondikgi e kitap rapar mag ruodhi mag Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zimri ruodh Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar piero ariyo gabiriyo mar Asa ruodh Juda, Zimri nobedo ruodh Tirza kuom ndalo abiriyo. Jolweny nogoyo kambi but Gibethon e dala mar jo-Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jo-Israel mane ni e kambi nowinjo ni Zimri osemonjo ruoth mi onege, negiketo ni Omri ma jatend jolweny, mondo obedo ruoth mar Israel mana gi chiengʼno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Omri gi jo-Israel duto mane ni kode nowuok Gibethon mi gimonjo Tirza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane Zimri oneno ni dalano osekaw, nodhi kama tek mar dala ruoth, nomoko dalano mach molwore. Mine otho,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikech richo mane otimo, kotimo richo e nyim Jehova Nyasaye kendo kowuotho e yore Jeroboam kendo e richo mane otimo, kod mago mane omiyo jo-Israel otimo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamoko mag loch Zimri gi ngʼanyo mane obedogo, donge ondikgi e kitepe mag rapar mag ruodhi Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omri ruodh Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka jo-Israel nopogore e migepe ariyo; migawo achiel ne chwako Tibni wuod Ginath kaka ruoth, to migawo machielo ne chwako Omri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "To joma ne luwo Omri ne onyisore ni gin giteko moloyo mago mag Tibni wuod Ginath. Kamano Tibni notho to Omri nodoko ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar piero adek gachiel mar loch Asa ruodh Juda, Omri nobedo ruodh Israel, nobedo ruoth kuom higni apar gariyo, ka auchiel kuomgi en Tirza.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.23",
            "verseOrgIds": [
              "1KI.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nongʼiewo gode mag Samaria gi Shemer gi fedha ma dirom kilo piero abiriyo kendo mogero dala maduongʼ e got, miluongo ni Samaria, kochake Shemer nying wuon godno.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "To Omri notimo timbe mamono e nyim Jehova Nyasaye kendo notimo richo mathoth moloyo joma notelo ne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowuotho e yore duto mag Jeroboam wuod Nebat kod richone mane omiyo jo-Israel otimo, mine gimiyo Jehova Nyasaye, ma Nyasach Israel mirima gi nyisechegi manono.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamoko mag loch Omri gi gik mabeyo mane otimo, donge ondikgi e kitap rapar mar ruodhi mag Israel?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omri noyweyo gi kwerene mi noyike Samaria, kendo Ahab wuode nokawo lochne kaka ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahab obedo ruodh Israel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar piero adek gaboro mar loch Asa ruodh Juda, Ahab wuod Omri nobedo ruodh Israel, kendo nobedo ruodh Israel kuom higni piero ariyo gariyo kodak Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahab wuod Omri notimo timbe mamono mangʼeny e nyim Jehova Nyasaye moloyo joma notelo ne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ok nine oluwo richo mag Jeroboam wuod Nebat kende, to bende nine okendo Jezebel nyar Ethbal ruodh Sidon mi nochako tiyo ni Baal kendo lame.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oloso kendo mar misango ne Baal e hekalu mar Baal mane osegero e Samaria",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahab bende noloso siro mar Ashera kendo notimo mangʼeny mamoko mondo ochwanygo Jehova Nyasaye, ma Nyasach Israel, kendo owangʼ iye moloyo ruodhi duto mag Israel mane nitiere motelone.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde Ahab, Hiel ja-Bethel nochako gero Jeriko kendo. Noketo misene mi wuode makayo miluongo ni Abiram notho kendo kane oguro dhorangeye to wuode ma chogo miluongo ni Segub bende notho, mana kaka wach Jehova Nyasaye mane owacho gi dho Joshua wuod Nun.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
