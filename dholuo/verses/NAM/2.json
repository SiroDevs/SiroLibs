  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NAM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nineve biro podho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mabiro monji ochomi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "yaye Nineve, omiyo rit dala mochiel motegno,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "rit yoreni,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "bed gi ikruok maber,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "kuom tekoni duto!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye biro dwoko duongʼ mar Jakobo,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "mana ka duongʼ mar Israel,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "kata obedo ni joma omonje osekethe",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "kendo oseketho puothegi mag mzabibu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okumba mag jolweny osebedo makwar ka remo;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "kendo lewni ma girwakorego bende kwar.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "Chuma manie ewi gechegi mil",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "ka giikore ne chiengʼ lweny;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "tongegi opiag mabith kendo milni ka gikedogo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geche powore e yore mag dala,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "ka giringo koni gi koni e tunge mag dala.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "Gichalo gi rameny maliel mager,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "ka gipiachore ka mil polo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluongo jolweny mage moyiero,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "to gichwanyore ka gidhi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "Giringo ka gidhi e ohinga mar dala;",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "ka gigengʼore gi okumba.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohinga mane gigengʼogo pi madonjo e dala ruoth omukore,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:6"
      },
      "items": [
        {
          "text": "bende od ruoth ogore piny.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osegol Chik ni dala maduongʼ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "nyaka maki ma ter e piny ma wendo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "Wasumbinigi ma nyiri ywagore ka akuche",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "kendo ka gidwongʼo korgi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nineve chalo dago,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "kendo pige mol kadhi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "Giywak kagiwacho niya, \"Chungʼ! Chungʼ!\"",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "to onge ngʼama lokore duogo.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakuru fedha!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Yakuru dhahabu!",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Mwandugi ngʼeny mokadho,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "gin mwandu mogol kuonde kenogi duto.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odongʼ nono, omaye gik moko duto,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "bende olonye modongʼ duk.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "Kibaji ogoyo chunygi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "bende chongegi onyosere,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "kendo dendgi tetni",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "ka ngʼato ka ngʼato wangʼe ojowore.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
