  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JER 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye, mad wiya bed ka soko mar pi",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "kendo pi wangʼa mol ka aora!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "Dwaywak odiechiengʼ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:1"
      },
      "items": [
        {
          "text": "kod otieno nikech nek mar joga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.1",
            "verseOrgIds": [
              "JER.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaye, mad ne abed gi",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "kar nindo michulo ne jowuoth e piny ongoro,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "mondo omi awe joga",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "kendo adhi mabor kodgi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "nimar giduto gin jochode,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:2"
      },
      "items": [
        {
          "text": "kanyakla mar joma onge adiera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.2",
            "verseOrgIds": [
              "JER.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Giketo lewgi moikore ka atungʼ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "mondo gidirgo miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "to dhigi maber e piny",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "ok nikech giwacho adiera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Gitimo richo bangʼ moro ka moro;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "ok gidewa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:3"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ema owacho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.3",
            "verseOrgIds": [
              "JER.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Beduru motangʼ gosiepeu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "kik uket genou kuom oweteu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "Nimar oweteu duto jo-miriambo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:4"
      },
      "items": [
        {
          "text": "kendo osiep moro amora jakwoth.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.4",
            "verseOrgIds": [
              "JER.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osiep wuondo osiep,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "kendo onge ngʼama wacho adiera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "Gisepuonjo lewgi wacho miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "kendo gisedonjo matut e richo",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:5"
      },
      "items": [
        {
          "text": "ma ok ginyal wuokie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.5",
            "verseOrgIds": [
              "JER.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idak e kind jo-miriambo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "e wuondruokgino gisedagi yie kuoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:6"
      },
      "items": [
        {
          "text": "Jehova Nyasaye ema owacho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.6",
            "verseOrgIds": [
              "JER.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emomiyo ma e gima Jehova Nyasaye Maratego wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "\"Ne, abiro pwodhogi kendo temogi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "nimar en angʼo machielo manyalo timo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:7"
      },
      "items": [
        {
          "text": "nikech richo mar joga?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.7",
            "verseOrgIds": [
              "JER.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lewgi en asere man-gi kwiri;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "owacho miriambo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "Gi dhoge owuoyo mamuol ne jabathe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:8"
      },
      "items": [
        {
          "text": "to e chunye oketone obadho.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.8",
            "verseOrgIds": [
              "JER.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "\"Donge dakumgi ne ma?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "Donge dachul kuor",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:9"
      },
      "items": [
        {
          "text": "ne oganda ma kama?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.9",
            "verseOrgIds": [
              "JER.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiro ywak kendo dengo ne gode",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "bende anaywag lege motwo, mosedongʼ nono,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "kendo onge gima wuothoe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "bende ywak mar jamni ok winjie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "Winy mafuyo e kor polo oseringo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:10"
      },
      "items": [
        {
          "text": "kendo le osedhi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anami Jerusalem obed gunda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "kama ondiegi ema odakie;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "kendo anaketh mier mag Juda",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:11"
      },
      "items": [
        {
          "text": "mondo ngʼato kik dag kanyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼa mariek manyalo winjo tiend ma? En ngʼa mosetiegi gi Jehova Nyasaye kendo nyalo lero tiende? Angʼo momiyo piny osekethi modongʼ nono ka kama otwo maonge ngʼama nyalo luwo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye nowacho niya, \"Nikech gisejwangʼo chikna, mane amiyogi; omiyo ok giseluora kata luwo chikna.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.13",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "To giseluwo mana timbegi mag wich teko; bende giseluwo bangʼ Baal, mana kaka wuonegi nopuonjogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emomiyo, ma e gima Jehova Nyasaye Maratego ma Nyasach Israel, wacho: \"Ne, anami jogi cham chiemo makech kendo modh pi sum.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.15",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakegi e dier ogendini ma gin kata wuonegi ok ongʼeyo, kendo analawgi gi ligangla manyaka atiekgi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.16",
            "verseOrgIds": [
              "JER.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye Maratego wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "\"Parane! Luonguru mon madengo mondo obi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:17"
      },
      "items": [
        {
          "text": "to moloyo mago man-gi lony mamalo e ywak.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.17",
            "verseOrgIds": [
              "JER.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Giret piyo",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "mondo gidengnwa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "nyaka wengewa pongʼ gi pi wangʼ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:18"
      },
      "items": [
        {
          "text": "ma oo kendo pi wangʼwa mol ma luokwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.18",
            "verseOrgIds": [
              "JER.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko mar dengo iwinjo koa Sayun:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "'Mano kaka otiekowa!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Mano kaka wichkuot marwa duongʼ!",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:19"
      },
      "items": [
        {
          "text": "Nyaka waa e pinywa nikech utewa osemuki.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.19",
            "verseOrgIds": [
              "JER.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koro, yaye mon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "winjuru wach Jehova Nyasaye;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "yawuru itu ne weche mawuok e dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "Puonjuru nyiu dengo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:20"
      },
      "items": [
        {
          "text": "puonjreuru ywak uwegi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.20",
            "verseOrgIds": [
              "JER.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tho oseidho gie dirisni magwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "kendo osedonjo kuondewa mochiel motegno gohinga;",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "osengʼado nyithindo oko e yore",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:21"
      },
      "items": [
        {
          "text": "kendo rowere e kuonde budho mag galamoro.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.21",
            "verseOrgIds": [
              "JER.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach niya, \"Ma e gima Jehova Nyasaye owacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "\" 'Ringre joma otho nopie ka owuoyo e pap alanga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "kaka cham mokaa gi jakeyo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:22"
      },
      "items": [
        {
          "text": "maonge ngʼama nyalo chokogi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.22",
            "verseOrgIds": [
              "JER.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e gima Jehova Nyasaye wacho:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "\"Kik ngʼama riek sungre gi riekone",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kata ngʼama tek sungre gi tekone,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:23"
      },
      "items": [
        {
          "text": "kata ngʼama omewo sungre gi mwandu mage,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "to ngʼat ma sungore mondo osungre kama:",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 9:24"
      },
      "items": [
        {
          "text": "ni ongʼeya, kendo owinja,",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.24",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        }
      ]
