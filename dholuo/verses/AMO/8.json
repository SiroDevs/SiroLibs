{
  "id": "AMO.8",
  "number": "8",
  "bookId": "AMO",
  "reference": "Amos 8",
  "copyright": "Biblica® Ochiw Thuolo Motingʼo Loko Manyien™ Weg Loko © 1980, 2002, 2003, 2020 otim gi Biblica, Inc. Biblica® Open New Luo Translation™ Copyright © 1980, 2002, 2003, 2020 by Biblica, Inc. \"Biblica\" en sai mondik mongorore e piny Amerika kendo en kido moyie malongʼo e ofis Biblica, Inc. Itiyo kode gi thuolo moa kuom Biblica, Inc. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "AMO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fweny mar angʼwen en atonga motingʼo olemo mochiek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fweny mane Jehova Nyasaye Manyalo Gik Moko Duto okelona ema: Ne aneno atonga mopongʼ gi olemo mochiek.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Jehova Nyasaye nopenja niya, \"Amos, ineno angʼo?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Ne adwoke niya, \"Aneno atonga mopongʼ gi olemo mochiek.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Eka Jehova Nyasaye nowachona niya, \"Mano e kaka joga Israel oseikore ni kum kendo ok anawegi ma ok akumogi.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto wacho niya, \"Chiengʼno wende ma iwero e hekalu nolokre mag ywak, ka ringre joma otho opie kuonde duto, kendo piny to olingʼ thi!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Winjuru un joma sando jochan,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:4"
      },
      "items": [
        {
          "text": "kendo mosiko mana kamayo joma odhier puothegi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "\"Mad ndalo mag lemo mar dwe manyien rum piyo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "mondo wayud thuolo mar uso cham.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "Bende upenjoru niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "\"Ndalo mag Sabato to biro rumo karangʼo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "mondo wagol chambwa warundi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "eka wanyalo choro nengo malo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kendo tiyo gi rapim ma ok nikare,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "ma wawuondogo jongʼiewo!",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kindeno wabiro uso cham maricho e nengo maber,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "bangʼe wabiro ngʼiewo joma odhier e nengo marom,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "gi nengo mingʼiewogo pat pat mondo gibed wasumbini magwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ma Nyasach joka Jakobo osekwongʼore ni wiye ok nowil gi timbegi maricho.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Donge gima kamano biro miyo piny yiengni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "mi ji duto modak e iye ywagi?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "Piny duto biro pongʼ ma oo oko",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "mana ka aora Nael manie piny Misri.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "\"Chiengʼno anami chiengʼ podhi e chuny odiechiengʼ tir,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "kendo anami piny lokre mudho godiechiengʼ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sewni mau mag lemo nolokre ywak mar tho,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "wendeu mag mor, to nolokre dengo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Uduto anami urwakru gi pien gugru",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "ka ulielo wiyeu mapoth.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Unuchal kod joma ywago wuodgi ma miderma,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "kendo odiechiengʼno nobed malit mapok ne kone e piny.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye Manyalo Gik Moko Duto wacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "\"Ndalo biro ma abiro kelo kech e piny,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "to ok nobed kech mar chiemo, kata riyo mar pi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:11"
      },
      "items": [
        {
          "text": "to nobed riyo mar winjo wach Jehova Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.11",
            "verseOrgIds": [
              "AMO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji nowuoth kadawo kochakore nyandwat e dho nam achiel nyaka dho nam machielo",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:12"
      },
      "items": [
        {
          "text": "kendo ginidigni chakre yo nyandwat nyaka yo wuok chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:12"
      },
      "items": [
        {
          "text": "ka gimanyo kama digiyudie wach Jehova Nyasaye,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.12",
            "verseOrgIds": [
              "AMO.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
