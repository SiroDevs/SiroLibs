          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harun nokendo Elisheba nyar Aminadab ma bende nyamin Nashon, kendo nonywolone Nadab, Abihu, Eliazar kod Ithamar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        }
      ]
    },
