          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Kora ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:24"
      },
      "items": [
        {
          "text": "Asir, Elkana kod Abiasaf.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:24"
      },
      "items": [
        {
          "text": "Magi ema ne dhout joka Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
