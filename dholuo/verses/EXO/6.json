      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "EXO 6:25"
      },
      "items": [
        {
          "text": "Magi ema ne jotend dhout joka Lawi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
