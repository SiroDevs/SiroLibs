            "sid": "NEH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "koa e anywola Harim ne en Adna;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        }
      ]
