  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2KI 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo e odiechiengʼ mar apar mar dwe mar apar e higa mar ochiko mar loch Zedekia, Nebukadneza ruodh Babulon nodhi gi jolweny mage duto momonjo Jerusalem. Nolworo dala maduongʼno mi ogoyone agengʼa koni gi koni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.1",
            "verseOrgIds": [
              "2KI.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dala maduongʼno ne ogone agengʼa nyaka higa mar apar gachiel mar ruoth Zedekia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.2",
            "verseOrgIds": [
              "2KI.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ mar ochiko e dwe mar angʼwen kech mane ni e dala maduongʼno nomedore makoro ne onge chiemo mane ji nyalo chamo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.3",
            "verseOrgIds": [
              "2KI.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ mano ohinga mar dala maduongʼno nomuki kendo jolweny duto noringo ka tony gotieno ka gikalo e rangach man e kind ohinga ariyo man but puoth ruoth, kata obedo ni jo-Babulon nolworo dala maduongʼno kamano. Negiringo ka gichomo Araba,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.4",
            "verseOrgIds": [
              "2KI.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "to jolwenj Babulon nolawo ruoth mojuke e pewe Jeriko. Jolwenje duto noringo oweye moke,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.5",
            "verseOrgIds": [
              "2KI.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo gimako ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 25:6"
      },
      "items": [
        {
          "text": "Ne gitere Ribla ir ruodh Babulon, kendo kanyo ema nongʼadne buch twech.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.6",
            "verseOrgIds": [
              "2KI.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neginego yawuot Zedekia e wangʼe koneno. Bangʼe negigolo wengene oko magitweye gi nyoroche mag nyinyo mi gitere Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.7",
            "verseOrgIds": [
              "2KI.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E odiechiengʼ mar abiriyo mar dwe mar abich e higa mar apar gochiko mar loch Nebukadneza ruodh Babulon, Nebuzaradan jatend jolweny marito ruoth, ma en achiel kuom jodong ruodh Babulon nobiro Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.8",
            "verseOrgIds": [
              "2KI.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowangʼo hekalu mar Jehova Nyasaye, kar dak ruoth kod udi duto man Jerusalem. Bende nowangʼo udi duto moger mabeyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.9",
            "verseOrgIds": [
              "2KI.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jolweny duto mag Babulon mane ichiko gi jatend jolweny marito ruoth ne omuko ohinga moluoro Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.10",
            "verseOrgIds": [
              "2KI.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradan jatend jolweny notero e twech joma nodongʼ e dala maduongʼno, kaachiel gi oganda mamoko kod joma noringo modhi ir ruodh Babulon mondo otony.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.11",
            "verseOrgIds": [
              "2KI.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "To jatend lweny noweyo jopinyno moko mane odhier ahinya mondo oti e puothe mag mzabibu kod puothe mamoko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.12",
            "verseOrgIds": [
              "2KI.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jo-Babulon nomuko sirni mag mula, rachungi mag taya kod Karaya Maduongʼ mar mula mane ni e hekalu mar Jehova Nyasaye kendo ne gitero mulago nyaka Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.13",
            "verseOrgIds": [
              "2KI.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende negikawo agulni, opawo, gir ngʼado otambi mar taya, bakunde kod gik moko duto molos gi mula mane itiyogo e hekalu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.14",
            "verseOrgIds": [
              "2KI.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatend jolweny marito ruoth nokawo gik moko duto molos gi dhahabu kata fedha ma gin gima iwangʼoe ubani kod bakunde mitimogo misengini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.15",
            "verseOrgIds": [
              "2KI.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mula mane ogolo e sirni ariyo, gi Karaya Maduongʼ kod rachungi mag taya, mane Solomon olosone hekalu mar Jehova Nyasaye, ne pek ma ok nyal pim.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.16",
            "verseOrgIds": [
              "2KI.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siro ka siro borne ne romo fut piero ariyo gabiriyo. Mula mane ni e ewi siro ka siro ne romo fut angʼwen gi nus, kendo nokede gi gik mongʼinore ongʼinore molwore koni gi koni. Siro machielo man-gi gik mongʼinore ongʼinore, ne chal kod mokwongo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.17",
            "verseOrgIds": [
              "2KI.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatend jolweny marito ruoth nomako Seraya jadolo maduongʼ, gi Zefania jadolo maluwe kod ji adek ma jorit dhoot hekalu moterogi e twech.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.18",
            "verseOrgIds": [
              "2KI.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "To kuom joma ne odongʼ e dala maduongʼno, nomako jatelo mane ochungʼ ne jolweny kod ji abich ma jongʼad rieko ne ruoth. Bende nomako jagoro mane tichne en ndiko nying joma onego bed jolweny kod jodonge piero auchiel mane oyudi e dala maduongʼno.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.19",
            "verseOrgIds": [
              "2KI.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuzaradan jatend lweny nomakogi duto mokelogi Ribla ir ruodh Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.20",
            "verseOrgIds": [
              "2KI.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth nogolo chik mondo neg-gi Ribla kanyo, e piny jo-Hamath.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 25:21"
      },
      "items": [
        {
          "text": "Omiyo Juda noter e twech mabor gi pinye owuon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.21",
            "verseOrgIds": [
              "2KI.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadneza ruodh Babulon noyiero Gedalia wuod Ahikam, ma wuod Shafan mondo otel ne ji mane odongʼ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.22",
            "verseOrgIds": [
              "2KI.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane jatend jolweny duto kod jogi nowinjo ni ruodh Babulon oseyiero Gedalia kaka jatelo maduongʼ, negibiro ir Gedalia e dala miluongo ni Mizpa. Jogo ne gin Ishmael wuod Nethania, Johanan wuod Karea, Seraya wuod Tanhumeth ja-Netofath, Jazania ja-Maakath kod jogegi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.23",
            "verseOrgIds": [
              "2KI.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedalia nokwongʼore kosingorenegi niya, \"Kik uluor jotend Babulon, to daguru e pinyni kendo mondo uti ne ruodh Babulon eka unudhi maber.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.24",
            "verseOrgIds": [
              "2KI.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata kamano, e dwe mar abiriyo Ishmael wuod Nethania, ma wuod Elishama mane koth joka ruoth, nobiro gi ji apar ma ginego Gedalia kod jo-Juda gi jo-Babulon mane ni kode Mizpa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.25",
            "verseOrgIds": [
              "2KI.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech gima notimoreni, ji duto chakre jochan nyaka joma omewo, to gi jotend jolweny duto, noringo modhi Misri nikech negiluoro jo-Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.26",
            "verseOrgIds": [
              "2KI.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogony Jehoyakin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "E higa mar piero adek gabiriyo mar twech Jehoyakin ruodh Juda, e higa mane Evil-Merodak obedo ruodh Babulon, nogonyo Jehoyakin e twech e odiechiengʼ mar piero ariyo gabiriyo, e dwe mar apar gariyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.27",
            "verseOrgIds": [
              "2KI.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowuoyo kode modembore kendo nomiye kom duongʼ moloyo ruodhi mamoko mane ni kode e twech Babulon.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.28",
            "verseOrgIds": [
              "2KI.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehoyakin nolonyo lepe mag twech kendo e ndalo ngimane duto ne ochiemo pile pile e mesa ruoth.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.25.29",
            "verseOrgIds": [
              "2KI.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
