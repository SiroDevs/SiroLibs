  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "GEN 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jakobo odwogo Bethel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Nyasaye nowacho ne Jakobo niya, \"Aa malo idhi Bethel kendo idag kuno mi iger kendo mar misango ne Nyasaye, mane ofwenyoreni kane iringo ia kuom Esau owadu.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Jakobo nowacho ne joode duto kod ji mane ni kode niya, \"Wituru nyiseche mag pinje mamoko ma un-go kendo upwodhru mi urwak lewni maler.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ubi mondo wadhiuru Bethel, kuma abiro dhi geroe kendo mar misango ne Nyasaye, mane odwoka e kinde mane an e chandruok malich kendo ma osebedo koda kamoro amora ma asedhiyoe.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.3",
            "verseOrgIds": [
              "GEN.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano negimiyo Jakobo nyiseche mag pinje mamoko mane gin-go kod stadi mane ni e itgi kendo Jakobo noyikogi e tiend yiend ober man Shekem.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negichako wuoth kendo luoro mar Jehova Nyasaye nomako mier duto mane okiewo kodgi maonge ngʼama nolawo bangʼ-gi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo kod ji duto mane ni kode nochopo Luz (ma tiende ni Bethel) e piny Kanaan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanyo Jakobo nogero kendo mar misango kendo noluongo kanyo ni El Bethel, nikech kanyo ema ne Nyasaye ofwenyorene kane oringo owadgi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debora, ma japit Rebeka notho kendo noyike e tiend yiend ober machiegni gi Bethel. Kuom mano nochak kanyo ni Allon Bakuth.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ ka Jakobo nosea Padan Aram, Nyasaye nochako ofwenyorene kendo nogwedhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nowachone niya, \"Kata obedo ni nyingi en Jakobo to ok nochak oluongi kamano to koro ibiro luongi ni Israel.\" Omiyo nochake ni Israel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Nyasaye nowachone niya, \"An Nyasaye Maratego, nywolri kendo imedri. Ogendini kod dhout ogendini noa kuomi kendo ruodhi nowuog kuomi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piny mane amiyo Ibrahim kod Isaka bende abiro miyi kaachiel gi nyikwayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka Nyasaye nodhi e polo moweye kama ne giwuoyoe kodeno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nochungo siro mar kidi kanyono mane Nyasaye owuoyoe kode, kendo noolo ewi sirono misango miolo piny bende noolo misango mar mo ewi siro.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo nochako kanyo mane Nyasaye owuoyoe kodeno ni Bethel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tho mar Rael gi Isaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka negiwuok gia Bethel. Kane gisedhi mochwalore gi Efrath, muoch nochako kayo Rael kendo nochandore ahinya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kinde mane muoch kayeno, jacholo nowachone niya, \"Kik iluor nikech inywolo wuowi machielo.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane chunye chiegni chot nochako wuodeno ni Ben-Oni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
        {
          "text": "To wuon mare to nochake ni Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuom mano Rael notho kendo nokunye e yo madhi Efrath (ma tiende ni Bethlehem).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakobo noketo siro ewi liend Rael kendo nyaka chil kawuono sirono obet kar liend Rael.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israel nochako odhi nyime giwuoth kendo noguro hembe tok oinga mar Migdal Eder.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane oyudo Israel dak kuno, Reuben nodhi moterore gi Bilha jatich ma nyako mar wuon-gi mi Israel nowinjo wachno.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 35:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 35:22"
      },
      "items": [
        {
          "text": "Jakobo ne nigi yawuowi apar gariyo:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Lea ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Reuben wuod Jakobo makayo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:23"
      },
      "items": [
        {
          "text": "Simeon, Lawi, Juda, Isakar kod Zebulun.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Rael ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:24"
      },
      "items": [
        {
          "text": "Josef kod Benjamin.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Bilha, jatich Rael madhako ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:25"
      },
      "items": [
        {
          "text": "Dan kod Naftali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuot Zilpa jatich Lea madhako ne gin:",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "GEN 35:26"
      },
      "items": [
        {
          "text": "Gad kod Asher.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 35:26"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "GEN 35:26"
      },
      "items": [
        {
          "text": "Magi ema ne yawuot Jakobo mane onywolone Padan Aram.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
