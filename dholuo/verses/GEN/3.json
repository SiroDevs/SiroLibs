          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam nochako chiege ni Hawa nikech nobiro bedo min ji duto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye noloso lewni mag pien ne Adam kod chiege kendo noumogi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kendo Jehova Nyasaye nowacho niya, \"Dhano koro osebedo machal kodwa, kongʼeyo ber kod rach. Kik yiene mondo oter lwete kendo okaw olemb ngima kendo ocham madimi odag nyaka chiengʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omiyo Jehova Nyasaye noriembe e Puodho mar Eden mondo opur lowo kamane ogole.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bangʼ kane oseriembo Adam oko, ne oketo kerubi gi ligangla mamil koni gi koni yo wuok chiengʼ mar Puodho Mar Eden mondo orit yo mochomo yadh ngima.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
      ]
