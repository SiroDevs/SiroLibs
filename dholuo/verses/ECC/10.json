      "attrs": {
        "style": "q2",
        "vid": "ECC 10:17"
      },
      "items": [
        {
          "text": "mondo giyud teko to ok mondo gimer.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        }
