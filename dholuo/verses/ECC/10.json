      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:17"
      },
      "items": [
        {
          "text": "kendo ruodhigigo chiemo e sa mowinjore,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
        }
