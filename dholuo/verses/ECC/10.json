      "attrs": {
        "style": "q2",
        "vid": "ECC 10:19"
      },
      "items": [
        {
          "text": "kendo divai bende miyo ngʼato winjo maber,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
            ]
