              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma ruodhigo wuok e anywola mar jotelo gin johawi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
              "ECC.10.17"
            ]
          }
