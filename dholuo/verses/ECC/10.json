      "attrs": {
        "style": "q2",
        "vid": "ECC 10:18"
      },
      "items": [
        {
          "text": "to ngʼato ma budho abudha ma ok ti gi lwete, to ode nyaka chwer.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
