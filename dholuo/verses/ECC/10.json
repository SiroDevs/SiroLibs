  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ECC 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka lwangʼni motho miyo gima dungʼ mangʼwe ngʼar bedo gi tik marach,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:1"
      },
      "items": [
        {
          "text": "e kaka miriambo matin ketho rieko kod luor.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.1",
            "verseOrgIds": [
              "ECC.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mariek timo timbe mabeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:2"
      },
      "items": [
        {
          "text": "to ngʼat mofuwo timo timbe maricho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.2",
            "verseOrgIds": [
              "ECC.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fupe nenore anena",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:3"
      },
      "items": [
        {
          "text": "kata kowuotho e yo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:3"
      },
      "items": [
        {
          "text": "kendo ji duto manene ongʼeyo ni ofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.3",
            "verseOrgIds": [
              "ECC.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ruoth okecho kodi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:4"
      },
      "items": [
        {
          "text": "to kik iwe tiji mitiyono;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:4"
      },
      "items": [
        {
          "text": "nimar kibolori to ruoth nyalo ngʼwononi kuom kethogi mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.4",
            "verseOrgIds": [
              "ECC.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitie richo ma aseneno e bwo wangʼ chiengʼ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:5"
      },
      "items": [
        {
          "text": "ketho moro mawuok kuom jatelo:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.5",
            "verseOrgIds": [
              "ECC.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma ofuwo imiyo tije madongo dongo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:6"
      },
      "items": [
        {
          "text": "to jo-mwandu to iketo e mago matindo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.6",
            "verseOrgIds": [
              "ECC.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aseneno wasumbini e ngʼe farese,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:7"
      },
      "items": [
        {
          "text": "to jotelo wuotho gi tiendgi ka wasumbini.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.7",
            "verseOrgIds": [
              "ECC.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama kunyo bur matut nyalo lwar e iye;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:8"
      },
      "items": [
        {
          "text": "to ngʼama muko kor ot thuol nyalo kayo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.8",
            "verseOrgIds": [
              "ECC.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama kunyo kite inyalo hiny gi kitego;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:9"
      },
      "items": [
        {
          "text": "to ngʼama baro yien inyalo hiny gi yien.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.9",
            "verseOrgIds": [
              "ECC.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka le dik",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:10"
      },
      "items": [
        {
          "text": "kendo lewe ok opiagi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 10:10"
      },
      "items": [
        {
          "text": "to nyaka oti kode gi teko mathoth eka obar yien,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:10"
      },
      "items": [
        {
          "text": "kuom mano chan gik moko chon kapod ok itimo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.10",
            "verseOrgIds": [
              "ECC.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka thuol okecho kapok oboye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:11"
      },
      "items": [
        {
          "text": "to koro onge ohala mar ja-bocho.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.11",
            "verseOrgIds": [
              "ECC.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weche moa e dho ngʼat man-gi rieko nigi ngʼwono,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:12"
      },
      "items": [
        {
          "text": "to ngʼama ofuwo tiekore mana gi wechene owuon.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.12",
            "verseOrgIds": [
              "ECC.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama ofuwo chako gi weche mag fuwo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:13"
      },
      "items": [
        {
          "text": "to gikone ni gin weche neko,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.13",
            "verseOrgIds": [
              "ECC.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kendo wechege ngʼeny maonge tiende.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ECC 10:14"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 10:14"
      },
      "items": [
        {
          "text": "Onge ngʼama ongʼeyo gima biro timorene kiny,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:14"
      },
      "items": [
        {
          "text": "koro en ngʼa manyalo nyise gima biro timorene bangʼ thone?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.14",
            "verseOrgIds": [
              "ECC.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼama ofuwo nyagore gi tich matek ma ok konye;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:15"
      },
      "items": [
        {
          "text": "nimar kata kuma oaye ok onyal paro.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.15",
            "verseOrgIds": [
              "ECC.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwongʼ piny ma ruodhe ne en jatich",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 10:16"
      },
      "items": [
        {
          "text": "kendo ma jotende mondo e nyasi gokinyi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
