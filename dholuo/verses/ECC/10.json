              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ngʼato nyap, to kor ode nyaka mukre marieny;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.18",
            "verseOrgIds": [
              "ECC.10.18"
            ]
          }
        }
