          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiemo mabeyo miyo ngʼato bedo mamor,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.19",
            "verseOrgIds": [
              "ECC.10.19"
