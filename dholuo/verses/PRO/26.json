      "attrs": {
        "style": "q2",
        "vid": "PRO 26:21"
      },
      "items": [
        {
          "text": "to yien bende miyo mach liel,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.21",
            "verseOrgIds": [
              "PRO.26.21"
            ]
