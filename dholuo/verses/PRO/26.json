  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "PRO 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka pe e ndalo oro kata koth e kinde keyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:1"
      },
      "items": [
        {
          "text": "e kaka luor ok owinjore ni ngʼat mofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka oyundi mafuyo kata ka opija maringo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:2"
      },
      "items": [
        {
          "text": "e kaka kwongʼ maonge gimomiyo kadho akadha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.2",
            "verseOrgIds": [
              "PRO.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka faras owinjore gi chwat,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:3"
      },
      "items": [
        {
          "text": "to dho punda owinjore gi tweyo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:3"
      },
      "items": [
        {
          "text": "e kaka ngʼe joma ofuwo owinjore gi goch.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.3",
            "verseOrgIds": [
              "PRO.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik idwok ngʼat mofuwo machalre gi fupe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:4"
      },
      "items": [
        {
          "text": "to dipo ka ibiro bedo machal kode.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.4",
            "verseOrgIds": [
              "PRO.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dwok ngʼat mofuwo koluwore gi fupe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:5"
      },
      "items": [
        {
          "text": "dipo ka obiro nenore e wangʼe owuon ni oriek.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ingʼado tiend ngʼato kata kelo masira,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:6"
      },
      "items": [
        {
          "text": "chalo gioro ngʼama ofuwo mondo oter ote.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.6",
            "verseOrgIds": [
              "PRO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ka tiend ngʼat mongʼol mawengni,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:7"
      },
      "items": [
        {
          "text": "e kaka ngero moa e dho ngʼat mofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka keto kidi e orujre",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:8"
      },
      "items": [
        {
          "text": "e kaka miyo ngʼat mofuwo luor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
            "verseOrgIds": [
              "PRO.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka bungu mar kudho e lwet ngʼat momer,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:9"
      },
      "items": [
        {
          "text": "e kaka ngero moa e dho ngʼat mofuwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
            "verseOrgIds": [
              "PRO.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ngʼama thoro diro aserni adira",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:10"
      },
      "items": [
        {
          "text": "ema chalo gi ngʼat mandiko ngʼat mofuwo kata ngʼato angʼata moyudo e tich.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.10",
            "verseOrgIds": [
              "PRO.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka guok dok e ngʼokne mosengʼogo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:11"
      },
      "items": [
        {
          "text": "e kaka ngʼat mofuwo nwoyo fupe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.11",
            "verseOrgIds": [
              "PRO.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bende ineno ngʼato ma paro owuon ni oriek?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:12"
      },
      "items": [
        {
          "text": "Ngʼat mofuwo nitiere gi geno moloye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.12",
            "verseOrgIds": [
              "PRO.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo wacho niya, \"Sibuor ni e wangʼ yo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:13"
      },
      "items": [
        {
          "text": "sibuor mager bayo e yore mag dala!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka dhoot marundore e pata,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:14"
      },
      "items": [
        {
          "text": "e kaka jasamuoyo lokore aloka e kitandane.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo luto lwete malal ei tawo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:15"
      },
      "items": [
        {
          "text": "onyap ahinya ma ok onyal gole oko moduoge e dhoge.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jasamuoyo paro e chunye ni oriek",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:16"
      },
      "items": [
        {
          "text": "moloyo ji abiriyo ma dwoko wach gi rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ngʼat mamako guok gi ite,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:17"
      },
      "items": [
        {
          "text": "e kaka ngʼat makadho akadha madonjo e dhawo ma ok mare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ngʼat ma janeko madiro",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.18",
            "verseOrgIds": [
              "PRO.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 26:18"
      },
      "items": [
        {
          "text": "pil mach kata aserni mager,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.18",
            "verseOrgIds": [
              "PRO.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
