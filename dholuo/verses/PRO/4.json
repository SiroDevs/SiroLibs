  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PRO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ohala miyudo kuom bedo gi rieko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawuota, winjuru puonj mag wuonu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:1"
      },
      "items": [
        {
          "text": "chikuru itu eka ubed gi ngʼeyo moloyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puonj mara mamiyou beyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:2"
      },
      "items": [
        {
          "text": "omiyo kik ujwangʼ puonjna.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kane pod an wuowi e od wuora,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:3"
      },
      "items": [
        {
          "text": "kane pod an rawera kendo nyathi achiel kende mar minwa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nopuonja kowacho niya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "\"Mak matek wechena gi chunyi duto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "rit chikena eka inibed mangima.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yud rieko kod ngʼeyo matut,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:5"
      },
      "items": [
        {
          "text": "wiyi kik wil kod wechena kata weyogi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik ijwangʼ rieko to obiro bedoni ragengʼ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:6"
      },
      "items": [
        {
          "text": "here, to obiro ritoi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko nigi duongʼ moloyo, omiyo yud rieko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "Kata obedo ni mwanduni duto nyalo rumo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "to bed gi winjo tiend wach.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miye duongʼ, to enotingʼi malo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:8"
      },
      "items": [
        {
          "text": "rwake chutho, to obiro miyi duongʼ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enoket ogut ngʼwono e wiyi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:9"
      },
      "items": [
        {
          "text": "kendo nosidhni osimbo mar duongʼ.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuoda, winji kendo yie gima awacho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:10"
      },
      "items": [
        {
          "text": "eka higni mag ngimani nobed mangʼeny.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apuonji e yor rieko",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:11"
      },
      "items": [
        {
          "text": "kendo anyisi yo makare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iwuotho, to ok inikier",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:12"
      },
      "items": [
        {
          "text": "bende ka iringo, to ok inichwanyri.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mak motegno gima isepuonjori,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:13"
      },
      "items": [
        {
          "text": "kik iweye, olalni to irite maber, nikech en e ngimani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iwuothi e yor joma timbegi mono",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:14"
      },
      "items": [
        {
          "text": "kata kik iluw yor jomaricho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bed mabor gi yorno, kik iwuothie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:15"
      },
      "items": [
        {
          "text": "to wichri kendo iluw yori iwuon.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikech ok ginyal nindo nyaka gitim gima mono;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:16"
      },
      "items": [
        {
          "text": "ayula wangʼ bende ok nyal terogi kapok gimiyo ngʼato opodho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timbe mamono e chiembgi ma gichamo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:17"
      },
      "items": [
        {
          "text": "to timbe ja-mahundu e divai ma gimadho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yor joma kare chalo ka ugwe mar kogwen,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:18"
      },
      "items": [
        {
          "text": "omedo rieny maler nyaka chiengʼ wuogi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
