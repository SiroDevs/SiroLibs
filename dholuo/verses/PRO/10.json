  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "PRO 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Ngeche mag Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeche mag Solomon:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "Wuowi mariek kelo mor ni wuon mare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:1"
      },
      "items": [
        {
          "text": "to wuowi mofuwo miyo min mare chuny lit.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwandu moyudi e yo marach onge gi ohala;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:2"
      },
      "items": [
        {
          "text": "to tim makare reso ji e tho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehova Nyasaye ok we ngʼat makare obed gi kech,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:3"
      },
      "items": [
        {
          "text": "to oketho gombo mar joricho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.3",
            "verseOrgIds": [
              "PRO.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwedo manyap miyo ngʼato bedo jachan,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:4"
      },
      "items": [
        {
          "text": "to lwedo ma jakinda kelo mwandu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.4",
            "verseOrgIds": [
              "PRO.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat makayo cham e kinde oro en wuowi mariek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:5"
      },
      "items": [
        {
          "text": "to ngʼat ma nindo kinde keyo en wuowi makwodo wich.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.5",
            "verseOrgIds": [
              "PRO.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gweth sidho kondo mar loch ewi ngʼat makare,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:6"
      },
      "items": [
        {
          "text": "to timbe mahundu opongʼ e dho ngʼat marach.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paro miparogo ngʼat makare nobed gweth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:7"
      },
      "items": [
        {
          "text": "to nying ngʼat marach nolal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mariek e chunye rwako chike,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:8"
      },
      "items": [
        {
          "text": "to ngʼat mofuwo ma wachne ngʼeny dhi e kethruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mobidhore wuotho kaonge luoro,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:9"
      },
      "items": [
        {
          "text": "to ngʼatno maluwo yore mobam ibiro yudo mapiyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.9",
            "verseOrgIds": [
              "PRO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat madiemo wangʼe giwuond kelo kuyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:10"
      },
      "items": [
        {
          "text": "to ngʼat mofuwo ma wachne ngʼeny dhi e kethruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dho ngʼat makare en soko mar ngima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:11"
      },
      "items": [
        {
          "text": "to timbe mahundu opongʼo dho ngʼat marach.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
            "verseOrgIds": [
              "PRO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sigu kelo miero,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:12"
      },
      "items": [
        {
          "text": "to hera umo maricho duto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.12",
            "verseOrgIds": [
              "PRO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rieko iyudo e dho jogo mongʼeyo tiend wach,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:13"
      },
      "items": [
        {
          "text": "to luth en mar ngʼe ngʼatno maonge gi rieko mar ngʼado bura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
            "verseOrgIds": [
              "PRO.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joma riek okano ngʼeyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:14"
      },
      "items": [
        {
          "text": "to dho joma ofuwo kelo kethruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
              "PRO.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwandu mar jomoko e ohinga mochiel motegno ma gigengʼorego,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:15"
      },
      "items": [
        {
          "text": "to dhier e kethruok mar jochan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.15",
            "verseOrgIds": [
              "PRO.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pok joma kare kelonegi ngima,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 10:16"
      },
      "items": [
        {
          "text": "to mwandu ma joricho yudo kelonegi kum.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.16",
            "verseOrgIds": [
              "PRO.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
