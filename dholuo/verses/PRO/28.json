  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "PRO 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaricho ringo kaonge ngʼama lawe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.1",
            "verseOrgIds": [
              "PRO.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:1"
      },
      "items": [
        {
          "text": "to joma kare jochir ka sibuor.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.1",
            "verseOrgIds": [
              "PRO.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka piny toke tek, to en gi jotelo mangʼeny,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.2",
            "verseOrgIds": [
              "PRO.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:2"
      },
      "items": [
        {
          "text": "to ngʼat mawinjo wach kendo man-gi ngʼeyo rito chik.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.2",
            "verseOrgIds": [
              "PRO.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jatelo mahinyo jochan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.3",
            "verseOrgIds": [
              "PRO.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:3"
      },
      "items": [
        {
          "text": "chalo kaka kodh oula maywero cham oko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.3",
            "verseOrgIds": [
              "PRO.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jogo ma ok rit chik pako ngʼat marach,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.4",
            "verseOrgIds": [
              "PRO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:4"
      },
      "items": [
        {
          "text": "to jogo marito chik dagi jogo maricho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.4",
            "verseOrgIds": [
              "PRO.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jomaricho ok ongʼeyo adiera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:5"
      },
      "items": [
        {
          "text": "to jogo madwaro Jehova Nyasaye ongʼeyo adiera chutho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.5",
            "verseOrgIds": [
              "PRO.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ber ngʼat ma jachan ma wuodhe ok cha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:6"
      },
      "items": [
        {
          "text": "moloyo ngʼat ma ja-mwandu ma yorene richo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.6",
            "verseOrgIds": [
              "PRO.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat marito chik en wuowi mariek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:7"
      },
      "items": [
        {
          "text": "to bedo osiep jawuoro kelo wichkuot ne wuon mare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.7",
            "verseOrgIds": [
              "PRO.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mamedo mwandu gi ohala ma malangʼ choko mwandu ne ngʼat machielo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:8"
      },
      "items": [
        {
          "text": "mabiro bedo mangʼwon gi jochan.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.8",
            "verseOrgIds": [
              "PRO.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ngʼato odino ite ne chik,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.9",
            "verseOrgIds": [
              "PRO.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:9"
      },
      "items": [
        {
          "text": "kata mana lemone bende richo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.9",
            "verseOrgIds": [
              "PRO.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat matero ngʼat moriere tir e yo mar richo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:10"
      },
      "items": [
        {
          "text": "biro podho e obetone owuon,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:10"
      },
      "items": [
        {
          "text": "to ngʼat ma ok cha biro yudo pok maber.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.10",
            "verseOrgIds": [
              "PRO.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jamoko nyalo paro owuon ni oriek,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:11"
      },
      "items": [
        {
          "text": "to jachan man-gi paro matut neno gik manie chuny jamokono.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ngʼat makare oloyo, nitie mor maduongʼ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:12"
      },
      "items": [
        {
          "text": "to ka ngʼat marach omi teko mondo otel,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:12"
      },
      "items": [
        {
          "text": "ji ringo dhiyo kar pondo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼat mapando richone ok dhi maber,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:13"
      },
      "items": [
        {
          "text": "to ngʼat ma hulo richone kendo oweyogi yudo ngʼwono.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "En ngʼama ogwedhi ngʼat moluoro Jehova Nyasaye kinde duto,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:14"
      },
      "items": [
        {
          "text": "to ngʼatno ma chunye tek donjo e chandruok.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka sibuor maruto kata ondiek madwaro kecho",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:15"
      },
      "items": [
        {
          "text": "e kaka ngʼat marach motelone joma ok nyal.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruoth ma jasunga onge gi rieko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.16",
            "verseOrgIds": [
              "PRO.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 28:16"
      },
      "items": [
        {
          "text": "to ngʼatno mamon gi gik moyud e yo marach biro dak amingʼa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.16",
            "verseOrgIds": [
              "PRO.28.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
