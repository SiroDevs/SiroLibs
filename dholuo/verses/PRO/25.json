  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "PRO 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms1"
      },
      "items": [
        {
          "text": "Ngeche mamoko mag Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magi e ngeche mamoko mag Solomon, mane jo-Hezekia ruodh Juda ondiko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.1",
            "verseOrgIds": [
              "PRO.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamiyo Nyasaye duongʼ kuom gik ma opando;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:2"
      },
      "items": [
        {
          "text": "to lero tiend weche en duongʼ ni ruodhi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.2",
            "verseOrgIds": [
              "PRO.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka polo bor kendo piny tut,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:3"
      },
      "items": [
        {
          "text": "e kaka chuny ruodhi ngʼeyo tek.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.3",
            "verseOrgIds": [
              "PRO.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ogol chilo kuom fedha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:4"
      },
      "items": [
        {
          "text": "to jatheth koro nigi gimoro mar theth;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.4",
            "verseOrgIds": [
              "PRO.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ogol ngʼat marach e nyim ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:5"
      },
      "items": [
        {
          "text": "eka kom ruodhe ibiro guro motegno e tim makare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.5",
            "verseOrgIds": [
              "PRO.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik imiri duongʼ iwuon e nyim ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:6"
      },
      "items": [
        {
          "text": "kata bedo kar jomadongo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.6",
            "verseOrgIds": [
              "PRO.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimar ber moloyo owachni niya, \"Bi ka,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:7"
      },
      "items": [
        {
          "text": "moloyo ka igoli e nyim jomadongo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.7",
            "verseOrgIds": [
              "PRO.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gima wangʼi oseneno kik ikel mapiyo kirikni e nyim od bura;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:8"
      },
      "items": [
        {
          "text": "nimar ibiro timo angʼo achien ka jabuti oketi e wichkuot?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.8",
            "verseOrgIds": [
              "PRO.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iloso wach manie kindi gi jabuti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:9"
      },
      "items": [
        {
          "text": "to kik idhi ihul wach malingʼ-lingʼ mar ngʼato;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.9",
            "verseOrgIds": [
              "PRO.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nono to ngʼat moro mowinji biro keti e wichkuot;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:10"
      },
      "items": [
        {
          "text": "mi huma mari marach ok nogiki.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.10",
            "verseOrgIds": [
              "PRO.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wach mowach e kinde mowinjore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:11"
      },
      "items": [
        {
          "text": "chalo gi olemo mar dhahabu moketie tawo molos gi fedha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.11",
            "verseOrgIds": [
              "PRO.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka tere mar dhahabu kata tigo mar dhahabu maber",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:12"
      },
      "items": [
        {
          "text": "e kaka siem mar ngʼat mariek mokwerogo ngʼat machiko ite.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.12",
            "verseOrgIds": [
              "PRO.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka ngʼich mar pe e kinde mar keyo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "e kaka jaote ma ja-adiera chalo ne ngʼat moore,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:13"
      },
      "items": [
        {
          "text": "omoro chuny ruodhe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.13",
            "verseOrgIds": [
              "PRO.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaka boche polo gi yamo maonge koth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:14"
      },
      "items": [
        {
          "text": "e kaka ngʼat mawuorore gi mich ma ok dochiw.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.14",
            "verseOrgIds": [
              "PRO.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horuok mos nyalo loko chuny ruoth,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:15"
      },
      "items": [
        {
          "text": "to lep mamuol nyalo toyo chogo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.15",
            "verseOrgIds": [
              "PRO.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka iyudo mor kich, to cham mana moromo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:16"
      },
      "items": [
        {
          "text": "mathoth ahinya, nyalo miyo ingʼogi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.16",
            "verseOrgIds": [
              "PRO.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kik iter tiendi pile e od jabuti,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.17",
            "verseOrgIds": [
              "PRO.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:17"
      },
      "items": [
        {
          "text": "dhiyo kuno pile, biro miyo ochayi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.17",
            "verseOrgIds": [
              "PRO.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kaka arungu kata ligangla; kata asere mabith,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.18",
            "verseOrgIds": [
              "PRO.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:18"
