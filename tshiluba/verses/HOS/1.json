          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kudi Hoshea, muana wa Beli, mu matuku a Uziya, Yotama, Ahaza ne Hezikiya, bakelenge ba Yuda, ne mu matuku a Yalobama, muana wa Yoasha, mukelenge wa Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.1",
            "verseOrgIds": [
              "HOS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku tshibangidilu hakayikila Yehowa ne Hoshea, Yehowa wakamuambila ne, Ya biebe, ubake mukashi wa masandi, ulele nʼandi bana ba mu masandi; bualu bua ba mu buloba ebu badi balonda malu a masandi, bahambuke kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.2",
            "verseOrgIds": [
              "HOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku wakaya biandi, wakabaka Gomê, muana wa bakashi wa Dibelayama; ne yeye wakimita difu, wakamulelela muana wa balume.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.3",
            "verseOrgIds": [
              "HOS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakamuambila ne, Umuidike dina ne, Yizelele",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.4:",
              "type": "text"
            },
            {
              "text": "Kuandamuna mu Tshiluba ne,",
              "type": "text"
            },
            {
              "text": "Nzambi udi umiamina",
              "type": "text"
            },
            {
              "text": "; tangila 2 Bakelenge 10.11.",
              "type": "text"
            }
          ]
        },
        {
          "text": "; bualu bua hahita musangu muihi, nensombuele mashi a Yizelele akadibo bamatshisha hanshi kudi ba mu tshiota tshia Yehu, nengumushe bukelenge kudi Bena Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.4",
            "verseOrgIds": [
              "HOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi nentshibule buta bua Bena Isalele mu tshibanda tshia Yizelele. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakimita difu kabidi, wakalela muana wa bakashi. Yehowa wakambila Hoshea ne, Umuidike dina ne, Udibo-kabayi-bafuila-luse",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.6:",
              "type": "text"
            },
            {
              "text": "Mu Buena Ebelu:",
              "type": "text"
            },
            {
              "text": "Lo-ruhamah",
              "type": "text"
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "; bualu bua tshiena nfuila Bena Isalele luse bua kubabuikidila mibi yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi nenfuile Bena Yuda luse; nembahandishe ku bukole bua Yehowa Nzambi wabo, tshiena mbahandisha ku buta, anyi ku muele wa nvita, anyi ku nvita anyi ku tubalu anyi kudi bena tubalu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakajila Udibo-kabayi-bafuila-luse mabele, Gomê wakimita difu dikuabo, wakalela muana wa balume. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakamba ne, Umuidike dina ne, Kambantu-banyi",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.9:",
              "type": "text"
            },
            {
              "text": "Mu Buena Ebelu:",
              "type": "text"
            },
            {
              "text": "Lo-ami",
              "type": "text"
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "!; bualu bua nuenu kanuena bantu banyi, ne tshiena ngikala Nzambi wenu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bungi bua Bena Isalele nebuikale bu nsenga ya ku mai manene, idibo kabayi mua kuidikisha anyi kubala; ne mu muaba wakadibo bamba ne, Kanuena bantu banyi, nebabambile ne, Nudi bana balume ba Nzambi wa muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.10",
            "verseOrgIds": [
              "HOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebasangishe Bena Yuda ne Bena Isalele hohamue, ne bobo bine nebadisunguile muntu umue bua kuikaleye ha mutu habo; nebumuke mu buloba ebu, bua dituku dia Yizelele nedikale dinene.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.11",
            "verseOrgIds": [
              "HOS.1.11"
            ]
          }
        }
      ]
    }
  ],
