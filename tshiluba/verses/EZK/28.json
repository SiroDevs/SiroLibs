              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kundi kabidi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa muntu, ambila mukokeshi wa mu Tulo ne, Mukelenge Yehowa udi wamba ne, Wakunanga tshiadi tshiebe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
