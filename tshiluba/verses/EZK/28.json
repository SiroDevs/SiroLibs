        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.19",
            "verseOrgIds": [
              "EZK.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Di dia Yehowa diakalua kundi kabidi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.20",
            "verseOrgIds": [
              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa muntu, tangisha mpala webe ku Sidona, umudiule, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "amba biebe ne, Mukelenge Yehowa udi wamba ne,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba mu tshisamba tshia Bena Isalele kabena basangana dieba didi mua kubataha, anyi mungonge udi mua kubakengesha, munkatshi mua bena mutumba nʼabo badi babanyunguluka ku nseke yonso, ne bakadi babenzela bibi. Nebamanye ne, Ndi Mukelenge Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge Yehowa udi wamba ne, Hanasangisha ba mu tshisamba tshia Bena Isalele bua kubumusha munkatshi mua bantu muakatangadikabo, hanamuenesha tshijila tshianyi mu bienzedi bindi mbenzela ku mesu kua bisamba bia bantu, hashishe, nebashikame mu buloba buabo buine bunakaha muntu wanyi Yakoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebashikamemu kabayi ne bualu kubatatshisha, nebibakemu nsubu, nebakune tumuma tua nvinyo mu madimi, nebashikamemu kabayi ne bualu bubatatshisha, hanalumbuluisha bena mutumba nʼabo badi babanyunguluka ne badi babakengesha; nebamanye ne, Meme ndi Yehowa Nzambi wabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
    }
