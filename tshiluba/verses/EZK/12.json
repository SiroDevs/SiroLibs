          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî dia Yehowa diakalua kundi kabidi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa muntu, mona, ba mu tshisamba tshia Bena Isalele badi bamba ne, Tshikena kumona tshidiye umona ntshia matuku a bungi atshidi ku mpala, ne yeye udi wamba malu a bikondo bitshidi kule. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
