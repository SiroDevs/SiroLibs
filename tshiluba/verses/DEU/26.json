  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "26",
        "style": "c",
        "sid": "DEU 26"
      },
      "items": [
        {
          "text": "26",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuabuela mu buloba budi Yehowa, Nzambi wenu, unuha bua nuenu kubuhiana, hanuabunyenga ne hanuashikamamu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hashishe nenuangate bintu bionso bidi biboba diambedi mu buloba budi Yehowa, Nzambi wenu, unuha, nubiteke mu tshisaka, nulue nʼabi mu muaba udi Yehowa, Nzambi wenu, usungula, bua kujadikamu dina diandi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nulue kudi muakuidi wa mu matuku au, numuambile ne, Ndi nkuambila lelu ku mesu kua Yehowa, Nzambi webe, ne, Nakubuela mu buloba buakaiaya Yehowa batatu betu, bua kutuhabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neangate tshisaka mu bianza bienu, neatshiteke hanshi ku mpala kua tshioshelu tshia Yehowa, Nzambi wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuambe ku mesu kua Yehowa, Nzambi wenu, ne, Tatu wetu wakadi Muena Sulia, wakadi wamba kufua; ne yeye wakaya mu Ejipitu, wakashikamamu bantu banya-banya; yeye wakalua tshisamba tshinene tshia bukole ne bantu ba bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Ejipitu bakatuenzela bibi, bakatukengesha, bakatuenzesha mudimu mukole; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.6",
            "verseOrgIds": [
              "DEU.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne tuetu tuakadi la kudi Yehowa, Nzambi wa bankambua betu, ne Yehowa wakulua dî dietu, wakatangila makenga etu ne mudimu wetu ne majitu etu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakatuhatula mu Ejipitu ne tshianza tshikole ne diboko diandi diolola ne malu makole ne bimanyinu ne malu a dikema; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakalua nʼetu mu muaba eu, wakatuha buloba ebu, buloba budi bûle tente ne mabele ne buitshi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka, Yehowa, tuakulua ne bintu biakaboba diambedi mu buloba buwakutuha. Nenuteke bintu ebi hanshi ku mpala kua Yehowa, Nzambi wenu, nenutendelele ku mpala kua Yehowa, Nzambi wenu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenusanke mu malu mimpe onso akanuha Yehowa, Nzambi wenu, ne nuenu ne ba mu nsubu yenu, ne Muena Lewi ne benyi badi munkatshi muenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
            "verseOrgIds": [
              "DEU.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuashikisha kufila tshia dikumi tshia bintu bienu bionso mu tshidimu tshisatu tshidibo bafila tshia dikumi tshia bintu, nenubale Bena Lewi ne benyi ne bana ba nshiya ne bakashi ba mu lufuila; nunku bobo nebadie mu misoko yenu, nebukute. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuambe ku mesu kua Yehowa, Nzambi wenu, ne, Tuakumusha bintu bia tshijila mu nsubu yetu, tuakabiha Bena Lewi ne benyi ne bana ba nshiya ne bakashi ba mu lufuila, bu mukenji uwakutuelela, katuakashiha mikenji yebe, katuakuhua mikenji muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katuakudia bintu ebi mu madilu etu, katuakabilenga hatuakadi banyanguke, katuakabifila kudi bakadi mu madilu: tuakutumikila dî dia Yehowa, Nzambi wetu; tuakuenza malu onso akatuambileye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utangile hanshi mu muaba webe wa tshijila mu diulu, uvudishile bantu bebe ba Isalele disanka, ne buloba buwakutuha, bu muwakalaya bankambua betu, buloba budi bûle tente ne mabele ne buitshi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa, Nzambi wenu, udi unuelela mukenji lelu bua nuenu nuenze mikenji ei ne mei au; nunku nubienze ne mitshima yenu yonso ne mioyo yenu yonso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nuakuitabusha Yehowa bu Nzambi wenu lelu, nuakuamba ne, Tuetu netuende mu nshila yandi, netutumikile mei andi ne mikenji yandi ne mikandu yandi, netunvue dî diandi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Yehowa wakanuitabusha bu bantu ba buhianyi buandi bu muakanulayeye, bua nuenu nutumikile mikenji yandi yonso, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kunubandisha ku mutu kua bisamba bionso biakafukeye mu butumbi ne mu dina ne mu buneme; bua nuenu nuikale bantu ba tshijila kudi Yehowa, Nzambi wenu, bu muakuambeye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
      ]
    }
  ],
