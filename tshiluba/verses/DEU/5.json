          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukumi mutshima webe ku mukashi wa mukuenu, anyi ku nsubu wa mukuenu, anyi ku budimi buandi, anyi ku muhika wandi mulume anyi ku muhika wandi mukashi, anyi ku ngombe wandi anyi ku mpunda wandi anyi ku tshintu tshionso tshia mukuenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
