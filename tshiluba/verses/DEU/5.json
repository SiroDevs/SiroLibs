          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unemeke tatuʼebe ne mamuʼebe bu muakanuambila Yehowa, Nzambi webe, bua matuku ebe ikale a bungi, ne bua wewe ukume dikasa dimpe mu buloba budi Yehowa, Nzambi webe, ukuha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
