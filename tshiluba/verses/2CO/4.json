  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "2CO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua bualu ebu tuetu tudi ne mudimu eu, bu mutuakaheta luse, katuena tuhanga; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.1",
            "verseOrgIds": [
              "2CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi tuakahidia malu masokome a bundu, katuena tuendakana ne budimu, katuena tudinga bantu ne dî dia Nzambi, kadi tudi tudianyisha ku dimuenesha dia bushua ku muoyo-mukese wa muntu yonso ku mesu kua Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala lumu luimpe luetu ne tshilulu tshikudika, ludi nʼatshi anu kudi batshidi bajimina; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakafofomishabo mesu a meshi a badi kabai bitabusha kudi nzambi wa tshikondo etshi, bua dinkenka dia lumu luimpe lua butumbi bua Kilisto, udi tshifuanyikishi tshia Nzambi, kaditemi kudibo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.4",
            "verseOrgIds": [
              "2CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua katuena tudiamba, kadi tudi tuamba Kilisto Yesu bu Mukelenge; ne tuetu bu bahika benu bualu bua Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.5",
            "verseOrgIds": [
              "2CO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Nzambi nguakamba ne, Munya neuteme mu mîdima; yeye wakatema mu mitshima yetu bua kutuha dinkenka dia lungenyi lua butumbi bua Nzambi ha mpala ha Yesu Kilisto.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.6",
            "verseOrgIds": [
              "2CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tudi ne bualu ebu bua mushinga mukole mu bintu biakafumbabo ne buloba, bua bulengele butambe bua bukole buikale bua Nzambi, kabufumi kutudi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.7",
            "verseOrgIds": [
              "2CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakatutshintshimika ku nseke yonso, kadi katuena mu muaba mubumbakane; tudi tulubakana, kadi katuena banze kuteketa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.8",
            "verseOrgIds": [
              "2CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuakuihatshibua, kadi katuena tulekedibua ha nkayetu; tuakukumibua hanshi, kadi katuena tushihibua; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.9",
            "verseOrgIds": [
              "2CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "misangu yonso tudi tutuala dishihibua dia Yesu mu mibidi yetu, bua muoyo wa Yesu umueneshibue kabidi mu mibidi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.10",
            "verseOrgIds": [
              "2CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua tuetu badi ne muoyo tudi tufidibua ku lufu misangu yonso bualu bua Yesu, bua muoyo wa Yesu kabidi umueneshibue mu mibidi yetu ifuafua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.11",
            "verseOrgIds": [
              "2CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku lufu ludi luenzesha munda muetu, kadi muoyo udi wenzesha munda muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.12",
            "verseOrgIds": [
              "2CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bualu bua tudi ne nyuma muomumue wa ditabusha bu mudi dî difundibue ne, Nakitabusha, nunku nakakula; tuetu tudi tuitabusha kabidi, nunku tudi tuakula kabidi: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.13",
            "verseOrgIds": [
              "2CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tudi bamanye ne, Wakabisha Mukelenge Yesu ku lufu neatubishe kabidi ne Yesu, neatumueneshe nʼenu ka mesu kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.14",
            "verseOrgIds": [
              "2CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua malu onso adi bua bualu buenu, bua ngasa, udi uvulangana kudi badi batamba bungi, akumbashe disakidila ku butumbi bua Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku katuena tuhanga; kadi bikala mibidi yetu ifuafua ifuafua, mioyo yetu idi ivuishibua mihia-mihia ku dituku ku dituku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.16",
            "verseOrgIds": [
              "2CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua dikenga dietu dikese dia tshituha tshihi didi ditamba kutuenzeshela bujitu bua butumbi bua tshiendelele musangu ne musangu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.17",
            "verseOrgIds": [
              "2CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "hatudi katui tutangila bintu bidi bimueneka ku mesu, kadi tudi tutangila bintu bidi kabi bimueneka ku mesu; bualu bua bintu bidi bimueneka ku mesu bidi bia tshituha tshihi, kadi bintu bidi kabi bimueneka ku mesu bidi bia tshiendelele.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.18",
            "verseOrgIds": [
              "2CO.4.18"
            ]
          }
        }
      ]
    }
  ],
