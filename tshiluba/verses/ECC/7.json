            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.13",
            "verseOrgIds": [
              "ECC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku dia diakalengele usanke biebe; ne mu dituku dia dikenga, welangane meji; bulelela, Nzambi wakavuisha dituku dimue diakanangane ne dikuabo, bua muntu kajinguludi malu atshilualua.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.14",
            "verseOrgIds": [
              "ECC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatangila malu onso mu matuku a ditshimbakana dianyi; muntu muakane udiku, udi ufua mu buakane buandi; muntu mubi udi uvudisha matuku andi mu bubi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.15",
            "verseOrgIds": [
              "ECC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuhitshi kudibingisha; kudivuishi bu muena lungenyi lutambe; udi musue kudibutula bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.16",
            "verseOrgIds": [
              "ECC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuvudishi malu mabi; kuikadi muhote; udi musue kufua dituku dia lufu luebe kadiyi dianze kufika bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.17",
            "verseOrgIds": [
              "ECC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbimpe kulamata ku bualu ebu bikole; kumushiku tshianza tshiebe nansha; bualu bua watshina Nzambi neahanduke mu malu onso.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.18",
            "verseOrgIds": [
              "ECC.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lungenyi ludi luvuisha bukole kudi muena meji, buhite bua bileba dikumi mu musoko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.19",
            "verseOrgIds": [
              "ECC.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bulelela, kakuena muntu muakane ha buloba utu wenza malu makane, kayi wenza malu mabi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.20",
            "verseOrgIds": [
              "ECC.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuteleji matshu ebe ku mei onso adibo bamba, bua wewe kunvu bihendu bia muhika webe; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.21",
            "verseOrgIds": [
              "ECC.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua mutshima webe udi mumanye ne, Wewe biebe wakahenda bakuabo misangu ya bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.22",
            "verseOrgIds": [
              "ECC.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakateka malu au onso mu meji; nakamba ne, Nempete meji, kadi nakuahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.23",
            "verseOrgIds": [
              "ECC.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malu adiku, adi kule, adi ne ndondo mule; udi mumanye mua kuajingulula nganyi? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.24",
            "verseOrgIds": [
              "ECC.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakateka mutshima wanyi ku kumanya ne kujingulula lungenyi ne kusokolola kua malu onso bua meme kumanya buhote bua malu mabi, ne ditshimbakana dia malu a hatuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.25",
            "verseOrgIds": [
              "ECC.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakasangana ne, Mukashi udi ne mutshima mufuanangane ne mateyi ne bukuondo ne bianza bidi bu mionshi, yeye udi mutambe lufu bululu; wasankisha Nzambi neahanduke mu bianza biandi; kadi yeye neakuate muntu mubi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.26",
            "verseOrgIds": [
              "ECC.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ECC 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muambi udi Wamba ne, Monai munakasangana hanakateta kusangisha bualu bumue ku bukuabo bua kuheta bualu bujalame; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.27",
            "verseOrgIds": [
              "ECC.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ECC 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi tshiakasangana bualu buakadi mutshima wanyi ukeba tô ne mpindiu; nakasangana muntu mulume umue mujalame munkatshi mua tshinunu tshia bantu, kadi tshiakasangana muntu mukashi munkatshi muabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.28",
            "verseOrgIds": [
              "ECC.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ECC 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakasangana anu bualu ebu bumue ne, Nzambi wakafuka bantu ne mitshima mijalame, kadi bobo bakadikebela malu a ngenyi yabo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.29",
            "verseOrgIds": [
              "ECC.7.29"
            ]
          }
        }
      ]
    }
  ],
