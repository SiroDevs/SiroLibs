        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.31",
            "verseOrgIds": [
              "GEN.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebi mbiota bia bana balume ba Noa ku milongo yabo, bisamba bia bantu biakamuangalaka ha buloba ku nyima kua nvula munene biakafuma kudibo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.32",
            "verseOrgIds": [
              "GEN.10.32"
            ]
          }
        }
      ]
