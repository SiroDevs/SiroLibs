            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge umue wa mu Afeke, mukelenge umue wa mu Lashalona, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.18",
            "verseOrgIds": [
