          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge umue wa mu Kedeshe, mukelenge umue wa mu Yokenama mu Kâmele, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.22",
            "verseOrgIds": [
              "JOS.12.22"
            ]
          }
        },
        {
