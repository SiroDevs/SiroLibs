          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge umue wa mu Dô ku mukuna wa Dô, mukelenge umue wa mu Goyima mu Gilegala, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.23",
            "verseOrgIds": [
              "JOS.12.23"
            ]
          }
        },
