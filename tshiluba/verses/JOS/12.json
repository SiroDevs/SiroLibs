          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge umue wa mu Tanaka, mukelenge umue wa mu Megido, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.21",
            "verseOrgIds": [
              "JOS.12.21"
            ]
          }
        },
