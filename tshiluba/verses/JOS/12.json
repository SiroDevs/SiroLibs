      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au mmena a bakelenge ba buloba bakashihabo kudi Bena Isalele, ne bakanyengabo buloba buabo dishiya dia Yadene kudi kuhatukila diba, ku tshibanda tshia Ânona tô ne ku mukuna wa Hêmona, ne buloba buonso bua Alabâ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12.1:",
              "type": "text"
            },
            {
              "text": "Tangila Yoshua 3.16.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bua ku esete: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.1",
            "verseOrgIds": [
              "JOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihona, mukelenge wa Bena Amole, wakadi mushikame mu Heshebona, ne wakadi mukokeshe ku Aloe udi ku muelele wa tshibanda tshia Ânona, ne musoko udi munkatshi mua tshibanda, ne tshituha tshia Gilada tô ne ku musulu wa Yaboka, mukalu wa Bena Amona; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.2",
            "verseOrgIds": [
              "JOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku Alabâ tô ne ku mai a Kinelota a ku esete tô ne ku mai a Alabâ, Dishiba dia Luehu mene, a ku esete mu nshila wa ku Bete-yishimota; ne ku luseke lua ku Sude, kuinshi kua mukuna wa Pisega; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.3",
            "verseOrgIds": [
              "JOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "tô ne ku mukalu wa Oga, mukelenge wa Bashana, ne wa bakadi bashala ba Bena Lefa bakadi bashikama mu Ashetalota ne mu Edelei, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.4",
            "verseOrgIds": [
              "JOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakadi mubakokeshe mu mukuna wa Hêmona ne mu Saleka, ne mu Bashana mujima tô ne ku mukalu wa Bena Geshû ne Bena Mâka ne tshituha tshia Gilada udi ku mukalu wa Sihona, mukelenge wa Heshebona. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.5",
            "verseOrgIds": [
              "JOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose, muntu wa Yehowa, ne Bena Isalele bakabashiha; ne Mose, muntu wa Yehowa, wakamuha Bena Lubena ne Bena Gada ne tshituha tshia tshisamba tshia Manashe bu buhianyi buabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.6",
            "verseOrgIds": [
              "JOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
