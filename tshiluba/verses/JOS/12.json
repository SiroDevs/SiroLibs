          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge umue wa mu Debî, mukelenge umue wa mu Gedê, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.13",
            "verseOrgIds": [
              "JOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
