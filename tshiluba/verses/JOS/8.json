        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Yoshua ne, Kutshinyi, kukuatshila buowa, angata bena nvita bonso; bika biebe, ya ku Ai; tangila, nakamana kufila mukelenge wa Ai ne bantu bandi ne musoko wandi ne buloba buandi mu tshianza tshiebe; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne wewe newenzele Ai ne mukelenge wa musoko bu muwakenzela Yeleko ne mukelenge wau; kadi bintu bia mu musoko ne bimuna, nubiangate bu bintu bienu; utume balaminyi ku nyima kua musoko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yoshua wakabika ne bena nvita bonso bua kuya ku Ai; Yoshua wakasungula bantu ba bukitu ne ba dikima binunu makumi asatu, wakabatuma butuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.3",
            "verseOrgIds": [
              "JOS.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabambila ne, Monai, nulale batentekela ku nyima kua musoko; kanuikadi kule ne musoko, kadi nudimuke bienu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.4",
            "verseOrgIds": [
              "JOS.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meme ne bantu bonso badi nʼanyi netusemene ha buihi ne musoko; ne hahatukabo kutudi bu diambedi, tuetu netunyeme ku mpala kuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.5",
            "verseOrgIds": [
              "JOS.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo nebatulonde tô ne hasemenabo kule ne musoko; bualu bua bobo nebambe ne, Badi batunyema, bu muakenzabo diambedi: nunku tuetu netubanyeme. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.6",
            "verseOrgIds": [
              "JOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nuenu balaminyi nenubike, nenunyenge musoko; bualu bua Yehowa, Nzambi wenu, neaufile mu bianza bienu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuanyenga musoko nenuwoshe ne kahia; nuenze bu mu dî dia Yehowa; monai, nakanuambila. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakabatuma, bakaya, bakalalaku bu balaminyi: bakashikama hankatshi ha Betele ne Ai, ku wesete kua Ai; kadi Yoshua wakalala munkatshi mua bantu butuku abu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua wakabika ne dinda dionso, wakasangisha bantu, ne yeye ne bakulu ba Bena Isalele bakaya ku mpala kua bantu ku Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.10",
            "verseOrgIds": [
              "JOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena nvita bonso bakadi nʼandi bakaya, bakasemena ha buihi, bakalua ku mpala kua musoko; bakasa tshitudilu ku luseke lua nôde lua Ai; tshibanda tshiakadi hankatshi habo ne Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.11",
            "verseOrgIds": [
              "JOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakangata bantu bu binunu bitanu, wakabatuma bu balaminyi hankatshi ha Betele ne Ai ku luseke lua wesete lua musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.12",
            "verseOrgIds": [
              "JOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku yeye wakangata bantu bu binunu bitanu, wakabateka bua kudiabo bu balaminyi ku luseke lua nôde lua musoko; Yoshua wakaya mu tshibanda butuku abu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila mukelenge wa Ai bualu ebu, wakabika lubilu ne dinda ne bantu bandi bonso, bakaluhuka mu musoko bua kuluangana ne Bena Isalele mu muaba wakasungulabo ku mpala kua mpata wa Alabâ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.14:",
              "type": "text"
            },
            {
              "text": "Tangila Yoshua 3.16.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kadi yeye kakamanya ne balaminyi bakadi ku nyima kua musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua ne Bena Isalele bonso hakadimanyisha bu bantu batekete ku mpala kuabo, bakanyema mu nshila wa ku tshihela. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.15",
            "verseOrgIds": [
              "JOS.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso bakadi mu musoko bakadisangisha bua kubalonda, ne bobo bakalonda Yoshua, bakashiya musoko wabo kule. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.16",
            "verseOrgIds": [
              "JOS.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuakadi mulume umue mushale mu Ai anyi Betele, buonso buabo bakalonda Bena Isalele: bakashiya musoko, bakalonda Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Yoshua ne, Tangisha difuma didi mu tshianza tshiebe ku Ai; bualu bua nengufile mu tshianza tshiebe. Yoshua wakatangisha difuma diakadi mu tshianza tshiandi ku Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaminyi bakabika lukasa ku muaba wabo, bakanyema lubilu hakabandisheye tshianza tshiandi, bakabuela mu musoko, bakaunyenga; bakosha musoko ne kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.19",
            "verseOrgIds": [
              "JOS.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Bena Ai ku nyima kuabo, monai, muishi wa musoko ubanda mulu; kabakadi ne bukole bua kunyema luseke elu anyi lukuabo; bakadi banyema ku tshihela bakakudimuna bakadi babalonda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.20",
            "verseOrgIds": [
              "JOS.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Yoshua ne Bena Isalele bonso ne balaminyi bakanyenga musoko, ne muishi wa musoko wakabanda mulu, bobo bakakudimuka, bakashiha Bena Ai. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.21",
            "verseOrgIds": [
              "JOS.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakuabo bakadi mu musoko bakaluhuka kudibo munkatshi mua Bena Isalele, bakuabo ku luseke elu, bakuabo ku luseke elu; bakabashiha tô, kakuakadi umue wabo wakahanduka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.22",
            "verseOrgIds": [
              "JOS.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakakuata mukelenge wa Ai ne muoyo, bakalua nʼandi kudi Yoshua.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakashikisha Bena Isalele kushiha Bena Ai bonso bakadi mu madimi ne mu tshihela kuakabalondabo, ne hakahonabo bonso ku miele ya nvita, tô ne hakajiminabo bonso, hashishe Bena Isalele bonso bakahingana ku Ai, bakaubutula ku miele ya nvita. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.24",
            "verseOrgIds": [
              "JOS.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Ai bonso ne balume ne bakashi bakafua dituku adi bakadi binunu dikumi ne bibidi, bantu bonso ba mu Ai mene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.25",
            "verseOrgIds": [
              "JOS.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yoshua kakahingasha tshianza tshiandi tshiakadiye muolole ne difuma tô ne hakabutuleye Bena Ai bonso kabutu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.26",
            "verseOrgIds": [
              "JOS.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu bimuna ne bintu bikuabo biakahuolabo bia mu musoko, Bena Isalele bakabiangata bu bintu biabo bu mu dî dia Yehowa diakambileye Yoshua. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yoshua wakosha Ai ne kahia, wakunguisha bionso biakadimu mushiki tshiendelele, wakahaudibua tô ne ku dituku edi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakowa mukelenge wa Ai ku mutshi tô ne ku dilolo; bakamba diba kubuela Yoshua wakamba ne, Batulule tshitalu tshiandi, bakatshiela ku mbelu kua tshibi tshia musoko, bakunguisha mushiki wa mabue ha mutu hatshi, udihu tô ne ku dituku edi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        }
      ]
    },
