            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatangila, ne nakunvua nyunyu wa mukanku umuehele uhahala munkatshi mua diulu, wamba ne dî dikole ne, Mulau, mulau, mulau, kudi badi bikala ha buloba, bualu bua mei makuabo a mpungi ya banjelo basatu badi balua kuela.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
      ]
