          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muanjelo muinai wakela mpungi, ne tshituha tshisatu tshia diba tshiakakuambila, ne tshituha tshisatu tshia ngondo, ne tshituha tshisatu tshia mitoto; bua tshituha tshiabi tshisatu tshikale midima, ne bua munya wa dituku kautemi bu tshituha tshiadi tshisatu, ne butuku muomumue.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
