  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2SA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakatuma Natana kudi Davidi. Yeye wakafika kudiye, wakamuambila ne, Bantu babidi bakadi mu musoko umue, umue wakadi mubanji, mukuabo wakadi muhele. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu mubanji wakadi ne bisumbu bia mikoko ne bia ngombe bia bungi; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.2",
            "verseOrgIds": [
              "2SA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi muntu muhele kakadi ne tshintu, anu kana ka mukoko kamue, kakasumbeye, kakadisheye; bakadiunda kudiye ne bana bandi; kakadia bidia biandi, kakanua mai a mu luhanza luandi mene, kakalala mu tshiadi tshiandi, kakadi bu muana mukashi mulela kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.3",
            "verseOrgIds": [
              "2SA.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe muena luendu wakalua kudi muntu mubanji; yeye kakitabusha bua kushihela muena luendu wakadi mulue umue wa mu mikoko yandi anyi umue wa mu ngombe yandi, kadi wakangata kana ka mukoko wa muntu muhele, wakamushihela muenyi wakadi mulue ku mbelu kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshiji tshikole tshiakakuata Davidi bua muntu au; yeye wakambila Natana ne, Bu mudi Yehowa ne muoyo, muntu wakenza bualu ebu udi ne bua kufua; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "budiye nʼabu mbua kumuhingishila mikoko mai bua bualu ebu buakenzeye, bualu bua yeye kakadi ne luse.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Natana wakambila Davidi ne, Wewe mene udi muntu eu. Yehowa, Nzambi wa Isalele, udi wamba ne, Nakakuela manyi bua wewe wikale mukelenge ku mutu kua Bena Isalele, nakanusungila mu bianza bia Shaula; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakakuha nsubu wa mukelenge webe, nakafila bakashi ba mukelenge webe mu tshiadi tshiebe; nakakuha Bena Isalele ne Bena Yuda kabidi; bikala bintu ebi bitambe bukese, nakadi kukuvudishilabi ha mutu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wakalengulula dî dia Yehowa bua kuenza bualu ebu bubi ku mesu kuandi bua tshinyi? Wewe wakashiha Uliya, Muena Hiti, ku muele wa nvita, wakangata mukashi wandi bu mukashi webe, wakamushiha ku muele wa nvita wa bana ba Amona. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku muele wa mata kawena umuka ku nsubu kuebe tshiendelele bualu bua wewe wakandengulula, wakangata mukashi wa Uliya, Muena Hiti, bu mukashi webe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi Wamba kabidi ne, Mona, nenkubishile bualu bubi mu nsubu webe mene; nenunyenge bakashi bebe ku mesu kuebe, nembafile kudi muena mutumba nʼebe, nealale ne bakashi bebe mu munya. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wakenza bualu ebu mu musokoko, kadi nengenzeshe bualu ebu ku mesu kua Bena Isalele bonso anu hatoke tô. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Davidi wakambila Natana ne, Nakenzela Yehowa bibi. Natana wakambila Davidi ne, Yehowa wakukubuikidila bubi buebe, wewe kuena ufila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bua bualu ebu bubi buwakenza wewe wakavuishila bena lukuna ba Yehowa tshikondo tshia kumuhendabo, nunku muana uwakalela neafue biandi bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natana wakumuka ne wakaya ku nsubu kuandi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakasamisha muana wakalelela mukashi wa Uliya Davidi disama dikole. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Davidi wakalombela muana eu Nzambi. Davidi wakajila bia kudia, wakabuela mu nsubu, wakalala hanshi ha buloba butuku bujima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakulu ba mu nsubu muandi bakabika, bakimana ha buihi nʼandi bua kumubishabo ba buloba, kadi yeye kakitabusha, wakahidia kudia nʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita matuku muanda mutekete muana wakafua. Bantu ba Davidi bakatshina kumuambila ne, Muana udi mufue; bualu bua bakamba ne, Monai, hakatshidi muana ne muoyo tuakayikila nʼandi ne yeye kakunyua dî dietu; monai, udi mua kutamba kunyingalala bituamuambila ne, Muana udi mufue! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi hakatangila Davidi bantu bandi banungane, Davidi wakamanya ne muana udi mufue; Davidi wakebesha bantu bandi ne, Muana wakulua, anyi? Bakamba ne, Wakufua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Davidi wakajuka ha buloba, wakowa mai, wakataha manyi hamʼbidi, wakaluata bilulu bikuabo; wakabuela mu nsubu wa Yehowa, wakamutendelela; nunku wakahingana ku nsubu kuandi; hakambeye dî, bakamuha bia kudia, yeye wakadia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bantu bandi bakamukonka ne, Bualu ebu bûdi wenza budi tshinyi? Hakadi muana ne muoyo, wewe wakadila, wakajila bia kudia; kadi hakafua muana, wewe wakajuka, wakadia bia kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Hakadi muana ne muoyo, nakajila bia kudia, nakadila, nakadikonka munda ne, Udi mumanye ne, Yehowa kena unfuila luse, bua muana ikale ne muoyo nganyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi muana wakamana kufua, bundi nʼabu mbua kujila bia kudia bua tshinyi? Ndi mumanye mua kumufululula kabidi, anyi? Nenye kudiye, kadi yeye kena mua kuhingana kundi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakasamba Beta-sheba mukashi wandi; wakabuela kudiye, wakalala nʼandi; yeye wakamulelela muana mulume, wakamuidika dina diandi ne, Solomo. Yehowa wakamunanga; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatuma Natana muprofete kudiye, wakamuidika dina ne, Munangibue kudi Yehowa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12.25:",
              "type": "text"
            },
            {
              "text": "Munangibue kudi Yehowa, kuandamuna kua muaku ne,",
              "type": "text"
            },
            {
              "text": "Yedidiya",
              "type": "text"
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " bualu bua Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba wakaluangana ne Laba, musoko wa Bena Amona, wakanyenga musoko eu wa bukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoaba wakatuma ba-messager kudi Davidi, bamba ne, Nakaluangana ne Laba, nakanyenga musoko udi ne mishimi ya mai ya bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku usangishe bantu badi bashala, utshintshimike musoko, ûnyenga; binanyenga musoko, nebawidike dina dianyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi wakasangisha bantu bonso, wakaya nʼabo ku Laba, wakaluangana ne musoko eu, wakaunyenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakangata tshifulu tshia butumbi tshia mukelenge tshiakadi ku mutu kuandi; bujitu buatshi buakadi bua ntalanta wa or,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12.30:",
              "type": "text"
            },
            {
              "text": "Ntalanta wa or wakadi ne bujitu bua 59 kg.",
              "type": "text"
            }
          ]
        },
        {
          "text": " tshiakadi tshilengeshibue ne mabue, a mushinga mukole; bakatshiasa ku mutu kua Davidi. Wakanyenga bintu bia bungi bia mu musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakangata bantu bakadimu, wakabenzesha mudimu wa kuhandabo mabaya ne scie ne bua kuenzabo biamu bia kuihila nʼabi ne bisui, ne bua kuenzabo tushola; wakenzela Bena Amona ba mu misoko yabo yonso nunku. Davidi ne bantu bandi bonso bakahingana ku Yelushalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
