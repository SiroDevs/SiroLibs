              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Shaula Davidi uya bua kuluangana ne Muena Peleshete, yeye wakakonka Abinê, kapitene ka masalayi andi, ne, Abinê, eu mmuana wa nganyi? Abinê wakamukudimuna dî ne, Bu mudi mutshima webe ne muoyo, mukelenge, tshiena mumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakamba ne, Ukonke bantu muena muana eu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadi Davidi ufuma kuakashiheye Muena Peleshete, Abinê wakamuangata, wakaya nʼandi kudi Shaula muambule mutu wa Muena Peleshete mu tshianza tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaula wakamukonka ne, Wewe nsongalume, udi muana wa nganyi? Davidi wakamukudimuna ne, Ndi muana wa muntu webe Yishai, Muena Beteleheme.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
