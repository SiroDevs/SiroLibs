      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo, muana wa Davidi, wakakoleshibua mu bukelenge buandi; Yehowa Nzambi wandi wakadi nʼandi, wakatamba kumuvuisha bunene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo wakasomba ne Bena Isalele bonso, ne tupitene tua bantu tshinunu ne tua bantu lukama, ne balumbuluishi bonso, ne bantu banene bonso ba mu Isalele, ne bakadi ku mutu kua nsubu ya batatuʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Solomo ne Bena Isalele bonso bakadi nʼandi bakaya ku mutu kua mukuna wa mu Gibeona; bualu bua ntenta wa kusambakena wa Nzambi wakasabo kudi Mose, muntu wa Yehowa, mu tshihela wakadiku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Davidi wakadi mumane kuangata mushete wa Nzambi wakadi ku Kîyata-yalima, wakaya nʼau ku muaba wakalongolola Davidi; bualu bua yeye wakaushimikila nsubu wa ntenta mu Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tshioshelu tshia tshiamu tshia mitaku tshiakenzabo kudi Besalele, muana wa Uli, muana wa Hû, tshiakadiku ku mpala kua nsubu wa tshitendelelu wa Yehowa; ne Solomo ne bantu bakadi nʼandi bakakebelamu Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo wakasemena ha buihi ne tshioshelu tshia tshiamu tshia mitaku tshia Yehowa tshiakadi ku mpala kua ntenta wa kusambakena, wakafilahu tshinunu tshia milambu ya kuosha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu butuku abu Nzambi wakamueneka kudi Solomo, wakamuambila ne, Ulombe tshinakuha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo wakambila Nzambi ne, Wewe wakalesha Davidi tatu wanyi luse lunene lujalame, wakumpuisha mu bukelenge mu muaba wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katataka, Yehowa Nzambi, witabushe bua mulayi webe kudi Davidi tatu wanyi ujadikibue; bualu bua wewe wakumpingisha mu bukelenge ku mutu kua bantu badi bungi bua dinfuenkenya dia buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umpe meji ne lungenyi bua meme kumanya mua kuluhuka ne kulua ku mpala kua bantu aba; bualu bua udi mumanye mua kukokesha bantu aba banene nganyi? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wakambila Solomo ne, Bua bualu ebu buakadi mu mutshima webe, wewe kuakundomba bubanji ne biuma, nansha butumbi, nansha mioyo ya badi nʼebe lukuna, nansha matuku a bungi ha buloba, kadi wakundomba meji ne lungenyi bia kukokesha nʼabi bantu banyi banakukuhingishila mukelenge ku mutu kuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakuha meji ne lungenyi; nenkuhe bubanji ne biuma ne butumbi biakadi bakelenge bonso ku mpala kuebe kabayi nʼabi; kakuena mukuabo udi nkulonda ku nyima neikale nʼabi kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Solomo wakafuma ku mukuna wa mu Gibeona ku mpala kua ntenta wa kusambakena, wakahingana ku Yelushalema; wakakokesha Bena Isalele.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomo wakasangisha makalu ne bena tubalu; wakadi ne makalu tshinunu ne nkama inai, ne bena tubalu binunu dikumi ne bibidi biakatekeye mu misoko yakadi ne makalu ne hamue ne mukelenge mu Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakakumbasha argent ne or mu Yelushalema bu mabue; ne mitshi ya cèdre yakadi bu mitshi ya sycomore ya mu bibanda, bualu bua bungi buabi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tubalu tuakadi nʼatu Solomo tuakafuma mu Ejipitu; bendi ba mushinga ba mukelenge bakatusumba mu bisumbu, tshisumbu ku mushinga watshi, tshisumbu ku mushinga watshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakasumba dikalu mu Ejipitu ku nshekele",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.17:",
              "type": "text"
            },
            {
              "text": "Nshekele wa argent wakadi ne bujitu bu bua 15 gr.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya argent nkama isambombo, ne kabalu ku nshekele lukama ne makumi atanu; bakabisumbila Bena Hiti ne Bena Sulia kabidi ku mushinga wabi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
  ],
