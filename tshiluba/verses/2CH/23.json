  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshidimu tshia muanda mutekete Yehoyada wakadikolesha, wakangata tupitene tua bantu lukama, Azaya, muana wa Yelohama, ne Yishemaele, muana wa Yehohanana, ne Azalaya, muana wa Obeda, ne Maseya, muana wa Adaya, ne Elishafata, muana wa Zikeli, wakahunga nʼabo tshihungidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bobo bakendakana ku nseke yonso ya Yuda, bakasangisha Bena Lewi ba mu misoko yonso ya Yuda ne bakadi ku mutu kua nsubu ya batatuʼabo mu Isalele, bakalua nʼabo ku Yelushalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu aba bonso bakahunga ne mukelenge tshihungidi mu nsubu wa Nzambi. Yeye wakabambila ne, Monai, muana wa mukelenge neakokeshe bu muakamba Yehowa bua bana ba Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuenu nenuenze bualu ebu: tshituha tshienu tshisatu tshia bakuidi ne Bena Lewi badi babuelamu dituku dia lumingu netshikale bu bambudi ba bintu ku bibuelelu bia nsubu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tshituha tshienu tshisatu tshikuabo netshikale ku nsubu kua mukelenge; ne tshituha tshienu tshisatu tshikuabo netshikale ku tshibi tshidi kumanda kua nsubu; bantu bonso bakuabo nebikale mu biendedi bia nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanubueshi muntu mukuabo mu nsubu wa Yehowa mene, anu bakuidi ne Bena Lewi badi ne mudimu wabo; bobo nebabuele bualu bua bobo badi bantu ba tshijila; kadi bantu bonso bakuabo batumikile mukenji wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Lewi bonso nebanyunguluke mukelenge, muntu ne muntu ne bintu bia nvita mu bianza biandi; muntu yonso udi ubuela mu nsubu bamushihe; nuenu nuikale ne mukelenge habueleye mu nsubu ne humukeye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Bena Lewi ne Bena Yuda bonso bakenza muakamba Yehoyada muakuidi; muntu ne muntu wakaya ne bantu bakadiye nʼabo, bakadi babuela dituku dia lumingu ne bakadi bahatuka dituku dia lumingu; bualu bua Yehoyada kakihata milongo ya bena mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada muakuidi wakafila mafuma ne ngabu ne bintu bia nvita biakadi bia mukelenge Davidi, biakadi mu nsubu wa Nzambi, kudi tupitene tua lukama lua bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakimanyika bantu bonso, muntu ne muntu ne bintu bia nvita mu bianza biandi, ku tshianza tshia balume tshia nsubu tô ne ku tshianza tshia bakashi tô ne ku tshioshelu, banyunguluke mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bakalua ne muana wa mukelenge, bakamuashila tshifulu tshia bukelenge, bakamuha mukanda wa dihungila; bakamuhingisha mu bukelenge; Yehoyada ne bana bandi bakamuela manyi ha mutu, bakamba ne, Mukelenge ikale ne muoyo musangu mule!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Atalaya tshiono tshia bantu balumbile lubilu, batumbishe mukelenge, yeye wakabuela kudi bantu mu nsubu wa Yehowa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye wakabanduluka, wakamona mukelenge muimane ku dikunshi diandi dia ku tshibuelelu, ne tupitene ne bena mpungi bimane ha buihi ne mukelenge, ne bena buloba bonso bakadi basanka, bela mpungi, bimbi ba misambu bakadi bimba bisanji, bakadi bimbisha misambu. Hashishe Atalaya wakadihanda bilulu biandi, wakamba ne, Kutungila kua tshitungu, kutungila kua tshitungu! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada muakuidi wakahatuka ne tupitene tua bantu lukama tuakadi ku mutu kua bantu, wakatuambila ne, Muihatai hadiye wenda munkatshi mua bantu, muntu wamulonda, numushihe ne muele wa nvita; bualu bua muakuidi wakamba ne, Kanumushihi mu nsubu wa Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakamushila mpunga; yeye wakaya ku tshibuelelu tshia tubalu tshia ku tshibi tshia mukelenge; bakamushihelaku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada wakahunga tshihungidi ne bantu bonso ne mukelenge, bua bobo bikale bantu ba Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso bakaya ku nsubu wa Bâla, bakamushimbula, bakatshibula mpingu yandi ne bioshelu biandi bituha, bakashiha Matana, muakuidi wa Bâla, ku mpala kua tshioshelu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada wakasungula bena mudimu ba mu nsubu wa Yehowa bakadi mu bukokeshi bua bakuidi ne Bena Lewi bakasungulabo kudi Davidi mu nsubu wa Yehowa, bua kufilabo milambu ya kuosha kudi Yehowa, bu muakafundabo mu mukanda wa mikenji ya Mose; bakimba misambu ne disanka bu muakadi mukenji wa Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakateka balami ku bibi bia ku nsubu wa Yehowa, bua muntu wakadi kayi muakane kabuedi mu nsubu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
              "2CH.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakangata tupitene tua bantu lukama ne bantu banene bonso ne bakokeshi ba bantu ba mu buloba, bakafuma ne mukelenge mu nsubu wa Yehowa; bakabuela ku tshibi tshia ku mutu mu nsubu wa mukelenge, bakashikika mukelenge mu nkuasa wa bukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bantu bonso ba mu buloba bakasanka, musoko wakadi ne ditalala bakashihabo Atalaya ne muele wa nvita.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.21",
            "verseOrgIds": [
              "2CH.23.21"
            ]
          }
        }
      ]
    }
  ],
