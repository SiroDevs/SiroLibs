      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu bionso bidi ne mahuahua bidi bienda ne mikolo mai bidi bibi kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.20",
            "verseOrgIds": [
              "LEV.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi nudi mua kudia bintu bionso bidi ne mahuahua bidi bienda ne mikolo mai bituhike ha buloba, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.21",
            "verseOrgIds": [
              "LEV.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nudi mua kudia mikumbi ne nsua ne bintunte ne mintuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.22",
            "verseOrgIds": [
              "LEV.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bintu bikuabo bidi ne mahuahua ne bidi ne mikolo mai bidi bibi kunudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi ulenga tshianza hamʼbidi ha bintu ebi neikale ne bukoya tô ne dilolo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "muntu yonso udi utuala tshituha tshia mubidi mufue wa bintu ebi, neuvuwe bilulu biandi, neikale ne bukoya tô ne dilolo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama yonso idi ne mikono mihanduluke ne idi kayiyi mihingishilula bintu mukana udi mubi kunudi, muntu yonso udi ulenga tshianza hamʼbidi hai neikale ne bukoya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama yonso udi wenda ne makama udi mubi kunudi, muntu yonso udi ulenga tshianza hamʼbidi hai neikale ne bukoya tô ne dilolo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu yonso udi utuala mubidi mufue wa nyama ei, neuvuwe bilulu biandi, neikale ne bu koya tô ne dilolo, nyama ei idi mibi kunudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
