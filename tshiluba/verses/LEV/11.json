        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biafua nyama wa munkatshi mua nyama mudi mua kudia, mundi yonso udi ulenga tshianza tshiandi hamʼbidi handi neikale ne bukoya tô ne dilolo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu udi udia munyinyi wandi neuvuwe bilulu, neikale ne bukoya tô ne dilolo, ne mundi udi utuala mubidi wandi mufue neuvuwe bilulu biandi, neikale ne bukoya tô ne dilolo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
