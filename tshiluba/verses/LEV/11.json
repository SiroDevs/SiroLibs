    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne Alona ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.1",
            "verseOrgIds": [
              "LEV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuambile Bena Isalele ne, Ebi mbintu bidi ne muoyo binudi mua kudia munkatshi mua nyama yonso idi ha buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.2",
            "verseOrgIds": [
              "LEV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama yonso idi ne mikono mihanduluke ne idi ihingishilula bintu mukana ibidia kabidi, nudi mua kudia nyama ei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.3",
            "verseOrgIds": [
              "LEV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kanudi nyama mikuabo idi ihingishilula bintu mukana, anyi idi ne mikono mihanduluke kamelo, bualu bua kadi kahingishilula bintu mukana, kabidia, kadi kakena ne mikono mihanduluke, kakena kakane kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.4",
            "verseOrgIds": [
              "LEV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabundi ka mputu kakena kakane kunudi, bualu bua kadi kahingishilula bintu mukana, kadi kakena ne mikono mihanduluke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.5",
            "verseOrgIds": [
              "LEV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsenji kena muakane kunudi bualu bua udi uhingishilula bintu mukana, kadi kena ne mikono mihanduluke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.6",
            "verseOrgIds": [
              "LEV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngulube kena muakane kunudi, bualu bua udi ne mikono mihanduluke, kadi kena uhingishilula bintu mukana. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.7",
            "verseOrgIds": [
              "LEV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanudi munyinyi wa nyama ei, kanulengi tshianza hamʼbidi hai, kayena miakane kunudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.8",
            "verseOrgIds": [
              "LEV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nudi mua kudia bintu ebi bia mu mai bintu bidi ne mialala ne mabamba bidi mu mai manene ne mu misulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.9",
            "verseOrgIds": [
              "LEV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bintu bionso bia mu mai budi kabiyi ne mialala ne mabamba, bidi mu mai manene anyi mu misulu, bidi bibi kunudi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.10",
            "verseOrgIds": [
              "LEV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebikale bibi kunudi, kanudi munyinyi wa bintu ebi, ne mibidi mifue yabi neyikale bu bintu bibi kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.11",
            "verseOrgIds": [
              "LEV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu bionso bia mu mai bidi kabiyi ne mialala ne mabamba nebikale bintu bibi kunudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.12",
            "verseOrgIds": [
              "LEV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyunyu ei idi mibi kunudi, kanudi nyunyu ei nyunyu wa mukanku ne nyunyu wa gypaête ne nyunyu wa orfraie, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.13",
            "verseOrgIds": [
              "LEV.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nyunyu wa milan mufike ne wa milan mukunze ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.14",
            "verseOrgIds": [
              "LEV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mushindu wonso wa tshikololo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.15",
            "verseOrgIds": [
              "LEV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nyunyu wa autriche ne nyunyu wa chat-huant ne nyunyu wa mouette ne wa nkumbikumbi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.16",
            "verseOrgIds": [
              "LEV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nyunyu wa tshihungulu ne nyunyu wa choutte ne nyunyu wa ibis, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.17",
            "verseOrgIds": [
              "LEV.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nyunyu wa pélican ne nyunyu mutoke utu wadia bintu bibole ne nyunyu wa cormoran ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.18",
            "verseOrgIds": [
              "LEV.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nyunyu wa cigogne ne nyunyu wa ya héron ne nyunyu wa huppe ne nyunyu wa mudima.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.19",
            "verseOrgIds": [
              "LEV.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
