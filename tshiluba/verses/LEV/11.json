        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu ebi bidi bibi munkatshi mua bintu bidi bidikoka hanshi ha buloba bibulebule ne mpuka ne dibemba ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne musodi ne tshiula ne lungonyonyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu ebi bidi bibi kunudi munkatshi mua bintu bidi bidikoka hanshi, muntu yonso udi ubilenga tshianza hadibi bifue yeye neikale ne bukoya tô ne dilolo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala bintu ebi bifue ne biahonabi ha tshintu, tshintu atshi netshikale ne bukoya, nansha dilonga nansha bilulu nansha biseba nansha tshibombi nansha tshintu tshikuabo tshidibo benza nʼatshi mudimu, nebatshiteke mu mai, netshikale ne bukoya tô ne dilolo, nunku netshikale tshitoke tô. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biahona bintu ebi mu tshivuadi tshia dima, netshikale ne bukoya, nebatshishihe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bintu bionso bia kudia bidi bituangana ne mai akadi mu bintu ebi nebikale ne bukoya, ne mai a kunua onso akadi mu bintu ebi neikale ne bukoya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biahona tshituha tshia mibidi mufue ya bintu ebi ha tshintu, tshintu atshi netshikale ne bukoya, nansha nfulu nansha bivuadi, nebanshihe, bidi ne bukoya, nebikale bibi kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mpokolo wa mai anyi dina dia mai diakumbulabo didi ne mai a bungi, mai au neikale malengele, kudi bintu bionso bidi bituangana ne mibidi yabi mufue nebikale ne bukoya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biahona tshituha tshia mubidi yabi mufue ha bintu bidibo bakuna mu buloba, bintu ebi nebikale bilengele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bielabo mai ha bintu ebi bia kukuna ne biahona tshituha tshia mubidi yabi mufue ha mutu habi, bintu ebi nebikale ne bukoya kunudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
