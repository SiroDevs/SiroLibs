          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi yeye nealekele nyunyu utshidi ne muoyo mu tshisuku ku butshika bua musoko, nealengeshe nsubu nunku, ne nsubu neikale muakane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
