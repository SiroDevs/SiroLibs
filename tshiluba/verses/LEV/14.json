          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "dia mu tshilulu anyi dia mu nsubu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
