          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi nealabe manyi adi mu tshianza tshiandi tshia bakashi ku lusongo lua ditshu dia ku tshianza tshia balume dia muntu udiye musue kulengesha ne ku tshiala tshiandi tshia ku tshianza tshia balume ne ku muanʼa dikasa munene wa ku tshia nza tshia balume, ha mutu ha mashi a mulambu wa disambuka dia mikenji, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
