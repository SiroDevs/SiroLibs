          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye neangate bintu bia kulengesha nʼabi nsubu nyunyu ibidi ne mitshi ya cêdre ne bintu bikunze ne mabeshi a hisopa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
