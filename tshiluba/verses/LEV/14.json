              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bialua muakuidi ne hatangileye ne disama kadiena ditampakana mu nsubu hashikishabo kumujinguila, muakuidi neambile bantu ne, Nsubu eu udi muakane bualu bua disama diakashika. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
