          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biamueneka disama mu nsubu kabidi hashikisheye kumusha mabue ne kukuona munda mua nsubu ne hajinguileye makuabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
