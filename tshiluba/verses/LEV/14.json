          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "manyi adi ashala mu tshianza tshia muakuidi, yeye neaele ha mutu ha muntu udiye musue kulengesha, bua kumubuikidila disambuka diandi ku mpala kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neafile umue wa nyunyu wa nkutshi anyi wa mputu nyunyu udiye mua kuangata ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "umue wa mulambu wa kubuikila nʼau bubi ne mukuabo wa mulambu wa kuosha ha kahia ne mulambu wa bukula, muakuidi neafile mulambu wa kubuikila nʼau bubi bua muntu udiye musue kulengesha ku mpala kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eu udi mukenji wa muena nsudi udi kayi mua kusangisha bintu bia mushinga mukole bia kudilengesha nʼabi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
