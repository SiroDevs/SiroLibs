              "type": "text"
            }
          ]
        },
        {
          "text": "ne wa tshiuja kabidi anyi wa tshilamulamu anyi wa ditoba ditoke, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
