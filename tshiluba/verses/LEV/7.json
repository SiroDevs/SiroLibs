          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.28",
            "verseOrgIds": [
              "LEV.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Muntu udi ufila mulambu wa kuvuisha nʼau ditalala kudi Yehowa nealue ne tshituha tshia mulambu wa kuvuisha nʼau ditalala, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.29",
            "verseOrgIds": [
              "LEV.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye nealue ne mulambu wa kuoshila Yehowa ha kahia mu bianza biandi, nealue ne dianyi ne tshiadi, nebatshinyukule bu mulambu udibo banyukula ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.30",
            "verseOrgIds": [
              "LEV.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neoshe dianyi ha tshioshelu, kadi tshiadi netshikale tshia Alona ne bana bandi balume. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.31",
            "verseOrgIds": [
              "LEV.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuhe muakuidi diboko dia balume dia nyama wa mulambu wa kuikisha nʼau ditalala udibo banyukula ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.32",
            "verseOrgIds": [
              "LEV.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wa munkatshi mua bana balume ba Alona udi ufila mashi ne dianyi bia mulambu wa kuvuisha nʼau ditalala neikale ne diboko dia balume bu tshintu tshiandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.33",
            "verseOrgIds": [
              "LEV.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua meme nakangata tshiadi tshidibo banyukula ne diboko didibo bakuha munkatshi mua milambu ya Bena Isalele, nakabifila kudi Alona muakuidi ne bana bandi balume bu bituha biabo tshiendelele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.34",
            "verseOrgIds": [
              "LEV.7.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etshi ntshintu tshia tshijila tshia Alona ne tshia bana bandi balume munkatshi mua milambu ya Yehowa idibo bosha ha kahia mu dituku diakabasunguleye bua kuenzelabo Yehowa mudimu wa buakuidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.35",
            "verseOrgIds": [
              "LEV.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakela mukenji wandi kudi Bena Isalele bua kubahabo tshintu etshi mu dituku diakabasunguleye. Etshi ntshintu tshiabo tshiendelele mu bikondo biabo bionso. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.36",
            "verseOrgIds": [
              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eu udi mukenji wa mulambu wa kuosha ha kahia ne wa mulambu wa bukula ne wa mulambu wa kubuikila nʼau bubi ne wa mulambu wa kusambuka kua mikenji, ne wa tshijila tshia bakuidi, ne wa mulambu wa kuvuisha nʼau ditalala, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakambila Yehowa Mose mu mukuna wa Sinai mu dituku diakeleye mukenji wandi kudi Bena Isalele bua kufilabo milambu yabo kudi Yehowa mu tshihela tshia Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
