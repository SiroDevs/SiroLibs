          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua edi ndituku didibo banubuikidila bubi buenu bua kunulengesha nunku nenuikale balengeshibue ku mibi yenu yonso ku mpala kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
