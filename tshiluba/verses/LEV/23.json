          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matuku muanda mutekete nenufile milambu ya kuoshila Yehowa ha kahia, dituku dia muanda mukulu nedikale dituku dia disangisha dia tshijila kunudi, nenufile mulambu wa kuoshila Yehowa ha kahia, edi ndisangisha dia tshijila, kanuenji mudimu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
