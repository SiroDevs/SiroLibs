          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku edi nedikale dituku dia lumingu dia kuikisha, ne nuenu nenujinge mu mitshima yenu, nuikishe bienu ku dilolo dia matuku tshitema a ngondo eu tô ne ku dilolo dia matuku dikumi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.32",
            "verseOrgIds": [
              "LEV.23.32"
            ]
          }
        }
