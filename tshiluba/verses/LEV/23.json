          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku dia kumudilu nenuangate mamuma a mitshi mimpe ne bikola bia mabue ne matamba a mitshi ne ntuhu ya mu mai, nenusanke ku mesu kua Yehowa, Nzambi wenu, matuku muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.40",
            "verseOrgIds": [
              "LEV.23.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
