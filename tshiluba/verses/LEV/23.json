          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenudie bidia nunku ku mesu kua Yehowa matuku muanda mutekete ku tshidimu ku tshidimu, eu udi mukenji wa tshiendelele mu bikondo bienu bionso, nenuenze bualu ebu mu ngondo wa muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.41",
            "verseOrgIds": [
              "LEV.23.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
