          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Dituku dia matuku dikumi ne atanu a ngondo eu wa muanda mutekete nebikale dituku didibo badia bidia bia mu bitandatanda tô matuku muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
