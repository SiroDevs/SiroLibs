          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuikale mu bitandatanda matuku muanda mutekete; bantu bonso hakalelabo mu Isalele nebashikame mu bitandatanda ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.42",
            "verseOrgIds": [
              "LEV.23.42"
            ]
