          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku dia kumudilu nedikale dituku dia disangisha dia tshijila, kanuenji mudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
