          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neatangile ha disama, neateke tshintu tshidi ne disama edi ha buatshi tô matuku muanda mutekete, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.50",
            "verseOrgIds": [
              "LEV.13.50"
            ]
          }
        },
