          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi neamutangile, ne bikala mputa mutampakane mu dikoba, muakuidi kena ne bua kukeba nsuki mitoke tô, muntu eu kena muakane. ",
          "type": "text",
          "attrs": {
