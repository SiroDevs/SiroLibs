              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye udi muena nsudi, kena muakane, muakuidi neambile bantu ne, Muntu eu kena muakane, udi ne disama dia nsudi ku mutu kuandi.",
          "type": "text",
          "attrs": {
