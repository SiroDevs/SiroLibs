          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi biamueneka mputa mutoke tô ku mutu kua muena dibala, anyi ha mpala hadi dibala, edi ndisama dia nsudi diakumueneka ku mutu kua muena dibala anyi ha mpala hadi dibala. ",
          "type": "text",
          "attrs": {
