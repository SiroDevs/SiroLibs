          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia muanda mute kete, muakuidi neatangile mu mputa, ne bikala mputa kayi mutampakane mu dikoba, ne kayi ubuela mu munyinyi wa mubidi, muakuidi neambile bantu ne, Muntu eu udi muakane, yeye neuvuwe bilulu biandi, neikale muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.34",
            "verseOrgIds": [
