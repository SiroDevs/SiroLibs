          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "nansha mu milongo ya buludi nansha mu milongo ya butshiama ya miosa ya mikoko anyi ya lin, nansha mu tshiseba anyi mu tshintu tshiakenzabo ne tshiseba, ",
          "type": "text",
          "attrs": {
