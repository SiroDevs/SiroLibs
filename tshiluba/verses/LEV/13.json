          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "halua dituku dia muanda mutekete, yeye neatangile ha disama, bikala disama ditampakane mu tshilulu, nansha mu milongo ya buludi nansha mu milongo ya butshiama, nansha mu tshiseba tshidibo benza nʼatshi mudimu edi ndisama dia nsudi; tshintu etshi katshiena tshiakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.51",
            "verseOrgIds": [
              "LEV.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
