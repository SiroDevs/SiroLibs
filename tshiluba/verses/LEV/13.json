          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia muanda mutekete, muakuidi neatangile mu mputa, ne bikala mputa kayi mutampakane, ne nsuki mitoke kabayiku, bielanganeye meji ne mputa kena ubuela mu munyinyi wa mubidi, ",
          "type": "text",
          "attrs": {
