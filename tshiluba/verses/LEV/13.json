              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala nsuki ya muntu mituke, ne bikaleye muena dibala, yeye udi muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.40",
            "verseOrgIds": [
