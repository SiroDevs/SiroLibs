          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilulu biakadiye nʼabi, nansha tshilulu tshiakenzabo ne miosa ya mikoko nansha tshilulu tshia lin, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.47",
