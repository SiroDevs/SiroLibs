          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala nsuki ya muntu ya ku mpala nubike, ne bikala mpala wandi ne dibala, yeye udi muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.41",
