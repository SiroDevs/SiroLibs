          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebamubeye, kadi nebashiye muaba wa mputa, ne muakuidi neamubueshe mu nsubu matuku muanda mutekete makuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.33",
            "verseOrgIds": [
