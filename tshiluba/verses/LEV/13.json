      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne Alona ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muntu ne tshiuja tshikese mu dikoba diandi anyi tshilamulamu anyi ditoba ditoke tô, bikala bintu ebi bu disama dia nsudi, nebalue nʼandi kudi Alona muakuidi anyi kudi umue wa bana bandi balume bakuidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neatangile ha disama didi mu dikoba diandi, bikala miosa ya mu muaba wa disama miandamuke mitoke tô, ne bikala disama dimane kubuela mu munyinyi wandi mene mene, edi ndisama dia nsudi, muakuidi neamutangile, neambile bantu ne, Muntu eu kena muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biamueneka ditoba ditoke tô mu dikoba diandi, ne bikaladi kadiyi dibuela mu munyinyi wandi mene, ne bikala miosa kayiyi mianze kuandamuka mitoke tô, nunku muakuidi neabueshe muntu udi ne disama ha nkayandi mu nsubu tô matuku muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia muanda mutekete, muakuidi neamutangile kabidi, bielanganeye meji ne disama didi diamba kushika, kadiena ditampakana, nunku muakuidi neamubueshe mu nsubu ha nkayandi matuku muanda mutekete makuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halua dituku dia muanda mutekete, muakuidi neamutangile kabidi, ne biamba disama kushika, bikaladi kadiyi ditampakana mu dikoba diandi, nunku muakuidi neambile bantu ne, Muntu eu udi muakane, disama edi didi bu tshilamulamu, muntu eu neuvuwe bilulu biandi, neikale mua kane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bikala tshilamulamu tshitampakane mu dikoba, hakashikisheye kudilesha kudi muakuidi bualu bua kudilengesha, nunku yeye neadileshe kudi muakuidi kabidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi neatangile ne bikala tshilamulamu tshitampakane mu dikoba, nunku muakuidi neambile bantu ne, Muntu eu kena muakane disama edi didi dia nsudi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muntu ne disama dia nsudi, nebalue nʼandi kudi muakuidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi neatangile, ne bikala tshima tshitoke tô mu dikoba, ne bikala miosa miandamuke mitoke tô, ne bikala munyinyi mubishe mu tshima, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "edi didi disama dia nsudi diakadi kudiye diambedi mu dikoba diandi, ne muakuidi neambile bantu ne, Muntu eu kena muakane, yeye kena umubuesha mu nsubu, bualu bua yeye kena muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bikala disama dia nsudi ditampakane mu dikoba ne biabuikiladi dikoba dionso dia muena nsudi, ku mutu tô ne ku makasa andi, ku miaba yonso idi muakuidi utangila, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku muakuidi neatangile ne bikala disama dia nsudi dimane kubuikila dikoba diandi dionso, yeye neambile bantu ne, Muntu eu wakadi ne nsudi udi muakane, wakandamuka muteke tô, yeye udi muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi biamueneka munyinyi wa mubidi mubishe, yeye kena muakane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muakuidi neatangile ha munyinyi wa mubidi mubishe, neambile bantu ne, Muntu eu kena muakane, munyinyi eu mubishe kawena muakane edi ndisama dia nsudi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyi bikala munyinyi eu mubishe muandamuke muteke tô kabidi nunku yeye nealue kudi muakuidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "muakuidi neamutangile, ne biandamukeye mutoke tô, nunku muakuidi neambile bantu ne, Muntu eu wakadi ne nsudi udi muakane, ne yeye neikale muakane.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
