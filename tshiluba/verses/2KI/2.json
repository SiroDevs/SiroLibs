        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafika tshikondo tshiakasungula Yehowa bua kuya ne Eliya mu diulu mu nvunde, Eliya wakafuma ne Elisha mu Gilegala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya wakambila Elisha ne, Ndi nkusengelela ne, Wewe ushikame kunoko, bualu bua Yehowa wakantuma ku Betele. Elisha wakamuambila ne. Bu mudi Yehowa ne muoyo ne bu mudi mutshima webe ne muoyo, tshiena ukulekela. Nunku bubidi buabo bakaya ku Betele. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana balume ba baprofete bakadi ku Betele, bakalua kudi Elisha, bakamuebesha ne, Udi mumanye ne, Yehowa neumushe mukelenge webe ku mutu kuebe lelu, anyi? Yeye wakabambila ne, E, ndi mumanye, nuanji kuhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya wakambila Elisha ne, Ndi nkusengelela ne, Ushikame kunoko, bualu bua Yehowa wakuntuma ku Yeleko. Yeye wakamuambila ne, Bu mudi Yehowa ne muoyo ne bu mudi mutshima webe ne muoyo, tshiena nkulekela. Nunku bakaya ku Yeleko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana balume ba baprofete ba mu Yeleko bakaluhuka kudi Elisha, bakamuebesha ne. Udi mumanye ne, Yehowa neumushe mukelenge webe ku mutu kuebe lelu, anyi? Yeye wakabambila ne, E, ndi mumanye, nuanji kuhuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya wakamuambila ne, Ndi nkusengelela ne, Ushikame kunoko, bualu bua Yehowa wakuntuma ku Yadene. Yeye wakamuambila ne, Bu mudi Yehowa ne muoyo ne bu mudi mutshima webe ne muoyo, tshiena nkulekela. Bubidi buabo bakatshidi baya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makumi atanu ba bana balume ba baprofete bakaya, bakimana ha bule buludiludi nʼabo, bubidi buabo bakimana hehi ne Yadene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya wakakohola tshikowelu tshiandi, wakatshivunga wakatula ha mai, ne mai akahanduluka eku ne eku; bubidi buabo bakasabuka ha buloba bûme.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakasabukabo, Eliya wakambila Elisha ne, Ulombe tshindi mua kukuenzela diambedi tshiyi muanze kubandishibua kudi Elisha wakamuambila ne, Ndi nkusengelela ne, Witabushe bua bituha bibidi bia nyuma webe bikale kundi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Wewe wakulomba bualu bakole, kadi biwantangila hanabandishibua kûdi, bualu nebuenjibue bu mu dî diebe; kedi biwikala kuyi untangila, bualu kabuena buenjibua. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshidibo benda bayikila, monai, dikalu dia kahia ne tubalu tua kahia biakamueneka, biakabahandulula, ne Eliya wakabandishibua mu diulu mu nvunde. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha wakamumona, wakela dî diandi ne, Tatu wanyi, tatu wanyi, dikalu dia Isalele ne badi benda ha tabalu tuadi!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye kakamutangila kabidi. Yeye wakavula bilulu biandi, wakabihanda bihese bibidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakambula kowelu tshia Eliya tshiakahona kudiye wakahingana, wakimana kumuelelu wa Yadene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakangata tshikowelu tshia Eliya tshiakahona kudiye, wakatula ha mai, wakamba ne Yehowa, Nzambi wa Eliya, udi kudi kunyi? Hakatuteye ha mai, mai akahanduluka eku ne eku; Elisha wakasabuka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamutangila bana balume ba baprofete bakadi ku Yeleko, bakambilangana ne, Nyuma wakadi nʼandi Eliya wakatulukila Elisha. Bakalua kumuakidila. Bakinama hanshi ku mpala kuandi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuambila ne, Mona, bakole makumi atanu badi munkatshi mua bantu bebe badi kunoko; ludi tukusengelela ne. Ubatume, bakehe mukelenge webe; bumue Nyuma wa Yehowa wakabanda nʼandi, wakamuela ha mutu ha mukuna mukuabo anyi mu tshinga tshibanda. Yeye wakamba ne, Kanubatumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo bamusengelele tô ne bakamukuata bundu, yeye wakamua ne, Nubatume. Bakatuma bantu makumi atanu, bakakebakeba tô matuku asatu, kadi kabakamusangana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakahingana kudiye hakadiye mu Yeleko; yeye wakabebesha ne, Tshiakanuambila ne, Kanuyi, anyi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena musoko bakambila Elisha ne, Mona, tudi tukusengelela ne. Muaba wa musoko wetu udi muimpe, bu mudi mukelenge wetu umona, kadi mai adi mabi, buloba kabuena bumenesha bintu bimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Nulue kundi ne mulondo muhia-muhia, nuelemu luehu. Bakalua nʼau kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakaya ku mishimi ya mai, wakelamu luehu wamba ne, Yehowa udi wamba ne, Nakalengesha mai a; lulu ne kuhoka kua mamuma kabiena bifumaku kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku mai â akalengeshibua tô ne ku difuku edi bu mu dî diakamba Elisha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakumukaku, wakaya ku Betele: hakadiye uya mu nshila, bana ba balume bakaluhuka mu musoko, bakamuseka, bakamuambila ne, Banda biebe, muena lubala! Banda biebe, muena lubala! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakatshunguluka, wakabatangila, wakabela mulau mu dina dia Yehowa. Bakashi ba ours",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2.24:",
              "type": "text"
            },
            {
              "text": "Ours udi nyama munene udi ne miosa ya bungi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " babidi bakaluhuka muitu, bakahandangana bana ba balume makumi anai ne babidi bakadi munkatshi muabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakafumaku, wakaya ku mukuna wa Kâmele, wakahingana ku Samalea.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
      ]
    }
  ],
