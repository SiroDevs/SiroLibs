  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "JDG 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimishona wakaya ku Gaza, wakatangilaku mukashi wa masandi, wakabuela kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambila Bena Gaza ne, Shimishona wakulua munemu. Bakamunyunguluka, bakalala butuku buonso ku tshibi tshia ku musoko, bamuindile balamine; bakalala talalâ butuku buonso bamba ne, Tuanji kumuindila ne hatshiabu, netumushihe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimishona wakalalamu tô ne mundankulu, wakabika mundankulu, wakakuata bibi bia ku musoko, ne makunshi abi abidi, wakabitula ne biamu bionso, wakabiteka ha maha andi, wakaya nʼabi tô ne ku mutu kua mukuna munene udi ku mpala kua Hebelone.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua malu au yeye wakananga mukashi wa mu tshibanda tshia Soleka, dina diandi Delila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakelenge ba Bena Peleshete bakaha kudiye, bakamuambila ne, Umuitabushishe bua kujingulula mudi bukole buandi, ne mua tuetu kumanya mua kumuhita bukole, ne bua tuetu kumusuika, kumukengesha; ne buonso buetu, muntu ne muntu, netukuhe argent tshinunu tshimue ne lukama lumue. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila wakambila Shimishona ne, Ndi nkusengelela ne, Ungambileku ne mudi bukole buebe bunene, ne bu mudibo bamanye mua kukusuika bua kukukengesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimishona wakamuambila ne, Biansuikabo ne milemu mibishe muanda mutekete, idi kayiyi mianze kûma, nentekete, nengikale bu muntu mukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bakelenge ba Bena Peleshete bakalua kudiye ne milemu mibishe muanda mutekete yakadi kayiyi mianze kûma, ne yeye wakamusuika nʼai. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamana kuteka bantu bu balaminyi bakadi balala munda mua nsubu; yeye wakamuambila ne, Shimishona, Bena Peleshete badi hamʼbidi hebe. Yeye wakatula milemu bu mudibo hatula nshinga wa mitshi ya diamba, hautuabo kahia. Nunku kabakadi bamanye bukole buandi kuakafumabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila wakambila Shimishona ne, Mona, wakunseka, wakunshima; katataka ndi nkusengelela ne, Ungambile mudibo mua kukusuika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuambila ne, Biansuikabo ne mionshi mihia-mihia idibo kabayi banze kuenza nʼai mudimu, nentekete, nengikale bu muntu mukuabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Delila wakangata mionshi mihia-mihia, wakamusuika nʼai, wakamuambila ne, Shimishona, Bena Peleshete badi hamʼbidi hebe. Balaminyi bakadi balala munda mua nsubu. Yeye wakakula ku maboko andi bu buanda.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila wakambila Shimishona ne, Diambedi wewe wakunseka, wakungambila anu mashimi, ungambile mudibo mua kukusuika. Yeye wakamuambila ne, Biwakuma bisumbu bia nsuki yanyi muanda mutekete mu mbungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakasuika nsuki yandi ne mundongo, wakamuambila ne, Shimishona, Bena Peleshete badi hamʼbidi hebe. Yeye wakatabala ku tulu tuandi, wakatula mundongo ne mbungu kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamukonka ne, Wewe udi mua kuamba ne, Ndi mukusue munyi, hadi mutshima webe kauyi kundi? Wakunseka misangu ei isatu, kuena mungambile mudi bukole buebe bunene. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadiye umusengelela ne mei andi ku dituku ku dituku, wakamutatshisha, mutshima wandi wakatata tô ne ku lufu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamusokoluela malu onso akadi mu mutshima wandi, wakamuambila ne, Dihaya kadiena dianze kubeya ha mutu hanyi, bualu bua nakumana kuikala Munazi kudi Nzambi katshia ku difu dia mamu wanyi; biambeyabo, bukole buanyi nebumuke kundi, nentekete, nengikale bu muntu mukuabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Delila ne, Yeye wakungambila malu onso a mu mutshima wandi, yeye wakatuma dî, wakabikila bakelenge ba Bena Peleshete, wamba ne, Luai bienu anu musangu eu, bualu bua yeye wakunsokoluela malu onso akadi mu mutshima wandi. Hashishe bakelenge ba Bena Peleshete bakalua kudiye ne argent mu bianza biabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.18",
            "verseOrgIds": [
              "JDG.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamuladika tulu ha bibelu biandi; yeye wakabikila mulume, wakamubeya bisumbu bia nsuki muanda mutekete yakadi ku mutu kuandi; yeye wakabanga kumukengesha ne bukole buandi buakumuka kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.19",
            "verseOrgIds": [
              "JDG.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Shimishona, Bena Peleshete badi hamʼbidi hebe. Yeye wakatabala ku tulu tuandi, wamba ne, Nenduhuke bu misangu mikuabo ya diambedi, nendihandishe nkayanyi mu bianza biabo. Kadi yeye kakadi mumanye ne, Yehowa wakamana kundekela. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Peleshete bakamukuata, bakatunyina mesu andi, bakahueka nʼandi ku Gaza, bakamusuika ne nkanu ya tshiamu tshia mitaku; yeye wakadi uhela mu nsubu wa lukanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi nsuki ya ku mutu kuandi yakahanga kumena kabidi, hakamubeyabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakelenge ba Bena Peleshete bakadisangisha hamue bua kufilabo mulambu munene kudi Dagona, nzambi wabo, ne bua kusankabo, bamba ne, Nzambi wetu wakafila Shimishona, muena lukuna wetu, mu bianza bietu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamutangila bantu, bakatumbisha nzambi wabo, bakamba ne, Nzambi wetu wakafila muena lukuna wetu mu bianza bietu, wakadi muhaudi wa buloba buetu, wakatushiha ba bungi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadi mitshima yabo isanka, bakamba ne, Bikilai Shimishona, alue kutusekesha. Bakabikila Shimishona mu nsubu wa lukanu; ne yeye wakahasekesha, bakamuteka hankatshi ha makunshi manene; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimishona wakambila nsongalume wakadi umukuata ku tshianza ne, Witabushe bua meme kubenga bianza bianyi ku makunshi adi makuate nsubu, bua meme ngeyemeneku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsubu wakadi mule tente ne balume ne bakashi; bakelenge bonso ba Bena Peleshete bakadimu; ne bantu bu binunu bisatu ne balume ne bakashi bakadi ha mutu ha nsubu, batangile hakadi Shimishona ubasekesha.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
