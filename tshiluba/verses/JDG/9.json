  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JDG 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke, muana wa Yelubâla, wakaya ku Shekeme kudi bana babo ne mamu wandi, yeye wakabambila ne bantu bonso ba mu nsubu wa tatu wa mamu wandi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.1",
            "verseOrgIds": [
              "JDG.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntu nnusengelela ne, Nukonke bena Shekeme bonso mu matshu abo ne, Bualu kai budi butambe buimpe ku mesu kuenu bua bana balume bonso ba Yelubâla badi makumi muanda mutekete banukokeshe, anyi bua muntu umue anukokeshe? Nuvuluke kabidi ne meme ndi bu mufuba wa mifuba yenu ne bu musunyi wa misunyi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.2",
            "verseOrgIds": [
              "JDG.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana babo ne mamu wandi bakamuambila mei au onso mu matshu a bena Shekeme bonso; ne mitshima yabo yakasua kulonda Abimeleke; bualu bua bakamba ne, Yeye udi muanʼetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.3",
            "verseOrgIds": [
              "JDG.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuha argent makumi muanda mutekete ya mu nsubu wa Bâla-belita; ne Abimeleke wakafuta nʼai bantu bahote ne ba hatuhu bakamulonda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.4",
            "verseOrgIds": [
              "JDG.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakaya ku nsubu wa tatu wandi wa ku Ofela, wakashiha bana babo bonso, bana ba Yelubâla, makumi muanda mutekete, ha dibue dimue. Kadi Yotama, muanʼa mukala wa Yelubâla, wakashala, bualu bua yeye wakasokoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.5",
            "verseOrgIds": [
              "JDG.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Shekeme bonso bakadisangisha hamue ne bonso ba mu nsubu wa Milo bakaya, bakateka Abimeleke mu bukelenge, muinshi mua mutshi wa telebinta ku dibue",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9.6:",
              "type": "text"
            },
            {
              "text": "Tangila Yoshua 24.26.",
              "type": "text"
            }
          ]
        },
        {
          "text": " dinene diakadi mu Shekeme.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakambabo Yotama bualu ebu, yeye wakaya, wakimana ha mutu ha mukuna wa Gelizima, wakabandisha dî diandi, wakabambila ne, Nuenu bena Shekeme, nungunvuile, bua Nzambi anufuile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.7",
            "verseOrgIds": [
              "JDG.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale mitshi yonso yakadisangisha bua kusungula mukelenge wa ku mutu kuai. Yakambila mutshi wa olive ne, Utukokeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.8",
            "verseOrgIds": [
              "JDG.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mutshi wa olive wakayambila ne, Nshiye mafuta anyi andi ntumbisha nʼau Nzambi ne bantu kabidi, bua kuya kuhehukahehuka ku mutu kua mitshi mikuabo, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.9",
            "verseOrgIds": [
              "JDG.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitshi yonso yakambila mutshi wa nfigi ne, Lua biebe, ubukokeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.10",
            "verseOrgIds": [
              "JDG.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mutshi wa nfigi wakayambila ne, Nshiya kushemakana kuanyi ne mamuma anyi mimpe bua kuya kuhehukahehuka ku mutu kua mitshi mikuabo, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.11",
            "verseOrgIds": [
              "JDG.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitshi yakambila muonshi wa tumuma ne, Lua biebe, udikokeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.12",
            "verseOrgIds": [
              "JDG.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi muonshi wakayambila ne, Nshiye nvinyo yanyi mihia-mihia, idi isankisha Nzambi ne bantu kabidi, bua kuya kuhehukahehuka ku mutu kua mitshi yonso mikuabo, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.13",
            "verseOrgIds": [
              "JDG.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe mitshi yonso yakambila mutshi wa meba ne, Lua biebe, utukokeshe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.14",
            "verseOrgIds": [
              "JDG.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutshi wa meba wakambila mitshi yonso ne, Binuasua kungela manyi ha mutu bua meme kuikala mukelenge ku mutu kuenu bulelela, hashishe nulue nushikame mu diledi dianyi, kadi binuahidia, kahia kahatuke ku mutshi wa meba bua kuosha mitshi ya cédres ya mu Lebanona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.15",
            "verseOrgIds": [
              "JDG.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku binuenza bulelela ne buimpe, hanuakuteka Abimeleke mu bukelenge, ne binuenzela Yelubâla ne ba mu nsubu wandi bimpe, ne binuamufuta bu muakadi difutu diandi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.16",
            "verseOrgIds": [
              "JDG.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "(bualu bua tatu wanyi wakanuluila nvita, wakamba kunufuila ne muoyo wandi, wakanusungila mu bianza bia Bena Midiyana; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.17",
            "verseOrgIds": [
              "JDG.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nuenu nuakabika ku mpala kua nsubu wa tatu wanyi lelu, nuakushiha bana bandi balume makumi muanda mutekete ha dibue dimue, nuakateka Abimeleke, muana wa mukashi, muenji wa mudimu wandi, mu bukelenge ku mutu kua bena Shekeme, bualu bua yeye udi muanʼenu) ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.18",
            "verseOrgIds": [
              "JDG.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "binuikala benzele Yelubâla ne ba mu nsubu wandi bualu bulelela ne buimpe lelu, nusanke bualu bua Abimeleke ne yeye asanke bualu buenu kabidi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.19",
            "verseOrgIds": [
              "JDG.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi binuikala kanuyi benze bimpe, kahia kahatuke kudi Abimeleke bua kuosha bena Shekeme ne ba mu nsubu wa Milo; kahia kahatuke kabidi kudi bena Shekeme ne kudi ba mu nsubu wa Milo bua kuosha Abimeleke kabidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.20",
            "verseOrgIds": [
              "JDG.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Yotama wakumuka, wakanyema, wakaya ku Be, wakashikamaku bualu bua dishina dia Abimeleke muanʼabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke wakadi mukelenge ku mutu kua Bena Isalele bidimu bisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.22",
            "verseOrgIds": [
              "JDG.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wakatuma nyuma mubi hankatshi ha Abimeleke ne bena Shekeme; bena Shekeme bakayila Abimeleke ku tshitungu; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.23",
            "verseOrgIds": [
              "JDG.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua bualu bubi buakenzeleye bana ba Yelubâla makumi muanda mutekete ne mashi abo kabidi bihingane ku mutu kua Abimeleke muanʼabo, nguakabashiha, ne ha mitu ha bena Shekeme bakamukolesha maboko bua yeye kubashiha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.24",
            "verseOrgIds": [
              "JDG.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Shekeme bakamutekela balaminyi ku mutu kua mikuna yonso, bakanyenga bintu bia bantu bonso bakahita mu nshila; bakambila Abimeleke bualu ebu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.25",
            "verseOrgIds": [
              "JDG.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.25",
            "verseOrgIds": [
              "JDG.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala, muana wa Ebede, wakalua ne ba mu tshiota tshiandi, Wakafika ku Shekeme; bena Shekeme bakamueyemena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.26",
            "verseOrgIds": [
              "JDG.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakaya mu madimi, bakahuola mamuma abo, bakatua tumuma tuabo tua nvinyo ku makasa abo, bakadia bidia bia disanka, bakabuela mu nsubu wa nzambi wabo, bakadia, bakanua, bakela Abimeleke mulau. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.27",
            "verseOrgIds": [
              "JDG.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala, muana wa Ebede, wakamba ne, Abimeleke udi nganyi, ne Shekeme udi nganyi, bua tuetu kumukuatshia mudimu? Yeye kena muana wa Yelubâla, anyi? Zebula kena kapita kandi, anyi? Nuenu nudi nukuatshila Hamo, tatu wa Shekeme, mudimu; kadi tudi ne bua kumukuatshia mudimu bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.28",
            "verseOrgIds": [
              "JDG.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi musue bantu aba bikale mu tshianza tshianyi, hashishe nengumushe Abimeleke. Yeye wakambila Abimeleke ne, Ukumbashe bena nvita bebe, uluhuke biebe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.29",
            "verseOrgIds": [
              "JDG.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.29",
            "verseOrgIds": [
              "JDG.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakunyua Zebula, mukelenge wa mu musoko, mei a Gala, muana wa Ebede, tshiji tshiandi tshiakadi tshikole. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.30",
            "verseOrgIds": [
              "JDG.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakatuma bamessager kudi Abimeleke mu musokoko bamba ne, Gala, muana wa Ebede, ne bana babo bakatua ku Shekeme, badi bakeba mua kukutombueshila bena musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.31",
            "verseOrgIds": [
              "JDG.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku ulue biebe mu butuku, wewe ne bantu badi nʼebe, nubalamine mu tshisuku; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.32",
            "verseOrgIds": [
              "JDG.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne dinda habanda diba, wewe ubike hatshiatshia, uye ku musoko lubilu; hashishe haluhukeye ne bantu hadiye nʼabo bua kuluangana nʼebe, wewe neubenzele bu mûdi musue.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Abimeleke wakabika ne bantu bonso bakadi nʼandi, bakaya mu butuku, bakalamina ha buihi ne Shekeme, baditahulule bisumbu binai. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.34",
            "verseOrgIds": [
              "JDG.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala, muana wa Ebede, wakaluhuka, wakimana ku tshibi tshia musoko; ne Abimeleke ne bantu bakadi nʼandi bakabika kuakadibo balamina. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.35",
            "verseOrgIds": [
              "JDG.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Gala bantu aba, yeye wakambila Zebula ne, Tangila, bantu badi bahueka ku mutu kua mikuna. Zebula wakamuambila ne, Wewe udi utangila anu maledi a mikuna bu mudiu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.36",
            "verseOrgIds": [
              "JDG.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Gala wakamuambila kabidi ne, Tangila, bantu badi bahueka munkatshi mua mikuna, ne tshisumbu tshimue tshidi tshiluila mu nshila wa ku mutshi wa telebinta wa Meonenima. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.37",
            "verseOrgIds": [
              "JDG.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Zebula wakamukonka ne, Mukana muebe muakamba ne, Abimeleke udi nganyi, bua tuetu aba kumukuatshia mudimu, mudi kudi kunyi? Aba kambantu bawakahetula, anyi? Ndi nkusengelela ne, Uye biebe, uluangana nʼabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.38",
            "verseOrgIds": [
              "JDG.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala wakaya ku mpala kua bena Shekeme, wakaluangana ne Abimeleke. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.39",
            "verseOrgIds": [
              "JDG.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke wakamuihata, yeye wakanyema ku mpala kuandi, ne ba bungi bakahona hanshi batahike mputa, tô ne ku mbelu kua tshibi tshia musoko. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.40",
            "verseOrgIds": [
              "JDG.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke wakashikama ku Aluma; ne Zebula wakihata Gala ne bana babo bua bobo kabashikami mu Shekeme.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshiabu bantu bakaya mu tshisuku, bakambila Abimeleke bualu ebu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.42",
            "verseOrgIds": [
              "JDG.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakangata bantu bandi, wakabatahulula mu bisumbu bisatu, bakalamina; wakatangila bantu baluhuka ku musoko, ne yeye wakabika, wakabaluisha ne wakabashiha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.43",
            "verseOrgIds": [
              "JDG.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke ne bisumbu biakadi nʼandi bakaya lubilu, bakimana ku tshibi tshia musoko, ne bisumbu bibidi biakaya, biakatantshila bonso bakadi mu tshisuku, bakabashiha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.44",
            "verseOrgIds": [
              "JDG.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke wakaluangana ne bena musoko dituku adi dionso, wakanyenga musoko, wakashiha bantu bonso bakadimu. Wakabutula musoko, wakanuaminamu luehu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 9:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua bantu bonso bakadi mu tshibumba tshia mu Shekeme lumu elu, bakabuela mu nsubu wa mabue wa Ele-belita. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.46",
            "verseOrgIds": [
              "JDG.9.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 9:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakambila Abimeleke ne, Bantu bonso bakadi mu tshibumba tshia mu Shekeme bakadisangisha hamue. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.47",
            "verseOrgIds": [
              "JDG.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Abimeleke wakabanda ku mukuna wa Salemona, yeye ne bantu bonso bakadiye nʼabo; Abimeleke wakangata tshisui mu tshianza tshiandi, wakakosa nʼatshi ditamba dia mutshi, wakaditeka ha diaha diandi, yeye wakambila bantu bakadi nʼandi ne, Nuakatangila munakuenza, enzai bu munakuenza lubilu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.48",
            "verseOrgIds": [
              "JDG.9.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JDG 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu aba bonso, muntu ne muntu, bakakosa matamba, bakalonda Abimeleke, bakâteka kuinshi kua nsubu, bakosha nsubu ne kahia; nunku bantu bonso bakadi mu tshibumba tshia mu Shekeme bakafua kabidi, bu bantu tshinunu ne balume ne bakashi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.49",
            "verseOrgIds": [
              "JDG.9.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JDG 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.49",
            "verseOrgIds": [
              "JDG.9.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JDG 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Abimeleke wakaya ku Tebese, wakaluangana ne Bena Tebese, wakaunyenga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.50",
            "verseOrgIds": [
              "JDG.9.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JDG 9:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tshibumba tshikole tshiakadi mu musoko, ne balume bonso ne bakashi bonso ba mu musoko bakanyemenamu, bakinshila bibi; bakahanda ku mutu kua tshibumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.51",
            "verseOrgIds": [
              "JDG.9.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JDG 9:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleke wakalua ha buihi ne tshibumba, wakaluangana ne benʼatshi, wakasemena ku tshibi tshia tshibumba bua kutshiosha ne kahia. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.52",
            "verseOrgIds": [
              "JDG.9.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JDG 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi mukashi mukuabo wakela dibue dia mpelu dinene ha mutu wa Abimeleke, wakahanda kabalubalu kandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.53",
            "verseOrgIds": [
              "JDG.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JDG 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe yeye wakabikila nsongalume, mutuadi wa ngabu wandi, wakamuambila ne, Tula muele webe wa nvita lubilu, unshihe; bantu kabambi ne, Mukashi wakamushiha. Nsongalume wandi wakamutua muele, yeye wakafua biandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.54",
            "verseOrgIds": [
              "JDG.9.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JDG 9:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatangila Bena Isalele ne, Abimeleke wakafua, bakaya muntu ku muaba wandi muntu ku muaba wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
            "verseOrgIds": [
              "JDG.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JDG 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Nzambi wakasombuela bubi bua Abimeleke buakenzeleye tatu wandi hakashiheye bana babo makumi muanda mutekete. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.56",
            "verseOrgIds": [
              "JDG.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JDG 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wakasombuela bena Shekeme kabidi bua malu mabi onso akenzabo; mulau wa Yotama, muana wa Yelubâla, wakabeleye wakalua ha mitu habo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.57",
            "verseOrgIds": [
              "JDG.9.57"
            ]
          }
        }
      ]
    }
