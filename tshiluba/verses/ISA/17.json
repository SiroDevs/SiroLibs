              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi misoko yabo yakadi ne bukole neyikale bu bikulu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
