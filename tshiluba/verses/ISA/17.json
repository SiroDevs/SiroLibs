              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi bantu nebatangile kudi Mufuki wabo, ne mesu abo neanemeke wa Tshijila wa Isalele. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabena batangila ku bioshelu, bintu bidi bianza biabo bienza, kabena banemeka bintu bidi minu yabo mienze, nansha bikalabi mitshi ya Bashela, nansha bikalabi mpingu ya kutendelela nʼai diba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
