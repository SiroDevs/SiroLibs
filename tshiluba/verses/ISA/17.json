            {
              "text": "17.9:",
              "type": "text"
            },
            {
              "text": "Tangila Yoshua 3.10; Nomba 21.24.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ne makolo bidi ha mikuna, misoko yakalekelabo hatuhu kudi bantu hakanyemabo ku mpala kua Bena Isalele; neyikale kabutu.",
          "type": "text",
          "attrs": {
