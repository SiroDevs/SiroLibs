              "EXO.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "EXO 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bonso bakenza bu muakambila Yehowa Mose ne Alona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "EXO 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dituku adi mene mene Yehowa wakumuka ne Bena Isalele mu Ejipitu ne bisumbu biabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.51",
            "verseOrgIds": [
              "EXO.12.51"
            ]
          }
        }
      ]
    }
