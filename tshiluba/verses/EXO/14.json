            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakatangila bualu bukole buakenzela Yehowa Bena Ejipitu, ne bantu bonso bakatshina Yehowa, bakeyemena Yehowa ne muntu wandi Mose.",
          "type": "text",
