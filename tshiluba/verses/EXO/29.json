          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.25",
            "verseOrgIds": [
              "EXO.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe newangate tshiadi tshia tshimpanga tshia kujidila kua Alona, utshinyukule bu mulambu udibo banyukula ku mpala kua Yehowa, netshikale tshituha tshiebe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.26",
            "verseOrgIds": [
              "EXO.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe neujidile tshiadi tshidibo banyukula, ne tshihela tshidibo babisha mulu tshia tshimpanga tshia kujidila kua Alona ne tshia bana bandi balume. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshintu etshi netshikale tshituha tshia Alona ne tshia bana bandi balume kudi Bena Isalele tshiendelele, bualu bua tshidi tshituha tshia bakuidi tshia mu mulambu ya kuvuisha nʼai ditalala ya Bena Isalele, tshidi mulambu udibo babisha mulu kudi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
