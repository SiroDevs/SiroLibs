        },
        {
          "text": "Wakenza mitshi ya acacia itanu ya kubuesha mu mabaya akadi ku luseke lumue lua nsubu wa tshitendelelu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
