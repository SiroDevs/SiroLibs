    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Davidi bakamulelelabo mu Hebelone: Amenona, muanʼa bute, muana wa Ahinoama, Muena Yizelele; muana muibidi Danyele, muana wa Abigayila, Muena Kâmele; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana muisatu Abashaloma, muana wa Mâka, muana wa bakashi wa Talemai, mukelenge wa mu Geshû; muana muinai Adoniya, muana wa Hagita; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muana muitanu Shefatiya, muana wa Abitala; muana muisambombo Itelema, muana wa mukashi wandi Egela: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakamulelela bana basambombo mu Hebelone kuakakokesheye bidimu muanda mutekete ne ngondo isambombo. Yeye wakakokesha mu Yelushalema bidimu makumi asatu ne bisatu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakamulelela mu Yelushalema: Shimea ne Shobaba ne Natana ne Solomo, bana banai kudi Bata-shua, muana wa bakashi wa Amiele, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Ibeha ne Elishama ne Elifelete ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Noga ne Nefege ne Yafia ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Elishama ne Eliada ne Elifelete, buonso buabo tshitema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.8",
            "verseOrgIds": [
              "1CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bonso mbana balume ba Davidi ha mutu ha bana balume ba bakashi bahika babakibue kudiye; Tamâ wakadi muanʼabo mukashi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muana wa balume wa Solomo wakadi Lehabama, Abiya wakadi muanʼandi, Asa wakadi muanʼandi, ne Yehoshafata wakadi muanʼandi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yolama wakadi muanʼandi, Ahazaya wakadi muanʼandi, ne Yoasha wakadi muanʼandi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasaya wakadi muanʼandi, ne Azaya wakadi muanʼandi, ne Yotama wakadi muanʼandi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaza wakadi muanʼandi, Hezikiya wakadi muanʼandi, ne Manashe wakadi muanʼandi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amona wakadi muanʼandi, ne Yoshiya wakadi muanʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.14",
            "verseOrgIds": [
              "1CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Yoshiya: Yohanana muanʼa bute wandi, Yehoyakima muana muibidi, Sedekiya muana muisatu ne Shaluma muana muinai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Yehoyakima: Yekoniya ne Sedekiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Yekoliya, muena lukanu: Shalatiele ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Malekilama ne Pedaya ne Shenasâ ne Yekamiya, Hoshama ne Nedabiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Pedaya: Zelubabela ne Shimei. Bana ba balume ba Zelubabela: Meshulama ne Hananiya; (Shelomita wakadi muanʼabo wa bakashi), ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashuba ne Ohela ne Belekiya ne Hasadeya ne Yushaba-heseda, buonso buabo batanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Hananiya: Pelatiya ne Yeshaya; muanʼandi wa balume Lefaya, muanʼandi wa balume Anana, muanʼandi wa balume Obadiya, muanʼandi wa balume Shekaniya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Shekaniya: Shemaya. Bana ba balume ba Shemaya: Hatusha ne Igala ne Baliya ne Nealiya ne Shafata, basambombo bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Nealiya: Eleyehoenai ne Hizikiya ne Azalikama, basatu bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Eleyehoenai: Hodawiya ne Eleyashiba ne Pelaya ne Akuba ne Yohanana ne Delaya ne Anani, muanda mutekete bonso.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
            "verseOrgIds": [
              "1CH.3.24"
            ]
          }
        }
      ]
    }
  ],
