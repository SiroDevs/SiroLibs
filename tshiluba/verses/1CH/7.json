            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Yafeleta: Pasaka ne Bimehala ne Ashawata. Aba mbana ba Yafeleta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
