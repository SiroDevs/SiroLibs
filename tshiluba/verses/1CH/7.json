          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Heleme, muanʼabo wa balume: Sofâ ne Yimena ne Sheleshe ne Amala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
