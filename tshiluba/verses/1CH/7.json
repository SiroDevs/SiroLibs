          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Beliya: Hebe ne Malekiele, wakadi tatu wa Bîzawita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
