              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Ashê: Yimena ne Yishewa ne Yishewi ne Beliya, ne Sela wakadi muanʼabo wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
