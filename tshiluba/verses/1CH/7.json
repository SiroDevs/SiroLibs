          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana ba balume ba Shemê: Ahi ne Loga ne Yehuba ne Alama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
