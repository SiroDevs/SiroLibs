          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebê wakalela Yafeleta ne Shomê ne Hotama, ne Shua wakadi muanʼabo wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
