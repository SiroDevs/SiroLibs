          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nshobo ya kumudilu wa Asafa yakakuata Yosefe; mibidi yakakuata Gedaliya; yeye ne bana babo bakadi dikumi ne babidi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.9",
            "verseOrgIds": [
              "1CH.25.9"
            ]
          }
        },
        {
