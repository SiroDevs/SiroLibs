  "verseCount": 56,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "LUK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahita tshituha tshihi, Yesu wakendakana mu bimenga ne mu misoko mikese, wambila bantu bualu bua Nzambi, wenda ne lumu luimpe lua bukelenge bua Nzambi; bayidi bandi dikumi ne babidi bakadi nʼandi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.1",
            "verseOrgIds": [
              "LUK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bakashi bakuabo bakumushileye nyuma mibi munda, bakashikisheye matekete abo: Malia wakadibo babikila ne Muena Magadala, bademon muanda mutekete bakumuka munda muandi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.2",
            "verseOrgIds": [
              "LUK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Yoana mukashi wa Kuza mulami wa bintu wa Helode, ne Susana ne bakuabo ba bungi, bakadi babakuatshisha ne bintu biabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.3",
            "verseOrgIds": [
              "LUK.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.3",
            "verseOrgIds": [
              "LUK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakunguila tshisumbu tshinene tshia bantu, kakalua ba mu misoko yonso kudiye, wakela lusumuinu ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.4",
            "verseOrgIds": [
              "LUK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumiaminyi wakaya bua kumiamina maminu andi; hakadiye umiamina, maminu makuabo akamata kukala kua nshila; bantu bakâdiata mu makasa, nyunyu ya mu diulu yakâzokola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.5",
            "verseOrgIds": [
              "LUK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuabo akamata ha dibue; hakatolokau, akafubidila, bualu bua kâkadi ne tshitelela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.6",
            "verseOrgIds": [
              "LUK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuabo akamata mu mionshi ya meba, mionshi yakadiunda nʼau, yakânyengela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.7",
            "verseOrgIds": [
              "LUK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuabo akamata mu buloba buimpe, akadiunda, akavudisha maminu makuabo lukama. Hakambeye malu â, wakela dî diandi bikole ne, Udi ne matshu unvue biandi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.8",
            "verseOrgIds": [
              "LUK.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.8",
            "verseOrgIds": [
              "LUK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayidi bandi bakamukonka bualu bua lusumuinu elu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.9",
            "verseOrgIds": [
              "LUK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakamba ne, Bakunuha bienu lungenyi lua kumanya malu a bukelenge bua Nzambi adi masokoka; kadi badi bambila bakuabo malu anu mu nsumuinu; nunku hamonabo, kabena bamona bimpe; hunvuabo, kabena bajingulula. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.10",
            "verseOrgIds": [
              "LUK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lusumuinu elu ludi nunku: Maminu adi dî dia Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.11",
            "verseOrgIds": [
              "LUK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba kukala kua nshila badi bantu bakunvua dî; hashishe, diabolo ulualua, udi unyenga dî mu mitshima yabo ne, Kabitabushi, kabasungidibu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.12",
            "verseOrgIds": [
              "LUK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba ha dibue badi bu bantu badi bitabusha dî ne disanka, hakudiunvuabo; kadi Bobo kabena ne miji, badi bitabusha tshituha, ku dituku dia diteta dia munda badi basesuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.13",
            "verseOrgIds": [
              "LUK.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au akamata mu mionshi ya meba adi bu bantu bakumpua dî; hatshidibo baya mu nshila, meshi abo ne biuma ne masanka a muoyo udibo nʼau katataka bidi bibafiekela mu nshingu, kabena bakuama maminu aboba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.14",
            "verseOrgIds": [
              "LUK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au a mu buloba buimpe adi bu bantu bakunvua dî mu mitshima mimpe ne ya kalolo, badi badilama bikole, badi bavudisha maminu bua dinanukila diabo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.15",
            "verseOrgIds": [
              "LUK.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.15",
            "verseOrgIds": [
              "LUK.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatemesha muntu muinda, yeye kena ûbuikila ne mushete, kena ûteka munshi mua bulalu; kadi yeye udi ûteka ha mesa a muinda, bua bonso badi babuela bamone dinkenka diau. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.16",
            "verseOrgIds": [
              "LUK.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kakuena bualu busokoka buahanga kusokolodibua; kakuena bualu bua mu musokoko buahanga kumanyibua ne kumueneka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.17",
            "verseOrgIds": [
              "LUK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dimukai munudi nunvua; bua udi ne bintu nebamuhe binga, kadi udi kai ne tshintu nebamunyenge tshidiye wela meshi ne, Ndi nʼatshi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.18",
            "verseOrgIds": [
              "LUK.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.18",
            "verseOrgIds": [
              "LUK.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mamu wandi ne bana babo bakalua kudiye, kabakamanya mua kulua ha buihi nʼandi bualu bua tshisumbu tshia bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.19",
            "verseOrgIds": [
              "LUK.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuambila ne, Mamu webe ne bana benu badi bimane ku bula, badi basue kukutangila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.20",
            "verseOrgIds": [
              "LUK.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakabandamuna ne, Mamuʼanyi ne bana betu badi anu bantu batu batelesha dî dia Nzambi, batu badienza.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.21",
            "verseOrgIds": [
              "LUK.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.21",
            "verseOrgIds": [
              "LUK.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dituku dikuabo yeye wakabuela mu buatu, yeye ne bayidi bandi; wakabambila ne, Tusabukai dishia dia dishiha; bakasemesha buatu mu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.22",
            "verseOrgIds": [
              "LUK.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo baya, yeye wakalala tulu; tshihuhu tshikole tshiakahueka ha dishiba; buatu buakamba kûla ne mai, bakamba kufua. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.23",
            "verseOrgIds": [
              "LUK.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalua kudiye, bakamubisha ku tulu, bakamba ne, Mukelenge, Mukelenge, tudi tufua. Yeye wakabika, wakabuikila luhehele ne mavuala; biakalekela, muaba au wakatalala talalâ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.24",
            "verseOrgIds": [
              "LUK.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakabakonka ne, Ditabusha dienu didi kudi kunyi? Bakadi ne buowa, bakakema, bakakonkangana ne, Ahu eu udi nganyi? Yeye udi wela mpehele ne mai dî diandi, bidi bimunvuila. Ku Gelasa Yesu udi umusha bademon munda mua mufitu ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.25",
            "verseOrgIds": [
              "LUK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakafika ku luseke lua Bena Gelasa, luakadi buludiludi ne Galela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.26",
            "verseOrgIds": [
              "LUK.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakasabukeye ku mpata, muntu wa mu musoko wakasangila nʼandi, wakadi ne bademon munda; tô musangu mule yeye kakadi uluata bilulu, kakadi ulala mu nsubu, anu mu majambu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.27",
            "verseOrgIds": [
              "LUK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamoneye Yesu, wakela dî diandi bikole, wakadihonena ku mpala kuandi, wakela dî diandi bikole ne, Ndi nʼebe bualu kai, wewe Yesu, Muana wa Nzambi Mutambe Bunene wa mu diulu? Ndi nkutendekena ne, Kunkengeshi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.28",
            "verseOrgIds": [
              "LUK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua wakadi wela mulamatshi dî ne, Hatuka munda mua muntu eu. Nyuma wa bukoya wakadi umukuata misangu ya bungi; bakadi bamusuika ne nkanu ne nkata; hakatshibuleye nkanu, demon wakadi umuihata mu bihela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.29",
            "verseOrgIds": [
              "LUK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakamukonka ne, Dina diebe nganyi? Wakamba ne, Legona, bualu bua bademon ba bungi bakadi munda muandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.30",
            "verseOrgIds": [
              "LUK.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamutendekena ne, Kutuambidi bua tuetu kuya mu dina didi kadî ne tshishikidilu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.31",
            "verseOrgIds": [
              "LUK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tshisumbu tshia ngulube ya bungi tshiakadiku idia mashinde ku mukuna; bakamutendekena ne, Itabusha bua tuetu kubuela munda muai. Yeye wakitabusha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.32",
            "verseOrgIds": [
              "LUK.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bademon bakaluhuka munda mua muntu, bakabuela munda mua ngulube; tshisumbu tshiai tshiakanyemena lubilu ku tshibungubungu, yakahona mu dishiba, yakafua mu mai. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.33",
            "verseOrgIds": [
              "LUK.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamona badishi bai bualu ebu, bakanyema, bakamba bualu ebu ku musoko ne mu luseke alu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.34",
            "verseOrgIds": [
              "LUK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakahatuka mu musoko bua kutangila bualu buakalua; bakalua kudi Yesu, bakasangana muntu wakahatuka bademon munda muandi mushikame ku makasa a Yesu, muluate bilulu, muikale ne lungenyi luimpe; bakatshina. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.35",
            "verseOrgIds": [
              "LUK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamonyi ba bualu abu bakabamanyisha muakusungilabo wakadi mukuatshike ne bademon. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.36",
            "verseOrgIds": [
              "LUK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso ba mu luseke lua Bena Gelasa bakamuambila ne, Umuka kutudi; bualu bua buowa bunene buakabakuata; wakabuela mu buatu, wakahingana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.37",
            "verseOrgIds": [
              "LUK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi muntu wakahatuka bademon munda muandi wakamutendekena ne, Ndi musue kuikala nʼebe; kadi Yesu wakamutuma ne, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.38",
            "verseOrgIds": [
              "LUK.8.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhingane ku nsubu kuebe, ubambile malu manene akukuenzela Nzambi. Yeye wakaya, wakamba malu manene akamuenzela Yesu mu musoko wonso.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.39",
            "verseOrgIds": [
              "LUK.8.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 8:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.39",
            "verseOrgIds": [
              "LUK.8.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 8:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakahingana Yesu, bantu ba bungi bakamusankidila, bualu bua bakadi bamuindile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.40",
            "verseOrgIds": [
              "LUK.8.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 8:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakalua, dina diandi Yailo, yeye wakadi mukelenge wa nsunagoga; wakadiela ku makasa a Yesu, wakamutendekena ne, Ulue mu nsubu wanyi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.41",
            "verseOrgIds": [
              "LUK.8.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 8:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua wakadi ne muana mukashi umuehele, wakadi bu bidimu dikumi ne bibidi; yeye wakamba kufua. Hakadiye wenda, bantu ba bungi bakamunguila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.42",
            "verseOrgIds": [
              "LUK.8.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 8:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukashi wakadiku, wakadi ne disama dia mashi ahatuka bidimu dikumi ne bibidi, wakafuta banganga buka bintu biandi bionso, kakuakadi muntu wakamanya mua kushikisha disama diandi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.43",
            "verseOrgIds": [
              "LUK.8.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 8:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "yeye wakalua ku nyima kua Yesu, wakalenga ku mubangu wa kazaku kandi; ha diba adi mene dihatuka dia mashi diakushika. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.44",
            "verseOrgIds": [
              "LUK.8.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 8:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakakonka ne, Wakundenga tshianza nganyi? Bakavila buonso buabo, Petelo ne bakuabo bakadi nʼandi bakamba ne, Mukelenge, bisumbu bia bantu bidi bikunguile, bidi bikutshintshimika. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.45",
            "verseOrgIds": [
              "LUK.8.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 8:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi Yesu wakamba ne, Muntu wakundenga tshianza; bualu bua nakudiunvua munda munda ne, Bukole buakuhatuka munda muanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.46",
            "verseOrgIds": [
              "LUK.8.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 8:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakamanya mukashi ne, Tshiena musokoma, wakalua uzakala, wakadiela ku mpala kuandi, wakamba ku mesu kua bantu bonso tshiakamulengeleye ne muakashika disama diandi ha diba adi mene. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.47",
            "verseOrgIds": [
              "LUK.8.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 8:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu wakamuambila ne, Muanʼanyi, ditabusha diebe diakukuhandisha, ya biebe talalâ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.48",
            "verseOrgIds": [
              "LUK.8.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 8:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadiye wamba nunku, muntu wakafuma ku nsubu wa mukelenge wa nsunagoga, wakamba ne, Muanʼebe udi mufue, kutatshishi Muyishi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.49",
            "verseOrgIds": [
              "LUK.8.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 8:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunvua Yesu dî diabo, wakamuambila ne, Kutshinyi, itabusha anu kuitabusha, nebamusungile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.50",
            "verseOrgIds": [
              "LUK.8.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 8:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakalueye ku nsubu, kakitabusha bua muntu mukuabo abuele nʼandi anu Petelo ne Yone ne Yakobo ne tatu wa muana ne mamu wandi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.51",
            "verseOrgIds": [
              "LUK.8.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 8:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonso bakadi badila, bakadi bamujinga; kadi yeye wakamba ne, Kanudidi; bualu bua yeye kena mufue, udi mulale tulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.52",
            "verseOrgIds": [
              "LUK.8.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 8:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakamuseka, bakamanya ne, Yeye udi mufue. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.53",
            "verseOrgIds": [
              "LUK.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi yeye wakamukuata ku tshianza, wakamubikila ne, Muana, bika. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.54",
            "verseOrgIds": [
              "LUK.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muoyo wandi wakahingana, wakabika lukasa; Yesu wakamba ne, Bamuhe bia kudia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.55",
            "verseOrgIds": [
              "LUK.8.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 8:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuledi bandi bakakema; kadi yeye wakabambila bikole ne, Kanuambidi muntu bualu buakuenjibua.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.8.56",
            "verseOrgIds": [
              "LUK.8.56"
            ]
          }
        }
      ]
    }
  ],
