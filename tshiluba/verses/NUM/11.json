          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakidika muaba au ne, Kibelota-hatawa, bualu bua bakajikamu bantu bakadi ne lukuka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.34",
