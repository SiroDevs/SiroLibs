          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakatshidi munyinyi mukana, diambedi bobo kabayi banze kûdia ku menu, tshiji tshiakakuata Yehowa bua bantu, ne Yehowa wakasamisha bantu bikole. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.33",
