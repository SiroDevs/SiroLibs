      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.1",
            "verseOrgIds": [
              "NUM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Hanualua mu buloba buenu, bundi munuhe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne hanuafila mulambu wa kuosha ha kahia kudi Yehowa bua kushikisha kuditshiha, anyi mulambu udi mitshima yenu misue kufila, anyi mu matuku anudi nudia bidia bia disanka, bualu bua kumusha dihembu kudi Yehowa, nansha mulambu wa ngombe nansha wa mikoko, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muntu udi ufila mulambu neafile mulambu wa bukula bubotesha bu tshintu tshia dikumi tshia tshihiminu tshimue, busangisha ne tshituha tshinai tshia dikoho",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15.4",
              "type": "text"
            },
            {
              "text": "Dî didi hin, litres 6",
              "type": "text"
            }
          ]
        },
        {
          "text": " dia manyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuafila mulambu wa kuosha anyi wa kudifila, nenufile kabidi tshituha tshinai tshia dikoho dia nvinyo bu mulambu udibo banua, nenufile nunku ku muana wa mukoko ne ku muana wa mukoko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuafila mulambu wa tshimpanga, nenulongolole tshintu tshitanu tshia bukula bubotesha busangisha ne tshituha tshisatu tshia dikoho dia manyi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne tshituha tshisatu tshia nvinyo bu mulambu udibo banua bua kûtuisha dihembu kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanualongolola mulume wa ngombe bu mulambu wa kuosha ha kahia anyi bu mulambu wa kushikisha kuditshiha anyi bu mulambu wa kuvuisha nʼau ditalala kudi Yehowa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.8",
            "verseOrgIds": [
              "NUM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebafile mulambu wa bukula bubotesha bu bituha bisatu bia ha dikumi busangisha ne tshituha tshia dikoho dia manyi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.9",
            "verseOrgIds": [
              "NUM.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebafile kabidi tshituha tshia dikoho dia nvinyo bu mulambu udibo banua, bu mulambu wa kuosha, bua kûtuisha dihembu kudi Yehowa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.10",
            "verseOrgIds": [
              "NUM.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuenze nunku kudi mulume wa ngombe yonso anyi kudi tshimpanga tshionso anyi kudi bana ba balume ba mikoko anyi kudi mbushi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.11",
            "verseOrgIds": [
              "NUM.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu bungi bua milambu mudi nu fila nenulongolole bintu ebi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.12",
            "verseOrgIds": [
              "NUM.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bantu bonso badi balela munkatshi muenu nebenze bilele ebi, hafilabo milambu ya kuosha ha kahia bu tshintu tshidi tshitua dihembu kudi Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikala muenyi mushikame munkatshi muenu, anyi muntu yonso muikale munkatshi muenu tô ne ku bikondo bienu bionso udi musue kufila mulambu wa kuosha ha kahia bu tshintu tshidi tshitua dihembu kudi Yehowa, yeye nênze bu munudi nuenza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua bantu bonso nebikale ne mukenji umue kunudi ne kudi muenyi udi munkatshi muenu ku bikondo bienu bionso: muenyi neikale bu nuenu ku mesu kua Yehowa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuikale ne mukenji umue ne dî dimue kunudi ne kudi muenyi udi munkatshi muenu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
    },
    {
