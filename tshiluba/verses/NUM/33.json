          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka ku Hô, bakashikama mu Salemona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 33:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Salemona, bakashikama mu Punona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 33:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Bimuna, bakashikama mu Oboto. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.43",
            "verseOrgIds": [
              "NUM.33.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 33:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Oboto, bakashikama mu Iye-habalima, ku luseke lua Bena Moaba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
            "verseOrgIds": [
              "NUM.33.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 33:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Iyima, bakashikama mu Dibona-gada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.45",
            "verseOrgIds": [
              "NUM.33.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 33:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Dibona-gada, bakashikama mu Alamona-dibelatayima. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
              "NUM.33.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 33:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Alamona-dibelatayima, bakashikama mu mikuna ya Abalama, mitangilangane ne Mukuna wa Nebo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 33:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka ku mikuna ya Abalima, bakashikama mu mpata ya Moaba hehi ne Yadene mitangilangane ne Yeleko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.48",
            "verseOrgIds": [
              "NUM.33.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashikama hehi ne Yadene, ku Bete-yishimota tô ne ku Abele-shitima, mu mpata ya Moaba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 33:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wakambila Mose mu mpata ya Moaba hehi ne Yadene mitangilangane ne Yeleko ne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambile Bena Isalele ne, Hanuasabuka Yadene mu buloba bua Kanâna, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenuihate bena buloba ebu bonso ku mpala kuenu, nushihe mpingu yabo ya mabue, ne mpingu yakatulabo ne tshiamu, ne miaba yabo ya kutendelela, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "nenunyenge buloba, nenushikamemu, bualu bua nakanuhabu bu buhianyi buenu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenuhiane buloba ku meku enu, hanuela nshobo, nenuhe bantu ba bungi buloba bua bungi, ne bantu bakese buloba bukese, biakuata nshobo muntu, buloba abu nebuikale buandi, nenuhiane buloba bu mulongo wa bisamba bia batatu benu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi binuahidia kuihata bena buloba ku mesu kuenu, bantu badi bashala nebikale bu tushingi mu mesu enu ne bu meba mu mbadi yenu, nebamatshishe mu buloba bunudi nushikama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nennuenzele bu munakelangana meji bua kubenzela bobo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
    }
