    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ei ngendu ya Bena Isalele hakaluhukabo mu buloba bua Ejipitu ku tshianza tshia Mose ne Alona bu muakadi bisumbu biabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.1",
            "verseOrgIds": [
              "NUM.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose wakafunda ngendu yabo bu mu dî dia Yehowa ei idi ngendu yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.2",
            "verseOrgIds": [
              "NUM.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabisha luendu luabo mu Lamesese mu dituku dia dikumi ne atanu dia ngondo wa kumudilu, ku nyima kua dituku dia kuhita kua Yehowa Bena Isalele bakumuka ku mesu kua Bena Ejipitu ne tshianza tshikole, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.3",
            "verseOrgIds": [
              "NUM.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakadi Bena Ejipitu bajika banʼa bute bakashihabo kudi Yehowa munkatshi muabo Yehowa wakalumbuluisha nzambi yabo kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.4",
            "verseOrgIds": [
              "NUM.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bena Isalele bakumuka mu Lamesese bakashikama mu Sukota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.5",
            "verseOrgIds": [
              "NUM.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Sukota, bakashikama mu Etama, udi ku butshika bua tshihela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.6",
            "verseOrgIds": [
              "NUM.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Etama bakahingana ku Pihahilota, udi ku mpala kua Bâla-sefona, bakashikama ku mpala kua Migedola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.7",
            "verseOrgIds": [
              "NUM.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Pihahilota, bakahita munkatshi mua dishiba dia mai bakaya mu tshihela bakaya luendu lua matuku asatu mu tshihela tshia Etama, bakashikama mu Mala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.8",
            "verseOrgIds": [
              "NUM.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Mala bakatua ku Elima mu Elima muakadi mpokolo ya mai dikumi ne ibidi ne mabue a ngashi makumi muanda mutekete bakashikamaku. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.9",
            "verseOrgIds": [
              "NUM.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Elima bakashikama hehi ne Dishiba Dikunze. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.10",
            "verseOrgIds": [
              "NUM.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka ku Dishiba Dikunze, bakashikama mu tshihela tshia Sina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.11",
            "verseOrgIds": [
              "NUM.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu tshihela tshia Sina, bakashikama mu Dofaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.12",
            "verseOrgIds": [
              "NUM.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Dofaka, bakashikama mu Alusha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.13",
            "verseOrgIds": [
              "NUM.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Alusha bakashikama mu Lefidima, ne bantu kabakadi ne mai a kunua. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.14",
            "verseOrgIds": [
              "NUM.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Lefidima bakashikama mu tshihela tshia Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.15",
            "verseOrgIds": [
              "NUM.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu tshihela tshia Sinai, bakashikama mu Kibelota hatawa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.16",
            "verseOrgIds": [
              "NUM.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Kibelota-hatawa bakashikama mu Haselota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.17",
            "verseOrgIds": [
              "NUM.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Haselota, bakashikama mu Litema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.18",
            "verseOrgIds": [
              "NUM.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Litema, bakashikama mu Limona-pelese. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.19",
            "verseOrgIds": [
              "NUM.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Limona-pelese, bakashikama mu Libina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.20",
            "verseOrgIds": [
              "NUM.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Libina, bakashikama mu Lisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.21",
            "verseOrgIds": [
              "NUM.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Lisa bakashikama mu Kehelata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.22",
            "verseOrgIds": [
              "NUM.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Kehelata, bakashikama ku mukuna wa Shefe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.23",
            "verseOrgIds": [
              "NUM.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka ku mukuna wa Shefe, bakashikama mu Halada. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.24",
            "verseOrgIds": [
              "NUM.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Halada bakashikama mu Makehelota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.25",
            "verseOrgIds": [
              "NUM.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Makehelota bakashikama mu Tahata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.26",
            "verseOrgIds": [
              "NUM.33.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Tahata, bakashikama mu Tela. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.27",
            "verseOrgIds": [
              "NUM.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Tela bakashikama mu Miteka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.28",
            "verseOrgIds": [
              "NUM.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Miteka, bakashikama mu Hashemona, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.29",
            "verseOrgIds": [
              "NUM.33.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Hashemona, bakashikama mu Moselota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.30",
            "verseOrgIds": [
              "NUM.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Moselota, bakashikama mu Bene-yâkana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.31",
            "verseOrgIds": [
              "NUM.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Bene-yâkana, bakashikama mu Ho-hadidegada ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.32",
            "verseOrgIds": [
              "NUM.33.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Ho-hadidegada, bakashikama mu Yotebata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.33",
            "verseOrgIds": [
              "NUM.33.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 33:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Yotebata, bakashikama mu Abalona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.34",
            "verseOrgIds": [
              "NUM.33.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 33:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Abalona, bakashikama mu Esione-gebê, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.35",
            "verseOrgIds": [
              "NUM.33.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 33:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Esione-gebê, bakashikama mu tshihela tshia Sina (dina dikuabo ne Kadesha). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
              "NUM.33.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 33:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakumuka mu Kadesha, bakashikama ku mukuna wa Hô, ku butshika bua buloba bua Edome.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
            "verseOrgIds": [
              "NUM.33.37"
            ]
          }
        }
      ]
    },
