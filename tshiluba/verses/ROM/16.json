          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Butumbi buikale kudi Nzambi, udi ne bukole bua kunujadika bu mudi lumu luimpe luanyi ne kuamba kuanyi kua Yesu Kilisto, bu mudi dibuluibua dia bualu busokoko buakadi buhuwishibue ku bikondo bia tshiendelele; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kadi katataka buakamueneshibua mu mifundu ya baprofete bu mudi mukenshi wa Nzambi wa tshiendelele; buakumanyishibua ku bisamba bionso bua ditumikila diabo mu ditabusha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Butumbi ebu buikale tshiendelele kudi Nzambi umuehele wa lungenyi, bualu bua Yesu Kilisto. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.27",
            "verseOrgIds": [
              "ROM.16.27"
            ]
          }
        }
      ]
    }
