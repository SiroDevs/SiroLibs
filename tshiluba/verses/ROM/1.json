          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakadi bûle tente ne malu onso adi kâi makane, ne malu mabi, ne kusaminangana kua mioyo, ne lukinu; bakadi bûle tente ne mukau, kushibangana, kutandangana, lubombo, lukuna; bena minunganu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "bena bunsonge, bena lukuna ne Nzambi, bena dikamakama, badisu, bafunyifunyi, babangi ba malu mabi mahia-mahia, bahidi ba mei a baledi babo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "bantu bakadi kabai ne meshi, bakadi kabai balama mei akahungabo, bakadi kabai ne dinanga bu dia bantu, bakadi kabai ne mitshima ya luse. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
