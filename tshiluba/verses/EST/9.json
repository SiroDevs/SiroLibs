          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatumina Bena Yuda bonso ba mu nseke ei lukama ne makumi abidi ne muanda mutekete ya mu bukelenge bua Ahashawelosha mikanda ya mei a ditalala ne a bushuwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
