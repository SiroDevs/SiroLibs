    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nyima kua malu â bakalekela mukelenge Ahashawelosha tshiji tshiandi, yeye wakavuluka Washeti ne bualu buakenzeye, ne bua mukenji wakeleye bualu buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe bantu bakadi bakuatshila mukelenge mudimu bakamuambila ne, Bakebele mukelenge bansongakashi balengele batshidi tumama; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukelenge asunguile tuhita tuandi mu nseke yonso ya bukelenge buandi bua bobo basangishe bansongakashi bonso balengele batshidi tumama mu nsubu wa mukelenge wa mu Shushana; babafile mu bianza bia Hegai, muntu mutungula wa mukelenge, mulami wa bakashi ba mukelenge, bashikame mu luhangu lua bakashi, babahe bintu bia kubalengesha nʼabi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsongakashi udi usankisha mutshima wa mukelenge ikale mukelenge mukashi mu muaba wa Washeti. Bualu ebu buakasankisha mutshima wa mukelenge; yeye wakenza nunku.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muena Yuda mukuabo wakadi mu nsubu wa mukelenge wa mu Shushana, dina diandi diakadi Môdekai, muana wa Yai, muana wa Shimei, muana wa Kishi, Muena Benyamina. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.5",
            "verseOrgIds": [
              "EST.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakafuma nʼandi mu Yelushalema ne bahika ne Yekonya, mukelenge wa Yuda, bakadi Nebukadenesâ, mukelenge wa Babulona, ulua nʼabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.6",
            "verseOrgIds": [
              "EST.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye wakadiundisha Hadasa, eu udi Esetê mene, muana wa mansebʼandi mu nsubu wandi, bualu bua yeye kakadi ne tatu ne mamu; nsongakashi eu wakadi mulengele muakane ku mesu; hakafua tatu wandi ne mamu wandi, Môdekai wakamuangata bu muanʼandi mukashi mene. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.7",
            "verseOrgIds": [
              "EST.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku hakunvuabo mukenji wa mukelenge ne dî diandi, ne hakasangishabo bansongakashi ba bungi mu nsubu wa mukelenge wa mu Shushana mu bianza bia Hegai, Esetê wakadi mufidibue mu nsubu wa mukelenge; bakamufila mu bianza bia Hegai, mulami wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.8",
            "verseOrgIds": [
              "EST.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsongakashi eu wakasankisha mutshima wandi, yeye wakasangana luse ku mesu kuandi; yeye wakamuha bintu bia kumulengesha nʼabi lubilu ne bansongakashi muanda mutekete basungula mu nsubu wa mukelenge bua kumukuatshila mudimu; yeye wakamuladika ne bansongakashi bandi muanda mutekete mu muaba wakatamba buakane mu nsubu wa bakashi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.9",
            "verseOrgIds": [
              "EST.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esetê kakanji kubamanyisha bua tshisamba tshiandi anyi bua bana babo; bualu bua Môdekai wakamuambila ne, Kubamanyishibi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.10",
            "verseOrgIds": [
              "EST.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Môdekai wakendenda ku luhangu lua bakashi ku dituku ku dituku bua kunvueye lumu lua Esetê ne malu akamukuata.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.11",
            "verseOrgIds": [
              "EST.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakakumbana tshikondo tshia nsongakashi ne nsongakashi kubuela kudi mukelenge Ahashawelosha, hakashikishabo kumuenzela bu muakadi mukenji bualu bua bakashi bua ngondo dikumi ne ibidi, (nunku matuku a kulengeshibua kuabo akashika; akadi nunku: ngondo isambombo bakabalengesha ne manyi a mula, ne ngondo isambombo bakabalengesha ne bintu bia dihembu dimpe ne bintu bikuabo bia kulengesha nʼabi bakashi); ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.12",
            "verseOrgIds": [
              "EST.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nunku nsongakashi ne nsongakashi wakabuela kudi mukelenge; bakamuha tshintu tshionso tshikasueye hakumukeye mu nsubu wa bakashi bua kuyeye mu nsubu wa mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.13",
            "verseOrgIds": [
              "EST.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu dilolo wakabuelamu, hakatshiabu yeye wakahingana mu nsubu muibidi wa bakashi mu bianza bia Shâshagaza, muntu mutungula wa mukelenge wakadi ulama bakashi bandi bahika bakabakeye; yeye kakadi ubuela kudi mukelenge kabidi bikala mukelenge kayi musanke bualu buandi, ne bikaleye kayi mumubikile mu dina.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.14",
            "verseOrgIds": [
              "EST.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakafika dituku dia Esetê, muana wa Abihayila, manseba wa Môdekai, wakangateye bu muanʼandi mukashi, kubuela kudi mukelenge, yeye kakalomba bintu bikuabo ha mutu ha bintu biakasungula Hegai, muntu mutungula wa mukelenge, mulami wa bakashi. Esetê wakasangana luse ku mesu kua bantu bonso bakamutangila. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.15",
            "verseOrgIds": [
              "EST.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku bakaya ne Esetê kudi mukelenge Ahashawelosha mu nsubu muandi mu ngondo wa dikumi, ngondo wa Tebeta, mu tshidimu tshia muanda mutekete tshia bukokeshi buandi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.16",
            "verseOrgIds": [
              "EST.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukelenge wakananga Esetê ku mutu kua bakashi bonso, yeye wakatamba bansongakashi bonso kusangana luse ku mesu kuandi; nunku yeye wakateka tshifulu tshia bukelenge ha mutu handi, wakamudisha mukelenge mukashi mu muaba wa Washeti. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.17",
            "verseOrgIds": [
              "EST.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku mukelenge wakalambishila bantu bandi banene bonso ne benji bandi ba mudimu bidia bia disanka dinene bua Esetê; yeye wakaha ba mu nseke yandi dikisha ne maha bu mudi bubanji bua mukelenge.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.18",
            "verseOrgIds": [
              "EST.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakasangishabo bansongakashi musangu muibidi, Môdekai wakadi mushikame ku tshibi tshia mukelenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.19",
            "verseOrgIds": [
              "EST.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esetê kakanza kumanyisha mukelenge tshisamba tshiandi ne bantu bandi bu muakamuambila Môdekai, bualu bua Esetê wakatumikila dî dia Môdekai bu muakenzeye hakadiye mudiundishibue kudiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.20",
            "verseOrgIds": [
              "EST.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu matuku au hakadi Môdekai mushikame ku tshibi tshia mukelenge, bantu batungula babidi ba mukelenge, Bigatana ne Teleshe, ba munkatshi mua balami ba ku tshibi, bakadi ne tshiji, bakakeba kushiha mukelenge Ahashawelosha. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.21",
            "verseOrgIds": [
              "EST.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu ebu buakamanyibua kudi Môdekai; yeye wakabuesha kudi Esetê, mukelenge mukashi; Esetê wakabuambila mukelenge mu dina dia Môdekai. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.22",
            "verseOrgIds": [
              "EST.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakadibo balumbulula, bakabusangana ne mbua bushuwa; bakabowa bubidi buabo ku mutshi umue; bakafunda bualu ebu mu mukanda wa kulondolola kua malu ku mpala kua mukelenge.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.23",
            "verseOrgIds": [
              "EST.2.23"
            ]
          }
        }
      ]
    }
  ],
