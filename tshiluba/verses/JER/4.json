              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.8",
            "verseOrgIds": [
              "JER.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Mu dituku adi mutshima wa mukelenge neufue, mitshima ya baminyampala neyifue kabidi; bakuidi nebakeme, baprofete nebatue mikemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.9",
            "verseOrgIds": [
              "JER.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe nakamba ne, Aka! Mukelenge Yehowa! Bulelela, wakudinga bantu aba ne ba mu Yelushalema bikole hawakamba ne, Nenuikale ne ditalala, kadi muele wa nvita udi ubatubula tô ne ku mioyo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu tshikondo atshi nebambile bantu aba ne ba mu Yelushalema ne, Luhehele ludi luosha ludi lufuma ku miaba ya hatuhu ya ha mutu ha mikuna ya mu tshihela, nelufike kudi muana mukashi wa bantu banyi, kaluyi luhehula, kaluyi lutokesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luhehele lutambe bukole bua kuenza nunku nelulue bua bualu buanyi; mpindiu meme kabidi nembalumbuluishe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    }
