            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yehowa udi wamhila ba mu Yuda ne ba mu Yelushalema ne,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.3",
            "verseOrgIds": [
              "JER.4.3"
            ]
          }
        }
