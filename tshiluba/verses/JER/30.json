          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi ndî dia kudi Yehowa diakalua kudi Yelemiya ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa, Nzambi wa Isalele, udi wamba ne, Fundai mei onso anakukuambila mu mukanda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Yehowa udi wamba ne, Mu matuku alualua nenkudimune buhika bua bantu banyi Bena Isalele ne Bena Yuda, nembahingashe mu buloba bunakaha batatu babo, ne bobo nebikale nʼabu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mmei akamba Yehowa bualu bua Bena Isalele ne Bena Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
