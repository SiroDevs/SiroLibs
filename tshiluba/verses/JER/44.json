        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 44:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dî diakalua kudi Yelemiya bua Bena Yuda bonso bakadi bashikama mu buloba bua Ejipitu, mu Migedola, mu Tapanehese, mu Mempi ne mu luseke lua Patelosa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.1",
            "verseOrgIds": [
              "JER.44.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 44:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diakamba ne, Yehowa wa misumba, Nzambi wa Isalele, udi Wamba ne, Nuakutangila makenga onso anakutumina ba mu Yelushalema ne ba mu misoko yonso ya mu Yuda; monai, lelu eu misoko ei idi bikulu, ne kakuena muntu udi mushikamemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.2",
            "verseOrgIds": [
              "JER.44.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 44:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bualu bua malu mabi abo akenzabo bua kunkuatshishabo tshiji, hakayabo kuosha musenga wa manananshi ne kutendelelabo nzambi mikuabo yakadibo kabayi bamanye, nansha bobo nansha nuenu nansha batatu benu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.3",
            "verseOrgIds": [
              "JER.44.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 44:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi nakanutumina bena mudimu banyi bonso baprofete, njuka hanyi ne lunkelu bua kubatuma, ngamba hanyi ne, Kanuenji bualu ebu budi bunfuisha bundu, bundi nkina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.4",
            "verseOrgIds": [
              "JER.44.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 44:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi kabakunvua, kabakateleja matshu bua kukudimunabo mitshima yabo ku bubi buabo, bua kulekela kuoshila nzambi mikuabo musenga wa manananshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.5",
            "verseOrgIds": [
              "JER.44.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 44:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nakakuatshika tshiji tshikole ne tshifikʼa munda ne biakatema mu misoko ya mu Yuda ne mu misesu ya Yelushalema, ne yakanyanguka ne yakabutuka bu mudibi lelu eu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.6",
            "verseOrgIds": [
              "JER.44.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 44:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yehowa, Nzambi wa misumba, Nzambi wa Isalele, udi wamba mpindiu ne, Nudi nuenzela mioyo yenu mene bualu bubi, bua meme kunûmushila balume ne bakashi, muana mukese ne muana utshidi wamua mabele, munkatshi mua Bena Yuda, tshiyi nnushila muntu umue, bua tshinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.7",
            "verseOrgIds": [
              "JER.44.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 44:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu kai nuenu nuakunkuatshisha tshiji ku bintu binudi nuenza ne bianza bienu, hanuoshila nzambi mikuabo musenga wa manananshi mu buloba bua Ejipitu, munuakuya bua kushikama; bua nuenu kudifuisha ne bua kudivuisha tshintu tshidibo bahenda ne bahetula munkatshi mua bisamba bionso bia ha buloba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.8",
            "verseOrgIds": [
              "JER.44.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 44:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuakuhua muoyo bua malu mabi a batatu benu, bua malu mabi a banfumu ba Yuda, bua malu mabi a bakashi babo, bua malu mabi enu mene ne bua malu mabi a bakashi benu, akenzabo mu buloba bua Yuda ne mu misesu ya Yelushalema, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.9",
            "verseOrgIds": [
              "JER.44.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabena banji kudihuekesha tô ne ku dituku edi, kabena banji kutshina, kabena banji kuenda mu mikenji yanyi anyi mu mayisha anyi, binakuteka ku mpala kuenu ne kua batatu benu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 44:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.10",
            "verseOrgIds": [
              "JER.44.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 44:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku Yehowa wa misumba, Nzambi wa Isalele, udi wamba ne, Monai, nentangishe mpala wanyi kunudi bua kunuenzela bibi, bua kubutula bonso ba mu Yuda mene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.11",
            "verseOrgIds": [
              "JER.44.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 44:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nengangate bantu ba mu Yuda batshidi bashala bakutangisha mpala yabo bua kuya ku Ejipitu bua kushikamaku, buonso buabo nebabutudibue; nebashihibue mu buloba bua Ejipitu; nebashihibue ku muele wa nvita ne ku tshiole; nebafue, kudi udi mutambe kuhuekela tô ne kudi udi mutambe bunene, nebafue ku muele wa nvita ne ku tshiole; nebikale bu tshintu tshidibo bahenda ne tshidi tshikuatshisha buowa, tshidibo bela mulau ne bahetula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.12",
            "verseOrgIds": [
              "JER.44.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 44:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenkengeshe badi bashikame mu buloba bua Ejipitu, bu munakakengesha ba mu Yelushalema, ne muele wa nvita, tshiole ne tshihuhu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.13",
            "verseOrgIds": [
              "JER.44.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua kakuikadi umue wa ba mu Yuda badi bashala bakuya mu buloba bua Ejipitu bua kushikamamu wahanduka anyi washala bua kuhinganeye ku buloba bua Yuda kudibo bajinga bua kuhingana ne kushikama. Bualu bua kakuena bakuabo bahingana, anu bantu banya-banya badi banyema.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 44:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.14",
            "verseOrgIds": [
              "JER.44.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 44:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe balume bonso bakadi bamanye bua bakashi babo ne, Badi boshila nzambi mikuabo musenga wa manananshi, ne bakashi bonso bakadi bimana ha buihi, bantu aba mene bakadi bashikama mu buloba bua Ejipitu ne mu Patelosa, ntshisumbu tshinene mene, bakakudimuna Yelemiya dî ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 44:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tudi tuamba bua dî diebe diwakutuambila mu dina dia Yehowa ne, Katuena tukunvuila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.16",
            "verseOrgIds": [
              "JER.44.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bulelela, netuenze mei onso akumana kuhatuka mukana muetu bua kuoshila mukelenge mukashi wa mu diulu musenga wa manananshi ne bua kumuhongoluela milambu ya bia kunua, bu mutuakuenza mu misoko ya Yuda ne misesu ya Yelushalema, ne tuetu ne batatu betu ne banfumu betu ne baminyampala betu. Bua mu tshikondo atshi tuakadi ne bintu bia kudia bikumbane, tuakadi ne diakalengele, katuakamona dikenga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.17",
            "verseOrgIds": [
              "JER.44.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi katshia tualekela kuoshila mukelenge mukashi wa mu diulu musenga wa manananshi ne kumuhongoluela milambu ya Dia kunua, tuakukengela bintu bionso, tuakufua ku muele wa nvita ne ku tshiole. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.18",
            "verseOrgIds": [
              "JER.44.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakashi bakamba ne, Hatuakadi tuoshila mukelenge mukashi wa mu diulu musenga wa manananshi, hatuakadi tumuhongoluela milambu ya bia kunua, hatuakamuambila mikata yakadi ne tshifuanyikishi tshiandi tshifundahu, hatuakamuhongoluela milambu ya bia kunua, katuakadi ne babayetu, anyi?",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.19",
            "verseOrgIds": [
              "JER.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 44:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.19",
            "verseOrgIds": [
              "JER.44.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 44:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashishe Yelemiya wakambila bantu aba bonso, ne balume ne bakashi, bantu aba bonso mene bakadi bamukudimuna dî adi ne, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.20",
            "verseOrgIds": [
              "JER.44.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 44:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa kakavuluka musenga wa manananshi unuakosha mu misoko ya Yuda ne mu misesu ya Yelushalema, nuenu ne batatuʼenu, banfumu benu ne baminyampala benu, ne bantu ba mu buloba buenu, anyi? Malu â kakadi mu mutshima wandi, anyi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.21",
            "verseOrgIds": [
              "JER.44.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 44:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa kakamanya mua kuitabusha kabidi bienzedi bienu bibi ne malu enu manyanguke. Bua bualu ebu buloba buenu buakulua bikulu, budi bukuatshisha buowa kudi bakuabo, budi ne mulau, kabuyi ne bantu bu mudibu dituku edi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
              "JER.44.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makenga â akunukuata, atudi tumona lelu, bualu bua nuakuoshila nzambi mikuabo musenga wa manananshi, ne nuakuenzela Yehowa bibi, kanuakutumikila dî dia Yehowa, kanuakuenda mu mikenji yandi, mu mei andi majalame ne mu mikenji idi ilesha bu mudiye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 44:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yelemiya wakambila bantu bonso ne bakashi bonso kabidi ne, Unvuai di dia Yehowa, nuenu Bena Yuda bonso badi mu buloba bua Ejipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa wa misumba, Nzambi wa Isalele, udi wamba ne, Nuenu ne bakashi benu nuakuamba mei â onso mukana muenu, nuakuênza ne bianza bienu, nuamba ne, Bulelela, netushikishe mitshihu yetu ituakuditshiha, bua kuoshila mukelenge mukashi wa mu diulu musenga wa manananshi ne bua kumuhongoluela milambu ya bia kunua. Nunku nuenze bu munuakuditshiha, nushikishe mitshihu yenu! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku unvuai dî dia Yehowa, nuenu ba mu Yuda badi bashikame mu buloba bua Ejipitu! Yehowa udi wamba ne, Monai, meme nakuditshiha mu dina dianyi dinene ne, Kabena batela dina dianyi kabidi mukana mua muntu munkatshi mua Bena Yuda badi mu buloba buonso bua Ejipitu, wamba ne, Bu mudi Mukelenge Yehowa ne muoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monai, ndi mbatangila bua kubenzela bibi, kembua kubenzela bimpe. Bena Yuda bonso badi bashikame mu buloba bua Ejipitu nebashihibue ku muele wa nvita ne ku tshiole, tô ne hanabamana bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 44:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Badi bahanduka ku muele wa nvita nebaluhuke mu buloba bua Ejipitu bua kuhingana ku buloba bua Yuda, anu bantu banya-banya mene. Bonso ba mu Yuda batshidi bashala bakaya mu buloba bua Ejipitu bua kushikamamu nebamanye dî didi dijalame bushuwa, ne ndî dianyi, anyi ndî diabo! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.28",
            "verseOrgIds": [
              "JER.44.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 44:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Etshi ntshimanyinu tshindi nnulesha ne nennukengeshe mu muaba eu, bua nuenu numanye ne mei anakuamba ne, Nennuenzele bibi, neajalame bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.29",
            "verseOrgIds": [
              "JER.44.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 44:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowa udi wamba ne, Nenfile Palô Hofela, mukelenge wa Ejipitu, mu bianza bia bena lukuna bandi, mu bianza bia badi bakeba muoyo wandi, bu munakufila Sedekiya, mukelenge wa Yuda, mu bianza bia Nebukadenesâ, mukelenge wa Babulona, wakadi muena lukuna wandi ne wakadi ukeba muoyo wandi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.30",
            "verseOrgIds": [
              "JER.44.30"
            ]
          }
        }
      ]
    }
