            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biabengabo kuangata luhanza ku tshianza tshiebe bua kulunuabo, ka neubambile ne, Yehowa wa misumba udi wamba ne, Nenulunue bulelela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
