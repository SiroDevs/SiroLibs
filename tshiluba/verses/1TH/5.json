  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1TH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi bana betu, bua bikondo ne bidimu kanuena ne bualu bua muanda wabi ufundibue kunudi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua nuenu nkayenu nudi bamanye bimpe ne, Dituku dia Mukelenge dilualua bu mudi muibi ulua butuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatshidibo bamba ne, Tudi ne ditalala, katui ne bualu; ahu dibutuka dia tshintuluntulu dilualua kudibo, bu mudi kanyinganyinga kalua kudi mukashi udi ne difu; ne bobo kabena bahanduka nasha kakese. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi nuenu bana betu, kanuena mu midima bua dituku adi dinukuate bu muibi; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua buonso buenu nudi bana ba munya ne bana ba dituku, katuena ba butuku anyi ba midima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku katuladi tulu bu mudi bakuabo benza; kadi tutabale, tuikale ne meshi mahole. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bua badi balala tulu badi balala tulu butuku; ne badi bakuatshika maluvu badi bakuatshika butuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tuetu, bualu bua tudi ba dituku, tuikale ne meshi mahole; tuluate tshibuikilu tshia ha tshiadi tshia ditabusha ne tshia dinanga, tuluate ditekemena dia luhandu bu tshifulu ku mutu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bualu bua Nzambi kakatusungula bua kutulekela tshishi, kadi bua tuetu kuheta luhandu bualu bua Mukelenge wetu Yesu Kilisto, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakatufuka, bua tuetu, nasha batabale nasha balale tulu, tuikale ne muoyo hohamue nʼandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nunku nusambangane, nudiundishangane muntu ne muntu, bu munudi nuenza kabidi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kadi tudi tunulomba, bana betu, bua nuenu mimanye badi benza mudimu munkatshi muenu ne badi ku mutu kuenu mu Mukelenge ne badi banudimusha; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.12",
            "verseOrgIds": [
              "1TH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bua nuenu nubabale bu banudi nutamba kutumbisha mu dinanga bua mudimu wabo. Nuikalangane ne ditalala munkatshi muenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.13",
            "verseOrgIds": [
              "1TH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, tudi tunusengelela ne, Nudimushe batshimbakanyi, nukoleshe badi ne mitshima yamba kuhanga, nukuatshishe badi batekete, nuikale ne lutulu kudi bantu bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numone ne muntu kahingishidi mukuabo bubi ku bubi buandi; kadi misangu yonso nulondelangane malu adi mimpe muntu ne muntu, ne kudi bonso. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.15",
            "verseOrgIds": [
              "1TH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nusanke misangu yonso; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.16",
            "verseOrgIds": [
              "1TH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuikale nutendelelatendelele; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.17",
            "verseOrgIds": [
              "1TH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu malu onso nusakidile Nzambi, bua edi ndisua dia Nzambi mu Kilisto Yesu bua bualu buenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.18",
            "verseOrgIds": [
              "1TH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanujimi Nyuma Muimpe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.19",
            "verseOrgIds": [
              "1TH.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanuhetudi mayisha a baprofete. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.20",
            "verseOrgIds": [
              "1TH.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1TH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nujingulule malu onso; nulamate malu adi mimpe; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.21",
            "verseOrgIds": [
              "1TH.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuehuke ku malu mabi a mushindu wonso.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1TH 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.22",
            "verseOrgIds": [
              "1TH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1TH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi wa ditalala nkayandi anujidile tshishiki; ne nyuma yenu ne misûke yenu ne mibidi yenu ilamibue mu buakane buonso, kanui ne kudiu, mu dilu? dia Mukelenge wetu Yesu Kilisto. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeye udi unubikila udi mua kueyemenyibua, yeye kabidi nênze buala budiye munubikidile.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana betu, nundombele Nzambi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1TH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuele bana betu bonso ba mu Kilisto muoyo ne kutuangana kua mishiku kua tshijila. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.26",
            "verseOrgIds": [
              "1TH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1TH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nutshihisha mu Mukelenge bua babadile bana betu bonso ba mu Kilisto mutanda eu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.27",
            "verseOrgIds": [
              "1TH.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1TH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.27",
            "verseOrgIds": [
              "1TH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1TH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasa wa Mukelenge wetu Yesu Kilisto ikale nʼenu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.28",
            "verseOrgIds": [
              "1TH.5.28"
            ]
          }
        }
      ]
    }
