  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "GEN 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat A-bɛ-ram kɛ Kɛ-tu-ra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ A-bɛ-ram cɛ rɔ nyɔk kɛ kue̱n kɛ ciek mi cɔal i̱ Kɛ-tu-ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ciek ɛmɔ di̱eth gaat ti̱ti̱, Dhim-ran kɛ Yɔk-can kɛ Mɛ-dhan kɛnɛ Mid-yan kɛ Ic-bak kɛnɛ Cua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yɔk-can gaat rɛw di̱eth ti tɔ̱ Cɛba kɛnɛ Dɛ-dan. Cu gaat Dɛ-dan a A-cu-rim kɛ Lɛ-tu-cim kɛnɛ Lɛ-u-mim. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gaat Mid-yan a, Eepa kɛnɛ E-pɛr kɛ Ä-nok kɛnɛ Ä-bi-dhä kɛ Ɛ-la-da. Tɔ̱tɔ̱ kɛn diaal kɛ gaat Kɛ-tu-ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu A-bɛ-ram kuakɛ diaal ka̱m gatdɛ ni Ay-dhɛk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ŋot A-bɛ-ram kɛ tëk, cuɛ gaat luɔɔmnikɛ moc kɛ muc, kä cuɛ kɛ tuk, kɛ ɣöö bikɛ na̱n kɛ Ay-dhɛk. Kä cukɛ wä kui̱ rööl känyä ca̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ A-bɛ-ram kɛnɛ kuɔ̱nydɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu run te̱e̱kä A-bɛ-ram diaal a run ti kuɔ̱r kɛl wi̱cdɛ jiɛn bärɔw wi̱cdɛ dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ cu li̱w a ro̱ŋ lɔcdɛ rɛy te̱e̱kä mi bäär. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gaatkɛ da̱ŋ rɛw Ay-dhɛk kɛnɛ I-ca-mel jɛ kony kɔ̱k Mak-pe-la mëë te rɛy kakä Ɛp-rɔn gat Dho-ɣar raan Ɣɛ̈th. Ɛ jɛn kak ëë thiëëk kɛ Ma-mɛ-ri, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë kɔk A-bɛ-ram ɛ nhiam gan Ɣɛ̈th, kä ɛ jɛn gua̱a̱th ëë ca ciek A-bɛ-ram ni Thara kɔŋ kony thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr li̱eth A-bɛ-ram cu Kuoth Nhial Ay-dhɛk poth kä cuɛ cu ciɛŋ ni Beer-laa-rɔy.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat I-ca-mel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liɛŋɛ jɛ täämɛ, ti̱ti̱ kɛ gaat I-ca-mel gat A-bɛ-ram ëë da̱pkɛ jɛ ɛ nya rööl I-jëp ni A-gar, jɛn nyam ëë mɔ läät Thara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.12",
            "verseOrgIds": [
              "GEN.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn pe̱k ciöötni gan I-ca-mel a ca kɛ guir ni guɔ̱ɔ̱ri. Nɛ-ba-yɔth ɛ jɛn gatdɛ min kɛ̱̈ɛ̱̈, cu dämani a Ke-dhar kɛ Adh-beel kɛ Mi-ba-tham ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Mic-mä kɛ Dhuma kɛ Mathɔ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.14",
            "verseOrgIds": [
              "GEN.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ A-dad kɛ Teemɔ kɛ Yɛ-tur kɛ Na-pic kɛnɛ Kedh-ma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tɔ̱tɔ̱ kɛ kɛn ciööt kua̱ri thuk duëli gan I-ca-mel da̱ŋ wäl rɛw rɛy ciëëŋikiɛn kɛnɛ dho̱rkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.16",
            "verseOrgIds": [
              "GEN.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mëë li̱w I-ca-mel, runkɛ kɛ run ti kuɔ̱r kɛl wi̱cdɛ jiɛn diɔ̱k wi̱cdɛn bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛn thuk duëli gan I-ca-mel cukɛ ciɛŋ ni ro̱l in te kam Ä-wi-la kɛnɛ Cur ke̱th rööl I-jëp lotdä A-thi-ri-ya. Kä cukɛ cieŋ tiilä kamnikiɛn kɛ dämanikiɛn diaal.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Da̱p E-thɔ kɛnɛ Je-kɔb",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ti̱ti̱ kɛ gaat Ay-dhɛk gat ëë ci A-bɛ-ram ɛ di̱eth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn runkɛ kɛ run ti jiɛn ŋuaan guäth ëë kuɛnɛ Rɛ-bɛ-ka nya Bä-thu-ɛl raan rööl Ä-ram rɛɛk Pa-dan-a-ram, Rɛ-bɛ-ka ɛmɔ ɛ jɛn nyiman La-ban. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.20",
            "verseOrgIds": [
              "GEN.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ay-dhɛk ciekdɛ jääny a thil gat, kɛ kui̱c ɛmɔ cuɛ Kuoth Nhial thi̱ec kɛ kui̱dɛ. Mëë cɛ jɛ thi̱ec, cu Kuoth Nhial palɛ liŋ, kä cu Rɛ-bɛ-ka ruët. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cɛ ruët, nɛ̈nɛ jɛ, cu gaat dhuɔ̱ɔ̱r ɛlɔ̱ŋ jiidɛ. Kä cuɛ thi̱ec i̱, “Ɛŋu tuɔɔk nɛmɛ kä ɣä mɔ?” Kɛ kui̱ ɛmɔ cuɛ go̱r ni ɣöö bɛ jɛ thi̱ec kä Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɛ loc i̱,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci päth rue̱tädɛ thuɔ̱k, cuɛ dap kɛ cuɛ̈ɛ̈k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min ci gat in nhiam käny raar, tithɛ ɛ cuät, kä puɔ̱nydɛ ni kɛɛliw kɛ mi̱em. Ɛ jɛ nɔ, cukɛ ciötdɛ cɔl i̱ E-thɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci gat in jio̱l ben raar, cua jɛ guɔ̱ɔ̱r ɛ däman a käpɛ ŋul cio̱kädɛ lɛɛr, kä cua ciötdɛ cɔl i̱ Je-kɔb. Mëë dapkɛ kɛ, ɛn guäth ɛmɔ Ay-dhɛk runkɛ kɛ run ti jiɛn bäkɛl ɛgi̱m.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
