  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "GEN 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rial Je-kɔb kɛ rɔ ikä kɛ röm E-thɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ min tɛth Je-kɔb piny wëë jälɛ, cuɛ röm kɛ ja̱a̱k Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niɛ min cɛ kɛ nɛn cuɛ wee i̱, “Nɛmɛ ɛ buɔ̱n ji̱ Kuɔth.” Cuɛ gua̱a̱th ɛmɔ cɔl i̱ Ma-na-yim (min lot ni ɣöö bua̱a̱n da̱ŋ rɛw).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ɛn wa̱a̱ni cu Je-kɔb naath ja̱k kɛ ɣöö bikɛ däman ni E-thɔ wä la̱r lär kɛ nhiam ro̱o̱l päämni Ɛ-dɔm min te rɛy rööl ji̱ Ɛ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.3",
            "verseOrgIds": [
              "GEN.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ la̱r kɛ ɛn ɣöö wiaa jiökɛ kuäärä ni E-thɔ i̱, “Ci kuanydu ni Je-kɔb ɛ lar i̱, ‘Ɛn runi ti̱ti̱ diaal cä wä cieŋ kɛɛl kɔnɛ La-ban. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cä rɔ jek ɣɔ̱k kɛ muɔ̱li kɛnɛ det kɛ kuaany wutni kɛnɛ kuaany mään. Kä nöŋä ji̱ thok ɛmɛ kɛ ɣöö de̱ri ɣä cu lor kɛ tɛ̈th lɔaac.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mëë ci nɛy tëë ca ja̱k luny kä jɛ, cukɛ jɛ ben jiök i̱, “Kɔn cakɔ cop kä dämuɔɔr ni E-thɔ kä cɛ ku thuŋ te̱nh piny kɛ ɣöö bɛ ji̱ ben lor, kä jälɛ kɛɛl kɛ wutni ti kur ŋuaan.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu Je-kɔb dual ɛlɔ̱ŋ kä cu ca̱rɛ nyuɔɔn. Kä min guicɛ jɛ inɔ kɛn nɛy tëë tekɛ jɛ kɛɛl, kɛ det kɛ ɣɔ̱k kɛnɛ thɔ̱a̱rɔa̱a̱li, cuɛ kɛ dääk ni bua̱a̱n da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn i̱, “Mi wä E-thɔ wä ben kä bɛ buɔ̱n kɛl ben mak piny kɛ ko̱r, bi buɔ̱n in dɔ̱ŋ rɔ le̱ny.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ cu pal wëë i̱, “Aɣ Kuoth Nhial, Kuoth gua̱a̱dɔɔŋ ni A-bɛ-ram, Kuoth gua̱a̱r ni Ay-dhɛk, ji̱n Kuoth ëë jio̱k ɣä i̱, ‘Locni ro̱o̱lu kɛnɛ watku kä bä nyinku diaal jak kä ro̱ŋ,’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɣän /cä ro̱ŋ kɛ kɛn tin diaal tin ci nyuth ni ɣä kɔ̱a̱c lɔaacdu min thil pe̱k. Ɣän mëë jiathä kir Jɔr-dɛn, te ni kɛɛt tetädä, kä ɛn täämɛ cä la bua̱a̱n da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kän ɣä kä dämaar ni E-thɔ dualä kɛ ɣöö bɛ kɔ mak kɛ ko̱r a /cɛ män bi päl kiɛ gaatkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lar ɛ ji̱n i̱, ‘Bi nyinkä diaal jak kä ro̱ŋ kä bi kuaykä jak kä ŋuan ce̱tnikɛ liɛt yiëër in /ca dëë luäŋ kɛ kuën.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn wäär ɛmɔ cuɛ niɛɛn ɛn wa̱nɔ. Kä cuɛ däman ni E-thɔ li̱ny ikä rɛy ɣɔ̱ɔ̱kɛ ala muc ti ba nöŋ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.13",
            "verseOrgIds": [
              "GEN.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ li̱eny ŋut de̱e̱t böwni ti kur da̱ŋ rɛw, kɛ tutkiɛn ti jiɛn da̱ŋ rɛw, ŋut de̱e̱t ti rɔɔm ti kur da̱ŋ rɛw, kɛnɛ tutkiɛn ti jiɛn da̱ŋ rɛw, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.14",
            "verseOrgIds": [
              "GEN.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "thɔ̱a̱rɔa̱a̱li ti jiɛn da̱ŋ diɔ̱k ti la̱a̱r kɛ dɛykiɛn kɛɛl, ɣɔ̱k ti jiɛn da̱ŋ ŋuaan kɛ tutkiɛn da̱ŋ wäl, ŋut muɔ̱li ti jiɛn da̱ŋ rɛw kɛnɛ tutkiɛn da̱ŋ wäl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.15",
            "verseOrgIds": [
              "GEN.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ la̱th tetni kuaanynikɛ, däkɛ kɛ kä bua̱a̱ni, kä cuɛ kɛ ku jiök i̱, “Yɛn wiaa nhiam lɛɛr ɔ kä a buɔ̱n ɔ tekɛ kam kɛ buɔ̱n ɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.16",
            "verseOrgIds": [
              "GEN.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kuanydɛ min nhiam jiök i̱, “Mi wä dämaar ni E-thɔ wä röm kɛ ji̱, kä thieecɛ ji̱ i̱, ‘Kuääru ŋa? Kä wi̱i̱ nikä? Kä ɣöth ɛmɛ ɛ duŋ ŋa?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.17",
            "verseOrgIds": [
              "GEN.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Larɛ i̱, ‘Ɛ duŋ kuanyädu ni Je-kɔb. Ɛ muc mi cɛ jäk kä kuäärä ni E-thɔ. Kä ɛn Je-kɔb puɔ̱nydɛ pa̱ny jɛn a guur kɔ ni.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.18",
            "verseOrgIds": [
              "GEN.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kuanydɛ min rɛwdɛ kɛnɛ min diɔ̱ɔ̱kdiɛn kɛ nɛy tin kɔ̱kiɛn lɛni jiök bä i̱, “Mi wiaa wä röm kɛ E-thɔ, jiökɛ jɛ i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.19",
            "verseOrgIds": [
              "GEN.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Kuanydu ni Je-kɔb puɔ̱nydɛ jɛn a guur kɔ ni.’ ” Kɛ ɣöö carɛ Je-kɔb ɛ kɛ lɔcdɛ i̱, “Ɣän bä lɔcdɛ yi̱eny kɛ muc ti bi kɔŋ cop ni kɛn kä jɛ, kä mi wakɔ wä jek dɔ̱ŋ bɛ ɣä lor kɛ tɛ̈th lɔaac.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.20",
            "verseOrgIds": [
              "GEN.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä nɔmɔ cuɛ muc jak kä wä nhiam, guäth in cuɛ niɛɛn guäth ëë cɛ pua̱t thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Je-kɔb Kɛnɛ jääk Kuɔth kä Pɛ-nu-el",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kɛ jɛn wäär ɛmɔ pa̱ny cu Je-kɔb rɔ jiɛc kɛnɛ mänkɛ kɛ kuaany määnkɛ da̱ŋ rɛw kɛ gaatkɛ da̱ŋ wäl wi̱cdiɛn kɛl. Cuɛ jiɛth kɛ thok waath Ya-bɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.22",
            "verseOrgIds": [
              "GEN.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ji̱ gɔaalɛ jäk kä kui̱c yiëër kɛɛl kɛ ŋɔakɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ cu duɔth kui̱c yiëër kärɔaadɛ. Kä nɛ̈nɛ jɛ, cu wut mi kueckɛ gua̱a̱th in bëë thi̱n rɔ muɔ̱n jɛ, kä cukɛ kueer kɛnɛ jɛ amäni bak ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci wut ɛmɔ ɛ ŋa̱c ɛn ɣöö /cɛ kueer ɛ luäŋ, cuɛ juɔɔl Je-kɔb pat kä cu juɔɔl Je-kɔb cu tëë ri̱el ri̱el. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min cɛ guic inɔ cuɛ wee i̱, “Päl ɣä a wa̱a̱ kɛ ɣöö po̱o̱tdɛ ɣɔw.” Kä cu Je-kɔb ɛ loc i̱, “/Cä ji̱ bi päl ɛ ni mi wi̱i̱ ɣä jɔl kɛ puɔ̱th.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu ram indaan ɛ ku thi̱ec i̱, “Cɔal ciötdu i̱di?” Kä cu Je-kɔb ɛ loc i̱, “Je-kɔb.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛn wa̱nɔ cuɛ cu wee i̱, “Ɛ ciötdu /ca bi nyɔk kɛ ciöl i̱ Je-kɔb, kɛ ɣöö ji̱n ci kueer kɛ Kuoth kɛnɛ naath kä cikɛ dhal. Ba ciötdu cu cɔl i̱ I-thɛ-rɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ cu Je-kɔb ɛ jiök i̱, “Läri ɣä ciötdu.” Cuɛ jɛ loc i̱, “Ɛŋu mi thieeci ni ciötdä?” Kä cuɛ Je-kɔb cu poth ɛn wi̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Je-kɔb gua̱a̱th ɛmɔ cu cɔl i̱ Pɛ-nu-el, kɛ ɣöö ɛ jɛn i̱, “Cakɔ nyinkɔ nɛn kɔnɛ Kuoth, kä cä lɛni ŋot te̱e̱kä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jiɛɛn kä Pɛ-nu-el kɛ gua̱a̱th ëë käny kɛ cäŋ, kä cuɛ ja̱l thie̱e̱pɛ juɔɔlɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn min thɛ̈ɛ̈kɛ ni ra̱a̱l in te juɔl ɛ gaat I-thɛ-rɛl amäni täämɛ kɛ ɣöö cɛ kam cɔ̱ɔ̱ni juɔl Je-kɔb pat.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
      ]
    }
