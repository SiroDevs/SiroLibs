      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ thia̱k kɛ dhɔr mi cɔal i̱ Go-cɛn, cu Je-kɔb gatdɛ ni Juda jäk kä nhiamdiɛn kɛ ɣöö bɛ Jo-thɛp wä la̱r lär ɛn ɣöö bikɛ wä jëk kɛnɛ jɛ kä Go-cɛn. Cukɛ ja̱l amäni mëë cikɛ cop thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Jo-thɛp ɛ ŋa̱c ɛn ɣöö ci gua̱n ben, cuɛ thurbil rialikä kä cuɛ wä ni Go-cɛn kɛ ɣöö de̱e̱kɛ wä jëk kɛnɛ gua̱n ni I-thɛ-rɛl. Mëë cikɛ jëk kɛnɛ gua̱n cuɛ rɔ kuer jɛ kä min cikɛ rɔ̱ kuäk cuɛ wiee ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ cu I-thɛ-rɛl Jo-thɛp cu jiök i̱, “Täämɛ cäŋ kua̱ lɛ li̱w bä, ɣän ci ku thuŋ nɛn a ŋotdi te̱e̱kä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min cikɛ thuɔ̱k kɛ jëk, cu Jo-thɛp ciëëŋ gua̱ni kɛnɛ dämani jiök i̱, “A wa̱a̱ kä bä Pɛro wä jiök i̱, ‘Dämaari kɛ ciëëŋ gua̱a̱r paykɛ cop ni ro̱o̱l Kɛ-naan kä ca rɔ̱ ben ma̱t ɣä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä jɛ la̱t jɛ bä ɛn ɣöö yɛn kɛ yɛn yiëën de̱e̱t kɛnɛ ɣɔ̱k, kɛnɛ ɣöö cia de̱tkun diaal kɛnɛ ɣɔ̱ɔ̱kun diaal kɛ kuakun nööŋ kɛɛl kɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.32",
            "verseOrgIds": [
              "GEN.46.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 46:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, mi wä Pɛro yɛ wä cɔl kä thieecɛ yɛ i̱, ‘La̱tdun ɛŋu?’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.33",
            "verseOrgIds": [
              "GEN.46.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 46:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "luɔcɛ jɛ i̱, ‘lapɛ yuɔ̱ɔ̱p ɣɔ̱ɔ̱k ni kuɛkädun amäni täämɛ, kä larɛ jɛ bä ɛn ɣöö ɛ jɛn ta̱a̱ ëë kɔŋ tekɛ guurikun ni wal.’ Kɛ ɣöö kɛ jɛn kui̱ kä nɔmɔ, ba yɛ cu nhök ɣöö dërɛ cieŋ kä Go-cɛn, kɛ ɣöö ji̱ rööl I-jëp kɛn canykɛ yiëën ɣɔ̱ɔ̱k kɛnɛ yuɔ̱ɔ̱p de̱e̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.34",
            "verseOrgIds": [
              "GEN.46.34"
            ]
          }
        }
      ]
    }
