    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ben nyɔac",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Kuoth Nhial Nowa ku jiök i̱, “Wër rɛy ria̱a̱y, ji̱n yɛnɛ ji̱ gɔaalu diaal, kɛ ɣöö cä jɛ nɛn ɛn ɣöö ɛ ji̱n gua̱n cuŋni kärɔaadu rɛy ri̱cä mi mi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ji̱n naŋni rɛw rɛy ria̱a̱y ni kä bärɔw kä le̱y diaal tin cä ji̱ nhök mi̱ethdiɛn, tuut kɛnɛ ŋuɔ̱ɔ̱tdɛ, kɛ rɛw kä le̱y diaal tin cä ji̱ gok mi̱thdiɛn, tuut kɛnɛ ŋuɔ̱ɔ̱tdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ rɛw ni kä bärɔw kä diit diaal, tuut kɛnɛ ŋuɔ̱ɔ̱tdɛ, kɛ ɣöö ba cätdiɛn yop a tëk wi̱i̱ muɔ̱ɔ̱n kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "La̱rä jɛ ji̱ inɔ kɛ ɣöö kɛ kɔr ni̱ni da̱ŋ bärɔw ɣän bä nhiaal jak kä dɛm wi̱i̱ muɔ̱ɔ̱n kɛ ni̱n ti jiɛn ŋuaan, kɛ wäär kɛnɛ cäŋdäär. Kä ɣän bä tin diaal tin tëk tin cä cak puɔc jɔ̱ɔ̱r wi̱i̱ muɔ̱ɔ̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Nowa tin diaal tin ci Kuoth kɛ la̱r jɛ la̱t.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ gua̱a̱th ëë bäk kɛ nyɔc wi̱i̱ muɔ̱ɔ̱n Nowa tëë kɛ run ti kur bäkɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Nowa kɛnɛ gaatkɛ kɛ ciekdɛ kɛ män gankɛ cukɛ wä rɛy ria̱a̱y kɛ jɛ kɛɛl, kɛ ɣöö bikɛ rɔ kɔl kä nyɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ley diaal tin gɔw kɛ diaal tin jiäk, kɛ diit kɛ muɔɔl piɛny diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wäkɛ rɛc rɛw kɛɛl tuut kɛnɛ ŋuɔ̱ɔ̱t kɛɛl kɛ Nowa, ce̱tkɛ mëë ci Kuoth ɛ guɔ̱k Nowa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr ni̱ni da̱ŋ bärɔw cu nyɔc ben wi̱i̱ muɔ̱ɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Nowa runkɛ a kur bäkɛl, kɛ cäŋ kä wäl bärɔw, kä pay rɛw, ɛn cäŋ ɛmɔ cu pi̱ bäpdiitni kac nhial kä cu pua̱a̱r rɔ lɛp. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nhiaal dɛ̈m wi̱i̱ muɔ̱ɔ̱n kɛ ni̱n ti jiɛn ŋuaan, kɛ wäär kɛnɛ cäŋdäär. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kɛ jɛn cäŋ ɛmɔ pa̱ny cu Nowa kɛnɛ ciekdɛ wä rɛy ria̱a̱y kɛɛl kɛ gaatkɛ ni Cɛm kɛ Ɣɛ̈m kɛ Ya-pɛth kɛ mänkiɛn da̱ŋ diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ wä kɛɛl kɛ ley dɔaar diaal ce̱tnikɛ cätdiɛn, kɛ ley ciëŋ diaal ce̱tnikɛ cätdiɛn kɛ muɔɔl piɛny diaal ni kɛ cätdiɛn, kɛ diit nhial diaal nikɛ cätdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ coth rɛc kɛɛl kɛ Nowa, rɛw kɛɛl tuut kɛnɛ ŋuɔ̱ɔ̱t kä ŋɔak diaal tin tëk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ coth rɛc kɛn diaal ce̱tnikɛ mëë ci Kuoth ɛ gok. Kä cu Kuoth Nhial thi̱i̱k ria̱a̱y cu lɛ̈k thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyɔc te wi̱i̱ muɔ̱ɔ̱n kɛ ni̱n ti jiɛn ŋuaan, kä cu pi̱ rɔ̱ re̱p kä cukɛ riey ɣöth nhial a thɔaarɛ wi̱i̱ pi̱i̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pi̱ wä kɛ mi rëpkɛ rɔ̱, kä cukɛ luëŋ ɛlueŋ a thɔaar riey thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.18",
            "verseOrgIds": [
              "GEN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ rɔ̱ re̱p ɛlɔ̱ŋ a cukɛ pääm tin ba̱r ba̱a̱r buɔny bä. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.19",
            "verseOrgIds": [
              "GEN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ wee kɛ wä a cukɛ pääm diaal buɔny a räth ni kä jua̱th tetni da̱ŋ wal wi̱cdɛ dhieec nhialiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.20",
            "verseOrgIds": [
              "GEN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, cu ŋɔak diaal tin tëk wi̱i̱ muɔ̱ɔ̱n cu li̱w, ti̱ti̱ kɛ diit, kɛ ɣɔ̱k, kɛ le̱y dɔaar, kɛ muɔɔl piɛny diaal, kɛ nɛy diaal tëë ci duɔth raar rɛy ria̱a̱y, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.21",
            "verseOrgIds": [
              "GEN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋɔak diaal tëë te ko̱o̱tdä, kɛn diaal cukɛ li̱w, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.22",
            "verseOrgIds": [
              "GEN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋɔak diaal tin tëk cua kɛ däk, tin diaal tëë te wi̱i̱ muɔ̱ɔ̱n, naath kɛ le̱y kɛ muɔɔl piɛny kɛ diit, cua kɛ jak kä thilkɛ ni kɛn diaal. Kä cu duɔth ni Nowa kärɔa kɛnɛ tëë tekɛ jɛ kɛɛl rɛy ria̱a̱y. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nyɔc te wi̱i̱ muɔ̱ɔ̱n kɛ ni̱n ti kuɔ̱r kɛl wi̱cdɛ jiɛn dhieec.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
  ],
