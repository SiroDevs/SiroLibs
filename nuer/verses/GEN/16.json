    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A-gar kɛnɛ I-ca-mel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ nɛ̈nɛ jɛ, Tha-ray kɛnɛ cɔwdɛ ni Ab-ram thilkɛ gat mi ca dap ɛ kɛn. Kä Tha-ray puɔ̱nydɛ pa̱ny tëë kɛ nya rööl I-jëp mi lät kɛ jɛ kɛɛl ala nya läätdä cieeŋdɛ. Nya mɔ cɔal ciötdɛ i̱ A-gar. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.1",
            "verseOrgIds": [
              "GEN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Tha-ray Ab-ram ku jiök i̱, “Min ci Kuoth Nhial ɣä pen dap, ɛŋu /ci nya läätädä ɛmɛ jak kä ciek ɔ, dɔ̱ŋ dëë cieeŋdä jek gaat kɛ jɛ.” Min ci Ab-ram min ca la̱t jɛ ɛ Tha-ray liŋ cuɛ jɛ nhɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, ɛn guäth ëë cu Tha-ray nya läätädɛ ni A-gar nya I-jëp ka̱m cɔwdɛ kɛ ɣöö bɛ kɛ da̱p gaat, te Ab-ram kɛ run ti jiath kɛl ro̱o̱l Kɛ-naan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.3",
            "verseOrgIds": [
              "GEN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Ab-ram nyam ɛmɔ jak kä ciek, cuɛ ruët. Kä mëë ci A-gar jɛ ŋa̱c ɛn ɣöö rue̱tdɛ, cuɛ wee kɛ mi caanyɛ kuäärɛ ni Tha-ray. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ mɔ cu Tha-ray Ab-ram jiök i̱, “Ɛ ŋuään ci A-gar thil luth kɛ ɣä mɔ, mɛmɛ /ci tharɛ tok ni ji̱n! Cä kuanydä kuëŋ baapdu kä niɛ guäth ëë cɛ ŋa̱c ɛn ɣöö cɛ ruët, cɛ cu thil luth kɛ ɣä. Mɛmɛ biɛ gui̱c ni Kuoth Nhial kamädan!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ab-ram ɛ cu loc i̱, “Wa, ɛŋu ɛnɔ, kä jɛn min ɛ kuanydu kä liŋɛ ni min lätdi jɛ. Guic min bi lät kä jɛ.” Ɛ jɛ nɔ, cu Tha-ray jɛ cu ciɛŋ ɛ jiäk. Kɛ kui̱c ɛmɔ cuɛ rɔ bar.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ rɔ bar, cu jääk Kuɔth Nhial ɛ jek däär paan wi̱i̱ puɔ̱ɔ̱l mi te dup in wä kä Cur. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ thi̱ec i̱, “A-gar, kuany Tha-ray, bi̱i̱ nikä kä ɛ ni wi̱i̱ thi̱nɔ?” Cu A-gar ɛ loc i̱, “Ɣän barä ni rɔ kä kuäärä.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ ku jiök i̱, “Locni kä kuääru, kä wër la liŋ ruacdɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ lɛni jiök bä, “Ɣän bä kuayku re̱p a bikɛ ŋuan ɛlɔ̱ŋ a /ca pe̱kdiɛn bi luäŋ kɛ kuen. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ji̱n rue̱tdi kɛ gat mi dho̱o̱l, kä bi ciötdɛ cɔl i̱ I-ca-mel (min lot ni ɣöö li̱ŋ Kuoth) kɛ ɣöö ci Kuoth Nhial lulu liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gat ɛmɔ bi ciaaŋdɛ a kui̱ny kui̱ny ce̱tkɛ muul mi kui̱ny. Bɛ tekɛ tɛr kɛ nɛy diaal, kä bɛ ciɛŋ ni gak kɛ ji̱ maarädɛ diaal.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min ci A-gar ruac ɛmɔ liŋ cuɛ Kuoth Nhial ëë ci ruac kɛ jɛ ɛn thɔ̱ŋi i̱, ciötdɛ cɔl i̱ Kuoth mi ne̱n kɛ ɣöö ɛ jɛn i̱, “Ɛ thuɔ̱k ɛpuc ɣän cä ram in la tiit ɣä lɛni dhil nɛn?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ cua jiw ɛmɔ cɔl i̱ Beer-laa-rɔy. Jɛn tëë kam Ka-dɛc kɛnɛ Ba-rɛd.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci päth rue̱tädɛ thuuk, cu A-gar Ab-ram cu da̱p dho̱o̱l kä cu Ab-ram ciötdɛ cɔl i̱ I-ca-mel. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäth ɛmɔ ci Ab-ram runkɛ a run ti jiɛn bädäk wi̱cdɛ bäkɛl.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
    }
  ],
