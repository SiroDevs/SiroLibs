        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Däk Lɔt piny kɛn Ab-ram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu Ab-ram cu jiɛn ni kä I-jëp wädɛ pe̱e̱k wec in cɔal i̱ Nɛ-gɛb kä Kɛ-naan, cuɛ jiɛn kɛɛl kɛnɛ ciekdɛ, kä cuɛ nyinkɛ diaal naŋ kɛ jɛ kɛɛl, amäni Lɔt cuɛ wä bä kɛ jɛ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.1",
            "verseOrgIds": [
              "GEN.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn Ab-ram tëë kɛ det ti ŋuan, kɛ ɣɔ̱k amäni ciɛk in bo̱r kɛnɛ da̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.2",
            "verseOrgIds": [
              "GEN.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ja̱lɛ tok ni kä Nɛ-gɛb ɛ lɛm lɛm, wädɛ kä Beth-ɛl amäni mëë cɛ cop kam Beth-ɛl kɛnɛ Aay mëë mɔ gua̱a̱th ëë cɛ kɛmɛdɛ kɔŋ pua̱t thi̱n bä, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.3",
            "verseOrgIds": [
              "GEN.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cɛ Kuoth kɔŋ ta̱th yi̱k thi̱n. Kä ɛn wi̱ni cu Ab-ram Kuoth Nhial pal. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.4",
            "verseOrgIds": [
              "GEN.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ jɛn Lɔt ëë jiɛc kɛɛl kɛnɛ Ab-ram tëë kɛ det bä kɛnɛ ɣɔ̱k matdiɛn amäni ji̱ cieeŋdɛ pa̱ny kɛ kuaanykɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.5",
            "verseOrgIds": [
              "GEN.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɛ mɔ, /ke̱n wal ro̱ŋ kɛ kui̱diɛn kɛn da̱ŋ rɛw kɛɛl, kɛ ɣöö tekɛ kɛ ɣɔ̱k ti ŋuan gua̱thnikiɛn diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.6",
            "verseOrgIds": [
              "GEN.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ ɣöö ciɛŋ yiëën ɣɔ̱ɔ̱kiɛn ni gak kamnikiɛn kä rɔ̱. Kɛn ni̱ni tɔ̱tɔ̱ dhɔr ɛmɔ cieŋni ji̱ rööl Kɛ-naan thi̱n kɛnɛ ji̱ rööl Pɛ-rii-dhi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.7",
            "verseOrgIds": [
              "GEN.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ cu Ab-ram Lɔt ku jiök i̱, “Thilɛ mi dënɛ gak, kiɛ mi dëë yiëën ɣɔ̱ɔ̱kä jɛ gak kɛnɛ yiɛɛn ɣɔ̱ɔ̱ku kɛ ɣöö kɔn lapnɛ gaat ciëk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.8",
            "verseOrgIds": [
              "GEN.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mun ɛ mi /cɛ te nhiamdu kɛɛliw? Mi wi̱i̱ wä mɛk ni pe̱k caam. Ɣän bä pe̱k cuëëc ka̱n, kä mi wi̱i̱ mɛk ni cuec bä cam ka̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.9",
            "verseOrgIds": [
              "GEN.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niɛ wa̱nɔ, cu Lɔt pan Jɔr-dɛn cu car ni kɛɛliwdɛ a wä räth ni Dho-ar, kä cuɛ jɛ nɛn ɛ mun ɣɔ̱ɔ̱k mi gɔaa ce̱tkɛ mun kakä Kuɔth Nhial kɛnɛ mun rööl I-jëp. Mɔmɔ ɛ mëë /ke̱n Kuoth Nhial wec Thɔ-dɔm kɛnɛ Go-mo-ra ni däk. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.10",
            "verseOrgIds": [
              "GEN.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ cu Lɔt pan Jɔr-dɛn ni kɛɛliwdɛ cu mëk rɔɔdɛ kä cuɛ cu ja̱l wee kui̱ käny ca̱ŋ. Cukɛ rɔ cu da̱a̱k inɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.11",
            "verseOrgIds": [
              "GEN.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu Ab-ram cieŋ rööl Kɛ-naan kä Lɔt cuɛ ciɛŋ ni kam rɛ̈kni paan Jɔr-dɛn. Cuɛ wee mi ɣo̱o̱thɛ kɛmɛnikɛ amäni mëë cɛ thia̱k kɛ Thɔ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.12",
            "verseOrgIds": [
              "GEN.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ ji̱ rööl Thɔ-dɔm kɛ nɛy ti ji̱ nyuɔɔni kä ŋuan dueerkiɛn ɛlɔ̱ŋ nhiam Kuɔth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ɣöth Ab-ram Ɣɛb-ron",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.13",
            "verseOrgIds": [
              "GEN.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Lɔt cu jiɛɛn, cu Kuoth Nhial Ab-ram ku jiök i̱, “Gui̱cni ɛ ɛn guäth ɛ ti̱i̱ cuŋä thi̱n ɛ amäni pe̱k ɔ bi luäŋ kɛ cuɔ̱p kɛ waŋdu mɔ, guic nhiamdu kɛ jɔkdu kä liɛc pe̱k ɔ wëë kä käny ca̱ŋ ɔ kɛnɛ pe̱k ɔ wëë kä kony ca̱ŋ ɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.14",
            "verseOrgIds": [
              "GEN.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ɛn mun ɛ nɛɛni mi, ni kɛɛliwdɛ, bä jɛ ka̱m ji̱ yɛnɛ kuayku ala duundun amäni cäŋ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.15",
            "verseOrgIds": [
              "GEN.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bä kuayku re̱p a bikɛ ŋuan ce̱tnikɛ tur piɛny in /ci raan ɛ dëë luäŋ kɛ kuën? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.16",
            "verseOrgIds": [
              "GEN.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiɛcni kä wër jäl di̱t wec kɛnɛ bärɛ, kɛ ɣöö bä jɛ ka̱m ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.17",
            "verseOrgIds": [
              "GEN.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, cu Ab-ram kɛmɛdɛ cu ɣöth kä cuɛ jɛ wä pua̱t gekä jiɛn Ma-mɛ-ri kä Ɣɛb-ron kä cuɛ Kuoth Nhial ta̱th yi̱k ɛn wi̱ni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.13.18",
            "verseOrgIds": [
              "GEN.13.18"
            ]
          }
        }
      ]
    }
  ],
