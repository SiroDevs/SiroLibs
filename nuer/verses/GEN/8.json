        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thuɔ̱k nyɔac",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn wa̱nɔ cu Kuoth Nowa tim kɛnɛ le̱y diaal kɛ ɣɔ̱k diaal tëë tekɛ jɛ kɛɛl rɛy ria̱a̱y. Kä cuɛ jiɔam jak kä bɛ puɔ̱t wi̱i̱ muɔ̱ɔ̱n, kä cu pi̱ wee do̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua löny pi̱i̱ni bäpdiitni tëë ci kac nhial kɛnɛ thuk puɔ̱ɔ̱ri lɛk kä thi̱n, kä ci nhiaal thuɔ̱k kɛ dɛ̈m nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ni̱n ti kuɔ̱r kɛl wi̱cdɛ jiɛn dhieec cu pi̱ wee kɛ wä piny. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ cäŋ kä wäl bärɔw kä pay bärɔw cu riey ben kɔ̱k wi̱i̱ pa̱a̱m mi cɔal i̱ Ä-ra-rat. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pi̱ wee kɛ wä piny, kä kɛ cäŋ in jio̱l kä pay wäl cu biɛɛ päämni jɔɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr thukä ni̱ni ti jiɛn ŋuaan, cu Nowa jakɔ̱k lëp wernyin ria̱a̱y. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci jakɔ̱k cu wä raar, cuɛ la pärɛ kui̱c ɔ kɛ kui̱cɔ amäni mëë ci piny kööt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, cuɛ guk cu lɛ̈p raar kɛ ɣöö bɛ jɛ cu ŋa̱c mi ci piny kööt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö /ke̱n guuk gua̱a̱th mi nyuurɛ thi̱n jek kɛ ɣöö ŋot pi̱ kɛ mi thia̱ŋkɛ wi̱c muɔ̱ɔ̱n, kä cuɛ luny rɛy ria̱a̱y. Ɛ jɛn, cu Nowa tetdɛ ruɔny raar kä cuɛ jɛ lɔ̱m kä cuɛ jɛ nööŋ rɛy ria̱a̱y. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn guäthɔ, cuɛ lɛni li̱ep kɛ ni̱n bärɔw. Kä kɛ kɔrɛ cuɛ guk nyɔk kɛ lɛp raar rɛy ria̱a̱y. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thiaŋdɛ cu guk luny jɔk, kä nɛ̈nɛ jɛ, cuɛ ben te thokdɛ kɛ ji̱th jiaath mi tɔ̱c mi cɔal jiathdɛ i̱ Ɔ-lip",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:11",
              "type": "text"
            },
            {
              "text": "Ɔ-lip",
              "type": "text"
            },
            {
              "text": "Kɛ thok liŋli̱th lotdɛ ni dhɛytuun kɛ thok tuɔ̱ruɔ̱k, kä ce̱t ciaŋdɛ kɛ thɔ̱w kɛnɛ nyɔ̱a̱t.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ɛ jɛn cu Nowa ɛ cu ŋa̱c ɛn ɣöö ci piny kööt. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ lɛni li̱ep kɛ ni̱n bärɔw kɔ̱kiɛn, cuɛ guuk nyɔk kɛ lɛp raar, kä /ke̱n guk lɛ luny jɔk.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈n ɛ, mëë ci Nowa runkɛ a run ti kur bäkɛl wi̱cdɛ kɛl, kɛ cäŋ in jio̱l kä pay in jio̱l cu pi̱ do̱n, kä cu Nowa thi̱i̱k ria̱a̱y guɛny. Kä min cɛ guel, cuɛ wi̱c muɔ̱ɔ̱n nɛn wëë kɛ mi köötdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ, kɛ cäŋ kä jiɛn da̱ŋ rɛw wi̱cdɛ bärɔw kä pay rɛw cu piny wee ko̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci piny cu kööt, cu Kuoth Nowa ku jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bia raar rɛy ria̱a̱y, ji̱n yɛnɛ ciekdu kɛ gaatku kɛnɛ män ganku kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä no̱o̱ŋni le̱y diaal raar kɛ ji̱ kɛɛl, diit kɛnɛ le̱y kɛ muɔɔl piɛny diaal, kɛ ɣöö bikɛ rɔ̱ diëth gaat ti ro̱ŋ wi̱i̱ muɔ̱ɔ̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Nowa kac raar kɛnɛ ciekdɛ kɛ gaatkɛ kɛnɛ män gankɛ kɛɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amäni le̱y kɛ muɔɔl kɛ diit, kɛn diaal cukɛ wä raar rɛy ria̱a̱y bä, cät ɔ kɛɛl, cät ɔ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tin ci Kuoth kɛ la̱t Nowa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛ nɔ, mëë ci Nowa cu ben raar, cuɛ Kuoth Nhial ta̱th yi̱k, kä cuɛ rɔ moc kä le̱y diaal tin gɔw kɛ mi̱eth kɛnɛ diit diaal tin gɔw kɛ mi̱eth, kä cuɛ kɛ wëŋ Kuoth Nhial wi̱i̱ yi̱kä ala muc ti waŋkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ŋuänydiɛn lɔc Kuɔth jak kä tɛth, kä cuɛ jɛ lar kɛ lɔcdɛ, “/Cä piny bi me̱t nyɔk kɛ däk kɛ kui̱ nath, kɛ ɣöö ca̱r wuɔ̱thnikiɛn ɛ mi jiääk ni kuɛɛkädiɛn, kä thilɛ yi̱ey kä tin diaal tin cä cak ti bä lɛ nyɔk kɛ ba̱th ce̱tkɛ mi cä la̱t ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.21",
            "verseOrgIds": [
              "GEN.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi bi ɣɔw ŋot nikɛ ta̱a̱dɛ, bɛ tekɛ gua̱a̱th pi̱thä kɛ gua̱a̱th ŋër, kɛ gua̱a̱th kɛ kui̱ kɔ̱a̱c kɛ gua̱a̱th kɛ kui̱ lëth, kä bɛ tekɛ mey kɛnɛ tɔ̱t, kɛ cäŋdäär kɛnɛ wäär.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    }
  ],
