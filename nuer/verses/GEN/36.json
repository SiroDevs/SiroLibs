    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat E-thɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ gaat E-thɔ (min la Ɛ-dɔm). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "E-thɔ cɛ kuɛɛn kɛ nyi̱er rööl Kɛ-naan, Adha nya wutdä mi cɔal i̱ Ee-lon mi la raan Ɣɛ̈th, kɛ Ɔ-li-ba-ma nya wutdä mi cɔal i̱ Ä-na gat Dhi-bɔn min la raan Iwi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ba-thɛ-math nya I-ca-mel, nyiman Nɛ-ba-yɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Adha Ɛ-li-padh da̱p E-thɔ, kä cu Ba-thɛ-math Rɛ-u-el dap. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ɔ-li-ba-ma Yuc dap, kɛnɛ Ya-lam kɛ Kora. Tɔ̱tɔ̱ kɛ gaat tëë ca da̱p E-thɔ kä Kɛ-naan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu E-thɔ mänkɛ cu naŋ kɛ gaatkɛ kɛnɛ nyieekɛ, kɛ ji̱ dhɔaarɛ diaal, detkɛ, kɛ ɣɔ̱ɔ̱kɛ kɛnɛ kuakɛ diaal tëë cɛ jëk rɔ kä Kɛ-naan kä cuɛ ɣo̱th ro̱o̱l mi na̱n kɛ däman ni Je-kɔb, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ci ŋɔakiɛn ŋuan ɛlɔ̱ŋ, kä /ci dhɔr in tekɛ thi̱n dëë ro̱ŋ kɛ kɛn da̱ŋ rɛw kɛɛl, kɛ ɣöö ŋuan ɣɔ̱ɔ̱kiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E-thɔ (min la Ɛ-dɔm) cuɛ ciɛŋ ni dhɔr päämni min cɔal i̱ ro̱l päämni Ɛ-dɔm.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn gaat E-thɔ min la gua̱ndɔɔŋ ji̱ Ɛ-dɔm, ëë la cieŋ ni dhɔr päämni min cɔal i̱ ro̱o̱l päämni Ɛ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.9",
            "verseOrgIds": [
              "GEN.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu E-thɔ kɛnɛ ciekdɛ ni Adha Ɛ-li-padh di̱eth kä cu E-thɔ kɛnɛ ciekdɛ ni Ba-thɛ-math Rɛ-u-el lɛni di̱eth. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛ-li-padh Te-man di̱eth kɛ O-mar kɛ Dhɛpo kɛ Ga-tam kɛnɛ Kɛ-nadh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn Ɛ-li-padh kɛnɛ luɔmdɛ mi cɔal i̱ Tim-nä cukɛ Ä-ma-lek di̱eth cu tɔ̱tɔ̱ a gaat gan E-thɔ kɛnɛ ciekdɛ ni Adha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Rɛ-u-el Na-ɣath di̱eth kɛ Dhɛra kɛ Cama kɛnɛ Midha, cu tɔ̱tɔ̱ a gaat gan E-thɔ kɛnɛ ciekdɛ ni Ba-thɛ-math. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu E-thɔ kɛnɛ nya Ä-na gat Dhi-bɔn ni Ɔ-li-ba-ma Yuc di̱eth kɛ Ya-lam kɛnɛ Kora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn gaat E-thɔ tëë tɔ̱ kua̱r rɛy rööl Ɛ-dɔm. Gaat Ɛ-li-padh min mɔ kɛ̱̈ɛ̱̈ E-thɔ kä kɛnɛ ciekdɛ ni Adha kɛ kɛn Te-man kɛ O-mar kɛ Dhɛpo kɛ Kɛ-nadh, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Kora kɛnɛ Ga-tam kɛ Ä-ma-lek. Cukɛ a kɛn kua̱r kä gaat Ɛ-li-padh ro̱o̱l Ɛ-dɔm, kɛn kɛ gaat gan Adha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Rɛ-u-el min mɔ gat E-thɔ kä kɛnɛ ciekdɛ ni Ba-thɛ-math a Na-ɣath kɛ Dhɛra kɛ Cama kɛnɛ Midha. Cukɛ a kɛn kua̱r kä gaat Rɛ-wɛl ro̱o̱l Ɛ-dɔm, kɛn kɛ gaat gan Ba-thɛ-math ciek E-thɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ti̱ti̱ a gaat E-thɔ kɛnɛ ciekdɛ ni Ɔ-li-ba-ma nya Ä-na, mɛmɛ ɛ Yuc kɛ Ya-lam kɛnɛ Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tɔ̱tɔ̱ kɛ gaat E-thɔ (min la Ɛ-dɔm) tëë la kua̱r rɛy gankɛ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaat The-ir",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gaat rööl päämni Ɛ-dɔm raan Ɣori tëë tɔ̱ di̱eel wec ɛmɔ kɛn ti̱n, gatdɛ ni Lo-tan kɛ Cɔ-bal, Dhi-bɔn kɛ Ä-na, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20",
            "verseOrgIds": [
              "GEN.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Di-cɔn kɛ E-dhɛr kɛnɛ Dhi-can, tɔ̱tɔ̱ kɛ kɛn kua̱r ji̱ Ɣori tëë tɔ̱ gaat rööl päämni kä Ɛ-dɔm. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.21",
            "verseOrgIds": [
              "GEN.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gaat Lo-tan kɛ Ɣori kɛnɛ Ɣe-man. Kä Tim-nä ɛ nyiman Lo-tan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.22",
            "verseOrgIds": [
              "GEN.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gaat Cɔ-bal ti̱n, Al-wan kɛ Ma-naath kɛ Ee-bal kɛ Cɛpo kɛnɛ O-nam. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.23",
            "verseOrgIds": [
              "GEN.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gaat Dhi-bɔn ti̱n, Aya kɛ Ä-na. Ɛ jɛn Ä-na ɛ nëë jek lo̱o̱l pi̱i̱ni däär dɔaar guäth ëë cɛ muɔ̱li gua̱n ni Dhi-bɔn naŋ laak thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaat Ä-na ti̱n, gatdɛ ni Di-cɔn kɛnɛ nyaadɛ ni Ɔ-li-ba-ma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25",
            "verseOrgIds": [
              "GEN.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaat Di-cɔn ti̱n, Ɛm-dan, Ɛc-ban, Ith-ran kɛnɛ Kɛ-ran. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.26",
            "verseOrgIds": [
              "GEN.36.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaat E-dhɛr ti̱n, Bi-lan kɛ Dha-wan kɛnɛ Ä-kan. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.27",
            "verseOrgIds": [
              "GEN.36.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaat Dhi-can ɛ Udh kɛnɛ Ä-ran. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.28",
            "verseOrgIds": [
              "GEN.36.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ti̱ti̱ kɛ kua̱r cieeŋni ji̱ Ɣori rɛy rööl päämni Ɛ-dɔm, kuäär ni Lo-tan kɛ Cɔ-bal kɛ Dhi-bɔn kɛ Ä-na, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
              "GEN.36.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Di-cɔn kɛ E-dhɛr kɛnɛ Dhi-can. Cukɛ a kɛn kua̱r ji̱ Ɣori rɛy rööl päämni Ɛ-dɔm.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kua̱r tin di̱t kä Ɛ-dɔm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kua̱r tëë ci ruec kä Ɛ-dɔm guäth ëë /ke̱n ji̱ I-thɛ-rɛl ni tekɛ kua̱r tin di̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.31",
            "verseOrgIds": [
              "GEN.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛlä mi mɔ gat wutdä mi cɔal i̱ Bɛ-or cuɛ ruëc kä Ɛ-dɔm, kä wecdɛ mëë ruaacɛ cɔalɛ i̱ Di-na-ba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci Bɛlä li̱w cua gua̱a̱thdɛ guäl ɛ Yo-bab gat wutdä mi cɔal i̱ Dhɛra raan rööl Bɔ-dhɛ-ra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yo-bab li̱w kä cua gua̱a̱thdɛ guäl ɛ Ö-cam raan rööl Te-man. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ö-cam li̱w kä cua gua̱a̱thdɛ guäl ɛ A-dad gat wutdä mi cɔal i̱ Bɛ-dhadh, mëë joc ji̱ Mid-yan kɛ ko̱r kä Mo-ab, kä wecdɛ mëë ruecɛ thi̱n cɔalkɛ jɛ i̱ Ä-with. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-dad li̱w kä cua gua̱a̱thdɛ guäl ɛ Tham-la raan rööl Math-rɛ-ka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Tham-la li̱w kä cua gua̱a̱thdɛ guäl ɛ Ca-ul raan wec in cɔal i̱ Rɛ-böth min te gekä kiɛɛr Yu-pɛ-ree-tidh. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ca-ul li̱w kä cua gua̱a̱thdɛ guäl ɛ Baal-ɣa-nan gat wutdä mi cɔal i̱ Ak-bor. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Baal-ɣa-nan li̱w kä cua gua̱a̱thdɛ guäl ɛ Ɣä-dar, kä cu wecdɛ mëë ruecɛ thi̱n a Pɔ̱w. Cɔal ciöt ciekdɛ i̱ Mɛɛ-ta-bɛl, nya wutdä mi cɔal i̱ Ma-tɛ-rɛd, ɛ nya dhɔaar in cɔal i̱ Me-dhaab.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
    },
