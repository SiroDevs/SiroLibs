          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ ciööt kuayni E-thɔ tëë tɔ̱ kua̱r rɛ̈y ciëŋ, kɛ thuk duëlikiɛn kɛ dho̱rikiɛn tin ciölkɛ kɛ, kuäär Tim-nä kɛ Al-wa kɛ Yɛ-theth, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 36:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɔ-li-ba-ma kɛ Elaa kɛ Pi-nɔn ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Kɛ-nadh kɛ Te-man kɛ Mib-dhar ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ma-gi-del kɛnɛ I-ram. Tɔ̱tɔ̱ kɛ kɛn kua̱r Ɛ-dɔm dho̱rikiɛn muundiɛn ëë tekɛ thi̱n. Nɔmɔ ɛ jɛn pe̱k gan E-thɔ min la gua̱ndɔɔŋ ji̱ Ɛ-dɔm.",
          "type": "text",
