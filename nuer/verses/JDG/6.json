              "JDG.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ wäär ɛ mɔ, cu Kuoth Nhial ɛ jiök i̱, “Käni thäk guur, thäk in gɔaa ni jɛn, min te run bärɔw, kä däk yi̱k kuɔth Baal min tekɛ guur, kä jɔpni puɔ̱ny kuɔth Ä-ce-ra in te gekädɛ piny bä. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.25",
            "verseOrgIds": [
              "JDG.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä lätni Kuoth Nhial Kuothdu kä yi̱k ɛn wi̱i̱ päämni ti̱ti̱, nikɛ pääm ti ca rɔ car ti. Kä käni thäk näkɛ ala muc mi waŋkɛ kä waŋɛ kɛ jiɛn pua̱a̱ny kuɔth Ä-ce-ra in bi jɔap piny.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.26",
            "verseOrgIds": [
              "JDG.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Gi-don wutni da̱ŋ wäl ka̱n kä kuaanykɛ, kä cuɛ jɛ la̱t ce̱tnikɛ min ci Kuoth Nhial ɛ la̱r jɛ. Kä kɛ ɣöö dualɛ ɛlɔ̱ŋ kɛ ji̱ dhɔaariɛn kɛnɛ ji̱ wec mi cɛ jɛ la̱t kɛ cäŋdäär, cuɛ jɛ la̱t kɛ wäär.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛnɛ, mëë ci ji̱ wec keer kɛ runwaŋ cua yi̱k kuɔth Baal kɛnɛ puɔ̱ny kuɔth Ä-ce-ra in te gekädɛ, jek ca kɛ da̱k piny, kä ca thäk in gɔaa ni jɛn näk ala muc wi̱i̱ yi̱kä min ca täth. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.28",
            "verseOrgIds": [
              "JDG.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ rɔ thiëc kamnikiɛn kä rɔ̱ wä kɛ i̱, “Ɛŋa mi lät nɛmɛ?” Kä mëë cikɛ jɛ go̱r thiëckɛ jɛ, cukɛ wee, “Ɛ Gi-don gat Yo-ac lät ɛn nɛmɛ ɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu wutni wec Yo-ac jiök i̱, “No̱o̱ŋi gatdu raar kɛ ɣöö ba näk, jɛn cɛ yi̱k kuɔth Baal da̱k piny, kä cɛ puɔ̱ny kuoth Ä-ce-ra jɔap piny bä min te gekä kuɔth Baal.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.30",
            "verseOrgIds": [
              "JDG.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ac nɛy diaal tin ci kɛ̈c kɛ jɛ loc i̱, “A ku yɛn ɣɔr ni kuoth Baal? Kiɛ gaŋɛ ni jɛ? Kä ramɔ gaŋ ni jɛ mɔ ba jɛ näk kɛ runwaŋ. Mi ɛ kuoth a rɔ gaŋɛ, kɛ ɣöö ca yi̱kdɛ da̱k piny.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.31",
            "verseOrgIds": [
              "JDG.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua Gi-don cɔl niɛ cäŋ ɛmɔ i̱ Yɛ-rub-baal",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:32",
              "type": "text"
            },
            {
              "text": "Yɛ-rub-baal",
              "type": "text"
            },
            {
              "text": "Kɛ thok Ɣi-bɛ-ru lotdɛ ni ɣöö ɛ Baal gaŋ rɔɔdɛ min la Yɛ-rub-baal.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", min lot ni ɣöö “Ɛ Baal gaŋ rɔɔdɛ?” Kɛ ɣöö ca yi̱kdɛ da̱k piny.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.32",
            "verseOrgIds": [
              "JDG.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu ji̱ Mid-yan kɛ ji̱ Ä-ma-lek kɛ nɛy tin cieŋ kui̱ känyä ca̱ŋ rɔ mat kɛɛl, cukɛ jiɛth kui̱ yiëër Jɔr-dɛn kä cukɛ pua̱t lo̱o̱lä Yidh-rɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛni ɣöö cu yiëë Kuɔth Nhial te rɛy Gi-don. Kä cuɛ kaaŋ koth, kä cuɛ thok duëël Ä-bi-ɛ-dhɛr cɔl i̱ ba guɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ naath jäk kä rɛy cieŋ Ma-na-thɛ kɛɛliw cɔɔlɛ kɛ i̱ guɔ̱ɔ̱rɛ ɣä, kä cuɛ naath jäk kä A-cɛr, kɛ Dhɛ-bu-lun, kɛ Nap-ta-li. Cukɛ wä röm kɛ kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Gi-don Kuoth jiök i̱, “Mi bi ji̱ I-thɛ-rɛl kän kɛ tetdä, ce̱tkɛ min ci lar, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
            "verseOrgIds": [
              "JDG.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nɛnɛ, ɣän bä miem deet la̱th piny guäth in la bɛl a kɔ̱a̱mkɛ thi̱n. Mi wä thec te kä miem kä rɔ, a kööt piny kɛɛliw, bä ŋa̱c ɛn ɣöö bi ji̱ I-thɛ-rɛl kän kɛ tetdä, ce̱tkɛ min ci lar.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.37",
            "verseOrgIds": [
              "JDG.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ cua̱ jɛn. Kä mëë cɛ keer mëë ruɔ̱n kɛ runwaŋ, cuɛ miem jek cikɛ nok kɛ thec, mëë cɛ kɛ nhiac, cu tuɔ̱k thia̱ŋ kɛ pikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.38",
            "verseOrgIds": [
              "JDG.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Gi-don Kuoth lɛni jiök i̱, “Cu gak kɛ ɣä. Ɛ ji̱ kua̱ thiec kɛ thiec kɛl kä rɔa. La̱ŋä ni ji̱, ku ɣä nhök ɣɔ̱n miemni ɛ mi, deri miem ti̱ti̱ jak kä kööt, kä dëë piny kɛɛliw tekɛ thec.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.39",
            "verseOrgIds": [
              "JDG.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth ɛ la̱t inɔ kɛn wäär ɛmɔ. Cu miem kööt kä rɔa, kä cu thec te wi̱i̱ muɔ̱ɔ̱n kɛɛliw.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.40",
            "verseOrgIds": [
              "JDG.6.40"
            ]
          }
        }
      ]
