          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ run ruëc Ä-dhar-yaa kuäär Juda ti jiɛn dhieec. Cu Pe-ka-yaa gat Mɛ-nɛ̈-ɣem a kuäär I-thɛ-rɛl kä Tha-mɛ-ria, kä cuɛ ruëc kɛ run rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ la̱t ni jiäk waaŋ Kuɔth Nhial. Cuɛ guɔ̱ɔ̱r ni dueer Ya-rɔ-baam gat Nɛ-bat diaal tëë jakɛ I-thɛ-rɛl kä dui̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu raan kɔarɛ ni Peka gat Rɛ-mɛ̈l-yaa jɛ ca̱p mi jiääk kɛnɛ ji̱ Gil-yad ti jiɛn dhieec, kä cuɛ jɛ näk duëël kua̱r rɛci. Kä cuɛ ruëc kɛ gua̱a̱thdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua duɔth lätni Pe-ka-yaa diaal gɔ̱a̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuäär I-thɛ-rɛl ni Peka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ run ruec Ä-dhar-yaa kuäär Juda ti jiɛn dhieec wi̱cdɛ rɛw, cu Peka gat Rɛ-mɛ̈l-yaa a kuäär I-thɛ-rɛl kä Tha-mɛ-ria. Kä cuɛ ruec kɛ run te jiɛn da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ la̱t ni jiäk waaŋ Kuɔth Nhial. Cuɛ guɔ̱ɔ̱r ni dueer Ya-rɔ-baam gat Nɛ-bat diaal tëë jakɛ I-thɛ-rɛl kä dui̱r.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ni̱n kua̱r. I-thɛ-rɛl ni peka cu Tig-lath-pi-lɛ-thɛr kuäär Thi-ri-ya I-yon, A-bel-beth-mä-kaa, Ya-no-a, Kɛ-dɛc, Ɣa-dhor, Gil-yad, kɛ Gɛ̈-lɛ-li, wi̱i̱ Nap-ta-li diaal ka̱n. Kä cuɛ naath naŋ kä Thi-ri-ya ala pɛ̈ɛ̈c. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣo-ce-ya gat Elaa Peka gat Rɛ-mɛ̈l-yaa ca̱p mi jiääk, cuɛ jɛ näk kä cuɛ ruec kɛ gua̱a̱thdɛ, kɛ run ruec Yo-tham gat U-dhi-yaa ti jiɛn da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua duɔth lätni Peka diaal gɔ̱a̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuäär Juda ni Yo-tham",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ rɛw runi ruëc Peka gat Rɛ-mɛ̈l-yaa kuäär I-thɛ-rɛl, cu Yo-tham gat U-dhi-yaa kuäär Juda ruec tok. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.32",
            "verseOrgIds": [
              "2KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë tookɛ ruec tëë kɛ run ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec. Kä cuɛ ruëc kä kɛ run wäl bäkɛl Jɛ-ru-tha-lɛm. Kä cɔalkɛ mani Yɛ-ru-ca nya Dha-dok. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ la̱t ni cuŋ nhiam Kuɔth Nhial, ce̱tnikɛ tëë diaal tëë ci gua̱n ni Ö-dhi-ya kɛ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ku la ɣöö /ka̱n gua̱th pali kuthni guäyni woc. Cu naath ŋot thöpkɛ muc kä waŋkɛ wal wuɔ̱thni yi̱knikiɛn. Kä cuɛ thi̱i̱k thuɔk luaak Kuɔth Nhial la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua duɔth lätni Yo-tham diaal gɔ̱a̱r rɛy buɔk kuɛ̈ɛ̈ni kua̱ri Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ni̱n tɔ̱tɔ̱ cu Kuoth Nhial ɛ tok kɛ mi jäkɛ Rɛ-dhin kuäär Ä-ram kɛnɛ Peka gat Rɛ-mɛ̈l-yaa kä Juda kɛ ko̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-tham li̱w, kä cua jɛ kony kɛɛl kɛnɛ gua̱ni därwec gua̱n ni Dee-bid. Kä cu gatdɛ ni A-ɣadh ruëc kɛ gua̱a̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
            "verseOrgIds": [
              "2KI.15.38"
            ]
          }
        }
      ]
    }
