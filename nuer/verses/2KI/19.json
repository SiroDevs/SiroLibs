            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
            "verseOrgIds": [
              "2KI.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ jɛn wäärɛ mɔ cu jääk Kuɔth Nhial wä, cuɛ nɛy ti bathdɔɔri ti kuɔ̱r wi̱cdɛ jiɛn bädäk wi̱cdɛ dhieec näk rɛy wec ji̱ A-thi-ri-ya. Kä min ci naath keer kɛ runwaŋ, cua nɛy tɔ̱tɔ̱ jek ala ti ci li̱w, kɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.35",
            "verseOrgIds": [
              "2KI.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär A-thi-ri-ya ni Thɛ-nɛ̈-kɛ-rib loc cieŋ, kä cuɛ wä cieŋ kä Ni-nɛ-be. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min wëë kuothdɛ ni Nith-rok pal, cu gaatkɛ Ɛ̈d-rɛ̈m-mɛ-lɛk kɛnɛ Thar-ɛ-dhɛr jɛ näk kɛ mut, kä cukɛ rɔ bar ro̱o̱l Ä-ra-rat. Kä cu gatdɛ ni E-thar-ɣɛ̈-don ruëc kɛ gua̱a̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.37",
            "verseOrgIds": [
              "2KI.19.37"
            ]
          }
        }
      ]
