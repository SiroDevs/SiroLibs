        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë took Yɛ-ɣo-ya-kim kuäär tëë kɛ run ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec, kä cuɛ ruëc kä Jɛ-ru-tha-lɛm kɛ run wäl kɛl. Kä cɔalkɛ man i̱ Dhɛ-bi-daa nya Pɛ-da-yaa kä Rumaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ la̱t ni jiäk nhiam Kuɔth Nhial, ce̱tnikɛ tëë diaal tëë ci gua̱ni kɛ la̱t.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
