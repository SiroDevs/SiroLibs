      },
      "items": [
        {
          "text": "Kuäär Juda ni Yɛ-ɣo-ya-kim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
