              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cu naath biɛt /ka̱n jɛ loc kɛ riet, kɛ ɣöö ci kuäär kɛ jiök i̱, “/Cuarɛ jɛ loc.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɛl-ya-kim gat Ɣil-ki-yaa gui̱i̱c cieŋ, kɛnɛ Cɛb-naa in la bolith, kɛ Yowa gat A-thap min la bulkamiin ben kä Ɣidh-ki-yaa kɛ bieyni ti ci rɛ̈t kɛ jiath lɔaac, kä cukɛ jɛ la̱t ruac Rɛ̈b-ca-kee.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
