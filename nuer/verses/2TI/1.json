  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2TI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ɣän Puɔl, jak Kritho Yecu kɛ ruac Kuɔth kɛ kui̱ ruac teekä min ca lar min te rɛy Kritho Yecu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gɔ̱a̱rä warɛgak ɛmɛ ji̱, lö Ti-mo-thi, gatdä min nhɔakä.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A puɔ̱th, kɛnɛ kɔ̱a̱c lɔaac, kɛ mal kä Kuoth in la Gua̱a̱ra kɛnɛ Kritho Yecu in la Käändan tekɛ ji̱ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lär tɛthä lɔaac kɛnɛ buɔ̱m",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän la̱rä Kuoth in palä tɛ̈th lɔaac kɛ ŋäc lɔaac mi gɔaa, ce̱tkɛ mëë ci gua̱ndɔɔŋni kä jɛ la̱t, mi tiɛmä ji̱ ni ciaŋ rɛy palikä kɛ wäär kɛnɛ cäŋ däär. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.3",
            "verseOrgIds": [
              "2TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɔ cä merku tim ɔ la göörä ni ɣöö dëë ji̱ nɛn, kɛ ɣöö dëë cu thia̱a̱ŋ kɛ tɛ̈th lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.4",
            "verseOrgIds": [
              "2TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän tiɛmä ŋa̱thdu in thuɔ̱k, jɛn ŋa̱th in ci kɔŋ tekɛ muɔɔrdɔɔŋ ni Lo-ith kɛnɛ muɔɔr ni Yu-nith, kä täämɛ ŋa̱cä jɛ ɛn ɣöö tëë rɛydu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ ti̱emä jɛ ji̱ ɛn ɣöö bi muc Kuɔth, in te rɛydu kɛ läth tetädä wi̱i̱du nyɔk kɛ döp. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ken Kuoth kɔn ka̱m yiëë dualä kä duundɛ ɣöö ɛ yiëë bumä, kɛnɛ nhök, kɛ ruɔ̱t lɔaac.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu po̱c, kɛ ɣöö bi naath la̱t ruac kɛ kui̱ Kua̱ran ni Yecu kiɛ kɛ kui̱dä ɣän ram min ca yiɛn kɛ kui̱dɛ. Kä duundɛ ɣöö cucni kɛ ɣä kɛɛl kɛ kui̱ thukni ti gɔw kä ŋäth ni buɔ̱m Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cɛ kɔn kän, kä cɛ kɔn cɔl ala nɛɛkɛ ti rɛl rɔ, kä /ciɛ kui̱ lätnikɔn kä duundɛ ɣöö ɛ kui̱ cäpädɛ pa̱ny kɛnɛ puɔ̱thdɛ. Jɛn puɔ̱th ɛmɔ ca jɛ ka̱m kɔn rɛy Kritho Yecu /ka̱n gua̱a̱th ni tok. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö ɛn täämɛ ca jɛ nyoth kɛ jɔac Käänädan ni Kritho Yecu, min cɛ lia̱a̱ woc, kä cɛ tëk mi do̱raar mi /ci bi met thil nööŋ buɔyä kɛ thuk ti gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ thukni ti gɔw ti̱ti̱ ca ɣä mɛk ala läätdiɛn, kä jak, kä ŋi̱i̱c, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱ ɛmɔ ruɔ̱ɔ̱tdä bɛ̈c bɛ̈ɛ̈c kɛ ɣöö la̱tdä. Kä ɣän /cä po̱c, kɛ ɣöö ŋa̱cä ram min ŋa̱a̱thä, kä ŋa̱cä jɛ ɛn ɣöö tëëkɛ lua̱ŋ kɛ ga̱ŋ kä min ca la̱th tetädä amäni cäŋ ɛmɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guurni ŋi̱i̱c in cuŋ in ci liŋ kä ɣä, rɛy ŋäthä kɛnɛ nhök tin te rɛy Kritho Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaŋ thuɔ̱k in ca la̱th tetädu kɛ luäk Yieekä in Gɔaa in Rɛl Rɔ min cieŋ rɛydan.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋäci jɛ ɛn ɣöö nɛy diaal tin te kä E-cia ci kɛn ɣä ba̱ny piny, amäni Pi-jɛl-äth kɛnɛ Ɣer-mɔ-jɛ-nith. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Kuäär ni Yecu käm ji̱ dhɔaar O-nɛ-thi-po-räth kɔ̱a̱c lɔaac, kɛ ɣöö cɛ puɔ̱nydä bum gua̱thni ti ŋuan, kä /kenɛ pöc kɛ kuatni yieenädä. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ cop kä Röm, cuɛ ɣä go̱r kɛ di̱t lɔaac, kä cuɛ ɣä jek. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.17",
            "verseOrgIds": [
              "2TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Kuäär nhɔkɛ ɛn ɣöö bɛ kɔ̱a̱c lɔaac jek ɛn cäŋ ɛmɔ! Kä ŋäc yɛn ɛ gɔaa ɛn ɣöö cɛ ɣä lätikä kä Ɛ-pɛ-thäth.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.18",
            "verseOrgIds": [
              "2TI.1.18"
            ]
          }
        }
      ]
    }
  ],
