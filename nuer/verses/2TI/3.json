        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ni̱n tin jɔak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋäcni nɛmɛ ɛn ɣöö kɛ ni̱n guutdä bi gua̱a̱th rikä ben. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi naath a nhɔk ni pua̱nykiɛn, bi kɛn a nhöök yio̱o̱ni, kä ji̱ liakä, ti ji̱ thuɔk jiääk, ji̱ kueethä, ti /ca diëëthkiɛn luth, ti thil tɛ̈th lɔaac, ti thil Kuoth, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nɛy ti /ci a naath, ti thil pälikä, ji̱ luɔm, ti ji̱ gaak, ti ji̱ ŋɛnyni, ti löök gɔyni, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti la kɔakɛ naath, ti /ci riɛk, ti cɛ kɔ̱p kɛ liak, ti nhɔakɛ ni nyin tɛthä lɔaac kä nhök Kuɔth, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ti jɔc raar ɛn ɣöö kɛ ji̱ Kuɔth, kä gaak kɛn buɔ̱mdɛ. Nɔ̱ɔ̱ni rɔ̱ kɛ nɛy ti ce̱tkɛ tɔ̱tɔ̱! ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö te rɛydiɛn kɛ nɛy ti coth rɛy dho̱ri, ti ka̱pkɛ män ti jiäk piny tin ci thia̱a̱ŋ kɛ duer tin böthkɛ ɛ gör kä ti jiäk, ti ŋuan, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "tin la ruac nɛɛni diaal a liŋ, kä /cikɛ dee met cop kɛ ŋäc thukä. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tkɛ mëë ci Jä-nɛth kɛnɛ Jam-bɛ-rɛth ruac Muthɛ gak, inɔ bä ci nɛy tɔ̱tɔ̱ thuɔ̱k gak, nɛy tin ci ca̱r wecdiɛn nyuɔɔn ti thil ŋa̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cikɛ bi räth ɛlɔ̱ŋ, kɛ ɣöö bi dɔ̱ɔ̱riɛn jɔɔc nhiam nɛɛni diaal ce̱tnikɛ jɔac dɔ̱ɔ̱rä wutni da̱ŋ rɛw.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruaacni tin jɔak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ci ŋi̱i̱cdä guɔ̱ɔ̱r, kɛ ciaaŋdä, kɛ luɔt teekädä, kɛ ŋa̱thdä, kɛ biɛtdä, kɛ nhökdä, kɛ cuɔ̱ɔ̱ŋdä a bum, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ muɔ̱cdä kɛ riɛk, kɛ cuɔ̱cdä, kɛ tëë ci tuɔɔk kä ɣä kä Ɛ̈n-ti-ɔk, kɛnɛ Ay-ko-niäm, kɛ Lith-tɛ-ra, kɛ kɛn rik tëë cä rut! Kä duundɛ ɣöö ci Kuäär ni Yecu ɣä kän kä kɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛpuc, nɛy diaal tin görkɛ ciaaŋ teekä Kuɔth rɛy Kritho Yecu bakɛ ciɛŋ a jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö bi nɛy ti jiäk, kɛnɛ nɛy tin thil ca̱p wäkɛ wä nhiam kɛ jiääkdiɛn ɛlɔ̱ŋ, mɛ̈tkɛ naath, kä mɛ̈tkɛ kɛ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱du, ŋotni kä min ci ŋa̱c, kä cuŋni a bum rɛy ŋäthädɛ, a ŋäci ram ëë nyuth ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä timɛ ni gaatädu ɛn ɣöö ŋäci Ruac Kuɔth in Rɛl Rɔ. Ruaacni tin tekɛ lua̱ŋ kɛ nyuuthdu kɛ kui̱ känä kɛ ŋa̱th Kritho Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruac Kuɔth kɛɛliw ŋunɛ Kuoth, kä gɔaaɛ kɛ kui̱ ŋi̱i̱cä, kɛnɛ kui̱ luekä kä mi jiääk, kɛ kui̱ nyuuthä dui̱rä, kɛnɛ kui̱ ŋi̱i̱cä ciɛŋä cuŋni, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö dee raan Kuɔth ro̱ŋ agɔaa diaal tin go̱o̱rɛ kɛ kui̱ lätni diaal ti gɔw.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
  ],
