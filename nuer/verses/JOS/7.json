              "JOS.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, cu Jɔ-cua naath ku ja̱k, kä cukɛ riŋ rɛy kɛmɛkä, kä cua kɛ wä je̱k piny rɛy kɛmɛkädɛ kä te yieeth pinydiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.22",
            "verseOrgIds": [
              "JOS.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ kɛ ka̱n kä cukɛ kɛ nöŋ Jɔ-cua kɛnɛ ji̱ I-thɛ-rɛl diaal. Kä cukɛ kɛ ben la̱th piny nhiam Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
            "verseOrgIds": [
              "JOS.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn, cu Jɔ-cua kɛɛl kɛ ji̱ I-thɛ-rɛl diaal A-ka̱n käp kɛnɛ läŋ yie̱e̱thä kɛ bi̱i̱ in bäär kɛ jɛn ciɛk dääpä, matdiɛn diaal amäni gaat A-ka̱n, ɣɔ̱ɔ̱kɛ kɛ muɔ̱likɛ kɛnɛ detkɛ, kɛmɛdɛ kɛnɛ ŋɔakɛ tin kɔ̱kiɛn diaal, kä cukɛ kɛ naŋ guäth mi cɔal i̱ Ta̱p A-kor.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:24",
              "type": "text"
            },
            {
              "text": "Ta̱p A-kor",
              "type": "text"
            },
            {
              "text": "Ɛmɔ lotdɛ ni ɣöö ta̱p rikni kɛ thok Nath.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wani, cu Jɔ-cua jɛ jiök i̱, “Min mooci ni kɔ riɛk ɛmɛ biɛ dhil lar. Kä ɛn wa̱lɛ bi Kuoth Nhial ji̱ lɛ moc riɛk.” Cukɛ A-ka̱n bök kɛ pääm ɛ kɛn diaal, kä cukɛ ji̱ cieeŋdɛ näk kɛ bo̱kni, kä cukɛ kɛ cua̱th kɛn diaal amäni nyinkɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ A-ka̱n di̱er piny kɛ buɔ̱n päämni ti te thi̱n amäni wa̱lɛ. Ɛ jɛn luɔt kä min cɔaalkɛ gua̱a̱th ɛmɔ i̱ Ta̱p A-kor amäni wa̱lɛ. Ɛ jɛn, cu Kuoth Nhial ŋɛ̈ɛ̈nydɛ cu luäär.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        }
      ]
    }
