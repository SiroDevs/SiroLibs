{
  "id": "JOS.19",
  "number": "19",
  "bookId": "JOS",
  "reference": "Jɔc 19",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 51,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JOS 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guɔ̱l rööl ëë ci pɛn kä Cim-on",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cua gaak in rɛwdɛ yuɔr kä cuɛ pɛ̈ɛ̈n kɛ kui̱ döör gan Cim-on nikɛ pëk gɔalikiɛn. Kä cu key rööliɛn rɔ wä pi̱em ni ro̱o̱l döör Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.1",
            "verseOrgIds": [
              "JOS.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ mat ni Ber-cɛ-ba kɛnɛ Cɛba kɛ Mo-la-dha. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.2",
            "verseOrgIds": [
              "JOS.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëë kɛ Ä-dhar-caal bä kɛnɛ Bala kɛ A-dhɛm ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.3",
            "verseOrgIds": [
              "JOS.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛl-to-lad kɛnɛ Bɛ-thul kɛ Ɣɔr-ma ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.4",
            "verseOrgIds": [
              "JOS.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Dhik-lag kɛnɛ Beth-mar-ka-both kɛ Ä-dhar-thu-tha ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.5",
            "verseOrgIds": [
              "JOS.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Beth-lɛ-booth kɛnɛ Ca-ru-wɛn, rɛ̈k da̱ŋ wäl wi̱cdɛ diɔ̱k kɛnɛ dho̱rkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.6",
            "verseOrgIds": [
              "JOS.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te A-yin thi̱n bä kɛnɛ Ri-mon kɛ Ɛ-thɛr kɛ A-can. Rɛ̈k da̱ŋ ŋuaan kɛnɛ dho̱rkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.7",
            "verseOrgIds": [
              "JOS.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matdiɛn amäni dho̱r diaal tëë thie̱e̱k kɛ rɛ̈k tɔ̱tɔ̱ wëë yiath ni Baa-lath-beer kɛ Rama kä Nɛ-gɛb. Nɛmɛ ɛ jɛn guɔ̱l rööl ëë ci rɔ yiɛth kɛ do̱r gan Cim-on nikɛ pëk gɔalikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.8",
            "verseOrgIds": [
              "JOS.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kui̱c döör gan Cim-on ɛmɛ, ɛ tɛ̈m kä guɔ̱l ëë ca tëm do̱r gan Juda kɛ ɣöö mun ëë ci pɛn kä Juda di̱tdɛ ɛlɔ̱ŋ kɛ kɛ ci gaat Cim-on kui̱cdiɛn cu ka̱n rɛy duŋädiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Guɔ̱l ëë yiɛɛth rɔ kɛ Dhɛ-bu-lun",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.9",
            "verseOrgIds": [
              "JOS.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu gaak in diɔ̱ɔ̱kdiɛn pɛn kä do̱r gan Dhɛ-bu-lun nikɛ pëk gɔalikiɛn. Kä cu pëkdiɛn rɔ wä pi̱em ni Tha-ridh. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.10",
            "verseOrgIds": [
              "JOS.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu keydiɛn ɛ cuat kui̱c in jay kony cäŋ kä Ma-rääl, räth ni Dha-ba-cɛt kä wëë pal ni waaŋ in te nhiam Yɔk-naam. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.11",
            "verseOrgIds": [
              "JOS.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ rɔ nyɔk kɛ ri̱t kui̱c käny cäŋ kä Tha-ridh bi wä pɛn ni rɛy Kith-loth-ta-bor, kä bɛ pal ni Da-bɛ-rath kä bɛ rɛ̈t ni Ya-pia. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.12",
            "verseOrgIds": [
              "JOS.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn thɔ̱ŋi cuɛ jɛ rɛ̈t ni Gɛ̈th-ɣe-pɛr in te kui̱c cueec lotdä min jay ni käny cäŋ, kɛnɛ Eth-ka-dhin, kä bɛ wä pal ni Ri-mon kä cuɛ jɛ gɔ̱a̱l kä Neya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.13",
            "verseOrgIds": [
              "JOS.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu key rɔ gɔ̱a̱l kä A-na-thon lotdä kayŋua̱a̱k kä cu pëkkɛ diaal wä pal ni paan täpä I-pa-tel, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.14",
            "verseOrgIds": [
              "JOS.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ Ka-tath kɛ Nää-lal kɛ Cim-rɔn kɛ I-dhä-la kɛnɛ Beth-lɛ-ɣɛm. Rɛ̈k da̱ŋ wäl rɛw, kɛ dho̱rkiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.15",
            "verseOrgIds": [
              "JOS.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn kui̱c ëë yiɛɛth rɔ kɛ gaat Dhɛ-bu-lun nikɛ pëk gɔalikiɛn, kɛn rɛ̈k tɔ̱tɔ̱ amäni dho̱rkiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kui̱c ëë yiɛɛth rɔ kɛ Yi-tha-kar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.16",
            "verseOrgIds": [
              "JOS.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu gaak in ŋuaandiɛn pɛn kä Yi-tha-kar kɛ kui̱ gankɛ nikɛ pëk gɔalikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.17",
            "verseOrgIds": [
              "JOS.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu key dhɔriɛn rääth ni kui̱c Yidh-rɛɛl kɛnɛ Kɛ-thu-loth, kɛ Cu-nem. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.18",
            "verseOrgIds": [
              "JOS.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ Ä-pa-ra-yim kɛnɛ Cion, kɛ Ä-na-ɣä-rath, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.19",
            "verseOrgIds": [
              "JOS.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ra-bith kɛnɛ Kic-yon, kɛ A-bɛdh ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.20",
            "verseOrgIds": [
              "JOS.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Rɛ-mɛth kɛnɛ Een-ga-nim, kɛ Een-a-da, kɛ Beth-pa-dhedh. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.21",
            "verseOrgIds": [
              "JOS.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu räth ni Ta-bor kɛnɛ Cää-dhi-ma kɛ Beth-cɛ-mɛc. Kä cu pëk këthdiɛn wä ni Jɔr-dɛn. Rɛ̈k da̱ŋ wäl bäkɛl kɛ dho̱rkiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.22",
            "verseOrgIds": [
              "JOS.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn pëk ëë yiɛɛth rɔ kɛ do̱r gan Yi-tha-kar nikɛ pëk gɔalikiɛn kɛn rɛ̈k tɔ̱tɔ̱ amäni dho̱rkiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kui̱c ëë yiɛɛth rɔ kɛ A-cɛr",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.23",
            "verseOrgIds": [
              "JOS.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu gaak in dhieecdiɛn pɛn kä do̱r gan A-cɛr nikɛ pëk gɔalikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.24",
            "verseOrgIds": [
              "JOS.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu keydiɛn rɔ lɔth ni kä Ɛl-kath, kɛ Äli, kɛ Bɛ-tɛn, kɛ Ak-cap, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.25",
            "verseOrgIds": [
              "JOS.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ A-la-mɛ-lɛk, kɛ A-mad, kɛ Mi-cal kä cuɛ räth ni Kar-mɛl kä kony cäŋ wä amäni Ci-ɣor-lib-nath. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.26",
            "verseOrgIds": [
              "JOS.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ri̱i̱tdɛ rɔ kɛ kui̱c känyä ca̱ŋ cuɛ wä ni Beth-da-gon kä cuɛ räth ni paan täpä I-pa-tel in lot ni kui̱c kayŋua̱a̱k Beth-e-mɛk kɛnɛ Ni-el, kä bɛ pal ni Ka-bul kui̱c caam. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.27",
            "verseOrgIds": [
              "JOS.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ Ab-don kɛ Rɛ-ɣob, kɛ Ɣa-mɔn, kɛnɛ Kana wëë yiath ni Dhi-don in di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.28",
            "verseOrgIds": [
              "JOS.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu key rɔ gɔ̱l kɛ Rama kä cuɛ wä ni Dhor in la rɛk in ca kal ni bum, kä cuɛ rɔ gɔ̱a̱l Otha kä cu pëk këthdɛ wä ni Bar in Bo̱r in te kam wi̱i̱ni cuɛ jɛ ka̱n ni kä Maa-leb wëë yiath ni Ak-dhib, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.29",
            "verseOrgIds": [
              "JOS.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "amäni Ömaa, kɛnɛ Ä-pek, kɛ Rɛ-ɣob, rɛ̈k ti jiɛn da̱ŋ rɛw wi̱cdiɛn rɛw amäni dho̱rkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn rɛ̈k ti̱ti̱ amäni dho̱rkiɛn kɛɛl ɛ jɛn kui̱c ëë yiɛɛth rɔ kɛ do̱r gan A-cɛr nikɛ pëk gɔalikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kui̱c ëë yiɛɛth rɔ kɛ Nap-ta-li",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.31",
            "verseOrgIds": [
              "JOS.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ kɛ kui̱ gan Nap-ta-li cu gaak in bäkɛliɛn pɛ̈ɛ̈n, cuɛ pɛn kä kɛ ni pëk gɔalikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.32",
            "verseOrgIds": [
              "JOS.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu key rööliɛn rɔ lɔth ni kä E-lɛp wëë yiath ni jiaath in te kä Dhä-nä-nim, kɛ La-kum kä cuɛ jɛ wä giɛk ni Jɔr-dɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
              "JOS.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn thɔ̱ŋi cu key ciɛc kä cuɛ jɛ rɛ̈t kä Adh-noth-ta-bor, kä cuɛ pal ni U-kok, kä cuɛ räth ni Dhɛ-bu-lun kui̱c targɛ̈w, kä cuɛ wä ni A-cɛr kui̱c konyä ca̱ŋ kɛ Juda kui̱c känyä ca̱ŋ kä Jɔr-dɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn rɛ̈k tin ca kal ni bum kɛn tin, Dhi-dim, Dhër, Ɣa-math, Ra-kath, kɛ Ki-nɛ-rɛth, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.35",
            "verseOrgIds": [
              "JOS.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ä-dha-ma, kɛ Rama, kɛ Ɣa-dhor, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.36",
            "verseOrgIds": [
              "JOS.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Kɛ-dɛc kɛnɛ Ɛ-dhɛ-ri, kɛ Een-a-dhor ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.37",
            "verseOrgIds": [
              "JOS.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Yir-on kɛnɛ Mig-dal-el, kɛ O-rem, kɛ Beth-ä-nath, kɛnɛ Beth-cɛ-mɛc. Mat rɛ̈kni da̱ŋ wäl wi̱cdiɛn bäŋuan kɛ dho̱rkiɛn kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.38",
            "verseOrgIds": [
              "JOS.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn kui̱c rööl ëë yiɛɛth rɔ kɛ do̱r gan Nap-ta-li nikɛ pëk gɔalikiɛn, kɛn rɛ̈k amäni dho̱rkiɛn kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kui̱c ëë yiɛɛth rɔ kɛ Daan",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.39",
            "verseOrgIds": [
              "JOS.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu gaak in bärɔwdiɛn ku pɛn kä do̱r gan Dan nikɛ pëk gɔalikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.40",
            "verseOrgIds": [
              "JOS.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu key rööliɛn rɔ tok ni kä Dhɔra, kɛ Ɛc-tool, kɛ Ir-cɛ-mɛc, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.41",
            "verseOrgIds": [
              "JOS.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Cää-la-bin, kɛ A-ya-lon, kɛ Ith-la, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.42",
            "verseOrgIds": [
              "JOS.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ee-lon, kɛ Tim-naa, kɛ Ɛk-ron, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.43",
            "verseOrgIds": [
              "JOS.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛl-tɛ-ke, kɛ Gi-bɛ-thon, kɛ Bää-lath, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.44",
            "verseOrgIds": [
              "JOS.19.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 19:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Yööd, kɛ Bɛ-ni-bɛ-rak, kɛ Gɛ̈th-ri-mon, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.45",
            "verseOrgIds": [
              "JOS.19.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 19:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Me-yar-kon, kɛ Ra-kon, kä wä key rɔ yi̱th nikɛ Yapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.46",
            "verseOrgIds": [
              "JOS.19.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 19:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci mun gan Dan kuɛ̈ɛ̈k kä kɛ, cukɛ Lɛ-cɛm mak, kä cukɛ jɛ ka̱n, cukɛ ji̱kɛ diaal näk, kä cukɛ jɛ ma̱c rɔ̱, cukɛ nyuur thi̱n kä cukɛ ciötdɛ ni Lɛ-cɛm ri̱t ala Daan nikɛ ciöt gua̱ndiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.47",
            "verseOrgIds": [
              "JOS.19.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ ɛ jɛn kui̱c ëë yiɛɛth rɔ kɛ gaat Dan nikɛ pëk gɔalikiɛn, kɛn rɛ̈k diaal ti̱ti̱ amäni dho̱rkiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kui̱c ëë yiɛɛth rɔ kɛ Jɔ-cua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 19:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mëë ci gaat I-thɛ-rɛl ku thuɔ̱k kɛ däkni piɛny kä rɔ̱diɛn, cukɛ Jɔ-cua gat Nun moc gua̱a̱th mi mɔ kui̱c rööl ëë da̱kɛ kä rɔ̱. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikɛ ruac ëë ci Kuoth Nhial ɛ lar, cukɛ jɛ ka̱m rɛk ëë kɔŋɛ thiec rɔ, jɛn rɛk in cɔal i̱ Tim-na-thɛ-ra wi̱i̱ pa̱a̱m Ɛ-pa-rim. Kä cu Jɔ-cua ɛ nyɔk kɛ ta̱th kä cuɛ nyuur thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 19:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tɔ̱tɔ̱ kɛ kɛn gua̱th tëë ci bo̱o̱th palä ni Ɛl-a-dhar kɛnɛ Jɔ-cua gat Nun, kɛɛl kɛ bööth thukni duëli dööri gan I-thɛ-rɛl diaal, kɛ da̱k kɛ kui̱diɛn kä cuɛ la̱t Kuɔth Nhial thi̱ec thi̱n kɛ gaakni kä Cilo thok luaak matdä ji̱ Kuɔth Nhial. Inɔ cu piny cu thuuk kɛ däkni.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.51",
            "verseOrgIds": [
              "JOS.19.51"
            ]
          }
        }
      ]
    }
