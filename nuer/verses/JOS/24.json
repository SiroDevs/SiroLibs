            "number": "33",
            "style": "v",
            "sid": "JOS 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu Ɛl-a-dhar gat Ä-ron li̱w, kä cua kony kä Giba, jɛn rɛk in te ro̱o̱l päämni Ɛ-pa-rim mëë ca ka̱m gatdɛ ni Pi-nɛ-ɣath.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.33",
            "verseOrgIds": [
              "JOS.24.33"
            ]
          }
