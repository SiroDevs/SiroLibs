          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ kɛn cɔ̱w pua̱a̱ny Jo-thɛp tëë ci ji̱ I-thɛ-rɛl kɛ nööŋ kä I-jëp, cua kɛ ben kony kä Cɛ-kɛm rɛy kakä muɔ̱ɔ̱n ëë ci Je-kɔb ɛ kɔk kä gaat Ɣä-mor, in la gua̱n Cɛ-kɛm, kɛ yio̱w ti kuɔ̱r, jɛn mun ɛmɛ cuɛ pɛn kä kuay Jo-thɛp.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        }
      ]
    },
    {
