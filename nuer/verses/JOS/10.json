          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn cäŋ ɛmɔ cukɛ jɛ ka̱n, kä cukɛ jɛ däk kɛ mutdiɛn kä cuɛ nɛy diaal tëë te rɛydɛ nor ɛn cäŋ ɔ ce̱tnikɛ mëë cɛ lät kä La-kic.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.35",
            "verseOrgIds": [
              "JOS.10.35"
            ]
          }
        }
      ]
