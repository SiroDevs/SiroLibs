          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ räth kä La-kic jiɛnädɛ kä Lib-na, jɛn kɛnɛ gaat I-thɛ-rɛl diaal, kä cukɛ jɛ go̱l kä cukɛ jɛ lep ko̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɛ thöp kɛ bäkɛ cäŋ in rɛwdɛ, kä cukɛ jɛ däk kɛ mutdiɛn kä cukɛ ji̱kɛ diaal la̱t ce̱tnikɛ duŋ Lib-na.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
