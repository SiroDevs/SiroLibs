    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lɔ̱a̱ŋ in ci Kuɔth ɛ lar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ min ŋot lär kä ɣöö banɛ wä lɔ̱ŋädɛ thi̱n, kuanɛ rɔ̱ niɛk kɛ ɣöö a jɛ thil ram kɛl kä yɛ mi /ci bi cop thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö canɛ thuk ti gɔw liŋ ce̱tkɛ kɛ, duundɛ ɣöö ruac in ci kɛn ɛ liŋ thilɛ mi gɔaa mi cɛ lät kä kɛ, kɛ ɣöö /kenkɛ min ca liŋ nhɔk kɛ ŋa̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɔn nɛy tin ŋa̱th banɛ wä rɛy lɔ̱ŋä ce̱tkɛ min ci Kuoth ɛ lar i̱,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:3",
              "type": "text"
            },
            {
              "text": "Diit 95:11.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ruac Kuɔth tëkɛ, kä lätdɛ ɛlɔ̱ŋ, leny muɔthdɛ muɔ̱th thɛpä mi ca thɛr kui̱cnikɛ da̱ŋ rɛw, la yiethɛ amäni mi cɛ tieey kɛnɛ yiëë da̱a̱k, kɛ kam cɔ̱ɔ̱ni kɛnɛ kua̱th, kä lukɛ cär lɔaac ran. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ mi ca cak mi dëë tɛ̱̈ɛ̱̈ kä jɛ, kä kɛn diaal jɔckɛ kä tekɛ ɣo̱o̱ŋä nhiamdɛ ɛn ram min banɛ rɔ̱ wä lat nhiamdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yecu ɛ bo̱o̱th palä min di̱i̱t",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö ta̱nɛ kɛ bo̱o̱th palä in di̱i̱t min ci wä nhial, ni Yecu Gat Kuɔth, kuanɛ ŋa̱thdan in latnɛ käp a bum. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö thilɛ kɔn bo̱o̱th palä in di̱i̱t mi /ci dee te kɛɛl kɛ kɔn rɛy nyuänädan, ta̱nɛ kɛ bo̱o̱th palä mi ca ɣɔ̱n kɛ dup diaal ce̱tkɛ kɔn, kä duundɛ ɣöö thilɛ jɛ duer. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ, kuanɛ rɔ̱ ti̱ec thiäkä nhiam Kuɔth guäth puthä, kɛ ɣöö dënɛ kɔ̱a̱c lɔaac kɛnɛ puɔ̱th baaŋ jek kɛ gua̱a̱th in gör nɛ luäk.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
