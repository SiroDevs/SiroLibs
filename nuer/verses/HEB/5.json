      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bööth palä diaal tin ca kuany rɛy nath kuanykɛ kɛ kɛ ɣöö bikɛ Kuoth lätikä kɛ kui̱ nath, kɛ ɣöö ba muc kɛnɛ loori thöp Kuoth kɛ kui̱ dueeri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn min kɔ̱cɛ, cuɛ luäŋ ɛn ɣöö bɛ lät agɔaa kɛ nɛy tin kueckɛ ŋu tin la̱tkɛ jiäk a kueckɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ, jɛn bɛ muc thöp kɛ kui̱ dueerikɛ, kɛnɛ kui̱ dueeri nɛɛni tɔ̱tɔ̱ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ci raan rɔ dee la̱th ɛn guäth luthä nɔmɔ, wä raan thi̱n a cɔɔlɛ Kuoth, ce̱tkɛ mëë te Ä-ron.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ bä, /ken Kritho rɔ mɛk kɛ ɣöö bɛ la bo̱o̱th palä in di̱i̱t, duundɛ ɣöö kuanyɛ ram ëë jio̱k jɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:5",
              "type": "text"
            },
            {
              "text": "Diit 2:7.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni̱ni tëë cieŋ Yecu wi̱i̱ muɔ̱ɔ̱n, cuɛ pal kä la̱ŋɛ kɛ jɔw mi di̱i̱t kɛ wiee, palɛ Kuoth in tekɛ lua̱ŋ kɛ ka̱ndɛ li̱th, kä cua palɛ liŋ kɛ kui̱ luthädɛ kɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cäŋɛ mëë ɛ Gat Kuɔth, cuɛ luth Kuɔth ŋa̱c kɛ ruɔ̱tdɛ kɛ ti bɛ̈c bɛ̈ɛ̈c. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö ca jɛ jakä thil diw, cua jɛn min tho̱p ka̱n in do̱raar nɛy diaal tin luɔ̱thkɛ jɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9",
            "verseOrgIds": [
              "HEB.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth ɛ kuany ala bo̱o̱th palä in di̱i̱t ce̱tkɛ Mal-ki-dhɛ-dɛk.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lui̱k kɛ kui̱ bänyä ŋäthä piny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.10",
            "verseOrgIds": [
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä mɛmɛ ta̱kɔ kɛ ti ŋuan ti dëëkɔ lat, kä jɛn bum latdɛ, kɛ ɣöö kuiy ŋäcdun. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.11",
            "verseOrgIds": [
              "HEB.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ ca gua̱a̱th mi bäär kɛ ɣöö dee yɛn a ŋi̱eec, kä go̱o̱r yɛn ram mi bi yɛ nyɔk kɛ ŋi̱i̱c kɛ ŋi̱i̱c in nhiam kɛ ruac Kuɔth. Go̱o̱rɛ yɛn ni cak, kä ɣöö dërɛ cam ni mi̱eth mi bum. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.12",
            "verseOrgIds": [
              "HEB.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mi rueeth ni cak, ŋotdɛ ɛ gat mi tɔt, jɛn ŋotdɛ kui̱cɛ ŋi̱i̱c in la cuɔ̱ɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.13",
            "verseOrgIds": [
              "HEB.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi̱eth mi bum ɛ mi̱eth nɛɛni ti ci dit, nɛy ti kɛ lät cikɛ tekɛ lua̱ŋ kɛ dääk kä mi gɔaa kä mi jiääk.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.14",
            "verseOrgIds": [
              "HEB.5.14"
            ]
          }
        }
      ]
    }
