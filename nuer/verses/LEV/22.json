              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba jɛ cam niɛ cäŋ ɔ, thil ɛ mi bi duɔth mi bi runwaŋ cop. Ɛ ɣän Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
