        },
        {
          "text": "“Inɔ tiɛtdɛ ŋuɔ̱tkä kä la̱t ɛ kɛ. Ɛ ɣän Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
