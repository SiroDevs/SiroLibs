              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wee muc tɛthkä lɔaac wä thöp Kuoth Nhial, guuri ŋuɔ̱tkɛ kɛ ɣöö ba jɛ nhök yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
