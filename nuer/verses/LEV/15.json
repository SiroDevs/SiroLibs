              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bädäk ni̱ni bɛ rɔ moc guɔ̱kni rɛw kiɛ kunnööri rɛw kä bɛ kɛ ben ka̱m bööth palä thok kɛmɛkä ro̱mä kɛ Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
