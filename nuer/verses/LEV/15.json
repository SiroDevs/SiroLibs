              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä kɛl thöp ala luur dui̱rä kä bi min dɔ̱ŋ a luur mi waŋkɛ, bɛ ciek ɛmɔ cu luɛl nhiam Kuɔth Nhial kɛ kui̱ thëkdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
