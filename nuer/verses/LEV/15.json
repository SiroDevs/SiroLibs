  "copyright": "PUBLIC DOMAIN",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "LEV 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Löny pua̱ny ti nööŋkɛ jiäk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ kɛnɛ Ä-ron jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jiökɛ ji̱ I-thɛ-rɛl i̱, mi wä raan puɔ̱nydɛ wä löny kɛn lony ɛmɔ, jiäkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.2",
            "verseOrgIds": [
              "LEV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi lönyɛ kiɛ cɛ cuɔ̱ŋ cɛ puɔ̱nydɛ jak kä jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.3",
            "verseOrgIds": [
              "LEV.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dhaŋ ɔ bɛ tɔ̱ɔ̱c thi̱n ɔ cɛ jiäk kä mi cɛ nyuur thinɔ bɛ jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.4",
            "verseOrgIds": [
              "LEV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn ram ɔ bi dhaŋdɛ nyɔt ɔ a jɛ lak bieyni kɛ, kä bɛ puaak, kɛ ɣöö bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn ram ɔ bi nyuur guäth in cɛ nyuur thi̱n ɔ, a jɛ lak bieynikɛ kä a jɛ puaak, bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ɔ bi puɔ̱nydɛ thiap ɔ, a jɛ lak bieynikɛ kä bɛ puaak, bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wee raan wä ŋuɔ̱l ruɛy, a jɛ lak bieynikɛ ɛn raam ɔ kä bɛ puaak, bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ cɛ cɛ jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn ram ɔ bi duɔ̱ɔ̱r thiap ɔ kä tin ci gua̱n lonyä nyuur thi̱n tɔ, bɛ jiääk mäni thiaŋ. Kä ram ɔ bi tɔ̱tɔ̱ kap nhial ɔ, a jɛ lak bieynikɛ, kä a jɛ puaak bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ɔ bi gua̱n lonyä jɛ nyɔt ɔ kä cɛ tetkɛ bi lak, a jɛ lak bieynikɛ kä bɛ puaak, bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dhaar ɛ bɛ nyɔt ɔ, a jɛ tiath kɛ, kä tin la̱tkɛ kɛ jiɛɛn ba kɛ lak kɛ pi̱.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛ kɔr kä min ci lönydɛ gɔaa ɛn gua̱n lönyä, a jɛ li̱p kɛ ni̱n bärɔw kɛ kui̱ la̱kdɛ, kä bɛ bieynikɛ cu lak, kä bɛ puaak pi̱i̱ni ti te lony, bɛ cu gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bädäk ni̱ni bɛ rɔ moc kɛ guɔ̱kni rɛw kiɛ kunnööri rɛw, kä bɛ ben nhiam Kuɔth Nhial thok kɛmɛkä ro̱mä kɛ Kuoth Nhial, kä bɛ kɛ ka̱m bööth palä, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi bööth palä kɛ thöp ala muc, kɛl ba luur dui̱rä bi min dɔ̱ŋ a luur mi waŋkɛ, bɛ raam ɔ cu luɛl nhiam Kuɔth Nhial kɛ kui̱ lönyädɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä wut la̱k wä läkikä, a jɛ lak puɔ̱nydɛ ni kɛɛliw, kä bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn bi̱i̱ ɛ ci ti̱i̱y pɛn thi̱n ɔ kiɛ köl, a jɛ lakkɛ, bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci wut tɔ̱ɔ̱c kɛ ciek, akɛ puakɛ rɔ, kä bikɛ jiääk mäni thiaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi thek ciek ce̱tkɛ ta̱a̱dɛ min wen, bɛ tekɛ jɛ kɛ ni̱n bärɔw. Kä ram mi wä jɛ nyɔt bɛ jiääk mäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tin diaal tin cɛ tɔ̱ɔ̱c thi̱n guäth in thekɛ cɛ jiääk. Kä tin cɛ nyuur thi̱n bä cikɛ jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn ram ɔ bi kölɛ nyɔt ɔ a jɛ lak bieynikɛ kä bɛ puaak bɛ jiääk amäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn ram ɔ bi duɔ̱ɔ̱r mi cɛ nyuur thi̱n thiap ɔ, a jɛ lak bieynikɛ kä a jɛ puaak, bɛ jiääk amäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ɛ köl kiɛ ŋu cɛ nyuur thi̱n ɔ, mi wi̱i̱ jɛ wä nyɔt bi jiääk amäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi te wut mi ci tɔ̱ɔ̱c kɛ jɛ guäth in thekɛ, bɛ jiääk kɛ ni̱n bärɔw, kä kölɔ cɛ tɔ̱ɔ̱c thi̱n ɔ cɛ jiääk.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi wä ciek wä thɛɛk kɛ pëk mi bäär a /cɛ ni̱nkɛ bäl tin la thek kɛ jɛ, kɛn ni̱n thek tɔ̱ diaal ɛ tɔ̱ bɛ kɛ thuk bäkɛ jiääk ce̱tnikɛ mëë thekɛ, bɛ jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn köl ɛ cɛ tɔ̱ɔ̱c thi̱n ɔ kɛ ni̱n thekädɛ, ba köl kɛ kui̱ thëkdɛ, kä mɔ cɛ nyuur thi̱n ɔ, bɛ jiääk ce̱tnikɛ thëkdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ɔ bi ti̱ti̱ nyɔt ɔ bɛ jiääk, a jɛ lak bieynikɛ kä a jɛ puaak bɛ jiääk amäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci thek thuɔ̱k, a jɛ kuɛn ni̱n bärɔw kɛ kɔriɛn bɛ cu gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
