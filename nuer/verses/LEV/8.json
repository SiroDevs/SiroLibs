          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lëy Ä-ron kɛnɛ gaatkɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.1",
            "verseOrgIds": [
              "LEV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“No̱o̱ŋni Ä-ron kɛnɛ gaatkɛ, kɛ bieynikiɛn, kɛ liɛɛth yi̱i̱rä, kɛ thäk luurä dui̱rä, kɛ rɔɔm da̱ŋ rɛw kɛ kɛ diëny mi te rɛydɛ kɛ jurayni ti thil thuɔp. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.2",
            "verseOrgIds": [
              "LEV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä a nɛy diaal mat kɛ rɔ thok kɛmɛkä ro̱mä kɛ Kuoth Nhial.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.3",
            "verseOrgIds": [
              "LEV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ ɛ la̱t ce̱tnikɛ min ci Kuoth Nhial ɛ la̱r jɛ, cu nɛy diaal rɔ dol thok kɛmɛkä ro̱mä kɛ Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.4",
            "verseOrgIds": [
              "LEV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ duɔl jiök i̱, “Nɛmɛ ɛ jɛn min ci Kuoth Nhial ɛ lar i̱ ba la̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.5",
            "verseOrgIds": [
              "LEV.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ Ä-ron kɛnɛ gaatkɛ cio̱l nhiam kä cuɛ kɛ ben puɔk kɛ pi̱. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.6",
            "verseOrgIds": [
              "LEV.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ luɔ̱t la̱th puɔ̱ɔ̱ny Ä-ron, kä cuɛ jɛ kum kɛ bi̱i̱ mi bäär kä cuɛ jɔkdɛ moc kɛ bi̱i̱ kath, kä cuɛ jɛ yiɛn kä puɔ̱ɔ̱nydɛ kɛ la̱a̱k mi ca tak ni kuurä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.7",
            "verseOrgIds": [
              "LEV.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ bi̱i̱ gɔ̱rä la̱th puɔ̱ɔ̱nydɛ kä cuɛ U-rim kɛnɛ Tu-mim la̱th thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.8",
            "verseOrgIds": [
              "LEV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wi̱cdɛ moc kɛ kum biey, mi cɛ nhiamdɛ moc yiöm dääpä min rɛl gɔɔydɛ rɔ ce̱tnikɛ min ci Kuoth Nhial ɛ la̱r Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.9",
            "verseOrgIds": [
              "LEV.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ liɛɛth yi̱i̱rä ka̱n kä cuɛ kɛmɛkä ro̱mä kɛ Kuoth Nhial yi̱r amäni tin diaal tin te rɛydɛ, cuɛ kɛ cu ley Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.10",
            "verseOrgIds": [
              "LEV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tha̱a̱ŋ liɛɛth kiɛth wi̱i̱ yi̱kä ni kä bärɔw, kä cuɛ yi̱r kɛ kɛ kuakɛ diaal, amäni thak la̱k nikɛ tharɛ, bikɛ cua ti ca ley Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.11",
            "verseOrgIds": [
              "LEV.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ tha̱a̱ŋ liɛɛth yi̱i̱rä wuɔ̱c wi̱i̱ Ä-ron, kä cuɛ jɛ yi̱r, kä cuɛ jɛ ley Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.12",
            "verseOrgIds": [
              "LEV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ gaat Ä-ron nööŋ kä cuɛ kɛ moc bieyni, kä cuɛ kɛ yiɛn kä pua̱nynikiɛn kɛ de̱p, kä cuɛ wuɔ̱thkiɛn moc kuɔ̱mni ce̱tnikɛ min ci Kuoth Nhial ɛ la̱r jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.13",
            "verseOrgIds": [
              "LEV.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn wa̱nɔ cuɛ ruath tha̱a̱k mi la luur dui̱rä nööŋ kä cu Ä-ron kɛnɛ gaatkɛ jɛ buk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.14",
            "verseOrgIds": [
              "LEV.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ jɛ näk, kä cuɛ tha̱a̱ŋ riɛm ka̱n, kä kɛ yiatdɛ cuɛ riɛm cua̱th tuɔ̱ŋni yi̱kä kä cuɛ jɛ ley Kuoth, kä cuɛ duɔth riɛm wuɔc thaar yi̱kä, kä cuɛ jɛ lak kä cuɛ cu ley Kuoth, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.15",
            "verseOrgIds": [
              "LEV.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cuɛ thiɔl jiɛcdɛ ka̱n kɛ li̱w, kɛnɛ go̱o̱k cua̱nydɛ amäni rokɛ kɛ kɛnɛ kɔalikiɛn kä cuɛ kɛ cu waŋ wi̱i̱ yi̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.16",
            "verseOrgIds": [
              "LEV.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö cuɛ kölɛ kɛnɛ ri̱ŋdɛ kɛ wawdɛ wä waŋ jɔk wec ce̱tkɛ min ci Kuoth ɛ la̱r ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.17",
            "verseOrgIds": [
              "LEV.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu Muthɛ thäk dɛ̈ɛ̈l rɔɔmä nööŋ ala muc mi waŋ kä cu Ä-ron kɛnɛ gaatkɛ jɛ buk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.18",
            "verseOrgIds": [
              "LEV.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ ɛ näk kä cuɛ riɛmdɛ kiɛth yi̱kä kui̱nikɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.19",
            "verseOrgIds": [
              "LEV.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min cɛ thuɔ̱k kɛ ŋuknidɛ cuɛ wi̱cdɛ kɛnɛ ri̱ŋdɛ kɛ thiɔlɛ cu waŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.20",
            "verseOrgIds": [
              "LEV.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ca nyin jiɛcdɛ diaal lak kɛnɛ kockɛ cu Muthɛ ɛ cu waŋ ɛn thäk dɛ̈ɛ̈l rɔɔmä kɛ lidɛ wi̱i̱ yi̱kä ce̱tnikɛ mëë cɛ la̱t jɛ, ala muc mi waŋ, kä cu ŋuänydɛ cua̱ mi gɔaa kä Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.21",
            "verseOrgIds": [
              "LEV.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ dɛl in dɔ̱ŋ nyɔk kɛ nööŋ, dɛl le̱yä, kä cu Ä-ron kɛnɛ gaatkɛ jɛ lɛni buk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.22",
            "verseOrgIds": [
              "LEV.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ jɛ näk, kä cuɛ tha̱a̱ŋ riɛm ka̱n kä cuɛ jɛ bat gokä jieth cuëëc Ä-ron kɛnɛ yiat tëtdä cueecdɛ in di̱i̱t, mäni yiat ciökä cueecdɛ min di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.23",
            "verseOrgIds": [
              "LEV.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gaat Ä-ron nööŋ nhiam kä cuɛ riɛm bat guɔ̱kni ji̱thni cueecdiɛn kɛ yɛt te̱tni cueecdiɛn tin di̱t, amäni yɛt ciökni cueecdiɛn tin di̱t, kä cuɛ riɛm cu kiɛth yi̱kä kui̱nikɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.24",
            "verseOrgIds": [
              "LEV.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thiɔlɛ kɛnɛ thiɔl jua̱a̱lɛ ka̱n nikɛ thiɔl jiɛcdɛ kɛɛliw amäni go̱o̱k cua̱nydɛ kɛ kɛ rokɛ nikɛ thiɔliɛn kɛ ɣäm cuëëc. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.25",
            "verseOrgIds": [
              "LEV.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ juray kɛl rɛy diëny jurayni ti /ka̱n la̱t kɛ thuɔp kä ca ley Kuoth Nhial ka̱n kɛ kɛ pat pat mi ca lia̱a̱p kɛ liɛɛth, kä cuɛ kɛ la̱th wi̱i̱ thiɔaal kɛnɛ ɣäm cuëëc. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.26",
            "verseOrgIds": [
              "LEV.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kɛn ti̱ti̱ diaal la̱th tëtdä Ä-ron kɛnɛ gaatkɛ kä cukɛ kɛ ben ŋuaŋ nhiam Kuɔth Nhial ala muc mi ŋuaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.27",
            "verseOrgIds": [
              "LEV.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ cu Muthɛ kɛ ka̱n tetnikiɛn kä cuɛ kɛ waŋ wi̱i̱ yi̱kä kɛ kɛ luur in waŋ ala muc lëyä mi tɛɛth ŋuänydɛ lɔc Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.28",
            "verseOrgIds": [
              "LEV.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kawdɛ lɛni ka̱n bä kä cuɛ jɛ ŋuëŋ Kuoth Nhial ala muc mi rɛl rɔ, ɛn kaw ɛmɔ ɛ jɛn cuɔ̱ɔ̱ŋ Muthɛ kä dɛl in lɛ̈ykɛ. Kä cuɛ jɛ la̱t ce̱tnikɛ min ci Kuoth Nhial ɛ la̱t jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
