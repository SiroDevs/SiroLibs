          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.29",
            "verseOrgIds": [
              "LEV.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ cu Muthɛ tha̱a̱ŋ liɛɛth yi̱i̱rä ka̱n, kɛnɛ tha̱a̱ŋ riɛm wec yi̱kä kä cuɛ kɛ ben kiɛth kä Ä-ron kɛn gaatkɛ amäni bieynikiɛn diaal, inɔ cuɛ Ä-ron kɛnɛ gaatkɛ cu ley Kuoth Nhial kɛ kɛ bieynikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ Ä-ron kɛnɛ gaatkɛ lɛni jiök i̱, “Ka̱nɛ ri̱ŋ kä wiaa thalɛ jɛ thok kɛmɛkä ro̱mä kɛ Kuoth Nhial kä camɛ jɛ ɛn wi̱ni kɛ jurayni tin te rɛy diëny luurä le̱yä, ce̱tnikɛ min ci Kuoth Nhial ɛ lar. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.31",
            "verseOrgIds": [
              "LEV.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä waŋɛ ri̱ŋ kiɛ juray ɛ bia doth ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.32",
            "verseOrgIds": [
              "LEV.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ jiɛc thok kɛmɛkä ro̱mä kɛ Kuoth Nhial kɛ ni̱n bärɔw amäni mi ci ni̱n leyädun thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.33",
            "verseOrgIds": [
              "LEV.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn la̱t ɛn wa̱lɛ mi ɛ jɛn min ca lar ɛ Kuoth Nhial i̱ ba lat kɛ lak dueerikun jɔ̱ɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.34",
            "verseOrgIds": [
              "LEV.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia te thok kɛmɛkä ro̱mä kɛ Kuoth Nhial kɛ wäär kɛnɛ cäŋdäär kɛ ni̱n bärɔw la̱tdɛ min ci Kuoth Nhial ɛ la̱r yɛ, kɛ ɣöö /cia bi li̱w. Nɛmɛ ɛ jɛn min ci Kuoth Nhial ɛ la̱t ɣä.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.35",
            "verseOrgIds": [
              "LEV.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Ä-ron kɛnɛ gaatkɛ la̱t ni min ci Kuoth Nhial ɛ lat kɛ thuk Muthɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.36",
            "verseOrgIds": [
              "LEV.8.36"
            ]
          }
        }
      ]
