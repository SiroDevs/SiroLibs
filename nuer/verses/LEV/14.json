        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱k dhɔpä puɔ̱ny ran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ti̱ti̱ kɛ kɛn luɔ̱ɔ̱tni kɛ kui̱ raam mi tekɛ juey gupä cäŋ in ba lak ni jɛ, kä banööŋ ni jɛ bööth palä. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä jɛ naŋ jɔk wec kä bɛ jɛ wä guic. Mi wee jɛ wä nɛn i̱ ci buɔ̱ɔ̱t jua̱th gɔw, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi bööth palä diit ti gɔw ti tëk da̱ŋ rɛw thi̱ec kɛ kɛ jiath ŋuër kɛ lath mi dɛ̈ɛ̈r kɛnɛ ithɔp kɛ kui̱ raam in baben lak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi bööth palä kɛ jiök i̱, na̱kɛ dit kɛl rɛy dhar wi̱i̱ pi̱ ti tekɛ lony. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ dit in dɔ̱ŋ in daan ka̱n kä bɛ jɛ cua̱th kɛ kɛnɛ jiath ŋuër kɛ lath mi dɛ̈ɛ̈r kɛ ithɔp rɛy riɛm diɛɛt in ca näk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ riɛmdɛ kiɛth puɔ̱ny raam min baben lak kɛ juey gupä, kä bɛ jɛ cu lar i̱ cɛ gɔaa, kä bɛ dit ɛ tëk ɔ cu jak kä wä rɛy ka̱a̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn ram ɛmɔ bɛ bieyni kɛ lak, kä bɛ mi̱emkɛ diaal muɔ̱t raar, kä bɛ rɔ cu puɔk kä bɛ cu gɔaa kä kɛ kɔrɛ bɛ cu ben wi̱c, duundɛ ɣöö bɛ cieŋ raar kɛmɛkädɛ kɛ ni̱n bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr ni̱ni da̱ŋ bärɔw bɛ mi̱emkɛ diaal muɔ̱t raar, bɛ wi̱cdɛ mud kɛnɛ ti̱kdɛ kɛ mi̱em waŋdɛ kɛ duɔth mi̱eem tin kɔ̱ŋ, kä bɛ bieyni kɛ lak, kä bɛrɔ puɔ̱k kä bɛ cu gɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛ bädäk ni̱ni bɛ rueeth de̱e̱t rɔɔmni da̱ŋ rɛw ti gur kɛli kɛ nac dɛ̈ɛ̈l rɔɔmä ti thil diw, nööŋ kɛ kɛ tok nupä da̱ŋ diɔ̱k ti kök köök ti ca liɔm kɛ liɛɛth ala luur bɛɛl kɛ ɣök liɛɛth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä min bi la̱t ɛmɔ lät kä raam ɛmɔ kɛnɛ muckɛ nööŋ nhiam Kuɔth Nhial thok kɛmɛkä ro̱mä kɛ Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ kɛl ka̱n kä rueeth deet tin kɔn ala luur cutdä kɛ kɛnɛ ɣök liɛɛth, bɛ kɛ ben ŋuaŋ nhiam Kuɔth ala muc ti ŋuaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ jɛ ben näk guäth in la na̱kɛ muc dui̱rä kɛnɛ muc in waŋ thi̱n, bɛ jɛ la̱t inɔ kɛ ɣöö muc cutdä cärɛ kɛ muc dui̱rä, kɛ nyin bööth palä, rɛl gɔɔydɛ rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi bööth palä tha̱a̱ŋ riɛm dɛ̈ɛ̈l muc cutdä ka̱n kä bɛ jɛ bat go̱kä ji̱th cuëëc raam min lak kɛ kɛnɛ yiat tëtdä cueecdɛ in diit kɛ yiat ciökä cueecdɛ in di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ rɔ muc kä liɛɛth, bɛ jɛ wuɔ̱c tëtdä caamdɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ yiat cueecdɛ cua̱th rɛy liɛɛth in te tëtdä caamdɛ, kɛ yiat cueecdɛ, bɛ tha̱a̱ŋ liɛɛth cu kiɛth kä bärɔw nhiam Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ɛn bööth palä duɔth liɛɛth in te tëtdä caamdɛ bat go̱kä ji̱th cuëëc raam in lakkɛ kɛnɛ yiat tëtdä cueecdɛ in di̱i̱t kɛ yiat ciökä cueecdɛ in di̱i̱t, ba jɛ bat wi̱i̱ riɛm mucä cutdä min ca bat ni wen. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ duɔth liɛɛth in te te̱tädɛ cu wuɔ̱c wi̱i̱ raam in lakkɛ ala mi luɛl kɛ ni jɛ nhiam Kuɔth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inɔ bi bööth palä muc dui̱rä thöp luɛlɛ jɛ ram in lakkɛ jiääkdɛ raar, kä kɛ kɔrɛ bɛ muc in waŋkɛ cu näk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ jɛ cu thöp wi̱i̱ yi̱kä kɛ kɛ muc bɛɛl, bi bööth palä jɛ cu luɛl, kä bɛ cu gɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ɛn ram ɛmɔ ɛ can a /cɛ ti̱ti̱ bi jëk, a jɛ kän thäk dɛ̈ɛ̈l rɔmä kɛl ala muc cutdä mi ŋuaŋ kä luɛɛl kɛ ni jɛ kɛ kɛ wäl wa̱a̱li tokä nupä mi ca lia̱a̱p kɛ liɛɛth ala muc bɛɛl, kɛ ɣök liɛɛth, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ guɔ̱kni rɛw kiɛ kunnööri rɛw tin dɔ̱ŋ derɛ luäŋ kɛ jek, dëë kɛl a luur dui̱rä kä dëë min dɔ̱ŋ a luur mi waŋkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bädäk ni̱ni bɛ kɛ nöŋ bööth palä kɛ kui̱ la̱kdɛ thok duëël ro̱mä nhiam Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi bööth palä thäk dɛ̈ɛ̈l min mɔ luur cutdä ka̱n kɛnɛ liɛɛth, kä bɛ kɛ ŋuaŋ ala muc ti ŋuaŋ nhiam Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ thäk dɛ̈ɛ̈l mucä dui̱rä näk, kä bɛ tha̱a̱ŋ riɛmdɛ ka̱n, kä bɛ jɛ bat go̱kä ji̱th cueecdɛ kɛnɛ yiat tëtdä cueecdɛ in di̱i̱t kɛ yiat ciökä cueecdɛ in di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ɛn bööth palä liɛɛth wuɔ̱c tëtdä caamdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ yiat tëtdä cueecdɛ bɛ jɛ kiɛth ni kä bärɔw nhiam Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ tha̱a̱ŋ liɛɛth bat bä go̱kä ji̱th cuëëc raam in lakkɛ, amäni yiat tëtdä cueecdɛ in diit kɛnɛ yiat ciökä cueecdɛ in diit, guäth in ca riɛm muc cutdä kɔn bat thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duɔth liɛɛth in te te̱tkädɛ wuɔ̱c wi̱i̱ raam in lakkɛ, luɛl kɛ ni jɛ nhiam Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ kɛl thöp kä guɔ̱kni kiɛ kunnööri, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛl ala luur dui̱rä cukɛ a min dɔ̱ŋ ala luur mi waŋ, kɛn duɔ̱p ɛmɔ bi bööth palä raam ɛmɔ cu luɛl nhiam Kuɔth Nhial.” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn ŋuɔ̱t kɛ kui̱ raam mi tekɛ dhɔp min /ci muc dëë luäŋ kɛ jiäk kɛ kui̱ la̱kdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dhɔp rɛy duëël",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Kuoth Nhial Muthɛ kɛnɛ Ä-ron jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä yɛn wec muun Kɛ-naan, min cä ka̱m yɛ ala duŋdun, kä cä dhɔp la̱th duëël rɛy muɔ̱ndun. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn ram ɔ ci duel ka̱n ɔ a jɛ bëë ben la̱r bööth palä i̱, ‘Ce̱tdɛ kɛ mi te duelä kɛ dhɔp.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä wee ka̱mɛ kuak raar rɛy duëël a /kenɛ ni coth ɛn duëël kɛ ɣöö bɛ jɛ wä guic, kɛ ɣöö bɛ cu thil mi ba lar i̱ jiäk rɛy duëël. Kɛ kɔrɛ bɛ rɛy duëël cu wä guic. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ juey guic, puɔ̱ny duëël, mi wee jɛ wä jek i̱ te juey thi̱n a tëë biɛl mi dɛ̈ɛ̈r kiɛ mi tɔ̱c mi jɔc, kä cɛ cuit puɔ̱ny duëël, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "bi bööth palä ben raar duëël, kä bɛ thi̱i̱k thok duëël lëk thi̱n kɛ ni̱n bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr ni̱ni da̱ŋ bärɔw bɛ luny jɔk, bɛ jɛ ben guic, mi cɛ juey jek a cɛ rɔ rëp kɛ biɛɛl ti ŋuan puɔ̱ny duëël ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ kɛ cu jiök i̱ ka̱mɛ pääm tin te biɛɛl jua̱th thi̱n raar kä wiaa yia̱kɛ kɛ jɔk wec guäth in jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ ro̱o̱dh duëël kuek raar ni kɛɛliw, kä bɛ mundɛ wa yiäk jɔk wec guäth in jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ pääm kɔ̱kiɛn ben la̱th guäth päämni tin ca ka̱m raar, kä bɛ duel nyɔk kɛ rödh.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ci juey rɔ nyɔk kɛ jɔac puɔ̱ny duëël kɛ kɔr kä min ca pääm ka̱m raar kä ca kɔ̱k kä ca rɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bööth palä jɛ ben kui̱c, mi cɛ jek a rëp biɛl jua̱th ni rɔ puɔ̱ny duëël, ɛ dhɔp mi bɛc, jiäkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ duel däk, mundɛ nikɛ jiɛɛnkɛ amäni ro̱o̱dhdɛ, kä bɛ kɛ naŋ raar jɔk wec guäth in jiääk. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä niɛ ram ɔ bi wä duëël ɔ guäth in ca thokdɛ lëkɔ, bɛ jiääk amäni thiaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ɔ ci tɔ̱ɔ̱c duëël ɛmɔ a lak bieynikɛ, kä ram ɔ ci mi̱th thi̱n ɔ a jɛ lak bieyni kɛ bä.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi ci bööth palä ben i̱ bëë juey ben guic, kä cɛ jek a /cɛ rɔ rëp puɔ̱ny duëël guäth in ca rɔdh, bɛ jɛ lar i̱ gɔaa ɛ ɛn duel kɛ ɣöö ci juey gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ la̱k duëël bɛ diit ti tiatni da̱ŋ rɛw ka̱n kɛ kɛ jiath ŋuër kɛnɛ lath mi dɛ̈ɛ̈r kɛ ithɔp, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ kɛl näk kä diit rɛy dhar wi̱i̱ pi̱i̱ni ti te lony ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "bɛ jiɛɛn ɛ ti ka̱n kɛ kɛ dit in tëk, kä bɛ kɛ cua̱th rɛy riɛm di̱et in ca näk kɛnɛ pi̱ tin te lony kä bɛ duel ben kith ni kä bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ ɛn duel cu lak kɛ riɛm di̱et kɛnɛ pi̱ ti lony, kɛ dit in tëk, kɛ jiath ŋuër, lath mi dɛ̈ɛ̈r, kɛ ithɔp, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kɔrɛ bɛ dit in tëk pa̱l wä rɛy ka̱a̱ni dɔɔr, bɛ duel cu luɛl Kä bɛ cu gɔaa.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn ŋuɔ̱t kɛ kui̱ raam ɔ bi tekɛ dhɔp kɛnɛ wuɔ̱ɔ̱k, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱ dhɔpä mi te rɛy biey kiɛ duel, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɛ pia̱a̱r kiɛ kuuk, kiɛ waŋ ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "ba nyoth mi jiäkɛ kiɛ gɔaa ɛ, ɛ jɛn ŋuɔ̱t kɛ kui̱ dhɔpä.",
