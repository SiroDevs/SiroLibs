          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä duundɛ ɣöö ba ŋɔak diaal guir kɛ ciaŋ mi com.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
