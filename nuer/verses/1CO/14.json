              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
            "verseOrgIds": [
              "1CO.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi caar raan ɛ ɛn ɣöö ɛ gök, kiɛ tëë kɛ buɔ̱m yieekä, derɛ jɛ ŋa̱c ɛnɛ gɔ̱a̱rä yɛ mɛ, ɛn ɣöö ɛ guk kä Kuäär ni Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
            "verseOrgIds": [
              "1CO.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi /ci raan mɛmɛ ŋäc, jɛn /ca jɛ bi ŋa̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ, dämaari, görɛ jɛ ɛn ɣöö bia ruaacni go̱o̱kä lat, kä /cuarɛ ruac kɛ thuk ti kueckɛ pen, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
