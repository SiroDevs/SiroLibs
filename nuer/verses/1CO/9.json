  "bookId": "1CO",
  "reference": "1 Kor 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "1CO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuŋ kɛnɛ lät jääkä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ciɛ ɣän ram mi lɔr? /Ciɛ ɣän jak? /Ka̱n Yecu in la Kuääran nɛn? /Cikɛ yɛn kuay la̱tdä kɛ kui̱ Kua̱r ni Yecu? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.1",
            "verseOrgIds": [
              "1CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi /ci ɣän a jak kä nɛy kɔ̱kiɛn, ɛ ɣän jak kä yɛ. Kɛ ɣöö lapɛ nyuuth kɛ thuɔ̱k ɛn ɣöö ɛ ɣä jak rɛy Kua̱r ni Yecu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ jɛn ruac ga̱ŋdä kɛ rɔ, kä nɛy tin ba ɣä ɣɔ̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.3",
            "verseOrgIds": [
              "1CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ci kɔn tekɛ cuɔ̱ɔ̱ŋ, kɛ mi̱ethdan kɛnɛ min mathnɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.4",
            "verseOrgIds": [
              "1CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Canɛ tekɛ cuɔ̱ɔ̱ŋ kɛ ja̱lan kɛɛl kɛ ciek mi tekɛ ŋa̱th ce̱tkɛ jaak tin kɔ̱ŋ, kɛ dämani Kua̱r ni Yecu amäni Thi̱i̱-päth? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.5",
            "verseOrgIds": [
              "1CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiɛ Bar-na-bäth kɛnɛ ɣän kärɔ̱ kɛn tɔ̱ bi lät tɔ̱ kɛ kui̱ nyinä ciɛŋädä? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.6",
            "verseOrgIds": [
              "1CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋa mi lät ala raan rɛ̈m kä mocɛ rɔ kɛ nyinkɛ? Ɛŋa mi piith kak wal kɛ kui̱ kɔaŋ thilɛ dɛy ti camɛ thi̱n? Ɛŋa mi lääk det a thil cak ti jekɛ thi̱n?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän latdä mɛmɛ kɛ lua̱ŋ mi bëë kä naath? /Ci ŋut lat ni mi ce̱tkɛ jɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.8",
            "verseOrgIds": [
              "1CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ca jɛ gɔ̱r rɛy ŋutdä Muthɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:9",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 25:4.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “/Ca thok tha̱a̱k dee kum, mi kɔ̱ɔ̱mɛ bɛl.” Ɛ kui̱ thääkni ɛn nɔ diɛɛr kɛ Kuoth ɔ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn /cɛ ruac kɛ kui̱dan kɔn diaal? Ca jɛ gɔ̱r kɛ kui̱dan pa̱ny, ɛn ɣöö ram mi pur derɛ puur kɛ ŋa̱th kɛ ti bɛ jek, kä dee kɔ̱ɔ̱m bɛl kɔ̱a̱m kɛ ŋa̱th ɛn ɣöö bi tha̱a̱ŋ bɛɛl a nyinkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.10",
            "verseOrgIds": [
              "1CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cakɔ kuay yieekä piɛth rɛydun, derɛ a mi di̱i̱t ɛlɔ̱ŋ mi cakɔ tha̱a̱ŋ ŋɛr kä yɛ kɛ kui̱ teekä ɛmɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.11",
            "verseOrgIds": [
              "1CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi te nɛy kɔ̱kiɛn kɛ cuɔ̱ɔ̱ŋ kɛ jek kä mɛmɛ kä yɛ, /ci di̱t ni cuɔ̱ɔ̱ŋda ɛlɔ̱ŋ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋ ɛ jɛn inɔ, /ka̱nkɔ cuɔ̱ɔ̱ŋ ɛmɛ ka̱m rɔ̱. Kä kɛ kui̱c ɛmɔ cakɔ rut ni ti diaal, kä ɣöö /bakɔ mi bum la̱th dup Thukni ti gɔw kɛ kui̱ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kui̱c yɛn ɛ, ɛn ɣöö nɛy tin ca cɔal läätdä rɛy luaak Kuɔth jëkɛ mi̱ethdiɛn thi̱n, kä nɛy tin lät wi̱i̱ yi̱kä Kuoth nyuakɛ ŋɔaani tin thöpkɛ wi̱i̱ yi̱kä? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.13",
            "verseOrgIds": [
              "1CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ, ci Kuäär ni Kuoth ɛ lat ɛn ɣöö nɛy tin latkɛ thuk ti gɔw bikɛ nyin teekädiɛn jek kɛ ruac Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän /ka̱n cuɔ̱ɔ̱ŋ kɛl kä cuŋ ti̱ti̱ ka̱m rɔ, kä /ka̱n warɛgak ɛmɛ gɔ̱r kɛ ɣöö bä duɔ̱ɔ̱r mi ce̱tkɛ mɛmɛ jek thi̱n. Kɛ ɣöö ŋua̱n ni lia̱a̱dä kä ɣöö bi raan luɔt liakädä ɛmɛ mac! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.15",
            "verseOrgIds": [
              "1CO.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mi latdä ni thuk Kuɔth ti gɔw, thilɛ luɔt mi dëë liak ni rɔ, kɛ ɣöö ɛ jɛn min bä la̱t ni jɛ. Kä riɛk akɛ ɣä, mi /cä thuk Kuɔth ti gɔw bi la̱t naath. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.16",
            "verseOrgIds": [
              "1CO.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi la̱tdä ruac ɛmɛ a laar ɣän bä tekɛ muc, kä duundɛ ɣöö mi la̱tdä ruac ɛmɛ a /ci jɛ lar ɣän i̱ bä jɛ la̱t, ɣän la̱tdä ni la̱t mi ca ka̱m ɣä i̱ bä la̱t ɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.17",
            "verseOrgIds": [
              "1CO.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ, kökdä ɛŋu? Ɛ jɛn ɣöö kɛ latdä kɛ ruac Kuɔth dëë thuk ti gɔw la̱t naath a thil kök. Kɛ kui̱c ɛmɔ /cä thuk Kuɔth lat kɛ kui̱ cuuŋädä.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.18",
            "verseOrgIds": [
              "1CO.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.18",
            "verseOrgIds": [
              "1CO.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cäŋ lɔarä kä nɛy diaal, kä duundɛ ɣöö cä rɔɔdä jakä kuany kä nɛy diaal, kɛ ɣöö dëë nɛy ti ŋuan ri̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.19",
            "verseOrgIds": [
              "1CO.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min la̱tdä kɛɛl kɛ ji̱ Juudh cä rɔɔdä ciɛŋ ce̱tkɛ raan ji̱ Juudh, kɛ ɣöö bä ji̱ Juudh ri̱t. Kä nɛy tin guɔ̱ɔ̱rkɛ ciaŋ ŋuɔ̱tni cä rɔɔdä ciɛŋ ce̱tkɛ ram mi guur ciaŋ ŋuɔ̱tni. Cäŋ /ci ɣän te piny ŋutdä kɛ ɣöö dëë nɛy tin guɔ̱ɔ̱rkɛ ŋuɔ̱t ri̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.20",
            "verseOrgIds": [
              "1CO.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tin te raar ŋutdä cä rɔɔdä ciɛŋ ce̱tkɛ ram mi te raar ŋutdä, kɛ ɣöö bä nɛy tin te raar ŋutdä ri̱t, (a cäŋ /cä lɔr kä ŋut Kuɔth, kä duundɛ ɣöö ta̱a̱ piny ŋutdä Kritho). ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rɛy nɛɛni tin kɔ̱c cua rɔ jakä ram mi kɔ̱c kɛ ɣöö dëë nɛy tin kɔ̱c ri̱t. Cu ɣän a ti diaal kä nɛy diaal, kɛ ɣöö dɔ̱ŋ dëë tha̱a̱ŋ nath kän kɛ duɔ̱ɔ̱p dee rɔ lot ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.22",
            "verseOrgIds": [
              "1CO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cua jɛ la̱t kɛɛliw kɛ kui̱ thuk Kuɔth ti gɔw, kɛ ɣöö dëë te rɛy nyuaakä puthni thukni tin gɔw.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
            "verseOrgIds": [
