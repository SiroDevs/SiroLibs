        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhök ɛ muc mi di̱i̱t ɛlɔ̱ŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ruacä kɛ thuk nath kiɛ kɛ thuk ja̱a̱kni nhial, kä thilɛ ɣä nhök, ɣän ca̱tdä kɛ löth mi ro̱t, kiɛ jɔw dëthni ti ta̱thkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ta̱a̱kɛ lua̱ŋ go̱o̱kä, kä ŋa̱cä ti diaal ti cua̱ŋkɛ naath, kä ta̱a̱kɛ ŋäc ŋɔaani diaal, kä ta̱a̱kɛ ŋa̱th kɛɛliw mi dëë woc ni pääm gua̱thnikiɛn, kä duundɛ ɣöö thilɛ ɣä nhök, ɛ ɣän baŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.2",
            "verseOrgIds": [
              "1CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi da̱kä nyinkä diaal kä piny, kä thöpä puɔ̱nydä kɛ ɣöö ba waŋ, kä thil ɣä nhök, thilɛ mi jëkä thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.3",
            "verseOrgIds": [
              "1CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhök ɛ päl piny, kä ɛ gɔɔy. Nhök thilɛ jɛ tiɛɛl, kiɛ ŋuën kiɛ liak kɛ rɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.4",
            "verseOrgIds": [
              "1CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä /ciɛ jua̱ŋ jua̱ŋ, kä /ciɛ rɛŋ. Nhök /cɛ naath kok kɛ ca̱rɛ kärɔa, /cɛ mal a ŋɔ̱a̱ŋɛ, kä /cɛ naath ŋuɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.5",
            "verseOrgIds": [
              "1CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhök /ci lɔcdɛ tɛth kɛ mi jiääk, duundɛ ɣöö tɛth lɔcdɛ kɛ mi la thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.6",
            "verseOrgIds": [
              "1CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhök ruutdɛ ŋɔaani diaal, kä ŋääthɛ ŋɔaani diaal, ŋääthɛ ŋɔak diaal ti bi ben, kä dhi̱i̱lɛ ŋɔaani diaal.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.7",
            "verseOrgIds": [
              "1CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhök /cɛ thuk. Kä duundɛ ɣöö bi ruaacni go̱o̱kä thuuk, kä bi ruaacni thukni ti kueckɛ cuɔ̱ŋ, kä bi ŋäc ŋɔaani thuuk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.8",
            "verseOrgIds": [
              "1CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋäc ŋɔaanidan tëëkɛ diw, kä ruac go̱o̱kädan tëëkɛ diw. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.9",
            "verseOrgIds": [
              "1CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä min thil diw ben, bi min tekɛ diw thuuk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.10",
            "verseOrgIds": [
              "1CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ɛ ɣän gat, cua̱ ruac ce̱tkɛ gat, kä cua̱ ca̱r ce̱tkɛ gat, kä cua̱ luɔt ŋɔaani lat ce̱tkɛ gat. Kä mëë cä di̱t, cua̱ ciaŋ gaatädä päl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.11",
            "verseOrgIds": [
              "1CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ɛn täämɛ, guɛcnɛ rɔ̱ rɛy neenä ɛ mi̱r mi̱r, kä duundɛ ɣöö banɛ Kuoth guic agɔaa. Täämɛ ŋäcdä tëëkɛ diw, kä bä ŋɔak ŋa̱c kɛn diaal, ce̱tkɛ mëë ca ɣä ŋa̱c ɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.12",
            "verseOrgIds": [
              "1CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ, ti̱ti̱ da̱ŋ diɔ̱k tekɛ thi̱n, ŋa̱th, kɛ ŋa̱th kɛ ti bi ben, kɛnɛ nhök, kä min di̱t ni jɛn ɛlɔ̱ŋ kä kɛn ti̱ti̱ ɛ nhök.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.13",
            "verseOrgIds": [
              "1CO.13.13"
            ]
          }
        }
      ]
    }
  ],
