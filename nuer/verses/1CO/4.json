    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jaak Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Carɛ kɔ inɛ, lapkɔ ji̱ läätdä Kritho, ti ci Kuoth kɛ jakä yuɔ̱ɔ̱p tɛ̱̈ɛ̱̈nikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.1",
            "verseOrgIds": [
              "1CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min görkɛ kä läät mi ce̱tkɛ nɔ ɛ ɣöö ɛ a läät mi ŋa̱thkɛ ɛ kuäärɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.2",
            "verseOrgIds": [
              "1CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱dä cä riɛk ɛn ɣöö bia ɣä luk kiɛ ba ɣä luk ɛ naath. A cäŋɛ ni ɣän /cä rɔ luk. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.3",
            "verseOrgIds": [
              "1CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ duer mi ŋa̱cä kärɔ, kä duundɛ ɣöö /cɛ ɣä jakä thil duer. Kɛ thuɔ̱k ɛ Kuäär ni Yecu ɛn ni̱n luk ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.4",
            "verseOrgIds": [
              "1CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, /cu luk ŋok mi /ken gua̱a̱thdɛ ni ben. Li̱epɛ amäni mi ci Kuäär ni Yecu ben. Jɛn bɛ ŋɔaani tin ca tɛ̱̈ɛ̱̈ täämɛ rɛy muɔ̱th nööŋ rɛy buɔyä, kä bɛ cär lo̱cni jakä jɔc. Kä bi ram ɔ liakdɛ jek kä Kuoth.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cä kɛn ti diaal ti̱ti̱ lät kä A-pɔ-löth kä cäkɛ lät kärɔɔdä kɛ kui̱ gɔɔyädun, dämaari, kɛ ɣöö dee yɛn luɔt kä min larkɛ i̱, “Thilɛ mi bääl min ca gɔ̱r rɛy ruac Kuɔth,” kɛ ɣöö thilɛ raan kä yɛ mi bi rɔ liak kɛ raan kä lo̱kɛ ram in dɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.6",
            "verseOrgIds": [
              "1CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ɛŋa mi jak ji̱ kä göl kä ram in dɔ̱ŋ? Kä ɛŋu tekɛ ji̱ mɔ mi /ka̱n ka̱m ji̱? Kä mi ca jɛ ka̱m ji̱, kä ɛŋu liaki rɔ mɔ ce̱tkɛ mi /ciɛ muc?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.7",
            "verseOrgIds": [
              "1CO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.7",
            "verseOrgIds": [
              "1CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cia ro̱ŋ kɛ tin görɛ! Kä cia ria̱ŋ! Kä ci yɛn a kua̱r a thilɛ kɔ thi̱n! Kɛ thuɔ̱k, ɣän göörä jɛ ɛn ɣöö dee yɛn a kua̱r, kɛ ɣöö dee nɛy a kua̱r kɛ yɛ kɛɛl! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.8",
            "verseOrgIds": [
              "1CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö caarä jɛ ɛn ɣöö Kuoth cɛ kɔn jaak la̱th guäth in jɔak, ce̱tkɛ nɛy ti ca kum kɛ lia̱a̱. Kɛ ɣöö cakɔ ben a nɛy ti guɛckɛ ɛ ɣɔw, kɛ ja̱a̱k nhial kɛnɛ naath. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.9",
            "verseOrgIds": [
              "1CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɔn lapkɔ dɔa̱a̱r kɛ kui̱ Kritho, kä yɛn pɛlɛ rɛy Kritho. Kɔn nyua̱nkɔ, kä duundɛ ɣöö bum yɛn. Luth naath yɛ, kä canykɛ kɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.10",
            "verseOrgIds": [
              "1CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amäni täämɛ näk buɔth kɛnɛ rɛw kɔ, kä ciaŋkɔ ni bieyni ti ci rɛ̈t, kä dua̱ckɛ kɔ, kä thilɛ kɔ ciëëŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.11",
            "verseOrgIds": [
              "1CO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɔn cuɔ̱ckɔ kɛ lät tetnikɔ. Mi cakɔ lam, poth nɛy naath. Mi cakɔ ciɛŋ a jiäk ɛ naath, la ruɔ̱tkɔ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.12",
            "verseOrgIds": [
              "1CO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi cakɔ kuëth, la nɛy a ruac agɔaa. Cua kɔ ce̱tnikɛ di̱r jiäkni ɣɔaa kɛnɛ nyaal wec muɔ̱ɔ̱n, amäni cäŋ ɛmɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
            "verseOrgIds": [
              "1CO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
            "verseOrgIds": [
              "1CO.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän /cä yɛ gɔ̱a̱r mɛmɛ kɛ ɣöö bɛ yɛ jakä po̱c, duundɛ ɣöö luëëkä ni yɛ ce̱tkɛ gaatkä tin nhɔakä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.14",
            "verseOrgIds": [
              "1CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cäŋ te yɛn kɛ ga̱a̱ŋ ti bathdɔɔri da̱ŋ wäl rɛy Kritho, kä thilɛ yɛ guuri ti ŋuan. Kɛ thuɔ̱k rɛy Kritho Yecu ci ɣän a guurun kɛ thuk tin gɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.15",
            "verseOrgIds": [
              "1CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän la̱ŋä yɛ ɛn ɣöö bi yɛn a nyiath ni ciaaŋdä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.16",
            "verseOrgIds": [
              "1CO.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä mɛmɛ ɣän ja̱kä yɛ Ti-mo-thi min la gatdä min nhɔakä kä tekɛ ŋa̱th rɛy Kua̱r ni Yecu, ɛn ɣöö bɛ yɛ ti̱em ciɛŋkä rɛy Kritho, ce̱tkɛ min cäkɛ ŋi̱eec gua̱thni diaal rɛy lueekni Kuɔth diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.17",
            "verseOrgIds": [
              "1CO.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tha̱a̱ŋkun liakɛ, rɔ̱ kɛ ɣöö carkɛ jɛ /cä bi ben kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.18",
            "verseOrgIds": [
              "1CO.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä ben kä yɛ kɛ gua̱a̱th mi thia̱k, mi nhɔk Kuäär ɛ, kä bä buɔ̱m nɛɛni tɔ̱ liakɛ rɔ̱ tɔ̱ ben jek a /ci mɔ a min lat kɛn ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.19",
            "verseOrgIds": [
              "1CO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ciaŋ kuäärä Kuɔth /cɛ te rɛy ruac kärɔa, te rɛy bumä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.20",
            "verseOrgIds": [
              "1CO.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu mi bi yɛn ɛ mɛk? Bä ben kä yɛ kɛ kɛɛt, kiɛ kɛ yiëë nho̱kä kɛnɛ ciaŋ gɔɔyä?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.21",
            "verseOrgIds": [
              "1CO.4.21"
            ]
          }
        }
      ]
    }
  ],
