          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.38",
            "verseOrgIds": [
              "1CO.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ciek dhil te kɛɛl kɛnɛ cɔwdɛ min ŋot cɔwdɛ teekä. Kä mi ci cɔwdɛ li̱w, tëëkɛ cuɔ̱ɔ̱ŋ ɛn ɣöö dëë jɛ nyɔk kɛ kuën ɛ ram mi go̱o̱rɛ, kä bɛ a ram mi te rɛy Kua̱r ni Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.39",
            "verseOrgIds": [
              "1CO.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ca̱rä dee di̱t ni tɛ̈th lɔaacdɛ, mi /ka̱nɛ nyɔk kɛ kuën. Kä caarä jɛ ɛn ɣöö ta̱a̱ kɛ Yiëë Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.7.40",
            "verseOrgIds": [
              "1CO.7.40"
            ]
          }
        }
      ]
    }
