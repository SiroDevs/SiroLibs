        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muc kɛ kui̱ ta̱th luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Dee-bid duɔl jiök i̱, “Gatdä ni Thɔ-lo-mon mi ca mɛk ɛ Kuoth ɛ, jɛn kui̱yɛ kä thilɛ mi ŋäcɛ, kä la̱t di̱tdɛ. Kä ɛn duel ɛ duŋ Kuɔth Nhial, /ciɛ duŋ ran. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.1",
            "verseOrgIds": [
              "1CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ ɣän ca kuak jak kä te wa̱nɔ nikɛ buɔ̱mdä kɛɛliw kɛ kui̱ luaak Kuɔthdä, ca da̱a̱p jak kä te thi̱n kɛ kui̱ la̱t nyinä dääpä, kɛ ciɛk in bo̱r kɛ kui̱ la̱t nyinä cikä min bo̱r, kɛ ciɛk in yian kɛ kui̱ la̱t nyinä cikä min yian, kɛ yiëëth kɛ kui̱ la̱t nyinä yieethä, kɛ jiɛɛn kɛ kui̱ la̱t nyinä jiɛɛn, a /ci pääm tin di̱t kökdiɛn, kɛnɛ pääm tin tekɛ biɛɛl, kɛ päm mi ŋir ŋir, kɛ päm cärä lɔaac, te thi̱n kɛ pek mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.2",
            "verseOrgIds": [
              "1CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lɛ̈ɛ̈ tin diaal tin ca rialikä kɛ kui̱ duëël in rɛl gɔɔydɛ rɔ mat thi̱n, kä ɣän ta̱a̱ kɛ da̱a̱pdä kɛnɛ ciɛk in bo̱r tin te tɔ̱ɔ̱wä. Kɛ ɣöö nhɔakä luak Kuɔthdä, ɣän ca kɛ thöp kɛ kui̱ luaak Kuɔthdä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.3",
            "verseOrgIds": [
              "1CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca da̱a̱p mi tekɛ ki̱luni ti bathdɔɔri diɔ̱k kä da̱a̱p mi ko̱k ko̱k thöp, kɛnɛ ki̱luni cikä min bo̱r mi ca lɛy mi tekɛ bathdɔɔri bärɔw, kɛ kui̱ ro̱thä pua̱ny luaak, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.4",
            "verseOrgIds": [
              "1CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ kui̱ lätni diaal tin ba la̱t ɛ ji̱ ta̱th, ba da̱a̱p lät nyin dääpä kä ba ciɛk in bo̱r lät nyin cikä min bo̱r. Kä ɛŋa mi luäŋ ɣöö bi Kuoth Nhial thöp muc kɛ lɔcdɛ mɔ kä bi rɔ lëy ɛn walɛ?”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.5",
            "verseOrgIds": [
              "1CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bööth dho̱ri muc lo̱cnikiɛn thöp, kä cua la̱t bä ɛ bööth thuk duëli kɛ bööth bathdɔɔri kɛnɛ bööth kuri, kɛ bööth lätni kua̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.6",
            "verseOrgIds": [
              "1CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ da̱a̱p mi tëë ki̱luni ti bathdɔɔri ti kuɔ̱r wi̱cdɛ jiɛɛn kɛnɛ ki̱luni ti bathdɔɔri ti kur diɔ̱k cikä min bo̱r, kɛ ki̱luni ti bathdɔɔri ti kur dhieec wi̱cdɛ jiɛn da̱ŋ ŋuaan cikä min yian, kɛ ki̱luni ti bathdɔɔri ti bathdɔɔri diɔ̱k ladiitä thöp kɛ kui̱ ta̱th luaak Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.7",
            "verseOrgIds": [
              "1CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tin tekɛ pääm tin di̱t kökdiɛn. Cukɛ kɛ thöp kɛ kui̱ duëël tɔ̱wä luaak Kuɔth Nhial, min tiɛtkɛ ɛ Yɛ-ɣe-li raan wec. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.8",
            "verseOrgIds": [
              "1CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu naath lo̱ckiɛn tɛɛth kɛ ɣöö ca ti̱ti̱ thöp Kuoth Nhial kɛ ca̱r lo̱cnikiɛn kɛɛliw. Kä cu kuäär ni Dee-bid lɔcdɛ tɛɛth ɛlɔ̱ŋ bä.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔny Dee-bid kɛ Kuoth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.9",
            "verseOrgIds": [
              "1CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Dee-bid Kuoth Nhial liak nhiam dolä kɛɛliw, wëë i̱, “Ɛ liak wä kä ji̱, lö Kuoth Nhial min la Kuoth gua̱ndɔɔŋda ni Je-kɔb, amäni cäŋ kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.10",
            "verseOrgIds": [
              "1CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä di̱t kɛ buɔ̱m kɛ gɔɔy kɛ guëth kɛ nyinku lö Kuoth Nhial. Kä tin diaal tin te puɔ̱rä, kɛnɛ tin te piny kɛ nyinku. Kä ɛ ji̱n Kuäär in di̱t ni jɛn kä ti diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.11",
            "verseOrgIds": [
              "1CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä luth kɛnɛ ria̱ŋ bäkɛ kä ji̱, kä ɛ ji̱n rueec kä ti diaal. Kä buɔ̱m kɛnɛ lua̱ŋ tekɛ ji̱, Kä ɛ ji̱n moc ti diaal kɛ buɔ̱m ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.12",
            "verseOrgIds": [
              "1CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ Kuothda, la̱rkɔ ji̱ tɛ̈th lɔaac kä liakɔ ciötdu min gɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.13",
            "verseOrgIds": [
              "1CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Duundɛ ɣöö ti̱ti̱ thöp kɛ kɛ kɛ lo̱ckɔ kɛɛliw! Ɛ ɣöö bä ti diaal kä ji̱, kä käm nɛy ni ji̱ min bä kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.14",
            "verseOrgIds": [
              "1CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔn nɛy ti jur kä ji̱, ce̱tkɛ mëë te gua̱ni kɔ, ce̱t tëkda kɛ ti̱eep wi̱i̱ muɔ̱ɔ̱n, thilɛ jɛ ŋa̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.15",
            "verseOrgIds": [
              "1CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ti ŋuan ti ca̱kɔ thöp ti kɛ kui̱ ta̱th luaakdu lö Kuoth Nhial min la Kuothda, kɛ nyinku kɛn diaal, kä bäkɛ kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.16",
            "verseOrgIds": [
              "1CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cä ji̱ lö Kuothda ɛn ɣöö ɣɔ̱ni lo̱c, kä nhɔki rialidiɛn ikä. Kɛ tɛth lɔaacdä kɛnɛ luth, ɣä ca ti̱ti̱ diaal thöp ji̱, kä nɛɛkä ti tëë wa̱nɛ mɔ ti, thöpkɛ ji̱ ti̱ti̱ kɛ tɛth lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.17",
            "verseOrgIds": [
              "1CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n lö Kuoth Nhial Kuoth gua̱ndɔɔŋnikɔ ni A-bɛ-ram kɛ Ay-dhɛk kɛnɛ I-thɛ-rɛl, rɔmni nɛmɛ lo̱cni nɛɛniku amäni cäŋ kɛl, kä jak ni lo̱ckiɛn ka tiɛtkɛ ji̱ ni ciaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.18",
            "verseOrgIds": [
              "1CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä moc gatdä ni Thɔ-lo-mon kɛ lɔc mi bɛ tit ni luëëku, kɛnɛ ŋuɔ̱tku, kɛ ɣöö dɔ̱ŋ bɛ luak in ca nyinkɛ rialikä la̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.19",
            "verseOrgIds": [
              "1CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid duɔl jiök kɛɛliw i̱, “Puanyɛ Kuoth Nhial min la Kuothdun.” Kä cu duɔl kɛɛliw Kuoth Nhial min la Kuoth gua̱ni puany, kä cu kɛ jɛ pal, kä cu kɛ kuäär lät kä luth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.20",
            "verseOrgIds": [
              "1CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ruɔ̱ndɛ, cu kɛ luuri kɛnɛ muc tin waŋkɛ thöp Kuoth Nhial, thääk ti bathdɔɔr kɛ dɛy deet ti bathdɔɔr kɛ thääk deet ti bathdɔɔr kɛ kɔaaŋ, kɛ muc ti ŋuan kɛ kui̱ ji̱ I-thɛ-rɛl diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.21",
            "verseOrgIds": [
              "1CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kɛ mi̱th kä cu kɛ maath kɛ tɛth lɔaac ɛn cäŋ ɛmɔ nhiam Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuëny Thɔ-lo-mon ala kuäär",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ gua̱th in rɛwdɛ, cukɛ gat Dee-bid ni Thɔ-lo-mon jak kä kuäär. Kɛ ciöt Kuɔth Nhial cukɛ jɛ kuany ala rueecdiɛn, kä cu Dha-dok a bo̱o̱th palä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.22",
            "verseOrgIds": [
              "1CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon nyuur wi̱i̱ kɔam kuäärä mëë ci Kuoth Nhial ɛ yiath piny kɛ gua̱th gua̱n ni Dee-bid. Kä cua kuäär mi gɔaa kä cua luɔ̱th ɛ ji̱ I-thɛ-rɛl diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bööth diaal, kɛ rɛm, amäni gaat Dee-bid diaal, ɛ lar i̱ bikɛ te kɔr Thɔ-lo-mon ala kuäär. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial Thɔ-lo-mon ka̱m liak nhiam ji̱ I-thɛ-rɛl diaal, kä cu gɔaa ni kuäärɛ kä kua̱r I-thɛ-rɛl tëë ci ben nhiamdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ti̱em ruecä Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Dee-bid gat Jɛthi I-thɛ-rɛl ruac kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.26",
            "verseOrgIds": [
              "1CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pek ruëcdɛ kɛ I-thɛ-rɛl run ti jiɛɛn ŋuaan. Cɛ ruëc kä Ɣɛb-ron kɛ run bärɔw, kä cɛ ruëc kä Jɛ-ru-tha-lɛm kɛ run ti jiɛɛn diɔ̱k wi̱cdɛ diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.27",
            "verseOrgIds": [
              "1CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ li̱w kɛ run ti cop lɔcdɛ ti cɛ ria̱ŋ thi̱n kɛnɛ luth, kä cu gatdɛ ni Thɔ-lo-mon ruec kɛ gua̱thdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
            "verseOrgIds": [
              "1CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua lätkɛ diaal gɔ̱a̱r rɛy buɔkni göökni da̱ŋ diɔ̱k, Tha-muɛl kɛnɛ Na-than kɛ Gad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.29",
            "verseOrgIds": [
              "1CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn tɔ̱ ca gɔ̱r tɔ̱, latkɛ ni pek ruecädɛ kɛ buɔ̱mdɛ kɛ tëë diaal te ci tuɔ̱k kä kɛ, kɛnɛ I-thɛ-rɛl kɛ kua̱r wi̱i̱ni diaal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.30",
            "verseOrgIds": [
              "1CH.29.30"
            ]
          }
        }
      ]
    }
