          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Kɔar Dee-bid tëë nhiam thok duëël Ben-ya-min",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ti̱ti̱ a nɛy tëë cu ben kä Dee-bid kä Dhik-lag, mëë cɛ rɔ bar kɛ Thɔɔl gat Kic. Cukɛ te rɛy nɛɛni tin buɔ̱m buɔ̱ɔ̱m tëë lua̱kɛ jɛ kɛ ko̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.1",
            "verseOrgIds": [
              "1CH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekɛ kɛ bääri, luäŋkɛn kui̱r kɛ tet caamdiɛn kɛnɛ tet cueecdiɛn. Kä kɛ ji̱ thuɔk duëël Ben-ya-min ji̱ maarä Thɔɔl.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.2",
            "verseOrgIds": [
              "1CH.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kua̱rkiɛn a A-ɣi-ɛ-dhɛr kɛnɛ Yo-ac gaat Cɛ-maa raan Giba. Kä cu rɛm Yɛ-dhi-el kɛnɛ Pɛ-lɛt gaat Ɛ̈dh-ma-wɛth kɛ Bɛ-ra-kaa kɛnɛ Yeɣu kä Ä-na-thoth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.3",
            "verseOrgIds": [
              "1CH.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ Yic-ma-yaa raan Gib-yon, ɛ ram kɛl kä nɛy tin buɔ̱m buɔ̱ɔ̱m tin jiɛɛn diɔ̱k, min la bööth jiɛɛn diɔ̱k. Kɛ Yir-mɛ-yaa, kɛ Yä-dhi-el, kɛ Yo-ɣa-nan kɛ Yo-dha-bad kä Gä-de-ra, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.4",
            "verseOrgIds": [
              "1CH.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛl-u-dhay kɛnɛ Yɛ-ri-moth kɛ Bal-yaa, kɛ Cɛ-mar-yaa kɛ Cɛ-pɛ̈t-yaa kä Ɣa-rup. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.5",
            "verseOrgIds": [
              "1CH.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ Ɛl-ka-na kɛnɛ Yi-ci-yaa kɛ Ä-dhar-el, kɛ Yo-dhɛr kɛ Ya-cɔ-bam raan Kora. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.6",
            "verseOrgIds": [
              "1CH.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ Yo-e-laa kɛ Dhɛ-bɛ̈d-yaa gaat Yɛ-ro-ɣaam raan Gɛ-dhor.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Kɔar Dee-bid thok duëël Gad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.7",
            "verseOrgIds": [
              "1CH.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu tha̱a̱ŋ ji̱ Gad rɔ̱ ma̱t Dee-bid mëë tëë rɛy dɔaar rɛy kɔ̱a̱kni. Kɛ nɛy ti buɔ̱m buɔ̱ɔ̱m ti ŋa̱ckɛ ko̱r. Ce̱t ta̱diɛn kɛ lony, kä puɔlkɛ ce̱tnikɛ kɛ̈w dɔaar. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.8",
            "verseOrgIds": [
              "1CH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu E-dhɛr a kuäär, kä cu rɛwdɛ a O-bad-yaa, kä cu diɔ̱ɔ̱kdiɛn a Ɛli-ab. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.9",
            "verseOrgIds": [
              "1CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mic-manaa a ŋuaandiɛn, kä cu Yir-mɛ-yaa a dhieecdiɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.10",
            "verseOrgIds": [
              "1CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu bäkɛliɛn a Ɛ̈-tay, kä cu bärɔwdiɛn a Ɛ-li-el, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.11",
            "verseOrgIds": [
              "1CH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu bädäkdiɛn a Yo-ɣa-nan, kä cu bäŋuandiɛn a Ɛl-dha-bad. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.12",
            "verseOrgIds": [
              "1CH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu wäliɛn a Yir-mɛ-yaa, kä cu wälkɛliɛn a Mak-ba-nay.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.13",
            "verseOrgIds": [
              "1CH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ji̱ Gad ti̱ti̱ kɛ bööth rɛ̈m ti di̱t, ram in kui̱c ni jɛn rɛydiɛn ɛ bo̱o̱th kuri, kä ram in di̱t ni jɛn ɛ bo̱o̱th bathdɔɔri. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.14",
            "verseOrgIds": [
              "1CH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ti̱ti̱ a nɛy tëë jiath kɛ kir Jɔr-dɛn kɛ pay in jio̱l, mëë ŋotdɛ kɛ thia̱ŋ. Cukɛ nɛy tëë cieŋ rɛy lööli jak kä barkɛ rɔ̱ kui̱c känyä ca̱ŋ kɛnɛ kui̱c konyä ca̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Kɔar Dee-bid thok duëël Ben-ya-min kɛnɛ Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.15",
            "verseOrgIds": [
              "1CH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ lɛ tekɛ wutni ti cu ben kä Dee-bid kä ji̱ Ben-ya-min kɛnɛ ji̱ Juda rɛy kɔ̱a̱kni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.16",
            "verseOrgIds": [
              "1CH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wä röm kɛ kɛ, kä cuɛ kɛ jiök i̱, “Mi bä yɛn kɛ ɣöö bia ɣä ben luäk, kä bia. Kä mi ba yɛn kɛ ɣöö bia ɣä no̱ŋ ji̱ tɛ̈rä, cäŋ ni mi thilɛ ɣä mi jiääk mi ca la̱tdɛ, bi Kuoth gua̱nikɔn ɛ guic kä bɛ yɛ luk.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.17",
            "verseOrgIds": [
              "1CH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱ŋɛ mɔ cu yiëë ben kä Ä-ma-thay bo̱o̱th jiɛn diɔ̱k, kä cuɛ wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ Kɔar Dee-bid thok duëël Ma-na-thɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.18",
            "verseOrgIds": [
              "1CH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu tha̱a̱ŋ nath ben kä Dee-bid kä ji̱ Ma-na-thɛ mëë cɛ ben kɛɛl kɛ ji̱ Pi-li-thɛt mëë wëë nyiëëny kɛ Thɔɔl. (Kä cuɛ ŋot /kenɛ ji̱ Pi-li-thɛt luäk kɛnɛ nɛɛkɛ, kɛ ɣöö mëë cɛ ruac kɛ kɛ, cu bööthkiɛn jɛ jak kä loc jɔk, wä kɛ i̱, “Bɛ kua̱rkɔn näk mi wëë wä loc kä kuäär ni Thɔɔl.”) ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.19",
            "verseOrgIds": [
              "1CH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min locɛ kä Dhik-lag cu ji̱ Ma-na-thɛ ti̱ti̱ ben kä jɛ. Ad-naa kɛnɛ Yo-dha-bad kɛ Yɛ-di-ä-el kɛ Mi-ka-el kɛ Yo-dha-bad kɛnɛ Ɛ-liɣu kɛ Dhi-lɛ-thay bo̱o̱th bathdɔɔri ji̱ Ma-na-thɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.20",
            "verseOrgIds": [
              "1CH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛ Dee-bid luäk kɛ nɛy tin la pɛ̈ckɛ naath. Kä kɛn diaal kɛ ji̱ ko̱o̱r, kä kɛ bööth rɛmni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.21",
            "verseOrgIds": [
              "1CH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ciaŋ la naath rɔa mät Dee-bid ba jɛ ben luäk, kä cuɛ tekɛ rɛm mi di̱i̱t mi ce̱tnikɛ rɛm Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.22",
            "verseOrgIds": [
              "1CH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rɛm Dee-bid kä Ɣɛb-ron.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 12:22"
