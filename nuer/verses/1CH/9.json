          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu A-dhel a gua̱n Ɛ̈dh-ri-kɔm kɛnɛ Bo-kɛ-ru kɛ I-ca-mel kɛnɛ Cɛ-ar-yaa kɛ O-bad-yaa kɛnɛ Ɣa-nan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.9.44",
            "verseOrgIds": [
              "1CH.9.44"
            ]
          }
        }
