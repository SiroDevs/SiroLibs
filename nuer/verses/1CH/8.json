            "number": "36",
            "style": "v",
            "sid": "1CH 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu A-ɣadh a gua̱n Yɛ-ɣo-ɛ̈-daa kä cu Yɛ-ɣo-ɛ̈-daa a gua̱n A-lɛ-mɛth kɛnɛ Ɛ̈dh-ma-wɛth kɛ Dhim-ri, kä cu Dhim-ri a gua̱n Modha. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.36",
            "verseOrgIds": [
              "1CH.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Modha a gua̱n Bina. Kä cu Bina a gua̱n Rapa kɛnɛ Ɛl-a-thaa kɛ A-dhel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.37",
            "verseOrgIds": [
              "1CH.8.37"
            ]
          }
        }
      ]
