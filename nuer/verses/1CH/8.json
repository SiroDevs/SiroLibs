          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat däman ni E-cɛk a U-lam kɛ̱̈ɛ̱̈dɛ kɛnɛ Yuc kɛ Ɛ-li-pa-lɛt.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.39",
