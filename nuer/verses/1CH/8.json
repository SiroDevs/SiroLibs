              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Mikaa a Pi-thon kɛnɛ Mɛ-lɛk kɛ Ta-reya kɛnɛ A-ɣadh. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.35",
            "verseOrgIds": [
              "1CH.8.35"
            ]
          }
        },
        {
