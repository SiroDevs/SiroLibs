              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gaat Yɛ-ro-ɣaam a Cɛ̈m-cɛ-ray kɛnɛ Cɛ-ɣar-yaa kɛ Ä-thɛ̈l-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.26",
            "verseOrgIds": [
              "1CH.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ Yä-rɛc-yaa kɛ E-li-yaa kɛnɛ Dhik-ri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.27",
            "verseOrgIds": [
              "1CH.8.27"
            ]
          }
        }
      ]
    },
