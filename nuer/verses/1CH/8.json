          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ti̱ti̱ a bööth thuk duëli kɛ kua̱rkiɛn tëë cieŋ kä Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.28",
