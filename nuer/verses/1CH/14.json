          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dee-bid kɛnɛ ji̱ dhɔaarɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣi-ram kuäär Dhor Dee-bid jäk kä naath, naŋkɛ jiɛɛn luɔ̱ɔr kɛ nɛy ti ta̱a̱th kɛ ŋa̱a̱t jiɛɛn, ti ba jɛ wä lät kä duel kuäärä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.1",
            "verseOrgIds": [
              "1CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid ɛ ŋa̱c ɛn ɣöö ci Kuoth Nhial jɛ jak kä kuäär I-thɛ-rɛl, kä cuɛ kuäärɛ kap nhial kɛ kui̱ nɛɛnikɛ ni ji̱ I-thɛ-rɛl.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.2",
            "verseOrgIds": [
              "1CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid kuɛɛn kɛ män ti ŋuan kä Jɛ-ru-tha-lɛm, cuɛ tekɛ dhɔɔl ti ŋuan kɛnɛ nyi̱er ti cua da̱p jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.3",
            "verseOrgIds": [
              "1CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ti̱ti̱ a ciööt gankɛ kä Jɛ-ru-tha-lɛm. Cä-muwä kɛnɛ Co-bab kɛ Na-than kɛnɛ Thɔ-lo-mon, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.4",
            "verseOrgIds": [
              "1CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Yib-ɣar kɛnɛ Ɛli-cuwa kɛ Ɛl-pa-lɛt, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.5",
            "verseOrgIds": [
              "1CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ No-gaa kɛ Nɛ-pɛg kɛnɛ Ya-pia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.6",
            "verseOrgIds": [
              "1CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ɛli-cama kɛnɛ Bɛɛl-yada",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:7",
              "type": "text"
            },
            {
              "text": "Bɛɛl-yada",
              "type": "text"
            },
            {
              "text": "Kä diɔ̱k kä jɛn bok ɛmɛ cɔal kɛ jɛ i̱ Ɛl-yada 3:8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kɛ Ɛ-li-pa-lɛt.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Juc Dee-bid kɛ ji̱ Pi-li-thɛt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.7",
            "verseOrgIds": [
              "1CH.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci ji̱ Pi-li-thɛt ɛ liŋ ɛn ɣöö ca Dee-bid kuany ala kuäär I-thɛ-rɛl, cu kɛn diaal jiɛɛn wa Dee-bid go̱r kä cu Dee-bid ɛ liŋ kä cuɛ ben röm kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.8",
            "verseOrgIds": [
              "1CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu ji̱ Pi-li-thɛt ben pɛɛc lo̱o̱lä ji̱ Rɛpa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.9",
            "verseOrgIds": [
              "1CH.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid Kuoth thiec i̱, “Ɣän bä wä nyiëëny kɛ ji̱ Pi-li-thɛt? Kä bikɛ ka̱m ɣä?” Kä cu Kuoth ɛ loc i̱, “Wër nyieenyni kɛ kɛ, bäkɛ ka̱m ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.10",
            "verseOrgIds": [
              "1CH.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu wä kä Baal-pɛ-ra-dhim",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "14:11",
              "type": "text"
            },
            {
              "text": "Baal-pɛ-ra-dhim",
              "type": "text"
            },
            {
              "text": "kuɛnɛ kä 2 Tham 5:20. Kɛ thok Ɣi-bɛ-ru lotdɛ ni ɣöö to̱l Kuoth Nhial naath.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kä cu Dee-bid kɛ joc ɛn wi̱ni. Kä cu Dee-bid wee “Ci Kuoth ji̱ tɛ̈rä joc kɛ ɣä, ce̱tnikɛ pul mi lɛny pi̱kɛ.” Kɛ kui̱c ɛmɔ cua gua̱a̱th ɛ mɔ cɔli Baal-pɛ-ra-dhim. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.11",
            "verseOrgIds": [
              "1CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ kuthkiɛn ba̱ny ɛn wi̱ni, kä cu Dee-bid kɛ jak kä waŋkɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.12",
            "verseOrgIds": [
              "1CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Pi-li-thɛt rɔ̱ nyɔk kɛ pëc lo̱o̱lä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.13",
            "verseOrgIds": [
              "1CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Dee-bid Kuoth thiec, kä cu Kuoth ɛ loc i̱, “/Cu wä lotdi ni kɔriɛn. Win rɔ, kä mak nikɛ kɛ kui̱c in lot ni jiɛɛn baltham. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.14",
            "verseOrgIds": [
              "1CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wi̱i̱ jɔw wä liŋ mi wä kɛ wuɔ̱th jiɛɛn baltham, ku wä nyieenykɛ kɛ. Kɛ ɣöö ɣän ca wä nhiamdu bä rɛm ji̱ Pi-li-thɛt wä joc.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.15",
            "verseOrgIds": [
              "1CH.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid ɛ la̱t ce̱tnikɛ min ci Kuoth ɛ la̱r jɛ, kä cukɛ rɛm ji̱ Pi-li-thɛt näk nikä Gib-yon ca mäni Gɛ-dhɛr. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.16",
            "verseOrgIds": [
              "1CH.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛ̈k Dee-bid räth wi̱i̱ muɔ̱ɔ̱n kɛɛliw, kä cu Kuoth Nhial döör diaal jak kä dual kɛ jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.14.17",
            "verseOrgIds": [
              "1CH.14.17"
            ]
          }
        }
      ]
    }
  ],
