        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "No̱o̱ŋ thandukä matdä ruac Kuɔth kä Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Dee-bid rɔ lät kä duel därwec Dee-bid. Kä cuɛ kɛmɛ yiath piny kɛ kui̱ thandukä matdä ruac Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wee i̱, “Thilɛ raan ɛ ni raan Lii-bay ɛnɔ bi thanduk matdä ruac Kuɔth kapɔ, kɛ ɣöö ci Kuoth Nhial kɛ mɛk kɛ ɣöö ba thanduk matda ruacdɛ kap kä bikɛ jɛ lät ikä amäni cäŋ kɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.2",
            "verseOrgIds": [
              "1CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ji̱ I-thɛ-rɛl diaal dol kä Jɛ-ru-tha-lɛm, kɛ ɣöö ba thanduk matdä ruac Kuɔth nööŋ gua̱thdɛ min cɛ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.3",
            "verseOrgIds": [
              "1CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gaat Ä-ron kɛnɛ ji̱ Lii-bay dol kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.4",
            "verseOrgIds": [
              "1CH.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.10",
            "verseOrgIds": [
              "1CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Dee-bid bööth palä ni Dha-dok kɛnɛ Ɛb-ya-thar kɛ ji̱ Lii-bay ni U-ri-el kɛnɛ Ä-tha-yaa kɛ Yo-el kɛnɛ Cɛ-mɛ̈-yaa kɛ Ɛ-li-el kɛnɛ A-mi-na-dab cɔl. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ jiök i̱, “Kɛ yɛn bööth thuk duëli ji̱ Lii-bay. Lɛ̈yɛ rɔ̱ kɛ gaatmanikun, kɛ ɣöö bia thanduk matdä ruac Kuɔth Nhial min la Kuoth I-thɛ-rɛl wä nööŋ guäth ɛ ca la̱t kɛ kui̱dɛ mi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ken yɛnɛ wä nööŋ ɛ yɛn kɛ nhiam yɛn ji̱ Lii-bay, ɛ jɛn ci Kuoth Nhial min la Kuothdan gaak kɛ kɔnɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu bööth palä kɛ ji̱ Lii-bay rɔ lɛy, kɛ ɣöö ba thanduk matdä ruac Kuɔth Nhial Kuoth I-thɛ-rɛl wä nööŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
              "1CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Lii-bay thanduk matdä ruac Kuɔth kap kɛ jiɛɛn kɛ wuɔ̱ɔ̱kiɛn. Ce̱tnikɛ ruac Kuɔth Nhial mëë ci Muthɛ jɛ lar.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.15",
            "verseOrgIds": [
              "1CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Muthɛ bööth ji̱ Lii-bay lɛni jiök kɛ ɣöö ba naath ti bia̱ këët din kuany kä gaatmani, ti bi diit puɔ̱nydä kɛt kɛ thuɔmni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Lii-bay Ɣe-man gat Yo-el kɛnɛ A-thap gat Bɛ-rɛk-yaa kä gaat Mɛ-ra-ri kɛ E-than gat Ku-ca-yaa kuany. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.17",
            "verseOrgIds": [
              "1CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu lua̱a̱kiɛn a Dhɛ-kar-yaa kɛnɛ Ya-dhel kɛ Cɛ-mi-ra-moth kɛnɛ Yɛ-ɣi-el kɛ Uni kɛnɛ Ɛli-ab kɛ Bɛ-na-yaa kɛnɛ Mä-the-yaa kɛ Mɛ̈-tith-yaa kɛnɛ Ɛ-li-pɛ-le-ɣu kɛ Mik-ne-yaa kɛ gääŋ thuɔk rɛ̈ɛ̈k ni O-bed-ɛ-dom kɛnɛ Yi-el. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.18",
            "verseOrgIds": [
              "1CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu këët din a Ɣe-man kɛnɛ A-thap kɛ E-than, pua̱a̱t thuɔmni yieethä min yian. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.19",
            "verseOrgIds": [
              "1CH.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dhɛ-kar-yaa Ä-dhi-el kɛ Cɛ-mi-ra-moth kɛnɛ Yɛ-ɣi-el kɛ Uni kɛnɛ Ɛli-ab kɛ Mä-the-yaa kɛnɛ Bɛ-na-yaa la pua̱a̱t bä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.20",
            "verseOrgIds": [
              "1CH.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mɛ̈-tith-yaa kɛnɛ Ɛ-li-pɛ-le-ɣu kɛ Mik-ne-yaa kɛnɛ O-bed-ɛ-dom kɛ Yi-el kɛ Ä-dhɛ̈dh-yaa a pua̱a̱t thuɔmni bä. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.21",
            "verseOrgIds": [
              "1CH.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua Kɛ-nan-yaa kuany ala bo̱o̱th ji̱ Lii-bay tin pua̱tkɛ thuɔmni, kɛ ɣöö ŋäcɛ puɔ̱t thuɔm agɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.22",
            "verseOrgIds": [
              "1CH.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ-rɛk-yaa kɛnɛ Ɛl-ka-na a ga̱a̱ŋ thuɔk duëël thandukä matdä ruac. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.23",
            "verseOrgIds": [
              "1CH.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Cɛ-bɛ̈n-yaa kɛnɛ Yo-ca-pat kɛ Nɛ-tan-el kɛnɛ Ä-ma-thay kɛ Dhɛ-kar-yaa kɛnɛ Bɛ-na-yaa kɛ Ɛ-li-dhɛr bo̱o̱th palä a kuɔ̱ɔ̱th kaaŋä nhiam thandukä matdä ruac Kuɔth. Kä O-bed-ɛ-dom kɛnɛ Yɛ-ɣi-yaa a ga̱a̱ŋ thuɔk duëël thandukä matdä ruac bä.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naŋ thandukä matdä ruac kä Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn cu Dee-bid kɛnɛ bööth I-thɛ-rɛl kɛ bööth bathdɔɔri wä wa thanduk matdä ruac Kuɔth Nhial nööŋ dhɔr O-bed-ɛ-dom kɛ tɛ̈th lɔaac mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ɣöö ci Kuoth ji̱ Lii-bay tëë kapkɛ thanduk matdä ruac Kuɔth Nhial luäk, cukɛ thääk bärɔw kɛnɛ rueeth rɔɔmni da̱ŋ bärɔw thöp ala muc. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.26",
            "verseOrgIds": [
              "1CH.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid kɛnɛ ji̱ Lii-bay tin kapkɛ thanduk matdä ruac tekɛ bieyni ti gɔw, kä cu ji̱ Lii-bay tin këët din kɛ Kɛ-nan-yaa bo̱o̱th pua̱a̱t thuɔmni këët din cu Dee-bid bieyni kath la̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.27",
            "verseOrgIds": [
              "1CH.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu ji̱ I-thɛ-rɛl diaal thanduk matdä ruac Kuɔth Nhial nööŋ kɛ diit kɛnɛ buɔ̱l kɛ kaaŋ kɛ ŋar mi di̱i̱t.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci thanduk matdä ruac Kuɔth Nhial cop däärwec Dee-bid, cu nya Thɔɔl ni Mi-kal guic kɛ wernyin, cuɛ kuäär ni Dee-bid nɛn duthɛ kä tɛth lɔcdɛ. Kä cuɛ jɛ lat jɔ̱ɔ̱r kɛ rɛy lɔaacdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
      ]
    }
  ],
