  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mät Ti-mo-thi rɔ Puɔl kɛnɛ Thay-läth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Puɔl wä kä Dɛr-bi kɛnɛ Lith-tɛ-ra gua̱a̱th in te raan kɔaar Yecu mi cɔal i̱ Ti-mo-thi thi̱n, mi gat nya ji̱ Juudh mi ŋa̱th, kä gua̱n ɛ raan Gɛ-rith. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ruac naath kɛ ciötdɛ a gɔaa kä Lith-tɛ-ra kɛnɛ Ay-ko-niäm. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Go̱o̱r Puɔl ɣöö bi Ti-mo-thi rɔ ma̱t jɛ. Cuɛ jɛ naŋ kä cuɛ jɛ cuɛl kɛ kui̱ ji̱ Juudh tin te gua̱thni tɔ̱tɔ̱, kɛ ɣöö ŋäc kɛn diaal ɛ ɛn ɣöö gua̱n ɛ raan Gɛ-rith. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë jälkɛ rɛy wi̱i̱ni, cukɛ mëë ca mat ɛ jaak Yecu kɛnɛ di̱t tin te kä Jɛ-ru-tha-lɛm ka̱m kɛ, kɛ ɣöö bakɛ luɔ̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ cu duël Kuɔth bum rɛy ŋäthä, kä wäkɛ kä mi rëpkɛ rɔ̱ ni ciaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuuth Puɔl kä Ti-ro-ath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ wä kɛ Pɛ-ri-jia kɛnɛ Gä-lëë-cia, kɛ ɣöö ca kɛ gok ɛ Yiëë in Gɔaa in Rɛl Rɔ ɛn ɣöö /cikɛ ruac Kuɔth bi lat kä E-cia. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cikɛ ben lotdä Midh-ya, cukɛ jɛ go̱r ɛn ɣöö bikɛ wä kä Bi-thi-nia, kä duundɛ ɣöö /ken Yiëë Yecu kɛ nhök wä. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ ba̱liɛn kɛ Midh-ya, cukɛ rɔ̱ luɔ̱ŋ kä Ti-ro-ath. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä wäär cu Puɔl nyuuth nɛn cuɛ raan Ma-tha-do-nia mi te cuŋä nɛn mi pal jɛ kä jio̱kɛ jɛ i̱, “Bër kui̱c kä kɔ kä Ma-tha-do-nia, bikɔ ben luäk.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ nyuuth nɛn, ni ɛn guäth ɛmɔ cua kɔ jɛ go̱r ɛn ɣöö dëëkɔ wä kui̱c kä Ma-tha-do-nia, kɛ ɣöö cakɔ jɛ car ɛn ɣöö ci Kuoth kɔ cɔl i̱ bakɔ thuk ti gɔw wä la̱t kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Riet Lu-dia kɛ rɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ mëë jiay kɔ kä Ti-ro-ath kɛ riey, cua kɔ jɛ cuɔ̱ŋ Tha-mo-ti-reth, kä mëë ruɔ̱ndɛ cua kɔ wä kä Nia-po-lɛth, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä ɛn wi̱ni cua kɔ wä kä Pi-li-pi min mɔ wec in nhiam rɛy rööl Ma-tha-do-nia, kä ruackɛ jɛ ɛ ji̱ Röm. Cua kɔ tekɛ ni̱n ɛn wi̱c ɛmɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ lɔ̱ŋä ji̱ Juudh cua kɔ wä raar kɛ thok in lot ni thok kiɛɛr, mi carkɔ i̱ dɔŋ derɛ tekɛ gua̱a̱th palä. Kä cua kɔ nyuur, kä cua kɔ ruac kɛ män ti ca rɔ dol ɛn wi̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ciek kɛl mi cɔali Lu-dia mi pääl Kuɔth ruacda liŋ. Jɛn ɛ raan wec Thay-tay-ra, mi la kɔk bieyni ti mɛ̈r. Cu Kuäär ni Kuoth lɔcdɛ lɛp kɛ ɣöö bɛ ruaacni tin ca lat ɛ Puɔl liŋ kɛ di̱t lɔaac. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ca jɛ lak kɛnɛ ji̱ ciëŋdɛ diaal, cuɛ kɔ pal, wëë i̱, “Mi cia jɛ jek ɛn ɣöö ta̱a̱kɛ ŋa̱th kɛ Kuäär ni Yecu, bia ciëŋɛ dueelä.” Kä cuɛ kɔ kok kɛ ɣöö bakɔ cieŋ kɛ jɛ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔl kɛnɛ Thay-läth dueel yieenä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ kɛl mëë wa̱kɔ guäth palä, cua kɔ Röm kɛ nyam mi kuany, mi tekɛ yiëë mi jiääk mi mar ŋɔaani ti bi jɔɔc, kä no̱ŋɛ ji̱kɛ ria̱ŋ kɛ kui̱ latädɛ kɛ ŋɔaani ti bi ben. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɔ kɛ Puɔl guɔ̱ɔ̱r, kä rɔalɛ wëë i̱, “Kɛn wutni ti̱ti̱ kɛ ja̱a̱ŋ Kuɔth nhial in Di̱t ni Jɛn, tin la̱tkɛ yɛ duɔ̱ɔ̱p känä.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ mɛmɛ lat kɛ ni̱n ti ŋuan. Kä cu Puɔl gaak ɛlɔ̱ŋ, kä cuɛ rɔ riet jɛ, kä cuɛ yiëë in jiääk jiök i̱, “Ɣän jiökä ji̱ kɛ ciöt Yecu Kritho, i̱ bër raar kä jɛ.” Kä cuɛ ben raar kɛ jɛn thaak ɛmɔ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ji̱kɛ jɛ nɛn ɛn ɣöö ci duɔ̱ɔ̱p in jek kɛn ɛ ni yio̱w thil, cukɛ Puɔl kɛnɛ Thay-läth käp, kä cukɛ kɛ yɔ̱a̱c nhiam kua̱ri guäth ko̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cikɛ kɛ nöŋ nhiam ji̱ luɔ̱k cukɛ wee i̱, “Wutni ti̱ti̱ nyuɔnkɛ wecdan kä kɛ ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ŋi̱eeckɛ naath kɛ ciɛŋ tin /ca rɔ̱ lot kɛ ŋut kɔn, kɔn ji̱ Röm. /Canɛ kɛ dee nhɔk kiɛ la̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu buɔ̱n rɔ mat kä makɛ kɛ, kä cu ji̱ luɔ̱k bieynikiɛn rɛ̈t kä cukɛ jɛ lat ɛn ɣöö bakɛ duäc kɛ kɛtni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr kä mëë cikɛ kɛ duäc ɛlɔ̱ŋ, cua kɛ yuɔr luaak yieenä, kä cua la̱t yieen ɛn ɣöö bɛ kɛ yien agɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ guridɛ kɛ ruac ɛmɛ, cuɛ kɛ la̱th dueel yieenä in te ni rɛci, kä cuɛ ciökiɛn gak kɛ jiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ gua̱a̱th wa̱rda̱a̱r cu Puɔl kɛnɛ Thay-läth pal kä kietkɛ Kuoth diit, kä liŋ ji̱ yieenä tin kɔ̱ŋ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ɛn guäth ɛmɔ cuɛ tekɛ lath piɛny mi di̱i̱t, mi cu cuɔ̱ɔ̱ŋ duëël yieenä yɔ̱k. Kä ni ɛn guäth ɛmɔ, cu thiekni diaal rɔ̱ lɛp, kä cu kuatni ciikni nɛɛni diaal rɔ̱ lony. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci yieen keer, kä cɛ thiekni duëël yieenä nɛn ca rɔ̱ lɛp, cuɛ thɛpdɛ ka̱n, kä cuɛ go̱r ɛn ɣöö bɛ näk, ŋäcɛ ni ɣöö ci ji̱ yieenä rɔ̱ kual. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Puɔl yɔal kɛ jɔw mi di̱i̱t i̱, “/Cu rɔ lät kä mi jiääk, kɛ ɣöö kɔn diaal a thi̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ yieen mac cɔl, kä cuɛ wä rɛc kɛ pɛ̈th kä cuɛ rɔ yuɔr piny nhiam Puɔl kɛnɛ Thay-läth kä lath jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kɛ nööŋ raar kä cuɛ wee i̱, “Kua̱r, ɛŋu mi bä dhil kɛ la̱t kɛ ɣöö bä kään?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jɛ loc i̱, “Ŋäth ni Kuäär ni Yecu, kä ba ji̱ kän, ji̱n amäni ji̱ ciëŋdu diaal.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ ruac Kua̱r ni Yecu la̱t jɛ, kɛnɛ ji̱ ciëŋdɛ nɛy diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ naŋ kɛ jɛn thaak wa̱r ɛmɔ, cuɛ buɔ̱ɔ̱tkiɛn lak, kä ni ɛn guäth ɛmɔ pa̱ny, cua jɛ lak kɛnɛ ji̱ gɔaalɛ diaal a thil gal. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ, cuɛ kɛ nööŋ dueelɛ, kä cuɛ kɛ moc mi̱eth. Kä cu lɔcdɛ tɛɛth kɛnɛ ji̱ ciëŋdɛ diaal, kɛ ɣöö cɛ Kuoth ŋäth.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci ɣɔw baak, cu ji̱ luɔ̱k bolithni ja̱k, jiökɛ kɛ i̱, “A wutni tɔ̱tɔ̱ wä.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu yieen rieet ti̱ti̱ la̱t Puɔl, jio̱kɛ jɛ i̱, “Ci ji̱ luɔ̱k yɛ jäkä ruac i̱, ‘Wiaa. Kɛ kui̱ ɛmɔ täämɛ bia raar, kä wiaa kɛ mal.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Puɔl kɛ loc i̱, “Cikɛ kɔ duäc nhiam nath, a /ka̱n duera jek rɛy luɔ̱k, kä kɛ kɔn wutni ti dieel ji̱ Röm, kä cikɛ kɔ yuɔr dueel yieenä. Kä täämɛ luɔnykɛ kɔ kɛ tɛ̱̈ɛ̱̈? Ëëy! A bä ni pua̱nykiɛn, bikɛ kɔ ben ka̱m raar.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu bolithni rieet ti̱ti̱ la̱t ji̱ luɔ̱k, kä cukɛ dual, mëë cikɛ jɛ liŋ ɛn ɣöö kɛ ji̱ Röm. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ cukɛ ben, cukɛ duer ben lar. Cukɛ kɛ ka̱m raar kä la̱ŋkɛ kɛ kɛ ɣöö bikɛ jiɛɛn wi̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr kä min cikɛ wä raar dueel yieenä, cukɛ wä dhɔr Lu-dia. Kä mëë cikɛ dämani kɛnɛ nyimani rɛy Kritho nɛn, cukɛ kɛ com, kä cukɛ jiɛɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    }
