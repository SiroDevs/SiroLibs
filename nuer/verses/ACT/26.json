        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ga̱ŋ Puɔl kɛ rɔ nhiam Ag-ri-pa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Ag-ri-pa Puɔl jiök i̱, “Ji̱n ti̱i̱ kɛ gua̱a̱th kɛ ɣöö bi ruacdu lat.” Kä cu Puɔl tetdɛ riny kä cuɛ ga̱ŋdɛ kɛ rɔ lat i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.1",
            "verseOrgIds": [
              "ACT.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän caarä jɛ ɛn ɣöö ta̱a̱ kɛ baŋ kɛ ɣöö ɛ nhiamdu, ji̱n kuäär ni Ag-ri-pa, ɛn ni̱n bä ga̱ŋdä kɛ rɔ lat thi̱n wa̱lɛ kɛ kui̱ go̱o̱nyni diaal tin gɔanykɛ ni ɣä ɛ ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.2",
            "verseOrgIds": [
              "ACT.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋäci ciɛŋ ji̱ Juudh diaal ɛlɔ̱ŋ, kɛnɛ ŋaknɔmnikiɛn. Kɛ kui̱ ɛmɔ ɣän la̱ŋä ji̱ kɛ ɣöö bi ɣä liŋ kɛ päl piny.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.3",
            "verseOrgIds": [
              "ACT.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ji̱ Juudh diaal ŋa̱ckɛ tëkdä ni ŋuɛɛtädä. Ŋäc kɛn tëkdä kɛɛliw, a tookɛ jɛ kɛ nhiam ni wi̱i̱dä cu mäni Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.4",
            "verseOrgIds": [
              "ACT.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci kɛn ɛ ŋa̱c kɛ gua̱a̱th mi bäär, mi deekɛ thuɔ̱k lat, ɛn ɣöö ɛ ɣän raan Pa-ri-thii buɔ̱n in cuŋ ciaaŋdiɛn ɛlɔ̱ŋ kɛ ciaŋ Kuoothäda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.5",
            "verseOrgIds": [
              "ACT.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ cuɔ̱ŋä rɛy luɔ̱k wanɛ mɛ, kɛ kui̱ ŋäthä kɛ min ci Kuoth ɛ la̱t gua̱ndɔɔŋnikɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.6",
            "verseOrgIds": [
              "ACT.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛ jɛn ɛn ni̱n go̱o̱r thuk duëlikɔ da̱ŋ wäl wi̱cdɛ rɛw ɛ i̱ dëë jek, min palkɛ Kuɔth kɛ wäär kɛnɛ cäŋ. Kä ɛ kui̱ ŋäthä ɛmɔ Kuäär ɛn min gɔanykɛ ni ɣä ɛ ji̱ Juudh! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.7",
            "verseOrgIds": [
              "ACT.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛŋu caar yɛn ɛmɔ, yɛn nɛy ti̱ti̱ ɛn ɣöö /ci Kuoth naath dee jiɛc li̱th?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.8",
            "verseOrgIds": [
              "ACT.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän bä cua jɛ car ɛn ɣöö bä la̱t ni ti ŋuan ti gua̱c kɛ ciöt Yecu raan Na-dha-rɛth. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.9",
            "verseOrgIds": [
              "ACT.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛ jɛn min cua̱ lat kä Jɛ-ru-tha-lɛm. Cua buɔ̱m jek kä bööth palä tin di̱t kɛ ɣöö bä nɛɛ Kuɔth ti ŋuan la̱th dueel yieenä, kä mëë cakɛ kum kɛ lia̱a̱, cua mëkdä la̱th kä ɣöö bakɛ näk. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.10",
            "verseOrgIds": [
              "ACT.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gua̱thni ti ŋuan cäkɛ jak kä dua̱ckɛ gua̱thni palä ji̱ Juudh diaal, kä cua̱ jɛ ɣɔ̱n ɛn ɣöö bikɛ ruac jiäk kɛ Yecu. Kä kɛ kɛ̈c lɔaac mi di̱i̱t kä kɛ, cua wä wi̱i̱ni ti kɔ̱kiɛn kɛ ɣöö bäkɛ wä duäc.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lat Puɔl kɛ ri̱etdɛ kɛ rɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.11",
            "verseOrgIds": [
              "ACT.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ɛ kui̱ kä nɛmɛ ɛ nëë wä kɛ ɣä kä Da-math-kɛth kɛ lua̱ŋ kɛnɛ ruac bööthni palä tin di̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ cäŋdäär, lö kuäär rɛy duɔ̱p, cua buay mi bëë nhial nɛn mi buɔy ni jɛn kä buay ca̱ŋ, mɛrɛ gua̱a̱th ëë ta̱a̱ thi̱n kɔnɛ nɛy tëë jäl kɛɛl kɛ ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cakɔ tɛɛth kɔn diaal, cua jɔw liŋ mi ruac kɛ ɣä kɛ thok Ɣi-bɛ-ru i̱, ‘Thɔɔl, Thɔɔl, ɛŋu ciɛŋi ɣä a jiäk ɔ? Moci ni rɔ kɛ buɔ̱t kɛ kuëtdu kɛ taŋ mi moth thokdɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua thiec i̱, ‘Ɛ ji̱n ŋa, Kuäär?’ Kä cu Kuäär wee i̱, ‘Ɛ ɣän Yecu in ciɛŋi a jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö jiɛc rɔ kä cuŋni kɛ ciöku. Kɛ ɣöö cä päl kä ji̱ kɛ kui̱ kä mɛmɛ, ɛn ɣöö cä ji̱ kuany ala läätdä. Kä bi naath la̱t tin ci nɛn kä ɣä kɛnɛ ŋɔaani tin bä nyuɔ̱th ji̱ kɛ nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä ji̱ luäk kä nɛɛku kɛnɛ Jur tin ja̱kä ji̱ kä thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi wäŋkiɛn lɛp, kɛ ɣöö dee kɛ rɔ̱ ri̱t kä muth kä dee kɛ wä buɔyä, kɛnɛ rietdiɛn kɛ rɔ̱ kä buɔ̱m Cɛy-tan, wädiɛn kä Kuoth, kɛnɛ ɣöö dee kɛ päl dueeri jek, kɛnɛ gua̱a̱th rɛy nɛɛni tin ca lɛy kɛ ŋa̱thdiɛn kɛ ɣä.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lär Puɔl kɛ la̱tdɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ ɛmɔ, lö kuäär ni Ag-ri-pa, /ka̱n thil luth kɛ nyuuth in cä nɛn nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua la̱t nɛy tëë te kä Da-math-kɛth kɛ nhiam kɛ Jɛ-ru-tha-lɛm, kɛnɛ ro̱l Ju-dia kɛɛliw cu amäni Jur bä, ɛn ɣöö bikɛ rɔ̱ ri̱t dueeri kä bikɛ rɔ̱ riet Kuoth, kä bikɛ lät ti ro̱ŋ kɛ rietdiɛn kɛ rɔ̱ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ kä mɔmɔ cu ji̱ Juudh ɣä käp rɛy luaak Kuɔth, kä cukɛ go̱r ni näkdä. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä amäni ɛn wa̱lɛ luäk ɣä Kuoth. Kä ɛnɔ ɣän cuɔ̱ŋä wanɛ mɛ, la̱tdä nëndä nɛy diaal tin tɔatni kɛnɛ tin di̱t. Kä thilɛ mi latdä ɛ ni tëë ci göök kɛ Muthɛ kɛ lat ɛn ɣöö bi tuɔɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Min la ɣöö bi Mɛ-thia ti bɛ̈c bɛ̈ɛ̈c dhil rut, kä ɛ jɛn ram in kɔŋ rɔ jiɛc li̱th, kä bɛ ruac buɔyä la̱t nɛɛkɔn kɛnɛ Jur.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
