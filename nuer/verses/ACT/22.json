  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "ACT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dämaari yɛnɛ gua̱a̱ri, liɛŋɛ ruacdä min gaŋä rɔ mɛ latdä nhiamdun ɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
            "verseOrgIds": [
              "ACT.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
            "verseOrgIds": [
              "ACT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cikɛ jɛ liŋ ɛ ruacɛ kɛ thok Ɣi-bɛ-ru, cukɛ cu biɛt ɛ lik. Kä cuɛ wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ ɣän raan Juudh, diëth kɛ ɣä kä Tar-thäth ro̱o̱l Thi-li-cia, kä duundɛ ɣöö piɛth kɛ ɣä ɛn wi̱c ɛmɛ ala mi ca ŋi̱eec ɛ Gam-li-el. Kä ca ɣä ŋi̱eec kɛ ciaŋ ŋuɔ̱tni gua̱ndɔɔŋnikɔn a thil diw, kä ɣän di̱t lɔcdä kɛ Kuɔth ce̱tkɛ min te yɛn diaal ɛn wa̱lɛ mɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cua Duɔ̱ɔ̱p ɛmɛ ciɛŋ a jiäk cu mäni lia̱a̱, yianä naath kä naŋä wutni kɛnɛ män kä naŋä kɛ luaak yieenä, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ mi ci bo̱o̱th palä in di̱i̱t kɛnɛ duɔl di̱tni kɛɛliw nën lat kɛ kui̱dä. Ɣän cä warɛgakni ka̱n kä kɛ kɛ nöŋäkɛ dämanikɔn ni Juudh, tin te kä Da-math-kɛth, cua wä ɛn wi̱ni kɛ ɣöö bä nɛy tin te ɛn wi̱ni wä yian, kä nööŋä kɛ kä Jɛ-ru-tha-lɛm kɛ ɣöö bakɛ ben tɔ̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lat Puɔl kɛ rietdɛ kɛ rɔ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mëë ta̱a̱ jälä a cä thia̱k kɛ Da-math-kɛth, kɛ gua̱a̱th ca̱ŋda̱a̱r ni kä kɛɛl cu buay mi di̱i̱t ben nhial kä cuɛ gua̱a̱th in ta̱a̱ thi̱n mɛr. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.6",
            "verseOrgIds": [
              "ACT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua tɛɛth, kä cua jɔw liŋ jio̱kɛ ɣä i̱, ‘Thɔɔl, Thɔɔl, ɛŋu ciɛŋi ɣä a jiäk ɔ?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jɛ loc i̱, ‘Ɛ ji̱n ŋa, Kuäär?’ Kä cuɛ ɣä jiök i̱, ‘Ɛ ɣän Yecu raan Na-dha-rɛth min ciɛŋi a jiäk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ nɛy tëë te kɛɛl kɛ ɣä cua buay nɛn kä /kenkɛ jɔw raam ëë ruac kɛ ɣä liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.9",
            "verseOrgIds": [
              "ACT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua wee i̱, ‘Ɛŋu mi bä la̱t, Kuäär?’ Kä cu Kuäär ɣä jiök i̱, ‘Jiɛc rɔ, kä wër kä Da-math-kɛth, ɛn wi̱ni ba ji̱ wä la̱t ŋɔaani diaal tin ca ka̱m ji̱ bi la̱t.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë thilɛ mi nɛ̈ɛ̈nä, kɛ kui̱ buɔyä ɛmɔ, cua ɣä käp tetdä ɛ nɛy tëë tekɛ ɣä kɛɛl, kä cua ɣä buath kä Da-math-kɛth.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä te ram mi cɔal i̱ A-na-ni-ath mi luth Kuoth kɛ ciaŋ ŋuɔ̱t, kä tëëkɛ kɛ̈k mi gɔaa kä ji̱ Juudh diaal tin cieŋ ɛn wi̱ni. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.12",
            "verseOrgIds": [
              "ACT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ben kä ɣä, kä cuŋɛ gekädä cuɛ ɣä jiök i̱, ‘Dämaar ni Thɔɔl, nyɔk rɔ kɛ guec!’ Kä ni ɛn guäth ɛmɔ cua rɔ nyɔk kɛ guec, kä cua jɛ nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.13",
            "verseOrgIds": [
              "ACT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ɣä jiök i̱, ‘Kuoth gua̱ndɔɔŋnikɔn cɛ ji̱ kuany kɛ ɣöö bi min go̱o̱rɛ ŋa̱c, kɛnɛ ɣöö bi Gua̱n Cuuŋä nɛn, kä bi jɔwdɛ min ruackɛ jɛ liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.14",
            "verseOrgIds": [
              "ACT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱n a neendɛ kä nɛy diaal kɛ kui̱ kä tin ci nɛn kä ci liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.15",
            "verseOrgIds": [
              "ACT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ ɛŋu mi liipi? Jiɛc rɔ, kä ba ji̱ lak, kä a dueerku lakɛ jɔ̱ɔ̱r, kɛ palu kɛ ciötdɛ.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jäkni Puɔl kä jur",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛ kɔr kä mëë cä luny kä Jɛ-ru-tha-lɛm mëë palä rɛy luaak Kuɔth, cua nyuuth nɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cua Kuäär nɛn jio̱kɛ ɣä i̱, ‘Pɛ̈thni, kä mali wä raar rɛy Jɛ-ru-tha-lɛm, kɛ ɣöö /cikɛ la̱t nenädu kɛ kui̱dä bi nhɔk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua wee i̱, ‘Kuäär, kɛn pua̱nykiɛn ŋa̱ckɛ jɛ ɛn ɣöö gua̱th pali ji̱ Juudh diaal cä nɛy tin ŋa̱thkɛ ji̱ yian kä cäkɛ duäc. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë wuɔ̱thkɛ riɛm Thi-bɛn in la neendu piny, ɣän bä ta̱a̱ cuŋä kä nhɔakä lia̱a̱dɛ, kä yiënä bieyni nɛɛni tëë na̱kɛ jɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ɣä jiök i̱, ‘Jiɛyni kɛ ɣöö bä ji̱ jäkä Jur guäth mi na̱n.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu naath te liŋ Puɔl amäni mëë cɛ nɛmɛ lat, kä cukɛ rɔal ɛlɔ̱ŋ, cukɛ wee i̱, “A ram mi ce̱tkɛ nɔ wuɔckɛ wi̱i̱ muɔ̱ɔ̱n! Kɛ ɣöö /cɛ ro̱ŋ kɛ ɣöö bɛ tëk.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi rɔalkɛ, kä yɔ̱a̱kɛ bieynikiɛn, kä yuɔrkɛ tup nhial, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu kuäär lathkëëri in di̱i̱t jɛ lar ɛn ɣöö ba jɛ nööŋ rɛc guäth lathkëëri, kä cuɛ jɛ lar ɛn ɣöö ba jɛ ɣɔ̱n kɛ duäc kɛ ɣöö ba min rɔal kɛ naath kɛ kui̱dɛ jek. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cikɛ jɛ yian kɛ ɣöö ba duäc, cu Puɔl kuäär lathkëëri mi te cuŋä gekädɛ jiök i̱, “Ɛ ŋut kä yɛ ɛn ɣöö ba ram mi diel kä Röm duäc, ɛ /ka̱nɛ kuɛth guäth luɔ̱k?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci kuäär in tɔt mɔmɔ liŋ, cuɛ wä kä kuäär in di̱i̱t, kä cuɛ jɛ jiök i̱, “Ɛŋu mi go̱o̱ri bi la̱t? Wut ɛmɛ ɛ diel kä Röm.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär lathkëëri in di̱i̱t ben, kä cuɛ Puɔl thiec i̱, “Läri jɛ ɣä, ɛ ji̱n diel Röm?” Kä cu Puɔl wee i̱, “Ɣɔ̱ɔ̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu kuäär lathkëëri in di̱i̱t jɛ loc i̱, “Ɣän cä di̱i̱l ɛmɛ kɔk kɛ yio̱w ti ŋuan.” Kä cu Puɔl wee i̱, “Kä ɣän ca ɣä dap ala diel.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni ɛn guäth ɛmɔ cu nɛy tin görkɛ duäcdɛ, rɔ lɛ̈k jɔk kä jɛ. Kä cu kuäär lathkëëri in di̱i̱t dual bä, kɛ ɣöö cɛ jɛ ŋa̱c ɛn ɣöö Puɔl ɛ diel Röm, kä cɛ jɛ yiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Puɔl nhiam ji̱ luɔ̱k",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min go̱o̱r kuäär lathkëëri ɣöö bɛ thuɔ̱k lotdä min gɔanykɛ Puɔl ɛ ji̱ Juudh ŋa̱c, mëë ruɔ̱ndɛ cuɛ Puɔl lony, kä cuɛ lar ɛn ɣöö bi bööth palä tin di̱t kɛnɛ ji̱ luɔ̱k diaal mat. Kä cuɛ Puɔl nööŋ, kä cuɛ jɛ jakä cuŋ nhiamdiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
        }
      ]
