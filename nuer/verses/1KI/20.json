          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gök ben kä kuäär I-thɛ-rɛl, kä cuɛ jiök i̱, “Bër bum rɔ, kä ŋäcni min bi la̱t agɔaa. Kɛ ɣöö i̱ ruel bi kuäär Thi-ri-ya ben nyiëëny kɛ ji̱.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mäk Thi-ri-ya in rɛwdɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
