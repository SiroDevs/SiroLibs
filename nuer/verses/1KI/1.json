            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ja̱a̱l Ä-do-ni-yaa diaal dual, kä cukɛ rɔ jiɛc, wä ram ɔ dupdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
