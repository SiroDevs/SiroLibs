            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär rɔ yac wëë i̱, “Ce̱tkɛ ciöt Kuɔth in tëk, mëë kään tëkdä kä ji̱ tɛ̈rä, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tnikɛ min cä ya̱c ji̱ kɛ ciöt Kuɔth Nhial, Kuoth I-thɛ-rɛl i̱, ‘Gatdu ni Thɔ-lo-mon ɛ jɛn bi ruec kɔɔrä mɔ, kä bi nyuur wi̱i̱ kɔamdä mɔ.’ Bä la̱t ɛn walɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ̈th-cɛba rɔ goŋ lätdɛ kuäär kä luth, wëë i̱, “Bi kuäärä ni Dee-bid tëk amäni cäŋ kɛl!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
