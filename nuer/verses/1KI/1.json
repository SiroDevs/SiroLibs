          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ä-do-ni-yaa dual kɛ Thɔ-lo-mon. Cuɛ rɔ wä käp kɛ tuɔ̱ŋ yi̱kä. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
