      },
      "items": [
        {
          "text": "Go̱o̱ny Yir-mɛ-yaa kä Kuoth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luɔ̱c Kuɔth kɛ Yir-mɛ-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.13",
            "verseOrgIds": [
              "JER.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛmɛ ɛ min ci Kuoth Nhial ɛ lar wëë i̱, “Kɛ kui̱ ji̱ thieekä nɛɛnikä ni ji̱ I-thɛ-rɛl diaal tin jiäk tëë ca mun ëë cä ka̱m nɛɛkä däk, nɛnɛ, ɣän bä kɛ yuɔ̱t raar muundiɛn, kä bä dhɔr Juda kän rɛydiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr kä min cä kɛ kän, bä tekɛ kɔɔc lɔaac kɛ kɛ, kä bä ram ɔ ku luɔc guäthdɛ ni muundɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä kɛn duɔ̱ɔ̱p nɛɛnikä wä ŋa̱c, a bikɛ rɔ̱ yac kɛ ciötdä wä kɛ i̱, ‘Ce̱tnikɛ ciöt Kuɔth Nhial in tëk,’ a cäŋɛ ni mëë cikɛ nɛɛkä kɔŋ ŋi̱eec kɛ ɣöö bikɛ rɔ̱ yac kɛ kuoth Baal, bäkɛ mat rɛy nɛɛnikä. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö mi wëë wä tekɛ do̱r mi /ci bi liɛŋ, ɣän bä jɛ yuɔ̱t ni raar kɛɛliwdɛ, kä bä jɛ däk, ruac ni ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
  ],
