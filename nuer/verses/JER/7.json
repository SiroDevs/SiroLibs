        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Yir-mɛ-yaa rɛy luak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ ruac Kuɔth ëë ci ben kä Yir-mɛ-yaa wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.1",
            "verseOrgIds": [
              "JER.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cuŋni thok luaak Kuɔth Nhial, kä lat ruac ɛmɛ, larɛ ɛn ɣöö liɛŋɛ ruac Kuɔth Nhial lö yɛn ji̱ Juda diaal tin la bä pal ɛn luaak ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.2",
            "verseOrgIds": [
              "JER.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Kuoth Nhial in la Ruey Ɣɔaa ni Kuoth I-thɛ-rɛl larɛ ɣöö, rialɛ ciaŋdun ikä bä yɛ jak kä cieŋ ɛn guäth ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.3",
            "verseOrgIds": [
              "JER.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ rieet ti̱ti̱ ŋäth a bia wee i̱, ‘Nɛmɛ ɛ luak Kuɔth Nhial, ɛ luak Kuɔth Nhial, ɛ luak Kuɔth Nhial.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.4",
            "verseOrgIds": [
              "JER.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi /cia dupkun rialikä kɛ thuɔ̱k kä cia ciaŋ jiäknikun päl, kä la̱tdɛ ni thuɔ̱k kamnikun, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.5",
            "verseOrgIds": [
              "JER.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä /ci yɛn juɔ̱r kɛnɛ ram mi thil gua̱n kɛ ciek jɔkä ciɛŋ a jiäk, kä /ci yiɛn riɛm ran bi pär kɛ wuth piny ɛn guäth ɛmɛ, kä /cia bi guɔ̱ɔ̱r ni kuth kɔ̱kiɛn tin dëë tëkdun bath, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.6",
            "verseOrgIds": [
              "JER.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä ɣän bä yɛ jak kä cieŋ ɛn guäth ɛmɛ, mun ëë cä ka̱m guurikun ni wal amäni cäŋ kɛl.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.7",
            "verseOrgIds": [
              "JER.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä nɛ̈nɛ jɛ, ŋääth yɛn ni ruac kacä mi thil luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.8",
            "verseOrgIds": [
              "JER.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä yɛn bia ŋot kɛ näk nath, kɛnɛ dhöm, kɛ ya̱c baaŋ, kɛnɛ wäŋ kuth Baal wal tin kuɔ̱r kuɔ̱ɔ̱r, kä guur yɛn ni kuth ti kɔ̱kiɛn ti kuecɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.9",
            "verseOrgIds": [
              "JER.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bia ben cuɔ̱ŋ nhiamdä rɛy luaak in palkɛ ɣä thi̱n kä bia wee i̱, ‘Cakɔ kään!’ Ka̱n mi wä yɛn lät ni tin diaal tin lökɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.10",
            "verseOrgIds": [
              "JER.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn luak ɛ palkɛ ɣä thi̱n ɛ, cɛ thil luɔt ɛ ca ni di̱r jiäkni waaŋdun? Kä nɛ̈nɛ jɛ, ɣän puɔ̱nydä guɛcä jɛ, ruac ni ɣän Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.11",
            "verseOrgIds": [
              "JER.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ wiaa guäth ëë la palkɛ ɣä thi̱n kɛ nhiam kä Cilo, wiaa guiɛcɛ min cä lät kä jɛ kɛ kui̱ dueeri nɛɛnikä ni ji̱ I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.12",
            "verseOrgIds": [
              "JER.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ kɛ ɣöö cia ti̱ti̱ diaal la̱t, kä ruacä kɛ yɛ ni ciaŋ, kä /ci yɛn ruacdä liŋ, kä cɔalä yɛ, kä /ci yɛn ɛ loc, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.13",
            "verseOrgIds": [
              "JER.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ kui̱c ɛmɔ, ɣän bä luak in palkɛ ɣä thi̱n, kä ŋääth yɛn ɛ, kɛnɛ gua̱a̱th ëë cä ka̱m yɛ kɛ guurikun, ɣän bä jɛ lät kä mi ce̱tkɛ mëë cä lät kä Cilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.14",
            "verseOrgIds": [
              "JER.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä yɛ woc waaŋdä, ce̱tnikɛ mëë cä ji̱ maarädun diaal kɔŋ woc, kuay Ɛ-pa-rim diaal, ruac ni ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lo̱k Kuɔth kɛ pal kuthni jiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.15",
            "verseOrgIds": [
              "JER.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ji̱n Yir-mɛ-yaa, /cu pal kɛ kui̱ nɛɛni ti̱ti̱, kä /cu duɔ̱ɔ̱r thiec kɛ kui̱diɛn mi dëë luäk nikɛ, kɛ ɣöö ɣän /cä ji̱ bi liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.16",
            "verseOrgIds": [
              "JER.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n /ken min lät kɛn ɛ rɛy wi̱i̱ni Juda kɛnɛ rɛy duɔ̱pni Jɛ-ru-tha-lɛm nɛn? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.17",
            "verseOrgIds": [
              "JER.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn ɣöö määt dho̱li jiɛn, kä dɔp gua̱ni mac, kä läny män nuɔ̱pni ti ba lät ni kuäär ciëk nhial mi̱eth. Kä muɔckɛ kɔaŋ piny kɛ kui̱ kuthni ti kɔ̱kiɛn, kua ɣä lɛ jak kä gak. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.18",
            "verseOrgIds": [
              "JER.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuɛ la jɛn ɣän ram in ba jak kä gak? Kä ci kɛn nyon ni pua̱nykiɛn? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.19",
            "verseOrgIds": [
              "JER.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ, bä gakdä wuɔc ɛn guäth ɛmɛ, kä naath kɛnɛ ley kɛ jiɛn diaal kɛnɛ tin do̱ny muun. Kä bɛ pɛ̈t a thilɛ ram mi bi jɛ yieny. Ruac ni ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.20",
            "verseOrgIds": [
              "JER.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa Kuoth I-thɛ-rɛl nɛmɛ lar, wëë i̱, “Matdɛ mucdun in waŋkɛ kä luurikun, kä camɛ ri̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.21",
            "verseOrgIds": [
              "JER.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mëë nööŋä guuri raar ro̱o̱l I-jëp, /ka̱n ruac kɛ kɛ kä thilɛ mi cä la̱r kɛ kɛ kui̱ mucni tin waŋkɛ kɛnɛ luuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.22",
            "verseOrgIds": [
              "JER.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cä jiök nikɛ i̱, ‘Luɔ̱thɛ ruacdä, bi ɣän a Kuothdun, kä bi yɛn a nɛɛkä. Kä guɔ̱ɔ̱rɛ ni ruac in cä la̱t yɛ, dɔ̱ŋ bɛ rɔ lot kɛ yɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.23",
            "verseOrgIds": [
              "JER.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö /ken yɛn ɛ luɔ̱th kä /ka̱nɛ jɛ liŋ, cu buɔ̱m ni wuɔ̱thkun kä cuarɛ wä la̱t ni cär lɔacdun. Cu loc ni yɛn jɔk kä ɣöö dee yɛn wä nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.24",
            "verseOrgIds": [
              "JER.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nikɛ gua̱a̱th ëë bä kɛ guurikun raar ro̱o̱l I-jëp cu mäni walɛ, ni ciaŋ la yɛ a ja̱kä kä ja̱a̱ŋkä diaal ni go̱o̱k ni ciaŋ ni ciaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.25",
            "verseOrgIds": [
              "JER.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋotdɛ /cia ɣä liŋ, bum ni wuɔ̱thkun. Cia la̱t ni jiäk ɛlɔ̱ŋ kä gua̱ni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.26",
            "verseOrgIds": [
