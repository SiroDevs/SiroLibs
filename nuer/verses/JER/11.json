    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "To̱l matdä ruac kɛ Kuoth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ rieet Kuɔth Nhial tëë ci ben kä Yir-mɛ-yaa wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Liŋ rieet matdä ruac, kä wër lät nikɛ ji̱ Juda kɛnɛ ji̱ Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biɛ wä la̱r kɛ, ɛn ɣöö ɛ Kuoth Nhial ni Kuoth I-thɛ-rɛl i̱, ‘Kuëth akɛ ram in /ci rieet matdä ruac ɛmɛ bi luɔ̱th, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "rieet tëë cä la̱t guurikun mëë nööŋä kɛ raar ro̱o̱l I-jëp, rɛy maac tha̱t yieethä.’ Liɛŋɛ ruacdä, kä la̱tdɛ tin diaal tin cä la̱r yɛ. Kä bi yɛn cua̱ nɛɛkä, kä bä cua̱ Kuothdun. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ ɣän bä ruac ëë cä la̱r guuri, mëë cä yac rɔ ɛn ɣöö bä kɛ ka̱m mun caak kɛnɛ tuaar, mun ɛ cieŋɛ thi̱n ɛ ɛn walɛ.” Kä cua̱ jɛ loc i̱, “A jɛ te nɔnɔ, Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɣä jiök i̱, “Lat rieet ti̱ti̱ diaal rɛy wi̱i̱ni Juda kɛnɛ rɛy duɔ̱pni Jɛ-ru-tha-lɛm i̱, ‘Tiɛtdɛ rieet matdä ruac ɛmɛ kä la̱tdɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nikɛ gua̱a̱th ëë nööŋä guurikun raar ro̱o̱l I-jëp amäni walɛ, la ruacä kɛ kɛ ni ciaŋ kɛ ɣöö bi kɛ ruacdä luɔ̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö /ken kɛn ruacdä liŋ, cu ram ɔ la̱t ni min caarɛ kɛ lɔcdɛ. Kɛ kui̱c ɛmɔ cua̱ kɛ nöŋ kɛn rieet matdä ruac ɛmɛ diaal, mëë cä la̱t kɛ i̱ ba la̱t, duundɛ ɣöö /ken kɛn jɛ la̱t.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ɣä nyɔk kɛ jio̱k i̱, “Tëë kɛ ca̱p mi jiääk rɛy ji̱ Juda kɛnɛ ji̱ Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikɛ loc kä jiäk gua̱ni, tëë lökɛ ɣöö ba ruacdä liŋ, a ba wä guɔ̱ɔ̱r ni kuth kɔ̱kiɛn, ji̱ dhɔaar I-thɛ-rɛl kɛnɛ ji̱ dhɔaar Juda ca mat ruacdä mëë cä lat kɛ gua̱ni to̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ bi ɣän Kuoth Nhial kɛ nöŋ riɛk mi /ci kɛ bi kään thi̱n, a cäŋ bikɛ wiee nhiamdä, cä kɛ bi liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ bi ji̱ wi̱i̱ni Juda kɛnɛ ji̱ Jɛ-ru-tha-lɛm cu wä nhiam kuthni tëë ci kɛn kɛ wa̱ŋ wal tin kuɔ̱r kuɔ̱ɔ̱r. Duundɛ ɣöö /ca kɛ dee kän kɛ gua̱a̱th in tekɛ rikä. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n Juda ŋuan kuthku ce̱tnikɛ wi̱i̱ku, kä ŋuan yi̱kni Jɛ-ru-tha-lɛm tin la kuoth Baal a wa̱ŋkɛ wal thi̱n ce̱tnikɛ ŋuan duɔ̱pnikɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cu Kuoth Nhial ɣä jiök i̱, “/Cu pal kɛ kui̱ nɛɛni ti̱ti̱, kɛ ɣöö /cä kɛ bi liŋ mi wä kɛ wä pal kɛ kui̱ rikädiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ cuɔ̱ŋ in mith kä nɛy tin nhɔakä rɛy luaakdä, kä lät kɛn ni jiäk? Ɛ dee muc da̱kdiɛn ku gaŋ? Kä dee ku tɛɛth ni lo̱ckiɛn? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci Kuoth Nhial kɛ kɔŋ cɔl i̱, ‘Jiath Ɔ-lip mi tɔ̱c, mi tekɛ dɛy ti gɔw.’ Kä täämɛ kɛ wuɔ̱w jiɔam mi di̱i̱t bɛ jɛ döp mac mi bi karkɛ waŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuoth Nhial in la Ruey Ɣɔaa min piith ji̱ da̱k lat kɛ kui̱du, kɛ kui̱ jiäkni tin ca la̱t ɛ dhɔr I-thɛ-rɛl kɛnɛ dhɔr Juda, tin ca ɣä jak kä gak kɛ ɣöö ca kuth Baal wa̱ŋ wal.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ca̱p mi jiääk kɛ kui̱ Yir-mɛ-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ cu Kuoth Nhial ruac ɛmɛ lat kɛ kui̱ ji̱ Ä-na-thoth tëë go̱r kɛ näkdu wä kɛ i̱, “/Cu ruac go̱o̱kä lat kɛ ciöt Kuɔth Nhial, kiɛ bakɔ ji̱ näk.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial in la Ruey Ɣɔaa wee i̱, “Nɛnɛ, ɣän bä kɛ duäc, ba ŋuɛ̈tni wutni näk kɛ mut. Kä bi gaatkiɛn kɛnɛ nyieekiɛn li̱w kɛ buɔth, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "a thilɛ ram mi bi duɔth kɛ tëk kä kɛ. Kɛ ɣöö ɣän bä ji̱ Ä-na-thoth nöŋ riɛk kɛ ruɔ̱n däkädiɛn.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.23",
            "verseOrgIds": [
              "JER.11.23"
            ]
          }
        }
      ]
    }
  ],
