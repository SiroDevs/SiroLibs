            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Duundɛ ɣöö kɛ ni̱n tin jɔak ɣän bä Ee-lam nyɔk kɛ loc guäthdɛ,” ruac ni ɣän Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
    }
