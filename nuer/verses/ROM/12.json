        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ka̱mɛ tëkdun Kuoth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, dämaari, la̱ŋä yɛ kɛ kɔ̱a̱c lɔaac Kuɔth, ɛn ɣöö thöpɛ rɔ̱, Kuɔth ala muc ti tëk, ala ti rɛ̈lkɛ rɔ̱, kä nhɔk Kuoth kɛ, min la duɔ̱ɔ̱p palä yieenikun in thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cuarɛ ce̱tkɛ ji̱ ɣɔaa ɛmɛ, gɛ̈rɛ ciaaŋ cärädun, ɛn ɣöö dee yɛn min go̱o̱r Kuoth ɛ ŋa̱c agɔaa, mi gɔaa, min nhɔkɛ, kä thil diw ŋa̱c.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän ruacä kɛ ramɔ kä yɛn diaal kɛ puɔ̱th baaŋ in ci Kuoth ɛ ka̱m ɣä, kɛ ɣöö /ci raan rɔɔdɛ bi car i̱ di̱tni jɛn a leny ca̱r in dee ca̱r kɛ jɛ, kä bi raan ca̱r muɔ̱lä, ramɔ kɛ pek ŋäthä min ci Kuoth ɛ ka̱m ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tkɛ min te kɔn kɛ cuŋ ti ŋuan rɛy pua̱a̱ny kɛl, kä /ci cuŋ pua̱ny diaal lät ni kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.4",
            "verseOrgIds": [
              "ROM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn duɔ̱ɔ̱p ɛmɔ kɔn diaal, cäŋ ŋuan kɔn lapnɛ puɔ̱ny kɛl rɛy Kritho, kä kɛ̈l kɛ̈ɛ̈li ca kɔn mat ala cuŋ pua̱a̱ny kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta̱nɛ kɛ muc ti gööl ce̱tkɛ puɔ̱th baaŋ Kuɔth in cɛ ka̱m kɔn. Ram mi tekɛ muc go̱o̱kä, a jɛ lätdɛ ce̱tkɛ ciaaŋ ŋäthädɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mi tekɛ lua̱ŋ läätdä, a jɛ lät kɛ jɛ, kä mi ɛ lua̱ŋ ŋi̱i̱cä, a jɛ ŋi̱i̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mi luäŋ cuɔ̱m nath, a jɛ com naath, ram mi muuc, a jɛ muc a lɔr tetdɛ. Kä ram mi tee muc bo̱thä a jɛ ɣɔ̱nɛ bɛ naath bo̱th agɔaa, kä mi ram mi luäŋ la̱t kɔ̱cä lɔaac, a jɛ lät kɛ tɛ̈th lɔaac.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyuɔ̱th ciɛɛŋä Krith-ciinä mi gɔaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A nhök la thuɔ̱k, kä nyi̱r mi jiääk. Kä käp ni mi gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.9",
            "verseOrgIds": [
              "ROM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhɔakɛ rɔ̱ ala raan kɛnɛ däman, kä görɛ jɛ i̱ bia rɔ̱ nyuɔ̱th luth kamnikun. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "La̱tdɛ a bum a yɛ cɛ dual, la̱tdɛ Kuäär ni Kuoth ikä kɛ yiëëdun kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lo̱ckun tɛth kɛ ŋa̱th kɛ mi bi ben, ta̱yɛ kɛ dhieel rɛy rikni, kä la̱ŋɛ ni ciaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuekɛ kɛ nɛɛ Kuɔth tin thil duɔ̱ɔ̱r, lëpɛ dho̱rkun jur.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puɔthɛ nɛy tin ciaŋkɛ yɛ a jiäk, puɔth kɛ, kä /cuarɛ kɛ lam. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lo̱ckun tɛth kɛɛl kɛ nɛy tɔ̱ tɛth lo̱ckiɛn tɔ̱, kä ro̱tdɛ kɛɛl kɛ nɛy tɔ̱ ro̱t tɔ̱. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciaŋɛ rɔ kɛɛl rɛy nho̱kä, /cuarɛ rɔ kap nhial kɛ liak, kä ka̱nɛ ni ciaaŋ kɔ̱cä. Kä /cuarɛ jɛ car i̱ pɛl ni yɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cuarɛ mi jiääk col kɛ mi jiääk, kä carɛ wi̱cdun kɛ min gɔaa nhiam nɛɛni diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi derɛ rɔ lot, görɛ jɛ ɛn ɣöö bia cieŋ kɛ mal kɛ nɛy diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.18",
            "verseOrgIds": [
              "ROM.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhöökä, /cuarɛ rɔ̱ col, pa̱lɛ jɛ waŋ lɔaac Kuɔth, kɛ ɣöö ca gɔ̱r ɛn ɣöö ɛ Kuäär ni Kuoth i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:19",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 32:35.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Cut ɛ duŋdä, bä jɛ col.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca gɔ̱r bä i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:20",
              "type": "text"
            },
            {
              "text": "Pɛl 25:21-22.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mi näk gua̱n tɛ̈ru buɔth ɛ, mi̱i̱thni jɛ. Kä mi näk rɛw ɛ, määthni jɛ, kɛ ɣöö kɛ la̱t kä nɔmɔ bɛ jɛ jak kä po̱c.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "A yɛ /ca tiam ɛ jiäk, kä tiamɛ ni jiäk kɛ gɔɔy.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.21",
            "verseOrgIds": [
              "ROM.12.21"
            ]
          }
        }
      ]
    }
  ],
