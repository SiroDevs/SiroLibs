              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ, bi ji̱ I-thɛ-rɛl diaal cu kään, ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
