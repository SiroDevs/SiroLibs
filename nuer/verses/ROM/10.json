  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "ROM 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dämaari, min go̱o̱r lɔcdä jɛ ɛlɔ̱ŋ, min la palä Kuoth ɛ jɛn ɣöö dee nɛɛkä kään. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän dëë lar ni ɣöö cikɛ rɔ̱ ka̱m Kuoth, duundɛ ɣöö /kenkɛ rɔ̱ ka̱m Kuoth kɛ duɔ̱ɔ̱p ŋäcä mi thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö kui̱c kɛn duɔ̱ɔ̱p in moc Kuoth naath cuɔ̱ɔ̱ŋ kɛ jɛ, kä cukɛ go̱r ni duɔ̱ɔ̱pdiɛn, kä /ken kɛn go̱r ni duɔ̱ɔ̱p cuŋni Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö Kritho ɛ jɛn pek ŋutdä, kɛ ɣöö dee nɛy diaal tin tekɛ ŋa̱th tekɛ cuŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ka̱n ɛ duŋ nɛɛni diaal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muthɛ cɛ gɔ̱a̱r kɛ kui̱ cuŋni tin jëkɛ kɛ ŋuɔ̱t i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:5",
              "type": "text"
            },
            {
              "text": "Liib 18:5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ram mi wä ŋuɔ̱t ti̱ti̱ wä luɔ̱th bɛ tëk kɛ kɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö ɛ cuŋ tin jëkɛ kɛ ŋa̱th i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:6-8",
              "type": "text"
            },
            {
              "text": "Ŋuɔ̱t 30:12-14.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “/Cu rɔ jio̱k i̱, ‘Ɛŋa mi bi wä nhial?’ ” (kɛ ɣöö bɛ Kritho wä nööŋ piny) ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiɛ bi wee i̱, “Ɛŋa mi bi wä piny?” (kɛ ɣöö bɛ Kritho wä nööŋ raar li̱th). ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛmɛ ɛ min latdɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dee naath ɛ cɔl kɛ luäk i̱di mi /ci kɛn ɛ ŋäth? Kä dee kɛn ɛ ŋäth i̱di ɛn ram min /ken kɛn ɛ met liŋ? Kä dee kɛn ɛ liŋ i̱di, mi thilɛ ram mi ci jɛ la̱tkɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dee naath ruac lat i̱di, mi /ka̱n kɛ ja̱k? Ce̱tkɛ min ca gɔ̱r i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:15",
              "type": "text"
            },
            {
              "text": "Ica 52:7.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ku ben nɛɛni tin ŋööŋkɛ thuk ruaacni tin gɔw lɛ gɔw i̱di!” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ken kɛn diaal ruaacni tin gɔw luɔ̱th, kɛ ɣöö ci I-ca-yaa wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:16",
              "type": "text"
            },
            {
              "text": "Ica 53:1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kuäär ni Kuoth, ɛŋa mi ci ruacda ŋäth?” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋa̱th bëë kä mi ca liŋ, kä mi ca liŋ bëë kɛ lat cio̱tdä Kritho.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ thiec i̱, /ken kɛn ɛ liŋ? Ɛpuc, ca liŋ, kɛ ɣöö ca lat i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    }
  ],
