          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋut kɛ kui̱ kuën",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö täämɛ, dämaari, ɣän ruacä kɛ nɛy ti ŋa̱ckɛ ŋuɔ̱t. /Ci yɛn ɛ ŋäc ɛn ɣöö ŋut tëë kɛ lua̱ŋ kɛ raan kärɔa min ŋotdɛ teekä? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.1",
            "verseOrgIds": [
              "ROM.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, ciek mi ca kuɛn bɛ te kɛɛl kɛnɛ cɔwdɛ kɛ ciaŋ ŋutdä min ŋot cɔwdɛ teekä. Kä mi ci cɔwdɛ li̱w, ca jɛ lony kä ŋut in yien jɛ kɛ cɔaadɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.2",
            "verseOrgIds": [
              "ROM.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn ba jɛ cɔl i̱ “Dho̱o̱m” mi cɛ cieŋ kɛɛl kɛ wut mi dɔ̱diɛn a ŋot cɔwdɛ teekä. Kä mi ci cɔwdɛ li̱w, jɛn cɛ lɔar kä ŋut ɛmɔ, kä mi ca kuɛn ɛ wut dɔ̱diɛn, /cɛ la dho̱o̱m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.3",
            "verseOrgIds": [
              "ROM.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.3",
            "verseOrgIds": [
              "ROM.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ tee nɔ bä kɛ yɛ mäthnikä. Kɛ ciaaŋ ŋutdä cia li̱w kɛ ɣöö kɛ yɛn puɔ̱ny Kritho. Kä ɛn täämɛ kɛ yɛn nɛɛkɛ ɛn ram in ca jiɛc li̱th kɛ ɣöö dee kɔn a la̱a̱t kɛ kui̱ Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.4",
            "verseOrgIds": [
              "ROM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë tëknɛ kɛ ciaaŋ ran, jiäk tëë go̱o̱r puɔ̱nykɛ tëë ca jiac nhial ɛ ŋut, tëë lät pua̱nyni kɔn, kɛ ti ro̱ŋ kɛ no̱ŋdan lia̱a̱. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.5",
            "verseOrgIds": [
              "ROM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ ca kɔn lony kä ŋuɔ̱t, canɛ li̱w kɛ jɛn mëë ci kɔn yiɛn, kɛ ɣöö /ci kɔn lät rɛy ŋutdä mëë wal ëë ca gɔ̱r, lät kɔn rɛy teekä Yieekä mi pay tuɔɔk.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋut kɛnɛ duer",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu dɔ̱ŋ mi banɛ lɛ lar? Ɛ ɣöö ŋut ɛ duer? /Cɛ dee a jɛn! Kä mi /ken ŋut te thi̱n, /cä duer dee ŋa̱c. Mi thil ni ŋut cä di̱t lɔaac go̱rä kä duɔ̱ɔ̱r dee ŋa̱c, mi /ken ŋut ɛ lar i̱,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:7",
              "type": "text"
            },
            {
              "text": "Ɣöth 20:17.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “A lɔcdu /ci di̱t kɛ duŋ radɔ̱diɛn.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci duer gua̱a̱th jek kɛ kui̱ ŋutdä, cɛ di̱t lɔaac ŋɔaani diaal la̱th rɛydä. Mi thilɛ ŋut, thilɛ duer buɔ̱m. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëëdan cä kɔŋ, tëk a thil ŋuɔ̱t, kä mëë ci ŋuɔ̱t ben, cu duer rɔ nyɔk kɛ tëk ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cua̱ cu li̱w, kɛ jɛn ŋuɔ̱t ɛmɔ pa̱ny, min dee ŋun ni tëk, cɛ nööŋ ni lia̱a̱ kä ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mëë ci duer gua̱a̱th jek kɛ ŋuɔ̱t, cɛ ɣä mɛt, kä cuɛ ɣä cu näk. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ, ŋut ɛ mi rɛl rɔ, kä luek ɛ mi rɛl rɔ bä, ɛ thuɔ̱k, kä gɔaa ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn nɔmɔ derɛ lot ni ɣöö ci mi gɔaa ɣä nöŋ lia̱a̱? /Cɛ dee a jɛn! Ɛ jɛn duer, lät lia̱a̱ rɛydä mɔ, rɛy kä mi gɔaa, kɛ ɣöö ba duer nyoth i̱ ɛ duer, kä rɛy ŋutdä ca duer jek i̱ ci jiääkdɛ di̱t.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tin kui̱i̱r rɛy ran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋäc kɔn ɛ ɛn ɣöö ŋut ɛ duŋ Yieekä, kä duundɛ ɣöö ɛ ɣän ri̱ŋ mi ca kɔak ala kuany dui̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.14",
            "verseOrgIds": [
              "ROM.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cä luɔt lätnikä ŋäc. Kɛ ɣöö /cä lät ni min göörä, kä la̱tdä niɛ min nyiɛrä pa̱ny. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.15",
            "verseOrgIds": [
              "ROM.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mi la̱tdä ni min /cä go̱r, ɣän nhɔakä ɛn ɣöö ŋut ɛ mi gɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.16",
            "verseOrgIds": [
              "ROM.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k, /ci ɣän lät jɛ mɔ, ɛ duer in cieŋ rɛydä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.17",
            "verseOrgIds": [
              "ROM.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋa̱cä jɛ i̱ thilɛ mi gɔaa mi cieŋ rɛydä, ɛ ni ciaaŋ ri̱eŋdä. Ɣän ŋa̱cä mi gɔaa, kä cä jɛ luäŋ kɛ ɣöö dëë jɛ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.18",
            "verseOrgIds": [
              "ROM.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /cä lät ni min gɔaa in göörä, kä la̱tdä ni jiääk min /ca go̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mi la̱tdä ni min /cä go̱r, /ci ɣän lät jɛ mɔ, ɛ jɛn duer in te rɛydä.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ, cä jek ɛn ɣöö ɛ ŋut ɛn min göörä ɣöö bä mi gɔaa la̱t, thia̱k jiäk kɛ ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
            "verseOrgIds": [
              "ROM.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö tɛth lɔcdä rɛci kɛ ŋut Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.22",
            "verseOrgIds": [
              "ROM.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nä ŋut dɔ̱diɛn mi lät rɛydä puɔ̱nydä mi tɛr ko̱r kɛ ŋut cärä wecdä, kä jakɛ ɣä kä pɛ̈c ŋutdä dui̱rä min cieŋ rɛy cuŋni pua̱a̱nydä. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.23",
            "verseOrgIds": [
              "ROM.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kua jiath lɔaac mi tee di tekɛ ɣä mɛ! Ɛŋa mi bi ɣä luäk puɔ̱ɔ̱ny ɛ li̱w ɛ? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.24",
            "verseOrgIds": [
              "ROM.7.24"
            ]
          }
        },
        {
