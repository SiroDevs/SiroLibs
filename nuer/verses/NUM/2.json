          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn ŋuaan wi̱cdɛ kur dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        },
        {
