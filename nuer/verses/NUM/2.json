        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ jɔakdɛ bi pua̱t ni thok duëël Rɛ-u-ben kɛ dho̱rkiɛn tin bo̱o̱thdiɛn mɔ Ɛli-dhur gat Cɛ-de-ur. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn ŋuaan wi̱cdɛ bäkɛl wi̱cdɛ kur dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.11",
            "verseOrgIds": [
              "NUM.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi thok duëël Cim-on pua̱t thieekädɛ tin bo̱o̱thdiɛn mɔ Cɛ-lu-mi-el gat Dhu-ri-ca-day. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.12",
            "verseOrgIds": [
              "NUM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn dhieec wi̱cdɛ bäŋuan wi̱cdɛ kur diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.13",
            "verseOrgIds": [
              "NUM.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba guɔ̱ɔ̱r ɛ thok duëël Gad tin bo̱o̱thdiɛn mɔ Ɛl-ya-thap gat Rɛ-u-el. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.14",
            "verseOrgIds": [
              "NUM.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn ŋuaan wi̱cdɛ dhieec wi̱cdɛ kur bäkɛl wi̱cdɛ jiɛɛn da̱ŋ dhieec. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu wec Rɛ-u-ben ji̱ kɛ diaal a nɛy ti bathdɔɔri ti kuɔ̱r kɛl wi̱cdɛ jiɛɛn dhieec wi̱cdɛ kɛl wi̱cdɛ kur ŋuaan wi̱cdɛ jiɛɛn da̱ŋ dhieec. Bikɛn a rɛw ɣo̱th.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.16",
            "verseOrgIds": [
              "NUM.2.16"
            ]
          }
        }
      ]
    },
