          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn diɔ̱k wi̱cdɛ dhieec wi̱cdɛ kur da̱ŋ ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu wec Ɛ-pa-rim ji̱kɛ diaal pekdiɛn kɛ dho̱rkiɛn a nɛy ti bathdɔɔri ti kuɔ̱r kɛl wi̱cdɛ bädäk wi̱cdɛ kuɔr kɛl. Bi ɣöthdiɛn a diɔ̱ɔ̱k ɣo̱thni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.24",
            "verseOrgIds": [
              "NUM.2.24"
            ]
          }
        }
      ]
