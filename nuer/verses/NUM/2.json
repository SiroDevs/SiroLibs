              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔriɛn ba thok duëël Nap-ta-li, tin bo̱o̱thdiɛn mɔ Nap-ta-li gat E-nan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn dhieec wi̱cdɛ diɔ̱k wi̱cdɛ kur ŋuaan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.30",
            "verseOrgIds": [
              "NUM.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu wec Daan ji̱ kɛ diaal kɛ dho̱rkiɛn a nɛy ti bathdɔɔri ti kuɔ̱r kɛl wi̱cdɛ jiɛɛn da̱ŋ dhieec wi̱cdɛ bärɔw wi̱cdɛ kur bäkɛl, bi ka nɛy tin jɔak ɣo̱th, pek ɔ nikɛ pek ɔ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.31",
            "verseOrgIds": [
              "NUM.2.31"
            ]
          }
        }
      ]
