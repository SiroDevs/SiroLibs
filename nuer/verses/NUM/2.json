              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn bäkɛl wi̱cdɛ rɛw wi̱cdɛ kur bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
