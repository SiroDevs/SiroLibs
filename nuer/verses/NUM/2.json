          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba guɔ̱ɔ̱r ɛ thok duëël Ma-na-thɛ tin bo̱o̱thdiɛn mɔ Gam-li-el gat Pɛ-daa-dhur, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
