          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "cu pekdiɛn a nɛy ti bathdɔɔri ti jiɛɛn diɔ̱k wi̱cdɛ rɛw wi̱cdɛ kur da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
        {
          "name": "verse",
