          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi thok duëël Ben-ya-min ɣöth kɛ kɔriɛn tin bo̱o̱thdiɛn mɔ Ä-bi-dan gat Gid-oni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
