          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ba kɛmɛkä ro̱mä ɣo̱th ɛ ji̱ Lii-bay kɛ där ɣöthni. Ce̱tnikɛ pua̱tdiɛn ɛ jɛn bi ɣöth kɛ kɛ mɔ, ramɔ nikɛ pekdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
