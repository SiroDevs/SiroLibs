          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä mi wä wut ciekdɛ wä diw, bɛ jɛ nööŋ nhiam Kuɔth Nhial, kä bi bo̱o̱th palä kɛn ŋuɔ̱t ti diaal ti̱ti̱ lat wi̱i̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.30",
            "verseOrgIds": [
              "NUM.5.30"
