          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi thäk dɛ̈ɛ̈l böwä thöp ala muc dui̱rä kɛ gëk mucä ciɛŋä min wen min la waŋkɛ kɛnɛ muc bɛɛlkɛ kɛ kɔaŋdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.16",
            "verseOrgIds": [
              "NUM.29.16"
            ]
