      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛn ti̱ti̱ bi ka ŋuɔ̱t kä ri̱ckun gua̱th cieŋnikun diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram ɔ bi raan näk ɔ ba näk kɛ nën nath. Kä /ca raan bi näk kɛ nën raam kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kök nhɔk kɛ kui̱ teekä raam mi ci raan näk. Ba jɛ dhil näk. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kök nhɔk kä ram mi ci rɔ bar wi̱c luäkä, kɛ ɣöö bɛ ben cieŋ wi̱c ɛ /ken bo̱o̱th palä min di̱i̱t ni li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ mun in cieŋ yɛn thi̱n yär. Kɛ ɣöö riɛm yärɛ mun, kä thilɛ mi dëë mun luɛl kä riɛm in ca wuɔ̱th thi̱n, ɛ ni mi ɛ riɛm raam min wuth riɛm thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cu mun in ciɛŋi yär, gua̱th in cieŋä thi̱n. Kɛ ɣöö ɣän Kuoth Nhial cieŋä rɛy ji̱ I-thɛ-rɛl.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
