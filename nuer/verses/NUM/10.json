          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ ca thanduk ɣo̱th ɔ, bi Muthɛ wee i̱, “Aɣ, Kuoth Nhial jiɛc rɔ, kä a ji̱ tɛ̈ru däk piny, kä a ji̱ gaakdu bar kɛ rɔ̱ nhiamdu.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
