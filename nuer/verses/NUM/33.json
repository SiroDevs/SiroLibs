          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.37",
            "verseOrgIds": [
              "NUM.33.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 33:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bo̱o̱th palä ni Ä-ron wä wi̱i̱ Pa̱a̱m Ɣor kɛ ruac Kuɔth Nhial, kä cuɛ wä li̱w thi̱n, kɛ cäŋ in jio̱l kä pay dhieec kɛ jiɛɛn ŋuaan runi kɛ kɔr kä mëë ci ji̱ I-thɛ-rɛl ben raar muun I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 33:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë li̱w Ä-ron pääm Ɣor tëë kɛ run ti kuɔ̱r wi̱cdɛ jiɛɛn da̱ŋ rɛw wi̱cdɛ diɔ̱k.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.39",
            "verseOrgIds": [
              "NUM.33.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
