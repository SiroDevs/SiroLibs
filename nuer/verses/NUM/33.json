          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cikɛ jiɛɛn Pääm Ɣor cikɛ ben pua̱t kä Dhal-mo-naa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41",
            "verseOrgIds": [
              "NUM.33.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 33:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ ji̱ ɛn thi̱n cukɛ ben pua̱t kä Pu-non. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.42",
            "verseOrgIds": [
              "NUM.33.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 33:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn thi̱n cukɛ ben pua̱t kä O-bot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.43",
            "verseOrgIds": [
              "NUM.33.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 33:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn thi̱n cukɛ ben pua̱t kä Iye-ä-ba-rim rɛy cieŋ O-bot. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.44",
            "verseOrgIds": [
              "NUM.33.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 33:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn thi̱n cukɛ ben pua̱t kä Di-bon-gad. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.45",
            "verseOrgIds": [
              "NUM.33.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 33:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ jiɛɛn thi̱n cukɛ ben pua̱t kä Al-mon-dib-la-ta-yim. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.46",
            "verseOrgIds": [
              "NUM.33.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 33:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn thi̱n cukɛ ben pua̱t pääm Ä-ba-rim a /ka̱n Nɛbo ni cop. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.47",
            "verseOrgIds": [
              "NUM.33.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 33:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn thi̱n cukɛ ben pua̱t rɛy tɔ̱ɔ̱rä Mo-ab kui̱ yiëër Jɔr-dɛn kä Jɛ-ri-ko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.48",
            "verseOrgIds": [
              "NUM.33.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ pua̱t gekä Jɔr-dɛn a känɛ ni kä Beth-yɛ-ci-moth a räth ni kä A-bel-ci-tim rɛy tɔ̱ɔ̱rä Mo-ab.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruaacni a /ka̱n yier Jɔr-dɛn ni jiɛth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 33:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.49",
            "verseOrgIds": [
              "NUM.33.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 33:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ruac kɛ Muthɛ rɛy tɔ̱ɔ̱rä Mo-ab kui̱ yiëër Jɔr-dɛn kä Jɛ-ri-ko i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jio̱kni ji̱ I-thɛ-rɛl, mi wä yɛn wä kui̱ yiëër Jɔr-dɛn wädun muun Kɛ-naan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juɔcɛ nɛy diaal tin cieŋ thi̱n raar nhiamdun, kä da̱kɛ päämkiɛn diaal tin ca la̱t, kɛnɛ kuth baaŋ tin ca täth, kä da̱kɛ gua̱th pali diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ciaŋɛ mun ala duŋdun, kɛ ɣöö cä ka̱m yɛ bia ciɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bia ka̱n ɛn mun kɛ yor gaakni ce̱tkɛ pek dho̱rikun. Kä bia thok duëël in di̱i̱t ka̱m pek mi di̱i̱t, kä bia thok duëël mi tɔt ka̱m pek mi tɔt. Kä gua̱th ɔ bi gaak ran pɛn thi̱n ɔ ba duŋdɛ. Bia ka̱n ɛn mun nikɛ thuk duëli guuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä yɛn tey a /cia nɛy tin cieŋ muun bi joc nhiamdun, kɛn tɔ̱tɔ̱ bikɛ ce̱tnikɛ pir waaŋdun, kä bikɛ ce̱tnikɛ kui̱c nenädun, kä bä yɛ moc riɛk muun in bia ciɛŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä yɛ lät kä min caarä dëë lät kä kɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
    }
