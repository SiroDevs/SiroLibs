          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial ruac kɛ Muthɛ kɛnɛ Ä-ron i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.17",
            "verseOrgIds": [
              "NUM.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cuarɛ thok duëël ji̱ Kɛ-ɣath jak kä däk rɛy ji̱ Lii-bay. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.18",
            "verseOrgIds": [
              "NUM.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö akɛ la̱t kɛ ti̱ti̱, kɛ ɣöö cikɛ bi li̱w mi wä kɛ ben thiekä kä tin rɛl gɔɔydiɛn rɔ̱. Ä-ron kɛnɛ gaatkɛ bikɛ wä rɛc kä ba ramɔ nyuɔ̱th la̱tdɛ kɛnɛ min bɛ kap, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.19",
            "verseOrgIds": [
              "NUM.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɛ ni ɣöö cikɛ bi wä rɛc a ba tin rɛl gɔɔydiɛn rɔ̱ wä guic a cäŋɛ gua̱th mi tɔt, kɛ ɣöö /cikɛ bi li̱w.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.20",
            "verseOrgIds": [
              "NUM.4.20"
            ]
          }
        }
      ]
    },
    {
