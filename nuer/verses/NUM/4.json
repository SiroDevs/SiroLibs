          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial ruac kɛ Muthɛ i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuɛn gaat Ger-con bä, kɛ thuk duëli gua̱ni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "a känɛ ni kä run ti jiɛɛn diɔ̱k a wä kä jiɛɛn dhieec, bikɛ kuɛn kɛn tin diaal tin la̱t, la̱tkɛ lät rɛy kɛmɛkä ro̱mä. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ la̱t dhɔaar ji̱ Ger-con, la̱t kɛnɛ ka̱p kɛmɛkä ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "bikɛ geel kɛnɛ kɛmɛkä ni kɛɛl kɛ kuumdɛ, kɛ kuum köl dɛ̈ɛ̈l min te nhialɛ, kɛ bi̱i̱ thuɔk kɛmɛkä ro̱mä, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ geel rɛ̈ɛ̈k kɛnɛ bi̱i̱ thuɔk rɛ̈ɛ̈k min go̱o̱l kɛmɛkä kɛnɛ yi̱k, kɛ kuak la̱tdɛ diaal la̱t, kä bikɛ tin diaal tin görkɛ la̱t ɛ kɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä lät diaal tin ba la̱t ɛ gaat Ger-con ba la̱t ɛ Ä-ron kɛnɛ gaatkɛ kɛn tin ba kap, kɛnɛ tin diaal tin bi kɛn kɛ la̱t, kä bikɛ ka̱m tin diaal ti ba kap. ",
