          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
          }
        },
