            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kuay Cim-on, cua wutni diaal tin ci runkiɛn cop kä jiɛɛn da̱ŋ rɛw a wä nhial kä lua̱ŋkɛ ko̱r gɔ̱r, thuk duëli gua̱ni nikɛ dho̱rkiɛn, ram ɔ nikɛ ciötdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu pek kuayni Cim-on a nɛy ti bathdɔɔri ti jiɛɛn dhieec wi̱cdɛ bäŋuan wi̱cdɛ kur diɔ̱k.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
            "verseOrgIds": [
              "NUM.1.23"
            ]
          }
        }
      ]
