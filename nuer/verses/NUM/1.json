              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kuay Gad, cua wutni diaal tin ci runkiɛn cop kä jiɛɛn da̱ŋ rɛw a wä nhial kä lua̱ŋkɛ ko̱r gɔ̱r, thukni duëli gua̱ni nikɛ dho̱rkiɛn, ramɔ nikɛ ciötdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.24",
            "verseOrgIds": [
              "NUM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
