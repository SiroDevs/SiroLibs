            }
          ]
        },
        {
          "text": "Ɛ ni ɣöö /ka̱n kuay ji̱ Lii-bay kuɛn kɛ kɛ kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
