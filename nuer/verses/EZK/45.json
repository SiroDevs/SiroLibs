        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pek wec mi la duŋ Kuɔth Nhial",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä yɛn mun wä da̱a̱k ala duŋdun, bia pek mi bila duŋ Kuɔth Nhial lɛ̈y go̱lä, ala gua̱a̱th mi rɛl gɔɔydɛ rɔ. Kä bɛ tekɛ theemni ti jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny, kɛnɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw ɣäp ɣääpdɛ. Kä bɛ la mi rɛl gɔɔydɛ rɔ ni kɛɛliwdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.1",
            "verseOrgIds": [
              "EZK.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä jɛn mun ɛmɛ, bi tha̱a̱ŋdɛ mi pur pur mi tekɛ jua̱th tetni ti kur dhieec ni kä jua̱th tet ni ti kur dhieec a gua̱a̱th luaak Kuɔth, mi tekɛ dɛ̈ɛ̈ mi tekɛ jua̱th tetni ti jiɛn dhieec mi go̱o̱l jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.2",
            "verseOrgIds": [
              "EZK.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä rɛy muɔ̱ɔ̱n in rɛl gɔɔydɛ rɔ bi gua̱a̱th mi tekɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny kɛnɛ jua̱th tetni ti bathdɔɔri da̱ŋ wäl ɣäp ɣääpdɛ thɛm. Kä bɛ a gua̱a̱th luaak Kuɔth mi rɛl gɔɔydɛ rɔ kä ti diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.3",
            "verseOrgIds": [
              "EZK.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ a kui̱ muɔ̱ɔ̱n mi rɛl gɔɔydɛ rɔ. Kä bɛ a duŋ bööthni palä, tin bi wä lät rɛy luaak Kuɔth, tin bi wä lät nhiam Kuɔth Nhial, kä bɛ te kä rɛɛw. Bɛ a gua̱a̱th in ba ciëëŋkiɛn la̱t thi̱n kä ba luaak Kuɔth in rɛl rɔ la̱t thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.4",
            "verseOrgIds": [
              "EZK.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba gua̱a̱th mi dɔ̱ŋ mi tekɛ jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec bärɛ piny, kɛnɛ jua̱th tetni ti bathdɔɔri da̱ŋ wäl ɣäp ɣääpdɛ, bɛ a duŋ ji̱ Lii-bay tin lät rɛy luaak Kuɔth, kɛ ɣöö bɛ la duŋdiɛn mi bikɛ wec ciɛŋädiɛn la̱t thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.5",
            "verseOrgIds": [
              "EZK.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä gekä gua̱th in rɛl rɔ, bi gua̱a̱th ka̱n thi̱n, mi bi ɣäp ɣääpdɛ a jua̱th tetni ti bathdɔɔri da̱ŋ dhieec, kä bärɛ piny bɛ a jua̱th tetni ti bathdɔɔri ti jiɛn da̱ŋ rɛw wi̱cdɛ dhieec. Bɛ la wec ji̱ I-thɛ-rɛl diaal.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mun kɛnɛ luëëk kɛ kui̱ rueecä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.6",
            "verseOrgIds": [
              "EZK.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi rueec mun in te kui̱ni muɔ̱ni da̱ŋ rɛw tin rɛl gɔɔydiɛn rɔ kui̱ muɔ̱ɔ̱n wec ka̱n. Bɛ jɛ ka̱n ni kui̱ känyä ca̱ŋ kui̱ käny ca̱ŋä muɔ̱ɔ̱n, kä bɛ lɛ ka̱n ni kui̱ konyä ca̱ŋ kui̱ konyä ca̱ŋ muɔ̱ɔ̱n, bi bärɛ key konyä ca̱ŋ kɛnɛ key kuec känyä ca̱ŋ, pa̱a̱r kɛ muɔ̱n thukni duëli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.7",
            "verseOrgIds": [
              "EZK.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn mun ɛmɔ bɛ la duŋdɛ kä I-thɛ-rɛl. Kɛ ɣöö dɔ̱ŋ /ci ruëëc nɛɛkä bilɛ ciɛŋ a jiäk, bikɛ thok duëël I-thɛ-rɛl nhök ɣöö ka̱nkɛ mun ce̱tkɛ thuk duëlikiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.8",
            "verseOrgIds": [
              "EZK.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuäär ni Kuoth Nhial mɛmɛ lar wëë i̱, “Cɛ ro̱ŋ lö ruëëc I-thɛ-rɛl! Pa̱lɛ ŋɛ̈ɛ̈ny kɛnɛ ciaaŋ jiääk, la̱tdɛ ni cuɔ̱ɔ̱ŋ kɛnɛ thuɔ̱k. Kua ma̱c nɛɛnikä ka̱p cuɔ̱ŋ, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Theemni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.9",
            "verseOrgIds": [
              "EZK.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“A nɛy diaal thöpkɛ ni theem mi päär, a jɛ thil ram mi yɔaŋkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A theemni kä ti law laaw päär kɛ theemni kä ti ko̱o̱t. A theemni kä ti law laaw tekɛ kɛl wäli, kä bi theemni kä ti ko̱o̱t tekɛ kɛl wäli kä dey thëm. Theemdiɛn bɛ la ni kɛl wäli dëth thëm. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ kɛn tin bi a theemnikun. Kä bi theem riaal kɛl a gi̱ramni da̱ŋ wäl wi̱cdɛ kɛl, kɛ kɛl ŋuaani wi̱i̱diɛn. Kä bi yio̱w ti jiɛn bäkɛl a gi̱ramni ti kur da̱ŋ bäkɛl wi̱cdɛ jiɛn bäkɛl wi̱cdɛ ŋuaan.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muc",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mɛmɛ bɛ a jɛn muc in bia thöp. Beel in cɔalkɛ tɔ̱c bia kɛl bäkɛli a thöpɛ, kä bia kɛl bä kɛli a thöpɛ kä dɛɛr, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13",
            "verseOrgIds": [
              "EZK.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ pek liɛth mi /ca bi wäny, kä bɛ a kɛl wäli kä dey thëm",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:14",
              "type": "text"
            },
            {
              "text": "thëm",
              "type": "text"
            },
            {
              "text": "theemni kä ti law laaw päärkɛ kɛ theemni kä ti ko̱o̱t, ɣomar kɛnɛ kor.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", (ɣök ce̱tdɛ kɛ theemni da̱ŋ wäl). ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.14",
            "verseOrgIds": [
              "EZK.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ rɔaam kɛl rɛy bua̱a̱ni deet ti kur da̱ŋ rɛw rɛy tɔ̱a̱ri I-thɛ-rɛl diaal. Kä mɛmɛ ɛ jɛn muc bɛɛl kɛ muc tin waŋkɛ, kɛ muc kɛ kui̱ gɔɔyä ti ba luɛl nikɛ, ruac ni ɣän Kuäär ni Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.15",
            "verseOrgIds": [
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi nɛy diaal rɔ̱ ma̱t rueec rɛy I-thɛ-rɛl kɛ tho̱p mucni ti̱ti̱. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö mɛmɛ bɛ la jɛn la̱t rueecä min bɛ la̱t kɛ kui̱ mucni tin waŋkɛ, kɛnɛ muc bɛɛl, kɛ muc kɔaaŋni kɛ gua̱th ti̱mä, kɛnɛ tëth päthni, kɛ ca̱ŋ lɔ̱ŋni. Kä kɛ gua̱th ti̱mni diaal tëë ca mɛk kɛ kui̱ thuɔk duëël I-thɛ-rɛl, bɛ muc dui̱rä, kɛnɛ muc bɛɛl, kɛ muc tin waŋkɛ, kɛnɛ muc kɛ kui̱ gɔɔyä, ti ba luɛl ni dueer ji̱ thuɔk duëël I-thɛ-rɛl thöp.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ti̱emni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuäär ni Kuoth Nhial mɛmɛ lar wëë i̱, “Kɛ pay in jio̱l kɛ cäŋ in jio̱l kä pay, ka̱nɛ ruath tha̱a̱k mi thil mɛ̈ɛ̈ny, kä wiaa lɛ̈yɛ luaak Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.18",
            "verseOrgIds": [
              "EZK.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bo̱o̱th palä tha̱a̱ŋ riɛm mucä dui̱rä ka̱n kä bɛ jɛ la̱th wääthni luaak Kuɔth, kɛ thɛɛri yi̱kä da̱ŋ ŋuaan, kɛnɛ wääthni thuɔk kal in te rɛci. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.19",
            "verseOrgIds": [
              "EZK.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi jɛ la̱t ni nɔ bä kɛ bärɔw ni̱ni path, kɛ kui̱ raam mi ci duer ɛ kui̱cɛ kiɛ kɛ guäc. Inɔ, bi luaak Kuɔth cu luɛl.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.20",
            "verseOrgIds": [
              "EZK.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.20",
            "verseOrgIds": [
              "EZK.45.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä kɛ pay in jio̱l kɛ cäŋ kä wäl ŋuaan kä jɛn pay, bia ti̱em ca̱ŋ bälä la̱t, kä kɛ ni̱n da̱ŋ bärɔw bia cam ni nup mi thil thuɔp. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ jɛn cäŋ ɛmɔ, bi rueec ruath tha̱a̱k ka̱n kɛ kui̱dɛ kɛnɛ kui̱ nɛɛni diaal tin cieŋ muun, kä bɛ jɛ thöp ala muc dui̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɛn ni̱n da̱ŋ bärɔw tin la̱t kɛ ti̱em, bi rueec rueeth thääkni da̱ŋ bärɔw thöp Kuoth Nhial ala muc ti waŋkɛ, amäni ɣöö bɛ rueeth rɔɔmni da̱ŋ bärɔw ti thil mɛ̈ɛ̈ny thöp, cäŋ ɔ kɛ cäŋ ɔ kɛ kɛn ni̱n da̱ŋ bärɔw diaal. Kä bɛ thääk deet böwni a tho̱pɛ ni ciaŋ kɛ ni̱n da̱ŋ bärɔw tɔ̱tɔ̱ ala muc kɛ kui̱ dui̱rä. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ muc bɛɛl ti thia̱ŋkɛ dieny a tho̱pɛ kɛ thäk kɛl, kɛ dieny bɛɛl kɛ kui̱ tha̱k dɛ̈ɛ̈l rɔɔmä kɛl, kɛ bul liɛth kɛ kui̱ diëny kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ pay in bärɔwdiɛn, kɛ cäŋ kä wäl dhieec kä pay, kɛ ni̱n ti̱mä da̱ŋ bärɔw, bi rueec muc ti ce̱tnikɛ muc tëë wal a thöpɛ, muc dui̱rä, kɛnɛ muc tin waŋkɛ kɛ muc bɛɛl amäni muc liɛth.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.25",
            "verseOrgIds": [
              "EZK.45.25"
            ]
          }
        }
      ]
    }
