    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Juɔ̱c Gog",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ruac Kuɔth Nhial ben kä ɣä ɛn ɣöö lat ruac go̱o̱kä mi jiääk kɛ kui̱ Gog wëë i̱, “Ɣän gakä kɛ ji̱ lö Gog in la bo̱o̱th ruëëcni Mɛ-cɛk kɛnɛ Tu-bal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.1",
            "verseOrgIds": [
              "EZK.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä ji̱ ri̱et kä bä ji̱ yɔ̱a̱c nhiam, kä bä ji̱ nööŋ kui̱c caam in nɔ̱n nɔ̱n, bä ji̱ buath ko̱o̱r wuɔ̱thni päämni I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.2",
            "verseOrgIds": [
              "EZK.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔrɛ, bä kui̱n kui̱ndu tɛ̈ŋ piny tetdä caamdu, kä bä bääriku tɛ̈ŋ piny tetdä cuëëcdu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.3",
            "verseOrgIds": [
              "EZK.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ji̱n Gog yɛnɛ rɛmdu kɛɛliw kɛ döör diaal tin te kɛɛl kɛ ji̱ ba yɛ näk wuɔ̱thni päämni I-thɛ-rɛl. Ɣän bä yɛ ka̱m diit nhial, kɛnɛ ley dɔaar tin ba yɛ cam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.4",
            "verseOrgIds": [
              "EZK.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia li̱w ni rɛy ka̱a̱kni däär paan, cä jɛ lar, ruac ni ɣän Kuäär ni Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.5",
            "verseOrgIds": [
              "EZK.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä mac jäkä Ma-gog, kɛnɛ nɛy tin cieŋ malä jɔk yiëër, kä bi kɛn ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän bä jɛ cu ŋa̱c ɛn ɣöö ci nɛɛkä ni ji̱ I-thɛ-rɛl ciötdä min rɛl gɔɔydɛ rɔ ŋa̱c. Kä /ca ciötdä bi nyɔk kɛ päl ɣöö ya̱rkɛ jɛ. Kä bi döör ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial min Rɛl Gɔɔydɛ rɔ kä I-thɛ-rɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.7",
            "verseOrgIds": [
              "EZK.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn a bëëni! Bɛ dhil ben, ɛn cäŋ in cä lat pa̱ny, ruac ni ɣän Kuäär ni Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi nɛy tin cieŋ wi̱i̱ni I-thɛ-rɛl wä raar ba yio̱w köör wä waŋ, köötni, kɛnɛ kuen kueeni, kɛ bääri, kɛnɛ mutni kɛ wi̱ethni. Kä bikɛ kɛ pɛt kɛ run da̱ŋ bärɔw ala tɔŋ maac. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.9",
            "verseOrgIds": [
              "EZK.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cikɛ tɔŋ bi̱lɛ nyɔk kɛ kuër rɛy dɔaar kiɛ jɔp jiɛn piny rɛy ruɔ̱ɔ̱p, kɛ ɣöö bi tɔŋkiɛn a yio̱w kööriɛn. Kä bikɛ nɛy tëë mackɛ kɛ mac, kä bikɛ nɛy tëë pɛ̈ckɛ kɛ pɛc, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuɔ̱ny Gog",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛn cäŋ ɛmɔ, bä Gog moc kɛ gua̱a̱th mi kuɔnykɛ jɛ thi̱n kä I-thɛ-rɛl, rɛy lo̱o̱lä ja̱a̱li nhiam baar in wac pi̱. Kä bɛ duɔ̱ɔ̱p nɛɛni tin ja̱a̱l gäk kɛ ɣöö ɛn wani ca Gog kɛnɛ bua̱a̱n nɛɛnikɛ ti ŋuan kony thi̱n. Kä ba lo̱o̱l ɛmɔ cɔli lo̱o̱l Ɣa-mon-gog",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:11",
              "type": "text"
            },
            {
              "text": "Ɣa-mon-gog",
              "type": "text"
            },
            {
              "text": "Kɛ thok Ɣi-bɛ-ru lotdɛ ni ɣöö nɛɛ Gog ti ŋuan.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ I-thɛ-rɛl kɛ kony kɛ päth da̱ŋ bärɔw, kɛ ɣöö bikɛ wec jakä puɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ wec diaal rɔ̱ mat kunyädiɛn. Kä bɛ kɛn diaal nöŋ luth kɛ cäŋ in bä nyoth ni buɔ̱mdä, ruac ni ɣän Kuäär ni Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ naath kuany go̱lä ti ba mun la ja̱lkɛ kɛ ɣöö bikɛ nɛy tɔ̱ ci duɔth a /ka̱n kony tɔ̱ la kuɔnykɛ, nɛy tin ci duɔth piny, kɛ ɣöö bikɛ mun jakä puɔth. Kɛ päth da̱ŋ bärɔw, bikɛ mun go̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.14",
            "verseOrgIds": [
              "EZK.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wäkɛ wä ja̱l rɛy wec, mi wä raan cɔa̱a̱ ran wä nɛn, bɛ gëkdɛ moc kɛ nyuuth, amäni mi ca jɛ ben kony ɛ nɛy tin la kuɔnykɛ naath rɛy lo̱o̱lä Ɣa-mon-gog. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.15",
            "verseOrgIds": [
              "EZK.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kä te wec Ɣä-mo-naa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:16",
              "type": "text"
            },
            {
              "text": "Ɣä-mo-naa",
              "type": "text"
            },
            {
              "text": "Lotdɛ ni ɣöö nɛy ti ŋuan.",
              "type": "text"
            }
          ]
        },
        {
          "text": " thi̱n ɛn wani bä.) Inɔ bikɛ wec cu jakä puɔth.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱du lö gat ran, nɛmɛ ɛ min lar Kuäär ni Kuoth Nhial ɛ ɛn ɣöö, ruacni kɛ diit nhial diaal kɛnɛ ley dɔaar diaal jio̱k nikɛ i̱, “Duɔlɛ rɔ̱, kä bia kɛɛl pekni diaal camɛ muc ti̱mä min cä rialikä kɛ kui̱dun mi̱eth ti̱mä, mi di̱i̱t wuɔ̱thni päämni I-thɛ-rɛl, bia ri̱ŋ cam thi̱n kä bia riɛm math thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bia ri̱ŋ rɛmni ti buɔ̱m buɔ̱ɔ̱m cam, kä bia riɛm ruëëcni wec muɔ̱ɔ̱n math, ce̱tkɛ mi ɛ riɛm dɛy deet kiɛ thäk dɛ̈ɛ̈l böwä kiɛ rɔɔmä, kɛ thääk ti ci kɛn diaal cuath kä Ba-can. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ mi̱th ti̱mä tin ca rialikä kɛ kui̱dun, yɛn diit nhial kɛnɛ yɛn ley dɔaar bia mi̱th kɛ ri̱ŋ tin cuay amäni mi cia ria̱ŋ, kä bia maath kɛ riɛm amäni mi cia yɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wi̱i̱ tokädä, bia mi̱th kɛ ri̱ŋ ji̱ jio̱ŋko̱o̱ri kɛnɛ ri̱ŋ ji̱ thurbiɛɛli, kɛnɛ ri̱ŋ wutni köör tin buɔ̱m buɔ̱ɔ̱m, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Loc gɔɔyä I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuäär ni Kuoth Nhial mɛmɛ lar wëë i̱, “Ɣän bä buɔ̱mdä jakä ŋa̱ckɛ ɛ döör diaal. Kä kɛn döör bikɛ lukdä min la cuɔ̱ɔ̱ŋ kɛnɛ buɔ̱mdä min cä luɔ̱ckɛ nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi thok duëël I-thɛ-rɛl ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial ni Kuothdiɛn, ɛn cäŋ ɛmɔ a wä nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi döör ɛ cu ŋa̱c ɛn ɣöö, wä thok duëël I-thɛ-rɛl pɛɛcä kɛ dueerkiɛn, kɛnɛ ɣöö cikɛ ɣä lät kä ti jiäk ɛlɔ̱ŋ. Kɛ kui̱ ɛmɔ ɣän cä waŋdä tɛ̱̈ɛ̱̈ kɛ kɛ, kä cäkɛ la̱th tetdä ji̱ tɛ̈riɛn, kä cua kɛn diaal cu näk kɛ ko̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ lät kɛ kɛ ce̱tnikɛ dueerkiɛn, kä cua̱ waŋdä tɛ̱̈ɛ̱̈ kɛ kɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, cu Kuäär ni Kuoth Nhial mɛmɛ lar wëë i̱, “Täämɛ ɣän bä Je-kɔb luɔc muundɛ, kä bä tekɛ kɔ̱a̱c lɔaac kɛ thok duëël I-thɛ-rɛl ni kɛɛliw. Kä bä tekɛ tiɛɛl kɛ kui̱ cio̱tädä min rɛl gɔɔydɛ rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ pöcdiɛn pa̱l ruëëc, kɛn tëë jiäk diaal tëë ci kɛn kɛ lät kä ɣä, mi wäkɛ wä cieŋ kɛ mal muundiɛn a thilɛ ram mi bikɛ lɛ jakä dual. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi wa̱a̱kɛ ruɔ̱ɔ̱l rɛy dööri kɛnɛ wi̱i̱ ji̱ tɛ̈riɛn tëë cakɛ riaw thi̱n, ɣän bä rɔ nyoth ɛn ɣöö rɛl gɔɔydä rɔ kɛ kɛ nhiam dööri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi kɛn ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial ni Kuothdiɛn kɛ ɣöö cäkɛ jäkä rɛy dööri ala pɛ̈ɛ̈c kä bäkɛ nyɔk kɛ loc muundiɛn. Thilɛ ram kɛl kä kɛ mi bi duɔth rɛy dööri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cä waŋdä bi nyɔk kɛ tëë kɛ kɛ, mi wa̱a̱ yiëëdä wä ka̱m ji̱ thuɔk duëël I-thɛ-rɛl, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.29",
            "verseOrgIds": [
              "EZK.39.29"
            ]
          }
        }
      ]
    }
