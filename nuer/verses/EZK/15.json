    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäät jiath buɔ̱cä mi thil luɔt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ruac Kuɔth Nhial ben kä ɣä wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.1",
            "verseOrgIds": [
              "EZK.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.5",
            "verseOrgIds": [
              "EZK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, mɛmɛ larɛ ɣän Kuäär ni Kuoth Nhial i̱, “Ce̱tnikɛ mëë cä tɔaŋ jiaath buɔ̱cä ka̱n rɛy tɔɔŋni jiɛn ruɔ̱ɔ̱p diaal, kä cua̱ jɛ la̱th maac ala tɔaŋ, ɣän bä nɛy tin cieŋ kä Jɛ-ru-tha-lɛm thöp inɔ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.6",
            "verseOrgIds": [
              "EZK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä ŋɛ̈ɛ̈nydä nyuɔ̱th kɛ, a cäŋ ɛ mëë cikɛ kɔŋ kään maac, ŋotdɛ bi mackɛ dhil nikɛ pët. Kä bi kɛ jɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial, mi wa̱a̱ ŋɛ̈ɛ̈nydä wä nyuɔ̱th kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.7",
            "verseOrgIds": [
              "EZK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä wec jakä te ni baaŋ, kɛ ɣöö cikɛ lät a thilɛ kɛ ŋa̱th, ruac ni ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.15.8",
            "verseOrgIds": [
              "EZK.15.8"
            ]
          }
        }
      ]
    }
  ],
