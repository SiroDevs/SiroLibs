              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ruac Kuɔth Nhial ben kä ɣä wëë i̱, “Gat ran, thok duëël I-thɛ-rɛl ruacɛ wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Jɛn nyuuth in cɛ nɛn ɛ nyuuth mi bi ben kɛ run ti ŋuan tia̱ nhiam. Latdɛ ruaacni go̱o̱kä kɛ gua̱a̱th mi nɔ̱a̱n nɔ̱a̱n.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.27",
            "verseOrgIds": [
              "EZK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
