          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        },
        {
          "name": "verse",
