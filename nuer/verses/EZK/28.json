            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial wee i̱, “Jɛn thok duëël I-thɛ-rɛl /cɛ rɔ bi nyɔk kɛ mi tëëkɛ ji̱ thieekä ti bakɛ ciɛŋ a jiäk ce̱tkɛ thil kɛnɛ kuiy. Kä bi kɛn ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuäär ni Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.24",
            "verseOrgIds": [
              "EZK.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuäär ni Kuoth Nhial mɛmɛ lar wëë i̱, “Mi wa̱a̱ ji̱ thuɔk duëël I-thɛ-rɛl wä ruɔl guäth kɛl rɛy dööri diaal tëë cäkɛ kiɛth thi̱n, kä bä gɔɔydä min rɛl rɔ nyoth rɛydiɛn, nhiam dööri diaal, ɛn wanɔ bikɛ cu nyuur muun ëë cä ka̱m ja̱ŋdä ni Je-kɔb. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.25",
            "verseOrgIds": [
              "EZK.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ cu cieŋ kɛ mal rɛydɛ, bikɛ ti̱ec la̱t kä bikɛ ka̱a̱k wal kɛ kui̱ kɔaŋ pith. Bikɛ cieŋ kɛ mal, mi wa̱a̱ ji̱ thieekädiɛn diaal tëë cikɛ ciɛŋ ɛ jiäk luk. Kä bi kɛn ɛ cu ŋa̱c ɛn ɣöö ɛ ɣän Kuoth Nhial ni Kuothdiɛn.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.26",
            "verseOrgIds": [
              "EZK.28.26"
            ]
          }
        }
      ]
    }
