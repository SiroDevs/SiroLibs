        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱o̱kä mi jiääk kɛ kui̱ kua̱r Dhor",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
