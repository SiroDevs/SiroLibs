{
  "id": "1SA.8",
  "number": "8",
  "bookId": "1SA",
  "reference": "1 Tham 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
