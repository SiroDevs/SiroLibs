              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ji̱ Ɣɛb-ron, cuɛ kɛ jäk kä gua̱thni diaal tin ci Dee-bid kɛnɛ nɛɛkɛ wä thi̱n.",
          "type": "text",
