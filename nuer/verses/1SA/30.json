          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Dee-bid ben kä Dhik-lag, cuɛ tha̱a̱ŋ kuakni tin ca Pɛc jäk kä mäthnikɛ, ni bööth Juda, wee i̱, “Nɛmɛ ɛ mucdun kä tin ca pɛc kä ji̱ tɛ̈r Kuɔth Nhial.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jäk kä nɛy tin te kä Beth-ɛl kɛnɛ ji̱ Ra-moth kä Nɛ-gɛb, kɛ Ya-tir, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ ji̱ Ä-ro-er kä Thip-moth, kɛ Ɛc-tɛ-mo-ä, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Ra-kal, kɛnɛ wi̱i̱ Ya-ra-mɛ-ɛl, rɛy cieŋ ji̱ Kɛɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ ji̱ Ɣɔr-ma, kɛ ji̱ Bor-a-can, kɛ ji̱ Ä-thak, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
