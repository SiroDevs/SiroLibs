  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "1SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luäk Dee-bid kɛ wec kiila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua Dee-bid jiök i̱, “Nɛnɛ ji̱ Pi-li-thɛt nyieenykɛ kɛ ji̱ Kiila, kä mac kɛn gua̱th kɔ̱mä bɛɛl.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.1",
            "verseOrgIds": [
              "1SA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ cu Dee-bid Kuoth Nhial thiec i̱, “Ɣän bä kɛn ji̱ Pi-li-thɛt ti̱ti̱ wä mak?” kä cu Kuoth Nhial ɛ loc i̱, “Wër, mäknikɛ, luäk kiila.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.2",
            "verseOrgIds": [
              "1SA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nɛɛ Dee-bid wee i̱, “Nɛnɛ, dual kɔn ɛn wa̱nɛ kä Juda. Bɛ ku lɛ te i̱di mi wä kɔn wä nyiëëny kɛ rɛm ji̱ Pi-li-thɛt kä Kiila?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.3",
            "verseOrgIds": [
              "1SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid Kuoth Nhial nyɔk kɛ thiec. Kä cu Kuoth Nhial ɛ loc i̱, “Jiɛc rɔ, wër kä Kiila. Kɛ ɣöö bä ji̱ Pi-li-thɛt ka̱m yɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.4",
            "verseOrgIds": [
              "1SA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid kɛnɛ nɛɛkɛ wä kä Kiila, cukɛ wä nyiëëny kɛ ji̱ Pi-li-thɛt, kä cukɛ ɣɔ̱ɔ̱kiɛn pɛc, kä cukɛ näk rɛydiɛn. Inɔ cu Dee-bid Kiila cu luäk.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.5",
            "verseOrgIds": [
              "1SA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë bar Ɛb-ya-thar gat Ä-ɣi-mɛ-lɛk rɔ kɔɔr Dee-bid kä kiila, cuɛ gaakni nööŋ kɛɛl kɛ rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cua la̱r Thɔɔl i̱ Dee-bid a kä Kiila, kä cuɛ wee i̱, “Ci Kuoth ɛ ka̱mä. Kɛ ɣöö cɛ rɔ ga̱k wi̱c mi tëë thi̱i̱k mi ga̱k kɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔɔl nɛy diaal cɔal ko̱o̱r, kɛ ɣöö ba Dee-bid wä go̱l kä Kiila kɛnɛ nɛɛkɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Dee-bid ŋäcɛ jɛ ɛn ɣöö Thɔɔl go̱o̱rɛ ɣöö bɛ jɛ lät kä mi jiääk. Kä cuɛ Ɛb-ya-thar bo̱o̱th palä jiök i̱, “No̱o̱ŋni gaakni wa̱nɛ mi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wee i̱, “Aɣ Kuoth Nhial, Kuoth I-thɛ-rɛl, ci ja̱ŋdu jɛ liŋ ɛ puc ɛn ɣöö Thɔɔl go̱o̱rɛ ben kä Kiila, bɛ jɛ ben däk kɛ kui̱dä. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ji̱ Kiila bi kɛ ka̱m jɛ? Ɛ bi Thɔɔl ben, ce̱tkɛ min cä liŋ? Aɣ Kuoth Nhial, Kuoth I-thɛ-rɛl, läri jɛ ja̱ŋdu.” Kä cu Kuoth Nhial ɛ jiök i̱, “Bɛ ben.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wee i̱, “A bi ji̱ Kiila nɛy ka̱m Thɔɔl?” Kä cu Kuoth Nhial ɛ jiök i̱, “Ba yɛ ka̱m jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid kɛnɛ nɛɛkɛ ti kur bäkɛl jiɛɛn kä Kiila, kä cukɛ wä guäth ɛ dëë kɛ wä thi̱n ɔ. Kä mëë ci Thɔɔl ɛ liŋ i̱ ci Dee-bid rɔ bar kä kiila, /kenɛ lɛ ben.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dee-bid rɛy dɔaar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid te rɛy kɔ̱a̱kni päämni rɛy dɔar Dhip. Kä la Thɔɔl ja go̱o̱r ni ciaŋ, duundɛ ɣöö/ken Kuoth ɛ ka̱m jɛ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid dual kɛ ɣöö go̱o̱r Thɔɔl näkdɛ. Cuɛ te rɛy dɔaar Dhip kä Ɣor-caa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.15",
            "verseOrgIds": [
              "1SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Jo-na-than gat Thɔɔl ben kä Dee-bid kä Ɣor-caa buumɛ jɛ i̱ bi Kuoth i̱ gaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.16",
            "verseOrgIds": [
              "1SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ jɛ jiök i̱, “Cu dual. /Ci gua̱a̱r ni Thɔɔl ji̱ bi jek. Kä bia̱ kuäär kä I-thɛ-rɛl, kä bä te kɔɔru. Kä ŋäc gua̱a̱r ɛ ɛn nɔmɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.17",
            "verseOrgIds": [
              "1SA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛn da̱ŋ rɛw ruac mat nhiam Kuɔth Nhial. Cu Dee-bid duɔth kä Ɣor-caa, kä cu Jo-na-than loc cieŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.18",
            "verseOrgIds": [
              "1SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Dhip wä kä Thɔɔl kä Giba wa jɛ jiök i̱, “Ciɛ Dee-bid ci rɔ tɛ̱̈ɛ̱̈ rɛyda mi, rɛy kɔ̱a̱kni kä Ɣor-caa, rɛy päämni kä A-ki-la min te cuëëc Yɛ-ci-mon? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.19",
            "verseOrgIds": [
              "1SA.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ku ben lö kuäär ce̱tnikɛ min go̱o̱r lɔcdu jɛ. Kä min ba̱kɔ la̱t ɛ ni ɣöö ba̱kɔ ka̱m ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.20",
            "verseOrgIds": [
              "1SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔɔl wee i̱, “A Kuoth Nhial poth yɛ. Kɛ ɣöö cia tekɛ nhök kɛ ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.21",
            "verseOrgIds": [
              "1SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiaa kä ŋa̱cɛ jɛ agɔaa. Gua̱a̱th in dëë jek thi̱n, kä ɛŋa mi ci jɛ nɛn, kɛ ɣöö ca la̱rä i̱ pɛlɛ ɛlɔ̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.22",
            "verseOrgIds": [
              "1SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛ mɔ tiɛtdɛ kɔ̱a̱k diaal tin cɛ rɔ tɛ̱̈ɛ̱̈ thi̱n, kä bia ɣä ben la̱r min thuɔ̱k. Kä bä ben wä kɛɛl kɛ yɛ, mi tëë ɛn wi̱ni, bä wä go̱r rɛy gan Juda diaal.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.23",
            "verseOrgIds": [
              "1SA.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jiɛɛn wäkɛ kä Dhip nhiam Thɔɔl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä te Dee-bid kɛnɛ nɛɛkɛ rɛy dɔaar Ma-ɣon kä Ä-ra-ba cuëëc Yɛ-ci-mon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.24",
            "verseOrgIds": [
              "1SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔɔl kɛnɛ nɛɛkɛ wä, wa Dee-bid go̱r. Kä cua la̱r Dee-bid. Kɛ kui̱c ɛmɔ cu Dee-bid wä cieŋ rɛy pa̱a̱m rɛy dɔaar pääm Ma-ɣon, kä mëë ci Thɔɔl ɛ liŋ cuɛ guɔ̱ɔ̱r rɛy dɔaar Ma-ɣon. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.25",
            "verseOrgIds": [
              "1SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Thɔɔl wä kui̱ pa̱a̱m, kä te Dee-bid kɛnɛ nɛɛkɛ kui̱i̱ pa̱a̱m. Kä cu Dee-bid rɔ bar kɛ pɛ̈th kɛnɛ nɛɛkɛ kɛ Thɔɔl, min ci Thɔɔl kɛnɛ nɛɛkɛ thia̱k kɛ käpdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.26",
            "verseOrgIds": [
              "1SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ja̱a̱k ben kä Thɔɔl jiök kɛ jɛ i̱, “Bër kɛ pɛ̈th, kɛ ɣöö ji̱ Pi-li-thɛt mackɛ wec.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.27",
            "verseOrgIds": [
              "1SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Thɔɔl rɔ ri̱t kɔɔr Dee-bid, kä cuɛ wä nyiëëny kɛ ji̱ Pi-li-thɛt. Kɛ kui̱c ɛmɔ cua gua̱a̱th ɛmɔ cɔli päm lënyä. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.28",
            "verseOrgIds": [
              "1SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid jiɛɛn ɛn wa̱nɔ, cuɛ wä cieŋ kɔ̱a̱kni Een-gɛ-di.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.29",
            "verseOrgIds": [
              "1SA.23.29"
            ]
          }
        }
      ]
    }
