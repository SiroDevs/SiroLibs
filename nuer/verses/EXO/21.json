          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä raan ja̱ŋdɛ yɔ̱t waaŋ, a bɛ muɔ̱t, mi ɛ ciek kiɛ wut, bɛ ja̱ŋ ɛmɔ pa̱l wä lɔrä kɛ kui̱ waŋdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi cɛ le̱y jäŋädɛ ar piny, mi ɛ wut kiɛ ciek, bɛ ja̱ŋ ɛmɔ jak kä wä baaŋ kɛ kui̱ lɛ̈c mi cɛ ar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋuɔ̱t gua̱n kä duɔ̱ɔ̱r",
          "type": "text"
        }
