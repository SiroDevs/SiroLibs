              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cäŋ ëë ruac kɛ Kuoth Nhial kɛ Muthɛ ro̱o̱l I-jëp, cuɛ Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ ɣän Kuoth Nhial, läri Pɛro kuäär I-jëp ti diaal tëë cä la̱rä ji̱.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
