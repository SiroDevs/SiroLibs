        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yi̱k weŋä wal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi yi̱k täth kɛ jiath thëëp mi ba wal ti gɔaa ŋuänydiɛn la waŋkɛ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi bärɛ a juäth tetdä kɛl, kä bi riewdɛ a juäth tetdä kɛl, bi bärɛ pa̱a̱r kui̱cni diaal. Kä bi bär thöölɛ a jua̱th te̱tni da̱ŋ rɛw, bi tuɔ̱ŋkɛ ce̱tnikɛ mi bäkɛ raar puɔ̱ɔ̱ny jiaath, ba kɛ täth kɛ jɛn jiath ɛ kɛl ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä biɛ rɔth kɛ da̱a̱p mi ti̱l ti̱l amäni biɛɛdɛ kɛnɛ bua̱a̱lkɛ kɛ tuɔ̱ŋkɛ. Kä biɛ lät kä thɛɛr gëëknikɛ wi̱i̱dɛ nhial kɛ da̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi tiil dääpä da̱ŋ rɛw la̱t kɛ kui̱dɛ piny thɛɛrädɛ, bi kɛ la̱th kui̱cnikɛ da̱ŋ rɛw tin luɔtkɛ rɔ̱. Bikɛ a go̱o̱ni to̱ŋni da̱ŋ rɛw tin ba kapkɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi to̱ŋ tɔ̱tɔ̱ la̱t kɛ jiath thëëp, kä bi kɛ rɔth kɛ da̱a̱p. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä biɛ la̱th nhiam ge̱e̱lä min te nhiam thandukä lueekni, gua̱a̱th in bä ro̱m kɛ ji̱ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Ä-ron wal ti tekɛ ŋuäny mi kur kur waŋ wi̱i̱dɛ, mi cɛ lɛmbär rial ikä ni ciaŋ kɛ runwaŋ, bɛ jɛ a dɔbɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi ci Ä-ron lɛmbär ŋap nhial kɛ thiaŋ bɛ jɛ a dɔbɛ, bikɛ a ti te thi̱n nhiam Kuɔth Nhial ri̱cnikun diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ca wäl mi /ci rɔ lot kɛ Kuoth Nhial, bi waŋ wi̱i̱dɛ, kiɛ luuri tin la waŋkɛ kiɛ muc bɛɛl, kiɛ muc tin la muɔckɛ piny /ca kɛ bi la̱th wi̱i̱dɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Ä-ron luël a lätdɛ tuɔ̱ŋni yi̱kä kä kɛɛl kɛ ruɔ̱n kɛ riɛm luurä dui̱rä min la luɛlkɛ, bɛ luel la̱t kä kɛɛl kɛ ruɔ̱n, kä bɛ räth mäni karkun diaal. Ɛ mi rɛl gɔɔydɛ rɔ kä ɣän Kuoth Nhial.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tho̱lbo̱k kɛmɛkä ro̱mä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wi̱i̱ ji̱ I-thɛ-rɛl wä kuɛn bi ramɔ ɣä ka̱m kök kɛ kui̱ teekädɛ guäth in gɔ̱ri kɛ ɣöö bɛ thil ti bɛ̈c bɛ̈ɛ̈c rɛydiɛn guäth in gɔ̱ɔ̱rikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi ram mi ca gɔ̱r kuenä yio̱w tin görkɛ la tho̱p, ce̱tkɛ pek yio̱o̱ni luaak Kuɔth. Bɛ kɛ la tho̱pɛ ala luur kä ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛy diaal tin runkiɛn jiɛn rɛw a wä nhial, bikɛ muc la tho̱p, ɣän Kuoth Nhial guäth in gɔ̱a̱rkɛ ciöötkiɛn guäth kue̱nä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ci nɛy ti ria̱ŋ ria̱a̱ŋ kui̱c yio̱o̱ni tɔ̱ thöpkɛ tɔ̱ bi re̱p, kä /ci nɛy tin can ɛ bi gäm guäth in thöpɛ muc, ɣän Kuoth Nhial, kɛ ɣöö bia tëkdun a luɛlɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi yio̱w luël la käni kä ji̱ I-thɛ-rɛl, bi kɛ lät ni la̱t duëël ro̱mä kɛ ɣöö bɛ Kuoth Nhial jak kä la tiimɛ ji̱ I-thɛ-rɛl nhiamdɛ kä bia tëkdun cu luɛl.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Thak yieethä in yian",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bi rɔɔdu ta̱th thak yie̱e̱thä, bi tharɛ täth kɛ ciɛk in yian kɛ kui̱ la̱k. Kä biɛ kuëŋ kam duëël ro̱mä kɛnɛ yi̱k. Kä bi pi̱ la̱th rɛydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn bi Ä-ron kɛn gaatkɛ te̱tkiɛn kɛnɛ ciökiɛn a lak thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ te̱tkiɛn kɛnɛ ciökiɛn a lakkɛ thi̱n guäth in wäkɛ rɛy duëël ro̱mä kɛnɛ gua̱a̱th in bäkɛ gekä yi̱kä kɛ ɣöö bikɛ ben lät, kɛ min waŋkɛ muc in la wa̱ŋkɛ ɣän Kuoth Nhial. Inɔ /cikɛ bi lɛ li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bikɛ te̱tkiɛn kɛnɛ ciökiɛn a lakkɛ a /cikɛ bi lɛ li̱w. Ba ŋut mi do̱raar kä kɛ, ni kä jɛn puɔ̱nydɛ amäni kuaykɛ ri̱cnikiɛn diaal.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Liɛɛth yi̱rä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ, cu Kuoth Nhial Muthɛ ni jiök i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Käni wal ti kuɔ̱r kuɔ̱ɔ̱r ala yieer wa̱l in kɔp mi tekɛ ki̱i̱lugram da̱ŋ bäkɛl, kɛnɛ wäl mi gɔaa ŋuänydɛ mi tekɛ theemni diɔ̱k, mäni to̱ŋ wa̱l mi lim lim ti tekɛ theemni diɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ luac mi theemni kɛ bäkɛl, kɛn diaal ba kɛ theem kɛ theemni luaak Kuɔth, matkɛ kɛ liɛth mi thiääŋ liɛɛr mi yial. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi liɛɛth yi̱rä mi rɛl rɔ la̱t kɛ kɛ, a liɔɔmi kɛ ce̱tnikɛ min la läät lithni kɛ a liɔm guäth la̱tdɛ, ba liɛɛth yi̱rä mi gɔaa mi rɛl rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi due̱l ro̱mä kɛnɛ thanduk lueekni a yi̱i̱ri kɛ jɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "amäni tharbët kɛnɛ kuakɛ diaal, kɛ cuuŋ lɛmbär amäni nyinkɛ diaal, kɛ yi̱k in la waŋkɛ wal ti ŋuän thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛnɛ yi̱k luuri tin la waŋkɛ kɛnɛ kuakɛ diaal, mäni thak kɛnɛ tharɛ min cuŋ kɛ jɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi kɛ lëy Kuoth Nhial kɛ ɣöö bikɛ a nyin Kuɔth ti gɔw ti rɛ̈lkɛ rɔ̱ ɛlɔ̱ŋ, kä ɛ niɛ kɛl ɔ bi yi̱k ɛmɔ gueer ɔ bɛ jɛ jak kä mi gɔaa mi rɛl rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi̱i̱ Ä-ron kɛnɛ gaatkɛ yi̱r, kä bi kɛ le̱y Kuoth Nhial kɛ ɣöö bikɛ lätkä la̱t ala bööth palä. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ I-thɛ-rɛl jiök i̱, ‘Liɛɛth ɛmɛ ɛ liɛɛth yi̱rädä mi gɔaa mi rɛl rɔ kä ri̱ckun diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Ca bi je̱k ni ɣöö yi̱erkɛ jɛ ni pua̱ny nɛɛni diaal. /Ci mi dɔ̱ŋ mi cäät kɛ jɛ bi la̱t kɛ kui̱dun. Ɛ duŋ Kuɔth mi gɔaa mi rɛl rɔ, kä ba mi gɔaa mi rɛl rɔ kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä raan mi ce̱tkɛ jɛ wä la̱t kɛnɛ mi wee tekɛ ram mi bi jɛ la̱th puɔ̱ɔ̱ny jurä dɔ̱diɛn, ram ɔ lät mi ce̱tkɛ nɔ mɔ ba tuɔ̱k raar rɛy nɛɛnikɛ.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wal tulä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Muthɛ jiök i̱, “Käni wal ti tekɛ ŋuäny mi gɔaa kä luaac da̱ŋ diɔ̱k, luac mi kɔp ɛlɔ̱ŋ kɛnɛ luac mi di̱t kökdɛ kɛ luac mi re̱e̱p ŋuäny, kɛɛl kɛ luac mi ti̱l ti̱l mi la waŋkɛ, kɛn diaal ba pe̱k thëmdiɛn pa̱a̱r ɛyit. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi wäl mi gɔaa ŋuänydɛ mi ba waŋkɛ la̱t ce̱tnikɛ la̱t in la läät lithni a lät ni yie̱e̱r biɛ liɔm kɛ milɛ. Ɛ duŋ Kuɔth mi lɛy lɛy mi rɛl gɔɔydɛ rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi tha̱a̱ŋdɛ ɣɔ̱l ala mi nyiw nyiw, bi tha̱a̱ŋdɛ la̱th nhiam thandukä lueekni min te due̱e̱l ro̱mä, guäth in ba̱a̱ ro̱mä kɛ ji̱ thi̱n. Ba duŋ Kuɔth mi gɔaa mi rɛl gɔɔydɛ rɔ ɛlɔ̱ŋ, mi thil mi päär kɛ jɛ kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä wal ŋuänyä tin bia la̱t kɛ kui̱dun, /cia kɛ bi pa̱a̱r kɛ la̱t in la̱tkɛ ni nɛmɛ, bi ŋäcdun kɛ jɛ a ɣöö ɛ duŋ Kuɔth mi gɔaa mi ɣɛɛl rɔ kä Kuoth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram mi wä mi ce̱tkɛ jɛ wä la̱t ala liɛɛth pua̱a̱ny mi bɛ rɔɔdɛ a yi̱i̱rɛ kɛ jɛ, jɛn ram ɔ ba tuɔ̱k raar rɛy nɛɛnikɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
      ]
    }
