        "style": "s1"
      },
      "items": [
        {
          "text": "Luëëk Kuɔth da̱ŋ wäl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
