        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“A lɔcdu /ci di̱t kɛ cieeŋ raam mi thie̱e̱k kɛ ji̱. /Cu ciek raam mi thie̱e̱k kɛ ji̱ bɛc, kiɛ lätku kɛɛl, kiɛ thääkdɛ, kiɛ muulɛ, kiɛ mi dɔ̱ŋ mi la duundɛ, /cu jɛ go̱r kɛ lɔcdu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lath pua̱nyni nath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 20:17"
          },
          "items": [
