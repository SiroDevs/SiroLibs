        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pal Yecu kɛ kui̱ jaaknikɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mëë ci Yecu ruaacni tɔ̱tɔ̱ lat, cuɛ nhial liɛc, kä cuɛ wee i̱, “Gua̱di̱n, ci gua̱a̱th ben. Puɔnyni Gatdu, kɛ ɣöö dee Gatdu ji̱ puany, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.1",
            "verseOrgIds": [
              "JHN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö ci jɛ ka̱m lua̱ŋ wi̱i̱ nɛɛni diaal, mi derɛ moc nɛy diaal tin ci ka̱m jɛ tëk mi thil pek. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.2",
            "verseOrgIds": [
              "JHN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɛmɛ ɛ jɛn tëk mi do̱raar ɛn ɣöö ŋa̱ckɛ ji̱, i̱ ɛ ji̱n Kuoth in thuɔ̱k kärɔa, kɛnɛ Yecu Kritho min ci ja̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.3",
            "verseOrgIds": [
              "JHN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cä ji̱ puany wi̱i̱ muɔ̱ɔ̱n kɛ thuɔ̱kdä, kɛ la̱t ëë ci ji̱n ɛ ka̱m ɣä i̱ bä la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.4",
            "verseOrgIds": [
              "JHN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ, Gua̱di̱n, puɔnyni ɣä nhiamdu kɛ gɔɔy puɔnyä mëë tekɛ ɣä nhiamdu mëë /ka̱n ɣɔw ni cak.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.5",
            "verseOrgIds": [
              "JHN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän cä ciötdu nyuɔ̱th nɛy tëë ci ka̱m ɣä wi̱i̱ muɔ̱ɔ̱n. Kɛn kɛ nɛɛku mëëdan, kä cikɛ ka̱m ɣä, kä cikɛ ruacdu käp. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.6",
            "verseOrgIds": [
              "JHN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ŋäc kɛn ɛ ɛn ɣöö ti diaal tin ci ka̱m ɣä bäkɛ kä ji̱, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.7",
            "verseOrgIds": [
              "JHN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö cäkɛ ka̱m ruaacni tëë ci ka̱m ɣä. Cikɛ kɛ nhɔk, kä cikɛ jɛ ŋa̱c kɛ thuɔ̱k ɛn ɣöö ba̱a̱ kä ji̱. Kä cikɛ jɛ ŋäth ɛn ɣöö ɛ ji̱n jäk ɣä mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.8",
            "verseOrgIds": [
              "JHN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän palä ji̱ kɛ kui̱diɛn. Ɣän /cä pal kɛ kui̱ ji̱ ɣɔaa, ɛ kui̱ nɛɛni tëë ci ka̱m ɣä, kɛ ɣöö kɛ nɛɛku. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.9",
            "verseOrgIds": [
              "JHN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛɛkä diaal kɛ nɛɛku, kä nɛɛku kɛ nɛɛkä, kä ca ɣä puany kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.10",
            "verseOrgIds": [
              "JHN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän /cä lɛ ŋot wi̱i̱ muɔ̱ɔ̱n, duundɛ ɣöö tekɛ rɛy ɣɔaa, kä ɣän ba̱a̱ kä ji̱. Gua̱a̱r in Rɛl Rɔ, gaŋkɛ kɛ ciötdu mëë ci ka̱m ɣä, kɛ ɣöö deekɛ a kɛl ce̱tkɛ kɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.11",
            "verseOrgIds": [
              "JHN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guäth ëë ta̱a̱ kɛɛl kɛ kɛ cä kɛ gaŋ kɛ ciötdu mëë ci ka̱m ɣä. Kä cä kɛ gaŋ a thilɛ ram kɛl mi ci bath kä kɛ, ɛ ni gat ëë ca lari bi bath, kɛ ɣöö bi ruaacni Kuɔth tëë ca gɔ̱r a thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.12",
            "verseOrgIds": [
              "JHN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ, ba̱a̱ kä ji̱, kä latdä ti̱ti̱ wi̱i̱ muɔ̱ɔ̱n, kɛ ɣöö dee tɛ̈th lɔaacdä ro̱ŋ rɛydiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.13",
            "verseOrgIds": [
              "JHN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cä kɛ ka̱m ruacdu, kä nyir ɣɔw kɛ, kɛ ɣöö /cikɛ ji̱ ɣɔaa, ce̱tkɛ min /ci ɣän a raan ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.14",
            "verseOrgIds": [
              "JHN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cä ji̱ pal kɛ ɣöö bi kɛ ka̱m raar rɛy ɣɔaa, ɛ ɣöö bikɛ gaŋ kä gua̱n jiäkni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.15",
            "verseOrgIds": [
              "JHN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cikɛ ji̱ ɣɔaa, ce̱tkɛ min /ci ɣän a raan ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.16",
            "verseOrgIds": [
              "JHN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leynikɛ rɔ, kɛ ɣöö ruacdu ɛ thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.17",
            "verseOrgIds": [
              "JHN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tkɛ mëë ci ɣä jäkä wi̱i̱ muɔ̱ɔ̱n, cä kɛ jäkä rɛy ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.18",
            "verseOrgIds": [
              "JHN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱diɛn cä rɔ thöp, kɛ ɣöö dee kɛ rɔ̱ lɛni thöp ji̱ kɛ thuɔ̱k.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.19",
            "verseOrgIds": [
              "JHN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ɣän /cä ji̱ pal kɛ kui̱ nɛɛni ti̱ti̱ kärɔ̱, palä ji̱ kɛ kui̱ nɛɛni ti ba ɣä ŋäth kɛ kui̱ ruacdiɛn bä. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.20",
            "verseOrgIds": [
              "JHN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä palä kɛ ɣöö dee kɛn diaal a kɛl. Kä ji̱n, Gua̱a̱r ti̱i̱, rɛydä, kä ta̱a̱ rɛydu, kɛ ɣöö dee kɛn diaal te rɛydan bä. Kɛ kui̱ kä nɔmɔ dee ɣɔw ɛ ŋäth ɛn ɣöö ɛ ji̱n jäk ɣä mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.21",
            "verseOrgIds": [
              "JHN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä liak ëë ci ka̱m ɣä, cä jɛ ka̱m kɛ, kɛ ɣöö dee kɛ a kɛl, ce̱tkɛ min kɛ kɔn kɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.22",
            "verseOrgIds": [
              "JHN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta̱a̱ rɛydiɛn kä ti̱i̱ rɛydä, kä dee kɛn a kɛl pa̱ny, kɛ ɣöö dee ɣɔw ɛ ŋa̱c ɛn ɣöö ɛ ji̱n jäk ɣä mɔ, kä cikɛ nhɔk kɛ nhök in ci nhɔk ni ɣä. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.23",
            "verseOrgIds": [
              "JHN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua̱di̱n, go̱o̱r lɔcdä ɣöö dee nɛy tin ci ka̱m ɣä te kɛɛl kɛ ɣä guäth in ta̱a̱ thi̱n, kɛ ɣöö bikɛ liakdä mëë ci ka̱m ɣä rɛy nho̱kädu a /ka̱n ɣɔw ni cak nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.24",
            "verseOrgIds": [
              "JHN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aɣ, Gua̱a̱r mi Gua̱n cuŋni, a cäŋɛ mi kui̱c ɣɔw ji̱, ɣän ŋa̱cä ji̱. Kä ŋäc nɛy ti̱ti̱ jɛ ɛn ɣöö ɛ ji̱n jäk ɣä mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.25",
            "verseOrgIds": [
              "JHN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cä ciötdu jakä ŋäc kɛn ɛ, kä bä jɛ jakä ŋa̱ckɛ, kɛ ɣöö dee nhök ëë ci nhɔk ni ɣä te rɛydiɛn, kä bä te rɛydiɛn.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.17.26",
            "verseOrgIds": [
              "JHN.17.26"
            ]
          }
        }
      ]
    }
  ],
