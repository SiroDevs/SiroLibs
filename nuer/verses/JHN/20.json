            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ, cu Yecu nyuuthni kɔ̱kiɛn ti ŋuan ti ga̱ykɛ naath la̱t nhiam ji̱ kɔaarɛ, ti /ka̱n gɔ̱r rɛy buɔk ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
            "verseOrgIds": [
              "JHN.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö ca ti̱ti̱ gɔ̱r kɛ ɣöö dee yɛn ɛ ŋäth ɛn ɣöö Yecu ɛ jɛn Mɛ-thia in la Gat Kuɔth, kä kɛ ŋa̱th, dee yɛn tekɛ tëk kɛ ciötdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.31",
            "verseOrgIds": [
              "JHN.20.31"
            ]
          }
        }
