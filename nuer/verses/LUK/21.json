              "LUK.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gua̱thni diaal la ŋi̱i̱cɛ rɛy luaak Kuɔth, kä kɛ wäär la wëë raar, wi̱i̱ pa̱a̱m mi cɔal i̱ “Ɔ-lip.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä la nɛy diaal a bä kä jɛ kɛ runwaŋ rɛy luaak Kuɔth, kɛ ɣöö bikɛ ruaacnikɛ ben liŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
