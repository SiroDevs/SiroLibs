        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:34-35",
              "type": "text"
            },
            {
              "text": "Ica 24:17.",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiɛtdɛ rɔ̱ kɛ ɣöö /ca lo̱ckun bi tiam ɛ cuɔ̱c mi̱eth kɛnɛ yɔ̱ŋ kɔaaŋni, kɛ diɛɛr kɛ kui̱ teekä, dɔ̱ŋ bi cäŋ ɛmɔ yɛ mam, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ dhuur kɛ ɣöö bi cäŋ ɛmɔ dhil ben kä nɛy diaal ti cieŋ wi̱i̱ muɔ̱ɔ̱n kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ta̱yɛ jinä gua̱thni diaal. Kä palɛ kɛ ɣöö dërɛ tekɛ buɔ̱m kɛ ka̱ndun kä ŋɔaani diaal tin bi tuɔɔk, kɛnɛ ɣöö bia cuɔ̱ŋ nhiam Gatdä Ran.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.36",
            "verseOrgIds": [
              "LUK.21.36"
            ]
          }
        }
      ]
    },
