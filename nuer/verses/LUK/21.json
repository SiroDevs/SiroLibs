{
  "id": "LUK.21",
  "number": "21",
  "bookId": "LUK",
  "reference": "Luk 21",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "LUK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Muc ciëk jɔkä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu nɛy ti ria̱ŋ ria̱a̱ŋ nɛn la̱thkɛ muckiɛn guäth yio̱o̱ni luaak Kuɔth. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ciek jɔkä mi can nɛn, tho̱pɛ yio̱w la̱ŋni da̱ŋ rɛw ti nyin tiɛtni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ wee i̱, “Ɛpuc, ɣän la̱rä jɛ yɛ, ci ciek jɔkä mɛ can ɛmɛ thöp ni mi leny kɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö kɛn diaal cikɛ muɔ̱c rɛy riäŋädiɛn mi di̱i̱t, kä ciek ɛmɛ rɛy canädɛ cɛ nyinkɛ diaal tin dee tëk kɛ jɛ thöp.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Yecu kɛ kui̱ däkä luaak Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.4",
            "verseOrgIds": [
              "LUK.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ruac tha̱a̱ŋ ji̱ kɔaarɛ, kɛ kui̱ gɔɔyä luaak Kuɔth kɛ biɛlɛ min ca bil ni jɛ, kɛ pääm ti gɔw kɛnɛ muc tin ca thöp Kuoth, cuɛ wee i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛ kui̱ ŋɔaani ti cia nɛn ti, bi ni̱n ben mi /ci päm kɛl bi duɔth wi̱i̱ pa̱a̱m dɔ̱diɛn, ba kɛn diaal yuɔr piny.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rik kɛnɛ ciaaŋ jiäkni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.6",
            "verseOrgIds": [
              "LUK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ Yecu thiec i̱, “Ŋi̱i̱c, bi nɔmɔ tuɔɔk i̱ nɛy? Kä bi nyuuthdɛ a ŋu, ɛn ɣöö bɛ tuɔɔk?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee i̱, “Niɛkɛ rɔ̱, kɛ ɣöö /ca yɛ bi buath jɔ̱ɔ̱r, kɛ ɣöö bi nɛy ti ŋuan ben kɛ ciötdä, wäkɛ i̱, ‘Ɛ jɛn ɣän!’ kä ‘Ci gua̱a̱th thia̱k!’ /Cuarɛ wä kɔɔriɛn.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi wä yɛn thuk ko̱o̱ri liŋ kɛnɛ rɔal, /cuarɛ dual. Kɛ ɣöö bi tɔ̱tɔ̱ yi̱k tuɔɔk kɛ nhiam, kä /ci guut bi cu ben ni ɛn guäth ɛmɔ.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.9",
            "verseOrgIds": [
              "LUK.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ kɛ jiök i̱, “Bi do̱rɔ nyiëëny kɛ do̱rɔ, kä bi kuäärɔ nyiëëny kɛ kuäärɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bɛ tekɛ lath piɛny mi di̱t, kä bɛ tekɛ buaath kɛnɛ jua̱th gua̱thni ti gööl. Bɛ tekɛ nyin dualä kɛnɛ nyuuthni ti di̱t ti gäykɛ naath nhial.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.11",
            "verseOrgIds": [
              "LUK.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.11",
            "verseOrgIds": [
              "LUK.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä a ŋot /ken ti̱ti̱ diaal ni tuɔɔk, ba yɛ yian, kä ba yɛ ciɛŋ a jiäk, ba yɛ gɔny guäth dolä ji̱ Juudh kä ba yɛ naŋ duëli yieenä, kä bikɛ yɛ naŋ nhiam kua̱ri kɛnɛ ruëëc kɛ kui̱ cio̱tädä. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ bɛ yɛ moc ɣöö bia thuk tin gɔw la̱t naath. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ ca̱rɛ ɛ /ka̱nɛ rɔ̱ ni rialikä kɛ duɔ̱ɔ̱p in bia gaŋ ni rɔ̱ kɛ nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bä yɛ moc rieet kɛnɛ pɛl mi /ci ji̱ tɛ̈run ɛ bi luäŋ kɛ ga̱k kiɛ kɛ luɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋɛ ni diëëthkun, kɛnɛ dämuɔɔri kɛnɛ watkun kɛ mäthnikun bikɛ yɛ kɔak, kä bikɛ tha̱a̱ŋdun näk. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ba yɛ nyir ɛ nɛy diaal kɛ kui̱ cio̱tädä. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä thilɛ mi̱em wecdun kɛl mi bi bath. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ dhieelun bia tëkdun jek.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Yecu kɛ kui̱ da̱k Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.19",
            "verseOrgIds": [
              "LUK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mi wä yɛn Jɛ-ru-tha-lɛm nɛn a ca göl piny ɛ rɛm, kua ŋa̱c ɛn ɣöö ci däkdɛ thia̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi nɛy tin te kä Ju-dia rɔ̱ bar wuɔ̱thni päämni, kä nɛy tin te rɛy wec jiɛɛn. Kä a nɛy tin raar rɛy wec /ci lɛ loc rɛydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ni̱n ti̱ti̱ kɛ ni̱n cutdä, kɛ ɣöö bi ruaacni tëë ca gɔ̱r a thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riɛk akɛ män tin ruët kɛnɛ tin lueth ɛn ni̱ni tɔ̱tɔ̱! Kɛ ɣöö bɛ tekɛ jiath lɔaac mi di̱i̱t wi̱i̱ muɔ̱ɔ̱n, kä bi waŋ lɔaac tekɛ kɛn nɛy tɔ̱tɔ̱. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakɛ näk kɛ thɛp, kä bakɛ naŋ ala pɛ̈ɛ̈c rɛy dööri diaal. Ba Jɛ-ru-tha-lɛm dɔany piny ɛ Jur, amäni ci gua̱a̱th juri thuɔ̱k.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.24",
            "verseOrgIds": [
              "LUK.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ben Gatdä Ran",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.24",
            "verseOrgIds": [
              "LUK.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä bi nyuuth te thi̱n kä cäŋ, kɛ pay kɛnɛ ciɛr, kä bɛ tekɛ jiath lɔaac wi̱i̱ muɔ̱ɔ̱n kä bɛ wi̱c dööri yi̱c, kɛ wuɔ̱w pi̱i̱ni bar, kɛnɛ muaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi naath muɔ̱n kɛ dual kɛ ŋäcdiɛn kɛ min bi tuɔɔk wi̱i̱ muɔ̱n, kɛ ɣöö ba buɔ̱m buɔ̱ɔ̱m nhial yɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔrɛ ba Gat Ran nɛn bëë piny rɛy puɔ̱rä kɛ buɔ̱m kɛnɛ buay mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ mi ci ti̱ti̱ diaal ku tuɔɔk, kua rɔ̱ jiɛc kä kapɛ wuɔ̱thkun nhial, kɛ ɣöö ci ka̱ndun thiekä.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋi̱i̱c kɛ kui̱ jiaath ŋɔa̱a̱p",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Yecu kɛ la̱t ruac cäätdä i̱, “Guɛcɛ jiath ŋɔa̱a̱p kɛnɛ jiɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɔ ci ji̱thkiɛn tunh ɔ, la yɛn ɛ cua̱ ŋäc ɛn ɣöö ci ruel thia̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cɛ jɛ bä, mi wä yɛn ŋɔak tɔ̱tɔ̱ wä nɛn, bia jɛ cu ŋa̱c ɛn ɣöö ci kuäärä Kuɔth ku thia̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.31",
            "verseOrgIds": [
              "LUK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛpuc, ɛpuc, ɣän la̱rä jɛ yɛ, /ci ri̱c ɛmɛ bi thuɔ̱k a /ken ŋɔak diaal ti̱ti̱ tuɔɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi nhial kɛnɛ piny thuɔ̱k, kä /ci rieetkä bi met thuɔ̱k.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.33",
            "verseOrgIds": [
              "LUK.21.33"
            ]
          }
        }
      ]
    },
