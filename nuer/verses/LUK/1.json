          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.45",
            "verseOrgIds": [
              "LUK.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mɛri wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.46",
            "verseOrgIds": [
              "LUK.1.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 1:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.55",
            "verseOrgIds": [
              "LUK.1.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mɛri te kɛɛl kɛ I-li-dha-bɛth kɛ päth da̱ŋ diɔ̱k, kä cu Mɛri loc cieeŋdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Da̱p Jɔ̱ɔ̱n in la lääk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 1:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.56",
            "verseOrgIds": [
              "LUK.1.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 1:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu gua̱a̱th dapä I-li-dha-bɛth cop, kä cuɛ dap kɛ gat mi dho̱o̱l. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.57",
            "verseOrgIds": [
              "LUK.1.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ thieekädɛ kɛnɛ watkɛ jɛ liŋ ɛn ɣöö ci Kuäär ni Kuoth ɛ nyuɔ̱th kɔ̱a̱c lɔaac mi di̱i̱t, kä cu lo̱ckiɛn tɛɛth kɛ jɛ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 1:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.58",
            "verseOrgIds": [
              "LUK.1.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 1:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ bädäk ni̱ni cukɛ ben kɛ ɣöö ba gat ben cuɛl, kä ɛ kɛn i̱ ba jɛ cɔl i̱ Dhɛ-kar-yaa kɛ ciöt gua̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.59",
            "verseOrgIds": [
              "LUK.1.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "LUK 1:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu man wee i̱, “/Ciɛ jɛn, ba jɛ cɔl i̱ Jɔ̱ɔ̱n.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.60",
            "verseOrgIds": [
              "LUK.1.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "LUK 1:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ jɛ jiök i̱, “Thilɛ ji̱ watdu mi cɔalkɛ kɛ jɛn ciöt ɛmɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.61",
            "verseOrgIds": [
              "LUK.1.61"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "62",
            "style": "v",
            "sid": "LUK 1:62"
          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ gua̱n wɛt, thiëckɛ jɛ kɛ ciöt in go̱o̱rɛ i̱ ba cɔl ni jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.62",
            "verseOrgIds": [
              "LUK.1.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "LUK 1:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ kɛ thiec duɔ̱ɔ̱r mi derɛ gɔ̱a̱r thi̱n, kä cuɛ jɛ gɔ̱r i̱, “Ciötdɛ ɛ jɛn Jɔ̱ɔ̱n.” Kä cu kɛn diaal ga̱a̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.63",
            "verseOrgIds": [
              "LUK.1.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "LUK 1:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni ɛn guäth ɛmɔ cu jɔwdɛ rɔ nyɔk kɛ lɛ̈p. Cuɛ lɛpdɛ lony, kä cuɛ ruac a liakɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.64",
            "verseOrgIds": [
              "LUK.1.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "65",
            "style": "v",
            "sid": "LUK 1:65"
          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ thieekädiɛn diaal dual. Kä ca ruaacni ti̱ti̱ diaal da̱k rɛy rööl päämni kä Ju-dia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.65",
            "verseOrgIds": [
              "LUK.1.65"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu nɛy diaal tëë cakɛ liŋ ga̱a̱c, wäkɛ i̱, “Bi gat ɛmɛ ku la ŋa?” Kɛ ɣöö te Kuäär ni Kuoth kɛ jɛ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱o̱kä Dhɛ-kar-yaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "66",
            "style": "v",
            "sid": "LUK 1:66"
          },
          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.66",
            "verseOrgIds": [
              "LUK.1.66"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "67",
            "style": "v",
            "sid": "LUK 1:67"
          },
          "items": [
            {
              "text": "67",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gua̱n ni Dhɛ-kar-yaa ro̱ŋ kɛ Yiëë in Gɔaa in Rɛl Rɔ, kä cuɛ ruac go̱o̱kä lat wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.1.67",
            "verseOrgIds": [
              "LUK.1.67"
            ]
          }
        }
      ]
    }
