    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäät kɛ dɛl mi ci bath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu thuɔ̱ɔ̱l tho̱lbo̱kä kɛ ji̱ dueeri rɔ̱ ti̱ec thiäkä kɛ ɣöö ba ruac Yecu ben liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu ji̱ Pa-ri-thii kɛnɛ ji̱ gɔ̱rä guɔɔr, wäkɛ i̱, “Wut ɛmɛ nyuurɛ ji̱ dueeri kä mi̱thɛ kɛ kɛ kɛɛl.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu kɛ la̱t ruac cäätdä ɛmɛ i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛŋa kä yɛ mi tekɛ rɔɔm ti kuɔ̱r, kä ci kɛl bath thi̱n, /cɛ det ti jiɛn bäŋuan wi̱cdɛ bäŋuan a bänyɛ läk, kɛ ɣöö bɛ min ci bath wä go̱r, amäni mi cɛ jɛ jek? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cɛ jɛ jek, la kapɛ jɛ kɛ ŋuäkdɛ, kä bi lɔcdɛ tɛɛth. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cɛ ben cieŋ, bɛ mäthnikɛ kɛnɛ ji̱ thieekädɛ cɔl, kä bɛ kɛ jiök i̱, ‘A lo̱ckun tɛth kɛ ɣä kɛɛl, kɛ ɣöö cä dɛlä mëë ci bath jek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A cäŋ ɛ jɛn inɔ, ɣän la̱rä jɛ yɛ, ɛn ɣöö bɛ tekɛ tɛ̈th lɔaac mi di̱i̱t cieŋ nhial kɛ kui̱ gua̱n duerä kɛl mi ci rɔ ri̱t dueerikɛ, kä ji̱ cuŋni ti jiɛn bäŋuan wi̱cdɛ bäŋuan ti /ci riet kɛ rɔ̱ go̱r.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yiëëth mi ci bath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.7",
            "verseOrgIds": [
              "LUK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ ciek in mith mi tekɛ yio̱w da̱ŋ wäl, kä ci kɛl bath, /cɛ lɛmbärɛ bi dɔp kä bɛ duel yiɛc, kä bɛ jɛ go̱r agɔaa, amäni mi cɛ jɛ jek? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cɛ jɛ jek, bɛ mäthnikɛ kɛnɛ ji̱ thieekädɛ cɔl, kä bɛ kɛ jiök i̱, ‘A lo̱ckun tɛth kɛ ɣä kɛɛl, kɛ ɣöö cä yiëëthdä mëë ci bath jek.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A cäŋ ɛ jɛn inɔ, ɣän la̱rä jɛ yɛ, ɛn ɣöö bɛ tekɛ tɛ̈th lɔaac nhiam ja̱a̱kni Kuɔth nhial kɛ kui̱ gua̱n duerä kɛl mi ci rɔ ri̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cäät gatdä mi ci bath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.10",
            "verseOrgIds": [
              "LUK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yecu wee i̱, “Tëëkɛ ram mi tekɛ gaat da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu gat in tɔt gua̱n jiök i̱, ‘Guä, kämni ɣä kui̱c ŋɔaani diaal tin bi a nyinkä.’ Kä cuɛ nyinkɛ dääk kä kamdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.12",
            "verseOrgIds": [
              "LUK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr ni̱ni ti tɔt cu gat in tɔt nyinkɛ diaal ruɔ̱ɔ̱l, kä cuɛ jiɛɛn, wëë ro̱o̱l mi na̱n. Cuɛ nyinkɛ wä ŋar ŋar kɛ lät ti jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci nyinkɛ diaal thuuk, cuɛ tekɛ buɔth mi di̱i̱t ɛn ro̱o̱l ɛmɔ, kä cuɛ jɛ tok kɛ mi go̱o̱rɛ ŋɔak. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wä cuɛ rɔ wä kök ram mi diel rööl ɛmɔ, mi cu jɛ jäkä rɛy ka̱a̱knikɛ kɛ ɣöö bɛ kuɔ̱ndhuɔ̱ɔ̱ri wä la̱a̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ go̱r ni mi derɛ cam ni ko̱m ŋɔa̱a̱ri tin cam kuɔ̱ndhuɔ̱ɔ̱ri kɛ. Kä cuɛ thil ram mi ci jɛ moc mi camɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.16",
            "verseOrgIds": [
              "LUK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cɛ wi̱cdɛ ku car agɔaa, cuɛ wee i̱, ‘Ji̱ la̱t gua̱a̱r a tekɛ kɛ mi̱th ti ŋuan ti doth tha̱a̱ŋkiɛn, kä li̱ewä kɛ buɔth wanɛ mɛ! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän bä jiɛɛn, bä wä kä gua̱a̱r, kä bä jɛ wä jiök i̱, “Guä, ɣän cä duer nhiam Kuɔth nhial, amäni nhiamdu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cä lɛ ŋot kɛ gɔɔy kɛ ɣöö ba ɣä cɔl i̱ gatdu. Ciɛŋ ɣä ce̱tkɛ raan kɛl kä la̱a̱tku.” ’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jiɛɛn, cuɛ ben kä gua̱n. Kä min ŋotdɛ kɛ na̱n, cu gua̱n ɛ nɛn. Cu lɔcdɛ thia̱a̱ŋ kɛ nhök. Cuɛ riŋ, kä cuɛ jɛ bom, kä ciimɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.20",
            "verseOrgIds": [
              "LUK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gatdɛ jɛ jiök i̱, ‘Ɣän cä duer nhiam Kuɔth nhial amäni nhiamdu. Ɣän /cä lɛ ŋot kɛ gɔɔy kɛ ɣöö ba ɣä cɔl i̱ gatdu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.21",
            "verseOrgIds": [
              "LUK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n ji̱ läätädɛ jiök i̱, ‘Wiaa, nöŋɛ bi̱i̱ in gɔaa ni jɛn kɛ pɛ̈th, kä la̱thɛ jɛ puɔ̱nydɛ. Kä kuëŋɛ tiɛl yiɛtädɛ kɛnɛ wa̱a̱ri ciöknikɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nööŋɛ ruath mi ci buuth kä na̱kɛ jɛ. Banɛ mi̱th, kä banɛ ŋar. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö gatdä ɛmɛ cɛ li̱w, kä cɛ rɔ nyɔk kɛ tëk. Cɛ bath, kä ca jek!’ Kä cu ŋar cu tok.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.24",
            "verseOrgIds": [
              "LUK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä täämɛ te gatdɛ min di̱i̱t rɛy kakä. Kä min bëë min cɛ thia̱k kɛ ciëŋ, cuɛ bul kɛnɛ duth liŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ ram kɛl kä ji̱ läätdä cɔl, cuɛ jɛ thiec kɛ mɔ lät rɔ mɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ jɛ loc i̱, ‘Ci dämuɔɔr ben, kä ci guur ruath mi ci buuth näk, kɛ ɣöö cɛ luny jɔk a puɔl puɔ̱nydɛ kä malɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.27",
            "verseOrgIds": [
              "LUK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu lɔcdɛ jiääk, kä cuɛ wä rɛc lo̱k. Kä cu gua̱n ben raar kä cuɛ jɛ läŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gua̱n loc i̱, ‘Guicɛ, ɣän cä ji̱ lätikä kɛ run ti ŋuan ce̱tkɛ kuany, kä /ka̱n ruacdu met lo̱k. Kä /keni ɣä met moc kɛ dɔdɛ̈ɛ̈l mi dee tɛɛth kɛ lo̱ckɔ kɔnɛ mäthnikä. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci gatdu mɛmɛ luny jɔk min ci ŋɔaku ŋar ŋar kɛ lëër, ci na̱k ni jɛ ruath mi ci buuth!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.30",
            "verseOrgIds": [
              "LUK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu gua̱n ɛ jiök i̱, ‘Gatdä, ti̱i̱ kɛɛl kɛ ɣä ni ciaŋ, kä ŋɔakä diaal kɛ nyinku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä banɛ ŋar kä bi lo̱ckun tɛɛth, kɛ ɣöö dämuɔɔr ɛmɛ, cɛ li̱w kä cɛ tëk, cɛ bath kä ca jɛ jek.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.32",
            "verseOrgIds": [
              "LUK.15.32"
            ]
          }
        }
      ]
    }
