          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ ɣän Nɛ-bu-kad-nɛ-dhar liakä Kuoth Nhial kä puanyä jɛ kä ka̱mä jɛ luth,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
