            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ci run tɔ̱tɔ̱ thuuk, ɣän Nɛ-bu-kad-nɛ-dhar, cua̱ nhial liɛc kä cu ciaaŋdä mëëdan luny kä ɣä.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
