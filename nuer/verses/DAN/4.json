          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn gua̱a̱th ɛ mɔ, ɣän cua̱ loc ciɛɛŋädä, kä cua gɔɔy ciɛɛŋädä kɛnɛ wuɔ̱tdä amäni buɔ̱m kuäärädä luɔ̱c ɣä. Kä cu luëëkä kɛnɛ ruëëckä luäkdä nyɔk kɛ gör, cua̱ loc wi̱i̱ kɔam kuäärädä, kä cua ɣä nyɔk kɛ mät luth mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
