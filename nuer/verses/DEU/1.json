  "bookId": "DEU",
  "reference": "Ŋuɔ̱T 1",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "DEU 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jiɛɛn kä Thi-nay",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ ruaacni tëë ci Muthɛ kɛ la̱t ji̱ I-thɛ-rɛl diaal kui̱ Yieer Jɔr-dɛn däär dɔaar kä Ä-ra-ba lotdä Cup, kam Pa-ran kɛnɛ To-pɛl kɛ La-ban kɛ Ɣä-dhe-rot, kɛ Di-dha-ɣab. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.1",
            "verseOrgIds": [
              "DEU.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ kam mi ja̱lkɛ kɛ ni̱n wäl kɛl kɛ jiɛɛndu kä Thi-nay kɛ duɔ̱p wi̱i̱ni rööl päämni Ɛ-dɔm wädu kä Ka-dɛc-bar-ni-ya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.2",
            "verseOrgIds": [
              "DEU.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ cäŋ in jio̱liɛn kä pay wäl kɛl kä ruɔ̱n jiɛɛn ŋuaan kɛ kɔr kä mëë cikɛ jiɛɛn kä I-jëp, cu Muthɛ ruac kɛ ji̱ I-thɛ-rɛl diaal kɛ tëë diaal tëë ca la̱t jɛ ɛ Kuoth Nhial kɛ kui̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.3",
            "verseOrgIds": [
              "DEU.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kɔr kä mëë cɛ Thi-yon joc kuäär ji̱ Ɛ-mor mëë cieŋ kä Ɛc-bon, kɛnɛ Ög kuäär Ba-can min cieŋ kä Ac-ta-roth kɛnɛ Ɛ-dhɛ-ri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.4",
            "verseOrgIds": [
              "DEU.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ ŋuɔ̱t ti̱ti̱ luk nhiam Yieer Jɔr-dɛn, muun Mo-ab, wëë i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.5",
            "verseOrgIds": [
              "DEU.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ci Kuoth Nhial ni Kuoth kɔn jiök kä Thi-nay i̱, ‘Cia cieŋ ɛlɔ̱ŋ ɛn pääm ɛ mi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.6",
            "verseOrgIds": [
              "DEU.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ri̱tdɛ rɔ wiaa päämni ji̱ Ɛ-mor kɛnɛ ji̱ thieekädiɛn kä Ä-ra-ba, wiaa wi̱i̱ni dhuɔ̱li kɛnɛ wi̱i̱ tin te täpni amäni Nɛ-gɛb kɛnɛ thok yieer, amäni mun ji̱ Kɛ-naan, kɛ Lɛ-ba-nɔn a räth ni Kiir in di̱i̱t kir Yu-pɛ-ree-tidh. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.7",
            "verseOrgIds": [
              "DEU.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛ̈nɛ jɛ ɣän cä mun jak kä te nhiamdun, wiaa muɔcɛ rɔ muɔ̱ɔ̱n ëë ci Kuoth Nhial ɛ ya̱c guurikun, ni A-bɛ-ram, Ay-dhɛk. Kɛ Je-kɔb i̱ bɛ ka̱mkɛ amäni kuaykiɛn.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuëny Muthɛ kɛ bööth thuk duëli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä niɛ guäth ëë jiökä yɛ thi̱n i̱, ‘/Cä yɛ bi luäŋ kɛ ruec kä rɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.9",
            "verseOrgIds": [
              "DEU.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial Kuothdun yɛ jak kä ŋuan, kä nɛ̈nɛ jɛ ɛn täämɛ ce̱t yɛn nikɛ kuɛl nhial kɛ ŋuan. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.10",
            "verseOrgIds": [
              "DEU.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A Kuoth Nhial kuoth guuri yɛ jak kä kur bathdɔɔri, kä bɛ yɛ poth ce̱tkɛ mëë cɛ la̱r yɛ! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.11",
            "verseOrgIds": [
              "DEU.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän dëë riɛkdun luäŋ kɛ ɣa̱c i̱di ɣän kä rɔ kɛnɛ löökun? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.12",
            "verseOrgIds": [
              "DEU.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuanyɛ nɛy ti pɛl kä tekɛ ŋäc thuk duëlikun bäkɛ jak kä bööthkun.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.13",
            "verseOrgIds": [
              "DEU.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ ɣä loc i̱, ‘Mi ci la̱t nɛy ɛ gɔaaɛ ba̱kɔ la̱t’. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.14",
            "verseOrgIds": [
              "DEU.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua̱ bööth dho̱rikun ka̱n, nɛy ti pɛl kä te ŋäc, cua̱ kɛ jak kä bööthkun, bööth nɛɛni ti bathdɔɔr, kɛnɛ nɛy ti kuɔ̱r kɛ nɛy ti jiɛɛn dhieec kɛ bööth nɛɛni da̱ŋ wäl. Kɛ ŋi̱eec thuk duëlikun gua̱thni diaal.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.15",
            "verseOrgIds": [
              "DEU.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.15",
            "verseOrgIds": [
              "DEU.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä cua̱ kua̱r luɔ̱ɔ̱knikun jiök ɛn guäth ëëdan i̱, ‘Liɛŋɛ rɔ kamnikun kɛ dämuɔɔri, kä luɔkɛ raan kɛnɛ däman a päär kiɛ kɛnɛ ram mi juɔ̱r in te wi̱c. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.16",
            "verseOrgIds": [
              "DEU.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu guic ni ta̱a̱ nath rɛy luɔ̱k, liŋ ram mi tɔt kɛnɛ ram mi di̱i̱t a päär. Cu dual kɛ waŋ ran, kɛ ɣöö luk ni Kuoth. Kä luk mi wä ji̱ dhal nöŋ ni jɛ ɣä, bä ben liŋ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.17",
            "verseOrgIds": [
              "DEU.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn wa̱nɔ bä ji̱ cu la̱t tin diaal tin bi la̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jäkni liemni kä raar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä cua̱ kɔ jiɛɛn kä Thi-nay ja̱lkɔ där dɔaar in bɛc bɛc ëë cia nɛn dup pa̱a̱m wec ji̱ Ɛ-mor, ce̱tnikɛ mëë ci Kuoth Nhial ni Kuothdan ɛ la̱rkɔn kä cu kɔn ben kä Ka-dɛc-bar-ni-ya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.19",
            "verseOrgIds": [
              "DEU.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ la̱r yɛ i̱, ‘Cia ben pääm wec ji̱ Ɛ-mor, min ci Kuoth Nhial Kuothdan ɛ ka̱m kɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.20",
            "verseOrgIds": [
              "DEU.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛ̈nɛ jɛ, ci Kuoth Nhial Kuothdun yɛ ka̱m mun, wiaa muɔcɛ rɔ gua̱th ce̱tkɛ min ci Kuoth Nhial Kuoth guuri jɛ la̱r yɛ. /Cuarɛ dual kä a yɛ /cɛ la̱th.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä /cuarɛ ben kä ɣä yɛn diaal laar yɛnɛ i̱, ‘Ja̱knɛ naath ti ba kɔn wä liem wec, kä ba kɔn, wä nöŋ ruac duɔ̱p in bi wä kɛ kɔn, duɔ̱p in bi cop kɛ kɔn wi̱c in wanɛ thi̱n.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cua mi gɔaa kɛ ɣä, ɛ cua̱ wutni da̱ŋ wäl rɛw ka̱n kä yɛ, ram kɛl thok duëël ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ wä wi̱i̱ni tin te päämni kä cukɛ ben lo̱o̱lä Ɛc-kol liɛmkɛ jɛ bä. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cukɛ dɛy jiɛɛn muɔ̱ɔ̱n ɛ mɔ nöŋ nɛy kɛ tetkiɛn, kä cukɛ ruac nööŋ bä laarkɛn ɛ i̱, ‘Ɛ mun mi gɔaa ci Kuoth Nhial Kuothdan ɛ ka̱m kɔn ɔ.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cia ŋot cia wä thi̱n luäŋ. Cu duŋdun ɛ ɣöö lökɛ ruac Kuɔth Nhial Kuothdun. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakɛ rɛy kɛmɛnikun laar yɛnɛ i̱, ‘Kɛ ɣöö lo̱k Kuoth Nhial nɛy ɛ jɛn cɛ kɔ nööŋ raar muun I-jëp, a bɛkɔ ben la̱th tetni ji̱ Ɛ-mor kɛ ɣöö bakɔ ben däk.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ winith kua̱kɔ lɛ wä thi̱n ɔ? Kä gaat mari ca lo̱ckɔ jak kä bath laar kɛn ɛ i̱, ‘Kɛ nɛy ti ba̱r ba̱a̱r kä bumkɛ kä kɔn. Kä tekɛ kɛ ti̱ec ti buɔ̱m buɔ̱ɔ̱m ti räth ni puɔ̱rä. Kä cakɔ gaat ji̱ Ä-nak nɛn ɛn wi̱ni.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jɛn cua̱ yɛ jiök i̱, ‘/Cuarɛ dual kɛ kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi Kuoth Nhial Kuothdun in jäl nhiamdun ko̱run tɛ̈r, ce̱tnikɛ mëë cɛ jɛ lät kä yɛ nhiamdun kä I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ce̱tkɛ mëë ciɛ nɛn däär dɔaar ɛn ɣöö ci Kuoth Nhial Kuothdun yɛ kap, ce̱tkɛ min la raan gatdɛ a kap, rɛy dupni diaal tëë cia jäl amäni cuɔ̱pdun ɛn wa̱nɛ.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ ŋuɔ̱tdɛ /cia Kuoth Nhial Kuothdun ŋäth, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "mëë wä nhiam kɛ ɣöö bɛ yɛ jëk gua̱a̱th mi bia pua̱t thi̱n. Kä ɛ mac kɛ wäär mi nyuth yɛ duɔ̱p in bi wä kɛ yɛ, kä ɛ pua̱r kɛ cäŋ däär.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duäc Kuɔth Nhial kɛ I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ci Kuoth Nhial ruacdun liŋ a cɛ gaak, kä cɛ rɔ yac i̱, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Thilɛ ram kɛl kä kɛn ri̱c ɛ jiäk ɛmɛ mi bi mun agɔaa ɛ mi nɛn mëë ca ya̱c guuri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ni Ka-leb gat Yɛ-pö-nɛ bi jɛ nɛn ɔ. Kä bä jɛ ka̱m mun ëë cɛ jäl kɛnɛ gaatkɛ, kɛ ɣöö cɛ Kuoth Nhial guɔ̱ɔ̱r kɛ lɔcdɛ kɛ li̱w!’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci Kuoth Nhial lɔcdɛ jiääk kɛ ɣä kɛ kui̱dun a cɛ ɣä jiök i̱, ‘/Ci mun ɛ mɔ bi nɛn bä.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Jɔ-cua gat Nun ɛ te nhiamdu mi bɛ jɛ nɛn, bumɛ kɛ ɣöö bɛ ji̱ I-thɛ-rɛl jak kä ka̱nkɛ mun ɛmɔ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä gaatkun tin cɔl yɛn kɛ i̱ pɛ̈ɛ̈c kɛnɛ dho̱li tin kueckɛ mi gɔaa kɛnɛ mi jiääk bikɛ wä thi̱n, kä bä ka̱mkɛ, kä ba duŋdiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä yɛn rietdɛ rɔ dup Bar in Tith däär dɔaar ja̱lɛ jɛ.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ ɣä loc i̱, “Cakɔ Kuoth Nhial dui̱rikä. A kɔn ba̱kɔ wä ko̱o̱r ce̱tkɛ min ci Kuoth Nhial Kuothda jɛ la̱r kɔ. Kä cu ramɔ rɔ yuɔr ni yio̱o̱nikɛ, ce̱tdɛ kɛ mi thia̱kɛ ɛn wä wi̱i̱ni pa̱a̱m. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial ruac kɛ ɣä, jio̱knikɛ i̱, ‘/Cuarɛ wä ko̱o̱r, kɛ ɣöö ci ɣän te rɛydun, amäni mi dëë gua̱n tɛ̈r yɛ joc.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua ruac kɛ yɛ, kä /ken yɛn ɛ liŋ. Cu yɛn lo̱k ni ruac Kuɔth Nhial /cuarɛ wä wi̱i̱ni pa̱a̱m ce̱t tëë kɛ mi ŋäc yɛn ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu ji̱ Ɛ-mor tëë cieŋ wi̱i̱ni päämni ben kä yɛ cua yɛ joc ce̱tkɛ min la tuaar naath a jooc, cua yɛ näk ni kä The-ir cu mäni Ɣɔr-ma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cuarɛ luny nhiam Kuɔth Nhial kɛ wiee duundɛ ɣöö /ken Kuoth Nhial jɔwdun liŋ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "/cuarɛ te kä Ka-dɛc kɛ ni̱n ti ŋuan.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
  ],
