            "verseOrgIds": [
              "DEU.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ lɔcdu /ci di̱t kɛ ciek gua̱n thieekädu, ɛ lɔcdu /ci di̱t kɛ duŋ gɔaal radɔ̱diɛn, kiɛ kaakdɛ, kiɛ kuanydɛ, thääkdɛ kiɛ mulɛ kiɛ mi la duŋ gua̱n thieekä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
