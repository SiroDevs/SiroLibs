          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cu gua̱n thieekädu naŋ luɔm kɛ kac.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.20",
            "verseOrgIds": [
              "DEU.5.20"
            ]
          }
        }
      ]
    },
