              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä tiɛtdɛ jɛ yɛn ɛn ɣöö bia kɛ la̱t ce̱tnikɛ min ci Kuoth Nhial Kuothdun ɛ la̱r yɛ. /Cuarɛ rɔ cak riet caam kiɛ cuëëc. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luɔ̱kɛ ni duɔ̱ɔ̱p in ci Kuoth Nhial Kuothdun ɛ la̱r yɛ, kɛ ɣöö bia cu tëk, bɛ cu gɔaa kɛ yɛ, kä bi ni̱nkun ŋuan wi̱i̱ muɔ̱ɔ̱n in bia wä cieŋ thi̱n.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
    }
