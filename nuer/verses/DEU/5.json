    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luëëk da̱ŋ wäl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Muthɛ ji̱ I-thɛ-rɛl diaal cɔl, kä cuɛ kɛ jiök i̱, “Luëëk ti la̱tdä yɛ ti lö ji̱ I-thɛ-rɛl kɛ ɣöö bia kɛ ŋa̱c kä tiɛtdɛ ciɛŋkiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuoth Nhial Kuothdan cɛ guk la̱t kɛ kɔn kä Thi-nay. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cikɛ gua̱nikɔn kɛn tëë lät Kuoth Nhial guk kɛ kɛ, lätdɛ jɛ kɛ kɔn, kä kɛ kɛn kɔn diaal tëk ɛn walɛ ti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuoth Nhial cɛ ruac kɛ yɛ nhiam kɛ nhiam däär maac wi̱i̱ pa̱a̱m, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "guäth ëë ta̱a̱ kamdun kɛ Kuoth Nhial, mëë la̱tdä yɛ ruacdɛ. Mëë dual yɛn kɛ mac, mëë /ka̱nɛ wä nhial wi̱i̱ pa̱a̱m. Wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɛ ɣän Kuoth Nhial Kuothdu, mëë käm ji̱ raar muun I-jëp, duëël yieenä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
            "verseOrgIds": [
              "DEU.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
            "verseOrgIds": [
              "DEU.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cuarɛ tekɛ kuoth mi dɔ̱diɛn nhiamdä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“/Cuarɛ rɔ täth kuoth jiɛn, ti cäät kɛ duɔ̱ɔ̱r puɔ̱rä Nhial, kiɛ mi cäät kɛ duɔ̱ɔ̱r wi̱i̱ muɔ̱ɔ̱n piny, kiɛ rɛy pi̱i̱ni piny muɔɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cuarɛ rɔ goŋ kɛ kɛ kiɛ bia kɛ pal. Kɛ ɣöö ɣän Kuoth Nhial Kuothdu ɛ ɣän gua̱n tiilä, mi la dueer gua̱ni gan a käm gaatkiɛn amäni ri̱c in diɔ̱ɔ̱kdiɛn kɛnɛ ŋuaandiɛn, kä nɛy tin lökä. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä la nhök mi thil pëk a nyuɔ̱thä tin nhɔakɛ ɣä kä tiɛtkɛ luëëkä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä /cu ciötdä cɔl baŋ. Kɛ ɣöö cä dueer raam in cɔl ciötdä baaŋ bi päl.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tit cäŋ lɔ̱ŋä, ɛ cäŋ mi rɛl rɔ ce̱tkɛ min cä la̱r ji̱ ɣän Kuoth Nhial Kuothdu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ni̱n bäkɛl bi lätku diaal la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ bärɔw ni̱ni ɛ cäŋ lɔ̱ŋä mi ca leyä, ɣän Kuoth Nhial Kuothdu. Thilɛ la̱t mi bia la̱t thi̱n. Ji̱n kiɛ gatdu kiɛ nyaadu, kiɛ läätdu, kiɛ thääkdu, kiɛ mulu kiɛ duɔ̱ɔ̱r kä ɣɔ̱ɔ̱ku, kiɛ ram mi cieŋ kɛɛl kɛ ji̱. Bi la̱a̱tku lɔ̱ɔ̱ŋ ce̱tkɛ mɔ ti̱i̱ ɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä titdɛ ɛn ɣöö cikɔn ɛ kuany muun I-jëp, ɛ Kuoth Nhial Kuothdu käm ji̱ raar thi̱nɔ kɛ tet mi bum, kɛ kui̱ ɛmɔ Kuoth Nhial Kuothdu jiökɛ ji̱ i̱, tit cäŋ lɔ̱ŋä.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
