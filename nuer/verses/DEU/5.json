            "number": "16",
            "style": "v",
            "sid": "DEU 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Luthni guur kɛnɛ muɔɔr, ce̱tkɛ min cä lär ji̱ Ɣän Kuoth Nhial Kuothdu, dɔ̱ɔ̱ bi ni̱nku jääny wi̱i̱ muɔ̱ɔ̱n, dɔ̱ɔ̱ bɛ gɔaa kɛ ji̱ muun in cä Ɣän Kuoth Nhial Kuothdu ka̱m ji̱.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        }
      ]
    },
