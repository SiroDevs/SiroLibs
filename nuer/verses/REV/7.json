          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua pek nath tin ca moc biɛl liŋ, kɛ bathdɔɔri ti kuɔ̱r kɛl wi̱cdɛ jiɛn da̱ŋ ŋuan wi̱cdɛ ŋuan (144,000), kä döör gan I-thɛ-rɛl diaal.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        }
      ]
    },
