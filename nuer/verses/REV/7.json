          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.8",
            "verseOrgIds": [
              "REV.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mɛmɛ cua guic, kä nɛnɛ, tëëkɛ buɔ̱n nath mi di̱i̱t ɛlɔ̱ŋ mi thilɛ ram mi dee kɛ luäŋ kɛ kuën, bäkɛ röli kɛnɛ döör diaal, kɛ nɛy diaal, kɛnɛ ji̱ thukni diaal ti gööl, cuŋkɛ nhiam kɔam kuäärä kɛnɛ Ruath Dɛ̈ɛ̈l, ciaŋkɛ bieyni ti bo̱o̱r, kä te tetkiɛn kɛ kar kaanä. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ wiee kɛ jɔw mi di̱i̱t i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.12",
            "verseOrgIds": [
              "REV.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ram kɛl kä di̱t ɣä thiec i̱, “Kɛ ŋaani, kɛn ti ciaŋkɛ bieyni ti bo̱o̱r ti, kä bäkɛ nikä?” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jɛ loc i̱, “Kuäär, ŋäc kɛ ji̱n.” Kä cuɛ ɣä jiök i̱, “Ti̱ti̱ kɛ kɛn nɛy tin pay ben raar rɛy rikä min di̱i̱t. Cikɛ bieynikiɛn lak, kä ci kɛn kɛ jakä buɔy kɛ riɛm Ruath Dɛ̈ɛ̈l.",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.14",
            "verseOrgIds": [
              "REV.7.14"
            ]
          }
        }
      ]
