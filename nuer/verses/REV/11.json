    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nëën da̱ŋ rɛw",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua ɣä ka̱m taŋ thëm mi ce̱tkɛ kɛɛt, kä cua ɣä jiök i̱, “Wër, thɛm luak Kuɔth kɛnɛ yi̱k, kä kuɛn nɛy tin pal thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cu kal luaak Kuɔth in te raar thɛm, päl ɛ, kɛ ɣöö ca jɛ ka̱m döör, kɛ ɣöö bikɛ wec in rɛl rɔ dɔany kɛ päth ti jiɛn ŋuan wi̱cdɛ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä nëënkä da̱ŋ rɛw ti ca rɔ rony kɛ bieyni cuali ka̱m buɔ̱m kɛ ɣöö bikɛ ruac Kuɔth lat kɛ ni̱n ti bathdɔɔr kɛl wi̱cdɛ kur rɛw wi̱cdɛ jiɛn bäkɛl.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn nëën da̱ŋ rɛw ti̱ti̱ kɛ jiɛn Ɔ-lip da̱ŋ rɛw kɛnɛ cuuŋni lɛmbärni da̱ŋ rɛw tin cuŋ nhiam Kua̱r ni Kuoth piɛny. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi tëëkɛ ram mi go̱o̱r ɣöö bikɛ moc riɛk, bä mac raar thokdiɛn, kä waŋkɛ ji̱ tɛriɛn. Ram ɔ bikɛ moc riɛk ɔ ba jɛ näk kɛ jɛn duɔ̱ɔ̱p ɛmɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tekɛ kɛ lua̱ŋ kɛ ɣöö ba pua̱a̱r gäk, kɛ ɣöö /ci nhiaal bi dɛ̈m kɛ ni̱n tin lat kɛn ɛ ruac Kuɔth, kä tekɛ kɛ lua̱ŋ kɛ ɣöö dëë pi̱ loc ni riɛm, kɛnɛ ɣöö dëë wi̱c muɔ̱ɔ̱n duäc kɛ rik diaal, ce̱tkɛ gua̱a̱th in go̱o̱r kɛn ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wäkɛ nëndiɛn wä thuk kɛ lat, bi ley in bä raar kɔ̱kä mi thil piny nyiëëny kɛ kɛ. Bɛ kɛ puɔ̱t kä bɛ kɛ näk, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bi ri̱ŋkiɛn te piny dup wec in di̱i̱t guäth ëë ca Kuääriɛn ni Kuoth kɔŋ pua̱t jiaath thi̱n. Kä ciöt wec ɛmɔ ce̱tdɛ kɛ Thɔ-dɔm kiɛ I-jëp. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ni̱n da̱ŋ diɔ̱k kɛ nuth, cu wutni tin te rɛy nath, kɛnɛ döör, kɛ thuk ti gööl, kɛ thuk duëli, pua̱nykiɛn tin ci li̱w di̱el guec, kä lökɛ ɣöö ba kɛ kony. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi ji̱ wec muɔ̱ɔ̱n lo̱ckiɛn tɛɛth kɛ lia̱a̱diɛn kɛn da̱ŋ rɛw. Kä muɔckɛ rɔ̱ kɛ muc, kɛ ɣöö kɛn göök da̱ŋ rɛw ti̱ti̱ cikɛ riɛk mi di̱i̱t nöŋ ji̱ wec muɔ̱ɔ̱n.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr ni̱ni da̱ŋ diɔ̱k kɛ nuth cu yiëë teekä mi bä kä Kuoth coth rɛydiɛn, kä cukɛ rɔ̱ jiëc cuɔ̱ŋ, kä cu dual mi di̱i̱t ben kä nɛy ti ca kɛ nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kɛn jɔw mi di̱i̱t liŋ nhial, jio̱kɛ kɛ i̱, “Bia nhial wanɛ mɛ!” Kä cukɛ wä nhial kɛ pua̱r a guic ji̱ tɛ̈riɛn kɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn guäth ɛmɔ cuɛ tekɛ lath piɛny mi di̱i̱t, kä cu kui̱c wec in wäliɛn tɛɛth. Cu nɛy ti bathdɔɔri da̱ŋ bärɔw näk ɛ lath piɛny, kä cu duɔth nath dual ɛlɔ̱ŋ, kä cukɛ Kuoth puɔ̱ɔ̱rä liak.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci riɛk in rɛwdɛ thuuk. Kä bi riɛk in diɔ̱ɔ̱kdiɛn ben kɛ pɛ̈th.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaaŋ in bärɔwdiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu jääk nhial in bärɔwdiɛn kaaŋdɛ koth, cuɛ tekɛ jɔw mi di̱i̱t nhial, wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu di̱t tin jiɛn da̱ŋ rɛw wi̱cdɛ ŋuan tin nyuur wi̱i̱ kɔamni kuäärädiɛn nhiam Kuɔth wuɔ̱thkiɛn yiath piny, kä cukɛ Kuoth pal, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
            "verseOrgIds": [
              "REV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "cukɛ di̱t kɛt i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
