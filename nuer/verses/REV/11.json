          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua luaak Kuɔth in te nhial lɛp, kä cua thanduk matdä ruac Kuɔth nɛn rɛy luaakdɛ. Kä cuɛ tekɛ yiel kɛnɛ wuɔ̱w mi di̱i̱t, kɛ ma̱a̱r kɛnɛ lath piɛny, kɛ nhiaal guiyni mi di̱i̱t.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.19",
            "verseOrgIds": [
              "REV.11.19"
            ]
          }
        }
      ]
    }
