              "REV.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä gɔ̱ri nɛmɛ jääk nhial in te dueel Kuɔth kä Thay-tay-ra i̱, ‘Ti̱ti̱ kɛ rieet Gatdä Kuɔth, min tekɛ wäŋ ti bo̱l ce̱tkɛ mac, kä ce̱t ciökɛ kɛ ciɛk in yian mi ca toth.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ɣän ŋa̱cä lätkun, nhökdun, ŋa̱thdun kɛnɛ ciaaŋ la̱tdun, amäni ruɔ̱tdun kɛ ŋɔaani bitdä. Kä ŋa̱cä jɛ ɛn ɣöö lätkun tin jɔak lënykɛ lät tëë nhiam. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä dɛ̈ɛ̈cä nɛmɛ kä yɛ, ɛn ɣöö cia I-dhɛ-bɛl pa̱l ŋi̱i̱cdɛ, ɛn ciek in cɔl rɔɔdɛ i̱ gök. Cɛ nɛɛkä mɛt, kɛ ŋi̱i̱cdɛ kɛ ɣöö bikɛ nyin leerä la̱t kɛnɛ mi̱ethdiɛn kɛ mi̱th ti ca thöp kuth jiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cä jɛ moc gua̱a̱th kɛ ɣöö bɛ rɔ ri̱t kä jiäkɛ, kä duundɛ ɣöö lo̱kɛ riet kɛ rɔ kä leerɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛnɛ, bä jɛ moc kɛ juey, kä bä nɛy tin ca nyin leerä kɛ la̱t jɛ kɛɛl yuɔr rɛy rikä mi bɛc bɛc. Ɛ ni mi pa̱lkɛ lätkɛ tin jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä gaatkɛ näk. Kä bi duël Kuɔth diaal ɛ ŋa̱c ɛn ɣöö ɛ ɣän ram mi go̱o̱r ni lɔc ran kɛnɛ ca̱rɛ. Kä bä ram ɔ cuɔ̱l min lat rɔ kɛ lätkun. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ kui̱dun, yɛn nɛy tin te kä Thay-tay-ra tin /ka̱nɛ ŋi̱i̱c ɛ jiääk ɛmɛ guɔ̱ɔ̱r, yɛn /ka̱n nɛmɛ ŋa̱c min cɔɔl nɛy tin kɔ̱ŋ jɛ i̱ “pɛl Cɛy-tan,” ɣän cä lar ɛn ɣöö /cä yɛ bi lɛ moc riɛk dɔ̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka̱pɛ min tekɛ yɛ a bum, amäni mi cä luny jɔk. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram mi ti̱em kä lät lätkä amäni guut ɣɔaa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        }
      ]
    }
