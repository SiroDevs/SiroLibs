    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ja̱a̱k kɛ rik da̱ŋ bärɔw tin jɔak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua nyuuth dɔ̱diɛn mi di̱i̱t mi gääy naath nɛn nhial, tëëkɛ ja̱a̱k nhial da̱ŋ bärɔw kɛ rik da̱ŋ bärɔw, tin la rik tin jɔak, kä bi waŋ lɔaac Kuɔth thuuk kɛ kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua mi ce̱tkɛ bar mi ti̱l ti̱l mi ca lia̱a̱p kɛ mac nɛn. Kä cua nɛy tin ca ley kɛnɛ cätdɛ puɔ̱t, kɛ pek cio̱tädɛ cuŋä gëëkni bar in ti̱l ti̱l, a te thuɔmni Kuɔth tetnikiɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ dit Muthɛ min la ja̱ŋ Kuɔth, kɛnɛ dit Ruath Dɛ̈ɛ̈l, wäkɛ i̱,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä mɛmɛ cua guic kä ca luak Kuɔth in la kɛmɛ nenä in te nhial lɛp. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ja̱a̱k nhial da̱ŋ bärɔw tin nööŋkɛ rik da̱ŋ bärɔw ben raar luaak Kuɔth, ca rɔ rony kɛ bieyni ti buɔy ɛ pak, kä ca kathkiɛn yiɛn kɛ läk dääpä. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ley kɛl kä ley da̱ŋ ŋuan tin tëk ja̱a̱k nhial da̱ŋ bärɔw ka̱m thääk dääpä da̱ŋ bärɔw ti thiäŋ kɛ waŋ lɔaac Kuɔth, min tëk kɛ tëk mi do̱raar. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu luak Kuɔth thia̱a̱ŋ kɛ tol gɔɔyä puɔnyä Kuɔth kɛnɛ buɔ̱mdɛ, kä thilɛ ram mi dee wä rɛc amäni mi ci rik da̱ŋ bärɔw tin nööŋkɛ ɛ ja̱a̱k nhial da̱ŋ bärɔw thuuk.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        }
      ]
    }
  ],
