      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ ɣän Thay-mɔn Pi-tɔr in la läät kä jak Yecu Kritho, gɔ̱a̱rä yɛ warɛgak ɛmɛ, yɛn nɛy tin ci ŋa̱th mi gɔaa mi ce̱tkɛ ŋa̱thda jek kɛ ciaŋ cuŋni Kuɔthdan kɛnɛ Käändan ni Yecu Kritho.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A puɔ̱th kɛnɛ mal mi di̱i̱t tekɛ yɛ rɛy ŋäcä Kuɔth kɛnɛ Yecu in la Kuääran.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciöt kɛnɛ kuëny",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä buɔ̱m kuoothä Kuɔth cɛ kɔn ka̱m ti diaal tin görnɛ kɛ kui̱ teekä ŋäthä mi thuɔ̱k kɛ ŋäcdan kɛ ram in cɔɔl kɔn kɛ buaydɛ kɛnɛ gɔɔydɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.3",
            "verseOrgIds": [
              "2PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɛn muc ti̱ti̱ cɛ kɔn ka̱m mi di̱i̱t kɛnɛ muc tin di̱t gɔɔydiɛn ɛlɔ̱ŋ tin cɛ la̱r kɔn. Kɛ ɣöö kɛ kɛ dee yɛn kään kä nyuɔɔn in te wi̱i̱ muɔ̱ɔ̱n, min bä kɛ kui̱ di̱tdä lɔaac kɛ ti jiäk, kä dɔ̱ŋ dee yɛn te nyuaakä ciɛɛŋä Kuɔth in rɛl rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.4",
            "verseOrgIds": [
              "2PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ la̱tdɛ a bum kɛ ɣöö bia ŋa̱thdun rep kɛ ciaŋ mi gɔaa, kä bia ciaŋ mi gɔaa rep kɛ ŋäc ŋɔaani, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.5",
            "verseOrgIds": [
              "2PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bia ŋäc ŋɔaani rep kɛ ruɔ̱t lɔaac, kä bia ruɔ̱t lɔaac rep kɛ dhieel, kä bia dhieel rep kɛ ciaŋ luthä mi gɔaa, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.6",
            "verseOrgIds": [
              "2PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bia ciaŋ luthä mi gɔaa rep kɛ gɔɔydun kɛ gaatmuɔɔri, kä bia gɔɔydun kɛ gaatmuɔɔri rep kɛ nhök. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.7",
            "verseOrgIds": [
              "2PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi te ŋɔaani ti̱ti̱ rɛydun kä rëpkɛ rɔ̱ agɔaa, ba yɛ luäk kɛ ɣöö bi yɛn a nɛy ti gɔw ti tekɛ dɛy rɛy ŋäcä Kua̱ran ni Yecu Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.8",
            "verseOrgIds": [
              "2PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ram mi dak ŋɔaani ti̱ti̱ kä jɛ dak guecdɛ, kä ɛ cɔr, kä cɛ jɛ pa̱l ruëëc ɛn ɣöö ca jɛ lak kä dueerkɛ tëë kɔn. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.9",
            "verseOrgIds": [
              "2PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, dämaari, ɣɔ̱a̱nɛ jɛ ɛlɔ̱ŋ ɛn ɣöö bia ciötdun kɛnɛ mëkdun kä Kuoth jakä thuɔ̱k, kɛ ɣöö mi wä yɛn ɛ la̱t /cia kɔ̱th bi kɔ̱thikä. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.10",
            "verseOrgIds": [
              "2PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ jɛn duɔ̱ɔ̱p ɛmɔ ba yɛ moc cuɔ̱ɔ̱ŋ kɛ ɣöö bia wä rɛy Kuäärä Kua̱ran kä Käändan ni Yecu Kritho mi do̱raar.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.11",
            "verseOrgIds": [
              "2PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ göörä jɛ ɛn ɣöö bä yɛ la ti̱emä ŋɔaani ti̱ti̱, a cäŋ ŋäc yɛn kɛ ni wen, kä ca yɛ yiath piny a bum rɛy thukä min bä kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.12",
            "verseOrgIds": [
              "2PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caarä jɛ ɛ cuɔ̱ɔ̱ŋ kä ɣä ɛn ɣöö bäkɛ ti̱em yɛ min ŋuɔtdä kɛ tëk. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.13",
            "verseOrgIds": [
              "2PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋa̱cä jɛ ɛn ɣöö bä puɔ̱ny ɛmɛ ba̱ny piny ce̱tnikɛ min ci Kuääran ni Yecu Kritho jɛ la̱r ɣä a jɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.14",
            "verseOrgIds": [
              "2PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä jɛ ɣɔ̱n ɛn ɣöö dee yɛn ŋɔaani ti̱ti̱ lɔ̱ tim gua̱thni diaal kɛ kɔr li̱ethdä.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nëën waŋ buɔyä Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.15",
            "verseOrgIds": [
              "2PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë la̱rkɔ yɛ buɔ̱m benä Kua̱ran ni Yecu Kritho, /ci nɛy lät ni yɛ cäätni pɛlä ti ca la̱t ɛ raan. Kä duundɛ ɣöö kɔn cakɔ di̱t Yecu nɛn kɛ wäŋkɔ pa̱ny. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.16",
            "verseOrgIds": [
              "2PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö cɛ luth kɛnɛ wuɔ̱t jek kä Kuoth in la Gua̱n, mëë ci jɔw Kuɔth ruac kɛ jɛ kɛ buaydɛ wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:17",
              "type": "text"
            },
            {
              "text": "Diit 2:7, Tuk 22:2, Ica 42:1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nɛmɛ ɛ jɛn Gatdä min nhɔakä, in tɛth lɔcdä kɛ jɛ.” ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɔn pua̱nykɔ cakɔ jɔw ɛmɔ liŋ min bëë nhial, mëë ta̱kɔ wi̱i̱ pa̱a̱m mi rɛl rɔ kɛ jɛ kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ruaacni göökni cu jakä thuɔ̱k kä kɔ. Gɔaa ɛ ɛn ɣöö bia ruac ɛmɛ dhil liŋ agɔaa, kɛ ɣöö ce̱tdɛ kɛ lɛmbär mi buɔy guäth mi col col, amäni mi ci ɣɔw baak kä ci cier bakä buay rɛy lo̱cnikun. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ nhiam kä ti diaal bia nɛmɛ dhil ŋa̱c, ɛn ɣöö thilɛ ruac go̱o̱kä buɔk mi la ruac mi lat gök ɛ kärɔa. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö thilɛ ruac go̱o̱kä mi ci met tuɔɔk kä raan, duundɛ ɣöö ɛ Yiëë in Gɔaa in Rɛl Rɔ ɛn min kämkɛ ruac Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
