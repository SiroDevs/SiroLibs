          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tiɛtdɛ jɛ, /cuarɛ jɛ dhɔt ɛn nɛmɛ. Ɛŋu bɛ tekɛ mi bi kuäär ya̱r ɔ?”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.22",
            "verseOrgIds": [
              "EZR.4.22"
            ]
          }
        }
