              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu pek kuakni diaal kuak dääpä kɛnɛ kuak cikä min bo̱r a bathdɔɔri dhieec wi̱cdɛ kur ŋuaan. Kɛn kuak ti diaal ti̱ti̱ cu Cec-bɛ̈-dhar kɛ nööŋ mëë jiɛc pɛ̈ɛ̈c kä Bɛ̈-bi-lɔn bendiɛn kä Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    }
