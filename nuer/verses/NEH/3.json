          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔriɛn cu Ben-ya-min kɛnɛ Ɣɛ̈-cub luɔt dho̱rikiɛn täth. Kä cu Ä-dhar-yaa gat Mä-the-yaa gat Ä-nan-yaa tääth gekä dhɔaarɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.23",
            "verseOrgIds": [
              "NEH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bi-nuwi gat Ɣe-na-dad kui̱c in dɔ̱ŋ täth ɛ känɛ jɛ ni dhɔr Ä-dhar-yaa a wä ni gukä cu mäni gɔŋtɔt, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.24",
            "verseOrgIds": [
              "NEH.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Pa-lal gat U-dhay tääth lotdä gɔŋtɔtdä kɛnɛ Cuut duëël kua̱r min thieek kɛ kal ga̱a̱ŋni. Kä kɛ kɔrɛ cu Pɛ-da-yaa gat Pɛ̈r-oc, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.25",
            "verseOrgIds": [
              "NEH.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ la̱a̱t luaak Kuɔth tin cieŋ kä O-pɛl tääth amäni luɔt Thuɔk Pi̱i̱ni min wä kui̱ känyä ca̱ŋ kɛnɛ Cuut in la gaŋkɛ ni luak Kuɔth.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ta̱a̱th tin kɔ̱kiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
