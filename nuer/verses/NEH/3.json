        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔriɛn cu ji̱ Tɛ-kowä kui̱c in dɔ̱ŋ täth min lot ni Cuut in di̱i̱t a räth ni pääny O-pɛl.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
            "verseOrgIds": [
              "NEH.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu bööth palä tääth ni nhial Thok Jio̱ŋko̱o̱ri täth ram ɔ a lotdɛ ni nhiam dhɔaarɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
              "NEH.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dha-dok gat I-mer tääth kɔɔriɛn lotdɛ ni nhiam dhɔaarɛ. Kä cu Cɛ-mɛ̈-yaa gat Cɛ-kɛ̈n-yaa yieen Thuɔk känyä ca̱ŋ tääth kɔɔrɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.29",
            "verseOrgIds": [
              "NEH.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ɣä-nɛ̈n-yaa gat Cɛ-lɛm-yaa kɛnɛ Ɣa-nun bäkɛl gan Dha-lɔp kui̱c in dɔ̱ŋ täth. Kä cu Mɛ-cu-lam gat Bɛ-rɛk-yaa kui̱c in lot ni dhɔrɛ täth. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.30",
            "verseOrgIds": [
              "NEH.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Mɛ̈l-ki-yaa tääth dääpä tääth a wä ni dhɔr la̱a̱tni luaak Kuɔth kɛnɛ köök min lot ni Thok Gueecni a räth ni duëël in te nhial gɔŋtɔtdä. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua jɛ la̱t amäni kam duëël in te nhial gɔŋtɔtdä kɛnɛ Thok Deet ɛ ta̱a̱th dääpä kɛ köök.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.32",
            "verseOrgIds": [
              "NEH.3.32"
            ]
          }
        }
      ]
