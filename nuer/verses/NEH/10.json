              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bakɔ duel kuakni Luaak Kuɔthda kɛnɛ bööth palä nöŋ muc bɛɛl kɛnɛ dɛy jiɛn diaal tin nhiam, kɛ kɔaŋ kɛnɛ liɛɛth. Kä bakɔ ji̱ Lii-bay nöŋ wa̱l wa̱a̱li bɛɛlkɔ, kɛ ɣöö kɛ ji̱ Lii-bay la kɛn tɔ̱ la ma̱a̱t kɛ kɛ tɔ̱ rɛy wi̱i̱nikɔ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
