              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ Dha-no-a kɛnɛ Ä-du-lam kɛ wi̱i̱kiɛn, kɛ La-kic kɛnɛ ka̱a̱kɛ kɛ Ä-dhe-ka kɛnɛ wi̱i̱kɛ. Cukɛ pua̱t nikä Ber-cɛ-ba cu mäni lo̱o̱l I-nɔm.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
