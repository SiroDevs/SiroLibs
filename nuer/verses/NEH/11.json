              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu nɛy ti ŋuan cieŋ wi̱i̱ni tin thieek kɛ ka̱a̱kiɛn, cu tha̱a̱ŋ ji̱ Juda cieŋ kä Kir-yath-ar-bä kɛnɛ wi̱i̱kɛ, kɛ Di-bon kɛnɛ wi̱i̱kɛ kɛ Yɛ-kab-dhel kɛnɛ wi̱i̱kɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cukɛ cieŋ wi̱i̱ni Yɛ-cuwä kɛnɛ Mo-la-dha kɛ Beth-pa-lɛt, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
