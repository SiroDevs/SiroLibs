              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Pɛ-thɛ̈k-yaa gat Mɛ-ce-dha-bel gat Dhɛra gat Juda, ɛ läät kua̱r kɛ kui̱ nɛɛni diaal.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nɛy tin te wi̱i̱ni tin kɔ̱kiɛn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
