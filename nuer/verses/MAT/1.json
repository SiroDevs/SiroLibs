{
  "id": "MAT.1",
  "number": "1",
  "bookId": "MAT",
  "reference": "Mɛ̈T 1",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciööt gua̱ndɔɔŋni Yecu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Warɛgak gua̱ndɔɔŋni Yecu Kritho, gat Dee-bid, gat A-bɛ-ram.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu A-bɛ-ram a gua̱n Ay-dhɛk, kä cu Ay-dhɛk a gua̱n Je-kɔb, kä cu Je-kɔb a gua̱n Juda kɛnɛ dämani, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.2",
            "verseOrgIds": [
              "MAT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Juda a gua̱n Pɛ-rɛdh kɛnɛ Dhɛra kä mandiɛn mɔ Ta-mar, kä cu Pɛ-rɛdh a gua̱n Ɣɛdh-ron, kä cu Ɣɛdh-ron a gua̱n Raam, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.3",
            "verseOrgIds": [
              "MAT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Raam a gua̱n A-mi-na-dab, kä cu A-mi-na-dab a gua̱n Na-con, kä cu Na-con a gua̱n Thal-mɔn, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Thal-mɔn a gua̱n Bo-ɛ̈dh kä man mɔ Ra-ɣab, kä cu Bo-ɛ̈dh a gua̱n O-bɛd min man mɔ Ruth, kä cu O-bɛd a gua̱n Jɛthi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.5",
            "verseOrgIds": [
              "MAT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Jɛthi a gua̱n Dee-bid in la kuäär in di̱i̱t.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid a gua̱n Thɔ-lo-mon kä man mɔ ciek U-ri-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.6",
            "verseOrgIds": [
              "MAT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Thɔ-lo-mon a gua̱n Rɛ-ɣɛ̈-bɔm, kä cu Rɛ-ɣɛ̈-bɔm a gua̱n Ä-bi-yaa, kä cu Ä-bi-yaa a gua̱n Atha, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.7",
            "verseOrgIds": [
              "MAT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Atha a gua̱n Yɛ-ɣo-ca-pat, kä cu Yɛ-ɣo-ca-pat a gua̱n Yo-ram, kä cu Yo-ram a gua̱n U-dhi-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.8",
            "verseOrgIds": [
              "MAT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu U-dhi-yaa a gua̱n Yo-tham, kä cu Yo-tham a gua̱n A-ɣadh, kä cu A-ɣadh a gua̱n Ɣidh-ki-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.9",
            "verseOrgIds": [
              "MAT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Ɣidh-ki-yaa a gua̱n Ma-na-thɛ, kä cu Ma-na-thɛ a gua̱n A-mɔth, kä cu A-mɔth a gua̱n Yo-ci-yaa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.10",
            "verseOrgIds": [
              "MAT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Yo-ci-yaa a gua̱n Yɛ-kɔn-ya kɛnɛ dämani, kɛ gua̱a̱th ëë pɛ̈c kɛ nikɛ kä Bɛ̈-bi-lɔn.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.11",
            "verseOrgIds": [
              "MAT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë cakɛ pɛ̈c kä Bɛ̈-bi-lɔn, cu Yɛ-kɔn-ya a gua̱n Cɛ-ɛ̈l-ti-el, kä cu Cɛ-ɛ̈l-ti-el a gua̱n Dhɛ-ru-ba-bɛl, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.12",
            "verseOrgIds": [
              "MAT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Dhɛ-ru-ba-bɛl a gua̱n A-bi-yud, kä cu A-bi-yud a gua̱n Ɛl-ya-kim, kä cu Ɛl-ya-kim a gua̱n A-dhor, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.13",
            "verseOrgIds": [
              "MAT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu A-dhor a gua̱n Dha-dok, kä cu Dha-dok a gua̱n A-kim, kä cu A-kim a gua̱n Ɛ-li-ud, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.14",
            "verseOrgIds": [
              "MAT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Ɛ-li-ud a gua̱n Ɛl-a-dhar, kä cu Ɛl-a-dhar a gua̱n Ma-than, kä cu Ma-than a gua̱n Je-kɔb, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.15",
            "verseOrgIds": [
              "MAT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu Je-kɔb a gua̱n Jo-thɛp min mɔ cɔw Mɛri, man Yecu in cɔal i̱ Mɛ-thia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä inɔ kar A-bɛ-ram diaal kamdiɛn kɛnɛ Dee-bid kɛ kar da̱ŋ wäl ŋuan. Kä nikä Dee-bid amäni pɛc nath kä Bɛ̈-bi-lɔn kɛ kar da̱ŋ wäl ŋuan. Kä ni kä pɛc nath kä Bɛ̈-bi-lɔn amäni da̱p Mɛ-thia kɛ kar da̱ŋ wäl ŋuan.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Da̱p Yecu Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ cu da̱p Yecu Kritho tuɔɔk inɛ. Mëë ca man ni Mɛri nhɔk ɛn ɣöö ba kuɛn ɛ Jo-thɛp, kä ŋotkɛ /kenkɛ ni te guäth kɛl, cua jɛ jek ɛn ɣöö ruetdɛ kɛ gat mi la̱thkɛ jiidɛ ɛ Yiëë in Gɔaa in Rɛl Rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.18",
            "verseOrgIds": [
              "MAT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cɔwdɛ ni Jo-thɛp, kɛ ɣöö ɛ wut mi gua̱n cuŋni, kä /cɛ jɛ go̱r i̱ derɛ jɛ moc pöc, go̱rɛ mi däkɛ jɛ kɛ tɛ̱̈ɛ̱̈. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.19",
            "verseOrgIds": [
              "MAT.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min carɛ mɛmɛ, nɛnɛ, cu jääk Kuäär ni Kuɔth nhial päl kä jɛ kɛ la̱k, laarɛ jɛ i̱, “Jo-thɛp, gat Dee-bid, /cu dual kɛ kuën ciëkdu ni Mɛri, kɛ ɣöö min rueetdɛ läthɛ Yiëë in Gɔaa in Rɛl Rɔ thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.20",
            "verseOrgIds": [
              "MAT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jɛn bɛ gat dap, kä bi jɛn cɔl i̱ Yecu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:21",
              "type": "text"
            },
            {
              "text": "Yecu kɛ thok Gɛ-rith ɛ Jɔ-cua min lot ni ɣöö bi Kuoth Nhial naath kän.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kɛ ɣöö ɛ jɛn min bi nɛɛkɛ kän kä dueerkiɛn.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.21",
            "verseOrgIds": [
              "MAT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu mɛmɛ kɛɛliw tuɔɔk, kɛ ɣöö bi mi ca lar ɛ Kuäär ni Kuoth kɛ thok go̱kä a thuɔ̱k mëë wëë i̱,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.22",
            "verseOrgIds": [
              "MAT.1.22"
            ]
          }
        }
      ]
    }
  ],
