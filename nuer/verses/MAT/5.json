        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cia jɛ liŋ ɛn ɣöö ca jɛ lar i̱, ‘Nhɔk gua̱n thieekädu, kä nyir gua̱n tɛ̈ru.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.43",
            "verseOrgIds": [
              "MAT.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɣän la̱rä jɛ yɛ i̱, ‘Nhɔakɛ ji̱ tɛ̈run kä palɛ kɛ kui̱ nɛɛni tin muɔckɛ yɛ kɛ riɛk, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.44",
            "verseOrgIds": [
              "MAT.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö bi yɛn a gaat Guurun in te nhial kɛ ɣöö jakɛ cäŋdɛ kä lɛp kä nɛy ti jiäk kɛnɛ nɛy ti gɔw, kä jäkɛ nhiaal kä ji̱ cuŋni kɛnɛ nɛy ti thil cuŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.45",
            "verseOrgIds": [
              "MAT.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi nhɔk yɛn ni nɛy tin nhɔakɛ yɛ, ɛ muc ŋu kä bia jek ɔ? Kä /cɛ jɛn min la̱tkɛ ɛ thuɔ̱ɔ̱l tho̱lbo̱kä bä? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.46",
            "verseOrgIds": [
              "MAT.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi nërɛ ni dämuɔɔri kärɔ̱, leny la̱tdun lät nɛɛni tin kɔ̱kiɛn i̱di? /Cɛ mäni jur inɔ bä? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.47",
            "verseOrgIds": [
              "MAT.5.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 5:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ bi yɛn gɔw ɛlɔ̱ŋ, ce̱tkɛ Guurun in te nhial.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.5.48",
            "verseOrgIds": [
              "MAT.5.48"
            ]
          }
        }
      ]
    }
