          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu nhiaal dɛ̈m, cu nyɔc ben raar, kä cu jiɔam puɔ̱t kä yɔ̱kɛ luaak ɛmɔ, kä cuɛ tɛɛth, kä cu tëthdɛ di̱t.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        }
      ]
