          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy diaal tin liɛŋkɛ ruaacnikä ti̱ti̱ kä /ci kɛn kɛ lät, bikɛ ce̱tkɛ ram mi dɔ̱a̱r mi ci luaakdɛ la̱t guäth litdä. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
