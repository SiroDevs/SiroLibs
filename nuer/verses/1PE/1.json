            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ kɛ kui̱ luthädun kɛ thuɔ̱k cia tieydun jakä wic wic, a cia tekɛ nhök mi thuɔ̱k kɛ dämuɔɔrikun tin Krith-cini. Inɔ nhɔakɛ rɔ̱ ɛlɔ̱ŋ kɛ lɔcdun kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
