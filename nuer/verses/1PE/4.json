        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuɔ̱ɔ̱p puthä Kuɔth",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ mëë ci Kritho ti bɛ̈c bɛ̈ɛ̈c rut kɛ puɔ̱nydɛ, amäni yɛn bä buɔ̱mɛ rɔ, kɛ ca̱r mi ce̱tkɛ ca̱rɛ, kɛ ɣöö ram mi ci bɛ̈c bɛ̈ɛ̈c rut kɛ puɔ̱nydɛ /ci dueer lɛ ŋot thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.1",
            "verseOrgIds": [
              "1PE.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ a wä nhiam bi tha̱a̱ŋ teekädu wi̱i̱ muɔ̱ɔ̱n thuk kɛ ca̱r Kuɔth, a /ci mɔ a min go̱o̱r raan ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci yɛn gua̱a̱th mi ro̱ŋ thuk kɛ lätni kä ti nhɔk Jur la̱tdiɛn, ci yɛn tëkdun thuk kɛ ciaŋ leerä, kɛnɛ lät jiäkni, kɛ yɔ̱ŋ kɔaaŋni, kɛnɛ ŋar baaŋ, kɛ lɔk, kɛ pa̱l kuthni guääyni. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikɛ ga̱a̱c kɛ ɣöö /ken yɛn rɔ̱ ma̱t kɛ täämɛ rɛy ciɛɛŋä yäämädiɛn, kä inɔ kuëthkɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö bikɛ pek lätnikiɛn kuën ram min ci rɔ rialikä kɛ ɣöö bɛ nɛy tin tëk kɛnɛ nɛy tin ci li̱w luk. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛ jɛn min ca thuk ti gɔw la̱t nɛy tin ci li̱w bä kɛ jɛ, kɛ ɣöö cäŋ ca pua̱nykiɛn luk ce̱tkɛ min ca nɛy diaal luk, dɔ̱ŋ bikɛ cieŋ kɛ yiëë ce̱tkɛ Kuoth.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuɔ̱p mucni Kuɔth agɔaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci guut ŋɔaani diaal thia̱k, kɛ kui̱ ɛmɔ a wuɔ̱thkun ɣööŋ, kä ruɔ̱tdɛ rɔ̱ kɛ kui̱ palikun. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:8",
              "type": "text"
            },
            {
              "text": "Pɛl 10:12.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min di̱t ni jɛn kä ti diaal nhɔakɛ rɔ̱ kɛ nhök mi thuɔ̱k, kɛ ɣöö nhök kumɛ dueer ti ŋuan piny. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuɔ̱ɔ̱rɛ rɔ̱ agɔaa, a thil ŋɔa̱a̱ŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce̱tdɛ kɛ yuup mucni Kuɔth ti gööl, lua̱kɛ rɔ̱ kamnikun ram ɔ kɛ muc in cɛ jek. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram mi ruac, a jɛ ruac ce̱tkɛ ram mi lat ni ruac Kuɔth. Kä ram mi lät naath ikä, a jɛ lät kɛ buɔ̱m min ci Kuoth ɛ ka̱m jɛ, kɛ ɣöö dëë Kuoth liak rɛy kä ti diaal kɛ Yecu Kritho. Kä buay kɛnɛ buɔ̱m kɛ nyinkɛ a thil pek. Inɔnɔ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuɔ̱c ala Krith-cin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.11",
            "verseOrgIds": [
              "1PE.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nhöökä, /cuarɛ ga̱a̱c kɛ riɛk mi bɛc bɛc mi bi tuɔɔk kä yɛ kɛ ɣɔ̱ndun, ce̱t tëëkɛ mi yi̱i̱c naath mi tuɔɔk kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.12",
            "verseOrgIds": [
              "1PE.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä a tɛth ni lo̱ckun ce̱tkɛ mi ruut yɛn bɛ̈c bɛ̈ɛ̈c Kritho kɛ jɛ kɛɛl, kɛ ɣöö dee lo̱ckun tɛɛth bä, mi wä buaydɛ wä jɔɔc. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.13",
            "verseOrgIds": [
              "1PE.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:14",
              "type": "text"
            },
            {
              "text": "Ica 11:2.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mi ca yɛ kuëth kɛ kui̱ cio̱tdä Kritho, ca yɛ poth, kɛ ɣöö te yiëë buɔyä min la Yiëë Kuɔth kɛ yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.14",
            "verseOrgIds": [
              "1PE.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä duundɛ ɣöö a thil raan kä yɛ mi bi cuuc kɛ ɣöö ɛ nääk nath, kiɛ cuer, kiɛ gua̱n nyuɔɔni, kiɛ gua̱n wi̱eecni. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.15",
            "verseOrgIds": [
              "1PE.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi cuc raan kɛ ɣöö ɛ Krith-cin, /cuarɛ jɛ car i̱ ɛ pöc, kä liak ni Kuoth kɛ ɣöö cia ciöt ɛmɔ jek. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.16",
            "verseOrgIds": [
              "1PE.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci gua̱a̱th cop kɛ ɣöö ba luk tok, kä ba jɛ tok kɛ ji̱ dhɔaar Kuɔth. Kä mi ba jɛ tok kɛ kɔn, kä bɛ kulɛ thuɔ̱k i̱di kɛ nɛy tin lökɛ thuk Kuɔth ti gɔw? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.17",
            "verseOrgIds": [
              "1PE.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci bok wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.18",
            "verseOrgIds": [
              "1PE.4.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "4:18",
              "type": "text"
            },
            {
              "text": "Pɛl 11:31.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
