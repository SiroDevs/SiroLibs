{
  "id": "1PE.4",
  "number": "4",
  "bookId": "1PE",
  "reference": "1 Pit 4",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
