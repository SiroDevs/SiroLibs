          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ci Kuäär ni Kuoth Nhial ɣä nyɔk kɛ nyuth nɛmɛ. Rɛydɛ cua diëny mi ca nok kɛ dɛy wal guutdä ŋër nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Kuoth Nhial ɣä thiec i̱, “Ɛŋu mi nɛɛni, A-mɔth?” Kä cua wee i̱, “Ɛ diëny mi thiäŋ kɛ dɛy wal guutdä ŋër.” Ɛ jɛn, cu Kuoth Nhial ɣä ku jiök i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Luk ji̱ I-thɛ-rɛl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Buɔth rɛ̈w kɛ kui̱ ruaacni Kuɔth",
          "type": "text"
        }
      ]
    }
  ],
