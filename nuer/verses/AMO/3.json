            "sid": "AMO 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liɛŋɛ thok ɛmɛ in lär Kuoth Nhial ɛ yɛ, lö ji̱ I-thɛ-rɛl, kɛ kui̱dun yɛn diaal tëë kämɛ raar rööl I-jëp wee i̱,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.1",
            "verseOrgIds": [
              "AMO.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciöl raam mi gök",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tɔaŋ Tha-mɛ-ria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
