  "bookId": "EST",
  "reference": "Ɛth 9",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
