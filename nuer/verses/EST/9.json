              "EST.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Ciek Kua̱r ni Ɛth-ter nya Ä-bi-ɣa-yil kɛnɛ Mɔr-da-kay in la raan ji̱ Juudh ruac gɔ̱r kɛ lua̱ŋ kuäärädiɛn, kɛ ɣöö ba warɛgak in rɛwdɛ mëë ci Mɔr-da-kay ɛ gɔ̱r kɛ kui̱ Pu-rim jakä thuɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua warɛgakni ja̱k kɛ kui̱ malä kɛnɛ gɔɔy ciɛŋä ji̱ Juudh diaal, cua jäkä wi̱i̱ kuäärä Ä-ɣɛ̈c-we-roc diaal ti kuɔ̱r kɛl wi̱cdɛ jiɛn da̱ŋ rɛw wi̱cdɛ bärɔw (127). ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua ruac lat bäkɛ ɣöö bakɛ la tiɛtkɛ ce̱tnikɛ gua̱a̱thdiɛn ɛmɛ rɛy runä, ce̱tnikɛ gɔ̱a̱r in ca gɔ̱ɔ̱r nikɛ ɛ raan ji̱ Juudh ni Mɔr-da-kay kɛnɛ Ciëk Kua̱r ni Ɛth-ter ɛn ɣöö bikɛ la ni̱nkiɛn, amäni kuaykiɛn ɛla ŋut ce̱tkɛ min la tiɛmkɛ thek mi̱thni kɛnɛ pa̱riɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ruac Ciëk Kua̱r ni Ɛth-ter ɛ jɛn ɛ ni̱n ka̱pkɛ ni Pu-rim ɛ bum, cua mɛmɛ jakä gɔ̱a̱rkɛ piny inɔ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
