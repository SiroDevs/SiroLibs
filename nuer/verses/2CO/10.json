        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ga̱y Puɔl kɛ la̱tdɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän Puɔl puɔ̱nydä la̱ŋä yɛ, kɛ ciaŋ thiɛkä kɛnɛ gɔɔy Kritho. Laar tha̱a̱ŋ nath jɛ lapä ram mi muɔ̱l muɔ̱l, kä mi ta̱a̱ jɔ̱ɔ̱r ɛ ɣän ram mi bum bum! ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cuɔmä yɛ ɛn ɣöö mi wa̱a̱ wä cop kä yɛ, /cä jɛ go̱o̱r i̱ bä buɔ̱m, ce̱tkɛ min dëë ruac a bum kɛ nɛy tin diɛwkɛ kɔ i̱ la̱tkɔ kɛ ciaŋ ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ thuɔ̱k cieŋ kɔn rɛy ɣɔaa ɛmɛ, kä duundɛ ɣöö /ci kɔn ko̱r tɛr kɛ ciaaŋ ɣɔaa ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö yio̱w kööran /cikɛ nyin ɣɔaa, kä duundɛ ɣöö tekɛ kɛ buɔ̱m Kuɔth kɛ ɣöö banɛ kɛ däk gua̱th ti buɔ̱m buɔ̱ɔ̱m. Canɛ ŋaknɔmni däk ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛnɛ nyin liakä diaal tin galkɛ naath kä ŋäc Kuɔth, kä ka̱pnɛ cär diaal kɛ kui̱ luthä Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakɔ rɔ̱ rialikä kɛ ɣöö bakɔ nɛy diaal tin thil luth duäc, mi wa luthdun pekdɛ cop.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guɛcɛ min te nhiamdun. Mi tëëkɛ ram mi ŋääth rɔɔdɛ ɛn ɣöö ɛ raan Kritho, a jɛ caarɛ ɛn ɣöö ce̱tkɛ min ɛ raan Kritho, kɛ kɔn nɛɛ Kritho bä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Täämɛ a cäŋ mi liakä rɔ a di̱t kä tɔt kɛ buɔ̱m, in ci Kuoth ɛ ka̱mkɔ, ɛn buɔ̱m ɛmɔ ɛ mi kap ni yɛ nhial, /ciɛ mi däk ni yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cä jɛ go̱r ɛn ɣöö bɛ jɔɔc i̱ jakä ni yɛ kä dual kɛ warɛgaknikä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö laar kɛn ɛ i̱, “Bum luɔt warɛgaknikɛ, kä puɔ̱nydɛ nyuänɛ, kä ruaacnikɛ thil kɛ luɔt.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A jɛ cop lo̱c nɛɛni tin ce̱tkɛ ɛn tɔ̱ ɛn ɣöö min latkɔ kɛ warɛgak a ta̱kɔ jɔ̱ɔ̱r, bakɔ jɛ lat ɛ ta̱kɔ thi̱n bä.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cakɔ jɛ go̱r ɛn ɣöö bakɔ rɔ̱ pa̱a̱r kɛ tha̱a̱ŋ nath tin latkɛ di̱tdiɛn kärɔ̱. Kä mi thɛ̈mkɛ rɔ̱ kamnikiɛn kä pa̱a̱rkɛ rɔ̱ kamnikiɛn, thilɛ mi gɔaa mi nyooth kɛn ɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ci liakda bi räth ɛlɔ̱ŋ, bɛ peek rɛy la̱t in ci Kuoth ɛ ka̱m kɔ, ɛ ni ɣöö bakɔ cop kä yɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /cakɔ pek këthda bi bäl, mi wakɔ wä cop kä yɛ, kɛ ɣöö kɛ kɔn nɛy tëë jio̱l tëë cuɔpkɛ gua̱a̱thdun kɛ thuk ti gɔw kɛ kui̱ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /ci liakda bi räth kɛ lät nɛɛni kɔ̱kiɛn, kä duundɛ ɣöö ŋa̱thda ɛ ɣöö bi ŋa̱thdun rɔ rep, kɛ ɣöö dëëkɔ la̱t mi di̱i̱t la̱t rɛydun, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö dëë kɔ thuk ti gɔw lat rɛy röli ti te kui̱dun, a thilɛ mi liakɔ rɔ̱ kɛ la̱t min ca la̱t ɛ radɔ̱diɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca lar i̱,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:17",
              "type": "text"
            },
            {
              "text": "Yir 9:24.",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ram mi liak rɔ, a jɛ liak ni Kuäär ni Yecu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö /ciɛ nɛy tin latkɛ gɔɔydiɛn kärɔ̱ kɛn tin nhɔakɛ, ɛ ni nɛy tin latkɛ gɔɔydiɛn ɛ Kuäär.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    }
  ],
