{
  "id": "2CO.5",
  "number": "5",
  "bookId": "2CO",
  "reference": "2 Kor 5",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ŋa̱cnɛ jɛ, mi wä kɛmɛ wec muɔ̱ɔ̱n in ciëŋnɛ thi̱n min la puɔ̱nydan wä da̱k, ta̱nɛ kɛ ti̱c mi do̱raar nhial kä Kuoth, duel mi /ca lät kɛ tet. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.1",
            "verseOrgIds": [
              "2CO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn täämɛ rɛy kɛmɛkä nɛmɛ guɔɔrnɛ thi̱n, kä di̱t lo̱ckɔn kɛ ɣöö dëë kɔn kum kɛ ciëŋ nhial, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.2",
            "verseOrgIds": [
              "2CO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö mi ba kɔn kum kɛ jɛ, /ci kɔn bi te baaŋ juutdä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.3",
            "verseOrgIds": [
              "2CO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö min ŋuɔtnɛ rɛy kɛmɛkä mɛmɛ, kuɔmkɔn kɛ kui̱ cucädan, kä /ciɛ ɣöö ba kuum ka̱m raar, duundɛ ɣöö ba repni kumdan a di̱t, kɛ ɣöö ba puɔ̱ny in la li̱w bät ɛ tëk. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.4",
            "verseOrgIds": [
              "2CO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ram mi ci kɔn rialikä kɛ kui̱ kä mɛmɛ ɛ jɛn Kuoth, in ci kɔn ka̱m Yiëëdɛ ala lär in thuɔ̱ɔ̱k kɛ kui̱ kä tin ca rialikä kɛ kui̱dan.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ ta̱nɛ kɛ buɔ̱m lɔaac ni ciaŋ. Ŋa̱cnɛ jɛ mi ŋuɔtnɛ kɛ ciaŋ rɛy pua̱ny ɛmɛ, te kɔn jɔ̱ɔ̱r kä Kuäär, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.6",
            "verseOrgIds": [
              "2CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö cieŋkɔn kɛ ŋa̱th, a /ci mɔ a min nɛ̈nɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.7",
            "verseOrgIds": [
              "2CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣɔ̱ɔ̱n ta̱nɛ kɛ buɔ̱m lɔaac, dënɛ nhɔk ni ɣöö ta̱nɛ jɔ̱ɔ̱r kɛ puɔ̱ny kɛ ɣöö banɛ te kɛɛl kɛ Kuäär ni Yecu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.8",
            "verseOrgIds": [
              "2CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛnɔ a cäŋ ciëŋnɛ rɛy pua̱ny ɛmɛ kiɛ ta̱nɛ jɔ̱ɔ̱r, min görnɛ ɛ ɣöö banɛ lɔcdɛ jakä tɛth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.9",
            "verseOrgIds": [
              "2CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi kɔn diaal dhil jɔɔc nhiam kɔam luɔ̱k Kritho, kɛ ɣöö dee ramɔ jek kɛ min ca lät kä puɔ̱ny, mi gɔaa kiɛ mi jiääk.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maar Kuɔth kɛ Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.10",
            "verseOrgIds": [
              "2CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ mi ŋa̱cnɛ luth Kua̱r ni Yecu, bi kɔn naath jak kä ŋa̱ckɛ jɛ. Kä kɔn diaal ŋäc Kuoth kɔn, kä ŋa̱a̱thä jɛ ɛn ɣöö ŋäc yɛn ɣä kɛ lo̱ckun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.11",
            "verseOrgIds": [
              "2CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "/Cakɔ nyɔk ni rɔ̱ kɛ lät yɛ, ka̱mkɔ ni yɛ luɔt mi bia liak ni rɔ̱ kɛ kui̱da, kɛ ɣöö dërɛ tekɛ lua̱ŋ kɛ luɔc nɛɛni tin liakɛ rɔ̱ kɛ tin jɔc, a /ci mɔ a tin te lɔɔc ran. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.12",
            "verseOrgIds": [
              "2CO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö mi nyuɔɔn ca̱ra, ɛ kui̱ Kuɔth. Kä mi carkɔ agɔaa, ɛ kui̱dun. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.13",
            "verseOrgIds": [
              "2CO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö nhök Kritho comɛ kɔn, kɛ ɣöö canɛ jɛ jek a thil diw, ɛn ɣöö ci ram kɛl li̱w kɛ kui̱ nɛɛni diaal, kɛ kui̱ ɛmɔ ci nɛy diaal li̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.14",
            "verseOrgIds": [
              "2CO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cɛ li̱w kɛ kui̱ nɛɛni diaal, kɛ ɣöö /ci nɛy tin tëk bi̱lɛ tëk kärɔ̱, kä bikɛ tëk nikɛ jɛ ɛn min ci li̱w kä ca jiɛc li̱th kɛ kui̱diɛn.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.15",
            "verseOrgIds": [
              "2CO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni ɛn täämɛ a wee wä nhiam, thilɛ raan mi banɛ car ala raan kɛ ciaaŋ nath. A cäŋ ɛ mëë canɛ Kritho car ala raan kɛ ciaaŋ nath, /canɛ bi̱lɛ ŋot kɛ ca̱r inɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ ɛmɔ, mi te raan rɛy Kritho, ɛ jɛn ram mi ca nyɔk kɛ di̱eth. Ci ta̱a̱dɛ mëë wal thuuk, nɛnɛ, ci ciaŋ mi pay tuɔɔk ben. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.17",
            "verseOrgIds": [
              "2CO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ kɛɛliw bëë kä Kuoth, min ci kɔn diaal luɔc maarä kɛ jɛ kɛ Kritho, kä cɛ kɔn ka̱m la̱t locä maarä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.18",
            "verseOrgIds": [
              "2CO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɔmɔ luɔtdɛ ɣöö ci Kuoth ji̱ ɣɔaa luɔc maarä kɛ jɛ kɛ Kritho, a /kenɛ dueerikiɛn kuën kɛ, kä cɛ kɔn ka̱m la̱t locä maarä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.19",
            "verseOrgIds": [
              "2CO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ lapnɛ ja̱a̱k kɛ kui̱ Kritho, a cɔɔl Kuoth naath kɛ kɔn. La̱ŋkɔ yɛ kɛ kui̱ Kritho, luɔcɛ maarä kɛ Kuoth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.20",
            "verseOrgIds": [
              "2CO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cɛ Yecu jakä tekɛ duer kɛ kui̱dan, jɛn ram min /ken met duer, kɛ ɣöö rɛydɛ dënɛ ciaaŋ cuŋni Kuɔth jek.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.21",
            "verseOrgIds": [
              "2CO.5.21"
            ]
          }
        }
      ]
    }
  ],
