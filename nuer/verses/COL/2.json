  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "COL 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä göörä ɣöö bia ŋa̱c ɛn ɣöö cä lät a bum kɛ kui̱dun kɛnɛ kui̱ nɛɛni tin te kä La-o-di-thia, kɛ nɛy diaal tin /ka̱n ɣä met nɛn. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.1",
            "verseOrgIds": [
              "COL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän göörä ɣöö bi lo̱ckiɛn buɔ̱m, kä bikɛ mat rɛy nho̱kä, kɛ ɣöö bikɛ tekɛ ti̱el ŋäcä ŋɔaani, kä bikɛ ruac Kuɔth in cuääŋ naath ŋa̱c, min la Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö rɛydɛ te ti̱l pɛlä kɛnɛ ŋäc ŋɔaani kɛ ti diaal thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän laarä nɛmɛ kɛ ɣöö thilɛ ram mi bi yɛ mɛt kɛ ruac wän wäänä. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋ ta̱a̱ jɔ̱ɔ̱r kɛ puɔ̱nydä, ta̱a̱ kɛɛl kɛ yɛ rɛy yieekä, kä tɛth lɔcdä kɛ nën teekädun mi gɔaa kɛnɛ buɔ̱m ŋäthädun rɛy Kritho.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tëk kɛɛliw rɛy Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ce̱tkɛ min cia Kritho Yecu nhɔk ala Kuäär, kua cieŋ rɛydɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "a ciökun cui̱t rɛydɛ, kä yiathɛ rɔ̱ piny rɛy ŋäthä, ce̱tkɛ mëë /ca yɛ ŋi̱eec, kɛ tɛ̈th lɔaac mi di̱i̱t.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ŋa̱cɛ jɛ ɛn ɣöö thilɛ ram mi bi yɛ jakä carɛ ti jiäk kɛ ŋi̱i̱c kacä mi baaŋ, ce̱tkɛ ta̱a̱ ciɛŋä nath tin bä kä kuäär yieekä ɣɔaa ɛmɛ, min /ci bä kä Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.8",
            "verseOrgIds": [
              "COL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö rɛydɛ te ciaŋ Kuɔth kɛɛliw thi̱n puɔ̱nydɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
              "COL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cu yɛn tekɛ tëk mi ro̱ŋ rɛydɛ. Kä ɛ jɛn Yecu la Kuäär kua̱ri kɛnɛ kuääri. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rɛy Yecu ca yɛ cuɛl, kä /ciɛ cuël mi la̱tkɛ kɛ tet nath, ɛ wuɔ̱c jiäkni pua̱ny kɛ cuël Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mëë ca yɛ kony kɛ jɛ kɛɛl rɛy la̱kdun, kä ca yɛ jiɛc kɛ jɛ kɛɛl bä kɛ ŋa̱th rɛy bumä Kuɔth min ci jɛ jiɛc li̱th. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë cia li̱w rɛy dueeri kɛnɛ thil cuelä pua̱a̱nydun, ci Kuoth yɛ jakä tëk kɛ Kritho kɛɛl. Cɛ mɛmɛ la̱t mëë cɛ kɔn pa̱l dueerkɔn diaal, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä cɛ tin ca gɔ̱r thi̱n coth tin ca gɔ̱a̱r kɔn kɛ duɔ̱ɔ̱p in lat ŋuɔ̱tdɛ. Cuɛ kɛ coth kɛ mëë cɛ Yecu jakä pua̱tkɛ jiaath. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cuɛ buɔ̱m ruëëcni kɛnɛ kua̱r woc, kä cuɛ jɛ nyoth nhiam nɛɛni diaal ɛn ɣöö thilɛ kɛ buɔ̱m, kɛ ɣöö cɛ kɛ puɔ̱t kɛ lia̱a̱dɛ jɔk jiaath.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "COL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ a yɛ /ca luk ɛ radɔ̱diɛn kɛ kui̱ mi̱eth kɛnɛ ma̱th, kiɛ kɛ kui̱ mi̱eth ti̱mä kiɛ tëth path kiɛ cäŋ lɔ̱ŋä ji̱ Juudh. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ ti̱eep kärɔ̱, kä min bi ben, kä min la thuɔ̱k ɛ Kritho. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A thil ram mi jak yɛ kä thil luɔt kɛ palun kɛ jaak nhial. Kä ram mi ce̱tkɛ nɔmɔ, la latdɛ luɔ̱ɔ̱tni diaal kä min cɛ nɛn. Kä kɛ ca̱r wecdɛ mi thil ŋa̱th la liakɛ ni rɔ. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä /cɛ rɔ mat kɛ Kritho, min la wi̱c. Kä Kritho ɛ jɛn min luäk kä mat puɔ̱ny kɛɛl, kɛ ɣöö derɛ piith kɛ duɔ̱ɔ̱p in go̱o̱r Kuoth ɛ.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lia̱a̱ kɛnɛ tëk kɛɛl kɛ Kritho",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mi cia li̱w kɛɛl kɛ Kritho, a ca yɛ lony kä ruec yieeni ɣɔaa, ɛŋu tëk yɛn ɔ, ce̱tkɛ mi ŋot yɛn ala ji̱ ɣɔaa ɔ? Ɛŋu luɔ̱thɛ ŋut ti ce̱tkɛ ti̱ti̱ ɔ, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.20",
            "verseOrgIds": [
              "COL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ɛn ɣöö “/Cu jɛ rɔm, kä /cu jɛ met, kä /cu jɛ thiap”? ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.21",
            "verseOrgIds": [
              "COL.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ŋut ti̱ti̱ luɔtkɛ ni tin bi thuuk kɛ läät, kɛn kɛ ruaacni nath kɛnɛ ŋi̱i̱c nath. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.22",
            "verseOrgIds": [
              "COL.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn ŋuɔ̱t ti̱ti̱ tekɛ kɛ pɛl, kɛ ɣöö kapkɛ rɔ̱ nhiam kä jakɛ rɔ̱ kä kuiy, kɛ ruɔ̱tdiɛn kɛ nyin pua̱ny ti bɛc, kä thilɛ kɛ lua̱ŋ kɛ ga̱ŋ di̱tdä lɔaac jiäkni pua̱a̱ny.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.23",
            "verseOrgIds": [
              "COL.2.23"
            ]
          }
        }
      ]
    }
  ],
