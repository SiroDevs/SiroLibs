{
  "id": "2CH.15",
  "number": "15",
  "bookId": "2CH",
  "reference": "2 Kuɛ̈N 15",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
