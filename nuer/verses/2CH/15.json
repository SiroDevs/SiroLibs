      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rialikä Atha kɛ rɔɔdɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu yiëë Kuɔth ben kä Ä-dhar-yaa gat O-dɛd. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.1",
            "verseOrgIds": [
              "2CH.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ Atha wä lor, kä cuɛ jiök i̱, “Liŋä, Atha, kɛ yɛn ji̱ Juda kɛ ji̱ Ben-ya-min yɛn diaal. Te Kuoth Nhial kɛɛl kɛ yɛ mi te yɛn kɛɛl kɛ jɛ. Mi wä yɛnɛ go̱r, bia jɛ jëk, kä mi wä yɛnɛ pa̱l ruëëc bɛ yɛ pa̱l ruëëc bä. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.2",
            "verseOrgIds": [
              "2CH.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä kɛ pek mi bäär cieŋ I-thɛ-rɛl a thil Kuoth mi thuɔ̱k, kä thilɛ kɛ bo̱o̱th palä mi ŋi̱i̱ckɛ, kä thilɛ kɛ ŋuɔ̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.3",
            "verseOrgIds": [
              "2CH.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mɔ cikɛ tëë riɛk ɔ, la lunykɛ kä Kuoth Nhial, Kuoth I-thɛ-rɛl. Cukɛ jɛ go̱r kä cukɛ jɛ jëk. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.4",
            "verseOrgIds": [
              "2CH.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛn runi tɔ̱tɔ̱ cuɛ thil mal kä ram wä ko̱o̱r kiɛ ram mi ci luny wi̱c, kɛ ɣöö te ji̱ wec muɔ̱ɔ̱n diaal kɛ rik. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.5",
            "verseOrgIds": [
              "2CH.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu do̱rɔ nyiëëny kɛ do̱rɔ, kä nyiëëny wec ɔ kɛ wec ɔ, kɛ ɣöö ci Kuoth Nhial kɛ moc riɛk. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.6",
            "verseOrgIds": [
              "2CH.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä yɛn, buɔ̱mɛ /cuarɛ rɔ luär, kɛ ɣöö ba yɛ cuɔ̱l la̱tdun.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.7",
            "verseOrgIds": [
              "2CH.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min ci Atha ruac go̱kä ni Ä-dhar-yaa gat O-dɛd liŋ, cuɛ rɔ com. Kä cuɛ kuth guäyni woc rɛy cieŋ Juda kɛ rɛy cieŋ Ben-ya-min kɛɛliw, kɛ wi̱i̱ diaal te cɛ käp rööl päämni Ɛ-pa-rim. Kä cuɛ yi̱k Kuɔth Nhial min te nhiam luaak Kuɔth rɛy kal bany. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.8",
            "verseOrgIds": [
              "2CH.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Juda kɛ ji̱ Ben-ya-min diaal kɛ ji̱ Ɛ-pa-rim kɛ ji̱ Ma-na-thɛ kɛ ji̱ Cim-on tëë cieŋ rɛydiɛn rɔ ma̱t Atha. Kä cu nɛy ti ŋuan ben kä jɛ kä I-thɛ-rɛl, mëë ca ŋa̱c i̱ te Kuoth Nhial Kuothdɛ kɛɛl kɛ jɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.9",
            "verseOrgIds": [
              "2CH.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ rɔ duɔl kä Jɛ-ru-tha-lɛm kɛ diɔ̱ɔ̱k päthni kä wäl dhieec runi ruëc Atha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.10",
            "verseOrgIds": [
              "2CH.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ cukɛ Kuoth Nhial thöp muc kä pɛ̈ɛ̈c te ca nööŋ. Thääk ti kur bärɔw, kɛ det ti bathdɔɔri bärɔw. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.11",
            "verseOrgIds": [
              "2CH.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ ruac mat i̱ ba pal ni Kuoth Nhial, Kuoth gua̱ni, kɛ lɔcdiɛn kɛɛliw kɛnɛ ca̱riɛn kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.12",
            "verseOrgIds": [
              "2CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ramɔ ci Kuoth Nhial, Kuoth I-thɛ-rɛl bi palɔ, ɛ gat kiɛ ciek kiɛ wut mi dɔaŋ ba näk. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.13",
            "verseOrgIds": [
              "2CH.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cukɛ rɔ yac nhiam Kuɔth kɛ rɔal mi di̱i̱t kɛ kaaŋni kɛ kaaŋni tuɔ̱ŋni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.14",
            "verseOrgIds": [
              "2CH.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ Juda diaal lo̱ckiɛn tɛɛth kɛ ɣöö cikɛ rɔ yac nikɛ lɔcdiɛn kɛɛliw kɛnɛ ca̱riɛn kɛɛliw. Kä cukɛ jɛ pal nikɛ lɔcdiɛn kɛɛliw, kä cukɛ jɛ jëk, kä cuɛ kɛ ka̱m mal pëkni diaal.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.15",
            "verseOrgIds": [
              "2CH.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu kuäär ni Atha mandɔɔŋdɛ ni Maaka woc kä ɣöö ɛ ciek kua̱r, kɛ ɣöö cɛ kuth Ä-ce-ra täth. Kä cu Atha kuoth mandɔɔŋdɛ da̱k piny, kä cuɛ jɛ waŋ rɛy tɔ̱ɔ̱rä Kid-ron. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.16",
            "verseOrgIds": [
              "2CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö gua̱th pali kuthni baaŋ /ka̱n kɛ däk kä Juda",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:17",
              "type": "text"
            },
            {
              "text": "Juda",
              "type": "text"
            },
            {
              "text": "Kä bok thuɔk Ɣi-bɛ-ru latdɛ jɛ i̱ I-thɛ-rɛl.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Kä cu Atha lɔcdɛ ka̱m Kuɔth Nhial kɛ ni̱n teekädɛ diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.17",
            "verseOrgIds": [
              "2CH.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ muc yäcä gua̱n kɛnɛ muc yäcädɛ nööŋ rɛy luaak Kuɔth, da̱a̱p kɛnɛ ciɛk in bo̱r kɛ kuak. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.18",
            "verseOrgIds": [
              "2CH.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ thil ko̱r kɛ run ruëc Atha ti jiɛn diɔ̱k wi̱cdɛ dhieec.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
      ]
    }
  ],
