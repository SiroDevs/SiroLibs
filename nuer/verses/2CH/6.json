        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Thɔ-lo-mon kɛ naath",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pal Thɔ-lo-mon kɛ kui̱ leyä",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Thɔ-lo-mon cuɔ̱ŋ nhiam yi̱kä Kuɔth Nhial nhiam dolä ji̱ I-thɛ-rɛl diaal, kä cuɛ tetkɛ tar palɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ gua̱a̱th cuŋä la̱t kɛ ciɛk in yian mi bär jɔakdɛ jua̱th tetni da̱ŋ dhieec kä ɣäp ɣääpdɛ jua̱th tetni da̱ŋ dhieec kä bärɛ nhial ɛ jua̱th tetni da̱ŋ diɔ̱k, kä cuɛ jɛ la̱th däär kal. Kä cuɛ wä cuɔ̱ŋ thi̱n. Kä cuɛ rɔ ka̱m mua̱a̱l thi̱n nhiam dolä ji̱ I-thɛ-rɛl diaal, kä cuɛ tetkɛ tar nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ wee, “Aɣ Kuoth Nhial, Kuoth I-thɛ-rɛl, thilɛ Kuoth mi päär kɛ ji̱ nhial kiɛ piny, mi tiit gukdɛ, kä nyuth nɛɛkɛ tin guɔ̱ɔ̱rkɛ jɛ kɛ lɔcdiɛn kɛɛliw nhök mi thil pek. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ci ruacdu mëë ci lat kɛ gua̱a̱r ja̱ŋdu ni Dee-bid tit. Kä ɛn walɛ ci laat diaal a thuɔ̱ɔ̱k. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ lö Kuoth Nhial, Kuoth I-thɛ-rɛl tit ruac ëë ci lat kɛ gua̱a̱r ja̱ŋdu ni Dee-bid, mëë wi̱i̱ i̱, ‘/Ci bi met thil ram mi la kuäär nhiamdä kä I-thɛ-rɛl, mi wä gaatku ŋuɔ̱tkä wä tit ce̱tkɛ min ci la̱t.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä täämɛ lö Kuoth Nhial, Kuoth I-thɛ-rɛl, ku ruac ëë ci la̱r ja̱ŋdu ni Dee-bid jak kä thuɔ̱k.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä ɛn duɔ̱ɔ̱r ɛ thuɔ̱k ɛn ɣöö dëë Kuoth cieŋ piny kɛɛl kɛ naath? Kä cäŋɛ ni pua̱a̱r nhial /cɛ ji̱ dëë naŋ. Kä ku kuɛ̈ɛ̈ luak ɛ ca täthɛ lɛ ni̱n ɛ di! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä Kuoth Nhial Kuothdä liŋ pal jäŋädu, kä käm ni ɣä mi ca thiec ɛ nhiamdu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛ waŋdu guic luaak ɛ mi kɛ wäär kɛnɛ cäŋdäär, ɛ jɛn gua̱a̱th in ci lar i̱ bi ciötdu te thi̱n. Kä liŋ pal jäŋädu mi palɛ a cɛ wi̱cdɛ luɔc guäth ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŋ palä kɛnɛ pal nɛɛniku ni ji̱ I-thɛ-rɛl mi palkɛ a ca wuɔ̱thkiɛn riet ɛn guäth ɛmɛ. Liŋɛ ni nhial guäth cieŋädu, kä mi wi̱i̱ jɛ liŋ päli nɛy ikä.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ci raan gua̱n thieekädɛ lät kä duer, kä ca thiec kɛ ya̱c, kä bɛ ben ya̱c nhiam yi̱kädu rɛy luaak ɛmɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "liŋɛ ni nhial lö Kuoth Nhial, luk kam ja̱a̱ŋniku, kä ku gua̱n dui̱rä duerɛ la̱th ni wi̱i̱dɛ kä ku gua̱n cuŋä ka̱m cuɔ̱ɔ̱ŋdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi waa nɛɛku ni ji̱ I-thɛ-rɛl wä joc ɛ gua̱n tɛ̈r kɛ ɣöö ca ji̱ duer duer, mi wäkɛ luny kä ji̱, kä bikɛ pal latkɛ dueriɛn nhiamdu luaak ɛmɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŋ ɛ ni nhial, kä päl duer nɛɛku ni ji̱ I-thɛ-rɛl, kä loc nikɛ muun ëë ci ka̱mkɛ kɛnɛ gua̱ni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ci ɣɔw thil nhiaal kɛ ɣöö ca ji̱ duer duer ɛ nɛɛku, mi wäkɛ pal luɔckɛ nhiamdiɛn ɛn luaak ɛmɛ, kä ba dueerkiɛn lat, kɛ ɣöö cikɛ moc riɛk, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "liŋkɛ ni nhial, kä päli ja̱a̱ŋku ni ji̱ I-thɛ-rɛl dueriɛn nyuth, nikɛ duɔ̱p in dëë guɔ̱ɔ̱r. Kä moc kɛ nhiaal muundiɛn ëë ci ka̱m kɛ ala duŋdiɛn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi ci mun tekɛ buɔth kiɛ kɔ̱m kiɛ kɔryɔm kiɛ rak, kiɛ mi ca nɛɛku go̱l ɛ ji̱ tɛ̈riɛn, kiɛ liaw rɛydiɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "palɔ ba palɔ kiɛ thiec ɔ ba thiec ɔ ɛ raandu mɔ kä ji̱ I-thɛ-rɛl diaal, kɛ lɔc mi jiɛth, kä bɛ tetkɛ cuɔ̱ŋ lotdä luaak ɛmɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "liŋɛ ni nhial guäth cieŋädu. Kä pälikɛ ikä, kä lätni raan ce̱tnikɛ min ro̱ŋ kɛ jɛ. (Kɛ ɣöö ɛ ji̱n kä rɔa ŋäc lo̱c ɔ). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ ba ji̱ luɔ̱th, kä ba guɔ̱ɔ̱r ni dupku gua̱thni diaal teekädiɛn muun ëë ci ka̱m gua̱nikɔ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inɔ bä kä ram mi juɔ̱r mi /ci mɔ a raan nɛɛniku ni ji̱ I-thɛ-rɛl, mi bä guäth mi na̱n, kɛ ɣöö cɛ di̱t bumä cio̱tädu liŋ, kä bɛ ben pal lotdä luaak ɛmɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "liŋɛ ni nhial guäth cieŋädu. Kä lätni mɔ cɛ thiec kä ji̱ mɔ, kɛ ɣöö bi dör wec muɔ̱ɔ̱n diaal ji̱ ŋa̱c kä ba ji̱ luɔ̱th, ce̱tkɛ min la̱tkɛ ɛ nɛɛku ni ji̱ I-thɛ-rɛl. Kɛn ɣöö ba ɛn luak ɛ ca la̱tdɛ ŋa̱c ɛn ɣöö cɔalkɛ jɛ kɛ ciötdu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
