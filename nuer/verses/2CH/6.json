          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä mi wä nɛɛku nyiëëny kɛ ji̱ tɛ̈riɛn kɛ duɔ̱ɔ̱p ɔ ci jäk ni kɛ mɔ, mi wä ji̱ pal a ca nhiamdiɛn luɔc ɛn wi̱c ɛ ci mɛk ɛ kɛnɛ luak ɛ ca ta̱th kɛ kui̱ cio̱tädu ɛ, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "liŋ paliɛn ni nhial, kä käm nikɛ min ca thiec.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
