            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ thuɔ̱k runä, cu rɛm ji̱ A-thi-ri-ya Yo-ac ben mak. Kä cukɛ Juda kɛnɛ Jɛ-ru-tha-lɛm käp, kä cua bööth diaal näk rɛy nath. Kä cukɛ pɛ̈ɛ̈c ti ŋuan jäk kä kuäär Da-math-kɛth. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cäŋ ci rɛm A-thi-ri-ya ben kɛ nɛy ti tɔt, la Kuoth Nhial kä ka̱m ji̱ I-thɛ-rɛl ti ŋuan, kɛ ɣöö ca Kuoth Nhial, Kuoth gua̱ni pa̱l ruëëc. Kä cua luk ɛmɔ la̱th wi̱i̱ Yo-ac.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
