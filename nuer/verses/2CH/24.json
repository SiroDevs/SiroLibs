        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu ji̱ A-thi-ri-ya Yo-ac ba̱ny piny kɛ buɔ̱ɔ̱t ti ŋuan. Kä cu ji̱ kɔaarɛ jɛ ca̱p mi jiääk kɛ kui̱ gatdä Yɛ-ɣo-ya-da bo̱o̱th palä mëë cɛ näk, kä cukɛ jɛ näk rɛy kölikɛ. Kä cua jɛ kony därwec Dee-bid, kä duundɛ ɣöö /ka̱nɛ kony rɛy kɔ̱a̱kni kua̱ri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä nɛy tëë ca̱pkɛ ca̱p mi jiääk ɛ Dha-bad gat Cim-ath kä A-mon kɛnɛ Yɛ-ɣo-dha-bad gat Cim-rith kä Mo-ab. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱ gankɛ ci go̱o̱k ti ŋuan ruac kɛ jɛ, kɛ kui̱ luaak Kuɔth in cɛ bany, cakɛ gɔ̱a̱r rɛy warɛgakä ŋi̱i̱cni rɛy buɔk kua̱r. Kä cu gatdɛ ni Ä-mä-dhi-ya ruëc kɛ gua̱thdɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
