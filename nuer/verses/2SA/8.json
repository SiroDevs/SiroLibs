          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rëp Dee-bid kɛ kuäärɛ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kɔr kä nɛmɛ cu Dee-bid ji̱ Pi-li-thɛt joc, kä cuɛ kɛ jak kä kuaany kä cuɛ Mɛ-thɛg-ɛ̈maa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:1",
              "type": "text"
            },
            {
              "text": "Mɛ-thɛg-ɛ̈maa.",
              "type": "text"
            },
            {
              "text": "Kɛ thok Ɣi-bɛ-ru kuec kɛ luɔtdɛ duundɛ ɣöö kä, Bok 1 Kuɛ̈ɛ̈ni cio̱k kä 18:1 cɔal kɛ jɛ i̱, “Gɛ̈th”.",
              "type": "text"
            }
          ]
        },
        {
          "text": " luɔ̱c jɔk kä kɛ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.1",
            "verseOrgIds": [
              "2SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ ji̱ Mo-ab joc bä, kä cuɛ kɛ jak kä tɔ̱ɔ̱ckɛ cuɛ bäriɛn thɛm kɛ dep. Cuɛ nɛy tin ciek ciëëk näk, kä cuɛ nɛy tin bärikɛn päl a tëk. Kä cu ji̱ Mo-ab a kuaany Dee-bid ti luɔ̱nykɛ jɛ tho̱lbo̱k.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.2",
            "verseOrgIds": [
              "2SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid Ɣä-dɛ̈d-ɛdhɛr gat Rɛ-ɣob kuäär Dho-baa lɛni joc, mëë cɛ buɔ̱m wä jek kiir Yu-pɛ-ree-tidh. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.3",
            "verseOrgIds": [
              "2SA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid ji̱ jiöŋkööri ti bathdɔɔr kɛl wi̱cdɛ kur bärɔw käp, kɛ rɛm nɛɛni ti bathdɔɔri ti jiɛɛn da̱ŋ rɛw. Kä cuɛ jiöŋkööri diaal dɔ̱a̱ŋkiɛn ŋuɔk, cuɛ päl ni jiöŋkööri ti ro̱ŋ kɛ thurbiɛɛli ti kuɔ̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.4",
            "verseOrgIds": [
              "2SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci ji̱ Thi-ri-ya tëë cieŋ kä Da-math-kɛth ben, ba Ɣä-dɛ̈d-ɛdhɛr kuäär Dho-baa ben luäk, cu Dee-bid kɛ näk nɛy ti bathdɔɔri ti jiɛɛn da̱ŋ rɛw wi̱cdɛ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.5",
            "verseOrgIds": [
              "2SA.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid wec Da-math-kɛth moc kɛ rɛm. Kä cu ji̱ Thi-ri-ya a kuaanykɛ ti luɔ̱ny kɛ jɛ tho̱lbo̱k. Kä cu Kuoth Nhial jɛ kam buɔ̱m mi joocɛ naath gua̱thni diaal ti̱n cɛ wä thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.6",
            "verseOrgIds": [
              "2SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ köötni dääpä tin jäl kɛ nɛɛ Ɣä-dɛ̈d-ɛdhɛr käp, kä cuɛ kɛ nööŋ kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.7",
            "verseOrgIds": [
              "2SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ yiëëth in yian mi di̱i̱t ka̱n kä Bɛtɛ̈ kɛnɛ Bɛ-ro-thay wi̱i̱ Ɣä-dɛ̈d-ɛdhɛr.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.8",
            "verseOrgIds": [
              "2SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mëë ci Toy kuäär Ä-math ɛ liŋ ɛn ɣöö ci Dee-bid rɛm Ɣä-dɛ̈d-ɛdhɛr joc kɛɛliw. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cu Toy gatdɛ ni Yo-ram jäk kä kuäär ni Dee-bid, kɛ ɣöö bɛ jɛ wä lät kä mal, kɛ ɣöö cɛ nyiëëny kɛ Ɣä-dɛ̈d-ɛdhɛr kä cɛ jɛ joc. Kɛ ɣöö cikɛ kɔn nyiëëny kɛ Ɣä-dɛ̈d-ɛdhɛr, kä cu Yo-ram ciɛk in yian nööŋ kɛɛl kɛ jɛ amäni da̱a̱p kɛnɛ ciɛk in bo̱r. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛn tɔ̱tɔ̱ cu kuäär ni Dee-bid kɛ lëy Kuoth Nhial, kɛɛl kɛ ciɛk in bo̱r mëë känɛ kä nɛy diaal tëë cɛ joc. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tëë cɛ ka̱n kä ji̱ Ɛ-dɔm,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:12",
              "type": "text"
            },
            {
              "text": "Ɛ-dɔm.",
              "type": "text"
            },
            {
              "text": "Ɛ-dɔm tha̱a̱ŋ Buɔkni Ɣi-bɛ-ru cɔal kɛ jɛ i̱ Ä-ram.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kɛnɛ ji̱ Mo-ab, kɛ ji̱ Am-on, kɛnɛ ji̱ Pi-li-thɛt, kɛ ji̱ Ä-ma-lek kɛ tëë diaal tëë pɛɛcɛ kä Ɣä-dɛ̈d-ɛdhɛr gat Rɛ-ɣob kuäär Dho-baa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dee-bid rɔ moc kɛ kɛ̈k mëë lunyɛ jɔk, cuɛ nɛy ti bathdɔɔri wäl bädäk näk kä ji̱ Ɛ-dɔm rɛy Lo̱o̱lä Milɛkä. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cuɛ rɛm la̱th kä Ɛ-dɔm. Kä cu ji̱ Ɛ-dɔm diaal a kuaany Dee-bid, kä cu Kuoth Nhial ɛ ka̱m juc nath gua̱thni diaal tin cɛ wä thi̱n.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ji̱ kɔaar Dee-bid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.14",
            "verseOrgIds": [
              "2SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cu Dee-bid I-thɛ-rɛl ruac kɛɛliw. Kä cuɛ nɛɛkɛ diaal ruac agɔaa kä cuɛ kɛ ciɛŋ a päär. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.15",
            "verseOrgIds": [
              "2SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Yo-ab gat Dhɛ-ru-yaa te wi̱i̱ rɛ̈m. Kä cu Yɛ-ɣo-ca-pat gat Ä-ɣi-lud a bulkamiin. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.16",
            "verseOrgIds": [
              "2SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Dha-dok gat Ä-ɣi-tub kɛnɛ Ä-ɣi-mɛ-lɛk gat Ɛb-ya-thar a bööth palä. Kä cu Thɛ-ra-yaa a bolith. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.17",
            "verseOrgIds": [
              "2SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Bɛ-na-yaa gat Yɛ-ɣo-ya-da te wi̱i̱ ji̱ Kɛ-reth kɛnɛ ji̱ Pɛ-lɛth. Kä cu gaat Dee-bid a bööth palä.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.18",
            "verseOrgIds": [
              "2SA.8.18"
            ]
          }
        }
      ]
    }
  ],
