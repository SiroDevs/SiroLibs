              "ISA.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial nɛmɛ lar wëë i̱, “Ca yɛ kɔak kɛ baŋ, kä ba yɛ luɛl a thil yio̱w. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö ci Kuäär ni Kuoth ruac ɛn ɣöö kɛ nhiam ci nɛɛkä wä kä I-jëp kɛ ɣöö bikɛ wä cieŋ thi̱n, kä cu ji̱ A-thi-ri-ya kɛ wä ciɛŋ ɛ jiäk ni baaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cu Kuoth Nhial lɛni ruac ɛn ɣöö täämɛ min cä liŋ /ciɛ ɣöö ca nɛɛkä naŋ ni baaŋ a thil luɔt? Kä wiee ni nɛy tin ruackɛ kɛ, kä lökɛ ni ciötdä ni ciaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ kui̱c ɛmɔ bi nɛɛkä ciötdä ŋa̱c, kɛ kui̱c ɛmɔ bikɛ jɛ ŋa̱c ɛn cäŋ ɛmɔ ɛn ɣöö ɛ ɣän ruac ɔ, kɛ thuɔ̱k ɛ ɣän.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cuɔ̱c jäŋä",
          "type": "text"
        }
      ]
    }
  ],
