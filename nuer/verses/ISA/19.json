            "sid": "ISA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mɛmɛ ɛ ruac go̱o̱kä kɛ kui̱ I-jëp.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi ji̱ I-jëp ce̱tnikɛ män, bikɛ dual kɛ duäc in nöŋkɛ kɛ ɛ Kuoth Nhial in la Ruey Ɣɔaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mun Juda bɛ ji̱ I-jëp jakä dual, kä ram ɔ ba la̱r ciöt Juda mɔ bɛ dual ɛlɔ̱ŋ kɛ kui̱ kä min caar Kuoth Nhial in la Ruey Ɣɔaa ɛ kɛ kui̱diɛn.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bi I-jëp kɛnɛ A-thi-ri-ya Kuoth Nhial pal",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi wi̱i̱ da̱ŋ dhieec kä I-jëp ruac kɛ thok ji̱ Kɛ-naan, kä bikɛ rɔ̱ yac kɛ ciöt Kuɔth Nhial in la Ruey Ɣɔaa. Kä ba wec kɛl thi̱n cɔli Wec Ca̱ŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bi Kuoth Nhial tekɛ yi̱k ni däär muɔ̱ɔ̱n I-jëp, kä bɛ tekɛ riäk këthdɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bɛ la nyuuth kɛ kui̱ Kuɔth Nhial in la Ruey Ɣɔaa muun I-jëp. Mi wäkɛ Kuoth Nhial thiec kɛ luäk kɛ kui̱ gua̱n tɛ̈riɛn, bɛ kɛ jäkä kään mi bikɛ gaŋ kä bikɛ luäk. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bi Kuoth Nhial rɔ jak kä ŋa̱ckɛ ɛ ji̱ I-jëp, kä bikɛ Kuoth Nhial ŋa̱c ɛn cäŋ ɛmɔ. Bikɛ Kuoth Nhial thöp luuri kɛ muc tin waŋkɛ, kä bikɛ rɔ̱ yac kɛ ti ba thöp Kuoth Nhial ti ba la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bi Kuoth Nhial ji̱ I-jëp moc kɛ juey, bɛ kɛ duäc kä bɛ kɛ jak kä gɔw, bikɛ luny kä Kuoth Nhial, kä bɛ paliɛn liŋ, kä bɛ kɛ jak kä gɔw.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ bɛ tekɛ duɔ̱ɔ̱p mi di̱i̱t mi jiɛy kä I-jëp wëë kä A-thi-ri-ya, bi ji̱ A-thi-ri-ya wä kä I-jëp, kä bi ji̱ I-jëp wä kä A-thi-ri-ya, kä bi ji̱ I-jëp kɛnɛ ji̱ A-thi-ri-ya Kuoth pal kɛɛl.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛn cäŋ ɛmɔ I-thɛ-rɛl bɛ la diɔ̱ɔ̱k I-jëp kɛnɛ A-thi-ri-ya ɛla puɔ̱th wi̱i̱ muɔ̱ɔ̱n, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "min bi Kuoth Nhial in la Ruey Ɣɔaa ɛ pothnikɛ wëë i̱, “Ɛ puɔ̱th tekɛ nɛɛkä ni ji̱ I-jëp kɛnɛ ji̱ A-thi-ri-ya la̱t tetkädä kɛ ji̱ I-thɛ-rɛl duŋdä.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
