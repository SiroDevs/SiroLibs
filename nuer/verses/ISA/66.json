        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kä nɛy tin ca rɔ̱ lɛy tin ca pua̱nykiɛn jak kä gɔw kɛ ɣöö bikɛ kuth wä pal rɛy ka̱a̱kni walkiɛn, nɛy tin guɔ̱ɔ̱rkɛ rɔ̱ wa ri̱ŋ kuɔ̱ndhuɔ̱ɔ̱r cam kɛnɛ tin kɔ̱ŋ tin jiäk, bi kɛn diaal guut ni kɛɛl,” ruac ni ɣän Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ɣän ŋa̱cä lätkiɛn kɛnɛ cärkiɛn kä gua̱a̱th ɛ bëëni kɛ ɣöö bi döör diaal kɛnɛ lëëp diaal ben kɛɛl, bikɛ buaydä ben nɛn, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kä bä nyuuth la̱th rɛydiɛn. Kä bä tha̱a̱ŋ nɛɛni tin ŋot kɛ tëk rɛydiɛn jäk kä rɛy dööri, bä kɛ jäk kä Tar-cic kɛ Pul kɛ Lud nɛy tin ŋa̱ckɛ yor bäärä kɛ Tu-bal kɛnɛ Ya-wan kɛ wi̱i̱ diaal tin nɔ̱a̱n nɔa̱a̱n tin /ka̱n kɛ̈kdä met liŋ kä /ken buaydä met nɛn, bikɛ gɔɔydä lat rɛy dööri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bikɛ gaatmuɔɔri nööŋ rɛy dööri diaal ce̱tkɛ muc ti thöpkɛ Kuoth Nhial, bikɛ ben a cikɛ kɔt kɛ jiöŋkööri kɛ muɔ̱li kɛ thurbiɛɛli kɛ thɔ̱a̱rɔa̱a̱li bäkɛ wi̱i̱ pa̱a̱mdä min rɛl rɔ ni Jɛ-ru-tha-lɛm, ce̱tnikɛ min la ji̱ I-thɛ-rɛl muc bɛɛl a no̱o̱ŋ kɛ kuak ti gɔw rɛy luaak Kuɔth Nhial. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä bä tha̱a̱ŋkiɛn kuany ala bööth palä kɛnɛ ji̱ Lii-bay,” ruac ni ɣän Kuoth Nhial.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
    {
