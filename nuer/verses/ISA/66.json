        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 66:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kɛn bikɛ wä raar ba pua̱ny nɛɛni tin ci li̱w tëë ci rɔ̱ luɔ̱c ɣä wä nɛn, kä /ci lɔa̱a̱t tin camkɛ kɛ bi li̱w, kä thilɛ mi bi mac in waaŋkɛ yieny, bi kɛn a ti jiäk kä nɛy diaal.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
          }
        }
