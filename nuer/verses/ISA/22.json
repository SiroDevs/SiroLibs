            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ ruac go̱o̱kä kɛ kui̱ lo̱o̱lä nyuuthä.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac Kuɔth kɛ kui̱ Cɛb-na",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
