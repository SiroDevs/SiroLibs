        "style": "s1"
      },
      "items": [
        {
          "text": "Ruac go̱o̱kä mi jiääk kɛ kui̱ Jɛ-ru-tha-lɛm",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
