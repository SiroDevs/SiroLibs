              "type": "text"
            }
          ]
        },
        {
          "text": "Kä mi wä ji̱ Mo-ab wä nhial guäth palä, bikɛ cuc ni rɔ̱diɛn, mi wäkɛ wä pal rɛy luaakdiɛn, thilɛ mi bi rɔ luɔ̱tkɛ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        }
