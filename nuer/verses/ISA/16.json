          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nɛmɛ ɛ jɛn min ci Kuoth Nhial ɛ lat kɛ kui̱ Mo-ab mëëdan. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.13",
            "verseOrgIds": [
              "ISA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duundɛ ɣöö ɛn täämɛ ci Kuoth Nhial wee i̱, “Kɛ run da̱ŋ diɔ̱k ti ce̱tkɛ run raam mi juɔ̱rkɛ ni jɛ, ba kuak Mo-ab kɛnɛ ji̱kɛ tin ŋuan lo̱k, bi nɛy tin ci kään thi̱n a nɛy ti tɔt ti thil lua̱ŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
          }
        }
      ]
