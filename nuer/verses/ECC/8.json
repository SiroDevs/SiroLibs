{
  "id": "ECC.8",
  "number": "8",
  "bookId": "ECC",
  "reference": "Ŋi̱I̱C 8",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
