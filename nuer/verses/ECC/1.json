            "number": "1",
            "style": "v",
            "sid": "ECC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ti̱ti̱ kɛ ruaacni ŋi̱i̱cä gat Dee-bid kuäär kä Jɛ-ru-tha-lɛm.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.1",
            "verseOrgIds": [
              "ECC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋäc ŋɔaani thilɛ jɛ luɔt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.11",
            "verseOrgIds": [
              "ECC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän ŋi̱i̱c cä kɔŋ a kuäär I-thɛ-rɛl kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.12",
            "verseOrgIds": [
              "ECC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cua̱ jɛ go̱r kɛ ŋäc wecdä ɛn ɣöö dëë tin diaal tin ca la̱t rɛy ɣɔaa ŋa̱c. Cua̱ jɛ jek ɛ la̱t mi thiɛk ci Kuoth ɛ ka̱m naathɛ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.13",
            "verseOrgIds": [
              "ECC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cua̱ kɛn diaal nɛn kɛn tin ca la̱t rɛy ɣɔaa. Kä nɛnɛ, kɛn diaal thilɛ kɛ luɔt, ce̱tdɛ kɛ wuɔ̱ɔ̱r kɔr jiɔam.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.14",
            "verseOrgIds": [
              "ECC.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.15",
            "verseOrgIds": [
              "ECC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ rɔ jiök i̱, “Ta̱a̱ kɛ ŋäc pɛlä mi di̱i̱t kä nɛy diaal tëë ci ruëc kä Jɛ-ru-tha-lɛm nhiamdä. Kä ci wi̱cdä thia̱a̱ŋ kɛ ŋäc kɛnɛ tiit ŋɔaani mi di̱i̱t.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.16",
            "verseOrgIds": [
              "ECC.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jɛ lɛ go̱r ɛn ɣöö bä ŋäc ŋɔaani kɛnɛ pɛl kɛ yɔ̱ɔ̱ŋ kɛ dɔ̱ɔ̱r lɛni ŋa̱c. Kä cua̱ jɛ lɛni jek ɛ wuɔ̱ɔ̱r kɔɔr jiɔam.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.1.17",
            "verseOrgIds": [
              "ECC.1.17"
            ]
          }
        }
      ]
    }
  ],
