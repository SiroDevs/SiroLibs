  "bookId": "ECC",
  "reference": "Ŋi̱I̱C 2",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ECC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Go̱r tɛthä lɔaac thilɛ jɛ luɔt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jɛ lɛ car kɛ lɔcdä i̱, “Bä ŋa̱c, ɛn ɣöö ɛŋu ro̱ŋ ŋɔaani ti gɔw.” Kä cua̱ jɛ jek bä thilɛ jɛ luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jɛ jek bä to̱k ɛ dɔ̱ɔ̱r. Kä ro̱ŋ ŋɔaani ti gɔw thilɛ mi lätdɛ kä ji̱. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ maath kɛ kɔaŋ kɛ ɣöö bi lɔcdä tɛɛth, cua̱ ŋot gaŋ pɛl wecdä ɣä. Cua̱ jɛ go̱r i̱ dëë min lät naathɛ nɛn rɛy ɣɔaa kɛ ni̱n teekädiɛn ti tɔt ti̱ti̱. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ ti di̱t la̱t. Cua̱ duël la̱t, kä cua̱ rɔ pi̱eth ka̱a̱k wal kɛ kui̱ kɔaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ rɔ lät kä ka̱a̱k wal, kä cua̱ kɛ pith kɛ wäŋ dɛɛni jiɛn diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ rɔ tët puɔ̱l ti wacä jiɛn thi̱n. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ kɔk kɛ kuany wutdä kɛnɛ kuany ciëk, kɛ kuaany ti kɔ̱ŋ ti dapkɛ dhɔrä. Kä cu te ni ɣän kɛ ɣɔ̱k kɛnɛ dët ti ŋuan kä nɛy tëë cieŋ kä Jɛ-ru-tha-lɛm. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ rɔ duɔ̱l ciɛk in bo̱r kɛnɛ da̱a̱p amäni ria̱ŋ kua̱ri rööl ëë ruaacä. Kä ta̱a̱ kɛ wutni kɛnɛ män ti tuar nhiamdä, kä cua̱ tekɛ män ti luɔɔm ce̱tkɛ min dee lɔc ran ɛ go̱r.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ rɔ jek di̱t ni ɣän kä nɛy diaal tin cieŋ kä Jɛ-ru-tha-lɛm. Kä cu ŋäc ŋɔaanidä ŋot thi̱n kɛ ɣä kɛɛl. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä tin diaal tin göörä, cä kɛ jek. Kä cua̱ tekɛ tɛ̈th lɔaac, kɛ ɣöö ci lɔcdä tɛɛth kɛ tin diaal tin cä la̱t, kä kɛn ti̱ti̱ kɛ kɛn tin cä jek kä läk kä diaal. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä min guɛcä tin diaal tin cä la̱t kɛ tetkä kɛnɛ la̱t in cä luäŋ. Cu kɛn diaal thil luɔt, cua ni wuɔ̱ɔ̱r kɔɔr jiɔam. Thilɛ mi dëë jek rɛy ɣɔaa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋäc ŋɔaani kɛnɛ dɔ̱ɔ̱r thilɛ kɛ luɔt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cua̱ ŋäc ŋɔaani kɛ yɔ̱ɔ̱ŋ kɛ dɔ̱ɔ̱r lɛ car. Cua̱ jɛ jek lät kuäär ni mi ci kuäär in nhiam ɛ kɔŋ la̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua̱ jek ni ɣöö gɔaa ni ŋäc kä dɔ̱ɔ̱r, ce̱tkɛ min gɔaa ni buay kä muth.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä cua jɛ mir ɛn ɣöö riɛk bɛ ben kä kɛn da̱ŋ rɛw. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän cua̱ jɛ car bä i̱, “Bä cuuc kɛ jɛn riɛkɔ bi dɔ̱a̱r cucɔ. Kä kuɛ la ŋu bä jek ɔ kä pɛl?” Kä cua̱ jɛ jek bä thilɛ jɛ luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ram mi pɛl, bɛ ce̱tnikɛ ram mi dɔ̱a̱r /cakɛ bi tim, kɛ ni̱n tɔ̱ bi ben tɔ̱, ba kɔn diaal pa̱l rueec. Bi ram mi pɛl pɛl li̱w ce̱tnikɛ ram mi dɔ̱a̱r! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ ɣän lökä tëk, kɛ ɣöö min cɛ la̱t rɛy ɣɔaa ɛ riɛk kä ɣä. Kɛn diaal thilɛ kɛ luɔt, ɛ wuɔ̱ɔ̱r kɔr jiɔam.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "La̱t thilɛ jɛ luɔt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɣän lökä lät kä diaal tin cä la̱t rɛy ɣɔaa, kɛ ɣöö bäkɛ ba̱ny ram mi bi lɔ̱ɔ̱ ben kɔɔrä. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ɛŋa ŋäcɛ mɔ ɛn ɣöö ba ram mi pɛl pɛl kiɛ dɔ̱a̱r? Kä bɛ tin diaal tin cä la̱t kɛ buɔ̱mdä rɛy ɣɔaa ka̱n. Kä nɔmɔ bä thilɛ jɛ luɔt. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inɔ cua̱ lät kä diaal tëë cä la̱t rɛy ɣɔaa tim, kä cu lɔcdä jiäk. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kɛ ɣöö bi raan ti cɛ la̱t kɛ ŋäc ŋɔaanidɛ kɛnɛ pɛlɛ kɛ buɔ̱mdɛ ba̱ny piny, a ba kɛ lɔ̱ɔ̱ ka̱n ɛ ram mi /ken kɛ la̱t. Ɛn nɔmɔ bä thilɛ jɛ luɔt, ɛ duer mi di̱i̱t. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ɛŋu mi bi raan ɛ jek kä lät diaal tin ca jɛ cuc rɛy ɣɔaa? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kä ni̱nkɛ diaal ɛ la̱t mi bɛc bɛc kä ɛ cuɔ̱c kɛnɛ jiääk lɔaac. Kä cärɛ kɛ wäär a thil lɔ̱a̱ŋ bä. Kä ɛn nɛmɛ bä thilɛ jɛ luɔt.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thilɛ mi gɔaa kä raan ɛ ni ɣöö bɛ mi̱th kä bɛ maath kɛ kɔaŋ bɛɛl tin cɛ la̱t a bi lɔcdɛ ro̱ŋ. Kä cua̱ jɛ jek bä bëë tetdä Kuɔth, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kɛ ɣöö mi thil ni jɛn, ɛŋa mi dee mi̱th kiɛ dee tɛ̈th lɔaac jek? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
              "ECC.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
