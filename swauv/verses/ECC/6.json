                  "text": "Zab 58:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mtu akizaa watoto mia, akaishi miaka mingi, nazo siku za maisha yake ni nyingi, lakini nafsi yake haikushiba mema; tena ikiwa, zaidi ya hayo, amekosa maziko; mimi nasema, Heri mimba iliyoharibika kuliko huyo; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaani, hiyo huja katika ubatili, na huenda gizani, nalo jina lake limefunikwa giza; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tena, haikuliona jua wala kulifahamu; basi, hii imepata kustarehe kuliko yule; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naam, ajapoishi miaka elfu mara mbili, asijiburudishe kwa mema; je! Wote hawaendi mahali pamoja?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
