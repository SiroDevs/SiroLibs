          "text": "bali kwa matendo mema, kama iwapasavyo wanawake wanaoukiri uchaji wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.10",
            "verseOrgIds": [
              "1TI.2.10"
            ]
