                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wala Adamu hakudanganywa, ila mwanamke alidanganywa kabisa akaingia katika hali ya kukosa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
