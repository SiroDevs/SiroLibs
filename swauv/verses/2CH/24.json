        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.2"
              },
              "items": [
                {
                  "text": "2 Nya 25:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.5"
              },
              "items": [
                {
                  "text": "26:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yoashi akafanya yaliyo mema machoni pa BWANA siku zote za Yehoyada kuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada akamwoza wake wawili, naye akazaa wana na binti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa baada ya haya, Yoashi alikuwa na nia ya kuitengeneza nyumba ya Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.4"
              },
              "items": [
                {
                  "text": "2 Fal 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.29.3"
              },
              "items": [
                {
                  "text": "2 Nya 29:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.8"
              },
              "items": [
                {
                  "text": "34:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akawakusanya makuhani na Walawi, akawaambia, Nendeni mijini mwa Yuda, mkakusanye katika Israeli wote fedha, ili kuitengeneza nyumba ya Mungu wenu mwaka kwa mwaka, mkafanye bidii kuliharakisha neno hili. Walakini Walawi hawakuliharakisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
