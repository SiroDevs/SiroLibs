                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalme akamwita Yehoyada mkuu wao, akamwambia, Mbona hukuwataka Walawi waitoze Yuda na Yerusalemu kodi ya Musa mtumishi wa BWANA, na ya kusanyiko la Israeli, kwa ajili ya hema ya ushuhuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
