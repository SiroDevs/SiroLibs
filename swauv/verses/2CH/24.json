        },
        {
          "text": "Yoashi alikuwa na umri wa miaka saba alipoanza kutawala; akatawala miaka arobaini huko Yerusalemu; na jina la mamaye aliitwa Sibia wa Beer-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
