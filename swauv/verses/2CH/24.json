              "type": "text"
            }
          ]
        },
        {
          "text": "Na hawa ndio waliomfanyia fitina, Zabadi mwana wa Shimeathi mwanamke Mwamoni, na Yehozabadi mwana wa Shimrithi mwanamke Mmoabi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
