                "loc": "REV.5.9"
              },
              "items": [
                {
                  "text": "Ufu 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao walipokwisha, wakaleta mbele ya mfalme na Yehoyada fedha iliyobaki, vikafanyizwa kwayo vyombo vya nyumba ya BWANA, vyombo vya utumishi, navyo vya kutolea, na miiko, na vyombo vya dhahabu na fedha. Wakatoa sadaka za kuteketezwa katika nyumba ya BWANA, daima, siku zote za Yehoyada.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
