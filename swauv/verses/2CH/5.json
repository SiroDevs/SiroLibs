                }
              ]
            }
          ]
        },
        {
          "text": "tena Walawi waimbaji, wote pia, yaani Asafu, na Hemani, na Yeduthuni, na wana wao, na ndugu zao, hali wamevaa kitani safi, wenye matoazi na vinanda na vinubi, wamesimama upande wa mashariki wa madhabahu, na pamoja nao makuhani mia na ishirini wakipiga panda;) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
