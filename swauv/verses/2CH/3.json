                "loc": "1CH.22.1"
              },
              "items": [
                {
                  "text": "1 Nya 22:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Sulemani akaanza kuijenga nyumba ya BWANA huko Yerusalemu, juu ya mlima Moria, pale BWANA alipomtokea Daudi babaye alipotengeza mahali pale alipoagiza Daudi, katika kiwanja cha kupuria cha Arauna",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:1",
              "type": "text"
            },
            {
              "text": "Au, Ornani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Myebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.1",
            "verseOrgIds": [
              "2CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaanza kujenga siku ya pili ya mwezi wa pili katika mwaka wa nne wa kutawala kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.2",
            "verseOrgIds": [
              "2CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.2"
              },
              "items": [
                {
                  "text": "1 Fal 6:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi hii ndiyo misingi ya majengo ya nyumba ya Mungu aliyoiweka Sulemani. Urefu wake kwa mikono ya cheo cha kwanza ulikuwa mikono sitini, na upana wake mikono ishirini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.3",
            "verseOrgIds": [
              "2CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.3"
              },
              "items": [
                {
                  "text": "1 Fal 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ukumbi uliokuwa mbele yake, urefu wake kadiri ya upana wa nyumba ulikuwa mikono ishirini, na kwenda juu kwake mia na ishirini; akaufunikiza ndani kwa dhahabu safi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.4",
            "verseOrgIds": [
              "2CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.17"
              },
              "items": [
                {
                  "text": "1 Fal 6:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nayo nyumba kubwa akaifunika miti ya miberoshi, aliyoifunikiza kwa dhahabu safi, akaifanyizia mitende na minyororo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.5",
            "verseOrgIds": [
              "2CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaipamba nyumba kwa vito iwe na uzuri; nayo dhahabu ilikuwa dhahabu ya Parvaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.6",
            "verseOrgIds": [
              "2CH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena, akaifunikiza kwa dhahabu nyumba, na boriti, na vizingiti, na kuta zake, na milango yake; akachora makerubi kutani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.7",
            "verseOrgIds": [
              "2CH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaifanya nyumba ya patakatifu pa patakatifu; urefu wake kadiri ya upana wa nyumba, ulikuwa mikono ishirini, na upana wake mikono ishirini; akaifunikiza kwa dhahabu safi, ya talanta mia sita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.8",
            "verseOrgIds": [
              "2CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na uzani wa misumari ulikuwa shekeli hamsini za dhahabu. Akazifunikiza orofa zake za juu kwa dhahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.9",
            "verseOrgIds": [
              "2CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.23"
              },
              "items": [
                {
                  "text": "1 Fal 6:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ndani ya nyumba ya patakatifu pa patakatifu akafanyiza makerubi mawili ya kuchonga; wakayafunikiza kwa dhahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.10",
            "verseOrgIds": [
              "2CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mabawa ya makerubi hayo urefu wake ulikuwa mikono ishirini; bawa moja mikono mitano, likiufikilia ukuta wa nyumba; na bawa la pili mikono mitano, likishikana na bawa la kerubi la pili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.11",
            "verseOrgIds": [
              "2CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bawa la kerubi la pili lilikuwa mikono mitano, likiufikilia ukuta wa nyumba; na bawa la pili mikono mitano, likishikana na bawa la kerubi la kwanza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.12",
            "verseOrgIds": [
              "2CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakaenea mabawa ya makerubi hayo mikono ishirini; yakasimama juu ya miguu yao, na nyuso zao ziliielekea nyumba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.13",
            "verseOrgIds": [
              "2CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.31"
              },
              "items": [
                {
                  "text": "Kut 26:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.51"
              },
              "items": [
                {
                  "text": "Mt 27:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.3"
              },
              "items": [
                {
                  "text": "Ebr 9:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akalifanya pazia la samawi na urujuani na nyekundu, na kitani safi, akaifanyizia makerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15"
              },
              "items": [
                {
                  "text": "1 Fal 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.21"
              },
              "items": [
                {
                  "text": "Yer 52:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena akafanya mbele ya nyumba nguzo mbili za mikono thelathini na tano kwenda juu kwake, na taji iliyokuwa juu yake moja moja ilikuwa mikono mitano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya minyororo ndani ya chumba cha ndani, akaiweka juu ya vichwa vya nguzo; akafanya makomamanga mia, akayaweka juu ya hiyo minyororo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akazisimamisha nguzo hizo mbele ya hekalu, moja upande wa kuume, na ya pili upande wa kushoto; akaliita jina la ile ya kuume Yakini,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:17",
              "type": "text"
            },
            {
              "text": "Yakini",
              "type": "text"
            },
            {
              "text": "maana yake imedhaniwa kuwa Atathibitisha.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na jina la ile ya kushoto Boazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:17",
              "type": "text"
            },
            {
              "text": "Boazi",
              "type": "text"
            },
            {
              "text": "maana yake imedhaniwa kuwa Imo nguvu.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
