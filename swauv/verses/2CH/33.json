        },
        {
          "text": "Amoni alikuwa na umri wa miaka ishirini na miwili alipoanza kutawala; akatawala katika Yerusalemu miaka miwili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
