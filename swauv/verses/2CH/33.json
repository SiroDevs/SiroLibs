            }
          ]
        },
        {
          "text": "Akaijenga madhabahu ya BWANA, akatoa juu yake dhabihu za sadaka za amani, na za shukrani, akawaamuru Yuda wamtumikie BWANA, Mungu wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
