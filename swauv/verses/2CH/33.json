                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akajenga madhabahu katika nyumba ya BWANA, napo ndipo alipopanena BWANA, Katika Yerusalemu litakuwako jina langu milele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
