              "items": [
                {
                  "text": "Zek 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha itakuwa katika siku hiyo, asema BWANA, nitawakatilia mbali farasi zako watoke kati yako, nami nitayaharibu magari yako ya vita; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
              "MIC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitaikatilia mbali miji ya nchi yako, na ngome zako zote nitaziangusha; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.11",
            "verseOrgIds": [
              "MIC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami nitakatilia mbali uchawi, usiwe mkononi mwako; wala hutakuwa tena na watu wenye kutabana; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.12",
            "verseOrgIds": [
              "MIC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.13.2"
              },
              "items": [
                {
                  "text": "Zek 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.8"
              },
              "items": [
                {
                  "text": "Isa 2:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami nitakatilia mbali sanamu zako na nguzo zako, zitoke kati yako; wala hutaiabudu tena kazi ya mikono yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.13",
            "verseOrgIds": [
              "MIC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitayang’oa maashera yenu, yasiwe kati yako; nami nitaiangamiza miji yako. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.14",
            "verseOrgIds": [
              "MIC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitajilipiza kisasi katika hasira na ghadhabu juu ya mataifa wasiosikiliza.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.15",
            "verseOrgIds": [
              "MIC.5.15"
            ]
          }
        }
      ]
