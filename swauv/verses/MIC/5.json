              "items": [
                {
                  "text": "Lk 1:71",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.8+GEN.10.9+GEN.10.10+GEN.10.11"
              },
              "items": [
                {
                  "text": "Mwa 10:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nao wataiharibu nchi ya Ashuru kwa upanga, na nchi ya Nimrodi katika malango yake; naye atatuokoa na Mwashuri, atakapoingia katika nchi yetu, na kukanyaga ndani ya mipaka yetu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
