                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na mtu huyu atakuwa amani yetu; wakati Mwashuri atakapoingia katika nchi yetu, na kuyakanyaga majumba yetu, hapo mtaondokesha wachungaji saba juu yake, na wakuu wanane. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
