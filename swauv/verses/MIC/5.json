              "items": [
                {
                  "text": "Zab 110:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hayo mabaki ya Yakobo yatakuwa kati ya kabila nyingi mfano wa umande utokao kwa BWANA, mfano wa manyunyu katika manyasi; yasiyomngojea mtu, wala kuwakawilia wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na hayo mabaki ya Yakobo yatakuwa kati ya mataifa, kati ya kabila nyingi, mfano wa simba kati ya wanyama wa msituni, kama mwana-simba kati ya makundi ya kondoo, ambaye, akiwa anapita katikati, hukanyaga-kanyaga na kurarua-rarua, wala hakuna wa kuokoa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkono wako na uinuliwe juu ya adui zako, na adui zako wote wakauliwe mbali.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        }
      ]
    },
