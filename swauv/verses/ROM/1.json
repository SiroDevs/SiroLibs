        {
          "text": "Kwanza namshukuru Mungu wangu katika Yesu Kristo kwa ajili yenu nyote, kwa kuwa imani yenu inahubiriwa katika dunia nzima. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
