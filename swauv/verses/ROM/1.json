              "items": [
                {
                  "text": "Yn 15:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini, ndugu zangu, sipendi msiwe na habari, ya kuwa mara nyingi nalikusudia kuja kwenu, nikazuiliwa hata sasa, ili nipate kuwa na matunda kwenu ninyi pia kama nilivyo nayo katika Mataifa wengine. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawiwa na Wayunani na wasio Wayunani, nawiwa na wenye hekima na wasio na hekima. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
