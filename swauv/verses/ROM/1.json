              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "wenye kusingizia, wenye kumchukia Mungu, wenye jeuri, wenye kutakabari, wenye majivuno, wenye kutunga mabaya, wasiowatii wazazi wao, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
