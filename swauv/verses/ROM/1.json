                  "text": "Efe 1:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana Mungu, nimwabuduye kwa roho yangu katika Injili ya Mwana wake, ni shahidi wangu jinsi niwatajavyo pasipo kukoma, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
