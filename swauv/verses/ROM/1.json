                  "text": "2 Pet 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "yaani, tufarijiane mimi na ninyi, kila mtu kwa imani ya mwenzake, yenu na yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
