                  "text": "32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "siku zote katika sala zangu, nikiomba nije kwenu hivi karibu, Mungu akipenda kuifanikisha safari yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
