                  "text": "Mdo 28:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana ninatamani sana kuwaona, nipate kuwapa karama ya rohoni, ili mfanywe imara; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
