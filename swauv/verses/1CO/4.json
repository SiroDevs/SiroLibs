              },
              "items": [
                {
                  "text": "22:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tukisingiziwa twasihi; tumefanywa kama takataka za dunia, na tama ya vitu vyote hata sasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
