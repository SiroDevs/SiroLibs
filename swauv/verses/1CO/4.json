                "loc": "PHP.3.17"
              },
              "items": [
                {
                  "text": "Flp 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, nawasihi mnifuate mimi. ",
          "type": "text",
          "attrs": {
