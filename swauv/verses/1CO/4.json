            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.19"
              },
              "items": [
                {
                  "text": "Gal 4:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa kuwa ijapokuwa mna waalimu kumi elfu katika Kristo, walakini hamna baba wengi. Maana mimi ndimi niliyewazaa katika Kristo Yesu kwa njia ya Injili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.15",
            "verseOrgIds": [
              "1CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
