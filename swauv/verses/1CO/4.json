              "type": "text"
            }
          ]
        },
        {
          "text": "Siyaandiki hayo ili kuwatahayarisha; bali kuwaonya kama watoto niwapendao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.14",
            "verseOrgIds": [
