                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rum 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ndugu, mambo hayo nimeyafanya kuwa mfano wa mimi na Apolo kwa ajili yenu, ili kwamba kwa mfano wetu mpate kujifunza kutokupita yale yaliyoandikwa; ili mmoja wenu asijivune kwa ajili ya huyu, kinyume cha mwenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.6",
            "verseOrgIds": [
              "1CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6"
              },
              "items": [
                {
                  "text": "Rum 12:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana ni nani anayekupambanua na mwingine? Nawe una nini usichokipokea? Lakini iwapo ulipokea, wajisifia nini kana kwamba hukupokea? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.7",
            "verseOrgIds": [
              "1CO.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.17"
              },
              "items": [
                {
                  "text": "Ufu 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mmekwisha kushiba, mmekwisha kupata utajiri, mmemiliki pasipo sisi. Naam, laiti mngemiliki, ili sisi nasi tumiliki pamoja nanyi! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.8",
            "verseOrgIds": [
              "1CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Rum 8:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.33"
              },
              "items": [
                {
                  "text": "Ebr 10:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana nadhani ya kuwa Mungu ametutoa sisi mitume mwisho, kama watu waliohukumiwa wauawe; kwa sababu tumekuwa tamasha kwa dunia; kwa malaika na wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.9",
            "verseOrgIds": [
              "1CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.18"
              },
              "items": [
                {
                  "text": "1 Kor 3:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sisi tu wapumbavu kwa ajili ya Kristo, lakini ninyi ni wenye akili katika Kristo; sisi tu dhaifu, lakini ninyi mna nguvu; ninyi mna utukufu, lakini sisi hatupati heshima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.10",
            "verseOrgIds": [
              "1CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.23+2CO.11.24+2CO.11.25+2CO.11.26+2CO.11.27"
              },
              "items": [
                {
                  "text": "2 Kor 11:23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata saa hii ya sasa, tuna njaa na kiu, tu uchi, twapigwa ngumi, tena hatuna makao; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.11",
            "verseOrgIds": [
              "1CO.4.11"
            ]
          }
        },
