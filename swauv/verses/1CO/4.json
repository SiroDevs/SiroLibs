                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini nitakuja kwenu upesi, nikijaliwa, nami nitafahamu, si neno lao tu waliojivuna, bali nguvu zao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.19",
