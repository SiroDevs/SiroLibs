                "loc": "TIT.1.7"
              },
              "items": [
                {
                  "text": "Tit 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu na atuhesabu hivi, kuwa tu watumishi wa Kristo, na mawakili wa siri za Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.1",
            "verseOrgIds": [
              "1CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.42"
              },
              "items": [
                {
                  "text": "Lk 12:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hapo tena inayohitajiwa katika mawakili, ndiyo mtu aonekane kuwa mwaminifu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.2",
            "verseOrgIds": [
              "1CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini, kwangu mimi, si kitu kabisa nihukumiwe na ninyi, wala kwa hukumu ya kibinadamu, wala sijihukumu hata nafsi yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.3",
            "verseOrgIds": [
              "1CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Zab 143:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana sijui sababu ya kujishitaki nafsi yangu, lakini sihesabiwi haki kwa ajili hiyo; ila anihukumuye mimi ni Bwana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.4",
            "verseOrgIds": [
              "1CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.8"
              },
              "items": [
                {
                  "text": "1 Kor 3:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi ninyi msihukumu neno kabla ya wakati wake, hata ajapo Bwana; ambaye atayamulikisha yaliyositirika ya giza, na kuyadhihirisha mashauri ya mioyo; ndipo kila mtu atakapoipata sifa yake kwa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        }
      ]
    },
    {
