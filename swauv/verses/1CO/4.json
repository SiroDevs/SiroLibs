                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kisha twataabika tukifanya kazi kwa mikono yetu wenyewe. Tukitukanwa twabariki, tukiudhiwa twastahimili; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.12",
            "verseOrgIds": [
              "1CO.4.12"
            ]
          }
        },
        {
