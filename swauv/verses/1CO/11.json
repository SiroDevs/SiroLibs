          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana alaye na kunywa, hula na kunywa hukumu ya nafsi yake, kwa kutokuupambanua ule mwili. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.29",
