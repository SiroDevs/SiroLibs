              "items": [
                {
                  "text": "Zek 9:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na vivi hivi baada ya kula akakitwaa kikombe, akisema, Kikombe hiki ni agano jipya katika damu yangu; fanyeni hivi kila mnywapo, kwa ukumbusho wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
