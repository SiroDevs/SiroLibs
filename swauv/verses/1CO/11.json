                  "text": "Mt 26:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana kila mwulapo mkate huu na kukinywea kikombe hiki, mwaitangaza mauti ya Bwana hata ajapo.",
          "type": "text",
          "attrs": {
