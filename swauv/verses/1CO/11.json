          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtu akiwa na njaa, na ale nyumbani kwake; msipate kukutanika kwa hukumu. Na hayo yaliyosalia nijapo nitayatengenez",
          "type": "text",
          "attrs": {
