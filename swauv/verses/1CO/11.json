                  "text": "1 The 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo wako wengi kwenu walio hawawezi na dhaifu, na watu kadha wa kadha wamelala. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
