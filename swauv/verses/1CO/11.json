              "attrs": {
                "loc": "HEB.12.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ila tuhukumiwapo, twarudiwa na Bwana, isije ikatupasa adhabu pamoja na dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.32",
            "verseOrgIds": [
              "1CO.11.32"
            ]
          }
