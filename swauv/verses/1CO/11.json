                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini mtu ajihoji mwenyewe, na hivyo aule mkate, na kukinywea kikombe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.28",
            "verseOrgIds": [
