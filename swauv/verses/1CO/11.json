          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akiisha kushukuru akaumega, akasema, Huu ndio mwili wangu ulio kwa ajili yenu; fanyeni hivi kwa ukumbusho wangu. ",
          "type": "text",
          "attrs": {
