              "items": [
                {
                  "text": "1 Tim 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo nakukumbusha, uichochee karama ya Mungu, iliyo ndani yako kwa kuwekewa mikono yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.15"
              },
              "items": [
                {
                  "text": "Rum 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana Mungu hakutupa roho ya woga, bali ya nguvu na ya upendo na ya moyo wa kiasi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.7",
            "verseOrgIds": [
              "2TI.1.7"
            ]
          }
        }
