          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana awape rehema wale walio wa mlango wake Onesiforo; maana mara nyingi aliniburudisha, wala hakuuonea haya mnyororo wangu; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
