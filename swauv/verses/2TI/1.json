              },
              "items": [
                {
                  "text": "Mdo 16:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nikiikumbuka imani uliyo nayo isiyo na unafiki, ambayo ilikaa kwanza katika bibi yako Loisi, na katika mama yako Eunike, nami nasadiki wewe nawe unayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
