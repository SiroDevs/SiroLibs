                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa Timotheo, mwanangu mpendwa. Neema na iwe kwako, na rehema, na amani, zitokazo kwa Mungu Baba na kwa Kristo Yesu Bwana wetu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
