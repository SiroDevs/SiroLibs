        },
        {
          "text": "Basi usiuonee haya ushuhuda wa Bwana wetu, wala usinionee haya mimi mfungwa wake, bali uvumilie mabaya pamoja nami kwa ajili ya Injili, kwa kadiri ya nguvu ya Mungu; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.8",
            "verseOrgIds": [
              "2TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
