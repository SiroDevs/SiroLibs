              "items": [
                {
                  "text": "1 Tim 6:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilinde ile amana nzuri kwa Roho Mtakatifu akaaye ndani yetu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
