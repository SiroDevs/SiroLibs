        {
          "text": "na sasa inadhihirishwa kwa kufunuliwa kwake Mwokozi wetu Kristo Yesu; aliyebatili mauti, na kuufunua uzima na kutokuharibika, kwa ile Injili; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
