            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waijua habari hii, ya kuwa wote walio wa Asia waliniepuka, ambao miongoni mwao wamo Figelo na Hermogene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
