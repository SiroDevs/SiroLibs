              "items": [
                {
                  "text": "1 Tim 2:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambayo kwa ajili ya hiyo naliwekwa niwe mhubiri na mtume na mwalimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
