                "loc": "TIT.2.1"
              },
              "items": [
                {
                  "text": "Tit 2:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shika kielelezo cha maneno yenye uzima uliyoyasikia kwangu, katika imani na upendo ulio katika Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
