          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo nimepatikana na mateso haya, wala sitahayari; kwa maana namjua yeye niliyemwamini, na kusadiki ya kwamba aweza kukilinda kile nilichokiweka amana kwake hata siku ile. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
