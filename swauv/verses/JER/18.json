              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.4.5"
              },
              "items": [
                {
                  "text": "Neh 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wewe, BWANA, unajua mashauri yao yote juu yangu, ya kuniua; usiwasamehe uovu wao, wala usifute dhambi yao mbele za macho yako; bali wakwazwe mbele zako; uwatende mambo wakati wa hasira yako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.23",
            "verseOrgIds": [
              "JER.18.23"
            ]
          }
