            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.16+ISA.1.17+ISA.1.18+ISA.1.19"
              },
              "items": [
                {
                  "text": "Isa 1:16-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Haya! Basi, ukawaambie watu wa Yuda, na wenyeji wa Yerusalemu, ukisema, BWANA asema hivi, Tazama, ninafinyanga mabaya juu yenu, na kuwaza mawazo juu yenu; rudini sasa, kila mmoja na aiache njia yake mbaya; zitengenezeni njia zenu, na matendo yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        }
