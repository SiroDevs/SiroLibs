              },
              "items": [
                {
                  "text": "Yer 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati wo wote nitakapotoa habari za taifa, na habari za ufalme, kuung’oa, na kuuvunja, na kuuangamiza; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.7",
            "verseOrgIds": [
              "JER.18.7"
            ]
          }
        },
