              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niangalie, Ee BWANA, ukasikilize sauti ya wanaoshindana nami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.19",
            "verseOrgIds": [
              "JER.18.19"
            ]
          }
        },
        {
