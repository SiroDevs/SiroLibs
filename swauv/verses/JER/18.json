                "loc": "ISA.64.8"
              },
              "items": [
                {
                  "text": "64:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ee nyumba ya Israeli, je! Siwezi mimi kuwatendea ninyi vile vile kama mfinyanzi huyu alivyotenda? Asema BWANA. Angalieni, kama udongo ulivyo katika mkono wa mfinyanzi, ndivyo mlivyo ninyi katika mkono wangu, Ee nyumba ya Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.6",
            "verseOrgIds": [
              "JER.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
