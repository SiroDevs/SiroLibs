        },
        {
          "text": "ikiwa taifa lile nililolitaja litageuka, na kuacha maovu yake nitaghairi, nisitende mabaya yale niliyoazimia kuwatenda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
