              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.4"
              },
              "items": [
                {
                  "text": "Zab 109:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.35.7"
              },
              "items": [
                {
                  "text": "35:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Mabaya yalipwe badala ya mema? Maana wameichimbia nafsi yangu shimo. Kumbuka jinsi nilivyosimama mbele zako, ili niseme mema kwa ajili yao, nikaigeuze ghadhabu yako isiwapate. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.20",
            "verseOrgIds": [
              "JER.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa sababu hiyo, uwatoe watoto wao waone njaa, uwatoe nguvu za upanga ziwapate; wake zao wafiwe na watoto wao, na kufiwa na waume zao; wanaume wao wauawe, na vijana wao wapigwe kwa upanga vitani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.21",
            "verseOrgIds": [
              "JER.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kilio na kisikiwe kitokacho katika nyumba zao, hapo utakapoleta kikosi juu yao kwa ghafula; kwa maana wamenichimbia shimo waninase, nao wameifichia miguu yangu mitego. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.22",
            "verseOrgIds": [
              "JER.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
