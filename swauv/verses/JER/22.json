              "items": [
                {
                  "text": "2 Nya 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atazikwa maziko ya punda, akibururwa, na kutupwa nje ya malango ya Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
