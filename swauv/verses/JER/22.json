        {
          "text": "Lakini kama hamtaki kusikia maneno haya, mimi naapa kwa nafsi yangu, asema BWANA, ya kuwa nyumba hii itakuwa ukiwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.5",
            "verseOrgIds": [
