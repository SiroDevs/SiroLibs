              "items": [
                {
                  "text": "Yer 23:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Upepo utawalisha wachungaji wako wote, na wapenzi wako watakwenda kufungwa; hakika wakati huo utatahayarika, na kufadhaika kwa sababu ya uovu wako wote.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        }
