            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kwamba, Sikia neno la BWANA, Ee mfalme wa Yuda; wewe uketiye katika kiti cha enzi cha Daudi, wewe, na watumishi wako, na watu wako wote waingiao kwa malango haya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
