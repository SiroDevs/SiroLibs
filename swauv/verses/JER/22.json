                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo watakapojibu, Ni kwa sababu waliliacha agano la BWANA, Mungu wao, wakaabudu miungu mingine, na kuitumikia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.9",
