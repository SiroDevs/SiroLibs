              "items": [
                {
                  "text": "Yer 17:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana mkifanya haya kweli kweli, ndipo watakapoingia kwa malango ya nyumba hii wafalme wenye kuketi katika kiti cha enzi cha Daudi, wanakwenda kwa magari, na wamepanda farasi yeye, na watumishi wake, na watu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.4",
            "verseOrgIds": [
              "JER.22.4"
            ]
          }
        },
