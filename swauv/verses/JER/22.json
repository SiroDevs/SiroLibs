                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama niishivyo mimi, asema BWANA, hata Konia, mwana wa Yehoyakimu, mfalme wa Yuda, angekuwa pete yenye muhuri katika mkono wangu wa kuume, ningekung’oa wewe hapo; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
