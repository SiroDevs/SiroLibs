              },
              "items": [
                {
                  "text": "Yer 34:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "nami nitakutia katika mikono ya watu wale wakutafutao roho yako, na katika mikono yao unaowaogopa, naam, katika mikono ya Nebukadreza, mfalme wa Babeli, na katika mikono ya Wakaldayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
