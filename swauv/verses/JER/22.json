        },
        {
          "text": "BWANA akasema hivi, Shuka nyumbani kwa mfalme wa Yuda, ukaseme neno hili huko, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
