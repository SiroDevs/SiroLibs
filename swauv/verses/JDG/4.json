        {
          "text": "Watu wakamwambia Sisera ya kwamba Baraka, mwana wa Abinoamu amekwea kwenda mlima wa Tabori. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.12",
            "verseOrgIds": [
