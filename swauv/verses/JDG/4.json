                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi hivyo Mungu akamshinda Yabini, mfalme wa Kanaani mbele ya wana wa Israeli siku hiyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkono wa wana wa Israeli ukazidi kupata nguvu juu ya Yabini, mfalme wa Kanaani, hata walipokuwa wamemwangamiza Yabini, mfalme wa Kanaani.",
          "type": "text",
