                "loc": "2KI.24.17"
              },
              "items": [
                {
                  "text": "2 Fal 24:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Yehoyakimu ni hawa; mwanawe Yekonia, na mwanawe Sedekia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
