          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanawe huyo ni Ahazi; na mwanawe huyo ni Hezekia; na mwanawe huyo ni Manase; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
