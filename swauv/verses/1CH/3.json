                "loc": "MAT.1.12"
              },
              "items": [
                {
                  "text": "Mt 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Yekonia, huyo aliyechukuliwa mateka; mwanawe Shealtieli, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Malkiramu, na Pedaya, na Shenazari, na Yekamia, na Hoshama, na Nedabia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.2"
              },
              "items": [
                {
                  "text": "Ezr 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Pedaya; Zerubabeli, na Shimei; na wana wa Zerubabeli; Meshulamu na Hanania; na Shelomithi alikuwa umbu lao; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Hashuba, na Oheli, na Berekia, na Hasadia, na Yushab-Hesedi, watu watano. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wana wa Hanania; Pelatia na Yeshaya; na wana wa Refaya, na wana wa Arnani, na wana wa Obadia, na wana wa Shekania.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:21",
              "type": "text"
            },
            {
              "text": "Au, hivi, Na wana wa Hanania; Pelatia, na mwanawe huyo ni Yeshaya, na mwanawe huyo ni Refaya, na mwanawe huyo ni Arnani, na mwanawe huyo ni Obadia, na mwanawe huyo ni Shekania.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
