        },
        {
          "text": "Na hawa alizaliwa huko Yerusalemu; Shamua, na Shobabu, na Nathani, na Sulemani, wanne, wana wa Bathsheba, binti Eliamu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
