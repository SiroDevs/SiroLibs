              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa tatu, Absalomu, mwana wa Maaka, binti Talmai, mfalme wa Geshuri; wa nne, Adoniya, mwana wa Hagithi; ",
          "type": "text",
          "attrs": {
