            }
          ]
        },
        {
          "text": "Na mwanawe Sulemani alikuwa Rehoboamu; na mwanawe huyo alikuwa Abiya; na mwanawe huyo ni Asa; na mwanawe huyo ni Yehoshafati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na mwanawe huyo ni Yehoramu; na mwanawe huyo ni Ahazia; na mwanawe huyo ni Yoashi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
