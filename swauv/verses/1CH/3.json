          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.8.2"
              },
              "items": [
                {
                  "text": "Ezr 8:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wana wa Shekania ni hawa; Shemaya, na wana wa Shemaya; Hatushi, na Igali, na Baria, na Nearia, na Shafati, watu sita. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
