            }
          ]
        },
        {
          "text": "Hao wote walikuwa wana wa Daudi, mbali na wana wa masuria; na Tamari alikuwa umbu lao. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
