        },
        {
          "text": "na Sadoki kuhani, na nduguze makuhani, mbele ya maskani ya BWANA katika mahali pa juu palipokuwa huko Gibeoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
