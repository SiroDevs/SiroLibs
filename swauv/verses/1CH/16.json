        },
        {
          "text": "na pamoja nao Hemani na Yeduthuni, na wale wengine waliochaguliwa, waliotajwa majina yao, ili kumshukuru BWANA, kwa kuwa fadhili zake ni za milele; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
