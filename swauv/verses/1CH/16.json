            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo siku hiyo Daudi alipoagiza kwanza kumshukuru BWANA, kwa mkono wa Asafu na nduguze.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
