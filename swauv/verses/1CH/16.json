        },
        {
          "text": "Basi akawaacha huko, mbele ya sanduku la agano la BWANA, Asafu na nduguze, ili watumike mbele ya sanduku daima, kila siku kama ilivyokuwa kazi yake. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Obed-edomu, pamoja na ndugu zao, sitini na wanane; Obed-edomu na mwana wa Yeduthuni, na Hosa, wawe mabawabu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
              "1CH.16.38"
            ]
          }
        },
