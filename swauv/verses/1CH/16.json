          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "na pamoja nao Hemani na Yeduthuni wenye baragumu na matoazi, kwa hao watakaovumisha sauti, na vinanda kwa ajili ya hizo nyimbo za Mungu; na hao wana wa Yeduthuni wawepo mlangoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
