              "JAS.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.18"
              },
              "items": [
                {
                  "text": "Yak 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Pet 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "N’nani aliye na hekima na ufahamu kwenu? Na aonyeshe kazi zake kwa mwenendo wake mzuri, katika upole wa hekima. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.31"
              },
              "items": [
                {
                  "text": "Efe 4:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini, mkiwa na wivu wenye uchungu na ugomvi mioyoni mwenu, msijisifu, wala msiseme uongo juu ya kweli. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.5"
              },
              "items": [
                {
                  "text": "Yak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hekima hiyo siyo ile ishukayo kutoka juu, bali ni ya dunia, ya tabia ya kibinadamu, na Shetani. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana hapo palipo wivu na ugomvi ndipo palipo machafuko, na kila tendo baya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.11"
              },
              "items": [
                {
                  "text": "Ebr 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini hekima itokayo juu, kwanza ni safi, tena ni ya amani, ya upole, tayari kusikiliza maneno ya watu, imejaa rehema na matunda mema, haina fitina, haina unafiki. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.17"
              },
              "items": [
                {
                  "text": "Isa 32:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.9"
              },
              "items": [
                {
                  "text": "Mt 5:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tunda la haki hupandwa katika amani na wale wafanyao amani.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
          }
        }
      ]
    }
  ],
