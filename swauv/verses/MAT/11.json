                "loc": "MAT.3.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hao walipokwenda zao, Yesu alianza kuwaambia makutano habari za Yohana, Mlitoka kwenda nyikani kutazama nini? Unyasi ukitikiswa na upepo? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini mlitoka kwenda kuona nini? Mtu aliyevikwa mavazi mororo? Tazama, watu wavaao mavazi mororo wamo katika nyumba za wafalme. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.8",
            "verseOrgIds": [
              "MAT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.76"
              },
              "items": [
                {
                  "text": "Lk 1:76",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini kwa nini mlitoka? Ni kuona nabii? Naam, nawaambia, na aliye mkuu zaidi ya nabii. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.9",
            "verseOrgIds": [
              "MAT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.2"
              },
              "items": [
                {
                  "text": "Mk 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.28"
              },
              "items": [
                {
                  "text": "Yn 3:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huyo ndiye aliyeandikiwa haya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.10",
            "verseOrgIds": [
              "MAT.11.10"
            ]
          }
        }
      ]
    },
