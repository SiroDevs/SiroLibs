          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye akawabatiza katika mto wa Yordani, huku wakiziungama dhambi zao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        },
        {
