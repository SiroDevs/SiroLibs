                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na shoka limekwisha kuwekwa penye mashina ya miti; basi kila mti usiozaa matunda mazuri hukatwa na kutupwa motoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.10",
            "verseOrgIds": [
