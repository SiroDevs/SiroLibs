        },
        {
          "text": "Siku zile aliondokea Yohana Mbatizaji akihubiri katika nyika ya Uyahudi, na kusema, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.1",
            "verseOrgIds": [
              "MAT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
