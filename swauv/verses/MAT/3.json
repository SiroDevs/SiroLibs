                  "text": "Yn 1:31-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati huo Yesu akaja kutoka Galilaya mpaka Yordani kwa Yohana ili abatizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.13",
            "verseOrgIds": [
              "MAT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini Yohana alitaka kumzuia, akisema, Mimi nahitaji kubatizwa na wewe, nawe waja kwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.14",
            "verseOrgIds": [
              "MAT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akajibu akamwambia, Kubali hivi sasa; kwa kuwa ndivyo itupasavyo kuitimiza haki yote. Basi akamkubali. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.15",
            "verseOrgIds": [
              "MAT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu alipokwisha kubatizwa mara akapanda kutoka majini; na tazama, mbingu zikamfunukia, akamwona Roho wa Mungu akishuka kama hua, akija juu yake; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.16",
            "verseOrgIds": [
              "MAT.3.16"
            ]
          }
        },
        {
