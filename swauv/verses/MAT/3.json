              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo walipomwendea Yerusalemu, na Uyahudi wote, na nchi zote za kandokando ya Yordani; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
