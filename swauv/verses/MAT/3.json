              "attrs": {
                "loc": "MRK.1.15"
              },
              "items": [
                {
                  "text": "Mk 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tubuni; kwa maana ufalme wa mbinguni umekaribia. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.2",
            "verseOrgIds": [
              "MAT.3.2"
            ]
