                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata alipoona wengi miongoni mwa Mafarisayo na Masadukayo wakiujia ubatizo wake, aliwaambia, Enyi wazao wa nyoka, ni nani aliyewaonya ninyi kuikimbia hasira itakayokuja? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi zaeni matunda yapasayo toba; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.8",
            "verseOrgIds": [
              "MAT.3.8"
            ]
          }
        },
