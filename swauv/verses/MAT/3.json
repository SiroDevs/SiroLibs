              },
              "items": [
                {
                  "text": "Mt 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambaye pepeto lake li mkononi mwake, naye atausafisha sana uwanda wake; na kuikusanya ngano yake ghalani, bali makapi atayateketeza kwa moto usiozimika.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
      ]
    },
