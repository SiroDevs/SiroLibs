                  "text": "Yn 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa sababu huyo ndiye aliyenenwa na nabii Isaya, akisema,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.3",
            "verseOrgIds": [
              "MAT.3.3"
            ]
