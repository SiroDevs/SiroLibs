              "items": [
                {
                  "text": "Rum 11:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayo nayo yatoka kwa BWANA wa majeshi, mwenye shauri la ajabu, apitaye wote kwa hekima yake.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.29",
            "verseOrgIds": [
              "ISA.28.29"
            ]
          }
        }
