                  "text": "1 Pet 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa ajili ya hayo Bwana, MUNGU, asema hivi, Tazama, naweka jiwe katika Sayuni, liwe msingi, jiwe lililojaribiwa, jiwe la pembeni lenye thamani, msingi ulio imara; yeye aaminiye hatafanya haraka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nitafanya hukumu kuwa ndiyo kanuni, na haki kuwa ndiyo timazi; na mvua ya mawe itachukulia mbali hilo kimbilio la maneno ya uongo, na maji yatapagharikisha mahali pa kujisitiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na agano lenu mliloagana na mauti litabatilika, tena mapatano yenu mliyopatana na kuzimu hayatasimama; pigo lifurikalo litakapopita, ndipo ninyi mtakapokanyagwa nalo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.18",
            "verseOrgIds": [
              "ISA.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kila wakati litakapopita litawachukueni. Maana litapita asubuhi baada ya asubuhi, wakati wa mchana na wakati wa usiku; na kuifahamu habari ile kutakuwa kitisho tu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.19",
            "verseOrgIds": [
              "ISA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana kitanda kile ni kifupi asiweze mtu kujinyosha juu yake, na nguo ile ya kujifunika ni nyembamba asipate mtu kujizingisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.20",
            "verseOrgIds": [
              "ISA.28.20"
            ]
          }
        },
