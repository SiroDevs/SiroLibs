              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi, naam, mimi, ni BWANA, zaidi yangu mimi hapana mwokozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.11",
            "verseOrgIds": [
              "ISA.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 43:12"
          },
          "items": [
