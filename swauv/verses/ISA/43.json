                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nimetangaza habari, nimeokoa, nimeonyesha, na hapakuwa mungu wa kigeni kati yenu; kwa sababu hiyo ninyi ni mashahidi wangu, asema BWANA, nami ni Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.12",
            "verseOrgIds": [
