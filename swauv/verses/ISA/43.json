                {
                  "text": "42:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walete vipofu walio na macho, na viziwi walio na masikio. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
