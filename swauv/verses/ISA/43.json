              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nitaiambia kaskazi, Toa; nayo kusi, Usizuie; waleteni wana wangu kutoka mbali, na binti zangu kutoka miisho ya dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.6",
