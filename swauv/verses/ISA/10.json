                  "text": "Dan 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana Bwana, BWANA wa majeshi, atayatimiza maangamizo yaliyokusudiwa katika nchi yote.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
