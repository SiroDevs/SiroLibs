              "items": [
                {
                  "text": "Rum 9:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana watu wako, Ee Israeli, wajapokuwa wengi kama mchanga wa pwani, ni mabaki tu watakaorudi; kuangamiza kumekusudiwa, kunakofurika kwa haki. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.22",
            "verseOrgIds": [
