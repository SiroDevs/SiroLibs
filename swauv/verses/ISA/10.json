                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.9"
              },
              "items": [
                {
                  "text": "2 Fal 16:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Je! Kalno si kama Karkemishi? Hamathi si kama Arpadi? Samaria si kama Dameski? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.9",
            "verseOrgIds": [
              "ISA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile mkono wangu ulivyofikilia falme za sanamu, ambazo sanamu zao za kuchongwa zilikuwa bora kuliko sanamu za Yerusalemu na za Samaria; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "je! Sitautenda Yerusalemu na sanamu zake vile vile kama nilivyoutenda Samaria na sanamu zake?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        }
      ]
    },
    {
