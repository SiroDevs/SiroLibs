              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo Bwana, BWANA wa majeshi, atawapelekea kukonda watu wake walionona; na badala ya utukufu wake kutawashwa kuteketea kama kuteketea kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.16",
            "verseOrgIds": [
              "ISA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwanga wa Israeli utakuwa ni moto, na Mtakatifu wake atakuwa mwali wa moto; nao utateketeza na kula mbigili zake na miiba yake katika siku moja. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.17",
            "verseOrgIds": [
              "ISA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye atauteketeza utukufu wa msitu wake, na wa shamba lake linalositawi, tangu nafsi hata nyama ya mwili, itakuwa kama vile afapo mtu aliye mgonjwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.18",
            "verseOrgIds": [
              "ISA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na miti ya msitu wake itakayosalia itakuwa michache, hata mtoto ataweza kuihesabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        }
      ]
    },
