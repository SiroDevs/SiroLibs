                  "text": "Dan 11:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana bado kitambo kidogo tu ghadhabu itakoma, na hasira yangu itageukia kuwaangamiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.25",
            "verseOrgIds": [
