        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.12",
            "verseOrgIds": [
              "ISA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
