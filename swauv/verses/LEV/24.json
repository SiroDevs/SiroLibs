            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.48"
              },
              "items": [
                {
                  "text": "1 Fal 7:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.19"
              },
              "items": [
                {
                  "text": "2 Nya 4:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.2"
              },
              "items": [
                {
                  "text": "Ebr 9:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawe iweke mistari miwili, mikate sita kwa kila mstari, juu ya hiyo meza safi, mbele za BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe utatia ubani safi juu ya kila mstari, ili uwe ukumbusho kwa hiyo mikate, sadaka ya kusongezwa kwa BWANA kwa moto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 24:8"
