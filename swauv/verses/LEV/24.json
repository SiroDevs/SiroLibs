              "items": [
                {
                  "text": "2 Nya 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kila siku ya Sabato ataipanga mbele za BWANA daima; ni kwa ajili ya wana wa Israeli, agano la milele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
              "LEV.24.8"
            ]
          }
        },
        {
