                "loc": "NUM.8.2+NUM.8.3+NUM.8.4"
              },
              "items": [
                {
                  "text": "Hes 8:2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waagize wana wa Israeli kwamba wakuletee mafuta ya zeituni safi ya kupondwa kwa ajili ya ile nuru, ili hiyo taa iwake daima. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.2",
            "verseOrgIds": [
              "LEV.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hapo nje ya pazia la ushahidi, ndani ya hema ya kukutania, Haruni ataitengeza tangu jioni hata asubuhi mbele za BWANA daima; ni amri ya milele katika vizazi vyenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.3",
            "verseOrgIds": [
              "LEV.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.31.8"
              },
              "items": [
                {
                  "text": "Kut 31:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.37.17+EXO.37.18+EXO.37.19+EXO.37.20+EXO.37.21+EXO.37.22+EXO.37.23+EXO.37.24"
              },
              "items": [
                {
                  "text": "37:17-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Atazitengeza hizo taa katika kile kinara kilicho safi mbele za BWANA daima.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.4",
            "verseOrgIds": [
              "LEV.24.4"
            ]
          }
        }
      ]
    },
