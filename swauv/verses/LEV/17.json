              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo naliwaambia wana wa Israeli, Hapana mtu miongoni mwenu aliye na ruhusa kula damu, wala mgeni aketiye kati yenu asile damu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
