              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo mtazishika amri zangu na hukumu zangu, wala msifanye machukizo hayo mojawapo; yeye aliye mzalia, wala mgeni aketiye kati yenu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.26",
            "verseOrgIds": [
              "LEV.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
