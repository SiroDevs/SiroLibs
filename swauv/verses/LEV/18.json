                }
              ]
            }
          ]
        },
        {
          "text": "Usifunue utupu wa mke wa nduguyo; maana, ni utupu wa nduguyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.16",
            "verseOrgIds": [
