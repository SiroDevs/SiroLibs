                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nena wewe na wana wa Israeli, uwaambie, Mimi ndimi BWANA, Mungu wenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.2",
            "verseOrgIds": [
