                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usifunue utupu wa mwanamke na binti yake; usimtwae binti ya mwanawe mume, au binti ya binti yake, ili kufunua utupu wake; hao ni jamaa ya karibu; ni uovu mkuu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.17",
            "verseOrgIds": [
              "LEV.18.17"
            ]
          }
        },
        {
          "name": "verse",
