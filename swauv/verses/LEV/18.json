        },
        {
          "text": "Kwa ajili ya hayo mtazishika amri zangu na hukumu zangu; ambazo mtu akizitumia ataishi kwa hizo; mimi ndimi BWANA.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.5",
            "verseOrgIds": [
              "LEV.18.5"
            ]
          }
