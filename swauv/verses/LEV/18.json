          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili kwamba hiyo nchi isiwatapike na ninyi pia, hapo mtakapoitia unajisi, kama ilivyoitapika hiyo taifa iliyotangulia mbele yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.28",
            "verseOrgIds": [
              "LEV.18.28"
            ]
          }
        },
        {
