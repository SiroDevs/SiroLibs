          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "(kwa kuwa hao watu wa nchi wameyafanya machukizo haya yote, hao waliotangulia mbele zenu, na hiyo nchi imekuwa najisi;) ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.27",
            "verseOrgIds": [
              "LEV.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
