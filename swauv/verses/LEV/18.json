              "items": [
                {
                  "text": "2 Sam 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utupu wa umbu lako, binti ya baba yako, au binti ya mama yako, kwamba alizaliwa nyumbani mwenu au kwamba alizaliwa kwengine, utupu wa hao usifunue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.9",
            "verseOrgIds": [
              "LEV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utupu wa binti ya mwanao mume, au wa binti ya binti yako, utupu wao hao usifunue; kwa kuwa ndio utupu wako mwenyewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.10",
            "verseOrgIds": [
              "LEV.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utupu wa binti ya mkewe baba yako, aliyezaliwa na baba yako, yeye ni umbu lako, usifunue utupu wake. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.11",
            "verseOrgIds": [
              "LEV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.19+LEV.20.20"
              },
              "items": [
                {
                  "text": "Law 20:19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usifunue utupu wa umbu lake baba yako; maana, yeye ni jamaa aliye karibu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.12",
            "verseOrgIds": [
              "LEV.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usifunue utupu wa umbu la mama yako; maana, yeye ni jamaa ya mama yako ya karibu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.13",
            "verseOrgIds": [
              "LEV.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usifunue utupu wa ndugu ya baba yako, usimkaribie mkewe huyo; yeye ni shangazi lako. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.14",
            "verseOrgIds": [
              "LEV.18.14"
            ]
          }
        },
        {
