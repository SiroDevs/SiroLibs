                  "text": "Eze 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usifunue utupu wa mkweo mwanamke; yeye ni mke wa mwanao; usifunue utupu wake huyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.15",
