                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Utupu wa mke wa baba yako, usifunue; maana, ni utupu wa baba yako. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.18.8",
            "verseOrgIds": [
              "LEV.18.8"
            ]
