              "items": [
                {
                  "text": "Amo 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na wazaliwa wa kwanza wote katika nchi ya Misri watakufa, tangu yule mzaliwa wa kwanza wa Farao aketiye katika kiti chake cha enzi, hata mzaliwa wa kwanza wa huyo kijakazi aliye pale nyuma ya jiwe la kusagia; na wazaliwa wa kwanza wote wa wanyama. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.5",
            "verseOrgIds": [
              "EXO.11.5"
            ]
          }
        },
        {
