            "number": "8",
            "style": "v",
            "sid": "EXO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena hao watumishi wako wote watanitelemkia kwangu mimi, nao watanisujudia, wakisema, Toka wewe, na hawa watu wote wakufuatao; na baada ya hayo nitatoka. Basi akatoka kwa Farao na hasira kuu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.8",
            "verseOrgIds": [
              "EXO.11.8"
            ]
          }
        }
