                  "text": "Amo 5:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo kutakuwa na kilio kikuu katika nchi yote ya Misri, ambacho mfano wake haujakuwa bado majira yo yote, wala hautakuwako mfano wake tena kabisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.6",
            "verseOrgIds": [
              "EXO.11.6"
            ]
          }
