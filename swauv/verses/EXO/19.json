                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mlima wa Sinai wote pia ukatoa moshi, kwa sababu BWANA alishuka katika moto; na ule moshi wake ukapanda juu kama moshi wa tanuu, mlima wote ukatetemeka sana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
