                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akamwambia Musa, Enenda kwa watu hawa, ukawatakase leo na kesho, wakazifue nguo zao, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
