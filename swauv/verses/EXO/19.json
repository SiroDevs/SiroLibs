                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa akapanda kwa Mungu, na BWANA akamwita toka mlima ule, akisema, Utawaambia nyumba ya Yakobo, na kuwaarifu wana wa Israeli, maneno haya; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.3",
            "verseOrgIds": [
              "EXO.19.3"
            ]
          }
        },
