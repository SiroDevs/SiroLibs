              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwezi wa tatu baada ya kutoka Waisraeli katika nchi ya Misri, siku iyo hiyo wakafika jangwa la Sinai. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.1",
            "verseOrgIds": [
              "EXO.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao walipokuwa wameondoka Refidimu na kufika jangwa la Sinai, wakatua katika lile jangwa; Israeli wakapiga kambi huko wakiukabili mlima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.2",
            "verseOrgIds": [
              "EXO.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
