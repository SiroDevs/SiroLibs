              "items": [
                {
                  "text": "Kum 4:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musa akawatoa hao watu katika kituo, akawaleta ili waonane na Mungu; wakasimama pande za chini za kile kilima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
