              },
              "items": [
                {
                  "text": "1 Sam 6:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo BWANA akamwambia Musa, Shuka chini, uwaonye watu wasije wakapasua njia waje kwa BWANA kutazama, kisha wengi miongoni mwao wakaangamia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
