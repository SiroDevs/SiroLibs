                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.81.7"
              },
              "items": [
                {
                  "text": "Zab 81:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hapo sauti ya baragumu ilipozidi kulia sana, Musa akanena, naye Mungu akamwitikia kwa sauti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akaushukia mlima, juu ya kilele cha mlima; BWANA akamwita Musa aende hata kilele cha mlima; Musa akapanda juu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
