        },
        {
          "text": "nanyi mtakuwa kwangu ufalme wa makuhani, na taifa takatifu. Hayo ndiyo maneno utakayowaambia wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
