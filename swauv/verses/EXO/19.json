              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.3"
              },
              "items": [
                {
                  "text": "Law 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.7"
              },
              "items": [
                {
                  "text": "2 Sam 6:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makuhani nao, wamkaribiao BWANA, na wajitakase, BWANA asije akawafurikia. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akamwambia BWANA, Watu hawa hawawezi kuukaribia mlima wa Sinai; kwa kuwa wewe ulituusia, ukisema, Wekeni mipaka kando-kando ya mlima, na kuutenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "BWANA akamwambia, Nenda, ushuke wewe; nawe utakwea, wewe, na Haruni pamoja nawe; lakini wale makuhani na watu wasipenye kumkaribia BWANA, asije yeye akawafurikia juu yao. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.24",
            "verseOrgIds": [
              "EXO.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Musa akawatelemkia hao watu na kuwaambia hayo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.25",
            "verseOrgIds": [
              "EXO.19.25"
            ]
          }
