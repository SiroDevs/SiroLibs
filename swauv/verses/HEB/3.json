              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo, kama anenavyo Roho Mtakatifu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
