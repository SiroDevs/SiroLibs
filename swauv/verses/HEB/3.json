                "loc": "HEB.6.11"
              },
              "items": [
                {
                  "text": "Ebr 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.1"
              },
              "items": [
                {
                  "text": "11:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana tumekuwa washirika wa Kristo, kama tukishikamana na mwanzo wa uthabiti wetu kwa nguvu mpaka mwisho; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        },
