            }
          ]
        },
        {
          "text": "Naye yule kuhani akawapa wakuu wa mamia mikuki na ngao zilizokuwa za mfalme Daudi, zilizokuwamo nyumbani mwa BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.10",
            "verseOrgIds": [
              "2KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walinzi wakasimama, kila mtu na silaha zake mkononi, kutoka pembe ya kuume ya nyumba mpaka pembe ya kushoto ya nyumba, kando ya madhabahu na nyumba, wakimzunguka mfalme pande zote. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.11",
            "verseOrgIds": [
              "2KI.11.11"
            ]
          }
        },
