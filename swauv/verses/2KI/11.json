                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Athalia, mama yake Ahazia, alipoona ya kuwa mwanawe amekufa, akainuka, akawaharibu wazao wote wa kifalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.1",
            "verseOrgIds": [
              "2KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ila Yehosheba, binti wa mfalme Yehoramu,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:2",
              "type": "text"
            },
            {
              "text": "Au, Yoramu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " umbu lake Ahazia, akamtwaa Yoashi mwana wa Ahazia, akamwiba miongoni mwa hao wana wa mfalme waliouawa, yeye na mlezi wake, na kuwatia katika chumba cha kulala; wakamficha usoni pa Athalia, basi kwa hiyo hakuuawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.2",
            "verseOrgIds": [
              "2KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.22.12"
              },
              "items": [
                {
                  "text": "2 Nya 22:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.8"
              },
              "items": [
                {
                  "text": "Zab 12:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alikuwako pamoja naye, amefichwa nyumbani mwa BWANA, miaka sita. Naye Athalia akaitawala nchi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.3",
            "verseOrgIds": [
              "2KI.11.3"
            ]
          }
        }
      ]
    },
    {
