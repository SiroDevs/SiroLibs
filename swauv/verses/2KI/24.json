                }
              ]
            }
          ]
        },
        {
          "text": "Yekonia alikuwa na umri wa miaka kumi na minane alipoanza kutawala; akatawala miezi mitatu katika Yerusalemu; na jina la mama yake aliitwa Nehushta binti Elnathani wa Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akafanya yaliyo mabaya machoni pa BWANA, mfano wa yote aliyoyafanya baba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1"
              },
              "items": [
                {
                  "text": "Dan 1:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati ule watumishi wa Nebukadreza mfalme wa Babeli wakakwea kwenda Yerusalemu, na mji ukahusuriwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Nebukadreza, mfalme wa Babeli, akaufikilia huo mji, hapo watumishi wake walipokuwa wakiuhusuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
