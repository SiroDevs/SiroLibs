                "loc": "JER.46.2"
              },
              "items": [
                {
                  "text": "46:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi mfalme wa Misri hakuja tena kutoka nchi yake; kwa kuwa mfalme wa Babeli alikuwa amemnyang’anya nchi, tangu kijito cha Misri mpaka mto wa Frati, yote aliyokuwa nayo mfalme wa Misri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
