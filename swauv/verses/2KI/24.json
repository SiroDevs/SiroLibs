                }
              ]
            }
          ]
        },
        {
          "text": "Na Yekonia, mfalme wa Yuda, akatoka akamwendea mfalme wa Babeli, yeye na mama yake, na watumishi wake, na wakuu wa watu wake, na maakida wake; mfalme wa Babeli akamchukua mateka katika mwaka wa nane wa kutawala kwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        }
