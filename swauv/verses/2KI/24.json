              "text": "24:1",
              "type": "text"
            },
            {
              "text": "Au, Nebukadneza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mfalme wa Babeli, na Yehoyakimu akawa mtumishi wake muda wa miaka mitatu; kisha, akageuka, akamwasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
