        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.6"
              },
              "items": [
                {
                  "text": "2 Nya 36:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehoyakimu akalala na babaze; na mwanawe Yekonia",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:6",
              "type": "text"
            },
            {
              "text": "Au, Yehoyakini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " akatawala mahali pake. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
