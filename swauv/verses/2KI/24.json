                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "tena kwa ajili ya damu zisizo na hatia alizozimwaga; kwani aliujaza Yerusalemu damu zisizo na hatia; wala BWANA hakukubali kusamehe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi mambo yote ya Yehoyakimu yaliyosalia, na yote aliyoyafanya, je! Hayakuandikwa katika kitabu-cha-tarehe cha wafalme wa Yuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
