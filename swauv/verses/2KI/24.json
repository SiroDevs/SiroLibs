                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakika kwa amri ya BWANA mambo hayo yalimpata Yuda, ili waondoshwe kutoka machoni pake, kwa sababu ya dhambi zake Manase, kadiri ya yote aliyoyafanya; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
