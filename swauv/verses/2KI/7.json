                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikatukia kama vile yule mtu wa Mungu alivyomwambia mfalme, Vipimo viwili vya shayiri kwa shekeli, na kipimo cha unga mzuri kwa shekeli, ndivyo vitakavyokuwa kesho, panapo saa hii, katika lango la Samaria; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.18",
            "verseOrgIds": [
              "2KI.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
