                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo akaniambia, Maji haya yanatoka kwenda pande za nchi ya mashariki, nayo yanashuka mpaka Araba, na kuingia katika bahari",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "47:8",
              "type": "text"
            },
            {
              "text": "Yaani, Bahari ya Chumvi.",
              "type": "text"
            }
          ]
        },
        {
          "text": "; maji yatokezwayo yataingia baharini, na maji yake yataponyeka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
