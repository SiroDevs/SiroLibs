          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali mahali penye matope, na maziwa yake, hayataponywa; yataachwa yawe ya chumvi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
