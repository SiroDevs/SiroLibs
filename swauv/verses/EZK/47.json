        },
        {
          "text": "Akaniambia, Mwanadamu, je! Umeona haya? Kisha akanichukua akanirudisha mpaka ukingo wa mto. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
