        {
          "text": "Basi nikiisha kurudi, tazama, kando ya ukingo wa mto ilikuwapo miti mingi sana, upande huu na upande huu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
