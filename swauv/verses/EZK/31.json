              "type": "tag",
              "attrs": {
                "loc": "DAN.4.22+DAN.4.23+DAN.4.24"
              },
              "items": [
                {
                  "text": "Dan 4:22-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nalimfanya kuwa mzuri kwa wingi wa matawi yake; hata miti yote ya Adeni, iliyokuwa ndani ya bustani ya Mungu, ilimwonea wivu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.9",
            "verseOrgIds": [
              "EZK.31.9"
            ]
          }
        }
