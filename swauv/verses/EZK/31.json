            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.7+ISA.10.8+ISA.10.9+ISA.10.10+ISA.10.11"
              },
              "items": [
                {
                  "text": "Isa 10:7-11",
                  "type": "text"
