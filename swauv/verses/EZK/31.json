                  "text": "13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi kimo chake kilitukuzwa kuliko miti yote ya kondeni, na vitanzu vyake viliongezeka; matawi yake yakawa marefu, kwa sababu ya maji mengi, alipoyachipuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.5",
            "verseOrgIds": [
              "EZK.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.23"
              },
              "items": [
                {
                  "text": "Eze 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.4.12"
              },
              "items": [
                {
                  "text": "Dan 4:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndege wote wa angani walifanya vioto vyao katika vitanzu vyake, na chini ya matawi yake wanyama wote wa kondeni walizaa watoto wao, na chini ya uvuli wake mataifa makuu yote walikaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.6",
            "verseOrgIds": [
              "EZK.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi hivyo alikuwa mzuri katika ukuu wake, katika urefu wa matawi yake; maana mizizi yake ilikuwa karibu na maji mengi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.7",
            "verseOrgIds": [
              "EZK.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Mwa 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mierezi ya bustani ya Mungu haikuweza kumficha; misunobari haikuwa kama vitanzu vyake, na miamori haikuwa kama matawi yake, wala bustanini mwa Mungu hamkuwa na mti wo wote uliofanana naye kwa uzuri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.8",
            "verseOrgIds": [
              "EZK.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 31:9"
          },
          "items": [
