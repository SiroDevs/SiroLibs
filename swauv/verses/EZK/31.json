            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.5"
              },
              "items": [
                {
                  "text": "32:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na wageni, watu wa mataifa watishao, wamemkatilia mbali na kumwacha; juu ya milima na katika mabonde yote matawi yake yameanguka, na vitanzu vyake vimevunjika karibu na mifereji yote ya nchi; na watu wote wa dunia wameshuka, wakitoka katika uvuli wake na kumwacha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.12",
            "verseOrgIds": [
              "EZK.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.18.6"
              },
              "items": [
                {
                  "text": "Isa 18:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Juu ya magofu yake ndege wote wa angani watakaa, na wanyama wote wa jangwani watakuwa juu ya matawi yake; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.13",
            "verseOrgIds": [
              "EZK.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
