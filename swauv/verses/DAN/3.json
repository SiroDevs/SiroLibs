                "loc": "DAN.2.49"
              },
              "items": [
                {
                  "text": "Dan 2:49",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wako Wayahudi kadha wa kadha uliowaweka juu ya mambo ya wilaya ya Babeli, yaani, Shadraka, na Meshaki, na Abednego; watu hawa, Ee mfalme, hawakukujali wewe; hawaitumikii miungu yako, wala kuiabudu ile sanamu ya dhahabu uliyoisimamisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
