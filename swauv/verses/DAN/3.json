              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akawaamuru baadhi ya watu mashujaa wa jeshi lake kuwafunga Shadraka, na Meshaki, na Abednego, na kuwatupa katika ile tanuru iliyokuwa ikiwaka moto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
