              "attrs": {
                "loc": "ACT.5.25+ACT.5.26+ACT.5.27"
              },
              "items": [
                {
                  "text": "Mdo 5:25-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Nebukadreza akatoa amri kwa hasira na ghadhabu, waletwe hao Shadraka, na Meshaki, na Abednego. Basi wakawaleta watu hao mbele ya mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
