          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Nebukadreza akaukaribia mdomo wa ile tanuru iliyokuwa inawaka moto. Akanena, akasema, Enyi Shadraka, na Meshaki, na Abednego, watumishi wa Mungu Aliye juu, tokeni, mje huku. Ndipo Shadraka, na Meshaki, na Abednego, wakatoka katika ule moto. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.26",
            "verseOrgIds": [
              "DAN.3.26"
            ]
          }
        },
