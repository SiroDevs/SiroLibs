              "items": [
                {
                  "text": "Dan 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo mpiga mbiu akapiga kelele akisema, Enyi watu wa kabila zote, na taifa, na lugha, mmeamriwa hivi, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakati mtakapoisikia sauti ya panda, na filimbi, na kinubi, na zeze, na santuri, na zomari, na namna zote za ngoma, lazima kuanguka na kuiabudu sanamu ya dhahabu, mfalme Nebukadreza aliyoisimamisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.22"
              },
              "items": [
                {
                  "text": "Yer 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.15"
              },
              "items": [
                {
                  "text": "Ufu 13:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kila mtu asiyeanguka na kuabudu atatupwa saa iyo hiyo katika tanuru ya moto uwakao. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakati huo, watu wa kabila zote walipoisikia sauti ya panda, na filimbi, na kinubi, na zeze, na santuri, na zomari, na namna zote za ngoma, watu wote na mataifa na lugha wakaanguka, wakaiabudu ile sanamu, mfalme Nebukadreza aliyoisimamisha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
