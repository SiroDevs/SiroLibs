              "items": [
                {
                  "text": "Isa 46:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nebukadreza akajibu, akawaambia, Enyi Shadraka, na Meshaki, na Abednego, je! Ni kwa makusudi hata hammtumikii mungu wangu wala kuisujudia sanamu ya dhahabu niliyoisimamisha? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
