              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.10"
              },
              "items": [
                {
                  "text": "Ufu 22:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini wewe, Ee Danieli, yafunge maneno haya, ukakitie muhuri kitabu, hata wakati wa mwisho; wengi wataenda mbio huko na huko, na maarifa yataongezeka.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
