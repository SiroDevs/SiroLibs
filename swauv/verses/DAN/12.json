              },
              "items": [
                {
                  "text": "Ufu 22:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wengi watajitakasa, na kujifanya weupe, na kusafika; bali wabaya watatenda mabaya; wala hataelewa mtu mbaya awaye yote; bali wao walio na hekima ndio watakaoelewa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 12:11"
          },
          "items": [
            {
