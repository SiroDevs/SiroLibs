                }
              ]
            }
          ]
        },
        {
          "text": "Wakati huo Mikaeli atasimama, jemadari mkuu, asimamaye upande wa wana wa watu wako; na kutakuwa na wakati wa taabu, mfano wake haukuwapo tangu lilipoanza kuwapo taifa hata wakati uo huo; na wakati huo watu wako wataokolewa; kila mmoja atakayeonekana ameandikwa katika kitabu kile. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
