              "items": [
                {
                  "text": "Yn 5:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena, wengi wa hao walalao katika mavumbi ya nchi wataamka, wengine wapate uzima wa milele, wengine aibu na kudharauliwa milele. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.41"
              },
              "items": [
                {
                  "text": "1 Kor 15:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na walio na hekima watang’aa kama mwangaza wa anga; na hao waongozao wengi kutenda haki watang’aa kama nyota milele na milele. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
