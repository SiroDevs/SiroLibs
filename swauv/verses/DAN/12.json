              "items": [
                {
                  "text": "Isa 57:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.5"
              },
              "items": [
                {
                  "text": "Zab 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lakini enenda zako hata utakapokuwa mwisho ule; maana wewe utastarehe, nawe utasimama katika kura yako mwisho wa siku hizo.",
          "type": "text",
          "attrs": {
