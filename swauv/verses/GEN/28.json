                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau akaona ya kuwa binti za Kanaani hawakumpendeza Isaka, baba yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
