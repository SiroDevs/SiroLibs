        {
          "text": "Basi Isaka akamwita Yakobo, akambariki, akamwagiza akamwambia, Usitwae mke wa binti za Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
