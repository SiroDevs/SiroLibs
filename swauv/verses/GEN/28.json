          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Isaka akampeleka Yakobo, naye akaenda Padan-aramu, kwa Labani, mwana wa Bethueli, Mshami, ndugu wa Rebeka, mama yao Yakobo na Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
