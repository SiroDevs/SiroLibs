        },
        {
          "text": "Esau akaona ya kwamba Isaka amembariki Yakobo na kumpeleka Padan-aramu, ili ajitwalie mke huko, na katika kumbariki akamwagiza, akasema, Usitwae mke wa binti za Kanaani, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya kuwa Yakobo amewatii babaye na mamaye, akaenda Padan-aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
