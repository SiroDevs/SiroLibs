              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikawa, baada ya mambo hayo, Yusufu akaambiwa, Tazama, baba yako hawezi; akawatwaa wanawe wawili, Manase na Efraimu, pamoja naye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.1",
            "verseOrgIds": [
              "GEN.48.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 48:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye akaarifiwa Yakobo ya kwamba, Angalia, mwanao Yusufu anakuja kwako. Israeli akajitia nguvu, akaketi juu ya kitanda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.2",
            "verseOrgIds": [
              "GEN.48.2"
            ]
          }
        },
        {
          "name": "verse",
