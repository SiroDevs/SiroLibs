                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi sasa wanao wawili uliozaliwa katika nchi ya Misri kabla sijaja kwako Misri ni watoto wangu, yaani, Efraimu na Manase watakuwa wangu, kama Reubeni na Simeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.5",
            "verseOrgIds": [
              "GEN.48.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 48:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wazao wako utakaozaa baada ya hawa watakuwa wako; kwa jina la ndugu zao wataitwa katika urithi wao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.48.6",
            "verseOrgIds": [
              "GEN.48.6"
            ]
          }
        }
      ]
    },
