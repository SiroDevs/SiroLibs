                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.4"
              },
              "items": [
                {
                  "text": "Rut 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Efroni alikuwa akiketi kati ya wazawa wa Hethi. Efroni Mhiti akamjibu Ibrahimu, na wazawa wa Hethi wanasikiliza, hata watu wote waingiao mlango wa mji wake, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.10",
            "verseOrgIds": [
              "GEN.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.20+2SA.24.21+2SA.24.22+2SA.24.23+2SA.24.24"
              },
              "items": [
                {
                  "text": "2 Sam 24:20-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sivyo, bwana wangu, unisikilize. Lile shamba nakupa, na pango iliyomo nakupa; mbele ya wana wa watu wangu nakupa, uzike maiti wako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.11",
            "verseOrgIds": [
              "GEN.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibrahimu akainama mbele ya watu wa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.12",
            "verseOrgIds": [
              "GEN.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.5+PHP.4.6+PHP.4.7+PHP.4.8"
              },
              "items": [
                {
                  "text": "Flp 4:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwambia Efroni, na watu wa nchi wanasikiliza, akisema, Tafadhali unisikilize; nitatoa kima cha shamba, nawe ukipokee kwangu, nami nitamzika humo maiti wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.13",
            "verseOrgIds": [
              "GEN.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efroni akamjibu Ibrahimu, akamwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.14",
            "verseOrgIds": [
              "GEN.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.30.13"
              },
              "items": [
                {
                  "text": "Kut 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.12"
              },
              "items": [
                {
                  "text": "Eze 45:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bwana wangu, unisikilize. Sehemu ya nchi, ambayo thamani yake ni shekeli za fedha mia nne, n’nini hii baina yako na yangu? Basi uzike maiti wako.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.15",
            "verseOrgIds": [
              "GEN.23.15"
            ]
          }
        }
      ]
