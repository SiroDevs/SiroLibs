            "number": "3",
            "style": "v",
            "sid": "GEN 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaondoka Ibrahimu kutoka mbele ya maiti wake, akasema na wazawa wa Hethi, akinena, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.3",
            "verseOrgIds": [
              "GEN.23.3"
            ]
          }
        },
