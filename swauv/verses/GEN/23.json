              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sara akafa katika Kiriath-arba, ndio Hebroni, katika nchi ya Kanaani. Ibrahimu akaja kumlilia Sara na kumwombolezea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
