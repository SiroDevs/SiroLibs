              "type": "text"
            }
          ]
        },
        {
          "text": "Basi umri wake Sara ulikuwa miaka mia na ishirini na saba ndio umri wake Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
              "GEN.23.1"
            ]
          }
        },
        {
