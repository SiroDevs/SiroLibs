              },
              "items": [
                {
                  "text": "Mdo 7:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi shamba la Efroni lililokuwa katika Makpela kuelekea Mamre, shamba, na pango iliyokuwamo, na miti yote iliyokuwamo shambani, iliyokuwa katika mipaka yake pande zote, vyote viliyakinishwa ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.17",
            "verseOrgIds": [
              "GEN.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuwa mali yake Ibrahimu, mbele ya wazawa wa Hethi, mbele ya watu wote waingiao katika mlango wa mji wake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.18",
            "verseOrgIds": [
              "GEN.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 23:19"
