          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wana wa Bilha, kijakazi wa Raheli, ni Dani na Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
