                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa alipokuwa anashikwa sana na utungu, mzalisha akamwambia, Usiogope, maana sasa utamzaa mwanamume mwingine. ",
          "type": "text",
          "attrs": {
