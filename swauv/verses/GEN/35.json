                  "text": "Mwa 28:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akajenga huko madhabahu, akapaita mahali pale, El-Betheli; kwa sababu huko Mungu alimtokea, hapo alipomkimbia ndugu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
