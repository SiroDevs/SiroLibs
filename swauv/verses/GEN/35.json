                  "text": "Mwa 24:59",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akafa Debora mlezi wa Rebeka, akazikwa chini ya Betheli, chini ya mwaloni; na jina lake likaitwa Alon-bakuthi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
