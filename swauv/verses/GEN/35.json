                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wana wa Lea ni Reubeni, mzaliwa wa kwanza wa Yakobo, na Simeoni, na Lawi, na Yuda, na Isakari, na Zabuloni. ",
          "type": "text",
          "attrs": {
