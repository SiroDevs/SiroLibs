                }
              ]
            }
          ]
        },
        {
          "text": "Yakobo akasimamisha nguzo mahali aliposema naye, nguzo ya mawe, akamimina juu yake sadaka ya kinywaji, akamimina mafuta juu yake. ",
          "type": "text",
          "attrs": {
