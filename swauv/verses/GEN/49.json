              "items": [
                {
                  "text": "Mwa 23:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "katika ile pango iliyomo shambani mwa Makpela, iliyo mbele ya Mamre katika nchi ya Kanaani, aliyoinunua Ibrahimu pamoja na shamba kwa Efroni Mhiti, pawe milki yake ya kuzikia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
