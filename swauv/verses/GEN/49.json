                "loc": "GEN.35.29"
              },
              "items": [
                {
                  "text": "35:29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Humo walimzika Ibrahimu, na Sara mkewe; humo wakamzika Isaka, na Rebeka mkewe; nami humo nikamzika Lea; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
