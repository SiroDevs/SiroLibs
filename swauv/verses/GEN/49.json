          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "shamba na pango iliyomo lililonunuliwa kwa wazawa wa Hethi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yakobo alipokwisha kuwaagiza wanawe, akakunja miguu yake kitandani, akafa, akakusanywa pamoja na watu wake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
