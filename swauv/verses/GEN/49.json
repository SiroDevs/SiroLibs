        {
          "text": "Hizo zote ndizo kabila za Israeli kumi na mbili. Na hayo ndiyo aliyowaambia baba yao, na kuwabariki; mmoja mmoja kwa mbaraka wake aliwabariki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
