        {
          "text": "Adamu akaishi miaka mia na thelathini, akazaa mwana kwa sura yake, kwa mfano wake, akamwita jina lake Sethi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
