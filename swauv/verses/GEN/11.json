              },
              "items": [
                {
                  "text": "Dan 1:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa watu waliposafiri pande za mashariki waliona nchi tambarare katika nchi ya Shinari; wakakaa huko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.2",
            "verseOrgIds": [
              "GEN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
