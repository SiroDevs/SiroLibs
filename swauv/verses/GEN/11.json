              "type": "text"
            }
          ]
        },
        {
          "text": "Nchi yote ilikuwa na lugha moja na usemi mmoja. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.1",
            "verseOrgIds": [
              "GEN.11.1"
