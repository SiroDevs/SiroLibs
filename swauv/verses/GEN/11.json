                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akashuka ili auone mji na mnara waliokuwa wakiujenga wanadamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
