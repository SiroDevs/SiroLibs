                {
                  "text": "Lk 1:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakasema, Haya, na tujijengee mji, na mnara, na kilele chake kifike mbinguni, tujifanyie jina; ili tusipate kutawanyika usoni pa nchi yote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        },
        {
          "name": "verse",
