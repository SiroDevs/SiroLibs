              "items": [
                {
                  "text": "Mal 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.12"
              },
              "items": [
                {
                  "text": "Mwa 25:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika wa BWANA akamwambia, Hakika nitauzidisha uzao wako, wala hautahesabika kwa jinsi utakavyokuwa mwingi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.23"
              },
              "items": [
                {
                  "text": "Kut 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika wa BWANA akamwambia, Tazama! Wewe una mimba, utazaa mwana wa kiume, nawe utamwita jina lake Ishmaeli, maana BWANA amesikia kilio cha mateso yako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.18"
              },
              "items": [
                {
                  "text": "Mwa 25:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye atakuwa kama punda-mwitu kati ya watu, mkono wake utakuwa juu ya watu wote na mkono wa watu wote utakuwa juu yake, naye atakaa mbele yao ndugu zake wote.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
