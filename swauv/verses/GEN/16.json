              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaika wa BWANA akamwona kwenye chemchemi ya maji katika jangwa, chemchemi iliyoko katika njia ya kuendea Shuri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwambia, Hajiri, wewe mjakazi wa Sarai, unatoka wapi, nawe unakwenda wapi? Akanena, Nakimbia mimi kutoka mbele ya bibi yangu Sarai. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.5+EPH.6.6+EPH.6.7+EPH.6.8+EPH.6.9"
              },
              "items": [
                {
                  "text": "Efe 6:5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Malaika wa BWANA akamwambia, Rudi kwa bibi yako, ukanyenyekee chini ya mikono yake. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
