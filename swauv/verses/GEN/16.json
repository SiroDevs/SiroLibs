            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaliita jina la BWANA aliyesema naye, Wewe U Mungu uonaye, kwani alisema, Hata hapa nimemwona yeye anionaye? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa hiyo kisima kile kiliitwa Beer-lahai-roi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:14",
              "type": "text"
            },
            {
              "text": "Beer-lahai-roi",
              "type": "text"
            },
            {
              "text": "maana yake ni kisima cha Aliye hai anionaye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tazama, kiko kati ya Kadeshi na Beredi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.22"
              },
              "items": [
                {
                  "text": "Gal 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hajiri akamzalia Abramu mwana wa kiume; Abramu akamwita jina lake Ishmaeli, yule mwanawe, ambaye Hajiri alimzaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abramu alikuwa mtu wa miaka themanini na sita, hapo Hajiri alipomzalia Abramu Ishmaeli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
