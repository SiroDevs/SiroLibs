                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hawa wote wakakutana panapo bonde la Sidimu, kwenye Bahari ya Chumvi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.3",
            "verseOrgIds": [
              "GEN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miaka kumi na miwili walimtumikia Kedorlaoma, hata mwaka wa kumi na tatu wakaasi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.4",
            "verseOrgIds": [
              "GEN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mwaka wa kumi na nne akaja Kedorlaoma na wafalme waliokuwa pamoja naye, wakawapiga Warefai katika Ashteroth-karnaimu, na Wazuzi katika Hamu, na Waemi katika Shawe-kiryathaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.5",
            "verseOrgIds": [
              "GEN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Wahori katika mlima wao Seiri, mpaka Elparani iliyo karibu na jangwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.6",
            "verseOrgIds": [
              "GEN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.2"
              },
              "items": [
                {
                  "text": "2 Nya 20:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha wakarudi wakaja mpaka Enmisfati, ndio Kadeshi, wakapiga nchi yote ya Waamaleki, na Waamori waliokaa Hasason-tamari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.7",
            "verseOrgIds": [
              "GEN.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
