                  "text": "Ebr 7:10-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na Melkizedeki mfalme wa Salemu akaleta mkate na divai, naye alikuwa kuhani wa Mungu Aliye juu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
              "GEN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akambariki, akasema, Abramu na abarikiwe na Mungu Aliye juu sana, Muumba mbingu na nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.19",
            "verseOrgIds": [
              "GEN.14.19"
            ]
          }
        },
        {
