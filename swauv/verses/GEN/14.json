                  "text": "Ebr 7:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ahimidiwe Mungu Aliye juu sana, aliyewatia adui zako mikononi mwako. Abramu akampa fungu la kumi la vitu vyote. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.20",
            "verseOrgIds": [
              "GEN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme wa Sodoma akamwambia Abramu, Nipe mimi hao watu, na hizo mali uchukue wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.21",
