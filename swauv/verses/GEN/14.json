              },
              "items": [
                {
                  "text": "Isa 41:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abramu aliposikia ya kwamba nduguye ametekwa mateka, akawapa silaha vijana wake, waliozaliwa katika nyumba yake, watu mia tatu na kumi na wanane, akawafuata mpaka Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akajipanga apigane nao usiku, yeye na watumwa wake, akawapiga, akawafukuza mpaka Hoba, ulioko upande wa kushoto wa Dameski. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
