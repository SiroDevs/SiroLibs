              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakamtwaa Lutu, mwana wa nduguye Abramu, aliyekaa huko Sodoma, na mali yake, wakaenda zao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.12",
            "verseOrgIds": [
              "GEN.14.12"
            ]
          }
        }
      ]
