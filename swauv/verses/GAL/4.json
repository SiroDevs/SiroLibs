                "loc": "GAL.3.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kusudi awakomboe hao waliokuwa chini ya sheria, ili sisi tupate kupokea hali ya kuwa wana. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.15"
              },
              "items": [
                {
                  "text": "Rum 8:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na kwa kuwa ninyi mmekuwa wana, Mungu alimtuma Roho wa Mwanawe mioyoni mwetu, aliaye, Aba, yaani, Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.29"
              },
              "items": [
                {
                  "text": "Gal 3:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.16"
              },
              "items": [
                {
                  "text": "Rum 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama ni hivyo, wewe si mtumwa tena bali u mwana; na kama u mwana, basi, u mrithi kwa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        }
      ]
