                "loc": "COL.2.20"
              },
              "items": [
                {
                  "text": "Kol 2:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kadhalika na sisi, tulipokuwa watoto, tulikuwa tukitumikishwa na kawaida za kwanza za dunia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.3",
            "verseOrgIds": [
              "GAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.10"
              },
              "items": [
                {
                  "text": "Efe 1:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata ulipowadia utimilifu wa wakati, Mungu alimtuma Mwanawe ambaye amezaliwa na mwanamke, amezaliwa chini ya sheria, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.4",
            "verseOrgIds": [
              "GAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.15+ROM.8.16+ROM.8.17"
              },
              "items": [
                {
                  "text": "Rum 8:15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.13"
              },
              "items": [
                {
                  "text": "Gal 3:13",
