          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini wakati ule, kwa kuwa hamkumjua Mungu, mliwatumikia wao ambao kwa asili si miungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.8",
            "verseOrgIds": [
              "GAL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bali sasa mkiisha kumjua Mungu, au zaidi kujulikana na Mungu, kwa nini kuyarejea tena mafundisho ya kwanza yaliyo manyonge, yenye upungufu, ambayo mnataka kuyatumikia tena? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.5"
              },
              "items": [
                {
                  "text": "Rum 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.16"
              },
              "items": [
                {
                  "text": "Kol 2:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mnashika siku, na miezi, na nyakati, na miaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.10",
            "verseOrgIds": [
              "GAL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.8"
              },
              "items": [
                {
                  "text": "2 Yoh 1:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nawachelea, isiwe labda nimejitaabisha bure kwa ajili yenu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        }
