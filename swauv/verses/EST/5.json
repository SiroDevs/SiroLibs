        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.27.1"
              },
              "items": [
                {
                  "text": "Mit 27:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.3"
              },
              "items": [
                {
                  "text": "1 The 5:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Zaidi ya hayo Hamani akasema, Naye malkia Esta hakumkaribisha mtu ye yote pamoja na mfalme katika karamu aliyoiandaa, ila mimi peke yangu; hata na kesho pia nimealikwa naye pamoja na mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
