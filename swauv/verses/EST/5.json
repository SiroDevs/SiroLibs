                "loc": "GEN.43.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Walakini Hamani akajizuia, akaenda zake nyumbani kwake; akatuma kuwaita rafiki zake na Zereshi mkewe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
