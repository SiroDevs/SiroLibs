              "items": [
                {
                  "text": "Ayu 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bali haya yote yanifaa nini, pindi nimwonapo yule Mordekai, Myahudi, ameketi mlangoni pa mfalme? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        },
