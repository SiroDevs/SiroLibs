          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi tubu; na usipotubu, naja kwako upesi, nami nitafanya vita juu yao kwa huo upanga wa kinywa changu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        },
