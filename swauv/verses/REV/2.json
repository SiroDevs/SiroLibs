                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "naye atawachunga kwa fimbo ya chuma, kama vyombo vya mfinyanzi vipondwavyo, kama mimi nami nilivyopokea kwa Baba yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
