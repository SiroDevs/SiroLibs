              },
              "items": [
                {
                  "text": "Ufu 3:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ila mlicho nacho kishikeni sana, hata nitakapokuja. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
