            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.8+PSA.2.9"
              },
              "items": [
                {
                  "text": "Zab 2:8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na yeye ashindaye, na kuyatunza matendo yangu hata mwisho, nitampa mamlaka juu ya mataifa, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
