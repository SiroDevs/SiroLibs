              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo wewe nawe unao watu wayashikao mafundisho ya Wanikolai vile vile. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
