                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakasema mara ya pili, Haleluya. Na moshi wake hupaa juu hata milele na milele. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        },
