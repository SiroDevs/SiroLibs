                }
              ]
            }
          ]
        },
        {
          "text": "Na tufurahi, tukashangilie, tukampe utukufu wake; kwa kuwa arusi ya Mwana-Kondoo imekuja, na mkewe amejiweka tayari. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
