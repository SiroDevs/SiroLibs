        },
        {
          "text": "kwa kuwa hukumu zake ni za kweli na za haki; maana amemhukumu yule kahaba mkuu aliyeiharibu nchi kwa uasherati wake, na kuipatiliza damu ya watumwa wake mkononi mwake. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
