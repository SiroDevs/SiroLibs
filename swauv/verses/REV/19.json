        },
        {
          "text": "Baada ya hayo nikasikia sauti kama sauti ya makutano mengi, sauti kubwa mbinguni, ikisema, Haleluya;",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        },
        {
