              "items": [
                {
                  "text": "135:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sauti ikatoka katika kile kiti cha enzi ikisema, Msifuni Mungu wetu, enyi watumwa wake wote, ninyi mnaomcha, wadogo kwa wakuu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
