                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye amepewa kuvikwa kitani nzuri, ing’arayo, safi; kwa maana kitani nzuri hiyo ni matendo ya haki ya watakatifu.",
          "type": "text",
          "attrs": {
