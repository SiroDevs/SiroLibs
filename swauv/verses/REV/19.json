          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:1",
              "type": "text"
            },
            {
              "text": "Haleluya",
              "type": "text"
            },
            {
              "text": "maana yake ni, Msifuni Bwana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wokovu na utukufu na nguvu zina Bwana Mungu wetu; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        },
