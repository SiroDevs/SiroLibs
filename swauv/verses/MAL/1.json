                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na macho yenu ninyi yataona, nanyi mtasema, BWANA ndiye mkuu kupita mpaka wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.5",
