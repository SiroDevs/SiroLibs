              "items": [
                {
                  "text": "Kum 15:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena mtoapo sadaka aliye kipofu, si vibaya? Na mtoapo sadaka walio vilema na wagonjwa, si vibaya? Haya! Mtolee liwali wako; je! Atakuwa radhi nawe? Au atakukubali nafsi yako? Asema BWANA wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.8",
            "verseOrgIds": [
              "MAL.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 1:9"
          },
          "items": [
