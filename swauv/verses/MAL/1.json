            "sid": "MAL 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakini ninyi mnalitia unajisi, kwa kuwa mwasema, Meza ya BWANA imetiwa unajisi; na matunda yake, yaani, nyama yake, hudharauliwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.12",
            "verseOrgIds": [
              "MAL.1.12"
            ]
          }
        },
        {
          "name": "verse",
