                  "text": "Isa 1:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena mwasema, Tazama, jambo hili linatuchokesha namna gani! Nanyi mmelidharau, asema BWANA wa majeshi; nanyi mmeleta kitu kilichopatikana kwa udhalimu, na kilema, na kilicho kigonjwa; ndivyo mnavyoleta sadaka; je! Niikubali hii mikononi mwenu? Asema BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.13",
            "verseOrgIds": [
              "MAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
