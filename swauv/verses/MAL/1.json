              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "bali Esau nimemchukia na kuifanya milima yake kuwa ukiwa, na urithi wake nimewapa mbweha wa nyikani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.3",
            "verseOrgIds": [
              "MAL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijapokuwa Edomu asema, Tumepondwa-pondwa, lakini tutarudi na kupajenga mahali palipoachwa hali ya ukiwa; BWANA wa majeshi asema hivi, Wao watajenga, bali mimi nitaangusha; na watu watawaita, Mpaka wa uovu, na, Watu ambao BWANA anawaghadhabikia milele. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.1.4",
            "verseOrgIds": [
              "MAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
