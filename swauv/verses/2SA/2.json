          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao wana wa Benyamini wakakusanyika pamoja nyuma ya Abneri, wakawa kikosi kimoja, wakasimama juu ya mlima. ",
          "type": "text",
          "attrs": {
