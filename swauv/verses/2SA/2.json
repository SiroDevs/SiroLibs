          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yoabu akapiga tarumbeta, na watu wote wakasimama, wasiwafuatie Israeli tena, wala hawakupigana tena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
