    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakamwambia Daudi wakasema, Watu wa Yabesh-gileadi ndio waliomzika Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.15"
              },
              "items": [
                {
                  "text": "Zab 115:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Daudi akatuma wajumbe kwa watu wa Yabesh-gileadi, na kuwaambia, Na mbarikiwe ninyi na BWANA, kwa kuwa mmemtendea bwana wenu fadhili hii, yaani Sauli, mkamzika. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.5",
            "verseOrgIds": [
              "2SA.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.16"
              },
              "items": [
                {
                  "text": "2 Tim 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mt 5:44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA naye sasa awatendee ninyi fadhili na kweli; mimi nami nitawalipeni fadhili hiyo, kwa sababu mmetenda jambo hilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.6",
            "verseOrgIds": [
              "2SA.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi sasa, mikono yenu na itiwe nguvu, nanyi iweni mashujaa; maana Sauli, bwana wenu, amekufa, tena nyumba ya Yuda wamenitia mimi mafuta niwe mfalme juu yao.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.7",
            "verseOrgIds": [
              "2SA.2.7"
            ]
          }
        }
      ]
    },
