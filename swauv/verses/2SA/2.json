              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi watu wa Yuda wakaenda, wakamtia Daudi mafuta huko, awe mfalme juu ya nyumba ya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.4",
            "verseOrgIds": [
              "2SA.2.4"
            ]
          }
        }
