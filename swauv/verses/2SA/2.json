                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Yoabu akasema, Aishivyo Mungu, usingalinena, basi asubuhi wangalikwenda zao, wasiwafuatie kila mtu ndugu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
