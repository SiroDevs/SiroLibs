                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ikawa baada ya hayo, Daudi akauliza kwa BWANA, akasema, Je! Niupandie mji wo wote wa Yuda? BWANA akamwambia, Haya! Panda. Daudi akasema, Niupandie mji upi? Akasema, Hebroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.42+1SA.25.43"
              },
              "items": [
                {
                  "text": "1 Sam 25:42-43",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Daudi akapanda aende huko, pamoja na wakeze wawili, Ahinoamu wa Yezreeli, na Abigaili, mkewe Nabali, wa Karmeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.2",
            "verseOrgIds": [
              "2SA.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.27.2"
              },
              "items": [
                {
                  "text": "1 Sam 27:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi naye akawapandisha watu wake waliokuwa pamoja naye, kila mtu na watu wa nyumbani mwake; wakakaa katika miji ya Hebroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.3",
            "verseOrgIds": [
              "2SA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 2:4"
          },
          "items": [
