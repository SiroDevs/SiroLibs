                "loc": "ISA.28.21"
              },
              "items": [
                {
                  "text": "Isa 28:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Abneri, mwana wa Neri, na watumishi wa Ishboshethi, mwana wa Sauli, wakatoka Mahanaimu kwenda Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.12",
            "verseOrgIds": [
              "2SA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.12"
              },
              "items": [
                {
                  "text": "Yer 41:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Huyo Yoabu naye, mwana wa Seruya, na watumishi wa Daudi, wakatoka, wakakutana nao karibu na ziwa la Gibeoni; wakaketi, hawa upande huu wa ziwa, na hawa upande huu wa ziwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.13",
            "verseOrgIds": [
              "2SA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.10.23"
              },
              "items": [
                {
                  "text": "Mit 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.13.10"
              },
              "items": [
                {
                  "text": "13:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Abneri akamwambia Yoabu, Tafadhali vijana hawa na waondoke na kucheza mbele yetu. Yoabu akasema, Haya! Na waondoke. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.14",
            "verseOrgIds": [
              "2SA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakaondoka, wakaenda upande wa pili kwa hesabu yao watu kumi na wawili wa Benyamini, na wa Ishboshethi, mwana wa Sauli na watu kumi na wawili wa watumishi wa Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.15",
            "verseOrgIds": [
              "2SA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakamatana, kila mtu akimshika mwenziwe kichwa chake, na kutia upanga wake katika ubavu wa mwenzake; wakaanguka pamoja; hata mahali pale pakaitwa Helkath-hasurimu, napo ni katika Gibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.16",
