              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo akaondoka Yoabu, akamwendea Absalomu nyumbani kwake, akamwambia, Kwa nini watumishi wako wamelitia moto shamba langu? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.31",
            "verseOrgIds": [
