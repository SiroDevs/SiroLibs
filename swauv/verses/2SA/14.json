              "items": [
                {
                  "text": "1 Fal 2:33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo huyo mwanamke wa Tekoa akamwambia mfalme, Na uwe juu yangu, Ee bwana wangu mfalme, na juu ya nyumba ya baba yangu uovu huu; wala kwa mfalme na kwa kiti chake cha enzi pasiwepo hatia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.9",
            "verseOrgIds": [
              "2SA.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akasema, Ye yote atakaye kuambia neno, mlete kwangu, naye hatakugusa tena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.10",
            "verseOrgIds": [
              "2SA.14.10"
            ]
          }
        },
