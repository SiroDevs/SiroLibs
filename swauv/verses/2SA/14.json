                  "text": "2 Fal 6:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye yule mwanamke wa Tekoa aliponena na mfalme, akaanguka kifulifuli chini, akamsujudia, akasema, Nisaidie, Ee mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
