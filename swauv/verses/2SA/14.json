                "loc": "DEU.19.12"
              },
              "items": [
                {
                  "text": "Kum 19:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tazama, jamaa yote wameniinukia mimi mjakazi wako, wakasema, Mtoe yule aliyempiga nduguye, ili tupate kumwua yeye kwa maisha ya nduguye aliyemwua, hata na kumfisha mrithi pia; ndivyo watakavyolizima kaa langu lililobaki, wasimwachie mume wangu jina wala masalio usoni pa nchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akamwambia huyo mwanamke, Nenda nyumbani kwako, nami nitakufanyia agizo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.8",
            "verseOrgIds": [
              "2SA.14.8"
            ]
          }
        },
