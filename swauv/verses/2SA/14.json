              "type": "text"
            }
          ]
        },
        {
          "text": "Absalomu akakaa miaka miwili mizima katika Yerusalemu; asimwone uso mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
