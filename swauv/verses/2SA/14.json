                  "text": "2 Sam 19:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "mtumwa wako Yoabu ameyatenda haya ili kubadili uso wa jambo hili; na bwana wangu anayo akili, kama akili ya malaika wa Mungu, hata ajue mambo yote ya duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        },
        {
          "name": "verse",
