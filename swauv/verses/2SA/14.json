              "items": [
                {
                  "text": "Mdo 27:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo akajibu, Nakusihi, mfalme na amkumbuke BWANA, Mungu wako, ili mlipiza kisasi cha damu asizidi kuharibu, wasije kumharibu mwanangu. Naye akasema, Aishivyo BWANA, hautaanguka chini hata unywele mmoja wa mwanao. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanamke akasema, Mwache mjakazi wako, nakusihi, niseme neno moja kwa bwana wangu mfalme. Akasema, Haya nena. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.2"
              },
              "items": [
                {
                  "text": "Amu 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.13.37"
              },
              "items": [
                {
                  "text": "2 Sam 13:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanamke akasema, Kwa nini basi wewe umewafikiria mambo kama hayo watu wa Mungu? Kwani kwa kunena neno hili mfalme ni kama mwenye hatia, kwa kuwa mfalme hamleti kwao tena yule mfukuzwa wake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
