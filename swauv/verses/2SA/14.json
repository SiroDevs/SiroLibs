              },
              "items": [
                {
                  "text": "Kut 4:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kisha uingie kwa mfalme ukamwambie maneno haya. Hivyo Yoabu akamtia maneno kinywani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
