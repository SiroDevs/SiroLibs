          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Absalomu akatuma kumwita Yoabu, ampeleke kwa mfalme, lakini yeye akakataa kumjia; akatuma tena mara ya pili, lakini akakataa kuja. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
