              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Yoabu akapiga tarumbeta, wakarudi watu toka kuwafuatia Israeli; kwani Yoabu akawazuia watu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
