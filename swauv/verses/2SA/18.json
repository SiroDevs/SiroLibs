                "loc": "ISA.31.6+ISA.31.7+ISA.31.8+ISA.31.9"
              },
              "items": [
                {
                  "text": "Isa 31:6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Daudi alikuwa ameketi kati ya malango mawili; mlinzi akapanda juu hata dari ya lile lango hata ukutani, akainua macho yake, akaangalia, na tazama, mtu anakuja mbio peke yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlinzi akalia, akamwambia mfalme. Naye mfalme akasema, Kama yu peke yake, ana habari kinywani mwake. Akaja mbio, akakaribia. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha huyo mlinzi akaona mtu mwingine anapiga mbio; mlinzi akamwita bawabu, akasema, Angalia, mtu mwingine anakuja mbio peke yake. Mfalme akasema, Huyu naye analeta habari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.42"
              },
              "items": [
                {
                  "text": "1 Fal 1:42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na huyo mlinzi akasema, Nionavyo mimi, kupiga mbio kwake yule wa kwanza ni kama kupiga mbio kwake Ahimaasi, mwana wa Sadoki. Naye mfalme akasema, Yeye ni mtu mwema, anakuja na habari njema. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaasi akainua sauti yake, akamwambia mfalme, Amani. Akainama mbele ya mfalme kifudifudi, akasema, Ahimidiwe BWANA, Mungu wako, aliyewatoa watu hao walioiinua mikono yao juu ya bwana wangu, mfalme. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalme akauliza, Je! Yule kijana, Absalomu, yu salama? Ahimaasi akajibu, Yoabu aliponituma mimi mtumishi wa mfalme, mimi mtumishi wako, naliona kishindo kikubwa, lakini sikujua sababu yake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme akasema, Geuka, usimame hapa. Akageuka, akasimama. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.27.2"
              },
              "items": [
                {
                  "text": "Zab 27:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.55.18"
              },
              "items": [
                {
                  "text": "55:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tazama, yule Mkushi akafika; Mkushi akasema, Nina habari kwa bwana wangu mfalme; kwa maana BWANA amekulipizia kisasi leo juu ya hao wote walioinuka kupigana nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalme akamwambia yule Mkushi, Yule kijana, Absalomu, je! Yu salama? Yule Mkushi akajibu, Adui za bwana wangu mfalme, na wote wainukao ili kukudhuru, na wawe kama alivyo yule kijana.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
