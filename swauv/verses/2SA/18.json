                  "text": "17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Ahimaasi, mwana wa Sadoki, akasema, Niende mbio sasa, nikampelekee mfalme habari, jinsi BWANA alivyomlipiza kisasi juu ya adui zake. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabu akamwambia, Wewe hutakuwa mchukua habari leo, siku nyingine utachukua habari; lakini leo hutachukua habari, kwa sababu mwana wa mfalme amekufa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yoabu akamwambia Mkushi mmoja, Nenda ukamwambie mfalme hayo uliyoyaona. Na huyo Mkushi akajiinamisha mbele ya Yoabu, akaenda zake mbio. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ahimaasi, mwana wa Sadoki, akamwambia Yoabu mara ya pili, Haidhuru, tafadhali nipe ruhusa, nipige mbio na mimi nyuma ya huyo Mkushi. Naye Yoabu akasema, Mbona wewe unataka kupiga mbio, mwanangu, kwa maana hutapata kitu kwa habari hizo unazopeleka? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasema, Haidhuru, nitapiga mbio. Akamwambia, Haya, piga mbio. Ndipo Ahimaasi akapiga mbio, akishika njia ya uwandani, akampita yule Mkushi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
