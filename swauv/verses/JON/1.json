                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ondoka, uende Ninawi, mji ule mkubwa, ukapige kelele juu yake; kwa maana uovu wao umepanda juu mbele zangu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.2",
            "verseOrgIds": [
              "JON.1.2"
            ]
          }
        },
        {
