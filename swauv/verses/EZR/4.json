          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakawaajiri washauri juu yao, ili kuwapinga kusudi lao, siku zote za Koreshi, mfalme wa Uajemi, hata wakati wa kutawala kwake Dario, mfalme wa Uajemi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
