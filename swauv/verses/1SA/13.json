        },
        {
          "text": "Sauli akasema, Nileteeni hapa sadaka ya kuteketezwa na sadaka za amani. Akaitoa sadaka ya kuteketezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.9",
            "verseOrgIds": [
              "1SA.13.9"
            ]
