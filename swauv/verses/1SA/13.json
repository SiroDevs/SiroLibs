          ]
        },
        {
          "text": "lakini Waisraeli wote hushuka kwa Wafilisti, ili kunoa kila mtu jembe lake, na mundu wake, na shoka lake, na sululu yake; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.20",
            "verseOrgIds": [
              "1SA.13.20"
            ]
          }
        },
