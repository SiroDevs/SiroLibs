          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Sauli, na mwanawe Yonathani, na watu waliokuwapo pamoja nao, wakakaa huko Geba ya Benyamini; lakini Wafilisti wakatua katika Mikmashi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.16",
            "verseOrgIds": [
              "1SA.13.16"
            ]
          }
        },
        {
