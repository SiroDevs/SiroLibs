          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ila walikuwa na tupa za kunolea sululu, na miundu, na mauma, na mashoka; na kwa kuinoa michokoo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.21",
            "verseOrgIds": [
              "1SA.13.21"
            ]
          }
