          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.2"
              },
              "items": [
                {
                  "text": "Yos 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.29"
              },
              "items": [
                {
                  "text": "Amu 1:29",
                  "type": "text"
