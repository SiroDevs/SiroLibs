              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.18"
              },
              "items": [
                {
                  "text": "Mwa 25:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Daudi na watu wake walikuwa wakikwea na kuwashambulia Wageshuri, na Wagirizi, na Waamaleki waliokuwa wenyeji wa nchi hiyo, tangu Telemu, hapo uendapo Shuri, hata mpaka nchi ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.8",
            "verseOrgIds": [
              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Daudi akaipiga nchi hiyo, asimhifadhi hai mume wala mke, akateka nyara kondoo, na ng’ombe, na punda, na ngamia na mavazi; kisha akarejea na kufika kwa Akishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.3"
              },
              "items": [
                {
                  "text": "Zab 141:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.25"
              },
              "items": [
                {
                  "text": "Mit 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.2.9"
              },
              "items": [
                {
                  "text": "1 Nya 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Akishi humwuliza, Je! Mmeshambulia upande gani leo? Na Daudi husema, Juu ya Negebu ya Yuda, au, juu ya Negebu ya Wayerameeli, au, juu ya Negebu ya Wakeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tena Daudi hakumhifadhi hai mume wala mke, ili kuwaleta Gathi maana alisema, Wasituchongee kusema, Ndivyo alivyofanya Daudi, tena ndivyo ilivyokuwa desturi yake wakati wote alipokaa katika nchi ya Wafilisti. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Akishi akamsadiki Daudi, akasema, Amewachukiza kabisa hao watu wake Israeli; kwa hiyo atakuwa mtumishi wangu hata milele.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
      ]
    }
