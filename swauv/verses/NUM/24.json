        },
        {
          "text": "Basi Balaamu alipoona ya kuwa ilimpendeza BWANA kuwabariki Israeli, hakwenda, kama hapo kwanza, ili kutafuta uchawi, bali alielekeza uso wake jangwani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
