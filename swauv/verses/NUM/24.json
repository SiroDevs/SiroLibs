              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu akamwambia Balaki, Je! Sikuwaambia wajumbe wako ulionipelekea, nikisema, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama Balaki angenipa nyumba yake imejaa fedha na dhahabu, siwezi kupita mpaka wa neno la BWANA, kutenda neno jema, wala neno baya, kwa nia yangu mwenyewe; BWANA atakalolinena ndilo nitakalolinena mimi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        }
