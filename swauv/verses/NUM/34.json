        },
        {
          "text": "kisha mpaka utageuka kutoka Azmoni kwendelea kijito cha Misri, na kutokea kwake kutakuwa hapo baharini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
