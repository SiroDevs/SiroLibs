            }
          ]
        },
        {
          "text": "kisha mpaka wenu utageuka kwenda upande wa kusini wa kukwelea kwake Akrabimu, kisha kupita kwendelea Sini; na kutokea kwake kutakuwa kuelekea upande wa kusini wa Kadesh-barnea; kisha utaendelea mpaka Hasar-adari, na kufikilia Azmoni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
