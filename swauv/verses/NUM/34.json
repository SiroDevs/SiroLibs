        {
          "text": "ndipo upande wenu wa kusini utakuwa tangu bara ya Sini kupita kando ya Edomu, na mpaka wenu wa kusini utakuwa tangu mwisho wa Bahari ya Chumvi kuelekea mashariki; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
