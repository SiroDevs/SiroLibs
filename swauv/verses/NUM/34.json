            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mpaka wenu wa upande wa kaskazini utakuwa ni huu; kutoka bahari kubwa mtajiandikia mlima wa Hori; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
