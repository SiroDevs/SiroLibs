          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha mpaka wenu wa upande wa magharibi mtakuwa na bahari kubwa na mpaka wake; hii ndiyo mpaka wenu upande wa magharibi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
