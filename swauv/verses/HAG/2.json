                {
                  "text": "Hag 1:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na sasa nawaomba, tafakarini; tangu siku hii na siku zilizopita; kabla halijatiwa bado jiwe juu ya jiwe katika nyumba ya BWANA; ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.15",
            "verseOrgIds": [
              "HAG.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAG 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "katika wakati huo wote, mtu alipofikia chungu ya vipimo ishirini, palikuwa na vipimo kumi tu; na mtu alipofikia shinikizo apate kuteka divai ya vyombo hamsini, palikuwa na divai ya vyombo ishirini tu. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.16",
            "verseOrgIds": [
              "HAG.2.16"
            ]
          }
        },
