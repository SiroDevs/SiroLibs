          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sema sasa na Zerubabeli, mwana wa Shealtieli, liwali wa Yuda, na Yoshua, mwana wa Yehosadaki, kuhani mkuu, na hayo mabaki ya watu, ukisema, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.2",
