                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, Waulizeni sasa makuhani katika habari ya sheria, mkisema, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtu akichukua nyama takatifu katika upindo wa nguo yake, naye akagusa kwa upindo wake mkate, au ugali, au divai, au mafuta, au chakula cho chote, je! Kitu hicho kitakuwa kitakatifu? Makuhani wakajibu, wakasema, La. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.11+NUM.19.12+NUM.19.13+NUM.19.14+NUM.19.15+NUM.19.16+NUM.19.17+NUM.19.18+NUM.19.19+NUM.19.20+NUM.19.21+NUM.19.22"
              },
              "items": [
                {
                  "text": "Hes 19:11-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Hagai akasema, Kama mtu aliyetiwa unajisi kwa kugusa maiti, akigusa kimojawapo cha vitu hivi, je! Kitakuwa najisi? Makuhani wakajibu, wakasema, Kitakuwa najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.13",
            "verseOrgIds": [
              "HAG.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAG 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.15"
              },
              "items": [
                {
                  "text": "Tit 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo Hagai akajibu, akasema, Hivyo ndivyo walivyo watu hawa, na hivyo ndivyo lilivyo taifa hili mbele zangu, asema BWANA; na hivyo ndivyo ilivyo kila kazi ya mikono yao; na kitu hicho wakitoacho sadaka huko ni najisi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.14",
            "verseOrgIds": [
              "HAG.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAG 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
