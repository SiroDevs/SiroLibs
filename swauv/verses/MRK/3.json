            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akaingia nyumbani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkutano wakakusanyika tena, hata wao wenyewe wasiweze hata kula mkate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.20",
            "verseOrgIds": [
              "MRK.3.20"
            ]
          }
        },
