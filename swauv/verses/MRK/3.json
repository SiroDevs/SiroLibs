                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jamaa zake walipopata habari wakatoka kwenda kumkamata; maana walisema, Amerukwa na akili. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.21",
            "verseOrgIds": [
              "MRK.3.21"
            ]
          }
        },
