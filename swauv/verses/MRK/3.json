              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.54"
              },
              "items": [
                {
                  "text": "Lk 9:54",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na Yakobo, mwana wa Zebedayo, na Yohana nduguye Yakobo, akawapa jina la Boanerge, maana yake, wana wa ngurumo; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Andrea, na Filipo, na Bartholomayo, na Mathayo, na Tomaso, na Yakobo wa Alfayo, na Thadayo, na Simoni Mkananayo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda Iskariote, ndiye aliyemsaliti.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu na Belzebuli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
