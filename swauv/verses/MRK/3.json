              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.22"
              },
              "items": [
                {
                  "text": "Mk 3:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa vile walivyosema, Ana pepo mchafu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
            "verseOrgIds": [
              "MRK.3.30"
            ]
