                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Yesu akajitenga, yeye na wanafunzi wake, akaenda baharini. Mkutano mkuu ukamfuata, kutoka Galilaya, na Uyahudi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.7",
            "verseOrgIds": [
              "MRK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.25"
              },
              "items": [
                {
                  "text": "Mt 4:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na Yerusalemu, na Idumaya, na ng’ambo ya Yordani, na pande za Tiro na Sidoni, mkutano mkuu, waliposikia habari za mambo yote aliyokuwa akiyatenda, wakamwendea. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "Mk 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.1+LUK.5.2+LUK.5.3"
              },
              "items": [
                {
                  "text": "Lk 5:1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akawaambia wanafunzi wake ya kwamba chombo kidogo kikae karibu naye, kwa sababu ya mkutano, wasije wakamsonga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
              "MRK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana aliponya wengi, hata wote waliokuwa na misiba wakamrukia wapate kumgusa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.41"
              },
              "items": [
                {
                  "text": "Lk 4:41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na pepo wachafu, kila walipomwona, walianguka mbele yake, wakalia wakisema, Wewe ndiwe Mwana wa Mungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.34"
              },
              "items": [
                {
                  "text": "Mk 1:34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akawakataza sana, wasimdhihirishe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
      ]
    },
