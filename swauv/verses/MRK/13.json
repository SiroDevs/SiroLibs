              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amin, nawaambieni, Kizazi hiki hakitapita, hata hayo yote yatimie. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
