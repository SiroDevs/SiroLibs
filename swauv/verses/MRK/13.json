          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na wakati huo mtu akiwaambia, Tazama, Kristo yupo hapa, au yuko kule, msisadiki; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
