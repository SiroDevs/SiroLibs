                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa maana wataondoka Makristo wa uongo, na manabii wa uongo, watatoa ishara na maajabu, wapate kuwadanganya, kama yamkini, hata hao wateule. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
