          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kama Bwana asingalizikatiza siku hizo, asingeokoka mtu ye yote; lakini kwa ajili ya wateule aliowateua amezikatiza siku hizo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
