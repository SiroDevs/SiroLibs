          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanyi kadhalika, myaonapo mambo hayo yanaanza, tambueni ya kuwa yu karibu milangoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
