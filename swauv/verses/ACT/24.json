                  "text": "Mdo 27:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akamwamuru yule akida kwamba Paulo alindwe; ila awe na nafasi, wala asimkataze mmojawapo wa rafiki zake kumtumikia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        }
