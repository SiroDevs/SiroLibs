              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Feliki aliwaahirisha, kwa sababu alijua habari za Njia ile kwa usahihi zaidi, akasema, Lisia jemadari atakapotelemka nitakata maneno yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
