              "items": [
                {
                  "text": "Mdo 15:23-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi walipokuwa wakipita kati ya miji ile, wakawapa zile amri zilizoamriwa na mitume na wazee walioko Yerusalemu, ili wazishike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makanisa yakatiwa nguvu katika ile Imani, hesabu yao ikaongezeka kila siku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maono ya Paulo juu ya Mtu wa Makedonia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
