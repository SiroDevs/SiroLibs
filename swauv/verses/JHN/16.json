          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na siku ile mtaomba kwa jina langu, wala siwaambii ya kwamba mimi nitawaombea kwa Baba; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.26",
