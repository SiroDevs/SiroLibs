              "items": [
                {
                  "text": "Yn 14:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa maana Baba mwenyewe awapenda kwa kuwa ninyi mmenipenda mimi, na kusadiki ya kwamba mimi nalitoka kwa Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
