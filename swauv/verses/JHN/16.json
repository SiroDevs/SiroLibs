            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneno hayo nimewaambia, msije mkachukizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.1",
            "verseOrgIds": [
              "JHN.16.1"
            ]
          }
        },
        {
