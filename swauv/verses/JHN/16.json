                  "text": "Isa 66:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi ninyi hivi sasa mna huzuni; lakini mimi nitawaona tena; na mioyo yenu itafurahi, na furaha yenu hakuna awaondoleaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.22",
            "verseOrgIds": [
