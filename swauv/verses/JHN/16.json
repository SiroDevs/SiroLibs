              "items": [
                {
                  "text": "Isa 26:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwanamke azaapo, yuna huzuni kwa kuwa saa yake imefika; lakini akiisha kuzaa mwana, haikumbuki tena ile dhiki, kwa sababu ya furaha ya kuzaliwa mtu ulimwenguni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.21",
            "verseOrgIds": [
              "JHN.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 16:22"
