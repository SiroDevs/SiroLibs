                  "text": "Mk 11:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tena siku ile hamtaniuliza neno lo lote. Amin, amin, nawaambia, Mkimwomba Baba neno lo lote atawapa kwa jina langu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.23",
