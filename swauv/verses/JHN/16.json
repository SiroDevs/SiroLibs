                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi wanafunzi wake wakasema, Tazama, sasa wasema waziwazi, wala huneni mithali yo yote. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
