          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalitoka kwa Baba, nami nimekuja hapa ulimwenguni; tena nauacha ulimwengu; na kwenda kwa Baba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
            "verseOrgIds": [
