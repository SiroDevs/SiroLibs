            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bado kitambo kidogo nanyi hamnioni; na tena bado kitambo kidogo nanyi mtaniona.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
