                }
              ]
            }
          ]
        },
        {
          "text": "Baada ya hayo Yesu, hali akijua ya kuwa yote yamekwisha kumalizika ili andiko litimizwe, akasema, Naona kiu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
