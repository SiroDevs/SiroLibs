              },
              "items": [
                {
                  "text": "Zab 69:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kulikuwako huko chombo kimejaa siki; basi wakatia sifongo iliyojaa siki juu ya ufito wa hisopo, wakampelekea kinywani. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
