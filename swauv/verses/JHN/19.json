              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na penye msalaba wake Yesu walikuwa wamesimama mamaye, na umbu la mamaye, Mariamu wa Klopa, na Mariamu Magdalene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
