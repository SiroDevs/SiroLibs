  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "JHN 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi ndipo Pilato alipomtwaa Yesu, akampiga mijeledi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.1",
            "verseOrgIds": [
              "JHN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao askari wakasokota taji ya miiba, wakamtia kichwani, wakamvika vazi la zambarau. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.2",
            "verseOrgIds": [
              "JHN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.22"
              },
              "items": [
                {
                  "text": "Yn 18:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakawa wakimwendea, wakisema, Salamu! Mfalme wa Wayahudi! Wakampiga makofi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.3",
            "verseOrgIds": [
              "JHN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha Pilato akatokea tena nje, akawaambia, Mtu huyu namleta nje kwenu, mpate kufahamu ya kuwa mimi sioni hatia yo yote kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.4",
            "verseOrgIds": [
              "JHN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu alipotoka nje, naye amevaa ile taji ya miiba, na lile vazi la zambarau. Pilato akawaambia, Tazama, mtu huyu! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.5",
            "verseOrgIds": [
              "JHN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wale wakuu wa makuhani na watumishi wao walipomwona, walipiga kelele wakisema, Msulibishe! Msulibishe! Pilato akawaambia, Mtwaeni ninyi basi, mkamsulibishe; kwa maana mimi sioni hatia kwake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.6",
            "verseOrgIds": [
              "JHN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.18"
              },
              "items": [
                {
                  "text": "Yn 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.33"
              },
              "items": [
                {
                  "text": "10:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.16"
              },
              "items": [
                {
                  "text": "Law 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wayahudi wakamjibu, Sisi tunayo sheria, na kwa sheria hiyo amestahili kufa, kwa sababu alijifanya kuwa Mwana wa Mungu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.7",
            "verseOrgIds": [
              "JHN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Pilato aliposikia neno hilo, akazidi kuogopa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.8",
            "verseOrgIds": [
              "JHN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaingia tena ndani ya ile Praitorio, akamwambia Yesu, Wewe umetokapi? Lakini Yesu hakumpa jibu lo lote. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.9",
            "verseOrgIds": [
              "JHN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Pilato akamwambia, Husemi nami? Hujui ya kuwa mimi nina mamlaka ya kukufungua, nami nina mamlaka ya kukusulibisha? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.10",
            "verseOrgIds": [
              "JHN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.18"
              },
              "items": [
                {
                  "text": "Yn 10:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.23"
              },
              "items": [
                {
                  "text": "Mdo 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesu akamjibu, Wewe hungekuwa na mamlaka yo yote juu yangu, kama usingepewa kutoka juu; kwa hiyo yeye aliyenitia mikononi mwako yuna dhambi iliyo kubwa zaidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.11",
            "verseOrgIds": [
              "JHN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.7"
              },
              "items": [
                {
                  "text": "Mdo 17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na tangu hapo Pilato akatafuta kumfungua; lakini Wayahudi wakapiga makelele wakisema, Ukimfungua huyu, wewe si rafiki yake Kaisari; kila mtu ajifanyaye kuwa mfalme humfitini Kaisari. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Pilato, aliposikia maneno hayo, akamleta Yesu nje, akaketi juu ya kiti cha hukumu, mahali paitwapo Sakafu ya Mawe, au kwa Kiebrania, Gabatha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ilikuwa Maandalio ya pasaka, yapata saa sita. Akawaambia Wayahudi, Tazama, Mfalme wenu! ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.6"
              },
              "items": [
                {
                  "text": "Yn 19:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi wale wakapiga kelele, Mwondoshe! Mwondoshe! Msulibishe! Pilato akawaambia, Je! Nimsulibishe mfalme wenu! Wakuu wa makuhani wakamjibu, Sisi hatuna mfalme ila Kaisari.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusulubiwa kwa Yesu",
          "type": "text"
        }
      ]
    },
