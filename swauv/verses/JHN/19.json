              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha akamwambia yule mwanafunzi, Tazama, mama yako. Na tangu saa ile mwanafunzi yule akamchukua nyumbani kwake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
