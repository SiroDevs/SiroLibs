                "loc": "JHN.3.1+JHN.3.2"
              },
              "items": [
                {
                  "text": "Yn 3:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.2.11"
              },
              "items": [
                {
                  "text": "Mt 2:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaenda Nikodemo naye, (yule aliyemwendea usiku hapo kwanza), akaleta machanganyiko ya manemane na uudi, yapata ratli mia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi wakautwaa mwili wake Yesu, wakaufunga sanda ya kitani pamoja na yale manukato, kama ilivyo desturi ya Wayahudi katika kuzika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na pale pale aliposulibiwa palikuwa na bustani; na ndani ya bustani mna kaburi jipya, ambalo hajatiwa bado mtu ye yote ndani yake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humo basi, kwa sababu ya Maandalio ya Wayahudi, wakamweka Yesu; maana lile kaburi lilikuwa karib",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
