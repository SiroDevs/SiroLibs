                }
              ]
            }
          ]
        },
        {
          "text": "Basi wakaambiana, Tusiipasue, lakini tuipigie kura, iwe ya nani. Ili litimie andiko lile linenalo,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
