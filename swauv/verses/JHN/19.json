                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi Yesu alipomwona mama yake, na yule mwanafunzi aliyempenda amesimama karibu, alimwambia mama yake, Mama, tazama, mwanao. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
