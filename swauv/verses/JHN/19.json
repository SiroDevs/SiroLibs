          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basi Yesu alipokwisha kuipokea ile siki, alisema, Imekwisha. Akainama kichwa, akaisalimu roho yake.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
