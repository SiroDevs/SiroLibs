              "items": [
                {
                  "text": "Mk 12:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amri yangu ndiyo hii, Mpendane, kama nilivyowapenda ninyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
