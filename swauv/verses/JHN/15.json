              "items": [
                {
                  "text": "1 Yoh 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakuna aliye na upendo mwingi kuliko huu, wa mtu kuutoa uhai wake kwa ajili ya rafiki zake. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
