            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama vile Baba alivyonipenda mimi, nami nilivyowapenda ninyi, kaeni katika pendo langu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
