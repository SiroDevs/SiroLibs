                "loc": "DAN.8.18"
              },
              "items": [
                {
                  "text": "Dan 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yule malaika aliyesema nami akanijia mara ya pili, akaniamsha, kama mtu aamshwavyo katika usingizi wake. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "Kut 25:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.5"
              },
              "items": [
                {
                  "text": "Ufu 4:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akaniuliza, Unaona nini? Nikasema, Nimeona, na tazama, kinara cha taa cha dhahabu tupu, nacho kina bakuli juu yake, na taa zake saba juu yake; tena iko mirija saba ya kuleta mafuta, kwa taa zote zilizo juu yake; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.4"
              },
              "items": [
                {
                  "text": "Ufu 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na mizeituni miwili karibu yake, mmoja upande wa kuume walile bakuli, na mmoja upande wake wa kushoto. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.3",
            "verseOrgIds": [
              "ZEC.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nikajibu, nikamwambia yule malaika aliyesema nami, nikasema, Ee Bwana wangu, vitu hivi ni nini? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo malaika aliyesema nami akajibu, akaniambia, Hujui vitu hivi ni nini? Nikasema, La, Bwana wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.5",
            "verseOrgIds": [
              "ZEC.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.5.2"
              },
              "items": [
                {
                  "text": "Ezr 5:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akajibu akaniambia, akisema, Hili ndilo neno la BWANA kwa Zerubabeli, kusema, Si kwa uwezo, wala si kwa nguvu, bali ni kwa roho yangu, asema BWANA wa majeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.6",
            "verseOrgIds": [
              "ZEC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
