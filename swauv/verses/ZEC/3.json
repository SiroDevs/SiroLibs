                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akamwambia Shetani, BWANA na akukemee Ewe Shetani; naam, BWANA, aliyechagua Yerusalemu, na akukemee; je! Hiki si kinga kilichotolewa motoni? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
