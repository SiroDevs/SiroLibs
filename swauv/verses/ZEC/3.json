                "loc": "REV.19.8"
              },
              "items": [
                {
                  "text": "Ufu 19:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye huyo akajibu, akawaambia wale waliosimama mbele yake, akisema, Mvueni nguo hizi zenye uchafu. Kisha akamwambia yeye, Tazama, nimekuondolea uovu wako, nami nitakuvika mavazi ya thamani nyingi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.6"
              },
              "items": [
                {
                  "text": "Kut 29:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikasema, Na wampige kilemba kizuri kichwani pake. Basi, wakampiga kilemba kizuri kichwani pake, wakamvika mavazi; naye malaika wa BWANA akasimama karibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha malaika wa BWANA akamshuhudia Yoshua, akisema, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
