                }
              ]
            }
          ]
        },
        {
          "text": "Sikiliza sasa, Ee Yoshua, kuhani mkuu, wewe na wenzako waketio mbele yako; maana hao ni watu walio ishara; kwa maana, tazama, ninamleta mtumishi wangu, aitwaye Chipukizi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
