        },
        {
          "text": "Kisha akanionyesha Yoshua, kuhani mkuu, amesimama mbele ya malaika wa BWANA, na Shetani amesimama mkono wake wa kuume ili kushindana naye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
