            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.9"
              },
              "items": [
                {
                  "text": "Kum 17:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA wa majeshi asema hivi, Kama ukienda katika njia zangu, na kama ukishika maagizo yangu, ndipo utakapoihukumu nyumba yangu, nawe utazilinda nyua zangu, nami nitakupa nafasi ya kunikaribia kati yao wasimamao karibu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        }
