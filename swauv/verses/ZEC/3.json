          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.64.6"
              },
              "items": [
                {
                  "text": "Isa 64:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi, Yoshua alikuwa amevaa nguo chafu sana, naye alikuwa akisimama mbele ya malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
