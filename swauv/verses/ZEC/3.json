              "items": [
                {
                  "text": "Ufu 5:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maana, litazame jiwe hili nililoliweka mbele ya Yoshua; katika jiwe moja yako macho saba; tazama, nitachora machoro yake, asema BWANA wa majeshi, nami nitauondoa uovu wa nchi ile katika siku moja. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
