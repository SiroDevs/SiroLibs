                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.3"
              },
              "items": [
                {
                  "text": "2 Pet 2:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ambalo wenye kundi hilo huwachinja, kisha hujiona kuwa hawana hatia; na hao wawauzao husema, Na ahimidiwe BWANA, kwa maana mimi ni tajiri; na wachungaji wao wenyewe hawawahurumii. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.5",
            "verseOrgIds": [
              "ZEC.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maana mimi sitawahurumia tena wenyeji wa nchi hii, asema BWANA; bali, tazama, nitawatia, kila mmoja wao, mikononi mwa mwenzake, na mikononi mwa mfalme; nao wataipiga hiyo nchi, wala mimi sitawaokoa mikononi mwao. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.6",
            "verseOrgIds": [
              "ZEC.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.12"
              },
              "items": [
                {
                  "text": "Sef 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.5"
              },
              "items": [
                {
                  "text": "Mt 11:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Basi nikalilisha kundi la machinjo, kweli kondoo waliokuwa wanyonge kabisa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisha nikajipatia fimbo mbili; nami nikaiita ya kwanza, Neema, na ya pili nikaiita, Vifungo; nikalilisha kundi lile. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.7",
            "verseOrgIds": [
              "ZEC.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.7"
              },
              "items": [
                {
                  "text": "Hos 5:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami nikawakatilia mbali wachungaji watatu katika mwezi mmoja; maana nafsi yangu ilikuwa imechoka kwa ajili yao, na nafsi zao pia walinichukia. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.8",
            "verseOrgIds": [
              "ZEC.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer 15:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipo nikasema, Sitawalisheni; afaye na afe; atakayekatiliwa mbali na akatiliwe mbali; nao waliosalia, kila mmoja na ale nyama ya mwili wa mwenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.9",
            "verseOrgIds": [
              "ZEC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaitwaa hiyo fimbo yangu, iitwayo Neema, nikaikata vipande viwili, ili nipate kulivunja agano langu nililolifanya na watu wa kabila zote. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.10",
            "verseOrgIds": [
              "ZEC.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ikavunjwa siku ile; na hivyo wale kondoo wanyonge walionisikiliza wakajua ya kuwa neno hili ndilo neno la BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.11",
            "verseOrgIds": [
              "ZEC.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.32"
              },
              "items": [
                {
                  "text": "Kut 21:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.15"
              },
              "items": [
                {
                  "text": "Mt 26:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nikawaambia, Mkiona vema, nipeni ujira wangu; kama sivyo, msinipe. Basi wakanipimia vipande thelathini vya fedha, kuwa ndio ujira wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.12",
            "verseOrgIds": [
              "ZEC.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.9+MAT.27.10"
              },
              "items": [
                {
                  "text": "Mt 27:9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kisha BWANA akaniambia, Mtupie mfinyanzi kima kizuri, hicho nilichotiwa kima na watu hao. Basi nikavitwaa vile vipande thelathini vya fedha, nikamtupia huyo mfinyanzi ndani ya nyumba ya BWANA. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.13",
            "verseOrgIds": [
              "ZEC.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo nikaikata vipande viwili fimbo yangu ya pili, iitwayo Vifungo, ili nipate kuuvunja udugu uliokuwa kati ya Yuda na Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.11.14",
            "verseOrgIds": [
              "ZEC.11.14"
            ]
          }
        }
      ]
    },
