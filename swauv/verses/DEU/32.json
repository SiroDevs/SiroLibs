            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.5"
              },
              "items": [
                {
                  "text": "Rum 10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kwa maana si jambo lisilofaa kwenu; maana, ni maisha yenu, na kwa jambo hili mtazifanya siku zenu kuwa nyingi juu ya nchi mwivukiayo Yordani kuimiliki.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
