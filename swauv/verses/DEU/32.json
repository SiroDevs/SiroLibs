          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akaja akasema maneno haya yote ya wimbo huu masikioni mwa watu, yeye na Yoshua, mwana wa Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 32:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akamaliza kuwaambia Israeli wote maneno haya yote; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "akawaambia, Yawekeni mioyoni mwenu maneno yote ambayo nashuhudia kwenu hivi leo; nayo waamuruni watoto wenu, wayatunze na kuyafanya maneno yote ya torati hii. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
