                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "BWANA akasema na Musa siku iyo hiyo, akamwambia, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwea katika mlima huu wa Abarimu, mpaka kilima cha Nebo, kilicho katika nchi ya Moabu, kuelekea Yeriko; ukaangalie nchi ya Kanaani niwapayo wana wa Israeli kuimiliki; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukafe katika kilima, huko ukweako, ukusanywe uwe pamoja na jamaa zako; kama alivyokufa nduguyo Haruni katika mlima wa Hori, akakusanywa awe pamoja na watu wake; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.11"
              },
              "items": [
                {
                  "text": "Hes 20:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "kwa sababu mlinikosa ninyi juu yangu katikati ya wana wa Israeli katika maji ya Meriba huko Kadeshi, katika bara ya Sini; kwa kuwa hamkunitakasa katikati ya wana wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwani utaiona hiyo nchi mbele yako, lakini hutakwenda huko kuingia hiyo nchi niwapayo wana wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
