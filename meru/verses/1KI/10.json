          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Kûr 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo abiashara ba Solomoni nî baagûraga mbarathi kuuma Misri na Cilicia",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10.28",
              "type": "text"
            },
            {
              "text": "Misri na Cilicia:",
              "type": "text"
            },
            {
              "text": "Ciaarî ntûûra cia nthîgûrû îrîa îtagwa Turaki ntûkûûne iji. Ntûûra iu ciaarî na îgweta rîa kûrîthia mbarathi inyiingî mono.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ngaarî cia ndwaa kuuma Misri. Rîu nabo bakeenderia anene ba Aiti na ba Sîria o mbarathi fetha îgana rîa mîrongo îtaano (150) na ngaarî ya ndwaa fetha magana jatantatû (600).",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
