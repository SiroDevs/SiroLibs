              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî mûnene Solomoni nî aakûrûkîte anene bangî bonthe ba nthîgûrû mantûûne jegiî ûtonga na ûûme. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû bonthe ba nthîgûrû nî bacwaga ûrîa boomba kwona Solomoni nîkenda baciigîrua ûûme bwaawe bûrîa MWATHANI aamweete. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O muntû wonthe ûrîa weejaga kîrî Solomoni nî aamûreetagîra biewa mwanya mwanya ta into bia fetha na bia thaabu, na nguû cia goro na mathaga ja ndwaa na into bia gwîkîra irio mûchemo, na mbarathi na nyûmbû. Gûtî mwaka jwaakûrûkagîrwa atîreeteri biewa ta biu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
