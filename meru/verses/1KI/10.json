          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Kûr 17.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî îgiiteene rîa waathani bwa Solomoni fetha yaingîîte Jerusalemu ta maiga, nayo mîtarakwa yaingîîte ta mîkûû ya mwitû jwa irîma bia Shefala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
