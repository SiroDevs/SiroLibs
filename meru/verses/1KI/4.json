          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo anene bonthe ba nthî baakinyîrwa nî nkuma ya ûûme bwa Solomoni, nî baatûmaga nchaama ciaao ciîta kûmûthikîîra.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.4.34",
