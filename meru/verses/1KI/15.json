            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûûragwa kûu kwa nchiarwa cia Jeroboamu kwaumanîrie na mûthûûro jûrîa MWATHANI Mûrungu wa Israeli aathûûrîre nîûntû bwa meeyia jarîa mûnene Jeroboamu aathithîrie na jarîa aatûmîre Aisraeli bathithia.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
