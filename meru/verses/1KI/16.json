            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI aatumîîre kîroria Jehu, mûtaana wa Hanani, kwaria rûteto rûu rwegiî Baasha na antû baao. Nawe aarîrie ru nîûntû bwa meeyia jarîa Baasha eeîîrie MWATHANI. We nî aathûûrîrie MWATHANI nîûntû bwa kwîyia o ta ûrîa mûnene Jeroboamu eeîîrie na nîûntû bwa kûthiria antû ba mûciî jwa Jeroboamu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
