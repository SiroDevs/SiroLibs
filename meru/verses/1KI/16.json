            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu MWATHANI nî aarîîrie kîroria Jehu, mûtaana wa Hanani ûntû bwegiî Baasha arauga atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gwe Baasha, nî wiijî atî waarî gîntû gûtîkîo, îndî nî ndaakweetherie mûtongeeria wa antû baakwa Israeli. Amwe na bûu, nî ûthingatîte mîtîre îmîthûûku ya Jeroboamu na watûma antû baakwa, Aisraeli beeyia. Ûntû bûbû nî bûnthûûrîtie mono. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, ngaakûthiria amwe na antû beenu, o ta ûrîa ndaathirîrie Jeroboamu mûtaana wa Nebati. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî antû beenu barîa bagakuîra ntûûreene bakaarîîwa nî kurû na barîa bagakuîra bûûrîîne bakarîîwa nî nyoni cia îgûrû.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        }
      ]
    },
    {
