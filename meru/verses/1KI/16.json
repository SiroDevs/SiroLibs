          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mathithio jangî jonthe ja Baasha na mantû ja ûchamba bwaawe jaandîki ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baasha nî aakuîre na arathikwa ntûûreene ya Tiriza. Rîu mûtaana waawe Ela araa mûnene",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        }
      ]
