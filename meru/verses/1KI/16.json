        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mathithio jangî jonthe ja Zimuri na rûgono runthe rwa ûrîa aajûkîrie ûnene na njîra îtîagîrîte nî jaandîki ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
