        "style": "s1"
      },
      "items": [
        {
          "text": "Ngigî ta rwano rwa kûmenyithia antû atî Ntukû ya MWATHANI îrî akuî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû kwîrwa bairire",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu gûtûma nthîgûrû yoona irio kaîrî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntukû ya MWATHANI",
          "type": "text"
        }
      ]
