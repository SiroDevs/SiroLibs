              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrî buî, ûroria bûbû bunthe bwa kîoneki nî bûbwithe ta maandîko jarî yukuune rîrîtumanie. Rîkanenkerwa muntû wiijî kûthoma akeerwa, “Thooma maandîko jaja,” augaga, “Ntîûmba kûjathoma nîûntû yuku nî rîrîtumanie.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî rîkanenkerwa muntû ûtiijî kûthoma akeerwa, “Thooma maandîko jaja,” augaga, “Ntiijî kûthoma.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wîrîgîîro bwa nyumeene",
          "type": "text"
        }
      ]
    },
