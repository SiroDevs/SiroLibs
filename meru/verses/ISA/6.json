              },
              "items": [
                {
                  "text": "2Ma 26.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwakeene jûrîa mûnene Uzia aakuîre, nî ndoonere MWATHANI. Nawe aakarîrîte rûriga rwa ûnene athûûngûûri îgûrû mono, naru rwambambio rwaawe rwoojûri kîûrûûne kîonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aserafi nabo nî baarûngi îgûrû rîaawe. O Mûserafi aarî na mathagu jatantatû; jaîrî aaikunîkîrîte najo ûthiû, na jaîrî aikunîkîrîte najo magûrû, na jaîrî jangî nîjo aabuurûkaga najo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Kûg 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo nî baaranagîria na kajû bakiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
