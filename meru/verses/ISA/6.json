              "type": "text"
            }
          ]
        },
        {
          "text": " Najo majû jaao nî jaatûmaga itugî bia mwari bikainaina, nakîo kîûrû gîkoojûra toogi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
            ]
