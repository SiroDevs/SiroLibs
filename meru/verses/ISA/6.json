        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrîo ûmwe wa Aserafi bau aabuurûkîre araambîjîîra arî na îkara rîa mwanki rîrîa aarî akûrita kuuma kîritîroone kîa igongwana na mîgwati ya chuuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araringithia mîromo yaakwa narîo, arambîîra ûjû, “Atîrî, nîûntû îkara rîrî rîkûringithia mîromo yaaku-rî, nandî îgi rîaaku rîkwangûrwa na warekerwa meeyia jaaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ndîraigua MWATHANI akîûria atîrî, “Nûû ngûtûma? Nûû ûgeeta antûûne eetû?” Naani ndîrauga, “Ndî aja! Ntûma.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
