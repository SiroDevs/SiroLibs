          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.5"
              },
              "items": [
                {
                  "text": "2Ane 16.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2Ma 28.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îgiita rîa Ahazi mûtaana wa Jothamu, Jothamu mûtaana wa Uzia, aathanaga Juda, Rezini mûnene wa Aramu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.1",
              "type": "text"
            },
            {
              "text": "Aramu:",
              "type": "text"
            },
            {
              "text": "nîyo Sîria.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na Peka mûnene wa Israeli mûtaana wa Remalia, nî beetîre kwithûkîra Jerusalemu îndî bataamîûmbîre.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa nteto iu ciaakinyîîre antû ba nja ya Daudi baraigua atî “Njûûrî ya Sîria nî îgwatanîrîte na njûûrî ya Efuraimu,” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.2",
              "type": "text"
            },
            {
              "text": "Efuraimu:",
              "type": "text"
            },
            {
              "text": "nîyo Israeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mûnene Ahazi amwe na antû baawe nî baamakîre mono barainaina ta ûrîa mîtî iinainagua nî ruuo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Isaya atîrî, “Umagara na mûtaana waaku Sheari-jashubu bûgatirimane na Ahazi mûthia jwa mûberethi jûrîa jwînîkaga rûûjî kuuma karieene karîa karî bwa rûgûrû, akuî na njîra îmbariî îrîa îîtaga kîeniine kîa Mûûri wa Nguû. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabuî bûmwîre atîrî, ‘Kara wimenyeerete, na ûborerete, na ûkáigua ûguaa. Menya ûkûa nkoro nîûntû bwa mûthûûro jûmûnene jwa Rezini na antû baawe ba Sîria na jwa Peka mûtaana wa Remalia barîa bakari ta inyinga biîrî bigûtoga birî akuî kûthira.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba Sîria na ba Efuraimu na Peka mûtaana wa Remalia nî batuireberete bauga atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Twîteni twithûkîre nthîgûrû ya Juda, tûmîûûre na twigwatîre yo, na twîke mûtaana wa Tabeeli ku arî mûnene.’”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî MWATHANI Mûrungu augîîte ûjû,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MWATHANI kûnenkanîra Imanueli ta rwano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aarîîrie Ahazi o kaîrî aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Romba MWATHANI, Mûrungu waaku rwano rwa ûntû bûrîa bûgaakarîka, kinya bweethîrwa bûrî nthîgûrû gwa akuû, kana bûrî îgûrû buru.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Ahazi arauga atîrî, “Ntîmûromba; ntîgeria MWATHANI.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Isaya arauga atîrî, “Thikîîreeni nandî gwe nchiarwa ya Daudi. Ka-ûtîng'anîtie kûnogia antû tontû bûkwenda kûnogia Mûrungu waakwa kinya we? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mat 1.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, MWATHANI wengwa agakwaa rwano: mwarî karaiti akaagia îu, aciare kaîjî, na amwîte Imanueli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7.14",
              "type": "text"
            },
            {
              "text": "Imanueli:",
              "type": "text"
            },
            {
              "text": "nî kuuga “Mûrungu arî amwe naatuî.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana ûu akaanyunyaga îria rîrîmatu na arîîjage nainchû mwanka rîrîa akamenya kwathûrana wega na ûthûûku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.15",
            "verseOrgIds": [
              "ISA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa kinya mbere ya mwana ûu amenya kwathûrana ûthûûku na wega-rî, nthîgûrû cia anene bau baîrî babwîkîrîte ûguaa itîîthîrwa irî na muntû noo ûmwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MWATHANI akaabûreetera buî amwe na antû beenu, na antû bangî ba rûrîîjo rweenu matukû ja thîîna înene nkûrûki ya îrîa yonthe bwoona kuuma rîrîa Efuraimu yaathûkanîre na Juda. Akaabûreetera mûnene wa Asîria abwithûkîre.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu rîakinya, MWATHANI akaaringa kîthiori, nabo antû ba Misri bakeeja ta ngi kuuma tûrûûjîîne twa Misri, tûrîa tûrî kûraaja. Ningî akaringîra antû ba Asîria kîthiori, nabo beeje ta njûkî kuuma nthîgûrû yaao. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bakeeja bonthe boojûre mîguuruune îrîa yorokeri mono, na makurunguune ja maiga, na ithakeene bionthe na bienine bionthe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu rîakinya, MWATHANI agaatumîra mûnene wa Asîria kuuma rwongo rwa Eufurate ta ûrîa mwenji atumagîra wembe, nawe akeenja Juda mûtuundu jwa mûtwe, na nchiûri cia mwîrî na akûrûre kinya nchiûri cia kîreru.",
          "type": "text",
