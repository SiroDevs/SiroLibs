      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû ba Israeli bagaacoka nthîgûrû yaao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI akaaigîîrua nchiarwa cia Jakubu kîaao. Akaathuura antû ba Israeli kaîrî na abeeke nthîgûrû yaao yongwa. Nabo antû batî ba Israeli bakaairinganîra nabo batuîke ba mwîrîga jwa Jakubu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.1",
            "verseOrgIds": [
              "ISA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba mîgongo îngî bakaaringîîria Aisraeli babaanie nthîgûrû yaao îrîa baaerwe nî MWATHANI. Îndî antû ba Israeli bakaabaeethia nkombo ciaao cia arûme na cia aka. Bagaataa barîa batwîre kûbataa na baathe barîa batwîre kûbaatha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.14.2",
            "verseOrgIds": [
              "ISA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babiloni îkaathirua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
