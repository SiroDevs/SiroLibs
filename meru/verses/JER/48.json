                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI Mweneinya, Mûrungu wa Israeli nî aarîrie nteto iji ciegiî nthîgûrû ya Moabu:",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
