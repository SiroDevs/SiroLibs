      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu gwîta na mbere kûgitîra nthîgûrû ya Babiloni îgamba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rwîmbo rwa gûkumia Mûrungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nchûgûma ya MWATHANI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûrungu gwîta na mbere gûkanûkia nthîgûrû ya Babiloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
