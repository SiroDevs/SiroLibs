          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI ariuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.54",
            "verseOrgIds": [
              "JER.51.54"
            ]
          }
        }
