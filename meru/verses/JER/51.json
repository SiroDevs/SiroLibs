            "number": "24",
            "style": "v",
            "sid": "JER 51:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI ariuga atîrî, “Ngaakanûkia Babiloni na antû bonthe barîa batwîre ku, bûtegeete na meetho jeenu nîûntû bwa ûthûûku bunthe bûrîa baathithîîrie Zaiûni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.24",
            "verseOrgIds": [
              "JER.51.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MWATHANI agateethia Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa Babiloni îgakara nyumeene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
