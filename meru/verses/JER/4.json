          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.10",
            "verseOrgIds": [
              "JER.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî îgiita nî rîîjîte, rîrîa antû baba ba Jerusalemu bakeerwa, “Kûrî ruuo rwa mwanki ruumîte irîmeene birîa bitî mîtî bia rwanda, rwîjîte kîrî antû baakwa. Naru rûtîîjîte nîkenda rûtumîrwa kwera into îtîîrine kana nîkenda rûbitheria, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.11",
            "verseOrgIds": [
              "JER.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "îndî ndwîrîte rwîje rûneenei mono. Nandî nî ni nkuuga bagaakanûkua.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.12",
            "verseOrgIds": [
              "JER.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremia kûrîrîra antû baao",
          "type": "text"
        }
      ]
    }
