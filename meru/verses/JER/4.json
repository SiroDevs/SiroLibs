              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI ariuga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.1",
            "verseOrgIds": [
              "JER.4.1"
            ]
