          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia araromba arauga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
