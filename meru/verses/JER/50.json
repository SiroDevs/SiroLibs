            "style": "v",
            "sid": "JER 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.20",
            "verseOrgIds": [
              "JER.50.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre anthû ba Babiloni atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.21",
            "verseOrgIds": [
              "JER.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 50:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.27",
            "verseOrgIds": [
              "JER.50.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 50:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bamatûkîte kuuma Babiloni beetîte Jerusalemu nî bakuuga ûrîa MWATHANI Mûrungu weetû akwirîîria kîrî antû ba Babiloni nîûntû Ababiloni nî beenyangîrie kîûrû kîaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.28",
            "verseOrgIds": [
              "JER.50.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 50:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.6"
              },
              "items": [
                {
                  "text": "Kûg 18.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Îteeni antû bonthe barîa barathaga na mîgwî beete bakaithûkîre Babiloni. Nî beete bamîcîgîîrie na menya barekeeria muntû noo ûmwe amatûka. Kanûkia Babiloni kûringana na mathithio jaayo jarîa jonthe îthithîtie. Nthîgûrû ya Babiloni nî îregeete kûmbathîkîra nîûntû bwa rwikumio rwaayo. Yaarega kûmbathîkîra ni MWATHANI, Ûrîa Mûtheru wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.29",
            "verseOrgIds": [
              "JER.50.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 50:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, nthaka ciaayo ikooragîrwa njîreene cia ntûûra na njûûrî ciaayo cionthe ithirue ntukû îîu. Ûu nîu ûûni MWATHANI nkuuga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.30",
            "verseOrgIds": [
              "JER.50.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 50:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.32",
            "verseOrgIds": [
              "JER.50.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 50:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûûni MWATHANI Mweneinya ndiuga atîrî: Antû ba Israeli na ba Juda nî bainyîîrîîtue. Barîa babataîte babagwete babarikia na batîkwenda kûbarekeeria beeta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.33",
            "verseOrgIds": [
              "JER.50.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 50:34"
          },
