                  "text": "47.1-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî aarîîrie kîroria Jeremia mantû jegiî ntûûra ya Babiloni na nthîgûrû yaao, aramwîra atîrî,",
          "type": "text",
          "attrs": {
