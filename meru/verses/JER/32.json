                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " MWATHANI nî aarîîrie Jeremia mwakeene jwa îkûmi jwa waathani bwa Zedekia mûnene wa Juda, naju jwaarî mwakeene jwa îkûmi na înaana jwa waathani bwa Nebukadineza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.1",
            "verseOrgIds": [
              "JER.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu njûûrî ya mûnene wa Babiloni nî yaacîgîîrîîtie Jerusalemu. Kîroria Jeremia nî aaîngîri kîaragoone gîa akaria kîrîa kîaarî gîkaroone kîa mûnene wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.2",
            "verseOrgIds": [
              "JER.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa Zedekia mûnene wa Juda nî aarî akûmwingîrithia akiugaga, “Nîkî ûntû ûkûroria ûkauga, ‘MWATHANI ariuga ûjû: Atîrî, nkaarekeeria ntûûra îîjî îtawe nî njûûrî cia mûnene wa Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.3",
            "verseOrgIds": [
              "JER.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekia mûnene wa Juda ationoka kuuma kîrî Ababiloni îndî no mwanka anenkanîrwe kîrî mûnene wa Babiloni, baaranîrie bategeene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.4",
            "verseOrgIds": [
              "JER.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza agaikia Zedekia Babiloni. Kûu nîku agakara mwanka nthithie nawe ûrîa nkwenda. Ningî gwe Zedekia kinya warwaa na Ababiloni ûtîboomba.’ Ûu nîu ûûni MWATHANI nkuuga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.5",
            "verseOrgIds": [
              "JER.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nawe ariuga ûjû, “MWATHANI nî ambarîrîtie ambîîra ûjû: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.6",
            "verseOrgIds": [
              "JER.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atîrî, Hanameli mûtaana wa Shalumu akeeja kîrî gwe nîûntû nî muntû wa ndûgû cieenu akwîre atîrî, ‘Gûra muunda jwaakwa jûrîa jûrî ntûûreene ya Anathothi nthîgûrû ya Benjamini nîûntû nîgwe ûbuîrîte kûjûkûûra. Jûgûre jwee jwaaku.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.7",
            "verseOrgIds": [
              "JER.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu o ta ûrîa MWATHANI aambîrîte, Hanameli muntû wa ndûgû cieetû areeja kîrî ni au kîaragoone gîa akaria, arambîîra atîrî, ‘Gûra muunda jwaakwa jûrîa jûrî ntûûreene ya Anathothi nthîgûrûûne ya Benjamini, nîûntû nîgwe ûbuîrîte kûjûkûûra. Jûkûûre jwee jwaaku.’ Rîu ndîramenya nî MWATHANI ûmbarîrîtie.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.8",
            "verseOrgIds": [
              "JER.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani nî ndaagûrîre muunda jûu jwaarî ntûûreene ya Anathothi kuuma kîrî muntû wa ndûgû cieetû Hanameli. Ndîramûthimîra fetha îkûmi na mûgwanja cia kûmûrîaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.9",
            "verseOrgIds": [
              "JER.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî ndeetîre akûûjî barakûûjîîra tûkîandîkanîra na tûgîîkanîîra caini. Naani ndîramûthimîra mbeecha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.10",
            "verseOrgIds": [
              "JER.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîracoka ndîrajûkia karatasi kau twekanîîrîte caini cia ûgûri, kau koonanagia ûrîa twetîkanîîrîtie, na ndîrajûkia karatasi kangî karîa gateekîri caini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.11",
            "verseOrgIds": [
              "JER.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani ndîranenkanîra karatasi kau kaandîki mantû ja ûgûri kîrî Baruku mûtaana wa Neria. Neria aarî mûtaana wa Mahaseia. Ndaamûnenkeere karatasi kau muntû ûu wa ndûgû cieetû Hanameli akîonaga. Akûûjî nî baarî o tûkîgûranîra. Ningî kinya Ayahudi bonthe barîa baakari nthî kîaragoone gîa akaria nî baakûûjîrîre nteto iu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.12",
            "verseOrgIds": [
              "JER.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîreera Baruku bathikîîrîte atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.13",
            "verseOrgIds": [
              "JER.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MWATHANI Mweneinya Mûrungu wa Israeli ariuga ûjû: Jûkia tûratasi tûtû twaandîki mantû ja ûgûri; karatasi karîa karî na caini na karîa gatî na caini, ûtwîkîre nyongûûne ya yûmba nîkenda tûtûûra ku îgiita rîrîraaja. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû MWATHANI Mweneinya Mûrungu wa Israeli ariuga atîrî: Nyomba, na miuunda, na miuunda ya mîzabibû îkaagûragwa o kaîrî nthîgûrûûne îîjî.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îromba rîa Jeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyuma ya kûnenkera Baruku mûtaana wa Neria turatasi tûu twaandîki mantû ja ûgûri, nî ndaarombere MWATHANI ndîrauga atîrî: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îî MWATHANI Mûrungu gwe, nîgwe woombîre îgûrû na nthîgûrû na inya yaaku înene. Gwe gûtî ûntû bûkûrema. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.17",
            "verseOrgIds": [
              "JER.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe nî woonagia antû babaingî mono wendo na kîaao gîaaku kîrîa gîtîthiraga. Îndî gwe nî ûthingatagia aana îkanûkia rîa beethe. Gwe ûrî ûmûnene na riîtwa rîaakû nî MWATHANI Mûrungu Mweneinya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.18",
            "verseOrgIds": [
              "JER.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe ûrî kîrîra gîkiingî na mathithio jaaku nî jamanene. Gwe nî woonaga mîîtîre ya antû yonthe, na ûkarîaa o muntû kûringana na mîîtîre yaawe na kûringana na mathithio jaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.19",
            "verseOrgIds": [
              "JER.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe nî waaringîre biama na wathithia mantû ja kûrigaria nthîgûrûûne ya Misri, na nîu wîtîte na mbere kûthithia nthîgûrûûne ya Israeli, na kinya mîgongoone îngî ya nthî yonthe mwanka naarua tûrî. Naagwe nî ûcionereete îgweta ta ûrîa gûkari nandî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.20",
            "verseOrgIds": [
              "JER.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe nî waaritîre antû baaku ba Israeli nthîgûrûûne ya Misri ûringîte biama na kûthithia mantû ja kûrîgarania ja inya, na kûmakania gûkûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.21",
            "verseOrgIds": [
              "JER.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî wabaeere nthîgûrû îîjî, îrîa waaciîtîîrie biûjûjû biaao ûrabeera ûkabaa, nthîgûrû îrîa nthongi na îrî mûthetu jûmûnoru na ûtonga bûbwingî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.22",
            "verseOrgIds": [
              "JER.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nî baatonyere ku baraigwatîra yo. Îndî bo bataakwathîkîîre kana beeta na mîîtîre îrîa îringeene na Waatho bwaaku. Gûtî ûntû noo bûmwe baathithîrie bwa jarîa waabeerîte bathithie. Tontû bûû, nîkîo gîtûmîte ûbareetera ûthûûku bûbû bunthe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.23",
            "verseOrgIds": [
              "JER.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.23",
            "verseOrgIds": [
              "JER.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atîrî, anthû bakûrûngîka nthingo cia gûcîgîîria ntûûra nîkenda bamiithûkîra na bamîtaa. Tontû bwa ndwaa, na mpara, na mîrimo, ntûûra nî înenkanîri kîrî Ababiloni barîa bamiithûkîrîte. Mantû jarîa gwe waarîrie nî jarîkîtie kûûjûra ta ûrîa ûkwona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.24",
            "verseOrgIds": [
              "JER.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwe na ûu, gwe MWATHANI Mûrungu nî ûmbîrîte atîrî, ‘Gûra muunda na mbeecha na wîthîrwe ûrî na akûûjî, kinya këethîra ntûûra nî înenkanîri kîrî Ababiloni.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aarîîrie Jeremia aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.26",
            "verseOrgIds": [
              "JER.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atîrî, ni nî ni MWATHANI Mûrungu wa antû bonthe. Ga-kûrî ûntû bûbûûmo mono kîrî ni bûrîa ntîûmba kûthithia? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.1+2KI.25.2+2KI.25.3+2KI.25.4+2KI.25.5+2KI.25.6+2KI.25.7+2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11"
              },
              "items": [
                {
                  "text": "2Ane 25.1-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2Ma 36.17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, MWATHANI ariuga ûjû: Ûûni rî, nkanenkanîra ntûûra îîjî kîrî Ababiloni na kîrî Nebukadineza mûnene wa Babiloni, nabo bakamîtaa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababiloni barîa bakûrwaa na ntûûra îîjî bakeeja bamîîthie buru amwe na nyomba irîa cionthe ciathithîrua mantû ja kûnthûûria. Nyomba irîa cionthe îgûrûgûrû rîaacio rîaîthagîrua ubaani nîûntû bwa Baali, na irîa ciaritagîrwa igongwana bia gwîtûûrîria nîûntû bwa mîrungu îngî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû antû ba Israeli na ba Juda kuuma o kîambîrîria batûûraga kûthithia ûthûûku akî meethoone jaakwa. Antû ba Israeli gûtî ûntû bûngî bathithagia tiga gûcwaa ûrîa nkathûûra nîûntû bwa mathithio jaao. Ûu nîu MWATHANI nkuuga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntûûra îîjî îtûûraga îkîmbîkagîra marûrû nkathûûra mono, kuuma ntukû îrîa yaakîrwe mwanka naarua îîjî. Tontû bûû, nkaamînyangia ntige kûmîona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaamîthîria nîûntû bwa ûthûûku bunthe bûrîa antû ba Israeli na ba Juda baathithîrie baumbuthûra mûthûûro jwaakwa. Nabo anene baao, na atongeeria baao, na athînjîri-Mûrungu baao, na iroria biaao, barîa batwîre Jerusalemu na Juda bathithîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bo nî kûmbutatîra bambutatîrîte antû a bamberekera, na kinya këethîra nî mbaritanaga magiita jonthe bataanthikîîra bagwata ûritani bwaakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
