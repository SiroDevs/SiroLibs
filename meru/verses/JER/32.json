                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.30-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bo beekîre mîrungu yaao ya mîng'uanano îrîa nthwîre kîûrûûne gîaakwa kîrîa kîgwetanagîrua na riîtwa rîaakwa, baragîîkîra mûgiro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Ala 18.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2Ane 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.31"
              },
              "items": [
                {
                  "text": "Jer 7.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Baakîte gûntû kûrîa mîrungu ya mîng'uanano yaathaathagîrua kûrîa kîguuruune kîa mûtaana wa Hinomu, nîkenda baritaga aana baao barî igongwana kîrî mûrungu jwa mûng'uanano jwa Moleki. Tî ûûni ndaabeerîte bathithie ûu, ningî kinya ntaathûgaanîria ûntû ta bûu ntûma bathithia ûthûûku ta bûu, na ntûma antû ba Juda beeyia.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wîrane bûrîa bûrî na wîrîgîîro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, MWATHANI Mûrungu wa Israeli nî aambîrîre atîrî, “Antû bariuga atî ndwaa, na mpara, na mîrimo nî bio bigaatûma ntûûra îîjî îtawa nî mûnene wa Babiloni. Îndî nandî thikîîra ûrîa nkuuga: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atîrî, nkoothûrania antû kuuma nthîgûrûûne irîa cionthe ndaabeengîrîîrie nîûntû bwa mûthûûro jûmûnene jûrîa jwangwete. Nkaabareeta gûntû gûkû ntûme batûûre kiindajî. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baa antû baakwa naani mpee Mûrungu waao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani ngatûma bagia na yerekeeria rîmwe, ûtûûroone bwaao nîkenda baambathîkagîra mwanka kenya, na nîkenda bo bakoona wega, o amwe na nchiarwa ciaao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngeeka kîrîkanîro gîa kenya nabo, atî ntîkorogarûka ntiga kûbathithîria wega. Ningî ngatûma bankîra na nkoro ciaao na batîkorombîrûkîra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaagwîragua nî kûbathithîria wega na nî mma ngaacieejana buru mbone bakwirikîria nthîgûrûûne îîjî.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MWATHANI ariuga atîrî, O ta ûrîa ndeeteereete antû baba ûthûûku bûbû bunthe, no u nkabareetera wega bunthe bûrîa mbeerîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miuunda îkaagûragwa nthîgûrûûne îîjî bûkuuga atî, nî îgaanjo rîtîtûûri nî muntû kana nyomoo, na nî înenkanîri kîrî Ababiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miuunda îkaagûragwa na mbeecha, na moogûri jageetîkanagîîrua na antû bageekanîîra caini barî na akûûjî. Ûu nîu gûgakaraga gûkû nthîgûrûûne ya Benjamini, na Jerusalemu, na ntûûreene cia Juda, na cia nthîgûrû ya irîma, na cia bûûrî na cia bwa ûmotho bwa Juda. Nîkwîthîrwa nkabacokeria mawega jaao. Ûu nîu ni MWATHANI nkuuga.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
  ],
