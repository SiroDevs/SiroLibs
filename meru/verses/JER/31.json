        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
              "JER.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îgiita rîu, antû bakaamamaga na bagookîîra banogoki.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        }
