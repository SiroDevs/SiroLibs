          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI Mweneinya, Mûrungu wa Israeli ariuga ûjû, “Rîrîa ngacokeria antû ba Juda na ntûûra ciaao mawega jaao, bagaacoka kwaragia o kaîrî bakiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
