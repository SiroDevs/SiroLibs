                "loc": "JOS.18.1"
              },
              "items": [
                {
                  "text": "Josh 18.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.60"
              },
              "items": [
                {
                  "text": "Zab 78.60",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.12+JER.7.13+JER.7.14"
              },
              "items": [
                {
                  "text": "Jer 7.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " rîu ngatûma kîûrû gîkî gîkare ta ûrîa Shilo yaakarîre. Narîo riîtwa rîa ntûûra îîjî rîgatua gûtumagîrwa ta kîrumi nî mîgongo yonthe ya nthîgûrû.’”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo athînjîri-Mûrungu, na iroria, na antû bonthe nî baigîrue Jeremia akîaria nteto arî kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia athiria kwaria nteto cionthe irîa MWATHANI aamwîrîte eere antû bonthe, nîrîo athînjîri-Mûrungu, na iroria, na antû bonthe baamûgwatîre baramwîra atîrî, “No mwanka ûûragwe nîûntû bwa mantû jau! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkî tontû waroria riîtweene rîa MWATHANI wauga, ‘kîûrû gîkî gîgakara ta ûrîa Shilo yaakarîre, na ningî wauga ntûûra îîjî îkaathirua buru îtigwe îtî na muntû wagûtûûra ku?’” Nabo antû bonthe baroothûrana baracîgîîria Jeremia kûu kîûrûûne.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa atongeeria ba Juda baigîrue mantû jau, nî baaumîre gîkaro kîa mûnene bareeta kîûrûûne, barakara nthî kîameene akuî na Mpingîro Înjerû ya kîûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu athînjîri-Mûrungu, na iroria baraarîria atongeeria bau na antû bonthe barabeera atîrî, “Muntû ûûjû abuîrîte gûtuîrwa kûûragwa nîûntû akûroria mantû jamathûûku jegiî ntûûra îîjî o ta ûrîa bwarîîkia kwigua bwingwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremia nî aarîîrie atongeeria bonthe na antû bonthe arabeera atîrî, “Nî MWATHANI ûntûmîte kûroria mantû jegiî kîûrû gîkî na ntûûra îîjî nteto iu cionthe bwaigua. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, rî, garûreeni mîîtîre yeenu na mathithio jeenu, na bwathîkîre MWATHANI Mûrungu. Nawe agaatigana na ûthûûku bûrîa augîîte akaabûthithîria. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî ni nandî ndî njareene cieenu. Nthithîrieni ûrîa bûkwenda ûrîa bûkwona kwagîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyeni na mma atî, bwambûraga bûkaireteera mûgiro jwa kûûraga muntû ûtîîtie; buî na ntûûra îîjî, na antû barîa batwîre ku. Nîkwîthîrwa nî mma, nî MWATHANI ûntûmîte nîkenda mbwîra nteto iu cionthe bwaigua.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
