            "verseId": "JER.26.23",
            "verseOrgIds": [
              "JER.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nîûntû Ahikamu mûtaana wa Shafani nî aagwataga Jeremia mbaru, Jeremia ataanenkanîîrwe kîrî antû ooragwa.",
          "type": "text",
          "attrs": {
