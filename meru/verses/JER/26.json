              "JER.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu atongeeria, na antû bonthe nî beerîre athînjîri-Mûrungu, na iroria atîrî, “Muntû ûûjû atîbuîrîte gûtuîrwa kûûragwa, nîûntû we agûtwarîria riîtweene rîa MWATHANI Mûrungu weetû.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.16",
            "verseOrgIds": [
              "JER.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo akûrû bamwe ba nthîgûrû îîu barookîîra baraarîria kîrîndî kîonthe kîrîa kîothûreene. Nabo bareera kîrîndî atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.17",
            "verseOrgIds": [
              "JER.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.12"
              },
              "items": [
                {
                  "text": "Mik 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mika mûtaana wa Moreshethi nî aarorerie matukûûne ja Hezekia mûnene wa Juda. Eerîre antû ba Juda atîrî, MWATHANI Mweneinya ariuga ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.18",
            "verseOrgIds": [
              "JER.26.18"
            ]
          }
        }
      ]
