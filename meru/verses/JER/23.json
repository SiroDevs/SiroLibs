              "type": "text"
            }
          ]
        },
        {
          "text": "Naagwe ûûragie iroria atîrî, ‘MWATHANI abuîrîte atîa? Kana nî macokio jarîkû abweete?’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.37",
            "verseOrgIds": [
              "JER.23.37"
            ]
          }
        },
