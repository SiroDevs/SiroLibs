              },
              "items": [
                {
                  "text": "34.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bûkárîa nyomoo îkuîte na bwaayo. Îndî nyama cia nyomoo ta iu ciomba kûrîîwa nî antû ageni barîa bûrî nabo ntûûreene cieenu. Kana bûkabeenderia nyama iu nîûntû buî bûrî antû babatheru kîrî MWATHANI Mûrungu weenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bûkáruga kang'ondu kana kabûri na îria rîa ng'ina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waatho bwegiî gîchunchî kîmwe kuuma kîrî îkûmi",
          "type": "text"
        }
      ]
    },
    {
