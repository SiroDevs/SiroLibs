            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.43",
            "verseOrgIds": [
              "DEU.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jaja nîjo Maathana jarîa Musa aanenkeere Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.44",
            "verseOrgIds": [
              "DEU.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo nî Mawaatho na nkuagaya na mantû ja wîthîre jarîa Musa eerîre antû ba Israeli rîrîa baaumîre Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.45",
            "verseOrgIds": [
              "DEU.4.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabeerîre jo barî rwongo rwa Jorodani kûu kîguuruune kîrîa kîaarî akuî na Bethipeori. Nthîgûrû îîu nîyo mûnene Sihoni wa Aamoni aathaga arî ntûûreene ya Heshiboni. Nîwe Musa na njûûrî ya asikarî ba Israeli boombîre ndweene rîrîa baaumîte Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.46",
            "verseOrgIds": [
              "DEU.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî baabaithûkîîre na baraigwatîra nthîgûrû yaawe na kinya nthîgûrû ya Ogi mûnene wa Bashani. Anene bau bo baîrî ba Aamori baatûûraga rwongo rwa bwa gaiti ka mûuro jwa Jorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.47",
            "verseOrgIds": [
              "DEU.4.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthîgûrû îîu yaaumîte ntûûreene ya Aroeri mwanka rwareene rwa mûgwanthî jwa mûuro jwa Arinoni, gwîta mwanka kîrîmeene kîa Sirioni na nîkîo gîtagwa Herimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.48",
            "verseOrgIds": [
              "DEU.4.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthîgûrû îîu îgwateene na mûgwanthî jwa Araba jûrîa jûrî kîguuruune kîa mûuro jwa Jorodani bwa gaiti mwanka îrieene rîa Chumbî kûu mûgwanthîîne jwa kîrîma gîa Pisiga.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.49",
            "verseOrgIds": [
              "DEU.4.49"
            ]
          }
        }
      ]
    }
