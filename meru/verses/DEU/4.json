          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Josh 20.8-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ningî Musa nî aathuurîre ntûûra ithatû irîa ciaarî gaiti ka mûuro jwa Jorodani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.41",
            "verseOrgIds": [
              "DEU.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "kûrîa muntû o ûrîkû ûûraganîte abuîrîte kûmatûkaga gwiciitha, bunka ëethîrwe oragîte muntû ûngî atîkwenda, kana ëethîrwa araarî na ûthû nawe. Muntû ta ûu akamatûkaga ntûûreene îmwe ya iu ithatû nîkenda acionokia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.4.42",
            "verseOrgIds": [
              "DEU.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
