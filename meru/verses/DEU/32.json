          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa akûthiria kûeejana nteto iu kîrî antû ba Israeli bonthe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "arabeera atîrî, “Menyagîîreeni, bwathîkagîîre Maathana jonthe jarîa ndabûritana naarua. Bûritanage nchiarwa cieenu jo nîkenda kinya cio ijaathîkagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mooritani jaja tî ja ûtheri, îndî nî ûtûûro kîrî buî. Jo jagatûma bûtûûre ûtûûro bûbûraaja nthîgûrûûne îrîa bûkaigwaatîra bwauna Jorodani.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
