              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na Joshua, mûtaana wa Nuni, nî beetîre barainîra antû rwîmbo rûu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa kwaa antû nkuagaya ciaawe cia mûthia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
