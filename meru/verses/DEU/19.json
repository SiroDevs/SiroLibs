                {
                  "text": "Kûr 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Bûgákûûrakûûra mîanka ya mûtûûri waaku îrîa yekîrwe o mbere kûu nthîgûrûûne îrîa bûkaigwaatîra yee kiigai kuuma kîrî MWATHANI Mûrungu weenu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mantû jegiî akûûjî",
          "type": "text"
        }
      ]
    },
