        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.11"
              },
              "items": [
                {
                  "text": "Kum 33.11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kuuma îgiita rîu gûtooneka kîroria kîngî ta Musa kûu Israeli. MWATHANI aaragia nawe ûthiû kwa ûthiû. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûtî kîroria kîngî ta Musa kîomba kûringa biama na kûthithia magegania ta jarîa MWATHANI aatûmîte Musa eeta kûthithîria Farao, wa nthîgûrû ya Misri, amwe na nthûûmba ciaawe cionthe na nthîgûrû yaawe yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî gûtî kîroria kîngî ta Musa kîomba kûthithia mantû ja inya na ja kûmakania ta jarîa Musa aathithîîrie antû ba Israeli bonthe bakîonaga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
