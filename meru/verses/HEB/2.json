              "type": "text"
            }
          ]
        },
        {
          "text": "Kaîrî akauga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.13",
            "verseOrgIds": [
              "HEB.2.13"
            ]
          }
        }
