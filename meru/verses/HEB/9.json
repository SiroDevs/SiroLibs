                "loc": "EXO.26.1+EXO.26.2+EXO.26.3+EXO.26.4+EXO.26.5+EXO.26.6+EXO.26.7+EXO.26.8+EXO.26.9+EXO.26.10+EXO.26.11+EXO.26.12+EXO.26.13+EXO.26.14+EXO.26.15+EXO.26.16+EXO.26.17+EXO.26.18+EXO.26.19+EXO.26.20+EXO.26.21+EXO.26.22+EXO.26.23+EXO.26.24+EXO.26.25+EXO.26.26+EXO.26.27+EXO.26.28+EXO.26.29+EXO.26.30"
