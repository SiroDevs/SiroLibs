                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa beekîre into biu bionthe, athînjîri-Mûrungu nî baatonyaga kanyomba ka mbere karîa kaarî akuî na mwari kûrita ngûgî ciaao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
            "verseOrgIds": [
              "HEB.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.2+LEV.16.3+LEV.16.4+LEV.16.5+LEV.16.6+LEV.16.7+LEV.16.8+LEV.16.9+LEV.16.10+LEV.16.11+LEV.16.12+LEV.16.13+LEV.16.14+LEV.16.15+LEV.16.16+LEV.16.17+LEV.16.18+LEV.16.19+LEV.16.20+LEV.16.21+LEV.16.22+LEV.16.23+LEV.16.24+LEV.16.25+LEV.16.26+LEV.16.27+LEV.16.28+LEV.16.29+LEV.16.30+LEV.16.31+LEV.16.32+LEV.16.33+LEV.16.34"
              },
              "items": [
                {
                  "text": "Ala 16.2-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî nî mûthînjîri-Mûrungu ûrîa mûnene wenka akî waakûrûkaga kanyomba ga twîrî na kinya we aakûrûkaga rîmwe rîonka o mwaka. Ningî atîngîkûrûka ku atî na tharike îrîa aaritaga nîûntû bwa meeyia jaawe wengwa na meeyia jarîa antû baathithagia batîkûmenya. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuumania na ûu gwakarîkaga, Roho Ûmûtheru arîmenyithania atî njîra ya gûtonya antû arîa atheru buru îtîrugûri këethîra kanyomba kau ka mbere ka îema noo karî o. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îîjî nî ngerekano ya kwonania ûrîa îgiita rîrî rîkari. Kûringana na mantû jau biewa na igongwana birîa biritagwa bitîtûmaga nkoro ya ûrîa wîtaga kûthaathayia Mûrungu îthera buru. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa mantû ja makûrû jonthe jegiî biakûrîa na biakunyua na kûtheria mwîrî kuumania na mantû mwanya mwanya. Mawaatho jau jonthe nî jaarî gîtûmi mwanka rîrîa Mûrungu aaretere njîra îngî înjerû.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristû nîwe kîgongwana kîrîa kîega buru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, rîrîa Kristû eejîre arî mûthînjîri-Mûrungu ûrîa mûnene nî aaretere mantû jameega. We nî aarî agûkûrûka îemeene rîrîa rînene nkûrûki na rîrîa rîagîru buru. Îema rîu rîtîthithîtue nî muntû, na rîtî nthîgûrû îîjî. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.11",
            "verseOrgIds": [
              "HEB.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû aakûrûkîre antû au atheru buru rîmwe rionka na rîa mûthia. Ataakûrûkîre antû au akamatîte tharike ya mbûri na njaû, îndî aakûrûkîre na tharike yaawe wengwa na aratûma twona wonokio bûrîa bûtîkorothira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.12",
            "verseOrgIds": [
              "HEB.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.15+LEV.16.16"
              },
              "items": [
                {
                  "text": "Ala 16.15-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.9"
              },
              "items": [
                {
                  "text": "Gût 19.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.17+NUM.19.18+NUM.19.19"
              },
              "items": [
                {
                  "text": "17-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tharike ya mbûri na ya ndeegwa na mûju jwa tûjaû tûrîa twakagîîrua nî biatûmaga antû barîa beethagîrwa barî na mûgiro batherua mîîrî yaao. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
              "HEB.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû ûu nîu gûkari rî, tharike ya Kristû yoomba kûbûtheria nkoro bûgatiga mantû jarîa jareetaga gîkuû na bûgatumîkîra Mûrungu ûrîa ûtûûraga mwoyo. Nîkwîthîrwa nîûntû bwa inya ya Roho ûrîa ûtûûraga kenya na kenya, Kristû nî airitîre wengwa kîrî Mûrungu arî kîgongwana gîkîega buru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.14",
            "verseOrgIds": [
              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bwa gîtûmi kîu, Kristû nîwe ûgwatithanagia Mûrungu na antû ndeene ya kîrîkanîro gîkîerû nîkenda barîa beeti boomba kwona rûgai rûrîa rwîranîri kenya na kenya. Tontû gîkuû kîaawe nîkîo kîathaûrîre antû kuuma ûkomboone bwa meeyia jarîa baathithîtie barî kîrîkanîroone kîa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rûgai rûtîeejanagwa mwanka rîrîa mwene kûgaa rûgai rûu agakua. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gîtûmi nîûntû mantû jarîa jaandîki ku jathithagua mwene kuigaa akua. Barûga îîu ya kiigai îtîambagîîria kûrita ngûgî mwene kwigaa arî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, kinya kîrîkanîro kîa mbere kîarikithîrue rîrîa tharike yeetûrîrwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.6+EXO.24.7+EXO.24.8"
              },
              "items": [
                {
                  "text": "Kum 24.6-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbere mma Musa aambîre kûmenyithia antû bonthe mantû jegiî maathana jonthe ja Mûrungu, rîu arajûkia tharike ya mbûri na ya ndeegwa yuungenue na rûûjî na araminyîria yuku rîa Waatho na araminyîria antû bonthe agîtûmagîra karwang'i ka mûkuû na kînyaguthi gîgîtuune ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiugaga, “Îîjî nî tharike ya kûrikithia kîrîkanîro kîrîa Mwathani abwathîte bûûjûragia.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
            "verseOrgIds": [
              "HEB.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.15"
              },
              "items": [
                {
                  "text": "Ala 8.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Musa aracoka araminyîria îema na into bionthe birîa biatumagîrwa ku bakîthaathayia Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.11"
              },
              "items": [
                {
                  "text": "Ala 17.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûrîa gûkari nî atî kûringana na Waatho bwa Musa akuî into bionthe bitheragua na tharike. Kinya kûrekerwa kwa meeyia gûtîonora buru mbere ya tharike îîtîka.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristû nîwe ûrekanagîra Meeyia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
            "verseOrgIds": [
              "HEB.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Into birîa bitumagîrwa kûthaathayia Mûrungu aja nthî nî mûng'uanano jwa into birîa bikaraga îgûrû. Tontû into biu nî bitheragua na njîra ya igongwana bia nyomoo, into bia îgûrû nî bitheragua na igongwana bibiega nkûrûki ya igongwana bia nyomoo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.23",
            "verseOrgIds": [
              "HEB.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa Kristû aatonyere antû atheru buru, antû atîthithîtue nî antû, ta o îgûrû rîongwa. Nandî Kristû eethagîrwa arî mbere ya Mûrungu nîûntû bweetû. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû atatonyere antû au maita jamaingî ta ûrîa mûthînjîri-Mûrungu ûrîa mûnene wa Ayahudi atonyaga antû au atheru buru o mwaka o mwaka arî na tharike ya nyomoo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûrîngîîthîrwa gûkari ûu Kristû arîngîîthîrwa athangîkîte magiita jamaingî kuuma rîrîa nthîgûrû yoombîrwe mwanka nandî. Îndî ûrîa gûkari nî atî we aacionanîrie kîrî antû bonthe rîmwe rîonka na rîa mûthia nîkenda îgiita rîa mûthia athiria meeyia nîûntû bwa ûrîa airitîre wengwa arî kîgongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.26",
            "verseOrgIds": [
              "HEB.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ta ûrîa gûtuui, o muntû wonthe no mwanka akue rîmwe akî rîu agiitîrwe îgamba nî Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.27",
            "verseOrgIds": [
              "HEB.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.12"
              },
              "items": [
                {
                  "text": "Isa 53.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, Kristû wengwa airitîre arî kîgongwana nîkenda arekera antû babaingî meeyia. Rîrîa agacoka îgiita rîa jaîrî, atîcoka kûrwaa na meeyia îndî akeeja kwonokia barîa batûûraga bamweteerete.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.28",
            "verseOrgIds": [
              "HEB.9.28"
            ]
          }
        }
      ]
    }
