              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrîkanîroone kîrîa gîkûrû Waatho nî bwaugaga ûrîa Mûrungu aabuîri kûthaathawua na nî kwaarî na antû aathithîtue a kûmûthaathagîria aja nthîgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.1",
            "verseOrgIds": [
              "HEB.9.1"
            ]
          }
        },
