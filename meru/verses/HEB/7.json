          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrungu nî aaciîtîrie akîmwethia mûthînjîri-Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Antû bangî bakîaa athînjîri-Mûrungu, Mûrungu ataciîtagia. Îndî rîrîa Jesû aeejaga mûthînjîri-Mûrungu, Mûrungu aaugîre ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
