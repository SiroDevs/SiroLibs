        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû nî jakwoneka bwega nkûrûki nîûntû mûthînjîri-Mûrungu ûkari ta Melikizedeki akwîja, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ûrîa waaere mûthînjîri-Mûrungu, tî kuuma mwîrîgeene jwa Lawi ta ûrîa Waatho buugaga, îndî nî kuumania na inya ya ûtûûro bûrîa bûtîthiraga. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Zab 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa nî kwaandîki mantû jamwegiî ûjû,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
