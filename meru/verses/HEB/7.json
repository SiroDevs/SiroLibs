          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athînjîri-Mûrungu barîa baarî o mbereene nî babaingî mono nîûntû nî baakujaga batîte na mbere kûrita ngûgî.",
          "type": "text",
