                "loc": "HAG.2.6"
              },
              "items": [
                {
                  "text": "Hag 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kajû kaawe kagiiteene kau nî gaatûmîre nthîgûrû inaina, îndî nandî nî eekîre wîrane atî, “Rîu rîngî ntinainia nthîgûrû akî îndî nkainainia kinya îgûrû.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
            "verseOrgIds": [
              "HEB.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nteto iu “Rîu rîngî” irîtwonia atî into bionthe birîa biûmbi bikainainua na biritwe o, nîkenda kîrîa gîtîûmba kwinainîka gîtigara. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, tûcokerieni Mûrungu nkaatho nîûntû bwa gûtûaa Ûnene bûrîa bûtîûmba kwinainua. Tûmûthathayieni ûrîa kwagîrîte tûkîmûkîraga na kwinyiia mbere yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.28",
            "verseOrgIds": [
              "HEB.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
