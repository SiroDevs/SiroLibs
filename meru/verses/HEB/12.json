              "items": [
                {
                  "text": "Kûr 4.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa Mûrungu weetû nî mwanki jûîîthagia jûkathiria buru.",
          "type": "text",
