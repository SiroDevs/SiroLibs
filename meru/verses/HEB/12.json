            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.22+DEU.5.23+DEU.5.24+DEU.5.25+DEU.5.26+DEU.5.27"
              },
              "items": [
                {
                  "text": "5.22-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Buî bûtîîti bwîta antû bûûmba kûringithia na njara, ta ûrîa antû ba Israeli beetîrwe bareeta kîrîmeene gîa Sinai kîrîa barîngîringithia na njara, kana antû arî na mwanki kana antû arî na muundu kana antû arî na kwithikîîra gûkûnene kana antû arî na kîbubani, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.18",
            "verseOrgIds": [
              "HEB.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kana arîa tarûmbeta gakaringwa kana arîa bûkaigua kajû ga kûmakia antû bonthe ûntû batîenda gûcoka kwigua kajû kau kaîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.19",
            "verseOrgIds": [
              "HEB.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
