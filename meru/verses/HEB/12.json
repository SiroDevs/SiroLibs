              "items": [
                {
                  "text": "Isa 35.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tontû bûû, njara cieenu îrîa igoogoi nî igîe inya na maru jeenu jarîa jagûtetema nî jarûngame ceeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Njun 4.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Thingatageni njîra irîa ciagîrîte nîkenda barîa barî wonje kinya bûrîkû batîkaremwe gwîta mwanka boorue.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
      ]
    },
    {
