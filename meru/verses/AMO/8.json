              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîracoka ndîraguûrîrwa ûntû bûngî nî MWATHANI Mûrungu. Atîrî, ndîroona gîkabû kîrî na matuunda jaguundi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI arambûûria atîrî, “Amosi nîmbi ûkwona?” Naani ndîramwîra, “Nî gîkabû kîrî na matuunda jaguundi jakinyîtie a kûrîîwa.” MWATHANI arambîîra atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa Israeli îkaathirua",
          "type": "text"
        }
      ]
    }
  ],
