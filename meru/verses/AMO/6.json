        },
        {
          "text": "Ningî gûgaakara atîrî, gûkëeja kwîthîrwa ûû ta antû îkûmi batigeere barî nyomba îmwe, kinya bo bagaakua. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
