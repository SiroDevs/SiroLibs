        },
        {
          "text": "Joshua nî eetîre antû ba mwîrîga jwa Rubeni na jwa Gadi, na nusu ya mwîrîga jwa Manase ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.1",
            "verseOrgIds": [
              "JOS.22.1"
            ]
          }
        },
        {
