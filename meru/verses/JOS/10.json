            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua na njûûrî ya Israeli bonthe baracoka baraithûkîra ntûûra ya Debiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.38",
            "verseOrgIds": [
              "JOS.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramîtaa amwe na mûnene waayo na tûtûûra tûrîa twamîcîgîîrîîtie tûnthe. Barabooraga na nchiû batîtigie muntû kinya ûmwe. Joshua arathithîria Debiri na mûnene waayo o ta ûrîa athithîîrîîtie Heburoni na Libuna na anene baacio.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
