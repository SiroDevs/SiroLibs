          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma mwîrîgeene jwa Gadi baraewa Ramothi-gileadi, îmwe ya ntûûra cia kûmatûkaga gwiciitha na Mahanaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.38",
            "verseOrgIds": [
              "JOS.21.38"
            ]
          }
        },
