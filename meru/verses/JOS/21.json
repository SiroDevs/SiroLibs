          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma mwîrîgeene jwa Rubeni baraewa Bezeri na Jahaza ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.36",
            "verseOrgIds": [
              "JOS.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
