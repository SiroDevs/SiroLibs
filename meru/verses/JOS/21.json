          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Dimuna na Nahalali; cionthe ciaarî ntûûra inya amwe na bieni biaacio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.35",
            "verseOrgIds": [
