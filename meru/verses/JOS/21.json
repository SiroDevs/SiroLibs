          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû Alawi barîa baatigeere ba mîciî ya Merari nî baeerwe ntûûra îkûmi na ijîîrî.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.40",
            "verseOrgIds": [
              "JOS.21.40"
            ]
          }
        }
