          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Heshiboni na Jazeri; cionthe ciaarî ntûûra inya amwe na bieni biaacio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.39",
            "verseOrgIds": [
              "JOS.21.39"
            ]
          }
        },
