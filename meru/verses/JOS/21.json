            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Alawi ba mîciî ya Gerishoni nî baaerwe ntûûra iji kuuma mwîrîgeene jwa nusu ya Manase: Golani îrîa îrî Bashani, îmwe ya ntûûra cia kûmatûkaga gwiciitha, na Beeshitera; cionthe ciaarî ntûûra ijîîrî amwe na bieni biaacio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.27",
            "verseOrgIds": [
              "JOS.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûûma mwîrîgeene jwa Isakari baraewa Kishioni na Daberathi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.28",
            "verseOrgIds": [
              "JOS.21.28"
            ]
          }
        },
