              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntûûra cionthe irîa Alawi bagaîîrwe gatîgatîîne ka antû ba Israeli ciaarî mîrongo îna na inyaanya amwe na bieni biaacio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ntûûra nî yaarî na kîeni kîmîthiûrûkîrîte. Ûu nîu ntûûra iu cionthe ciaakari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.42",
            "verseOrgIds": [
              "JOS.21.42"
            ]
          }
        }
      ]
