                {
                  "text": "Kûr 31.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.31.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
