          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntûûra iu amwe na tûtûûra twaacio nîcîo ciagaîîrwe antû bwa mwîrîga jwa Asheri kûringana na mîciî yaao.",
          "type": "text",
