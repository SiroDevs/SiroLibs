          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Uma na Afeki na Rehobu; cionthe ntûûra mîrongo îîrî na ijîîrî na tûtûûra twaacio. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.30",
            "verseOrgIds": [
              "JOS.19.30"
            ]
          }
