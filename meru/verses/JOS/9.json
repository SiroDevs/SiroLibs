            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baracokeria Joshua baramwîra atîrî, “Nî twaarî tûkwîrwa ûrîa MWATHANI Mûrungu waaku eerîte Musa nthûûmba yaawe atî akabûnenkera nthî îîjî yonthe na atî akaathiria antû bonthe barîa batwîre ku baume mbere yeenu. Naatuî nî twagwatîrwe nî ûguaa bûbûnene mono tûkîbûkîra na nîkîo gîatûmîre tûthithia ûntû bûu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
