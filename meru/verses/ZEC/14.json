              "ZEC.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî mûrimo jûmûthûûku jûkagwata mbarathi, na nyûmbû, na nkamîîra, na ntigiri, na nyomoo ingî cionthe irîa ikeethîrwa irî kambîîne ya anthû.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.15",
            "verseOrgIds": [
              "ZEC.14.15"
            ]
          }
        }
      ]
    },
