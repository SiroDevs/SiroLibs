              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
            "verseOrgIds": [
              "ZEC.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu rîakinya ntuara cia mbarathi ikaandîkwa atîrî, “Întheru nîûntû bwa MWATHANI.” Nacio nyongû cia kîûrû kîa MWATHANI ikaa intheru o ta mpakûri irîa irî mbere ya kîritîro kîa igongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.20",
            "verseOrgIds": [
              "ZEC.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 14:21"
          },
