        },
        {
          "text": "Îndî rîrîa Balaamu oonere atî MWATHANI nî kûtharima eendaga kûtharima Israeli, ateetîre kûringia kaîrî ta ûrîa aathithagia mbereene. Îndî nîka aagarûkîre areerekera bwa rwanda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaamu araithîîria aroona antû ba Israeli baambîte maema jaao kûringana na mîîrîga yaao. Nîrîo Roho wa Mûrungu aamwîjîrîre, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "araambîrîîria kûroria akiugaga atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûroria bwa Balaamu bwa mûthia",
          "type": "text"
        }
      ]
    },
