          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Balaamu nî eerîre mûnene Balaki atîrî, “Tontû nandî gancokeete kîrî antû beetû rî, îjaîja nkwîre mantû jarîa antû baba ba Israeli bakaabûthithîria buî antû ba Moabu îgiita rîtî kûraaja.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        },
        {
