              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.33.40"
              },
              "items": [
                {
                  "text": "Gût 33.40",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûnene wa Aradi ûrîa Mûkanaani, ûrîa waatûûraga rûteere rwa bwa ûmotho rwa Kanaani, rîrîa aigîrue Israeli nî îîtîrîte njîreene ya Atharimu, nî aaithûkîîre Aisraeli, arataa bamwe baao. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.1",
            "verseOrgIds": [
              "NUM.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîrîo Aisraeli baaciîtîrie mûciîtio kîrî MWATHANI baramwîra atîrî, “Ûkëeja gûtûma tûkoomba antû baba ndweene, nî mma tûkaathiria ntûûra ciaao buru.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI araigua mûciîtio jwa antû ba Israeli aranenkanîra Akanaani kîrî bo. Nabo Aisraeli barabathiria buru na barathiria ntûûra ciaao. Naku antû au kûreetwa Horima.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.3",
              "type": "text"
            },
            {
              "text": "Horima:",
              "type": "text"
            },
            {
              "text": "na Kîhibirania nî kuuga “Kûthirua buru.”",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Njoka îrîa yaathithîtue na îturutia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
