                "loc": "DEU.16.1+DEU.16.2"
              },
              "items": [
                {
                  "text": "Kûr 16.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî eetîre na mbere kuuga atîrî, “Kûrî ntukû ya îkûmi na inya ya mweri jwa mbere nîrîo mambura ja Pasaka yaakwa ni MWATHANI jakambagîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kum 12.14-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.15"
              },
              "items": [
                {
                  "text": "23.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.18"
              },
              "items": [
                {
                  "text": "34.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Kûr 16.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo ntukû ya îkûmi na ithaano ya mweri jûu nîrîo bûkaambagîîria mambura ja mîgaate îtiimbithîtue. Mîgaate îtiimbithîtue îrîîwe ntukû mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû ya mbere ya mambura jau îkethagîrwa îrî ya kûthaathayia Mûrungu na gûtî ngûgî îbuîrîte kûritagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî bûnditagîre kîgongwana gîa gwakîîria nakîo nî: tûregwa twîrî, na ntûrûme îmwe, na tûtûrûme mûgwanja twa mwaka jûmwe, na no mwanka twîthîrwe tûtî na antû athûûku noo amwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî bûritage kîgongwana kîu kîa irio kîa mûtu jûmwinyu juunganîtue na maguta: bûkaritanagîria kîgongwana kîa ndeegwa amwe na kilo ithatû cia mûtu jûmwinyu na bûritanagîrie ntûrûme îmwe amwe na kilo ijîîrî cia mûtu jûmwinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatûrûme kamwe ka tûu mûgwanja karitanagîrue amwe na kilo îmwe ya mûtu jûmwinyu buru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî bûritage nthenge îrî kîgongwana kîa kûthiria meeyia nîkenda bûthirîrua meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabuî bûkaaritaga igongwana biu o amwe na igongwana birîa bingî bia gwakîîria biritagwa o rûkîîrî o rûkîîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûthithagie o ûu bûkanditîra kîgongwana gîa gwakîîria kîrîa kîrî yeera rîrîega ntukû mûgwanja. Igongwana biu biritagwe o amwe na igongwana birîa biritagwa o rûkîîrî o rûkîîrî birî igongwana bia gwakîîria na bia gwîîtûûrîria. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo ntukû ya mûgwanja yakinya bûûthûranage nîkenda bûnthaathayia na bûkáritaga ngûgî no îrîkû.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        }
      ]
    },
