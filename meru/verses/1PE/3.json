                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Akol 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Buî eekûrû, inyiiagieni kîrî akûrû beenu. Ûntû bûu nîbu bûgatûma bamwe baao barîa batîtîkîtie rûteto bagarûka nîûntû bwa mîtîre ya eekûrû baao batîarîrîtue, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1Tim 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " boona ûrîa mîîtîre ya eekûrû baao îrî ya ûtheru na ya gûkîra Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwigemia kweenû gûkéethîrwa kûrî kwa mwîrî ta kwîînda nchiûri na kwigemia na into bia thaabu na gwîkîra nguû cia goro. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî kwigemia kweenu nî kwîthîrwe kûrî gwa nkoro ndeene. Into bieenu bia kwigemia nî biîthîrwe birî birîa bitîînyangaga nabio nî mûtûûrîre jwa ûboreri na ûkiri. Mantû jau nîjo jarî gîtûmi mono mbere ya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu eekûrû bamwe barîa baatwîre karaaja barîa baakaraga beerîgîîrîte Mûrungu baigemagia. Nabo baatûûraga bainyiîtie kîrî akûrû baao. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Kîam 18.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûu nîu Sara aathîkaga kîrî Abrahamu akîmwîtaga mwathi waakwa. Naabuî nandî bûrî aana ba Sara bwatua kûthithagia ûrîa kwagîrîte na bweethîrwa bûtîreka bûguawua nî ûntû kinya bûrîkû. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Aef 5.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Akol 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naabuî akûrû bûbuîri gûtûûrania na eekûrû beenu bwega bûkîmenyaga atî batî na inya taabuî. Batîîageni tontû kinya bo nî baeei kîewa kîa ûtûûro nî Mûrungu o ûmwe naabuî. Thithagieni ûu nîkenda maromba jeenu jatîkeeje kûrigîîrua.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûthangîkua nîûntû bwa kûthithia ûrîa kwagîrîte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthieene, ataana na aarî ba baaba, ndîbwîra ûjû: nî bûbuîri kwîthîrwa bûrî na yerekeeria rîmwe. Iganagîîrueni kîaao na bwendanage ta aana ba ng'ina ûmwe. Ningî bwîthîrwe bûrî na nkoro ibooreri na bûkinyiiagia o muntû kîrî ûngî. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkárîagieni ûûî na bûngî. Ningî bûkárîagieni kîrumi na kîngî. Îndî antû a kûthithia ûu, tharimanageni tontû ûntû bûu nîbu bwîtîri bûtua kûthithagia nîkenda kinya buî bûkeeja kwona kîtharimo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.12+PSA.34.13+PSA.34.14+PSA.34.15+PSA.34.16"
              },
              "items": [
                {
                  "text": "Zab 34.12-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû Maandîko jaugîîte,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî rî, nûû ûûmba kûbûthûûkia këethîrwa bûrî na wîru bwa kûthithia ûrîa kwagîrîte? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.10"
              },
              "items": [
                {
                  "text": "Mat 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12+ISA.8.13"
              },
              "items": [
                {
                  "text": "Isa 8.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî kinya bûkëeja kûthangîkua tontû bwa kûthithia ûrîa kwagîrîte, Mûrungu akabûtharima. Bûkábakîreni kana bûthangîka. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî buî tîîageni Kristû arî Mwathani nkoroone cieenu. Karageni bwithuranîrîte gûcokeria wonthe ûrîa ûûmba kûbûria mantû jegiî wîrîgîîro bûrîa bûrî nabu. Thithagieni ûu bûrî na ûkiri na gîtîîo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Karageni bûtî na ûntû bwa kûbûgambithia nkoroone cieenu nîkenda kinya rîrîa bûkarumwa, bau bakûbûruma bacokerwe nî nthao boona mathithio jeenu jameega jarîa bûthithagia bûrî ndeene ya Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû nî kaaba kûthangîkua nîûntû bwa kûthithia ûrîa kwagîrîte këethîrwa bûu nîbu wendi bwa Mûrungu nkûrûki ya kûthangîkua nîûntû bwa kûthithia ûthûûku. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû kinya Kristû ka aakuîre nîûntû bwa meeyia jeetû rîmwe rîonka. We ûrîa waarî ûmwagîru arakua nîûntû bwa antû barîa bataagîrîte nîkenda agatûreeta kîrî Mûrungu. We nî aakuîre mwîrî îndî aragîa ûtûûro ndeene ya Roho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areeta gûtûmîîria roho irîa ciatheeki. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Kîam 6.1—7.24",
              "type": "text"
            }
          ]
        },
        {
          "text": " Roho iu nî cia barîa bataathîkîrîte Mûrungu îgiiteene rîa Noa rîrîa Mûrungu eeteerete aboorerete ntukûûne irîa Noa aakaga sabina. Antû babakai barîa baatonyere sabineene, nabo nî antû banana, nîbo boonokere rûûjî rwa îkondoria. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwonokua kûu kwaao kûraa rwano rwa kwonania gûkeeja ûbatithio bûu buî bwonoketue nabu nandî. Naku kwonokua kûu tî kûthambua rûko rwa mwîrî, îndî ûrîa gûkari nî kwerenca Mûrungu nîkenda agatwaa mathûgaanio jamakembûku kuumania na kûriûka kwa Jesû Kristû, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ûrîa waitîrie îgûrû na ûkari rûteere rwa njara ya ûrîo ya Mûrungu akîathaga araîka na athani na mainya jonthe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
