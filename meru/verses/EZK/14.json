            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.8"
              },
              "items": [
                {
                  "text": "Kûg 6.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " MWATHANI Mûrungu ariuga atîrî, “Nîatîa mantû jakeethîrwa janenei bûng'ana, rîrîa ngaakanûkia Jerusalemu na mantû jana jarîa mathûûku buru. Najo nî ndwaa na mpara na nyamû inthûûku na mîrimo îmîthûûku nîkenda bithiria antû na nyomoo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.21",
            "verseOrgIds": [
              "EZK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî gûkëethîrwa kûrî bagaatigara ba gûtongeeria aana beenu, rîrîa bakeeja kîrî buî na bwoone mîîtîre yaao na mathithio jaao, bûkaaborerua nîûntû bwa mantû jamathûûku jarîa nthithîrîtie Jerusalemu na mantû jangî jarîa mîthithîrîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.22",
            "verseOrgIds": [
              "EZK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkaborerua bwona mîîtîre yaao na mathithio jaao na bûkaamenya gûtî ûntû nthithîtie ûtheri gûtî na gîtûmi, nîu ni MWATHANI Mûrungu nkuuga.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.23",
            "verseOrgIds": [
              "EZK.14.23"
            ]
          }
        }
      ]
