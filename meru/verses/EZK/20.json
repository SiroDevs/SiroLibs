            "sid": "EZK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îndî kinya aana baao nî baaregere kûmbathîkîra. Bataathîkîîre Waatho bwaakwa kana baathîkîra mataaro jaakwa, jarîa muntû abuîrîte kûthingata nîkenda atûûra mwoyo. Nabo nî beekîîre sabatû ciaakwa mûgiro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.21",
            "verseOrgIds": [
              "EZK.20.21"
            ]
          }
        }
