        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îndî buî buugaga atî, ‘MWATHANI atîthithagia mantû ja îota.’ Nandî buî antû ba Israeli thikîîreeni. Buî bûrîthûgaania atî ntîthithagia mantû ja îota. Ka mantû jaakwa jatî ja îota? Anga mantû jeenu tijo jatî ja îota? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.25",
            "verseOrgIds": [
              "EZK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûmwagîru akëeja gûtiga kûthithia mantû jamaagîru, akaambîrîria kûthithia meeyia, muntû ûu agaakua, nîûntû bwa meeyia jau. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.26",
            "verseOrgIds": [
              "EZK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî muntû ûmûthûûku akëeja gûtigana na ûthûûku bûrîa aathithia akaambîrîria kûthithia jarîa jaagîrîte, muntû ûu agatûûra mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.27",
            "verseOrgIds": [
              "EZK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa muntû ta ûu nî aaithûgaanîrie bwega aratigana na ûthûûku bunthe bûrîa aathithia, no mwanka atûûre mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.28",
            "verseOrgIds": [
              "EZK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî antû ba Israeli bo baugaga, ‘MWATHANI nî athithîtie mantû jatî ja îota.’ Ka mantû jaakwa jatî ja îota? Anga tî mantû jeenu jatî ja îota?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.29",
            "verseOrgIds": [
              "EZK.18.29"
            ]
          }
        }
      ]
