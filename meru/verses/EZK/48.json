          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwankana na mwîrîga jwa Simioni, mwîrîga jwa Isakari jûkaagaîrwa rûthanju rûmwe rwa kîthaka kuuma bwa gaiti gwîta bwa rûgûrû. ",
          "type": "text",
          "attrs": {
