          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwankana na mwîrîga jwa Zebuloni, mwîrîga jwa Gadi jûkaagaîrwa rûthanju rûmwe rwa kîthaka kuuma bwa gaiti gwîta bwa rûgûrû. ",
          "type": "text",
          "attrs": {
