            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Hamani aracuurua antû arîa aakîte gwa gûcuuria Modekai. Rîu mûnene arathûûrûka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
        }
      ]
    }
