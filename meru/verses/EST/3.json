          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî gweekîri Waatho atî mantû jarîa jaarî barûgeene ya kuuma kwa mûnene jatûmîîrue nthîgûrû yonthe nîkenda antû bonthe beethîrwe baithuranîrîte ntukû îîu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.3.14",
