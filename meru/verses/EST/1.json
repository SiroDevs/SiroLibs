      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûka-mûnene tawe Vashiti kûrega kwathîkîra mûnene Aritashashita",
          "type": "text"
        }
      ]
    },
    {
