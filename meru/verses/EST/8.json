              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waatho bûu bwaabuîrîte gûtûmîîrua kîrî antû bonthe ba nthîgûrû cionthe. Nabo Ayahudi nî baabuîrîte kwîthîrwa baithuranîrîte nîkenda bairîîria kîrî anthû baao ntukû îîu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.13",
            "verseOrgIds": [
              "EST.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe mûnene nî eerîre eetithia mbarathi ciaawe irîa ciaarî rwîro mono beetange bagatûmîîrie waatho bûu. Nabu waatho bûu bûratûmîîrua ntûûreene îrîa nene ya Susa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.14",
            "verseOrgIds": [
              "EST.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.14",
            "verseOrgIds": [
              "EST.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekai nî aaumîre gîkaroone kîa mûnene eekîrîte rwambambio rwa ûnene rwa rangi ya wiirû bwa îgûrû na rangi înjerû. Ningî nî eekîrîte nguû ya îgûrû ya ndigi cia bamba ya rangi ya mûkû. Ningî nî eekîrîte thirû înthongi. Nabo antû ba ntûûra ya Susa nî baagwîrîîtue mono bagîkûngwagîra. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.15",
            "verseOrgIds": [
              "EST.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Ayahudi nî baagwîrîîtue mono, na banogoki bakwona bakûûmbana. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.16",
            "verseOrgIds": [
              "EST.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthîgûrûûne yonthe na ntûûreene cionthe kûrîa waatho bûu bwaathomagwa, Ayahudi nî baagwîragua mono, bakathithia biatho nîûntû bwa nkerû, na bakanogoka kuuma ngûgîîne ciaao. Ningî antû babaingî barîa bataarî Ayahudi nî baaere Ayahudi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.17",
            "verseOrgIds": [
              "EST.8.17"
            ]
          }
        }
      ]
    }
