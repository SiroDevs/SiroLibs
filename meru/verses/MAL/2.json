          "type": "text",
          "attrs": {
            "verseId": "MAL.2.4",
            "verseOrgIds": [
              "MAL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAL 2:5"
          },
          "items": [
            {
              "text": "5",
