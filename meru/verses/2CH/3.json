                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ningî aratuma gîtambaa gîa kûgaania kîûrû na antû arîa atheru kîa nguû înthongi aragîaka rangi ya wiirû bwa îgûrû na întuune, na arakîgemia na mbicha cia kerubi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îtugî biîrî bithithîtue na îturutia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.14",
            "verseOrgIds": [
              "2CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aarathithia itugî biîrî mbere ya kîûrû bia ûraaja bwa mita îkûmi na mûgwanja na nusu (17.5m). Nabio biongo biaabio biaarî bia mita ijîîrî na nusu (2.5m). ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî arathithia mîtungo îkarî ja mîkathî aramîcuuria itugîîne îgûrû na aracuuria mîng'uanano ya matuunda ja kûûmba na îturutia jakari ta mîkukumanga mîtungoone îîu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itugî biu nabio abiîkîte mbere ya kîûrû, kîmwe kîrî rûteere rwa ûmotho na kîngî rûteere rwa ûrîo. Kîrîa kîaarî rûteere rwa ûmotho aragîîta Jakini",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.17",
              "type": "text"
            },
            {
              "text": "Jakini:",
              "type": "text"
            },
            {
              "text": "kiugo gîkî gîkari ta kîa Kîibirania kîrîa kiugîîte “Mûrungu nîwe ûrikithagia.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " nakîo kîrîa kîaarî rûteere rwa ûrîo aragîîta Boazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.17",
              "type": "text"
            },
            {
              "text": "Boazi:",
              "type": "text"
            },
            {
              "text": "kiugo gîkî gîkari ta kîa Kîibirania kîrîa kiugîîte “Nî inya yaawe.”",
              "type": "text"
            }
          ]
        }
      ]
    }
