          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ningî mathithio jaawe kuuma kîambîrîîria mwanka mûthia nî jaandîki yukuune rîa anene ba Israeli na Juda.",
          "type": "text",
