              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû jangî jonthe ja waathani bwa Josia na ûrîa eetîkîtie MWATHANI na akaathîkagîra mawaatho jaawe na ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
