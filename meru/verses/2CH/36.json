              },
              "items": [
                {
                  "text": "1Ane 9.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî baraîthia kîûrû kîa Mûrungu na baramomoranga rûthingo rwa Jerusalemu. Baraîthia nyomba cia anene cionthe na bareenyangia into bia goro bionthe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        }
