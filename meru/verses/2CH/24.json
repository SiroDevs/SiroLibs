        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.35"
              },
              "items": [
                {
                  "text": "Mat 23.35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.51"
              },
              "items": [
                {
                  "text": "Luk 11.51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu Roho wa Mûrungu aarejîîra Zekaria mûtaana wa Jehoiada ûûria waarî mûthînjîri-Mûrungu, nawe ararûngama areera antû atîrî, “Ûjû nîu Mûrungu augîîte, ‘Nîmbi îtûmîte buuna maathana ja MWATHANI bwaaga umithio? Tontû nî bûtiganîrîtie MWATHANI rî, kinya we aakûbûtiganîria.’” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî baramûkunyanîra, na mûnene ararita Waatho baramûûragîra na maiga kîaragoone gîa kîûrû kîa MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joashi ararega kûririkana wega bûrîa Jehoiada îthe wa Zekaria aamwonetie, arooraga mûtaana waawe. Nawe Zekaria agîkua arauga, “MWATHANI aroona ûrîa bûkûthithîria na abûkanûkie!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûthia jwa waathi bwa Joashi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
