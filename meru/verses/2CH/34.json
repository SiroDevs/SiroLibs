                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Jer 3.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Josia aarî na ûkûrû bwa mîaka înaana rîrîa aambîrîîrie kwaathana. Nawe aathanîre mîaka mîrongo îthatû na jûmwe arî Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithagia mantû jarîa jaagwîragia MWATHANI, athingatîte ngerekano ya Daudi, na atîkuuna Waatho noo bûrîkû.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josia kwînyangia mîrungu ya mîng'uanano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakeene jwa înaana kuuma akwambîrîria kwaathana, Josia arî o ûmûnini nîrîo aambîrîîrie kûthaathayia Mûrungu wa ûjûûwe Daudi. Mwakeene jwa îkûmi na îîrî nî aambîrîîrie kûmomoranga irombero bia mîrungu mîgeni na itugî bia Ashera na mîng'uanano ya kwaja na ya yûmba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2Ane 21.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2Ma 33.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabio iritîro bia igongwana bia Baali biramomorangwa na Waatho bwaawe. Aramomoranga into birîa biaîthagîrua ubaani îgûrû rîa iritîro bia igongwana biu. Ningî araunanga itugî bia Ashera na mîng'uanano ya kwaja na ya yûmba; aramîthetheranga îraa tîîri aramînyagia îgûrû rîa mbîrîra cia antû barîa baamîritagîra igongwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1Ane 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî araakîîria mîrûitû ya athînjîri-mîrungu ya mîng'uanano iritîroone bia igongwana biaao aratheria Juda na Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie ûu ntûûreene cia Manase na Efuraimu na Simioni gwîta mwanka Nafutali na bieniine birîa biacithiûrûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî amomorangîre iritîro bia igongwana na itugî bia Ashera, na arathetheraga mîng'uanano îraa mûtu na aramomoranga iritîro bia igongwana bia kwîthîria ubaani bionthe birîa biaarî nthîgûrû ya Israeli. Nawe aracoka Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yuku rîa Waatho kwonora",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakeene jwa îkûmi na înaana kuuma akwambîrîria kwaathana, nyuma ya kûtheria nthîgûrû na kîûrû kîa Mûrungu, Josia nî aatûmîre antû bathatû gwaka kîûrû kîa MWATHANI Mûrungu waawe kûrîa kîathûkangîtue. Nabo nî Shafani, mûtaana wa Azalia na Maaseia, mûrûngamîîri wa ntûûra na Joaha, mûtaana wa Joahazi, ûrîa waarî karani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bareeta kîrî Hilikia mûthînjîri-Mûrungu ûrîa mûnene, baranenkanîra mbeecha irîa ciariti nîûntû bwa kîûrû kîa Mûrungu, irîa ciothûranîtue nî Alawi barîa baakaragia mwari kuuma kîrî antû ba Manase na Efuraimu na kuuma kîrî Aisraeli bonthe barîa baatigeere na kuuma kîrî antû bonthe ba Juda na Benjamini na atûûri ba Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baranenkanîra mbeecha iu kîrî arûngamîîri ba ngûgî ya gwaka kîûrû kîa MWATHANI. Nabo arûngamîîri bau baranenkera ariti ngûgî barîa baathithagia kîûrû kûrîa kwathûkangi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî baranenkera abundi ba mbaaû na ba maiga nîkenda bagûra nacio maiga jamathambie na mbaaû cia gwaka nyomba îrîa anene ba Juda baarekeete îkamomokanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû bau nî baaritîre ngûgî îîu na wîru bûbûnene. Nabo baatongeeretue nî Jahathi na Obadia, Alawi ba nchiarwa cia Merari, na Zekaria na Meshulamu, nchiarwa cia Kohathi. Nabo Alawi bonthe barîa baarî na ûtea bwa kûringa into bia kwina, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîbo baarûngamagîîra akamati ba into na ariti ngûgî ba mîthemba mwanya mwanya. Alawi bangî nabo baarî tûrani na bangî aandîki na bangî akaria ba mpingîro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa baumagaragia mbeecha irîa ciareeti kîûrûûne kîa MWATHANI, Hilikia, mûthînjîri-Mûrungu, nî oonîre Yuku rîa Waatho bwa MWATHANI rîrîa rîaejani na njîra ya Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikia areera Shafani ûrîa waarî karani atîrî, “Nkwona Yuku rîa Waatho kîûrûûne kîa MWATHANI.” Nawe Hilikia aranenkera Shafani yuku rîu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani araikîria mûnene yuku rîu na aramwîra atîrî, “Nthûûmba ciaaku nî ikûrita ngûgî cionthe irîa ûracieete. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî baritîîte mbeecha cionthe irîa cieeki nyomba ya MWATHANI na bainenkanîra kîrî arûngamîîri na ariti ba ngûgî.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî Shafani areera mûnene atîrî, “Mûthînjîri-Mûrungu Hilikia akûnenkera yuku.” Shafani arathomera mûnene rîo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûnene aigîrue nteto cia Waatho aratambûranga nguû ciaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areera Hilikia na Ahikamu, mûtaana wa Shafani na Abidoni, mûtaana wa Mika na Shafani, ûrîa waarî karani na Asaia, nthûûmba ya mûnene ûjû: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îteeni bûkarombe kîrîra kîrî MWATHANI nîûntû bwaakwa na antû barîa batigeere Israeli na Juda mantûûne jegiî nteto cia yuku rîrî. MWATHANI nî athûûri mono nî tuî nîûntû biûjûjû bieetû nî biaregîre kwaathîkîra kiugo kîa MWATHANI kana bathingata mantû jarîa jaandîki yukuune rîrî.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûu Hilikia amwe na barîa baatûmi nî mûnene, bareeta kîrî mûka-kîroria weetagwa Hulida ûrîa waatûûraga Jerusalemu ntûûra ya ijîîrî baramwîra mantû jarîa jaakarîkîte. Hulida aarî mwekûrû wa Shalumu. Shalumu aarî mûtaana wa Tokathi. Nawe Tokathi aarî mûtaana wa Hasira ûrîa waarî mûmenyeeri wa nguû cia rwambambio kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe arabeera bacoke kîrî mûnene bamwîre atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“MWATHANI Mûrungu wa Israeli ariuga ûjû: Nkaareetera nthîgûrû îîjî na antû baayo ûthûûku, mbagwatithie irumi bionthe birîa biaandîki yukuune rîu rîthirîtie kûthomerwa mûnene wa Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûthûûro jwaakwa jûkabatûrîkîra na jûtîoreka nîûntû nî bambîrûkîrîte beeta kûîthîria mîrungu îngî ubaani nîkenda banthûûria na mathithio jaao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî îreni mûnene wa Juda, ûu ûbûtûmîte bwîîja kûromba kîrîra kîa MWATHANI ûjû, ‘MWATHANI Mûrungu wa Israeli ariuga ûjû bwegiî nteto iu wiigîîtue: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû gwe nî wairirîre na wainyiiyia mbere ya Mûrungu rîrîa waigîrue mantû jarîa aarîîtie jegiî nthî îîjî na atûûri baayo; wainyiiyia mbere yaakwa na watambûranga nguû ciaaku ûkîrîraga mbere yaakwa, kinya ni nî mbigîîtue maromba jaaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani ngaakûa thîîrî mwanka rîrîa ûgaakua na ntîreka woona ûthûûku bunthe bûrîa nkaareetera nthîgûrû îîjî na atûûri baayo.’” Nabo baracoka kîrî mûnene, baramwîra nteto iu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josia gwîka kîrîkanîro gîa kwathîkîra MWATHANI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûnene areeta akûrû bonthe ba Juda na Jerusalemu na baroothûrana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene areeta kîûrûûne amwe na antû ba Juda bonthe na atûûri ba Jerusalemu na athînjîri-Mûrungu na Alawi na kîrîndî kîonthe, kuuma ûrîa mûnini mwanka ûrîa mûnene. Arabathomera nteto cionthe cia yuku rîa Waatho rîrîa rîonekeete kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene ararûngama antû arîa aathithîtue nîûntû bwa anene nawe areeka kîrîkanîro na MWATHANI arauga atî akaathîkagîra MWATHANI na akathingataga maathana jaawe na wîrane bwaawe na nkoro yaawe yonthe na mwoyo jwaawe junthe na atî akoojûragia jarîa jonthe jaandîki yukuune rîu rîa Waatho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aratûma antû ba Benjamini bonthe na atûûri ba Jerusalemu betîkîîria kwathîkîra kîrîkanîro kîu. Atûûri ba Jerusalemu baroojûria ûrîa kîrîkanîro kîa Mûrungu wa biûjûjû biaao kîaugaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Josia nî aaritîre mîng'uanano na moomaramari jonthe jarîa jaarî nthîgûrû ya antû ba Israeli, na aratûma antû bonthe barîa baatûûraga Israeli bacokeera MWATHANI Mûrungu waao. Rîrîa rîonthe aarî mwoyo, antû bataatiga kûthingata MWATHANI Mûrungu wa biujûjû biaao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
