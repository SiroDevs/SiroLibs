              "items": [
                {
                  "text": "1Ane 10.16-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.15+2CH.9.16"
              },
              "items": [
                {
                  "text": "2Ma 9.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Shishaki araithûkîra Jerusalemu; arajûkia mûthithû jûrîa jweeki kîûrûûne kîa MWATHANI na jwa gîkaro kîa mûnene, areeta naju junthe. Ningî arajûkia rong'o cia thaabu irîa ciathithîtue nî Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.9",
            "verseOrgIds": [
              "2CH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Rehoboamu arathithia rong'o ingî cia îturutia. Nacio ciamenyagîîrwa nî akaria ba gîkaro kîa mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.10",
            "verseOrgIds": [
              "2CH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa rîonthe mûnene eetîte kîûrûûne, akaria bau nî beetanagia nawe bakamatîte rong'o iu, na nyumeene bagaicokia nyomba ya akaria.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.11",
            "verseOrgIds": [
              "2CH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 12:11"
          },
          "items": [
            {
              "text": "11",
