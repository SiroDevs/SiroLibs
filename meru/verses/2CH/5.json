          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo athînjîri-Mûrungu bararemwa nî kûrita ngûgî ciaao nîûntû bwa ûrîa mwago jwa MWATHANI jwoojûrîte kîûrûûne.",
          "type": "text",
          "attrs": {
