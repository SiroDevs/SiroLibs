              "items": [
                {
                  "text": "Kum 40.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo aringi ba tarumbeta na ba thaani cia kûringithania na ba into birîa bingî barainanîria amwe rwîmbo rwa gûkumia MWATHANI na kûmûcokeria nkaatho na kajû gakanene bakiugaga:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
