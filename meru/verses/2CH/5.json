                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1Ma 15.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Solomoni aratûmanîra akûrû ba Israeli, na atongeeria ba mîîrîga na ba mîciî ya antû ba Israeli bareeta Jerusalemu nîkenda beeta kûgîîra Îthandûkû rîa Kîrîkanîro kîa MWATHANI kuuma Zaiûni, ntûûra ya Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû bau ba Israeli boothûranîre kîrî mûnene îgiiteene rîa mambura ja Tûgaanda mweriine jwa mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo akûrû ba Israeli bonthe baroothûrana, nabo Alawi baraakamata Îthandûkû, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bararîkûrûkia kîûrûûne. Barajûkia kinya îema rîa gûtirimanîra amwe na into biarîo bionthe barabikûrûkia kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni na kîûthûrano kîonthe gîa antû ba Israeli barîa beejîte kîrî we baroothûrana mbere ya Îthandûkû rîa Kîrîkanîro bakîritaga igongwana bia ng'ondu na ng'ombe inyiingî mono itîngîûmba gûtarîka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo athînjîri-Mûrungu baraikia Îthandûkû rîa kîrîkanîro kîa MWATHANI antû arîa aathuranîri nîûntû bwa rîo kîûrûûne ndeene, antû arîa atheru buru, bararîîka rungu rwa mathagu ja kerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mathagu ja kerubi jaatambûrûkîte îgûrû rîa antû au Îthandûkû rîaarî jakarîkunîkîra amwe na mîaro îrîa rîakamatagwa nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîaro îîu nî yaarî îmîraaja mono nîûntû mîthia yaayo nî yoonekaga muntû arî kîûrûûne bwa ndeene buru îndî îrî o ndeene ya antû arîa atheru mono. Îndî îtoonekaga muntû arî bwa oome. Nayo îrî o kinya naarua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Kûr 10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gûtî gîntû kîaarî îthandûkûûne rîu tiga mbechua irîa ijîîrî Musa eekîrîte ku arî kîrîmeene gîa Sinai arîa MWATHANI aathithîrie kîrîkanîro na antû ba Israeli rîrîa baumaga Misri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwago jwa Mûrungu kîûrûûne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo athînjîri-Mûrungu baraumauma antû arîa atheru buru. Athînjîri-Mûrungu barîa baarî o bonthe nî baitheretie batîkûûria muntû nî wa gîkundi kîrîkû kana kîrîkû. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Alawi barîa aini bonthe, ja bo Asafu na Hemani na Jeduthuni, amwe na ataana baao na antû ba ndûgû ciaao baarûngi rûteere rwa ûrîo rwa kîritîro kîa igongwana beekîrîte nguû inthongi mono na bakîringaga thaani cia kûringithania na inanda na wandîîndî. Ningî nî kwaarî na athînjîri-Mûrungu îgana rîa mîrongo îîrî barîa baaringaga tarumbeta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
