            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa Solomoni aathirîrie kûromba, mwanki jûreenama kuuma îgûrû jûraîîthia igongwana bia gwakîîria, na kinya igongwana birîa bingî biariti, naju mwago jwa MWATHANI jûroojûra kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
