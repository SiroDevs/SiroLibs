            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya athînjîri-Mûrungu batoomba gûkûrûka kîûrûûne kîa MWATHANI nîûntû bwa ûrîa mwago jwa MWATHANI jwoojûri ku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
