    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoshafati kûrwaa na antû ba Amoni na Moabu na Ameuni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumeene, antû ba Moabu na Amoni, amwe na antû bamwe ba Ameuni nî beetîre kûrwaa na Jehoshafati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.1",
            "verseOrgIds": [
              "2CH.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bamwe bareeta bareera Jehoshafati atîrî, “Antû babaingî mono nî bakwîjîîrîte baumîte Edomu, rwongo rûrîa rûngî rwa îria rîa Chumbî, na atîrî, nandî baagûkinya Hazazoni-tamari.” Hazazoni-tamari nooku Enigedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.2",
            "verseOrgIds": [
              "2CH.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati araigua ûguaa, araambîrîîria kûromba MWATHANI, na aratûmîîria Juda kunthe arauga antû baciate irio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.3",
            "verseOrgIds": [
              "2CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû barauma ntûûreene cionthe cia Juda baroothûrana amwe nîkenda bacwaa ûteethio kuuma kîrî MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.4",
            "verseOrgIds": [
              "2CH.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati nî aarûngamîre ntunduune ya antû ba Juda na Jerusalemu kîûrûûne mbere ya kîarago kîrîa kîerû ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.5",
            "verseOrgIds": [
              "2CH.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "arauga atîrî, “Gwe MWATHANI, Mûrungu wa biûjûjû bieetû; anga gwe tîgwe Mûrungu ûrîa ûrî kûu îgûrû? Anga tîgwe waathaga moonene jonthe ja mîgongo? Inya na ûûmbani birî njareene ciaaku, na gûtî muntû ûûmba gûkwirima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.6",
            "verseOrgIds": [
              "2CH.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.8"
              },
              "items": [
                {
                  "text": "Isa 41.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.23"
              },
              "items": [
                {
                  "text": "Jak 2.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Atîrî, gwe Mûrungu weetû, anga ûteengîre antû barîa baatûûraga nthîgûrû îîjî nîûntû bwa antû baaku ba Israeli na ûramîeejana kîrî nchiarwa cia Abrahamu mûcoore waaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.7",
            "verseOrgIds": [
              "2CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nî batwîîre ku, na nî bagwaakîrîte nyomba întheru o ku nîûntû bwa riîtwa rîaaku bakiugaga, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.8",
            "verseOrgIds": [
              "2CH.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Tûkëeja kwîjîîrwa nî ûthûûku-rî, bûrî bwa ndwaa, kana bwa ndwari îmbîî, kana bwa mpara, tuî tûkaarûngama kîûrûûne gîkî, na mbere yaaku, nîûntû kîûrûûne gîkî nîku ûthaathagîrua. Naatuî twagûkaîra nîûntû bwa thîîna yeetû ûtwigue na ûtwonokie.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.9",
            "verseOrgIds": [
              "2CH.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.4+DEU.2.5+DEU.2.6+DEU.2.7+DEU.2.8+DEU.2.9+DEU.2.10+DEU.2.11+DEU.2.12+DEU.2.13+DEU.2.14+DEU.2.15+DEU.2.16+DEU.2.17+DEU.2.18+DEU.2.19"
              },
              "items": [
                {
                  "text": "Kûr 2.4-19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nandî tega woone antû ba Amoni na ba Moabu na ba Kîrîma kîa Edomu, barîa waagirîrie antû ba Israeli baithûkîra rîrîa baumaga nthî ya Misri, barabeeba na batîbathirie. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.10",
            "verseOrgIds": [
              "2CH.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî nî ûkwona barîtûrîaa na kwîja gûtwînga kiigaine gîaaku kîrîa ûtûgaîrîte! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.11",
            "verseOrgIds": [
              "2CH.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itû gwe Mûrungu weetû; tîgwe ûkaagiita bwaao? Tontû tuî tûtî na inya ya kûûmba kîrîndî gîkî kîonthe gîtwîjîîrîte. Tûtîkûmenya ûrîa tûkathithia, îndî nîgwe twîrîgîrîte.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.12",
            "verseOrgIds": [
              "2CH.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu, antû bonthe ba Juda baarûngi mbere ya MWATHANI barî na tûkenke twaao, na aka baao, na aana baao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.13",
            "verseOrgIds": [
              "2CH.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho wa MWATHANI nî eejîriîre Jahazieli mûtaana wa Zekaria. Zekaria aarî mûtaana wa Benaia. Benaia aarî mûtaana wa Jeieli. Jeieli aarî mûtaana wa Matania ûrîa waarî Mûlawi wa mwîrîga jwa Asafu. Roho wa MWATHANI aramwîjîîra arî ntunduune gatîgatî, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.14",
            "verseOrgIds": [
              "2CH.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.1+DEU.20.2+DEU.20.3+DEU.20.4+DEU.20.5+DEU.20.6+DEU.20.7+DEU.20.8+DEU.20.9+DEU.20.10+DEU.20.11+DEU.20.12+DEU.20.13+DEU.20.14"
              },
              "items": [
                {
                  "text": "Kûr 20.1-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nawe arauga; “Thikîîreeni buî antû bonthe ba Juda, na atûûri ba Jerusalemu, na mûnene Jehoshafati. MWATHANI arîbwîîra ûjû: ‘Bûgáakîreni kana bûmaka nîûntû kîrîndî gîkî nî gîkiingî ûjû, nîûntû ndwaa tî yeenu, nî ya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.15",
            "verseOrgIds": [
              "2CH.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rûûjû înameeni bûkarwee nabo. Bagaitîîria njîreene ya Zizi, naabuî bûbatirime mûthieene jwa mûguuru bwa gaiti ya bûûrî ya Jerueli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.16",
            "verseOrgIds": [
              "2CH.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.13+EXO.14.14"
              },
              "items": [
                {
                  "text": "Kum 14.13-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûtîbatara kûrwaa ndwaa îîjî. Bûkaarûngama arîa bûrî bûkirîte ki bwoone MWATHANI akîbûûmbanîra, buî antû ba Juda na Jerusalemu.’ Tigeeni gûkîra kana bûmaka. Rûûjû umagareni bûkarwee nabo, na MWATHANI akeethîrwa arî amwe naabuî.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.17",
            "verseOrgIds": [
              "2CH.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Jehoshafati areenîka mûtwe aratiirithia ûthiû bwaawe nthi, na kinya antû ba Juda bonthe na atûûri ba Jerusalemu nî baairingîre nthî mbere MWATHANI, bakîmûthaathagia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.18",
            "verseOrgIds": [
              "2CH.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Alawi ba mwîrîga jwa Kohathi na jwa Kora bararûngama barakumia MWATHANI Mûrungu wa Israeli na kajû gaakanene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.19",
            "verseOrgIds": [
              "2CH.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rûûneene barookîîra rûkîîrî kainda baraumagara bareeta bûûrîîne ya Tekoa. Rîrîa baaumagaraga Jehoshafati nî aarûngamîre na arauga, “Nthikîîreeni buî antû ba Juda na atûûri ba Jerusalemu! Îtîkieni MWATHANI Mûrungu weenu, nawe agaatûma bwirikîrie. Îtîkieni iroria biaawe, naabuî bûkoona ûûmbani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.20",
            "verseOrgIds": [
              "2CH.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aracoka araireba na atongeeria, arathuura antû ba kwinîra MWATHANI bakîmûkumagia na ndwîmbo, beetîte barî mbere ya njûûrî. Nabo bainaga ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.21",
            "verseOrgIds": [
              "2CH.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.23",
            "verseOrgIds": [
              "2CH.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa antû ba Juda baakinyîre mûnaareene jwa akaria rwanda, nî baategîre ndeerîa njûûrî îîu ya maitha yaarî, baroona nî biimba akî bianyaganîte nthîgûrû. Gûtî noo ûmwe waatigeere arî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.24",
            "verseOrgIds": [
              "2CH.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati na antû baawe nî beetîre gûtaa into kîrî bo, nabo bareethîra ng'ombe inyiingî mono, na into, na nguû, na into bia goro, barabikamata mwanka birarema. Baathirîrie ntukû ithatû bagîkamataga into biu nî ûrîa biaingîîte. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.25",
            "verseOrgIds": [
              "2CH.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû ya inya baroothûrana mûuro jwa Beraka baratharimîra MWATHANI nao. Tontû bûû, mûuro jûu jwîtagwa Mûuro jwa Beraka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20.26",
              "type": "text"
            },
            {
              "text": "Mûuro jwa Beraka:",
              "type": "text"
            },
            {
              "text": "nî kuuga Kîtharimo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwanka naarua. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.26",
            "verseOrgIds": [
              "2CH.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu antû bau bonthe ba Juda na Jerusalemu baracoka Jerusalemu batongeeretue nî Jehoshafati bagwîrîtue, nîûntû MWATHANI nî aaboombanîrîte kîrî anthû baao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.27",
            "verseOrgIds": [
              "2CH.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo baracoka Jerusalemu bakîringaga inanda na wandîîndî na tarumbeta bareeta kîûrûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.28",
            "verseOrgIds": [
              "2CH.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo moonene ja nthîgûrû cionthe jarakîra Mûrungu rîrîa baigîrue atî MWATHANI nî aarwîte na anthû ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.29",
            "verseOrgIds": [
              "2CH.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, nthîgûrû îrîa Jehoshafati aathaga nî yaakarîre îrî na ûkiri nîûntû Mûrungu waawe nî aamweete thîîrî nteere cionthe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mûthia jwa waathani bwa Jehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu nîu Jehoshafati aathanîre Juda. Aarî na ûkûrû bwa mîaka mîrongo îthatû na îtaano rîrîa aambîrîîrie kwaathana, na araathana mîaka mîrongo îîrî na îtaano arî Jerusalemu. Ng'ina eetagwa Azuba, mwarî wa Shilihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathingatîre ngerekano ya îthe Asa atîkûmîebera, arathithia mantû ja kûgwîria MWATHANI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî iritiro bia igongwana bia tûrîma bitoomba kwebeerua, nîûntû antû bataarî bagûcokeera Mûrungu wa biûjûjû biaao na nkoro ciaao.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mantû jangî jonthe jarîa Jehoshafati aathithîrie, kuuma bwa mbere mwanka bwa mûthia jaandîki rûgonoone rwa Jehu, mûtaana wa Hanani rûrîa rûrî yukuune rîa anene ba Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoshafati mûnene wa Juda nî aathithîrie ngwatanîro na mûnene Ahazia wa Israeli, ûrîa wathithagia mantû jamathûûku mono. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagwatanîîre nîkenda bathithia meri cia gwîta Tarishishi, nabo baacithithagîria Ezioni-geberi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Eliezeri mûtaana wa Dodarahu wa ntûûra ya Maresha nî aarorerie Jehoshafati mantû jamaaî aramwîra, “Tontû bwa kûgwatanîra na Ahazia, MWATHANI akaathûkangia birîa bûthithîtie.” Nacio meri irathûûkanga iraremwa nî gûkinya Tarishishi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
    }
