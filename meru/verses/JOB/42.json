          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubu nî acokerie MWATHANI aramwîra atîrî,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mantû ja Mûthia ja yuku rîrî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuma ya MWATHANI kwarîria Ayubu nteto iu, MWATHANI nî aacokere areeta Elifazi ûrîa wa kuuma Temani na aramwîra atîrî, “Ûûgwe na acoore baaku bobaîrî nî bûnthûûrîîtie mono. Nîkwîthîrwa buî gûtî mantû ja mma bwarîîtie jarîa jambegiî tiga jarîa jaarîîtue nî nthûûmba yaakwa Ayubu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî îteeni kîrî nthûûmba yaakwa Ayubu abûrombere, naabuî bûrite kîgongwana gîa gwakîîria kîa ndeegwa mûgwanja na ntûrûme mûgwanja nîûntû bwa meeyia jeenu. Naani nkaigua îromba rîaawe ntîkeeje kûbûkanûkia kûringana na waa bweenu. Nîkwîthîrwa gûtî mantû ja mma bwarîîtie jarîa jambegiî tiga jarîa jaarîîtue nî nthûûmba yaakwa Ayubu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Elifazi ûrîa wa kuuma Temani na Bilidadi wa kuuma Shua na Zofari wa kuuma Naama nî beetîre barathithia ûrîa MWATHANI aabeerîte. MWATHANI araigua maromba ja Ayubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 42:10"
          },
          "items": [
