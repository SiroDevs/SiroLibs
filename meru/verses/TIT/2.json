        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû Mûrungu nî aguûrîte ûtugi bwaawe bwa kwonokia kîrîndî kîonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtugi bûu bûtûritanaga gûtigana na mîtûrîre îmîthûûku na mairîrîîria jamaaî ja nthîgûrû na gûtûûra ûtûûro bûbwega na bûbwagîîru na bwa gûkîra Mûrungu nthîgûrûûne îîjî, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tweteerete Ntukû îu ntharime îrîa twîrîgagîîra, rîrîa ûkumio bwa Mûrungu weetû Ûmûnene tawe Mwonokia weetû Jesû Kristû îgakinya. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
