            "verseId": "2SA.1.1",
            "verseOrgIds": [
              "2SA.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
