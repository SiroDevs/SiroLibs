              "items": [
                {
                  "text": "2Sam 3.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abusalomu aramatûka areeta kîrî Talimai mûtaana wa Amihudi mûnene wa Geshuri. Daudi nawe araithikîîra kagiita gakaraaja nîûntû bwa gûkua kwa mûtaana waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Abusalomu akûmatûka eeta Geshuri arakara ku mîaka îthatû. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene Daudi akûthiria kwithikîîra nîûntû bwa gîkuu kîa Amunoni, arambîrîria kwenda kwoona mûtaana waawe Abusalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
