          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.26",
            "verseOrgIds": [
              "2SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joabu aramûcokeria atîrî, “Nî ngûciîtia na MWATHANI ûrîa ûtwîîre mwoyo atî, këethîra tîka waaria, asikarî baakwa barîngî kwîngana naabuî mwanka rûûjû rûkîîrî.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.27",
            "verseOrgIds": [
              "2SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, Joabu araringa tarumbeta, na asikarî baawe bonthe bararûngama na baratiga kwîngana na Aisraeli kaîrî, ndwaa îrathira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.28",
            "verseOrgIds": [
              "2SA.2.28"
            ]
          }
        }
      ]
    },
