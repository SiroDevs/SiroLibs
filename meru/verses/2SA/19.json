        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.28",
            "verseOrgIds": [
              "2SA.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene aramûcokeria atîrî, “Ûkáuga ûntû bûngî. Nî ngitîte atî ûgwe na Ziba bûgaane kîthaka kîa Saûlû.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.29",
            "verseOrgIds": [
              "2SA.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshethi aramwîra, “Ziba nî ajûkie kîonthe, tontû gûcoka kwa mûnene arî thîîria nî bûng'anîte.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.30",
            "verseOrgIds": [
              "2SA.19.30"
            ]
          }
        }
      ]
    },
    {
