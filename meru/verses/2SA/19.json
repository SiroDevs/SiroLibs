              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene araciîtîria Shimei aramwîra, “Ndîkwîra na mma ûtîûragwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.23",
            "verseOrgIds": [
