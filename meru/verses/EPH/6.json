        },
        {
          "text": "Ndîmûtûma kîrî buî nîkenda akabûmenyithia mantû jeetû na nîkenda abwîkîra inya nkoroone cieenu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
