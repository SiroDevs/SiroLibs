      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia mûtaana wa Amazia aaere mûnene wa Juda mwakeene jwa mîrongo îîrî na mûgwanja jwa waathani bwa Jeroboamu wa baîrî mûnene wa Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia aambîrîîrie kwaathana arî na ûkûrû bwa mîaka îkûmi na îtantatû. Aathanîre arî Jerusalemu mîaka mîrongo îtaano na îîrî. Ng'ina eetagwa Jekolia, na aarî wa kuuma ntûûra ya Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia nî aathithîrie mantû jameega mbere ya MWATHANI, o ta ûrîa îthe Amazia aathithagia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî gûntû kûrîa mîrungu ya Baali yaathaathagîrua gûtaathûûkangua. Antû noo beetîre na mbere kûrîtîra igongwana ku na kwîthîria ubaani nao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aatûmîre mûnene agwaatwa nî mûrimo jwa mûtigiri, na aratûûra naju mwanka rîrîa aakuîre. Ningî aakaraga nyomba yaawe wenka. Jothamu, mûtaana wa mûnene, nîwe watongagîîria nja ya îthe na nîwe wathaga nthîgûrû ya Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mantû jangî jonthe jarîa mûnene Uzia aathithîrie nî jaandîki yukuune rîa ngono cia anene ba Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.1"
              },
              "items": [
                {
                  "text": "Isa 6.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uzia nî aakuîre, arathikwa mbîrîreene cia anene ntûûreene ya Daudi. Mûtaana waawe Jothamu, araa mûnene",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
