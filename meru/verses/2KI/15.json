          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûtongeeria wa njûûrî ya Pekahia tawe Peka mûtaana wa Remalia barî na antû mîrongo îtaano ba kuuma mwîrîgeene jwa Gileadi nî baakunyanîîre mûnene, baramûûragîra giitiiroone kîa gîkaro kîa mûnene, kûu ntûûreene ya Samaria. Nawe Peka araa mûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mantû jangî jonthe jarîa Pekahia aathithîrie nî jaandîki yukuune rîa ngono cia anene ba Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
