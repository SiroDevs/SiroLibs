          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaria mûtaana wa Jeroboamu wa baîrî aambîrîîrie kwaathana Israeli mwakeene jwa mîrongo îthatû na înaana jwa waathani bwa Uzia mûnene wa Juda. Aathanîre arî ntûûreene ya Samaria mîeri îtaantatû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie mantû jamathûûku mbere ya MWATHANI, o ta biûjûjû biaawe. Ataatiganîre na meeyia jarîa Jeroboamu mûtaana wa Nebati aathithîtie jarîa jaatûmîre Israeli îtonya meeyiene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu mûtaana wa Jabeshi nî aakunyanîîre mûnene Zekaria na aramûûragîra ntûûreene ya Ibleamu, araa mûnene ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo mantû jangî jarîa mûnene Zekaria aathithîrie nî jaandîki yukuune rîa ngono cia anene ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
