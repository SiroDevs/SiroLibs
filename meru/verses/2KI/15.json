              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peka mûtaana Remalia aaere mûnene wa Israeli mwakeene jwa mîrongo îtaano na îîrî jwa waathani bwa Uzia mûnene wa Juda. Peka aathanîre mîaka mîrongo îîrî arî ntûûreene ya Samaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie mantû jamathûûku mbere ya MWATHANI, na ataatiganîre na meeyia jarîa Jeroboamu mûtaana wa Nebati aathithîtie jarîa jaatûmîre Israeli itonya meeyiene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.28",
            "verseOrgIds": [
              "2KI.15.28"
            ]
          }
        }
      ]
