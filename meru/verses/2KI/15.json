              "items": [
                {
                  "text": "2Ane 10.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, wîrane bwa MWATHANI bûrîa eerîte Jehu atî, “Nchiarwa ciaaku îkaathana ndeene ya Israeli mwanka nthukî ya inya,” bûroojûra.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
