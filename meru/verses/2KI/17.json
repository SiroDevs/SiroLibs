      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshea mûtaana wa Ela aaere mûnene wa Israeli mwakeene jwa îkûmi na îîrî jwa waathani bwa Ahazi mûnene wa Juda. Hoshea aathanîre arî ntûûreene ya Samaria mîaka kenda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aathithîrie mantû jamathûûku mbere ya MWATHANI, îndî tî jamathûûku nkûrûki ya jarîa anene ba Israeli barîa baarî mbere yaawe baathithagia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalimaneseri mûnene wa Asîria nî aaithûkîîre nthîgûrû ya Israeli, na mûnene Hoshea arainenkanîra kîrî we. Mûnene Hoshea arambîrîîria kûritagîra mûnene wa Asîria ûgoti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî mûnene wa Asîria nî aatigîre gwîtîkia Hoshea, nîûntû Hoshea nî aarî agûtûma atûmwa kîrî So, mûnene wa Misri, akîmûrombaga ûteethio na nî aarî agûtiga kûritagîra mûnene wa Asîria ûgoti bûrîa aamûritagîra o mwaka o mwaka. Tontû bûû, mûnene wa Asîria aramûgwata, aramûtheeka ncheera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kûûmbwa gwa Samaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûnene wa Asîria aracoka araithûkîra nthîgûrû ya Israeli yonthe arakinya ntûûra ya Samaria, na aramîcîgîîria îgiita rîa mîaka îthatû. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakeene jwa kenda jwa waathani bwa mûnene Hoshea nîrîo Shalimaneseri mûnene wa Asîria aataîre ntûûra ya Samaria. Arathaamia antû ba Israeli arabaikia nthîgûrû ya Asîria; araikia bamwe ntûûreene ya Hala, na bangî arabaikia akuî na mûuro jwa Habori nthîgûrûûne ya Gozani, na bangî arabaikia ntûûreene ingî cia Media.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwaakarîre ûu nîûntû bwa ûrîa antû ba Israeli beeîîrie MWATHANI Mûrungu waao, ûrîa waabaritîre nthîgûrû ya Misri kuuma waathoone bwa Farao mûnene wa Misri. Ningî nî baathaathaîrie mîrungu îngî, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na barathingata nkuagaya cia antû ba mîgongo îrîa MWATHANI eengîre nîkenda antû ba Israeli baigwatîra kûu, na nî baathingatîre mîîtîre îmîthûûku îrîa booneetue nî anene ba Israeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû ba Israeli nî baathithagia mantû na witho jatîagîrîte kîrî MWATHANI Mûrungu waao. Nî baaciakîrîte irombero bia mîrungu ya mîng'uanano ntûûreene ciaao cionthe, kuuma irîa nini mwanka irîa nene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1Ane 14.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî nî beekîre itugî bia mîrungu ya mîng'uanano ya Baali na Ashera kûrîa kunthe baarombagîra na rungu rwa mîtî îrîa îriibîte yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Aisraeli nî baaîthagîîria ubaani gûntû kûu kunthe o ta ûrîa antû ba mîgongo îrîa MWATHANI aabeengîîre baathithagia. Nabo nî baathithîrie mantû jamathûûku jaratûma MWATHANI athûûra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nî baathaathayia mîrungu ya mîng'uanano îrîa MWATHANI aabakaanîtie batîkamîthaathagie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî MWATHANI nî aakaanîtie antû ba Israeli na ba Juda na njîra ya iroria birîa bionthe aatûmîte akiugaga atîrî, “Garûkeeni bûtigane na mîîtîre yeenu îmîthûûku, bwathîkagîre maathana jaakwa na mawaatho jaakwa, kûringana na ûrîa ndeerîre biûjûjû bieenu na njîra ya nthûûmba ciaakwa, iroria.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî bo nî baaregere kwathîka, baroomia nkoro ciaao o ta ûrîa beethe baathithagia barîa baaregere kwathîkîra MWATHANI Mûrungu waao. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî baareganîre na mawaatho jaawe na kîrîkanîro kîrîa MWATHANI aathithîtie na beethe. Ningî nî baareganîre na nkuagaya cia MWATHANI barathingata mîrungu ya mîng'uanano na baraa ba ûtheri. Baathingataga mîtûûrîre ya antû ba mîgongo îrîa yaabathiûrûkîrîte, o îrîa MWATHANI aabakaanîtie batîkathithagie ta yo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1Ane 12.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bararega kwathîkîra maathana ja MWATHANI Mûrungu waao na baracoka baraithithîria mîrungu ya mîng'uanano ya njaû ijîîrî cia chuuma, na mûrungu jwa mûka jweetagwa Ashera. Ningî baracoka barathaathayia njota cionthe cia îgûrû na barathaathayia kinya Baali mûrungu jwa mûng'uanano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10"
              },
              "items": [
                {
                  "text": "Kûr 18.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî nî baaritaga aana baao barî igongwana bia gwakîîria. Baracoka baratua kûroragîrua na kûrîngagîrua baracieejana buru kûthithagia mantû jamathûûku mbere ya MWATHANI mwanka arathûûra nîbo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, MWATHANI nî aathûûrîre mono nîûntû bwa antû ba Israeli mwanka arabeenga barauma kîrî we. Gûtî bo baatigarîre tiga antû ba mwîrîga jwa Juda bonka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
