          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî kinya antû ba Juda batoombîre kûmenyeera maathana ja MWATHANI Mûrungu waao. Bo nî beetîre na mbere kûthingata mîîtîre ya antû ba Israeli îrîa baarî bakwambîrîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aaregere nchiarwa cionthe cia Israeli arabakanûkia na arabanenkanîra kîrî anthû mwanka aratûma beebua bauma kîrî we.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa MWATHANI aatûmîre Israeli yaathûkana na Juda, Israeli nî yaathuurîre Jeroboamu mûtaana wa Nebati aa mûnene waayo. Jeroboamu nî aatûmîre Israeli îtiga kûthingata MWATHANI îraambîrîîria kûthithia meeyia jamanene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba Israeli nî beetîre na mbere kûthithia meeyia jarîa jonthe Jeroboamu aathithagia batigûtigana najo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwanka rîrîa MWATHANI aatûmîre beebua bauma kîrî we, O ta ûrîa nthûûmba ciaawe iroria ciaugaga ûrîa aabeerîte. Tontû bûû, antû ba Israeli nî baathaamîrue baraikua kîthamîrioone nthîgûrûûne ya Asîria na nîku barî mwanka naarua tûrî.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû ba Asîria gûtûûra nthîgûrû ya Israeli",
          "type": "text"
        }
      ]
    },
    {
