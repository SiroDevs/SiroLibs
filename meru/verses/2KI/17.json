                  "text": "Kûr 5.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî eekîre kîrîkanîro na antû ba Israeli arabeera atîrî, “Bûkáthaathayia mîrungu îngî, kana bûmîritîra igongwana kana bûmîtumîkîra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
