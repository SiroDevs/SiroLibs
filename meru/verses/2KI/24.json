            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiiteene rîu, atongeeria ba njûûrî ba Nebukadineza mûnene wa Babiloni nî beetîre kwithûkîra Jerusalemu na baramîcîgîîria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza mûnene wa Babiloni nî eetîre Jerusalemu îgiita o rîu atongeeria ba njûûrî yaawe baamîcîgîîrîîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
