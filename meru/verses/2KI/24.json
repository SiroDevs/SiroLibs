        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
