            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.1+JER.29.2"
              },
              "items": [
                {
                  "text": "29.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nebukadineza mûnene wa Babiloni nî aajûkîrie antû baba arabaeethia atae: Jehoiakini mûnene wa Juda, ng'ina wa Jehoiakini, na ataana ba Jehoiakini na atongeeria baawe ba njûûrî na barîa baamenyagîîra gîkaro kîa mûnene. Mûnene Nebukadineza aabajûkîrie barî atae mwakeene jwa înaana kuuma akwambîrîria kwaathana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        }
