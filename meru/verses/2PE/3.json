          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî buî acoore baakwa tontû bwa ûrîa bûthirîtie kûmenya ûntû bûu, imenyagîîreni mono bûtîkeeje gwaatithua njîra nî ndemi na bûremwa nî gûciaanda bwega. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.17",
            "verseOrgIds": [
              "2PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî îteni na mbere bûgîkûraga ndeene ya ûtugi na ûmenyo bwa Mwathani na Mwonokia weetû Jesû Kristû. Ûkumio nî kîrî we nandî na kenya na kenya! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.18",
            "verseOrgIds": [
              "2PE.3.18"
            ]
          }
        }
      ]
    }
