            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.1"
              },
              "items": [
                {
                  "text": "Kûg 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî tuî tûtûûraga twetereete Mûrungu oojûria wîrane bûrîa atweere; nabu nî Îgûrû rîrîeru na nthîgûrû înjerû kûrîa gûtûûraga waagîru.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.13",
            "verseOrgIds": [
              "2PE.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
