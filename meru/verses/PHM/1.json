                  "text": "4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûgûkeethua nî Epafarasi, ûrîa ûtheeki ncheera amwe naani nîûntû bwa Kristû Jesû. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
