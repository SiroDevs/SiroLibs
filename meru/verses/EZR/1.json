          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.10",
            "verseOrgIds": [
              "EZR.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Into bionthe bia thaabu na fetha biaarî ngiri ithaano, na magana jana (5,400).",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Into biu bionthe biaikîrue Jerusalemu nî Sheshibazari, rîrîa atae baacokere kuuma Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
