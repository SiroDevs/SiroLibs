                  "text": "Zek 4.6-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîrîo Zerubabeli mûtaana wa Shealitieli na Jeshua mûtaana wa Jozadaki, baambîrîîrie gwaka nyomba ya Mûrungu kaîrî, îrîa îrî Jerusalemu. Ningî nî baarî na iroria bia Mûrungu bikîbateethagia ngûgî.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
