          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrî nchiarwa cia Bebai, kûrooneka Jehohanani, na Hanania, na Zabai, na Athilai. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.28",
