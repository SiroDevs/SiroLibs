          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrî nchiarwa cia Zatu, kûrooneka Elioenai, na Eliashibu na Matania, na Jeremothi, na Zabadi, na Aziza. ",
          "type": "text",
          "attrs": {
