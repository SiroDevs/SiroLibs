          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîrî aini, kûrooneka Eliashibu. Kuuma kîrî akaria mpingîro kûrooneka Shalumu, na Telemu, na Uri.",
          "type": "text",
          "attrs": {
