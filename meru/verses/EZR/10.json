          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma kîrî nchiarwa cia Elamu, kûrooneka Matania, na Zekaria, na Jehieli, na Abudi, na Jeremothi, na Elija. ",
          "type": "text",
          "attrs": {
