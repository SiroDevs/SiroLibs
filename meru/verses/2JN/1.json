                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Joh 13.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "15.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nandî îgwe mwekûrû ûmwende, ndîkwaandîkîra ngîkûûragia twendanage. Rîu narîo tî rîathana rîrîerû ngûkwaandîkîra, îndî no rîrîa tûtwîre narîo kuuma kîambîrîria atî twendanage. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.5",
            "verseOrgIds": [
              "2JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendo bûu nabu nî atî tûtue kwathîkagîra maathana. Rîathana o rîrîa twaeerwe kuuma kîambîrîria atî tûtûûrage tûkîendanaga.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.6",
            "verseOrgIds": [
              "2JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aritani babaingî ba ûrongo nî bathirîtie kûnyagania nthîgûrûûne kunthe. Bo batîîtîkagia atî Jesû Kristû nî eejîre nthîgûrûûne arî na mwîrî ta muntû. Muntû ûrîa uugaga ûu nî mwaîîrania na nî mûnthû wa Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.7",
            "verseOrgIds": [
              "2JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, imenyagîîreni bûtîkeeje kwaga kîrîa bûtwîre kûthangîkîra nîkenda bweewa îtuui rîrîûjûru buru. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.8",
            "verseOrgIds": [
              "2JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O muntû ûrîa ûtîthingataga ûritani bwa Kristû na akauma oome yaabu, atî na Mûrungu. Îndî ûrîa ûrûmagîrîra mooritani jau, arî na ngwatanîro na Baaba na Mûtaana waawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.9",
            "verseOrgIds": [
              "2JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, muntû akëeja kwîja kîrî buî ûtîkûritana ûritani bûbû, bûkámûgwateeni ûgeni nyomba cieenu na kinya kûmûkeethia bûkamûkeethia. ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.10",
            "verseOrgIds": [
              "2JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû ûrîa ûkamûkeethia nî agwatanîrîte nawe ngûgîîne îîu yaawe înthûûku.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.11",
            "verseOrgIds": [
              "2JN.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nteto cia mûthia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
