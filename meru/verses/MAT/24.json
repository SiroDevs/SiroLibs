              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Kûg 6.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Îgiita rîa mîthangîko rîathîra o rîo, riûa rîkaaga weerû kûgîe muundu, na mweri jûtige kûthaara na njota igwe kuuma îgûrû, na bingî birîa bikaraga îgûrû biinainue. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.29",
            "verseOrgIds": [
              "MAT.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Dan 7.13",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10+ZEC.12.11+ZEC.12.12+ZEC.12.13+ZEC.12.14"
              },
              "items": [
                {
                  "text": "Zek 12.10-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Kûg 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu nîrîo rwano rwa Mûtaana wa Muntû rûkoonekana îgûrû, na antû bonthe ba nthîgûrû bakaithikîîra rîrîa bakoona Mûtaana wa Muntû enamîte arî îgûrû rîa matu, arî na inya na mwago jûmûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.30",
            "verseOrgIds": [
              "MAT.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tarumbeta îkaringwa îgambe na kajû gakanene na atûme araîka baawe boothûranie antû bonthe barîa Mûrungu athuurîte kuuma nthîgûrûûne yonthe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûritani kuumania na mûkûû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîu iritaneeni kuuma kîrî mûkûû: O rîrîa mpang'i ciaaju ciambagîîria kûtheûka, na mabûûra jakambîrîria kûriiba nî bûmenyaga atî, thano îrî akuî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ûu naabuî rîrîa bûkoona mantû jaja jonthe jakarîka, bûmenye atî Mûtaana wa Muntû arî akuî mono. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîbwîra na mma atî, nthukî îîjî yonthe îtîthira mantû jaja jonthe jatîrakarîka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgûrû na nthî bikathira, îndî nteto ciaakwa igatûûra kenya na kenya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûtî muntû wiijî ntukû kana thaa irîa Mûtaana wa Muntû akeeja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gûtî muntû wiijî ntukû kana thaa irîa mantû jaja jagakarîka. Araîka na kinya Mûtaana batiijî îndî nî Baaba wenka wiijî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.6.5+GEN.6.6+GEN.6.7+GEN.6.8"
              },
              "items": [
                {
                  "text": "Kîam 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Mûtaana wa Muntû akeeja gûkeethîrwa gûkari ta ûrîa gwakari îgiita rîa Noa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere ya ngai ya maburiko yuura, antû nî barîîjaga na bakanyua, na bakagûrana na bakagûrwa, mwanka ntukû îrîa Noa aakûrûkîre sabineene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.6+GEN.7.7+GEN.7.8+GEN.7.9+GEN.7.10+GEN.7.11+GEN.7.12+GEN.7.13+GEN.7.14+GEN.7.15+GEN.7.16+GEN.7.17+GEN.7.18+GEN.7.19+GEN.7.20+GEN.7.21+GEN.7.22+GEN.7.23+GEN.7.24"
              },
              "items": [
                {
                  "text": "Kîam 7.6-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Antû batamenyaga jarîa jeetaga na mbere, mwanka rîrîa mûguû jweejîre jûrabakondoria bonthe. O ûu nîu gûgakara rîrîa Mûtaana wa Muntû akeeja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu antû baîrî bakeethîrwa bakîrîmaga muundeene, ûmwe ajûkûe na ûngî atîgwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka baîrî bakeethîrwa bakîthiaga, ûmwe ajûkûe na ûngî atîgwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, kareni bwithuranîrîte, nîûntû bûtiijî ntukû îrîa Mwathani weenu agacoka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39+LUK.12.40"
              },
              "items": [
                {
                  "text": "Luk 12.39-40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî menyeni atî, këethîra mwene nyomba nî ethagîrwa akîmenyaga thaa irîa mwamba akeeja, atîmama, na atîrekeeria mwamba auna nyomba yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, kinya buî kareni bwithuranîrîte nîkwîthîrwa Mûtaana wa Muntû akeeja thaa irîa bûtîmwîrîgîrîte.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nthûûmba îrîa mbîtîkua na îrîa îtî mbîtîkua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû areeta na mbere kûbeera, “Nthûûmba îrîa mbîtîkua na înjûme nî îrîkû? Nî îrîa mûnene waayo aethetie mûrûngamîîri wa bangî, abaejage biakûrîa îgiita rîrîa rîagîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kûgwîrua nî kîrî nthûûmba îîu, këethîra mwathi waayo rîrîa agacoka, akamîîthîra îkîritaga ngûgî o îîu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîbwîra na mma atî akaethia nthûûmba îîu mûrûngamîîri wa into biaawe bionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nthûûmba îîu îkëethîrwa îrî îmbîî, îgacîîra yongwa atî, ‘Mwathi waakwa agakara îgiita rîrîraja atîracoka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu akaambîrîria kûûra nthûûmba irîa arûngamîrîte, na akaambîrîria kûrîa na kûnyua arî amwe na oogiti bangî. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwathi waayo akeeja ntukû na thaa irîa îtîmwîrîgîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwathi ûu akamîkanûkia bûbûuî, na amîgere kûrîa aciayia bakeethîrwa barî. Kûu bagakaraga bakîrîraga na gûkabakaba maîgo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.51",
            "verseOrgIds": [
              "MAT.24.51"
            ]
          }
        }
      ]
    }
