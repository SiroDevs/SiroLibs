                "loc": "LUK.17.23+LUK.17.24"
              },
              "items": [
                {
                  "text": "Luk 17.23-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, bakëeja kûbwîra, ‘Mesia, arî rwanda,’ bûgeteni nao; ningî bakëeja kûbwîra ‘Arî nyomba cia ndeene,’ bûgéetîkia ûntû bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.26",
            "verseOrgIds": [
              "MAT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa Mûtaana wa Muntû akeeja oonewe kunthe o ntûti, o ta ûrîa rweni rwenagîria bwa gaiti, na o ntûti rûkoonerwa bwa rûgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.27",
            "verseOrgIds": [
              "MAT.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.37"
              },
              "items": [
                {
                  "text": "Luk 17.37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Arîa kiimba kîrî, nîo nderi ciûthûranaga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.28",
            "verseOrgIds": [
              "MAT.24.28"
            ]
          }
        }
