{
  "id": "MAT.1",
  "number": "1",
  "bookId": "MAT",
  "reference": "Mat 1",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "MAT 1"
      },
      "items": [
        {
          "text": "1",
