          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngai îraura, na nyomba îîu îrariingwa nî mûguû na ruuo rûrûnene, îndî îtaagwîre nîûntû nî yaaki iigeene.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        }
