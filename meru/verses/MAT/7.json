              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îndî o muntû ûrîa wigagua nteto iji ciaakwa na akarega kûthithia ûrîa ciugîte, akari ta muntû kîaa ûrîa waakîre nyomba yaawe mûthangeene. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
