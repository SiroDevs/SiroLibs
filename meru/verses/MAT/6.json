              "items": [
                {
                  "text": "Mar 11.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Tontû bûkëethîra nî bûrekagîra antû maatia jaao, Abaagu ûrîa ûrî îgûrû akabûrekera. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.14",
            "verseOrgIds": [
              "MAT.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî bûkëethîra bûtîrekagîra antû bangî maatia jaao, kinya Abaagu atîbûrekera maatia jeenu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûritani bwegiî gûciata biakûrîa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.15",
            "verseOrgIds": [
              "MAT.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rîrîa bûciatîte biakûrîa bûgatukieni moothiû jeenu ta aciayia. Nîkwîthîrwa batukagia moothiû jaao nîkenda antû boona atî nî baciatîte biakûrîa. Ndîbwîra na mma atî nî bathirîtie kûewa îtuui rîaao. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.16",
            "verseOrgIds": [
              "MAT.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî rîrîa gwe ûciatîte biakûrîa, thaambia ûthiû bwaaku na waake mûtwe jwaaku maguta, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.17",
            "verseOrgIds": [
              "MAT.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîkenda antû batîkameenye atî nî ûciatîte biakûrîa îndî ûmenyekane atî nî ûciatîte nî Abaagu ûrîa ûrî withoone wenka. Nawe Abaagu ûu wonaga jarîa jarî withoone agakwaa îtuui.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.18",
            "verseOrgIds": [
              "MAT.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûritani bwegiî gwîka ûtonga îgûrû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
