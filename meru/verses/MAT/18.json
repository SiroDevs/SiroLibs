        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.19"
              },
              "items": [
                {
                  "text": "Mat 16.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Joh 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ndîbwîra na mma atî kîrîa bûkaregana nakîo aja nthîgûrû gîtîtîkîîrua îgûrû, na kîrîa bûgetîkîîria aja nthîgûrû gîgetîkîîrua îgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ndîbwîra atî antû baîrî bakëeja gwîtîkanîîria barombere ûntû kinya bûrîkû aja nthîgûrû, Baaba ûrîa ûrî îgûrû akabathithîria ûntû bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.19",
            "verseOrgIds": [
              "MAT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa arîa antû baîrî kana bathatû boothûranaga nîûntû bwa riîtwa rîaakwa nî mbîthagîrwa ndî amwe nabo.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.20",
            "verseOrgIds": [
              "MAT.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngerekano ya kûritana ûrîa muntû abuîri kûrekera ûngî",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
