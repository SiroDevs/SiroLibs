        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa mûnene nkûrûki ya bangî Ûneneene bwa Îgûrû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
