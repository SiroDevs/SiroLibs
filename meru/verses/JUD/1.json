              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî buî, eendwa baakwa, ririkaneni mantû jarîa atûmwa ba Mwathani weetû Jesû Kristû baabwîrîre. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.17",
            "verseOrgIds": [
              "JUD.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
