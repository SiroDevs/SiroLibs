              ]
            }
          ]
        },
        {
          "text": " Enoki, tawe ûrîa waatwîre nthukî ya mûgwanja kuuma îgiita rîa Adamu, nî aarorerie na arauga,",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.14",
            "verseOrgIds": [
              "JUD.1.14"
            ]
          }
        }
