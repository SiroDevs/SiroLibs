              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû baba bakaraga bakînung'unaga magiita jonthe na batiigagua bang'anîri; baathagwa nî mairîrîîria jaao jamathûûku. Bo baikumagia mono na bagakathîrîria antû bangî mono bakîenda kûgunîka.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.16",
            "verseOrgIds": [
              "JUD.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Karageni bûrî eetîkua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
