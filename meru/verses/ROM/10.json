                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Ala 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Musa aandîkîre arauga atî muntû ûrîa ûrî ûmwagîru nîûntû bwa kûthingata Waatho agatûûrua nîbu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.12+DEU.30.13+DEU.30.14"
              },
              "items": [
                {
                  "text": "Kûr 30.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî muntû ûrîa ûrî ûmwagîru nîûntû bwa gwîtîkia, akáuga ûjû nkoroone yaawe, “Nûû ûgaitia îgûrû?” (Kuuga ûu nî Kristû akûringa nthî). ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî akória, “Nûû ûkenama kûrîa akuû barî?” (Kuuga ûu nî kûriûkia Kristû kuuma kîrî akuû). ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Maandîko jariuga ûjû, “Rûteto rwa Mûrungu rûrî akuî naagwe, na rûrî kanyueene gaaku, na rûrî nkoroone yaaku.” Rûu nîru tûtûmagîîria nîkenda muntû eetîkia; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nîûntû ûkëeja kuumbûra na kanyua gaaku atî Jesû nîwe Mwathani, na ûgeetîkia na nkoro yaaku atî Mûrungu nî aamûriûkîrie kuuma gîkuûne, ûkoonoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.9",
            "verseOrgIds": [
              "ROM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa muntû eetîkagia na nkoro yaawe na akaethua ûmwagîru na akaumbûra na kanyua kaawe na akoonoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.10",
            "verseOrgIds": [
              "ROM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Isa 28.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maandîko jariuga, “Muntû wonthe ûrîa wîtîkagia Mûrungu, atîkorocokerwa nî nthao.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûntû bûu nî bwa antû bonthe nîûntû kîrî Mûrungu gûtî Mûyahudi kana ûrîa ûtî Mûyahudi. Mûrungu nî Mwathani wa antû bonthe na nî atharimaga na itharimo bibingî bonthe barîa bamûkaagaîra. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.12",
            "verseOrgIds": [
              "ROM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.32"
              },
              "items": [
                {
                  "text": "Joe 2.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O ta ûrîa Maandîko jakuuga, “O muntû wonthe ûrîa ûgakaîra riîtwa rîa Mwathani akoonoka.”",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
