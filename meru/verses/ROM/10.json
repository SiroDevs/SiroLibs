              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nîatîa antû bakoomba gûkaîra Mwathani ûrîa batîtîkîtie? Ningî bageetîkia atîa këethîra gûtî rîo baigua agîtûmîîrua? Ningî bakaigua atîa këethîra gûtî mûtûmîîria wa kûbeera? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Isa 52.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîatîa antû bakoomba gûtûmîîria batîtûmi? O ta ûrîa kwaandîki, “Kwîja kwa antû barîa batûmîîragia Nteto Injega cia Mûrungu nî kûthongomi mono!” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Isa 53.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî tî antû bonthe beetîkîrie Nteto Injega cia Mûrungu; nîkwîthîrwa Isaya ariûria atîrî, “Mwathani nûû weetîkia ntûmîîri yeetû?” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû wîtîkio buumanagia na kwigua nteto îrîa itûmîragua, nacio nteto iu ciegiî Krîstû ûrîa ûgûtûmîîrua.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        }
      ]
    },
