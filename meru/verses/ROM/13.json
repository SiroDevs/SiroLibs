                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Ala 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa maathana jarîa jaugaga, “Ûkáthûngîîra; Ûkóragana; Ûkáiya; Ûkáirîrîria;” na kinya jangî jonthe jarî ndeene ya Waatho bûbû buugaga, “Endaga muntû ûngî o ta ûrîa ûciendeete gwengwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûkëethîrwa wendeete muntû, ûtîmûthithîria ûntû bûbûthûûku. Tontû bûû, kwendana nîku kûûjûria Waatho bunthe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî bûbuîri kûthithia ûu nîûntû nî bûkûmenya atî rîrî nîrîo îgiita rîeenu rîa gûûkîîra kuuma toroone. Nîkwîthîrwa îgiita rîeetû rîa kwonokua rîrî akuî naatuî nandî nkûrûki ya rîrîa twambîrîrie gwîtîkia. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûtukû bûrî akuî kûthira, na mûthenya nî jwengeerie gûkinya. Tûtigeeni kûthithia mantû jamooru jarîa jathithagîrua muunduune na tûthithagie mantû jameega ta antû barîa batûûraga weerûûne. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûtûreeni na mîîtîre îmîega ta antû ba weerû. Tûtiganeeni na biatho birîa antû bathithagia mantû jamaaî, na wogiti, na ûmaramari na ûmaraya, na kûrwaa tuî twîngwa na kwigîrua bangî rûriitho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî rekeni Mwathani Jesû Kristû aathage ûtûûro bweenu buru na bûkáa mwîrî kaanya ga kûûjûria mairîrîîria jaaju jamaaî.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
        }
      ]
    }
