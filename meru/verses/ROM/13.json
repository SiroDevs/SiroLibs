            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.17+DEU.5.18+DEU.5.19"
              },
              "items": [
                {
                  "text": "Kûr 5.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
