                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nîbo bongwa baathuurîre kûthithia ûntû bûu. Nî mma yaarî ngûgî yaao gûteethia Ayahudi bau nkîa. Nîkwîthîrwa Ayahudi nî bagaanîre itharimo biaao bia kîroho na antû barîa batî Ayahudi, kinya bo nî babuîri kûgaîra Ayahudi itharimo bia into birîa barî nabio. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.27",
            "verseOrgIds": [
              "ROM.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa nkathiria ngûgî îîjî na nenkanîre mbeecha irîa cionthe ikeethîrwa ikûritwa, nîrîo nkabûriûngîra ndî rûgendoone rwaakwa rwa gwîta Spania. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
              "ROM.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî nkûmenya atî rîrîa nkeeja kweenu, nkeeja mbûjûri itharimo bia Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.29",
            "verseOrgIds": [
              "ROM.15.29"
            ]
          }
        }
      ]
    },
