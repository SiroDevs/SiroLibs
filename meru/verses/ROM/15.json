              "ROM.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ataana na aarî ba baaba, ndaabwerenca ndeene ya Mwathani weetû Jesû Kristû na nîûntû bwa wendo bûrîa buumaga kîrî Roho, bûciûmie amwe naani kûndombera kîrî Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.30",
            "verseOrgIds": [
              "ROM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûrombe nîkenda Mûrungu ambonokia kuuma kîrî antû ba Judea barîa batîîtîkîtie na nîkenda kinya ngûgî yaakwa îrîa îmbikîtie Jerusalemu îtîkîîrua nî akristû ba ku. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.31",
            "verseOrgIds": [
              "ROM.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûu, këethîra nî wendi bwa Mûrungu nkeeja kîrî buî ngwîrîtue na nogoke nîûntû bwa gûkarania naabuî. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
              "ROM.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrungu ûrîa ûtweejaga thîîrî arokaraga amwe naabuî bwinthe. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.33",
            "verseOrgIds": [
              "ROM.15.33"
            ]
          }
        }
