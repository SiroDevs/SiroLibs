          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kinya këethîra nî aaringîre biama bibingî mono bakîonaga, baatamwîtîkîrie, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.37",
            "verseOrgIds": [
              "JHN.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Isa 53.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nîkenda nteto irîa kîroria Isaya augîre ciûjûra:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        }
      ]
