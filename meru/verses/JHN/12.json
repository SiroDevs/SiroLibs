          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû akwaria nteto iu, areeta na araiciitha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.36",
            "verseOrgIds": [
              "JHN.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû kwaaga wîtîkio",
          "type": "text"
        }
      ]
    },
    {
