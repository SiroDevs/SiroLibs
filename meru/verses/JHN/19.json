                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "69.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyuma ya jau, Jesû akûmenya atî mantû jonthe jaakûthira na nîkenda Maandîko joojûra arauga, “Ndî na nyoonta.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû au nî kwaarî na mpakûri yoojûri ndibei îrî na nchechû. Tontû bûû, baratombeka kînyaguthi ndibeiine îîu na barakîmuntîîra kîrî kamûti ka mûkuû na baramûrîkîîra mûromoone. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Jesû aacemere ndibei îîu arauga, “Mantû jonthe jakûthira.” Rîu areenîka kîongo bwa nthî na arakua.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesû kûmuntwa mbaru na îtumo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
