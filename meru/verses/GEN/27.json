              "GEN.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebeka aracoka areera Isaaka atîrî, “Ni nandî nî nogeete gûtûûra mwoyo nîûntû bwa aka baba Ahiti. Jakubu akëeja kûgûra mûka ûkari ta Ahiti baba rî, kûrî gîtûmi gîa ntûûra mwoyo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
