          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu areeta mûka waawe Hawa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.20",
              "type": "text"
            },
            {
              "text": "Hawa:",
              "type": "text"
            },
            {
              "text": "nî kuuga “ûtûûro” kana “mwoyo.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " tontû nîwe waarî ng'ina wa barîa bonthe barî mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI Mûrungu aratumîra Adamu na mwekûrû waawe nguû cia mîgûûta arabeekîra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adamu na Hawa kwîngwa muundeene jwa Edeni",
          "type": "text"
        }
      ]
    },
