                  "text": "Maj 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo mpara ya mîaka mûgwanja îraambîrîîria o ta ûrîa Josefu aaugîîte. Naku nî kwagîîre mpara nthîgûrûûne ingî cionthe, îndî kûreethîrwa kûrî na irio bibingî nthîgûrûûne ya Misri yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
