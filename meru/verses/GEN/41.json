          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiro îrîa yaakarîte mîaka mûgwanja nthîgûrûûne ya Misri nî yakinyîre mûthia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.53",
            "verseOrgIds": [
              "GEN.41.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
