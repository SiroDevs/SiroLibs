            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana ba Lea baarî: Rubeni (Ûrîa waarî mwana wa kîranga wa Jakubu) na Simioni na Lawi na Juda na Isakari na Zebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        },
        {
          "name": "verse",
