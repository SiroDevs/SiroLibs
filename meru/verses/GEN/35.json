          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana ba Biliha ûrîa waarî nthûûmba ya Raeli baarî: Dani na Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana ba Zilipa ûrîa waarî nthûûmba ya Lea baarî: Gadi na Asheri. Bau nîbo ataana ba Jakubu barîa baaciarîri Padani-aramu na nîyo Mesopotamia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
