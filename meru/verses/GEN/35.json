          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ataana ba Raeli baarî: Josefu na Benjamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        },
