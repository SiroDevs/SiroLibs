              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana ba Jakubu baarî îkûmi na baîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
