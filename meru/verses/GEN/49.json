              },
              "items": [
                {
                  "text": "Maj 7.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jakubu aathiria kwarîria ataana baawe, araikûnja gîtandeene kîaawe arakua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
