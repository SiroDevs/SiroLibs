              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.3+GEN.23.4+GEN.23.5+GEN.23.6+GEN.23.7+GEN.23.8+GEN.23.9+GEN.23.10+GEN.23.11+GEN.23.12+GEN.23.13+GEN.23.14+GEN.23.15+GEN.23.16+GEN.23.17+GEN.23.18+GEN.23.19+GEN.23.20"
              },
              "items": [
                {
                  "text": "Kîam 23.3-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " gîkurunguune kîrîa kîrî muundeene jûrîa jûrî Maki-pela, bwa gaiti ya Mamure, nthîgûrûûne ya Kanaani. Gîkurungu kîu nîkîo kîrîa Abrahamu aagûranîîrie amwe na muunda jwa Efuroni ûu Mûhiti nîkenda agîa na antû aawe wengwa a kûthikanaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.9+GEN.25.10"
              },
              "items": [
                {
                  "text": "Kîam 25.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.29"
              },
              "items": [
                {
                  "text": "35.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Au nîo Abrahamu na mwekûrû waawe Sara baathikîrwe, na nîo Isaaka na mwekûrû waawe Rebeka baathikîrwe, na nîo ndaathikîre Lea. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munda jûu, amwe na gîkurungu kîu kîrî ku nî kûgûrwa biaagûrîrwe kuuma kîrî Ahiti.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
