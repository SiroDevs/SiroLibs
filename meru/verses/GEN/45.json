              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.13"
              },
              "items": [
                {
                  "text": "Maj 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Josefu nî aaigîrue atîûmba gûciûmia kaîrî arî mbere ya barîa bonthe baarî kîrî we. Arauga na inya atîrî, “Antû bonthe nî baumagarue beebere aja.” Tontû bûû, gûtî muntû waarî o Josefu akiimenyithania kîrî ataana ba ng'ina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nî aarîrîre na kajû gakanene mwanka Amisri baraigua, na kinya antû ba nja ya Farao baraigua. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.2",
            "verseOrgIds": [
              "GEN.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu areera ataana ba ng'ina atîrî, “Nî ni Josefu. Baaba no atwîre mwoyo?” Îndî ataana ba ng'ina batoombîre kûmûcokeria nîûntû bwa kûrigara kûrîa baarigarîre baigua ûu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josefu areera ataana ba ng'ina atîrî, “Îjaîjeeni akuî nandî.” Nabo bareetaîta. Arabeera atîrî, “Nî ni mûtaana wa nyakwe Josefu ûrîa bweenderie Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nandî menyeni bwîja kwigua bûbûûî kana bwigambithia nîûntû bwa kwîthîrwa atî nî bwampenderie naaja. Nî Mûrungu weendere mbîja ndî mbere yeenu nîkenda mbonokia mîoyo ya antû. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî nî mîaka îîrî îthirîte kuuma mpara îkwîja nthîgûrûûne, na nî îtigeere mîaka îngî îtaano îrîa gûtîrîmwa kana gûkethwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûrungu nî aandetere gûkû ndî mbere yeenu nîkenda ntûma bûtigara nthîgûrûûne na mbonokia mîoyo yeenu na njîra ya mwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, tî buî bwandetere gûkû, nî Mûrungu. Ningî Mûrungu nî ampeethetie îthe wa Farao, na mûrûngamîîri wa nja yaawe, na ampeethia mwathi wa nthîgûrû ya Misri yonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Maj 7.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nandî îteni na mpwîî kîrî baaba bûmwîre, ‘Mûtaana waaku Josefu aakwîra atîrî, Mûrungu nî ampeethetie mwathani wa nthîgûrû ya Misri yonthe. Nandî njû kîrî ni naaja, na ûkáthaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûgaatûûra nthîgûrû ya Gosheni, na ûkeethîrwa ûrî akuî naani, ûûgwe na aana baaku, na aana ba aana baaku, na ndîîthia ciaaku cia mbûri na ng'ondu na ng'ombe, na into biaaku bionthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani ngaakûmenyagîîra ûrî nao ûtîkeeje kûrîa thîîna, gwe na nja yaaku na birîa bionthe ûrî nabio, nîûntû mîaka nî îtigeere îngî îtaano ya mpara.’ ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî bûgûcionera, na kinya mûtaana wa chiaa Benjamini agûcionera atî nî ni ndaabwîra ûu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkárega kwîra baaba ûnene bûrîa ndî nabu gûkû Misri na mantû jonthe jarîa bwoneete. Nandî gîîreeni baaba bûmûreete naaja na mpwîî.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu aracoka arakumbatîria mûtaana wa ng'ina Benjamini ararîra. Benjamini kinya we ararîra akumbatîrîîtie Josefu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî aracûnca ataana ba ng'ina bangî bonthe o akîrîraga. Nyuma ya ûu, ataana ba ng'ina baraaranîria nawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Farao na antû ba nja yaawe baamenyere atî ataana ba ng'ina ba Josefu baagûkinya, ûntû bûu nî bwabagwîrîrie mono. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.16",
            "verseOrgIds": [
              "GEN.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao nî eerîre Josefu atîrî, “Îîra ataana ba nyakwe atîrî, nî baîkie ntigiri ciaao mîrigo baambîîrie rûgendo, na baakinya nthîgûrû ya Kanaani rî, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.17",
            "verseOrgIds": [
              "GEN.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bajûkie abaagu na antû ba nja yaawe, beeje kîrî ni. Naani nkaabaa gûntû kûrîa kwega buru gûkû nthîgûrû ya Misri, naabo bakaarîjaga birîa bieega bia nthîgûrû îîjî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.18",
            "verseOrgIds": [
              "GEN.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî beere atîrî, nî bajûkie ngaarî îrîa îkuuragua nî mbarathi kuuma gûkû nthîgûrû ya Misri nîûntû bwa twaana twaao na aka baao, beete bagîîre abaagu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
            "verseOrgIds": [
              "GEN.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûgátinda bûmakîrîte into bingî bieenu nîûntû gûntû kûrîa kwega buru gûkû nthîgûrû ya Misri gûkeethîrwa kûrî kweenu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ataana bau ba Israeli nî baathithîrie o ûu. Josefu nî aabanenkeere ngaarî irîa ikuuragua nî mbarathi kûringana na waatho bwa Farao, na arabaa rîîgu nîûntû bwa rûgendo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.21",
            "verseOrgIds": [
              "GEN.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî aabaeere o muntû o muntû nguû înjerû, na araa Benjamini ichunchî magana jathatû bia fetha na nguû injerû ithaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe nî aatûmanîîre into bibi biikîrua îthe: ntigiri îkûmi cia ndûme ikamatîte into birîa biega buru kuuma Misri; na ntigiri îkûmi cia nka ikamatîte irio na mîgaate na rîîgu ya îthe nîûntû bwa rûgendo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.23",
            "verseOrgIds": [
              "GEN.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ararekeeria ataana ba ng'ina beeta, îndî arabeera ûjû, “Menyeni bwîja gûtetania bûrî rûgendoone.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
            "verseOrgIds": [
              "GEN.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo barauma Misri, bareeta barakinya kîrî îthe Jakubu nthîgûrû ya Kanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwîra atîrî, “Josefu no arî mwoyo, na nîwe ûkwaathana nthîgûrûûne ya Misri yonthe.” Jakubu aratemûka nîûntû ataabeetîkagia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî rîrîa baamweere nteto cionthe irîa Josefu aabeerîte, na oona ngaarî irîa ikuuragua nî mbarathi, irîa Josefu aatûmîte cia kûmûkamata, Jakubu aragîa inya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
