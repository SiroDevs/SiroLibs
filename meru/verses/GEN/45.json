        "style": "s1"
      },
      "items": [
        {
          "text": "Josefu kwimenyithania kîrî ataana ba ng'ina",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 45:1"
          },
          "items": [
