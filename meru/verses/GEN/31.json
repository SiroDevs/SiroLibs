              "type": "text"
            }
          ]
        },
        {
          "text": "Kîthûmba gîkî na iiga rîrî nî ûkûûjî atî ntîkarobikûrûka mbîjîte ndeerîa ûrî, naagwe ûtîkarokûrûka kîthûmba gîkû kîa maiga na gîtugî gîkî kîa iiga wîjîte ndeerîa ndî, ûrî na ûthûûku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.52",
            "verseOrgIds": [
              "GEN.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
