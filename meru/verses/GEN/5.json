            {
              "text": "5.2",
              "type": "text"
            },
            {
              "text": "muntû:",
              "type": "text"
            },
            {
              "text": "na Kîhibirania nî Adamu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
