                  "text": "Mar 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Aaboombîre ntomûrûme na mûka na arabatharima. Aathiria kûboomba arabeeta muntû.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
