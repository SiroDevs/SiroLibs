                "loc": "1PE.3.20"
              },
              "items": [
                {
                  "text": "1Pet 3.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî oonere atî ûmaramari bwa antû bûkwingîa mono nthîgûrûûne. Ningî aroona atî antû nî baakaraga na mairîrîîria jamathûûku nkoroone ciaao magiita jonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aaigîrue bûbûûî mono nîûntû bwa kûûmba muntû na araithikîîra nkoroone yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, MWATHANI arauga atîrî, “Nkaathiria antû bonthe nthîgûrûûne na nthirie nyomoo na nyoni na nyamû irîa ciikuuragia na kîu nîûntû nî nkwirira gîtûmi ndaabiûmbîre.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî Noa nî aagwîrîrie MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
