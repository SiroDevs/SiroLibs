                  "text": "2.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naku nî gwaakarîre atîrî, antû nî baambîrîîrie kwingîa nthîgûrûûne kunthe na nî baaciarîre aarî. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biûmbe bia îgûrû nî bionere aarî bau barî babathongi, na biraithuurîra aarî bamwe baraa aka baao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, MWATHANI arauga atîrî, “Roho waakwa atîtûûraga ndeene ya muntû kenya na kenya nîkwîthîrwa muntû agatûûraga kagiita gagakai ka mîaka îgana rîmwe rîa mîrongo îîrî.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Gût 13.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îgiiteene rîu biûmbe bia îgûrû bikûjûkia aarî ba antû nî biaaciarîre imuntû bibinene mono bieetagwa Nefilimu. Imuntû biu nîbio biaarî îgweta nthîgûrûûne.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
    },
