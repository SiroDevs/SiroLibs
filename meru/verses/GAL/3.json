                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.3"
              },
              "items": [
                {
                  "text": "Aro 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O ûu nîu kwaandîki mantû jegiî Abrahamu, “We nî eetîkîrie Mûrungu, na nîûntû bwa wîtîkio bûu bwaawe Mûrungu aramûtara atî nî ûmwagîru.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Aro 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, menyeni atî antû barîa beetîkîtie Mûrungu, nîbo ataana ba Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Kîam 12.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maandîko nî joonanîrie o mbere mma atî Mûrungu akaagîrithia antû barîa batî Ayahudi nîûntû bwa gwîtîkia. Tontû bûû, Maandîko jaratûmîîria Nteto Injega kîrî Abrahamu atî: “Mûrungu akatharima antû barîa batî Ayahudi nîûntû bwaaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, bonthe barîa beetîkagia nî batharimagwa o ta ûrîa Abrahamu atharimîrwe nîûntû bwa gwîtîkia.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        }
      ]
    },
