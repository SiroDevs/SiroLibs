                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Kûr 21.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Îndî Kristû nî aatûkûûrîre kuuma kîrumiine kîa Waatho rîrîa eetîkîrîrie kûrumwa nîûntû bweetû. Tontû Maandîko Jamatheru jariuga, “O muntû ûrîa wambagwa mûtîîne îgûrû, nî ûmûrume.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kristû aathithîrie ûu nîkenda kîtharimo kîrîa Mûrungu eerîîre Abrahamu kînenkerwa antû barîa batî Ayahudi kuumania na Kristû Jesû na nîkenda tuî nîûntû bwa wîtîkio tûkaeewa Roho ûrîa weranîri nî Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waatho na wîrane bwa Mûrungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ataana na aarî ba baaba, ka mbwee ngerekano ya ûrîa antû batûûraga; kiigai kîathiria kwaandîkwa na gwîkîrwa caini, gûtî muntû ûcokaga gûkîtharia kana kwongeera gantû kangî. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Kîam 12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nandî rî, mawîrane ja Mûrungu jaarî kîrî Abrahamu, na nchiarwa yaawe. Maandîko jatîkuuga, “Nchiarwa ciaawe,” teeka barî babaingî, îndî jariuga, “Nchiarwa yaawe,” nîûntû nî muntû ûmwe akî ûkwîrîrwa nawe nî Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Kum 12.40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûrîa nkwenda kuuga nî atî: Mûrungu nî eekîre wîrane na Abrahamu araciîtia akoojûria wîrane bûu. Waatho nabu bwejîre mîaka magana jana na mîrongo îthatû nyumeene. Tontû bûû, gûtî u Waatho bûûmba kûtharia kîrîkanîro kîa Mûrungu kana bweethia wîrane bwaawe gîntû kîa ûtheri. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.14"
              },
              "items": [
                {
                  "text": "Aro 4.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû gûkëeja kwîthîrwa kîewa kîa Mûrungu kîeejanagwa nîûntû bwa Waatho, nî kuuga, gîtîejanwa nîûntû bwa wîrane. Îndî ûûma nî atî Mûrungu aeere Abrahamu kîewa nîûntû bwa wîrane bwaawe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
