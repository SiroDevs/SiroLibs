            "sid": "GAL 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî mbere ya îgiita rîa wîtîkio rîîja, Waatho nî bwatûthaîkîte, tûrakara tûthaîki nîbu mwanka rîrîa wîtîkio bûu bwaagwuûrîrwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, twaathagwa nî Waatho mwanka rîrîa Kristû eejîre nîkenda twagîrithua nîûntû bwa gwîtîkia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî tontû îgiita rîongwa rîa wîtîkio nî rîkinyîte, Waatho bûtîcoka gûtwatha kaîrî.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
    },
