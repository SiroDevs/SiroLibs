      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atongeeria ba antû ba Israeli baatûûraga Jerusalemu. Antû bangî ba Israeli nî baaringîre kuura nîkenda bamenya nî muntû ûrîkû kuuma o mûciî ûgeeta gûtûûra Jerusalemu. Antû bau bangî ba Israeli nî baatûûrîre ntûûreene ingî. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû nî baakumîrie antû bonthe barîa baairitîre bongwa gwîta gûtûûra Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
