              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntû ûrîa waathuuri kwaragîîria antû ba Israeli Kîameene gîa Parasia eetagwa Pethalia mûtaana wa Meshezabeli. Pethalia aarî wa mûciî jwa Zera, wa kuuma mwîrîgeene jwa Juda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Antû ba Israeli barîa baatûûraga ntûûreene ingî cia Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba mwîrîga jwa Juda nî baatûûraga ntûûreene iji akuî na miuunda yaao: Kiriathiaraba, na Diboni, na Jekabuzeeli na tûtûûra tûrîa twaithiûrûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baatûûraga ntûûreene ya Jeshua, na ya Molada, na ya Bethipeleti, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya Hazari-shuali, na ya Beerisheba na tûtûûra tûrîa twaaithiûrûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baatûûraga ntûûreene ya Zikilagi, na ya Mekona, na tûtûûra tûrîa twaithiûrûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baatûûraga ntûûreene ya Enirimoni, na ya Zora, na ya Jaramuthi, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya Zanoa, na ya Adulamu na tûtûûra tûrîa twaaithiûrûkîrîte. Ningî nî baatûûraga ntûûreene ya Lakishi na miuundeene îrîa yaamîthiûrûkîrîte, na bangî Azeka na tûtûûra tûrîa twaamîthiûrûkîrîte. Tontû bûû, antû ba Juda baatûûraga ntûûreene irîa ciaarî gatîgatî ka Beerisheba îrîa yaarî bwa ûmotho mwanka kîguuruune kîa Hinomu kîrîa kîaarî bwa ûrîo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû ba mwîrîga jwa Benjamini nî baatûûraga ntûûreene iji: Geba, na ya Mikimashi, na ya Ai, na ya Betheli, na tûtûûra tûrîa twaithiûrûkîrîte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baatûûraga ntûûreene ya Anathothi, na ya Nobu, na ya Anania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya Hazori na ya Rama, na ya Gitaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya Hadidi, na ya Zeboimu, na ya Nebalati, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ya Lodi, na ya Ono, na kîguuruune kîa Atea. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikundi bimwe bia Alawi barîa baatûûraga nthîgûrûûne ya Juda nî beerîrwe bagatûûre amwe na antû ba mwîrîga jwa Benjamini.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
          }
        }
      ]
