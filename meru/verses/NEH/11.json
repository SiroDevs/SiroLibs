          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bangî ba Israeli barîa baatûûraga ntûûreene iu ingî cia nthîgûrû ya Juda amwe na athînjîri-Mûrungu, na Alawi nî baatûûraga ithakeene birîa baagaîri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî antû barîa baaritaga ngûgî kîûrûûne baakaraga rûteere rûmwe rwa Jerusalemu rweetagwa Ofeli. Atongeeria baao baarî Ziha na Gishipa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
