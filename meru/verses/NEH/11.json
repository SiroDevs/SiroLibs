        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaria ba kîûrû barîa baatûûraga Jerusalemu baarî Akubu, na Talimoni, na antû ba ndûgû ciaao. Bonthe baarî antû îgana rîa mîrongo mûgwanja na baîrî (172).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
