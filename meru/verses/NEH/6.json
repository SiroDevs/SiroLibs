{
  "id": "NEH.6",
  "number": "6",
  "bookId": "NEH",
  "reference": "Neh 6",
  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
