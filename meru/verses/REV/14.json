        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
            "verseOrgIds": [
              "REV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîraigua kajû kuuma bwa îgûrû gakiugaga, “Aandîka jaja: Kîtharimo nî kîrî antû barîa bagakua bagwatanîrîte na Mwathani kwambîrîria nandî gwîta na mbere.” Rîu Roho arauga, “Nî mma nî baatharimi! Bakagwîrua nî kûnogoka kuuma ngûgîîne ciaao indito. Nîkwîthîrwa mathithio jaao jakabathingata.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maketha ja nthîgûrû",
          "type": "text"
        }
      ]
    },
