          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mîthangîko ya ijîîrî îkûthira, îndî atîrî, mîthangîko ya jathatû yeengerie kwîîja.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
