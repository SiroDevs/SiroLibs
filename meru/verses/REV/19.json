                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu ndîroona îgûrû rîarugûka na ndîroona mbarathi înjerû! Ûrîa wamîtithîtie eetagwa Gwîtîkîka na Ûûma. Nawe agiitaga îgamba na îota na ageeta ndweene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
