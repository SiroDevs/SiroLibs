                {
                  "text": "Joe 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Kûg 14.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rûchiû rûrûûgî nî rwaumîrîte kanyueene kaawe. Rûchiû rûu nîru agatumîra kûthiria antû ba mîgongo na akabaatha atî na kîaao. Ningî agakinyangîra nzabibû gîkinyangîroone takîo marûrû ja mûthûûro jwa Mweneinya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwambambio na kîero kîaawe nî kwaandîki riîtwa rîrî, “Mûnene wa anene na Mwathani wa athani.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
