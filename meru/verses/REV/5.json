              "items": [
                {
                  "text": "Isa 42.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo baraina rwîmbo rûrwerû rûkuuga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
