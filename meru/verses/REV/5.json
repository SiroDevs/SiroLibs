          },
          "items": [
            {
              "text": "\n        Dan 7.10\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ningî ndîraraithîîria kaîrî na ndîraigua kajû ka araîka milioni na milioni inyingî. Araîka bau bathiûrûkîrîte rûriga na biûmbe birîa birî mwoyo na akûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bainaga rwîmbo rûrwerû bakiugaga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
