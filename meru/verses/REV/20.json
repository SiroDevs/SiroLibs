                {
                  "text": "Ezek 7.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.2"
              },
              "items": [
                {
                  "text": "38.2",
