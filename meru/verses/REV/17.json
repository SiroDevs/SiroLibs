        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Jer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anene barîa bathanaga nthîgûrû nî bathûngîîrîte nawe na antû barîa batûûraga nthîgûrû nî bogitîtue nî ûthûngîîri bwaawe.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        }
      ]
    },
    {
