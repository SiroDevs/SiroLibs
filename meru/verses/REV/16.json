            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûraîka wa batano aretûûra mûthûûro jûrîa jwaarî mpakûriine yaawe rûrigeene rwa ûnene rwa nyomoo. Ûnene bwaayo bûrakunîkwa nî muundu. Antû bararûmanga ndûûme ciaao tontû bwa rwakaî rûrîa baigagua. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bararuma Mûrungu wa îgûrû nîûntû bwa ûrîa baarî na ironda na rwakaî rûrwingî na batairirîre maatia jaao.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
