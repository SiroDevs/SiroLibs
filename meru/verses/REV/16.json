          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûraîka wa baîrî aretûûra mûthûûro jûrîa jwaarî mpakûriine yaawe îrieene. Îria rîrakara ta tharike ya muntû ûkuîte na gîntû kîonthe kîrîa kîaarî mwoyo kîrîa gîtûûraga îrieene kîrakua.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
