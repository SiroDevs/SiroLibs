              "items": [
                {
                  "text": "Kûg 3.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Thikîîreni, ni nkeeja ta mwamba! Kîtharimo nî kîrî muntû ûrîa ûtîaua nî toro na ethîrwe ekîrîte nguû ciaawe atîkeeje kuuma arî kîthûnû athawa!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.15",
            "verseOrgIds": [
              "REV.16.15"
            ]
          }
        },
        {
