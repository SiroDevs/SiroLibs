              "REV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûraîka wa bana aretûûra mûthûûro jûrîa jwaarî mpakûriine yaawe riûeene. Riûa rîreetîkîîrua kûîthia antû na mwanki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.8",
            "verseOrgIds": [
              "REV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû baraîîthua nî riûa mono, nabo bararuma riîtwa rîa Mûrungu ûu waarî na inya ya kwatha ikanûkia biu. Ningî batairirîre meeyia jaao kana bakumia Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.9",
            "verseOrgIds": [
              "REV.16.9"
            ]
          }
        }
      ]
    },
    {
