                {
                  "text": "Zek 12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu roho iu iroothûrania anene bau gûntû gweetagwa na Kîhibirania Amagedoni.",
          "type": "text",
