            }
          ]
        },
        {
          "text": "Rîu ndîraigua kajû gakanene kuuma kîûrûûne gakîîraga araîka bau mûgwanja ûjû, “Îteeni na bwîtûûre mûthûûro jwa Mûrungu jûrîa jûrî mpakûriine iu mûgwanja nthîgûrûûne.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.1",
            "verseOrgIds": [
              "REV.16.1"
            ]
          }
        }
