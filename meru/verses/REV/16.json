              "items": [
                {
                  "text": "Zab 78.44",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûraîka wa bathatû aretûûra mûthûûro jûrîa jwaarî mpakûriine yaawe mîuroone na ithimeene bia rûûjî. Ndûûjî cionthe iraa tharike. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.4",
            "verseOrgIds": [
              "REV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîraigua mûraîka ûrîa mûnene mantûûne ja ndûûjî auga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.5",
            "verseOrgIds": [
              "REV.16.5"
            ]
          }
        }
      ]
    },
    {
