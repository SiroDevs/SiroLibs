                }
              ]
            },
            {
              "text": "Dan 7.2",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.5"
              },
              "items": [
                {
                  "text": "Zek 6.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyuma ya ûu ndîroona araîka bana barûngi koneene cio inya cia nthîgûrû. Nabo nî baaingîrîte ndûûo cio inya nîkenda îtiurutana îgûrû rîa nthî înjûmo kana îgûrû rîa îria kana ciuruta mûtî kinya jûmwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.1",
            "verseOrgIds": [
              "REV.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ndîracoka ndîroona mûraîka ûngî aitîtie bwa îgûrû aumîîrîte kûrîa riûa riumagîîra agwete mûûri jwa Mûrungu ûrîa ûtwîre mwoyo. Mûraîka ûu areeta araîka barîa bana na kajû gakanene. Araîka bau nî barîa baaeei inya ya kwînyangia nthîgûrû înjûmo o na îria. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.2",
            "verseOrgIds": [
              "REV.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.4"
              },
              "items": [
                {
                  "text": "Ezek 9.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mûraîka ûu arabeera, “Bûkenyangieni nthî înjûmo kana îria kana mîtî mwanka rîrîa tûkathiria gwîkîra nthûûmba cia Mûrungu weetû rwano moothiû jaao.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.3",
            "verseOrgIds": [
              "REV.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî ndîraigua atî ntari ya antû ba kuuma mîîrîgeene yonthe ya Israeli barîa beekîrîtwe rwano yaarî ngiri îgana rîmwe rîa mîrongo îna na inya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.4",
            "verseOrgIds": [
              "REV.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba nîbo beekîrwe rwano:",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.5",
            "verseOrgIds": [
              "REV.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntundu îtîtarîka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
