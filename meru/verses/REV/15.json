            "number": "1",
            "style": "v",
            "sid": "REV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîroona gîntû gîakari ta îria rîa kîoo riungenue na mwanki. Ndîroona barîa baarûîte na boomba nyomoo amwe na mûng'uanano jwaayo o na ntari ya riîtwa rîaayo barûngi rûteere rwa îria rîu rîa kîoo. Antû bau baagwete kînanda kîrîa Mûrungu aabanenkerete. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.2",
            "verseOrgIds": [
              "REV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.1"
              },
              "items": [
                {
                  "text": "Kum 15.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nabo nî bainaga rwîmbo rwa Musa, nthûûmba ya Mûrungu, na kinya rwîmbo rwa Gatûrûme bakiugaga,",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.3",
            "verseOrgIds": [
              "REV.15.3"
            ]
          }
        }
      ]
