                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyuma ya ûu, ndîroona kîûrû kîa Mûrungu kîrîa kîrî kûu îgûrû na ndeene ndîroona îema rîa gûtirimanîra rîarugûka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araîka mûgwanja barîa baarî na ikanûkia mûgwanja barauma kîûrûûne kîu bekîrîte nguû injerû cwee na baciogeete mîcibi ya thaabu ibara biaao. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îgiita rîu kîumbe kîmwe kîa biûmbe bina birîa birî mwoyo kîranenkera araîka bau mûgwanja mpakûri mûgwanja ciûjûri mûthûûro jwa Mûrungu ûrîa ûtûûraga mwoyo kenya na kenya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
