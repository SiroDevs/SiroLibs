          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîroona gîûntû kîngî gîa kûrigaria kûu îgûrû. Nî kwaarî na araîka mûgwanja barîa baarî na ikanûkia mûgwanja bia mûthia tontû nîbio biaarî bia kûthirîkîîria mûthûûro jwa Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.1",
            "verseOrgIds": [
              "REV.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
