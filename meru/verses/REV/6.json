              "items": [
                {
                  "text": "Luk 21.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa Gatûrûme kaathingûrîre mûûri jwa îtantatû kûrakara atîrî, Nthîgûrû îrainaina mono. Riûa rîrairûwa ta nguû înjirû. Ningî mweri jûraa jûmûtuune ta tharike. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.4"
              },
              "items": [
                {
                  "text": "Isa 34.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nacio njota cia îgûrû iratua kwarûka nthî ta ûrîa nkûû ciarûkaga rîrîa kûrî na ruuo rûrûnene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
            "verseOrgIds": [
              "REV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Kûg 16.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îgûrû rîrakûnjwa rîrarima ta ûrîa yuku rîkûnjagwa. Irîma bionthe na icîgîîrio bia îria birebua birauma arîa biaarî. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.19"
              },
              "items": [
                {
                  "text": "Isa 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu anene ba nthîgûrû na antû barîa barî îgweta na atongeeria barîa anene ba njûûrî na itonga na barîa barî inya o na antû bonthe na nkombo o na barîa barî na ûciathi, bonthe baraiciitha ikurunguune na maigeene jarîa jaarî irîmeene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 6:16"
          },
          "items": [
