            "sid": "REV 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu ndîroona Gatûrûme gakîthingûra mûûri jûmwe jwa îrîa mûgwanja na ndîraigua kîûmbe kîmwe kîa biûmbe biu bina birî mwoyo gîkiugaga na mûgambo ta jwa ngorogoro, “Njû!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.1",
            "verseOrgIds": [
              "REV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.8"
              },
              "items": [
                {
                  "text": "Zek 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.3"
              },
              "items": [
                {
                  "text": "6.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naani nkîraithîîria ndîroona mbarathi ya rangi înjerû. Ûrîa wamîîtithîtie nî aagwete ûta, nawe aranenkerwa thirû. Rîu araumagara amîîtithîtie akîûmbanaga ndweene nîkenda akoombaga anthû baawe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.2",
            "verseOrgIds": [
              "REV.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
