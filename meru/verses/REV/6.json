          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.2"
              },
              "items": [
                {
                  "text": "Zek 6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu Gatûrûme karathingûra mûûri jwa îthatû. Naani ndîraigua kîûmbe kîa bithatû kîrîa kîrî mwoyo gîkiuga, “Njû!” Nkîraithîîria ndîroona mbarathi înjirû yaumîra. Ûrîa wamîîtithîtie nî aagwete ratiri njareene yaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.5",
            "verseOrgIds": [
              "REV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu nîrîo ndaaigîrue kajû kuuma au biûmbe bina birî mwoyo biaarî gakiugaga, “Mûchaara jwa ntukû jûkeethîrwa jûrî kilo îmwe ya nkano kana jwîthîrwe jûrî kilo ithatû cia mûnyaki. Îndî bûkeenyangieni maguta kana ndibei!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
