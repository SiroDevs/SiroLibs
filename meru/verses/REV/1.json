        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîragarûka nîkenda mbona ûrîa wambaragîria. Ndîkûgarûka ndîroona itugî mûgwanja bia kûrîkîîra taawa birîa biathithîtue na thaabu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
