              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "We nî atwendeete na nî atûthaûrîte kuuma meeyiene jeetû na njîra ya tharike yaawe, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
