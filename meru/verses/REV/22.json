                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Zek 14.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu mûraîka arambonia mûuro jwa rûûjî rwa ûtûûro, rûrûkembûku ta kîoo, rûrîa rwaumaga rûrigeene rwa Mûrungu na rwa Gatûrûme. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.1",
            "verseOrgIds": [
              "REV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 22:2"
          },
          "items": [
            {
