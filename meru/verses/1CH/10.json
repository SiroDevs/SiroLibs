                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, Saûlû arakua nîûntû bwa kûrega gwîtîkia MWATHANI na kûrega kwathîkîra maathana jaawe. Ningî nî eetaga gûcwaa nkuagaya na kîrîra kuuma kîrî roho cia antû barîa baakuîre. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saûlû atooragia nkuagaya kuuma kîrî MWATHANI. Tontû bûû, MWATHANI aramûûraga na aranenkanîra waathani kîrî Daudi mûtaana wa Jesii.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
