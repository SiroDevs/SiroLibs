            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuma mwîrîgeene jwa Simioni nî kwaarî na nchamba cia ndwaa cia îgweta ngiri mûgwanja cia îgana rîmwe (7,100). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.25",
            "verseOrgIds": [
              "1CH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwîrîgeene jwa Alawi kwaarî na asikarî ngiri inya cia magana jatantatû (4,600). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.26",
            "verseOrgIds": [
              "1CH.12.26"
            ]
          }
        },
        {
          "name": "verse",
