              "JDG.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 19:22"
          },
          "items": [
            {
              "text": "22",
