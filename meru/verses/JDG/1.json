          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, antû ba mwîrîga jwa Asheri nî baatûûrîre amwe na Akanaani nîûntû bataabengîre.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.32",
