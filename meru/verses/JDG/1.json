              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo antû ba mwîrîga jwa Dani nî beengîrîîrue nthîgûrûûne ya irîma nî Aamori na bataabarekere beenama mûgwanthîîne. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.34",
            "verseOrgIds": [
              "JDG.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamori nî beetîre na mbere gûtûûra kîrîmeene kîa Heresi na ntûûreene ya Aijaloni na ya Shaalibimu. Îndî antû ba mwîrîga jwa Efuraimu na ba mwîrîga jwa Manase nî baabainyîrîîrie bakîbaritithagia ngûgî kwa inya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.35",
            "verseOrgIds": [
              "JDG.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
