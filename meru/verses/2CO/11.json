          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "îndî nî ndeenîkîîrwe ndiriceene ya rûthingo rwa ntûûra mbîkîri gîkabûûne na ndîraûra.",
          "type": "text",
