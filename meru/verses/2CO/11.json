            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "14.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nî ndaûrîrwe ibooko maita jathatû nî Aroma, na ndîraringwa na maiga rîmwe. Meri nî ithûûkangîte maita jathatû ndî ku na kûrî rîmwe ndakarîre rûûjîîne kûu îrieene ûtukû na mûthenya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
