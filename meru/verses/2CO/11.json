                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa ndaarî Damaski, mûrûngamîîri ûrîa waathanaga îgiita rîa mûnene Areta, nî eekîre akaria mwîrîga jwa ntûûra nîkenda bangwata, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
