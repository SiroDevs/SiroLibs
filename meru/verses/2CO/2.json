              "2CO.2.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Maj 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîrîa ndakinyîre Troa gûtûmîîria Nteto Injega cia Kristû, Mwathani nî antemeere njîra nîkenda ndita ngûgî kûu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî ntaang'anîrwe ndîkwîthîra mûtaana wa baaba Tito atî kûu. Tontû bûû, ndîreera antû batigwe bwega na ndîreeta Makedonia.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûûmbani nîûntû bwa Kristû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî nî nkaatho kîrî Mûrungu ûrîa ûtûmaga tûûmbana ndeene ya Kristû. Nî Mûrungu ûtûmaga tuî tûtaambia ûûma bwa Kristû gûntû kunthe bûkari ta îera rîrîega. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.14",
            "verseOrgIds": [
              "2CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa tuî tûkari ta îera rîrîega rîa ubaani îrîa Kristû aritagîra Mûrungu, nî tûkinyagîra antû bonthe barîa bakwonoka na barîa bakûûra. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.15",
            "verseOrgIds": [
              "2CO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îera rîu rîkari ta gîkuû kîrî barîa bakûûra na ûtûûro kîrî barîa bakwonoka. Nûû îndî ûûmba kûrita ngûgî îîu? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.16",
            "verseOrgIds": [
              "2CO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuî tûtîkari ta antû babaingî, barîa baethetie Nteto cia Mûrungu ta biashara. Îndî tuî nîûntû Mûrungu nî atûtûmîte, twaaragia tûrî na mma mbere yaawe, tûrî nthûûmba cia Kristû.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.17",
            "verseOrgIds": [
              "2CO.2.17"
            ]
          }
        }
      ]
    }
  ],
