        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.10",
            "verseOrgIds": [
              "2CO.9.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.10"
              },
              "items": [
                {
                  "text": "Isa 55.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mûrungu ûrîa weejanaga mbeeû kîrî mûrîmi na akaeejana biakûrîa nîwe ûkabwaa mbeeû cionthe irîa bûkenda na atûme ikûre na iciare maketha jamaingî nîûntû bwa kweejana na magi kweenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.10",
            "verseOrgIds": [
              "2CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatûma bwîthîrwe bûrî itonga bia into bionthe nîkenda bûkoomba kweejanaga na magi magiita jonthe. Bûu nabu bûgatûma babaingî bacokerie Mûrungu nkaatho tontû bwa biewa bieenu birîa bakoonaga kuuma kîrî tuî. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.11",
            "verseOrgIds": [
              "2CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû biewa biu bieenu bitîteethagia atheru akî îndî nî bitûmaga antû babaingî bakoojûrwa nî nkaatho kîrî Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.12",
            "verseOrgIds": [
              "2CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûu bûkûrita biewa gûgatûma antû babaingî bakumithie Mûrungu tontû bûkoonania nî bwathîkîrîte ûrîa Nteto Injega cia Kristû ikuuga na ningî bacokerie Mûrungu nkaatho nîûntû bwa biewa bieenu kîrî bo na kîrî antû bangî bonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.13",
            "verseOrgIds": [
              "2CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antû bau nabo bakabûrombagîra boojûrîtwe nî wendo tontû bwa ûtugi bwa mwanya bûrîa Mûrungu abweete. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.14",
            "verseOrgIds": [
              "2CO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûcokerieni Mûrungu nkaatho tontû bwa kîewa kîrîa gûtî nteto tûûmba kwîrana bwega ûrîa gîkari.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.15",
            "verseOrgIds": [
              "2CO.9.15"
            ]
          }
        }
      ]
    }
  ],
