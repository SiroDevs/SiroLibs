              },
              "items": [
                {
                  "text": "Zab 112.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " No ta ûrîa Maandîko jakuuga,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.9.9",
            "verseOrgIds": [
              "2CO.9.9"
            ]
          }
        }
      ]
    },
    {
