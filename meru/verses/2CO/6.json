              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "6.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kîûrû kîa Mûrungu kîegeenie atîa na mîrungu ya mîng'uanano? Nîkwîthîrwa tuî nî tuî kîûrû kîa Mûrungu ûrîa ûtûûraga mwoyo. O ta ûrîa Mûrungu augîîte Maandîkoone:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
    },
    {
