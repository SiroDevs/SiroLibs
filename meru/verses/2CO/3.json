                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.33"
              },
              "items": [
                {
                  "text": "Jer 31.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.19"
              },
              "items": [
                {
                  "text": "Ezek 11.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.26"
              },
              "items": [
                {
                  "text": "36.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naabuî nî bûkwonania bûrî barûga kuuma kîrî Kristû îrîa twatûmîîrwe tûrareeta. Barûga îîu îtîaandîki na rangi îndî yaandîkîtwe na Roho wa Mûrungu ûrîa ûtûûraga mwoyo. Ningî îtîaandîki mbechueene cia maiga îndî yaandîkîtwe nkoroone cia antû.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.3",
            "verseOrgIds": [
              "2CO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tûriuga ûjû nîûntû nî tûgûciîtîkia mbere ya Mûrungu nîûntû bwa Jesû Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.4",
            "verseOrgIds": [
              "2CO.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Teeka kûrî gîntû tûrî nakîo na bweetû kîa gwikûmîria atî twoomba kûrita ngûgî îîu îndî nî mûrungu ûtûmaga tûûmba kûrita ngûgî iu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.31"
              },
              "items": [
                {
                  "text": "Jer 31.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nî Mûrungu ûtweete inya ya kwaa ariti ngûgî ba kîrîkanîro gîkîerû. Kîrîkanîro kîu nakîo tî kîa Waatho bûbwaandîke îndî nî kîa Roho nîûntû Waatho bûrîa bwaandîki bûreetaga gîkuû, îndî Roho areetaga ûtûûro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.29"
              },
              "items": [
                {
                  "text": "Kum 34.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Waatho bûu bwaandîki mbechueene cia maiga mûthieene nî gîkuû bwaaretere. Kûnenkanîrwa kwa Waatho bûu nî kwejîre na mwago na ûkumio bûbûnene mono kinya antû ba Israeli bararemwa nî kûraithîîria ûthiû bwa Musa nî ûrîa bwakengete kinya këethîra kwaarî gwa kagiita gagakai. Rîu gûkëeja kwîthîrwa kûnenkanîrwa kwa Waatho bûu bwaaretere gîkuû nî kwaarî na mwago na ûkumio bûbûnene ûu rî, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.7",
            "verseOrgIds": [
              "2CO.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kûnenkanîrwa kwa Roho gûtîthîrwa kûrî na mwago nkûrûki? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.8",
            "verseOrgIds": [
              "2CO.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, gûkëeja kwîthîrwa nîu kwaarî na mwago jûmûnene îgiita rîa kûnenkanîrwa kwa Waatho bûrîa bwaatûmîre tûgitîrwa îgamba rîa gûkua, bûu bûrîonania atî kûnenkanîrwa kwa Waatho bûrîa bûtûmaga twigithanua na Mûrungu gûkeethîrwa kûrî na mwago jûmûnene nkûrûki. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.9",
            "verseOrgIds": [
              "2CO.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, twoomba kuuga atî nîûntû mwago jûkwîja jûmûnene nkûrûki, nandî mwago jûrîa jwaarî o mbere nî jwathirîre. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.10",
            "verseOrgIds": [
              "2CO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gûkëethîrwa ûntû bûu bwa ûkumio bwa kagiita gagakai nîu bweejîre na mwago jûmûnene, no mwanka mwago jûrîa jûrî jwa gûtûûra jwîthîrwe jûrî na ûkumio bûbûnene nkûrûki.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.11",
            "verseOrgIds": [
              "2CO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî tontû bwa ûrîa tûrî na wîrîgîîro bûû, tûrî na ûchamba mono. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.12",
            "verseOrgIds": [
              "2CO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.33"
              },
              "items": [
                {
                  "text": "Kum 34.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tûtîkari ta Musa ûrîa weekîîre kananga ka gûkunîkîra ûthiû bwaawe nîkenda Aisraeli batîkoone mûthia jwa gûkenga kûu gwacokere kûthira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.13",
            "verseOrgIds": [
              "2CO.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî mathûgaanio jaao nî jaarigicanîrue na mwanka naarua tûrî kananga kau nî kethagîrwa gakûnîkîte mathûgaanio jaao rîrîa bakûthoma mauku ja kîrîkanîro gîîkûrû. Kananga kau keebagua o rîrîa muntû aagwatanîra na Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.14",
            "verseOrgIds": [
              "2CO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kinya naarua tûrî, îgiita rîonthe rîrîa bathomaga Waatho bwa Musa, kananga nî kethagîrwa gakunîkîte mathûgaanio jaao. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.15",
            "verseOrgIds": [
              "2CO.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.34"
              },
              "items": [
                {
                  "text": "Kum 34.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî kananga kau keebagua rîrîa muntû acokeera kîrî Mwathani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.16",
            "verseOrgIds": [
              "2CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu Mwathani nî Roho na arîa Roho wa Mwathani arî, kûrî na ûciathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.17",
            "verseOrgIds": [
              "2CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, moothiû jeetû jarîa jatîkunîkîri nî joonanagia ûkumio bwa Mwathani. Ûkumio bûu bwîthagîrwa bûkiumaga kîrî Mwathani ûrîa ûrî Roho na nîwe ûtûgarûraga kuuma ûkumio bûmwe gwîta kîrî bûngî nîkenda tûkara tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.18",
            "verseOrgIds": [
              "2CO.3.18"
            ]
          }
        }
      ]
    }
  ],
