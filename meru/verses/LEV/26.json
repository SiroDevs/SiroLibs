          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Îndî bûkëeja kwirira meeyia jeenu na meeyia ja biûjûjû bieenu jarîa baathithîrie nîntû bwa kûrega kûmbathîkîra ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "baratûma kinya ni mbautatîra na mbanyagania nthîgûrûûne cia anthû baao; bûkëeja gûtiga kûrema na bakainyiiyia na bageetîkîra kûgarûka bagatiga kwîyia, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
