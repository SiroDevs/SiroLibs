                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ningî MWATHANI nî aaugîre atîrî, “Bûkáaithithîria mîrungu ya mîng'uanano kana bûrûngîka itugî kana bwaja maiga bûjathaathayia kûu nthîgûrûûne yeenu. Nîkwîthîrwa ni nî ni MWATHANI Mûrungu weenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menyagîîreeni ntukû ciaakwa cia sabatû na bwîkagîîre antû aakwa atheru arîa nthaathagîrua. Nîkwîthîrwa ni nî ni MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
