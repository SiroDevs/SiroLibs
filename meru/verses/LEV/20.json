                "loc": "DEU.5.18"
              },
              "items": [
                {
                  "text": "Kûr 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ntomûrûme akëeja kûthûûngîîra na mwekûrû wa muntû ûngî, bobaîrî nî athûngîîri na no mwanka booragwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.8"
              },
              "items": [
                {
                  "text": "Ala 18.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.30"
              },
              "items": [
                {
                  "text": "Kûr 22.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.20"
              },
              "items": [
                {
                  "text": "27.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme ûrîa ûkaathengeera mwekûrû wa îthe, muntû ûu akethagîrwa aagîrîte îthe nthoni. Nawe amwe na mwekûrû ûu no mwanka booragwe. Nabo bakeethîrwa baireteereete gîkuû kîaao bongwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.11",
            "verseOrgIds": [
              "LEV.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.15"
              },
              "items": [
                {
                  "text": "Ala 18.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme akëeja kûthengeera mwekûrû wa mûtaana waawe, we na mwekûrû ûu no mwanka booragwe. Kûu nî kûthenganîîra na mûka wa mûtaana na nî ûntû bûbûthûûku mono. Nîbo bongwa bakeethîrwa baireteereete gîkuû kîu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.12",
            "verseOrgIds": [
              "LEV.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.22"
              },
              "items": [
                {
                  "text": "Ala 18.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme akëeja kûthengeera ntomûrûme ûngî bobaîrî bakeethîrwa bagûciîkîra mûgiro na no mwanka booragwe. Nîbo bakeethîrwa baireteereete gîkuû kîaao bongwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.17"
              },
              "items": [
                {
                  "text": "Ala 18.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.23"
              },
              "items": [
                {
                  "text": "Kûr 27.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme akëeja kûgûra mûka na akagûra mwarî wa mûka ûu, kinya ûntû bûu nî bûbûthûûku mono. Bonthe babuîrîte gwakîîrua nîkenda ûthûûku buuma kîrî buî. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.19"
              },
              "items": [
                {
                  "text": "Kum 22.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.23"
              },
              "items": [
                {
                  "text": "Ala 18.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Kûr 27.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntomûrûme akëeja kûthengeera nyomoo, no mwanka ooragwe, na kinya nyomoo îîu yûragwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.15",
            "verseOrgIds": [
              "LEV.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûka akëeja gûcwaa nyomoo îkamûthengeera, mûka ûu abuîrîte kûûragwa na kinya nyomoo îîu îbuîrîte kûûragwa. Mûka ûu nîwe wiretereete gîkuû kîaawe na areetera nyomoo îîu gîkuû.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.16",
            "verseOrgIds": [
              "LEV.20.16"
            ]
          }
        }
      ]
    },
