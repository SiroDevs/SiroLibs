              "items": [
                {
                  "text": "Kum 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.4"
              },
              "items": [
                {
                  "text": "Mat 15.4",
                  "type": "text"
