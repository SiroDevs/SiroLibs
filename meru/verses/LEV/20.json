              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.10"
              },
              "items": [
                {
                  "text": "Mar 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû wonthe ûrîa ûkaaruma îthe kana arume ng'ina, no mwanka ooragwe. Nîwe ûkeethîrwa aireteereete gîkuû wengwa nîûntû bwa kûruma îthe kana ng'ina.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
