                  "text": "Ala 23.26-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.29.7+NUM.29.8+NUM.29.9+NUM.29.10+NUM.29.11"
              },
              "items": [
                {
                  "text": "Gût 29.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bûbû nîbu Waatho bûrîa bûkaathingatagwa magiita jonthe: Ntukû ya îkûmi ya mweri jwa mûgwanja, taju Tishiri, bûciatage biakûrîa na bûkáritaga ngûgî noo îrîkû. Waatho bûu bûthingatagwe nî Ayahudi na ageni barîa batûûraga amwe nabo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû îîu nîyo bûkaatheragua na nkaabûthirîria meeyia jeenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îîu nî ntukû ya sabatû, ntukû ya kûnogoka, na gûciata kûrîa. Bûu nî Waatho bwa kûthingatagwa magiita jonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû jau jakathithagua nî mûthînjîri-Mûrungu ûrîa ûthuuri na aathûrîrwa Mûrungu, antûûne a îthe nîwe ûgeekagîra nguû irîa ibuîrîte gwîkîrwa nî mûthînjîri-Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe akaaritaga kîgongwana gîa kûtheria antû arîa atheru, na gîa kûtheria îema rîa gûtirimanîra, na gîa kûtheria kîritîro kîa igongwana, na gîa kûthirîria athînjîri-Mûrungu meeyia, na gîa kûthirîria antû ba Israeli meeyia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kîgongwana gîa kûthiragîria antû ba Israeli meeyia kîritagwa o rîmwe ndeene ya mwaka. Waatho bûu bûthingatagwe magiita jonthe.” Musa arathithia o ta ûrîa MWATHANI aamwîrîte.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
