              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.9+LEV.19.10"
              },
              "items": [
                {
                  "text": "Ala 19.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.19+DEU.24.20+DEU.24.21+DEU.24.22"
              },
              "items": [
                {
                  "text": "Kûr 24.19-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîrîa bûgakethaga maketha ja miuunda yeenu bûgáakethaga bûkinyagia mîthia. Ningî bûgaacokageni kûringa rûûa kûrîa bûketheete. Bûtigaragîrie nkîa na ageni matigari jarîa jatîkethi. Ni nî ni MWATHANI Mûrungu weenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.22",
            "verseOrgIds": [
              "LEV.23.22"
            ]
          }
        }
      ]
