                  "text": "Kûr 5.12-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ritageeni ngûgî ntukû ithanthatû, îndî ntukû ya mûgwanja nî sabatû, ntukû îrîa antû babuîrîte kûnogoka. Ntukû îîu babuîrîte kûûthûranaga bakanthaathayia, na batîbuîrîte kûrita ngûgî. Ntukû îîu îkethagîrwa îrî sabatû yaakwa gûntû kunthe kûrîa bûtûûraga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bibi nî bio biatho birîa ntuîte, birîa bûkanthaathayia bwothûrana, magiita jarîa nkabwîrîra.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
      ]
