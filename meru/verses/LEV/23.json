            "number": "2",
            "style": "v",
            "sid": "LEV 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arîria antû ba Israeli ûbeere ûjû: Biatho bibi nîbio bituui nîkenda bûbikûngwaagîra rîrîa bûkûnthaathayia bûûthûranîte. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.2",
            "verseOrgIds": [
              "LEV.23.2"
            ]
          }
        },
        {
