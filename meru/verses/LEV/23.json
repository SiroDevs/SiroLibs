        },
        {
          "text": " “Mambura ja Pasaka ya MWATHANI jakambagîîria ûgoro bwa ntukû ya îkûmi na inya ya mweri jwa Nisani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23.5",
              "type": "text"
            },
            {
              "text": "Nisani:",
              "type": "text"
            },
            {
              "text": "na Kîibirania nî mweri jwa mbere.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
