          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî aarîîrie Musa aramwîra atîrî, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.23",
            "verseOrgIds": [
              "LEV.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Arîria antû ba Israeli ûbeere ûjû: Ntukû ya mbere ya mweri jwa mûgwanja yakinya, tarumbeta nî îringagwe antû bakoothûrana nîkenda banogoka bakînthaathayia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.24",
            "verseOrgIds": [
              "LEV.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû îîu bûkáaritaga ngûgî indito, ningî bûnditagîre kîgongwana gîa gwakîîria.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.25",
            "verseOrgIds": [
              "LEV.23.25"
            ]
          }
        }
      ]
