            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Kûr 16.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nayo ntukû ya îkûmi na ithaano ya mweri o jûu, nîrîo mambura jaakwa ja mîgaate îtiimbithîtue jakambagîîria. Najo jagakûngwagîrwa ntukû mûgwanja. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû ya mbere ya mambura jau bûgaatigaanaga na ngûgî irîa bûritaga bûûthûranage bûkanthaathayia. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukû ithanthatû nditagîreeni kîgongwana gîa gwakîîria o ntukû o ntukû. Îndî bûtigage ngûgî irîa bûritaga ntukû ya mûgwanja, bûûthûranage bûnthaathagie.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
