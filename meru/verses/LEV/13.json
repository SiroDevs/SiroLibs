              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ntomûrûme kana mûka akëeja kuuma mathainya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.38",
            "verseOrgIds": [
              "LEV.13.38"
