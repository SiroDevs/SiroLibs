          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "mûthînjîri-Mûrungu akamûtega antû au kwajîtue. Akëeja kwona mathainya jagarûkîte rangi jagatuka, rîu mûthînjîri-Mûrungu akaamenya nî mathainya akî jaumîte na atî muntû ûu nî ûmûtheru.",
          "type": "text",
          "attrs": {
