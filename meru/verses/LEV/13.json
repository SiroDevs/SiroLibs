            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 13:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muntû ûrîa ûkëethagîrwa arî na mûrimo jûmûthûûku jwa gîkoonde ageekagîra matani, na arekagîîrie mûtuundu jûgakara jûtîcanûri. Ningî ageetaga aikunîkîte kanyua agîtûmagîîria, Îî ni ntîtheri! Îî ni ntîtheri!” ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.45",
            "verseOrgIds": [
              "LEV.13.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe muntû ûu, agaakaraga arî wenka oome ya kambî nîûntû atîtheri, rîrîa rîonthe akeethîrwa arî na mûrimo jûu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.46",
            "verseOrgIds": [
              "LEV.13.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ûrîa nguû îrî na uumu îbûîrîte kûtherua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 13:46"
          },
          "items": [
            {
              "text": "46",
