          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumeene uumu bûkëeja kuumîra bûkaambîrîria gûtaamba nguûûne ya gûtuma na mîtumi, kana ya ndigi cia bamba kana ya gîntû kîa mûgûûta kîonthe, no mwanka îîthîîrue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
              "LEV.13.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
