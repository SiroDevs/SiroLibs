              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Muntû atîbuîrîte kwendia kana kûgûra gîntû ambathûrîrîte nîûntû gîntû kîu nî gîkîtheru; kinya gîkëethîrwa kîrî kîthaka kana nyomoo kana muntû. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkëethîrwa mbathûrîri muntû arî wa kûûragwa, muntû ûu abuîrîte kûûragwa na atîbuîrîte kûrîîrwa mbeecha akûûrwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
