          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa ntûmîîri ya gûkua gwa Kristû mûtharabeene nî waa kîrî barîa bakûûra îndî kîrî tuî barîa tûkwonokua, ntûmîîri îîu nî inya ya Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
