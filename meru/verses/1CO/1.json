                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Jer 9.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû ta ûrîa Maandîko jakuuga,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.31",
            "verseOrgIds": [
              "1CO.1.31"
            ]
          }
        }
