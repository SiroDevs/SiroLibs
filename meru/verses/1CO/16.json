            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.16"
              },
              "items": [
                {
                  "text": "1Ako 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rîu ataana na aarî ba baaba, nî bwijî atî antû ba nja ya Stefano nîbo baarî ba mbere gwîtîkia ndeene ya Akaia, nabo nî bairitîte nîûntû bwa gûteethia antû ba Mûrungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, ndîbwerenca bwathîkagîre antû ta bau na ningî bwathîkagîre bonthe barîa baritanagîria ngûgî nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkûgwîrîrua kwîja kwa Stefano, na Fotunato amwe na Akaiko antû eenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagûtûma ndaboorera o ta ûrîa bûtûmîte bûboorera. Tontû bûû, tîîageni antû ta baba.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
    },
