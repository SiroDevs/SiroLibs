                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Maj 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nkabûriûngîra ndathiria gûkûrûkîîra Makedonia, tontû no mwanka mbîtîîre ku. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuga ngakara naabuî kagiita gagakai kana kinya nthirîrîe kiingo gîa mpio kûu, nîkenda buî bwîja gûnteethia ngîîta rûgeendo rwaakwa rwa o kunthe kûrîa ngeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû nandî ntîkwenda kûbwona nkûrûkîte akî, ndîrîgîîra gûkara amwe naabuî îgiita rîrîraja këethîra Mwathani akambîtîkîîria.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
