                  "text": "1Ma 13.5-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rîu antû ba Kiriathi-jearimu bareeja barajûkia Îthandûkû rîa MWATHANI, barariikia nyomba ya muntû ûmwe weetagwa Abinadabu ûrîa watûûraga karîmeene. Baretûrîra Eleazari mûtaana waawe maguta nîkenda akamenyagîîra Îthandûkû rîa MWATHANI.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samueli kwatha Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
