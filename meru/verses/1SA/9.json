              "text": "9.25",
              "type": "text"
            },
            {
              "text": "Îgûrûgûrû:",
              "type": "text"
            },
            {
              "text": "Îgiita rîu nyomba ciakagwa îgûrûgûrû rîng'ananîrîtie na antû nî baamenyeretie kûmamaga nao.",
              "type": "text"
            }
          ]
        },
        {
          "text": " rîa nyomba, nawe aramama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
