          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“No mwanka antû bonthe ba Israeli bamenye na mma atî Jesû ûrîa buî bwaambithîrie, nîwe wengwa Mûrungu aeetherie Mwathani na Kristû.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        }
      ]
