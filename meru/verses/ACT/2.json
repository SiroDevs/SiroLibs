              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa tî Daudi waaitîrie îgûrû îndî we nî aaugîre:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.34",
            "verseOrgIds": [
              "ACT.2.34"
            ]
          }
        }
