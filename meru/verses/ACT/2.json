                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.23.33"
              },
              "items": [
                {
                  "text": "Luk 23.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.18"
              },
              "items": [
                {
                  "text": "Joh 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jesû ûûjû, kûringana na mûbango jwa Mûrungu, Mûrungu nî aijî atî bûkamûnenkanîra kîrî eeyia na bamwambe mûtharabeene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.23",
            "verseOrgIds": [
              "ACT.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.28.5+MAT.28.6"
              },
              "items": [
                {
                  "text": "Mat 28.5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.6"
              },
              "items": [
                {
                  "text": "Mar 16.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.5"
              },
              "items": [
                {
                  "text": "Luk 24.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Îndî Mûrungu nî aamûriûkîrie kuuma kîrî gîkuû, na aramûthaûra kuuma kîrî înya yaakîo, nîûntû gîkuû gîtîngîûmba kûmûtheeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.16.8+PSA.16.9+PSA.16.10+PSA.16.11"
              },
              "items": [
                {
                  "text": "Zab 16.8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nîkwîthîrwa Daudi nî aaugîre mantû jamwegiî ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.28",
            "verseOrgIds": [
              "ACT.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ataana ba baaba, ndîenda kûbwîra mantû mpûmîîrîtie atî jûûjû weetû Daudi, nî aakuîre na arathikwa; kinya kaburi kaawe karî aja gweetû kinya naarua tûrî. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.29",
            "verseOrgIds": [
              "ACT.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.11"
              },
              "items": [
                {
                  "text": "Zab 132.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.12+2SA.7.13"
              },
              "items": [
                {
                  "text": "2Sam 7.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû aarî kîroria, nî aijî atî Mûrungu nî aamûciîtîrîtie atî ûmwe wa nchiarwa ciaawe akaa mûnene na aathanage. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.30",
            "verseOrgIds": [
              "ACT.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi nî aarî akwona na aaria auga atî Krîstû akarîûka na ‘ataatiganîîrue akara gwa akuû kana mwîrî jwaawe jwoora.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.31",
            "verseOrgIds": [
              "ACT.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû o ûûjû nîwe Mûrungu aariûkîrie, naatuî twinthe tûrî akûûjî ba ûntû bûu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.32",
            "verseOrgIds": [
              "ACT.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû nî aitithîrue îgûrû mwanka njara ya ûrîo ya Mûrungu na araewa kîewa kîrîa eerîîri nî Îthe kîa Roho Ûmûtheru. Mantû jarîa bûkwona na kwigua nandî nî kîewa kîa Roho ûrîa atûîtûûrîrîtie. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.33",
            "verseOrgIds": [
              "ACT.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
