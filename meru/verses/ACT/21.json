                  "text": "Maj 20.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Baaugîre ûu nîûntû nî baarî bakwona Trofimasi wa kuuma Efeso arî na Paûlû ntûûreene na barathûgaania atî Paûlû nî aarî akûmûkûrûkia kîûrûûne.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
