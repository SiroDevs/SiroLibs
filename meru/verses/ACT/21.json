            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa ntukû iu mûgwanja ciaarî akuî kûthira, Ayahudi bamwe barîa baaumîte Asia nî boonere Paûlû arî kîûrûûne na baraujîîra antû bonthe mwanka baramûgwata ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakiugaga, “Antû ba Israeli, itû tûteethieni! Muntû ûûjû nîwe ûraritanaga gûntû kunthe mantû ja kûthûûmbia antû beetû, na kûthûûmbia Waatho bwa Musa na kinya kûmenithia kîûrû. Amwe na jau, nandî agûkûrûkia antû barîa batî Ayahudi kîûrûûne eekîrithia antû aja atheru mûgiro.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
