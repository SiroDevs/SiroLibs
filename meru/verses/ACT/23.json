              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûtongeeria wa asikarî areeta asikarî baîrî na arabeera, “Thaa kenda cia ûtukû ciakinya, thuranîreni asikarî magana jaîrî, na asikarî mîrongo mûgwanja barîa beetithagia mbarathi, na asikarî magana jaîrî barîa batumagîra matumo, nîkenda beeta Kaisaria. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî thuranîreni mbarathi irîa Paûlû agatûmîra na bûmûkinyie arî thîîria kîrî Felix ûrîa waarî mûrûngamîîri.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûtongeeria ûu araandîka barûga îkiugaga ûjû:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.25",
            "verseOrgIds": [
              "ACT.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
