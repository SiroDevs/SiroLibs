          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa Paûlû aaugîre ûu, Ayahudi baraciîtîra bagîkararanagia bongwa.]",
          "type": "text",
          "attrs": {
            "verseId": "ACT.28.29",
