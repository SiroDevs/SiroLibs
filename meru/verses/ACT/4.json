          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bakanenkera atûmwa mbeecha iu, nabo bakagaîra o muntû o muntû kûringana na ûbatu bwaawe.",
          "type": "text",
