          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atûmwa nî baakûûjagîîra barî na inya înene mono mantû jegiî kûriûka kwa Mwathani Jesû, na Mûrungu arabatharima bonthe na njîra inyingî. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.33",
            "verseOrgIds": [
              "ACT.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
