          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.22",
            "verseOrgIds": [
              "ACT.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peterû na Johana bakûrekeerua nî baacokere kîrî acoore baao na barabeera ûrîa baarî bakwîrwa nî athînjîri-Mûrungu barîa anene na akûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.4.23",
            "verseOrgIds": [
              "ACT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 4:24"
          },
          "items": [
