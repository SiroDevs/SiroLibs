              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ûgaaka îema rîu rîa gûtirimanîra kûringana na mwakîre jûrîa nkwoneretie kîrîmeene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.30",
