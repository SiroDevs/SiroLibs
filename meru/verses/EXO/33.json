                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13"
              },
              "items": [
                {
                  "text": "28.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî eerîre Musa atîrî, “Îteeni buume aja, ûûgwe amwe na antû barîa waaritîre nthîgûrû ya Misri, bwîîte nthîgûrû îrîa ndaaciîtîîrie Abrahamu, na Isaaka na Jakubu ndîrauga, ‘Nkaa nchiarwa cieenu nthîgûrû îîu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naani rî, ngatûma mûraîka mbere yeenu na mpîînge Akanaani, na Aamori, na Ahiti, na Aperizi, na Ahivi, na Ajebusi baume ku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îteeni nthîgûrûûne îrîa nthongi na îrî mûthetu jûmûnoru na ûtonga bûbwingî. Îndî ni ntîîtania naabuî ntîkeeje kûbûthirîria njîreene tontû buî bûrî antû boomîtie mîtwe mono.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.3",
            "verseOrgIds": [
              "EXO.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa antû baigîrue mantû jau jamathûûku, baraithikîîra na gûtî muntû weekîra into biaawe bia kwithongomia nabio. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.4",
            "verseOrgIds": [
              "EXO.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nîkwîthîrwa MWATHANI nî aarî akwîra Musa atîrî, “Îîra antû ba Israeli, ‘Buî bûrî antû boomîtie mîtwe mono. Nkëeja gwîtania naabuî kagiita gagakai ndabûthiria. Nandî riteeni into birîa bwigemagia nabio nîkenda menya ûrîa nkaathithia naabuî.’” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.5",
            "verseOrgIds": [
              "EXO.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bûû, antû ba Israeli bararitîra into birîa baithongomagia nabio au kîrîmeene kîa Horebu na batacoka kûbiîkîra kaîrî.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Îema rîa gûtirimanîra",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nî aamenyeretie kûjûkagia îema rîa gûtirimanîra akarîamba oome ya kambî, gataaria mma. Nawe areeta îema rîu îema rîa gûtirimanîra. O muntû wonthe eenda gûtirimana na MWATHANI nî eetaga îemeene rîu naarîa oome ya kambî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rîonthe Musa agîîta îemeene rîa gûtirimanîra antû bonthe nî bookagîîra, o muntû akarûngama mwariine jwa îema rîaawe, bagategeera Musa mwanka agakûrûka îemeene rîa gûtirimanîra. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aatonya îemeene îtu rîrîa rîakari ta gîtugî nî rîenamaga rîkarûngama mwariine jwa îema rîu rîa gûtirimanîra, nawe MWATHANI rîu akaranîria na Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O rîrîa antû boona îtu rîu rîaakari ta gîtugî rîrûngi mwariine jwa îema, antû bonthe nî bookagîîra bakathaathayia MWATHANI, o muntû wonthe arî mwariine jwa îema rîaawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI aaragia na Musa bategeene ûthiû kwa ûthiû, o ta ûrîa muntû aaragia na mûcoore waawe. Rîrîa Musa aacokaga kambîîne nthûûmba yaawe Joshua mûtaana wa Nuni, ûrîa waarî muntû ûmwîthî, nî aatigagwa îemeene.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maromba ja Musa na wîrane bwa MWATHANI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nawe nî eerîre MWATHANI ûjû, “Atîrî, ûrîmbîîra, ‘Tongeeria antû baba,’ îndî gwe ûtîkûmbîîra nûû ûgeetania naani. Ningî gwe no gwe ûmbîrîte, ‘Nînkwijî na riîtwa rîaaku na nî ngwîrîîtue nîgwe.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nandî rî, itû ndakwerenca këethîra nî ûgwîrîîtue nî ni, mbonereria njîra ciaaku, nîkenda nkûmenya bwega na mbona munya kîrî gwe. Ningî gwe jûkia mûgongo jûjû jûrî antû baaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI aramwîra, “Nkethagîrwa ndî amwe naabuî na nkabwaa kînogoko.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa aramwîra, “Ûkeeja kwîthîrwa gwe ûtîîtania naatuî, ûgaatûrita aja tûrî. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû rî, nîatîa gûkamenyekana atî, nî mboneete munya meethoone jaaku, ûûni amwe na antû baaku? Weetania naatuî nîrîo ûûni amwe na antû baaku tûkoonekana tûrî antû ba mwanya buru na antû bangî bonthe barîa barî nthîgûrûûne.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "MWATHANI nî eerîre Musa atîrî, “Ûntû bûu bungwa waugîra nîbu nkaathithia; nîkwîthîrwa gwe nî wooneete munya meethoone jaakwa na nî nkwijî na riîtwa rîaaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa arauga, “Itû rekeeria mbone weerû bwa ûkumio bwaaku.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.15"
              },
              "items": [
                {
                  "text": "Aro 9.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI aramwîra, “Ngaatûma ûthongi bwaakwa bunthe bûkûrûkîîre mbere yaaku, na nkauga riîtwa rîaakwa, ‘MWATHANI,’ ndî mbere yaaku. Naani nkaigîîrua kîaao o ûrîa nkeenda kwigîîrua kîaao, na mbonanie wendo bwaakwa kîrî o ûrîa nkeenda.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Îndî aramwîra atîrî, “Tîkûrekeeria ûmbona ûthiû, nîkwîthîrwa muntû akambona ûthiû atîcoka gûtûûra mwoyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî MWATHANI aramwîra atîrî, “Kûrî na kaanya rûteere rwaakwa arîa ûûmba kûrûngama iigeene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa weerû bwa ûkumio bwaakwa bûgaakûrûkîîra mbere yaaku, ngaagwîkîra rûkuûne rwa iiga rîu, na nkûthiîke na njara yaakwa mwanka mpambe nkûrûke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu nîrîo nkeebaebia njara yaakwa nîkenda ûmbona mûgongo; îndî ûthiû bwaakwa bûtîûmbwa kwonwa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
            "verseOrgIds": [
              "EXO.33.23"
            ]
          }
        }
      ]
    }
  ],
