      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "MWATHANI kwîra Israeli yume kîrîmeene gîa Sinai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
