          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo barereeria mîînjîro na thaabu na mîkang'i ya kûgwatîîra mîgaamba baramîthithia na thaabu, na mîgaamba nayo baramîereeria na thaabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
