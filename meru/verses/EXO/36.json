          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû bwa mwari jwa îema nî baathithîrie nanga înthongi îtumi na mîtumi ya rangi ya wiirû bwa îgûrû na ya mûkû na întuune. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
