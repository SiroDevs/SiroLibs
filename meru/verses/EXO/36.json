          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na îtaano îngî nîûntû bwa mîînjîro ya rûteere rûngî rwa îema, na îtaano îngî nîûntû bwa mîînjîro ya rûteere rwa rûgûrû rwa îema bwa nyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
