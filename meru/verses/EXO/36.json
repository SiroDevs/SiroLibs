              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ningî nî baathithîrie mîgaamba ya mîtî ya mîgaa, îtaano nîûntû bwa mîînjîro ya rûteere rûmwe rwa îema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
