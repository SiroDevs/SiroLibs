              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mûgaamba jûrîa jwagitanîtie îema gatîgatî kuuma mûthia jûmwe mwanka jûngî, jwagiitanîîrîîtie gatîgatî ka mîînjîro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
