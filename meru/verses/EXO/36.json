              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo barathithia nanga ya rangi ya wiirû bwa îgûrû na ya mûkû na întuune, îtumi bwega. Baragemia nanga îîu na mbicha cia kerubimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
