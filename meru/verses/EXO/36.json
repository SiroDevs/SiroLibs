          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naru rwambambio rûu bararûthithîria itugî bina bia mîgaa na barabiereeria na thaabu. Ningi barabithithîria ikinyithio bina bia fetha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
