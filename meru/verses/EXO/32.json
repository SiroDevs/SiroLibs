              "items": [
                {
                  "text": "Kûg 3.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nandî rî, barekere meeyia jaao na kwëethîrwa ûtîbarekera itû mpaangûra mpuume yukuune rîrîa waandîkaga mantû ja antû.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
