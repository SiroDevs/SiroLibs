            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " MWATHANI nî eerîre Musa atîrî, “Andîka mantû jaja yukuune jarî Kîririkanio kîrî antû na ûjathome Joshua akiigagua, atî nkaathiria Amaleki buru batîkaririkanwe kaîrî nthîgûrûûne.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nî aakîre kîritîro kîa igongwana na aragîîta, “MWATHANI nîwe rwano rwaakwa rwa kûthingataga” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "akiugaga, “Ûkîîria njara rûrigeene rwa MWATHANI! MWATHANI akaarûjaga na Amaleki kuuma nthukî îmwe gwîta îngî.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
