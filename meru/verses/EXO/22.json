          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10+DEU.18.11"
              },
              "items": [
                {
                  "text": "Kûr 18.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bûkarekagîîrieni mûka mûrogi atûûra mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
