                "loc": "DEU.24.10+DEU.24.11+DEU.24.12+DEU.24.13"
              },
              "items": [
                {
                  "text": "Kûr 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ûkarîîja kûjûkia nguû ya muntû ûngî îrûngamîîra îraandû, ûtîkareke riûa rîthûa ûtîcokeretie mwene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontû nguû îîu îkëethîrwa nîyo yonka arî nayo ya gwîkunîkîra nîmbi akaiguîkîra nayo akîmama? Nawe akëeja gûnkaîra, nkamûthikîîra nîûntû ndî wa kîaao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
