              "items": [
                {
                  "text": "Kûr 27.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû ûrîa wonthe ûkamama na nyomoo no mwanka ooragwe.",
          "type": "text",
