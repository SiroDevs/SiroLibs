                  "text": "23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bûkëeja gûkoobithia mbeecha kîrî nkea ya antû baakwa barîa bûtûûranagia nabo bûkabathithagîrieni ja ûrîa aeejani marandû bathithanagîria, bûbeetia mpongeeri îgûrû rîa mbeecha iu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
