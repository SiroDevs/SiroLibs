                }
              ]
            }
          ]
        },
        {
          "text": " “Bûkathithagîrieni ageni ûthûûku kana bûbainyîîria, tontû kinya buî bwatwîre bûrî ageni nthîgûrû ya Misri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkathangîkagieni ntigwa kinya îrîkû kana kaana gatî na aciari. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkëeja kûbathangîkia nabo bagankaîra, gûtî nkaanja nkaigua kîrîro kîaao; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "naani ngwatwe nî marûrû mbûûrage na rûchiû, nabo eekûrû beenu bakaa ntigwa na aana beenu batigwe batî na beethe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        }
