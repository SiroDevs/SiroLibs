              "COL.2.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.1+ROM.14.2+ROM.14.3+ROM.14.4+ROM.14.5+ROM.14.6"
              },
              "items": [
                {
                  "text": "Aro 14.1-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tontû bûû, bûgeetîkîrieni muntû kinya ûrîkû abwîkîra mawaatho jegiî biakûrîa kana biakûnyua kana jegiî mîthenya ya thigûûnkû kana biatho bia mweri jûmwerû kana sabatû. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.16",
            "verseOrgIds": [
              "COL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "COL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû jau jonthe nî mbicha ya ûntû bûrîa bûkeeja; ûntû bûu bungwa nî Kristû. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.17",
            "verseOrgIds": [
              "COL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "COL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûgeetîkîrieni kûgambithua nî muntû kinya ûrîkû ûrîa ûgaga nî oonete bioneki na akabûkinyagîîria bwinyiyie na bûrombage araîka. Muntû wa mûthemba jûu eethagîrwa oojûrîtwe nî wikumia bûtî na gîtûmi tontû bwa mathûgaanio ja nthîgûrû. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.18",
            "verseOrgIds": [
              "COL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.16"
              },
              "items": [
                {
                  "text": "Aef 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tontû bûû, nî baathûrani na Kristû ûrîa ûrî mûtwe na ûrîa ûgwatithanîtie mwîrî junthe na mîkiia na tûgano twaju na agatûma jwoona marero na jûkûra o ta ûrîa Mûrungu endete.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gûkua na gûtûûra amwe na Kristû",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "COL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.19",
            "verseOrgIds": [
              "COL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "COL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bûkëeja kwîthîrwa nî bûkujanîrîtie amwe na Kristû na bwonokua kuuma kîrî inya ya roho inthûûku irîa ciathanaga nthîgûrû, nîmbi îndî îtûmaga bwîta na mbere gûtûûra teeka bûrî ba nthîgûrû îîjî? Nîkî tontû bwathîkagîra mawaatho ta jaja: ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.20",
            "verseOrgIds": [
              "COL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "COL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bûkágwata gîkî,” kana “Bûgácema gîntû kîna,” kana “Bûkáringithia kîrîa.” ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.21",
            "verseOrgIds": [
              "COL.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "COL 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mantû jau jonthe jegiî into birîa biejaga bia ûtheri biathiria gûtumîrwa. Ningî jau jonthe nî mawaatho na mooritani ja antû. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.22",
            "verseOrgIds": [
              "COL.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "COL 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
