          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Zab 69.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû ûmwe nî ogîîre arajûkia kînyaguthi aragîtombeka ndibeiine îrî na ng'ana, na arakîogeera kamûrangiine aramûkundithia akiugaga, “Twetereni twoone këethîra Elija akeeja kûmûrita mûtharabeene.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesû arakaya na kajû gakanene, rîu arakua.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        }
