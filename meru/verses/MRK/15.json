            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamba baîrî nî baambanîrîtue nawe. Ûmwe rûteere rwaawe rwa ûrîo na ûngî rwa ûmotho. [ ",
          "type": "text",
          "attrs": {
