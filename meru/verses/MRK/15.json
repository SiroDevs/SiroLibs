                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maandîko jarîa jaugaga, “Nî aagiitîîrwe îgamba ta ûmwe wa antû babaaî,” jakûûjûra.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
