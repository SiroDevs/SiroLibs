              "items": [
                {
                  "text": "Luk 8.2-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ningî nî kwaarî na eekûrû baaraithîîrîtie barî gataaria. Bamwe baabo baarî Maria Magidalina na Maria ng'ina wa Jakubu ûrîa mwanake na Josesi na Salome. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bau nîbo eekûrû barîa baathingatanaga nawe bakîmûmenyagîîra rîrîa aarî Galili. Ningî nî kwaarî kinya aka bangî barîa baamûthingatîre mwanka Jerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
