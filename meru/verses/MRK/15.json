            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Gîtambaa kîrîa gîacûûrîtue kîûrûûne kîratambûka kuuma îgûrû mwanka nthî, biraa biîrî. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa mûnene wa asikarî ûrîa waarûngi au mbere yaawe aigîrue Jesû agîkaya na kajû gakanene na oona atî agûkua nî augîre, “Nî mma ûûjû araarî Mûtaana wa Mûrungu!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        }
