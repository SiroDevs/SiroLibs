                  "text": "Isa 29.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jesû arabacokeria, “Buî aciaayia! Kîroria Isaya nî aarorerie mantû ja mma jabwegiî rîrîa aandîkîre:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
