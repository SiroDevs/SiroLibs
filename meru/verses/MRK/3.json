          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gûtî muntû ûûmba kûûna nyomba ya muntû ûrî na inya na ajûkia into biaawe, tiga aambe amûtheeke, rîu amûtuunye into. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndîbwîra na mma atî antû bakarekerwa meeyia jaao na kinya irumi birîa barumîte Mûrungu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
          }
        }
      ]
    },
