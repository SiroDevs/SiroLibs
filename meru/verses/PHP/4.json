        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
