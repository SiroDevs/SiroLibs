            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rîrîa nkëethîrwa ndî amwe naabuî kaîrî, bûkeethîrwa bûrî na gîtûmi gîa gwikumia nîûntû bwaakwa na nîûntû bwa ûtûûro bweenu bûrîa bûrî nabu ngwatanîroone na Kristû Jesû.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
