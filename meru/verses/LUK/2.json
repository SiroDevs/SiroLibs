                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Luk 1.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntukû ya inyanya kuuma agûciarwa, kaana nî gaatanîrwe na kareetwa Jesû, riîtwa o rîrîa kaaei nî mûraîka mbere ya kinya ng'ina agîa îu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
