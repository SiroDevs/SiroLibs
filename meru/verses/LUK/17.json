                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muntû wonthe ûrîa ûcwaga kwonokia ûtûûro bwaawe akabwaga. Îndî ûrîa ûraîrwa nî ûtûûro bwaawe akabwonokia. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
