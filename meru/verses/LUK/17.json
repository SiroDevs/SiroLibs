          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.6+GEN.7.7+GEN.7.8+GEN.7.9+GEN.7.10+GEN.7.11+GEN.7.12+GEN.7.13+GEN.7.14+GEN.7.15+GEN.7.16+GEN.7.17+GEN.7.18+GEN.7.19+GEN.7.20+GEN.7.21+GEN.7.22+GEN.7.23+GEN.7.24"
              },
              "items": [
                {
                  "text": "Kîam 7.6-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Antû nî baarîîjaga na bakanyua, na nî baagûranaga na bakagûrwa, mwanka ntukû îrîa Noa aakûrûkîre ndeene ya sabina. Mbura ya maburiko nî yaurîre na îrathiria antû bonthe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
              "LUK.17.27"
            ]
          }
        },
        {
