              },
              "items": [
                {
                  "text": "Mar 13.15-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntukû îîu muntû ûrîa ûkeethîrwa arî îgûrûgûrû rîa nyomba, agákinya nthî kûjûkia into biaawe birîa birî nyomba. Ningî ûrîa ûkeethîrwa arî muundeene, agácoka nja. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
