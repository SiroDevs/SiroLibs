              "items": [
                {
                  "text": "Kîam 6.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " O ta ûrîa gwakari îgiiteene rîa Noa, nîu gûkeethîrwa gûkari rîrîa Mûtaana wa Muntû akeeja. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
