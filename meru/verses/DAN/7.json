              "DAN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jûjû nîju mûthia jwa mantû jau. Ûûni Danieli nî ndaamakîre mono nî mantû jau ndîratuka ûthiû, îndî ndîreeka mantû jau nkoroone.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
