              "type": "text"
            }
          ]
        },
        {
          "text": "Rîu mûnene Dario araandîkîra antû bonthe ba mîgongo yonthe, na nthiomi cionthe barîa baatwîre nthîgûrûûne yonthe arauga atîrî, “Jûkieni nkeethî! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
