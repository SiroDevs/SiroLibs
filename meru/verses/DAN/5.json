        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
