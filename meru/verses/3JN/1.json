                }
              ]
            }
          ]
        },
        {
          "text": " Nî ni mûkûrû wa Kanisa ngûkwaandîkîra gwe Gayo, mûcoore waakwa ûrîa mpendeete mma.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
