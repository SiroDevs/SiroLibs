              "type": "text"
            }
          ]
        },
        {
          "text": "Ainsi dit l'",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.13",
            "verseOrgIds": [
              "AMO.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.13",
                "verseOrgIds": [
                  "AMO.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": ": À cause de trois transgressions des fils d'Ammon, et à cause de quatre, je ne le",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.13",
            "verseOrgIds": [
              "AMO.1.13"
            ]
          }
        },
        {
          "text": "révoquerai point, parce qu'ils ont fendu le ventre aux femmes enceintes de Galaad, afin d'élargir leurs frontières ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.13",
            "verseOrgIds": [
              "AMO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "et j'allumerai un feu dans les murs de Rabba, et il dévorera ses palais, au milieu des cris au jour de la bataille, au milieu de la tempête au jour du tourbillon ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.14",
            "verseOrgIds": [
              "AMO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "et leur roi ira en captivité, lui et ses princes ensemble, dit l'",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.15",
            "verseOrgIds": [
              "AMO.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.15",
                "verseOrgIds": [
                  "AMO.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.15",
            "verseOrgIds": [
