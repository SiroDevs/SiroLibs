              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Telle est la loi de l'holocauste, de l'offrande de gâteau, et du sacrifice pour le péché, et du sacrifice pour le délit, et du sacrifice de consécration, et du sacrifice de prospérités,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
