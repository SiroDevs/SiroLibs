                "verseId": "LEV.7.38",
                "verseOrgIds": [
                  "LEV.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "commanda à Moïse sur la montagne de Sinaï, le jour où il commanda aux fils d'Israël de présenter leurs offrandes",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
