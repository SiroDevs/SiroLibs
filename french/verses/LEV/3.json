                "verseId": "LEV.3.14",
                "verseOrgIds": [
                  "LEV.3.14"
                ]
              }
            }
          ]
        },
        {
          "text": ": la graisse qui couvre l'intérieur, et toute la graisse qui est sur l'intérieur,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
