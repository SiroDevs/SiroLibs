            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et si son offrande est une chèvre, il la présentera devant l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
