          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "[C'est] un statut perpétuel, en vos générations, dans toutes vos habitations : vous ne mangerez aucune graisse ni aucun sang.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.17",
