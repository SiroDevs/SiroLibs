          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "et il en présentera son offrande, un sacrifice par feu à l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.14",
            "verseOrgIds": [
              "LEV.3.14"
            ]
          }
        },
        {
