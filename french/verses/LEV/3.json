          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il présentera, du sacrifice de prospérités, un sacrifice fait par feu à l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
