                "verseId": "LEV.3.9",
                "verseOrgIds": [
                  "LEV.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": ": sa graisse, la queue qu'on ôtera entière jusque contre l'échine, et la graisse qui couvre l'intérieur, et toute la graisse qui est sur l'intérieur,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
