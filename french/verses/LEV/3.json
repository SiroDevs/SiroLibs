          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "et le sacrificateur les fera fumer sur l'autel : [c'est] un pain de sacrifice par feu, en odeur agréable. Toute graisse appartient à l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
