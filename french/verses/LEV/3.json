          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "et le sacrificateur fera fumer cela sur l'autel : [c'est] un pain de sacrifice par feu à l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        },
        {
