          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et si son offrande pour le sacrifice de prospérités à l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "LEV.3.6",
                "verseOrgIds": [
                  "LEV.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "est de menu bétail, mâle ou femelle, il le présentera sans défaut.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si c'est un agneau qu'il présente pour son offrande, il le présentera devant l'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "char",
