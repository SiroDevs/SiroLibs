{
  "id": "JOB.36",
  "number": "36",
  "bookId": "JOB",
  "reference": "Job 36",
  "copyright": "Texte libre de droits",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "JOB 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Élihu continua et dit :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.1",
            "verseOrgIds": [
              "JOB.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Attends-moi un peu, et je te montrerai que j'ai encore des paroles pour",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✝Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.2",
                "verseOrgIds": [
                  "JOB.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.2",
            "verseOrgIds": [
              "JOB.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'apporterai de loin ce que je sais, et je donnerai justice à mon créateur.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.3",
            "verseOrgIds": [
              "JOB.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car certainement mes discours ne sont pas des mensonges ; celui qui est parfait",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        },
        {
          "text": "en connaissances est avec toi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.4",
            "verseOrgIds": [
              "JOB.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.5",
                "verseOrgIds": [
                  "JOB.36.5"
                ]
              }
            }
          ]
        },
        {
          "text": "est puissant et ne méprise personne ; il est puissant en force d'intelligence",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.5",
            "verseOrgIds": [
              "JOB.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il ne fait pas vivre le méchant, mais il fait droit aux malheureux.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.6",
            "verseOrgIds": [
              "JOB.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il ne retire pas ses yeux de dessus le juste, et [celui-ci] est avec les rois sur le trône, et il les fait asseoir à toujours, et ils sont élevés.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.7",
            "verseOrgIds": [
              "JOB.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et si, liés dans les chaînes, ils sont pris dans les cordeaux du malheur,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.8",
            "verseOrgIds": [
              "JOB.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il leur montre ce qu'ils ont fait, et leurs transgressions, parce qu'elles sont devenues grandes",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.9",
            "verseOrgIds": [
              "JOB.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il ouvre leurs oreilles à la discipline, et leur dit de revenir de l'iniquité.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.10",
            "verseOrgIds": [
              "JOB.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "S'ils écoutent et le servent, ils accompliront leurs jours dans la prospérité et leurs années dans les choses agréables [de la vie] ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.11",
            "verseOrgIds": [
              "JOB.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais s'ils n'écoutent pas, ils s'en iront par l'épée, et expireront sans connaissance.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.12",
            "verseOrgIds": [
              "JOB.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les hypocrites",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        },
        {
          "text": "de cœur amassent la colère ; ils ne crient pas quand [",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.13",
                "verseOrgIds": [
                  "JOB.36.13"
                ]
              }
            }
          ]
        },
        {
          "text": "] les lie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.13",
            "verseOrgIds": [
              "JOB.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils mourront dans la jeunesse, et leur vie est parmi les hommes voués à l'infamie.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.14",
            "verseOrgIds": [
              "JOB.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il délivre le malheureux dans son malheur, et lui ouvre l'oreille dans l'oppression.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.15",
            "verseOrgIds": [
              "JOB.36.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il t'aurait aussi tiré de la gueule de la détresse [et mis] au large, là où il n'y a point de gêne, et la graisse abonderait dans les mets de ta table",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.16",
            "verseOrgIds": [
              "JOB.36.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais tu es plein des jugements",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        },
        {
          "text": "des méchants ; le jugement et la justice [te] saisiront.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.17",
            "verseOrgIds": [
              "JOB.36.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puisqu'il y a de la colère, prends garde qu'elle ne t'enlève par le châtiment ; et une grande rançon ne te le fera pas éviter.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.18",
            "verseOrgIds": [
              "JOB.36.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiendra-t-il compte de tes richesses ? Non ; – ni de l'or, ni de toutes les ressources de la puissance.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.19",
            "verseOrgIds": [
              "JOB.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne soupire pas après la nuit qui enlèvera les peuples de leur place.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.20",
            "verseOrgIds": [
              "JOB.36.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Prends garde à toi ! Ne te tourne pas vers l'iniquité, car c'est ce que tu as choisi plutôt que l'affliction",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.21",
            "verseOrgIds": [
              "JOB.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.22",
                "verseOrgIds": [
                  "JOB.36.22"
                ]
              }
            }
          ]
        },
        {
          "text": "se montre élevé dans sa puissance : qui enseigne comme lui ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui lui a prescrit son chemin, et qui a dit : Tu as mal agi ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Souviens-toi de glorifier son œuvre, que les hommes célèbrent :",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tout homme la contemple, le mortel la regarde de loin.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "JOB.36.26",
                "verseOrgIds": [
                  "JOB.36.26"
                ]
              }
            }
          ]
        },
        {
          "text": "est grand, et nous ne le connaissons pas ; le nombre de ses années, nul ne le sonde.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il attire les gouttes d'eau : des vapeurs qu'il forme elles distillent la pluie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que les nuages font couler ; ils tombent en gouttes sur les hommes, abondamment",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 36:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais qui peut comprendre le déploiement de la nuée, le fracas de son tabernacle ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.29",
            "verseOrgIds": [
              "JOB.36.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 36:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, il étend sa lumière autour de lui, et couvre le fond",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        },
        {
          "text": "de la mer.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.30",
            "verseOrgIds": [
              "JOB.36.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 36:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car par ces choses il juge les peuples, il donne la nourriture en abondance.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.31",
            "verseOrgIds": [
              "JOB.36.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il couvre ses mains de l'éclair",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        },
        {
          "text": ", et lui commande où il doit frapper",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.32",
            "verseOrgIds": [
              "JOB.36.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Son bruit l'annonce, le bétail même en présage la venue !",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.33",
            "verseOrgIds": [
              "JOB.36.33"
            ]
          }
        }
