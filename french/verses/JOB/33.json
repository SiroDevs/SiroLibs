          "text": "les hommes, et dira : J'ai péché et j'ai perverti la droiture, et il ne me l'a pas rendu ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.27",
            "verseOrgIds": [
              "JOB.33.27"
            ]
          }
        }
