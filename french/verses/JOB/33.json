                "verseOrgIds": [
                  "JOB.33.26"
                ]
              }
            }
          ]
        },
        {
          "text": "] l'aura pour agréable ; et il verra sa face avec des chants de triomphe, et [",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.26",
            "verseOrgIds": [
