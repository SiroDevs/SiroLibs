              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il a délivré mon âme pour qu'elle n'aille pas dans la fosse, et ma vie verra la lumière.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.33.28",
            "verseOrgIds": [
              "JOB.33.28"
            ]
          }
        }
      ]
