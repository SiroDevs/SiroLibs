                "verseOrgIds": [
                  "1KI.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "avait dépossédés devant les fils d'Israël.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
