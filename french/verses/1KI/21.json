          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.25",
                "verseOrgIds": [
                  "1KI.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", sa femme Jézabel le poussant.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
