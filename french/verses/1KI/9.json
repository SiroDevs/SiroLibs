                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ". Et il acheva la maison.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        }
