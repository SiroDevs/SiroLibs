          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils allèrent à Ophir, et y prirent de l'or, 420 talents, et les apportèrent au roi Salomon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
            "verseOrgIds": [
