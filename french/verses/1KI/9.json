        },
        {
          "text": "Et Salomon offrait trois fois par an des holocaustes et des sacrifices de prospérités sur l'autel qu'il avait bâti pour l'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1KI.9.25",
                "verseOrgIds": [
                  "1KI.9.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", et il faisait fumer l'encens sur celui qui était devant l'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.25",
            "verseOrgIds": [
              "1KI.9.25"
            ]
          }
        },
        {
          "name": "char",
