            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Personne ne vit jamais",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
