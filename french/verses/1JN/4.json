                "verseOrgIds": [
                  "1JN.4.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; et ceci est l'[esprit]",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.3",
            "verseOrgIds": [
              "1JN.4.3"
            ]
          }
        },
        {
          "text": "de l'antichrist, duquel vous avez entendu dire qu'il vient, et déjà maintenant il est dans le monde.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.3",
            "verseOrgIds": [
              "1JN.4.3"
            ]
          }
        },
        {
