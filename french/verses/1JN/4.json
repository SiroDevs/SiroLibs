              "type": "text"
            }
          ]
        },
        {
          "text": "Si quelqu'un dit : J'aime",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.20",
            "verseOrgIds": [
              "1JN.4.20"
            ]
