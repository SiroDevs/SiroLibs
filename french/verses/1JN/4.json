          ]
        },
        {
          "text": ": tout esprit qui confesse Jésus Christ venu en chair est de",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.2",
            "verseOrgIds": [
              "1JN.4.2"
            ]
          }
        },
