                "verseOrgIds": [
                  "1JN.4.12"
                ]
              }
            }
          ]
        },
        {
          "text": "; si nous nous aimons l'un l'autre,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
