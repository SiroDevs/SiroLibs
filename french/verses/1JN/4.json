          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1JN.4.6",
                "verseOrgIds": [
                  "1JN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "; celui qui connaît",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.6",
            "verseOrgIds": [
              "1JN.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1JN.4.6",
                "verseOrgIds": [
                  "1JN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nous écoute ; celui qui n'est pas de",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.6",
            "verseOrgIds": [
              "1JN.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1JN.4.6",
                "verseOrgIds": [
                  "1JN.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ne nous écoute pas : à cela nous connaissons l'esprit de vérité et l'esprit d'erreur.",
