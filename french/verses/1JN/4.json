          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1JN.4.20",
                "verseOrgIds": [
                  "1JN.4.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", et qu'il haïsse son frère, il est menteur ; car celui qui n'aime pas son frère qu'il voit, comment peut-il aimer",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.20",
            "verseOrgIds": [
