            "style": "v",
            "sid": "1JN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour vous, enfants, vous êtes de",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.4",
            "verseOrgIds": [
              "1JN.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
