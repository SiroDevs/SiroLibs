                "verseOrgIds": [
                  "ROM.3.29"
                ]
              }
            }
          ]
        },
        {
          "text": "des Juifs ? ne l'est-il pas aussi des nations ? – Certes, aussi des nations ;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.29",
            "verseOrgIds": [
              "ROM.3.29"
            ]
          }
        },
