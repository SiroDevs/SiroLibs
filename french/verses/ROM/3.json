                "verseOrgIds": [
                  "ROM.3.30"
                ]
              }
            }
          ]
        },
        {
          "text": "qui justifiera la circoncision sur le principe de [la] foi et l'incirconcision par la foi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.30",
            "verseOrgIds": [
              "ROM.3.30"
            ]
          }
        },
