              "type": "text",
              "attrs": {
                "verseId": "ROM.3.29",
                "verseOrgIds": [
                  "ROM.3.29"
                ]
              }
            }
          ]
        },
        {
          "text": "] est-il seulement le",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.29",
            "verseOrgIds": [
              "ROM.3.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
