              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "puisque c'est un seul",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.30",
            "verseOrgIds": [
              "ROM.3.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
