              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il ne foule pas l'aneth avec un traîneau à tranchants et ne fait pas tourner la roue du chariot sur le cumin ; car on bat l'aneth avec un bâton et le cumin avec une verge :",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.27",
            "verseOrgIds": [
              "ISA.28.27"
            ]
          }
        },
