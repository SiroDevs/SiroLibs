              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cela aussi vient de l'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.29",
            "verseOrgIds": [
              "ISA.28.29"
            ]
          }
