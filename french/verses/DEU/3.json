          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et nous avons habité dans la vallée, vis-à-vis de Beth-Péor.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
            "verseOrgIds": [
              "DEU.3.29"
            ]
