          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tu entres dans la vigne de ton prochain, tu pourras manger des raisins selon ton appétit et te rassasier ; mais tu n'en mettras pas dans ta corbeille.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tu entres dans les blés de ton prochain, tu pourras arracher des épis avec ta main ; mais tu ne lèveras pas la faucille sur les blés de ton prochain.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.26",
            "verseOrgIds": [
              "DEU.23.26"
            ]
          }
        }
      ]
