              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", ton",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", te bénira dans toute ta récolte",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "text": "et dans tout l'ouvrage de tes mains ; et tu ne seras que joyeux.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
