              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu ne feras pas fléchir le jugement ; tu ne feras pas acception de personnes ; et tu ne recevras pas de présent ; car le présent aveugle les yeux des sages et pervertit les paroles des justes.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.19",
            "verseOrgIds": [
              "DEU.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
