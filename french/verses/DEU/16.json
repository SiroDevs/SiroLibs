                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", au lieu qu'il aura choisi : à la fête des pains sans levain, et à la fête des semaines, et à la fête des tabernacles ; et on ne paraîtra pas devant l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
