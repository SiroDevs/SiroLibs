                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "aura choisi, car l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
