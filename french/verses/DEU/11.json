          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "afin que vos jours et les jours de vos fils, sur la terre que l'",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "char",
