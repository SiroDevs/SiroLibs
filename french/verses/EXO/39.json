              "type": "text"
            }
          ]
        },
        {
          "text": "Et tout le travail du tabernacle de la tente d'assignation fut achevé ; et les fils d'Israël firent selon tout ce que l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
