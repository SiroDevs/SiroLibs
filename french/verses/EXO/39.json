              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "et la couverture de peaux de béliers teintes en rouge, et la couverture de peaux de taissons, et le voile qui sert de rideau",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
