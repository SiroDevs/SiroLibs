              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "et à lui et à Oholiab, fils d'Akhisamac, de la tribu de Dan, il a mis au cœur d'enseigner ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
