              "type": "text"
            }
          ]
        },
        {
          "text": "et pour tailler des pierres à enchâsser, et pour tailler le bois, afin d'exécuter des dessins en toutes sortes d'ouvrages ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
