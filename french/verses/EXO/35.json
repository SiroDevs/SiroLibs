          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "et les aromates, et l'huile pour le luminaire, et pour l'huile de l'onction, et pour l'encens des drogues odoriférantes.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.28",
