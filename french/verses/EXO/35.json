                "verseOrgIds": [
                  "EXO.35.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", en sagesse, en intelligence, et en connaissance, et pour toute espèce d'ouvrages ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.31",
            "verseOrgIds": [
              "EXO.35.31"
