                "verseOrgIds": [
                  "EXO.35.30"
                ]
              }
            }
          ]
        },
        {
          "text": "a appelé par nom Betsaleël, fils d'Uri, fils de Hur, de la tribu de Juda ;",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
