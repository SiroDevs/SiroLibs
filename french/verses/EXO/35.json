                  "EXO.35.29"
                ]
              }
            }
          ]
        },
        {
          "text": "avait commandé de faire, apportèrent une offrande volontaire à l'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.29",
            "verseOrgIds": [
              "EXO.35.29"
            ]
