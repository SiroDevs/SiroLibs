          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les grenouilles monteront sur toi, et sur ton peuple, et sur tous tes serviteurs.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.29",
            "verseOrgIds": [
              "EXO.7.29"
            ]
          }
