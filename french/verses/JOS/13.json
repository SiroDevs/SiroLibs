          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "et la moitié de Galaad, et Ashtaroth, et Édréhi, villes du royaume d'Og, en Basan, furent aux fils de Makir, fils de Manassé, à la moitié des fils de Makir, selon leurs familles.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
