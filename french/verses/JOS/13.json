          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "leur territoire était depuis Mahanaïm : tout Basan, tout le royaume d'Og, roi de Basan, et tous les bourgs de Jaïr, qui sont en Basan, 60 villes ;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
