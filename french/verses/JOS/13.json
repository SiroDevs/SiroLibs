            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est là ce que Moïse distribua en héritage dans les plaines de Moab, au-delà du Jourdain de Jéricho, vers le levant.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        }
      ]
    },
