      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 71:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aussi, mon",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.71.22",
                "verseOrgIds": [
                  "PSA.71.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", je te célébrerai avec le luth",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        },
        {
          "text": ", [je louerai] ta vérité ; je chanterai tes louanges avec la harpe, ô Saint d'Israël !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.22",
            "verseOrgIds": [
              "PSA.71.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
