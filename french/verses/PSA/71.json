              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mes lèvres, et mon âme, que tu as rachetée, exulteront quand je chanterai tes louanges.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.23",
            "verseOrgIds": [
              "PSA.71.23"
            ]
          }
        }
      ]
    },
