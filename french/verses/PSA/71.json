          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu multiplieras ma grandeur, et tu te tourneras, tu me consoleras.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.21",
            "verseOrgIds": [
              "PSA.71.21"
            ]
          }
        }
      ]
    },
    {
