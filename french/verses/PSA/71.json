          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma langue aussi redira tout le jour ta justice ; car ils seront honteux, car ils seront confondus, ceux qui cherchent mon malheur.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.71.24",
            "verseOrgIds": [
