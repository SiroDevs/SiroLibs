{
  "id": "PSA.36",
  "number": "36",
  "bookId": "PSA",
  "reference": "Psaumes 36",
  "copyright": "Texte libre de droits",
  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
        "style": "c",
        "sid": "PSA 36"
      },
      "items": [
        {
          "text": "36",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au chef de musique. Du serviteur de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.1",
                "verseOrgIds": [
                  "PSA.36.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". De David.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.1",
            "verseOrgIds": [
              "PSA.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "La transgression du méchant dit",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        },
        {
          "text": ", au-dedans de mon cœur, qu'il n'y a point de crainte de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.2",
                "verseOrgIds": [
                  "PSA.36.2"
                ]
              }
            }
          ]
        },
        {
          "text": "devant ses yeux.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.2",
            "verseOrgIds": [
              "PSA.36.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il se flatte à ses propres yeux quand son iniquité se présente pour être haïe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.3",
            "verseOrgIds": [
              "PSA.36.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les paroles de sa bouche sont iniquité et tromperie ; il s'est désisté d'être sage, de faire le bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.4",
            "verseOrgIds": [
              "PSA.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il médite la vanité",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        },
        {
          "text": "sur son lit ; il se tient sur un chemin qui n'est pas bon ; il n'a point en horreur le mal.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.5",
            "verseOrgIds": [
              "PSA.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.6",
                "verseOrgIds": [
                  "PSA.36.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", ta bonté est dans les cieux, ta fidélité [atteint] jusqu'aux nues.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.6",
            "verseOrgIds": [
              "PSA.36.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta justice est comme de hautes montagnes",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        },
        {
          "text": "; tes jugements sont un grand abîme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.7",
                "verseOrgIds": [
                  "PSA.36.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", tu sauves l'homme et la bête.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.7",
            "verseOrgIds": [
              "PSA.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Combien est précieuse ta bonté, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.36.8",
                "verseOrgIds": [
                  "PSA.36.8"
                ]
              }
            }
          ]
        },
        {
          "text": "! Aussi les fils des hommes se réfugient sous l'ombre de tes ailes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.8",
            "verseOrgIds": [
              "PSA.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils seront abondamment rassasiés de la graisse de ta maison, et tu les abreuveras au fleuve de tes délices ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.9",
            "verseOrgIds": [
              "PSA.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car par-devers toi est la source de la vie, en ta lumière nous verrons la lumière.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.10",
            "verseOrgIds": [
              "PSA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Continue ta bonté à ceux qui te connaissent, et ta justice à ceux qui sont droits de cœur.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.11",
            "verseOrgIds": [
              "PSA.36.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que le pied de l'orgueil ne m'atteigne pas, et que la main des méchants ne me chasse pas loin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.12",
            "verseOrgIds": [
              "PSA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Là sont tombés les ouvriers d'iniquité ; ils ont été renversés, et n'ont pu se relever.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.36.13",
            "verseOrgIds": [
              "PSA.36.13"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.37",
    "number": "37",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.35",
    "number": "35",
