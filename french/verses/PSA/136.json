            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Célébrez l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.1",
            "verseOrgIds": [
              "PSA.136.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.136.1",
                "verseOrgIds": [
                  "PSA.136.1"
                ]
              }
            }
          ]
        },
        {
          "text": "! Car il",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.1",
            "verseOrgIds": [
              "PSA.136.1"
            ]
          }
        },
        {
          "text": "est bon ; car sa bonté demeure à toujours",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.1",
            "verseOrgIds": [
              "PSA.136.1"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.1",
            "verseOrgIds": [
              "PSA.136.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
