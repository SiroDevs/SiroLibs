          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Célébrez le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.2",
            "verseOrgIds": [
              "PSA.136.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.136.2",
                "verseOrgIds": [
                  "PSA.136.2"
                ]
              }
            }
          ]
        },
        {
          "text": "des dieux ! car sa bonté demeure à toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.2",
            "verseOrgIds": [
              "PSA.136.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 136:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Célébrez le Seigneur des seigneurs ! car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.3",
            "verseOrgIds": [
              "PSA.136.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 136:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Celui qui seul fait de grandes merveilles, car sa bonté demeure à toujours :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.4",
            "verseOrgIds": [
              "PSA.136.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 136:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a fait les cieux par [son] intelligence, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.5",
            "verseOrgIds": [
              "PSA.136.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 136:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a étendu la terre sur les eaux, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.6",
            "verseOrgIds": [
              "PSA.136.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 136:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a fait de grands luminaires, car sa bonté demeure à toujours :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.7",
            "verseOrgIds": [
              "PSA.136.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 136:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le soleil pour dominer sur le jour, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.8",
            "verseOrgIds": [
              "PSA.136.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 136:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "La lune et les étoiles pour dominer sur la nuit, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.9",
            "verseOrgIds": [
              "PSA.136.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 136:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a frappé l'Égypte en ses premiers-nés, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.10",
            "verseOrgIds": [
              "PSA.136.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 136:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et a fait sortir Israël du milieu d'eux, car sa bonté demeure à toujours, –",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.11",
            "verseOrgIds": [
              "PSA.136.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 136:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "À main forte et à bras étendu, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.12",
            "verseOrgIds": [
              "PSA.136.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 136:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a divisé en deux la mer Rouge, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.13",
            "verseOrgIds": [
              "PSA.136.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 136:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et a fait passer Israël au milieu d'elle, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.14",
            "verseOrgIds": [
              "PSA.136.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 136:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et a précipité le Pharaon et son armée dans la mer Rouge, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.15",
            "verseOrgIds": [
              "PSA.136.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 136:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a conduit son peuple par le désert, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.16",
            "verseOrgIds": [
              "PSA.136.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 136:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui a frappé de grands rois, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.17",
            "verseOrgIds": [
              "PSA.136.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 136:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et a tué de puissants rois, car sa bonté demeure à toujours :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.18",
            "verseOrgIds": [
              "PSA.136.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 136:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sihon, roi des Amoréens, car sa bonté demeure à toujours,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.19",
            "verseOrgIds": [
              "PSA.136.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 136:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Og, roi de Basan, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.20",
            "verseOrgIds": [
              "PSA.136.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 136:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et a donné leur pays en héritage, car sa bonté demeure à toujours, –",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.21",
            "verseOrgIds": [
              "PSA.136.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 136:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "En héritage à Israël, son serviteur, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.22",
            "verseOrgIds": [
              "PSA.136.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 136:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui, dans notre bas état, s'est souvenu de nous, car sa bonté demeure à toujours,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.23",
            "verseOrgIds": [
              "PSA.136.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 136:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et nous a délivrés de nos ennemis, car sa bonté demeure à toujours ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.24",
            "verseOrgIds": [
              "PSA.136.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PSA 136:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui donne du pain à toute chair, car sa bonté demeure à toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.25",
            "verseOrgIds": [
              "PSA.136.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PSA 136:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Célébrez le",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.26",
            "verseOrgIds": [
              "PSA.136.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.136.26",
                "verseOrgIds": [
                  "PSA.136.26"
                ]
              }
            }
          ]
        },
        {
          "text": "des cieux ! Car sa bonté demeure à toujours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.136.26",
            "verseOrgIds": [
              "PSA.136.26"
            ]
          }
        }
