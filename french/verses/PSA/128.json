    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 128:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantique des degrés. Bienheureux quiconque craint l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.1",
                "verseOrgIds": [
                  "PSA.128.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", [et] marche dans ses voies !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.1",
            "verseOrgIds": [
              "PSA.128.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 128:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car tu mangeras du travail de tes mains ; tu seras bienheureux, et tu seras entouré de biens",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.2",
            "verseOrgIds": [
              "PSA.128.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 128:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta femme sera au-dedans de ta maison comme une vigne féconde",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        },
        {
          "text": "; tes fils seront comme des plants d'oliviers autour de ta table.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.3",
            "verseOrgIds": [
              "PSA.128.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 128:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, ainsi sera béni l'homme qui craint l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.4",
                "verseOrgIds": [
                  "PSA.128.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.4",
            "verseOrgIds": [
              "PSA.128.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 128:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.128.5",
                "verseOrgIds": [
                  "PSA.128.5"
                ]
              }
            }
          ]
        },
        {
          "text": "te bénira de Sion. Et puisses-tu voir le bien de Jérusalem tous les jours de ta vie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.5",
            "verseOrgIds": [
              "PSA.128.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 128:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et voir des fils de tes fils ! La paix soit sur",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        },
        {
          "text": "Israël !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
      ]
    }
  ],
