        },
        {
          "text": "De David. Psaume. L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.110.1",
                "verseOrgIds": [
                  "PSA.110.1"
                ]
              }
            }
          ]
        },
        {
          "text": "a dit à mon Seigneur : Assieds-toi à ma droite, jusqu'à ce que je mette tes ennemis pour le marchepied de tes pieds.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.1",
            "verseOrgIds": [
              "PSA.110.1"
            ]
          }
        }
      ]
    },
