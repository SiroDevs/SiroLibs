            "number": "7",
            "style": "v",
            "sid": "PSA 110:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il boira du torrent dans le chemin, c'est pourquoi il lèvera haut la tête.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.7",
            "verseOrgIds": [
              "PSA.110.7"
            ]
          }
        }
