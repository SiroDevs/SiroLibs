                "verseId": "PSA.110.2",
                "verseOrgIds": [
                  "PSA.110.2"
                ]
              }
            }
          ]
        },
        {
          "text": "enverra de Sion la verge",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        },
        {
          "text": "de ta force : Domine au milieu de tes ennemis !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.110.2",
            "verseOrgIds": [
              "PSA.110.2"
            ]
          }
        }
      ]
    },
