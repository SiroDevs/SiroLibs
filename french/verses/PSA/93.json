          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tes témoignages sont très sûrs. La sainteté sied à ta maison, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.93.5",
                "verseOrgIds": [
                  "PSA.93.5"
                ]
              }
            }
          ]
        },
        {
          "text": "! pour de longs jours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.5",
            "verseOrgIds": [
              "PSA.93.5"
            ]
          }
        }
