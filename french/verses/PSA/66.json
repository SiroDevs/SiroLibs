{
  "id": "PSA.66",
  "number": "66",
  "bookId": "PSA",
  "reference": "Psaumes 66",
  "copyright": "Texte libre de droits",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "66",
        "style": "c",
        "sid": "PSA 66"
      },
      "items": [
        {
          "text": "66",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Au chef de musique. Cantique. Psaume. Poussez des cris de joie vers",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.1",
                "verseOrgIds": [
                  "PSA.66.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", toute la terre !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.1",
            "verseOrgIds": [
              "PSA.66.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chantez la gloire de son nom, rendez glorieuse sa louange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.2",
            "verseOrgIds": [
              "PSA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dites à",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.3",
                "verseOrgIds": [
                  "PSA.66.3"
                ]
              }
            }
          ]
        },
        {
          "text": ": Que tes œuvres sont terribles ! Tes ennemis se soumettent",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        },
        {
          "text": "à toi, à cause de la grandeur de ta force.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.3",
            "verseOrgIds": [
              "PSA.66.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toute la terre se prosternera devant toi, et chantera tes louanges ; elle chantera ton nom. Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.4",
            "verseOrgIds": [
              "PSA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venez, et voyez les œuvres de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.5",
                "verseOrgIds": [
                  "PSA.66.5"
                ]
              }
            }
          ]
        },
        {
          "text": ": il est terrible dans ses actes envers les fils des hommes.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.5",
            "verseOrgIds": [
              "PSA.66.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il changea la mer en terre sèche ; ils passèrent le fleuve à pied : là nous nous sommes réjouis en lui.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.6",
            "verseOrgIds": [
              "PSA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il domine par sa puissance pour toujours ; ses yeux observent les nations. Que les rebelles ne s'élèvent pas ! Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.7",
            "verseOrgIds": [
              "PSA.66.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peuples, bénissez notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.8",
                "verseOrgIds": [
                  "PSA.66.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", et faites entendre la voix de sa louange.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.8",
            "verseOrgIds": [
              "PSA.66.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est lui qui a conservé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        },
        {
          "text": "notre âme en vie, et il n'a pas permis que nos pieds soient ébranlés.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.9",
            "verseOrgIds": [
              "PSA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 66:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.10",
                "verseOrgIds": [
                  "PSA.66.10"
                ]
              }
            }
          ]
        },
        {
          "text": "! tu nous as éprouvés, tu nous as affinés comme on affine l'argent ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.10",
            "verseOrgIds": [
              "PSA.66.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu nous as fait entrer dans le filet, tu as mis un fardeau accablant sur nos reins ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.11",
            "verseOrgIds": [
              "PSA.66.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tu as fait passer",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        },
        {
          "text": "les hommes sur notre tête ; nous sommes entrés dans le feu et dans l'eau, et tu nous as fait sortir dans un lieu spacieux.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.12",
            "verseOrgIds": [
              "PSA.66.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'entrerai dans ta maison avec des holocaustes ; j'acquitterai envers toi mes vœux,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.13",
            "verseOrgIds": [
              "PSA.66.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ce que mes lèvres ont proféré, et que ma bouche a dit dans ma détresse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.14",
            "verseOrgIds": [
              "PSA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je t'offrirai des holocaustes de bêtes grasses, avec l'encens des béliers ; je sacrifierai du gros bétail avec des boucs. Sélah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.15",
            "verseOrgIds": [
              "PSA.66.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venez, écoutez, vous tous qui craignez",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.16",
            "verseOrgIds": [
              "PSA.66.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.16",
                "verseOrgIds": [
                  "PSA.66.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", et je raconterai ce qu'il a fait pour mon âme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.16",
            "verseOrgIds": [
              "PSA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai crié à lui de ma bouche, et il a été exalté par ma langue.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.17",
            "verseOrgIds": [
              "PSA.66.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si j'avais regardé l'iniquité dans mon cœur, le Seigneur ne m'aurait pas écouté.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.18",
            "verseOrgIds": [
              "PSA.66.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cependant",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.19",
            "verseOrgIds": [
              "PSA.66.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.19",
                "verseOrgIds": [
                  "PSA.66.19"
                ]
              }
            }
          ]
        },
        {
          "text": "m'a écouté ; il a fait attention à la voix de ma prière.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.19",
            "verseOrgIds": [
              "PSA.66.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Béni soit",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.20",
            "verseOrgIds": [
              "PSA.66.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.66.20",
                "verseOrgIds": [
                  "PSA.66.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", qui n'a point rejeté ma prière, ni retiré d'avec moi sa bonté.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.66.20",
            "verseOrgIds": [
              "PSA.66.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.67",
