  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "116",
        "style": "c",
        "sid": "PSA 116"
      },
      "items": [
        {
          "text": "116",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 116:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai aimé l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.1",
                "verseOrgIds": [
                  "PSA.116.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", car il a entendu ma voix, mes supplications ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 116:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il a incliné son oreille vers moi, et je l'invoquerai durant mes jours.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 116:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les cordeaux de la mort m'avaient environné, et les détresses du shéol m'avaient atteint ; j'avais trouvé la détresse et le chagrin ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.3",
            "verseOrgIds": [
              "PSA.116.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 116:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais j'invoquai le nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
        {
          "text": ": Je te prie, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.4",
                "verseOrgIds": [
                  "PSA.116.4"
                ]
              }
            }
          ]
        },
        {
          "text": "! délivre mon âme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.4",
            "verseOrgIds": [
              "PSA.116.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 116:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.5",
                "verseOrgIds": [
                  "PSA.116.5"
                ]
              }
            }
          ]
        },
        {
          "text": "est plein de grâce et juste, et notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.5",
                "verseOrgIds": [
                  "PSA.116.5"
                ]
              }
            }
          ]
        },
        {
          "text": "est miséricordieux.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.5",
            "verseOrgIds": [
              "PSA.116.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 116:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.6",
                "verseOrgIds": [
                  "PSA.116.6"
                ]
              }
            }
          ]
        },
        {
          "text": "garde les simples ; j'étais devenu misérable, et il m'a sauvé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.6",
            "verseOrgIds": [
              "PSA.116.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 116:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon âme, retourne en ton repos, car l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.7",
                "verseOrgIds": [
                  "PSA.116.7"
                ]
              }
            }
          ]
        },
        {
          "text": "t'a fait du bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 116:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car tu as délivré mon âme de la mort, mes yeux de larmes, mes pieds de chute :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 116:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je marcherai devant l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.9",
                "verseOrgIds": [
                  "PSA.116.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dans la terre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        },
        {
          "text": "des vivants.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.9",
            "verseOrgIds": [
              "PSA.116.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 116:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai cru, c'est pourquoi j'ai parlé. J'ai été fort affligé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.10",
            "verseOrgIds": [
              "PSA.116.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 116:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je disais en mon agitation : Tout homme est menteur.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.11",
            "verseOrgIds": [
              "PSA.116.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 116:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que rendrai-je à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.12",
                "verseOrgIds": [
                  "PSA.116.12"
                ]
              }
            }
          ]
        },
        {
          "text": "pour tous les biens qu'il m'a faits ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.12",
            "verseOrgIds": [
              "PSA.116.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 116:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je prendrai la coupe du salut",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        },
        {
          "text": ", et j'invoquerai le nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.13",
                "verseOrgIds": [
                  "PSA.116.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.13",
            "verseOrgIds": [
              "PSA.116.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 116:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'acquitterai mes vœux envers l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.14",
                "verseOrgIds": [
                  "PSA.116.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", – oui, devant tout son peuple.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.14",
            "verseOrgIds": [
              "PSA.116.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 116:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Précieuse, aux yeux de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.15",
                "verseOrgIds": [
                  "PSA.116.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", est la mort de ses saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.15",
            "verseOrgIds": [
              "PSA.116.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 116:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je te prie, ô",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.16",
                "verseOrgIds": [
                  "PSA.116.16"
                ]
              }
            }
          ]
        },
        {
          "text": "! car je suis ton serviteur ; je suis ton serviteur, le fils de ta servante ; tu as délié mes liens.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.16",
            "verseOrgIds": [
              "PSA.116.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 116:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je te sacrifierai des sacrifices d'actions de grâces, et j'invoquerai le nom de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.17",
                "verseOrgIds": [
                  "PSA.116.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.17",
            "verseOrgIds": [
              "PSA.116.17"
            ]
          }
        }
      ]
    },
