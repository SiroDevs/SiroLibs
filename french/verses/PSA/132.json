{
  "id": "PSA.132",
  "number": "132",
  "bookId": "PSA",
  "reference": "Psaumes 132",
  "copyright": "Texte libre de droits",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "132",
        "style": "c",
        "sid": "PSA 132"
      },
      "items": [
        {
          "text": "132",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 132:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cantique des degrés.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.1",
                "verseOrgIds": [
                  "PSA.132.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", souviens-toi de David, [et] de toutes ses afflictions !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 132:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Comment il a juré à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.2",
                "verseOrgIds": [
                  "PSA.132.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", [et] fait un vœu au Puissant de Jacob :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 132:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si j'entre dans la demeure",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        },
        {
          "text": "de ma maison, si je monte sur le lit où je couche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 132:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si je permets à mes yeux de dormir, à mes paupières de sommeiller,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 132:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jusqu'à ce que j'aie trouvé un lieu pour l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.5",
                "verseOrgIds": [
                  "PSA.132.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", des demeures pour le Puissant de Jacob !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 132:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voici, nous avons entendu parler d'elle",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        },
        {
          "text": "à Éphrata, nous l'avons trouvée dans les champs de Jaar",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 132:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entrons dans ses demeures, prosternons-nous devant le marchepied de ses pieds.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 132:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lève-toi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.8",
                "verseOrgIds": [
                  "PSA.132.8"
                ]
              }
            }
          ]
        },
        {
          "text": "! pour [entrer dans] ton repos, toi et l'arche de ta force !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 132:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que tes sacrificateurs soient revêtus de justice, et que tes saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        },
        {
          "text": "chantent de joie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 132:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "À cause de David, ton serviteur, ne repousse pas la face de ton oint.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 132:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.11",
                "verseOrgIds": [
                  "PSA.132.11"
                ]
              }
            }
          ]
        },
        {
          "text": "a juré à David [en] vérité, il n'en reviendra pas : Je mettrai du fruit de ton ventre sur ton trône.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 132:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si tes enfants gardent mon alliance et mes témoignages que je leur enseignerai, leurs fils aussi seront assis à perpétuité sur ton trône.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 132:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.13",
                "verseOrgIds": [
                  "PSA.132.13"
                ]
              }
            }
          ]
        },
        {
          "text": "a choisi Sion ; il l'a désirée pour être son habitation :",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 132:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "C'est ici mon repos à perpétuité ; ici j'habiterai, car je l'ai désirée.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.14",
            "verseOrgIds": [
              "PSA.132.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 132:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je bénirai abondamment ses vivres, je rassasierai de pain ses pauvres ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.15",
            "verseOrgIds": [
              "PSA.132.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 132:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et je revêtirai de salut ses sacrificateurs, et ses saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        },
        {
          "text": "exulteront en chantant de joie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.16",
            "verseOrgIds": [
              "PSA.132.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 132:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Là je ferai germer la corne de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        },
        {
          "text": "David, j'ai préparé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        },
        {
          "text": "une lampe à mon oint.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.17",
            "verseOrgIds": [
              "PSA.132.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 132:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je revêtirai de honte ses ennemis ; et sur lui fleurira sa couronne",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.18",
            "verseOrgIds": [
              "PSA.132.18"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.18",
            "verseOrgIds": [
              "PSA.132.18"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.133",
    "number": "133",
    "bookId": "PSA"
  },
  "previous": {
    "id": "PSA.131",
    "number": "131",
