                "verseId": "PSA.67.7",
                "verseOrgIds": [
                  "PSA.67.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", nous bénira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
