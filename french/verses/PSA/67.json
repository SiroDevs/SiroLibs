            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.67.7",
                "verseOrgIds": [
                  "PSA.67.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", notre",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        },
        {
          "name": "char",
