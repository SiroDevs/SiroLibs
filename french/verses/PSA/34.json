  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "PSA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "De David, quand il dissimula sa raison devant Abimélec",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.1"
            ]
          }
        },
        {
          "text": ", qui le chassa, et il s'en alla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je bénirai l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.2",
                "verseOrgIds": [
                  "PSA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "en tout temps ; sa louange sera continuellement dans ma bouche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mon âme se glorifiera en l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.3",
                "verseOrgIds": [
                  "PSA.34.3"
                ]
              }
            }
          ]
        },
        {
          "text": "; les débonnaires l'entendront, et se réjouiront.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magnifiez l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.4",
                "verseOrgIds": [
                  "PSA.34.4"
                ]
              }
            }
          ]
        },
        {
          "text": "avec moi, et exaltons ensemble son nom.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai cherché l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.5",
                "verseOrgIds": [
                  "PSA.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "; et il m'a répondu, et m'a délivré de toutes mes frayeurs.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ils ont regardé vers lui, et ils ont été illuminés, et leurs faces n'ont pas été",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        },
        {
          "text": "confuses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cet affligé a crié ; et l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.7",
                "verseOrgIds": [
                  "PSA.34.7"
                ]
              }
            }
          ]
        },
        {
          "text": "l'a entendu, et l'a sauvé de toutes ses détresses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'ange de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.8",
                "verseOrgIds": [
                  "PSA.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "campe autour de ceux qui le craignent, et les délivre.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goûtez et voyez que l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.9",
                "verseOrgIds": [
                  "PSA.34.9"
                ]
              }
            }
          ]
        },
        {
          "text": "est bon ! Bienheureux l'homme qui se confie en lui !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Craignez l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.10",
                "verseOrgIds": [
                  "PSA.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", vous ses saints ; car rien ne manque à ceux qui le craignent.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les lionceaux souffrent disette, et ont faim ; mais ceux qui cherchent l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.11",
                "verseOrgIds": [
                  "PSA.34.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ne manquent d'aucun bien.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Venez, fils, écoutez-moi : je vous enseignerai la crainte de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.12",
                "verseOrgIds": [
                  "PSA.34.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui est l'homme qui prenne plaisir à la vie [et] qui aime les jours pour voir du bien ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garde ta langue du mal, et tes lèvres de proférer la tromperie ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.14",
            "verseOrgIds": [
              "PSA.34.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Retire-toi du mal, et fais le bien ; cherche la paix, et poursuis-la.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.15",
            "verseOrgIds": [
              "PSA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les yeux de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.16",
                "verseOrgIds": [
                  "PSA.34.16"
                ]
              }
            }
          ]
        },
        {
          "text": "[regardent] vers les justes, et ses oreilles sont [ouvertes] à leur cri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.16",
            "verseOrgIds": [
              "PSA.34.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "La face de l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.17",
                "verseOrgIds": [
                  "PSA.34.17"
                ]
              }
            }
          ]
        },
        {
          "text": "est contre ceux qui font le mal, pour retrancher de la terre leur mémoire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.17",
            "verseOrgIds": [
              "PSA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "[Les justes] crient, et l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.18",
                "verseOrgIds": [
                  "PSA.34.18"
                ]
              }
            }
          ]
        },
        {
          "text": "entend, et il les délivre de toutes leurs détresses.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.18",
            "verseOrgIds": [
              "PSA.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.19",
            "verseOrgIds": [
              "PSA.34.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.19",
                "verseOrgIds": [
                  "PSA.34.19"
                ]
              }
            }
          ]
        },
        {
          "text": "est près de ceux qui ont le cœur brisé, et il sauve ceux qui ont l'esprit abattu.",
          "type": "text",
          "attrs": {
