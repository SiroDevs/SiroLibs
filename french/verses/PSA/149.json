        "number": "149",
        "style": "c",
        "sid": "PSA 149"
      },
      "items": [
        {
          "text": "149",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 149:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Louez Jah.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        },
        {
          "text": "Chantez à l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.1",
                "verseOrgIds": [
                  "PSA.149.1"
                ]
              }
            }
          ]
        },
        {
          "text": "un cantique nouveau ! [Chantez] sa louange dans la congrégation des saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 149:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'Israël se réjouisse en celui qui l'a fait ; que les fils de Sion s'égaient en leur roi !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 149:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qu'ils louent son nom avec des danses, qu'ils chantent ses louanges avec le tambourin et avec la harpe !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 149:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car l'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.4",
                "verseOrgIds": [
                  "PSA.149.4"
                ]
              }
            }
          ]
        },
        {
          "text": "prend plaisir en son peuple ; il pare les débonnaires de salut.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 149:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Que les saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        },
        {
          "text": "se réjouissent de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        },
        {
          "text": "la gloire, qu'ils exultent avec chant de triomphe sur leurs lits !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 149:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les louanges de",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.6",
                "verseOrgIds": [
                  "PSA.149.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sont dans leur bouche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        },
        {
          "text": ", et une épée à deux tranchants dans leur main,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 149:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour exécuter la vengeance contre les nations, des châtiments au milieu des peuples",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 149:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour lier leurs rois de chaînes, et leurs nobles de ceps de fer ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 149:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pour exécuter contre eux le jugement qui est écrit. Cette gloire est pour tous ses saints",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        },
        {
          "text": ". Louez Jah !",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
      ]
    }
  ],
