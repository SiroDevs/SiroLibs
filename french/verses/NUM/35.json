            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "NUM.35.34",
                "verseOrgIds": [
                  "NUM.35.34"
                ]
              }
            }
          ]
        },
        {
          "text": ", j'habite au milieu des fils d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
