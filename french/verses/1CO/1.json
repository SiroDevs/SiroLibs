{
  "id": "1CO.1",
  "number": "1",
  "bookId": "1CO",
  "reference": "1 Corinthiens 1",
  "copyright": "Texte libre de droits",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paul, apôtre appelé",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "text": "de Jésus Christ par la volonté de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.1",
                "verseOrgIds": [
                  "1CO.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", et Sosthène, le frère,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.1",
            "verseOrgIds": [
              "1CO.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "à l'assemblée de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.2",
                "verseOrgIds": [
                  "1CO.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "qui est à Corinthe, aux sanctifiés dans le christ Jésus, saints appelés",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "text": ", avec tous ceux qui en tout lieu invoquent le nom de notre seigneur Jésus Christ, et leur [seigneur] et le nôtre :",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.2",
            "verseOrgIds": [
              "1CO.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Grâce et paix à vous, de la part de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.3",
                "verseOrgIds": [
                  "1CO.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "notre Père et du seigneur Jésus Christ !",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.3",
            "verseOrgIds": [
              "1CO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je rends toujours grâces à mon",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.4",
                "verseOrgIds": [
                  "1CO.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "pour vous, à cause",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "text": "de la grâce de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.4",
                "verseOrgIds": [
                  "1CO.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "qui vous a été donnée dans le christ Jésus,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "de ce qu'en toutes choses vous avez été enrichis en lui en toute parole",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "text": "et toute connaissance,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.5",
            "verseOrgIds": [
              "1CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "selon que le témoignage du Christ a été confirmé au milieu de vous",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.6",
            "verseOrgIds": [
              "1CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "de sorte que vous ne manquez d'aucun don de grâce pendant que vous attendez la révélation de notre seigneur Jésus Christ,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.7",
            "verseOrgIds": [
              "1CO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "qui aussi vous affermira jusqu'à la fin [pour être] irréprochables dans la journée de notre seigneur Jésus Christ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.8",
            "verseOrgIds": [
              "1CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.9",
                "verseOrgIds": [
                  "1CO.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", par qui vous avez été appelés à la communion de son Fils Jésus Christ, notre Seigneur, est fidèle.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.9",
            "verseOrgIds": [
              "1CO.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or je vous exhorte, frères, par le nom de notre seigneur Jésus Christ, à parler tous un même langage, et à ce qu'il n'y ait pas de divisions parmi vous, mais que vous soyez parfaitement unis dans un même sentiment et dans un même avis.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.10",
            "verseOrgIds": [
              "1CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car, mes frères, il m'a été dit",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "text": "de vous, par ceux qui sont de chez Chloé, qu'il y a des dissensions parmi vous.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.11",
            "verseOrgIds": [
              "1CO.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or voici ce que je dis, c'est que chacun de vous dit : Moi, je suis de Paul ; et moi, d'Apollos ; et moi, de Céphas ; et moi, de Christ.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.12",
            "verseOrgIds": [
              "1CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le Christ est-il divisé ? Paul a-t-il été crucifié pour vous ? ou avez-vous été baptisés pour le nom de Paul ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.13",
            "verseOrgIds": [
              "1CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Je rends grâces à",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.14",
                "verseOrgIds": [
                  "1CO.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "de ce que je n'ai baptisé aucun de vous, sinon Crispus et Gaïus,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.14",
            "verseOrgIds": [
              "1CO.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "afin que personne ne dise que j'ai baptisé pour mon nom.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.15",
            "verseOrgIds": [
              "1CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "J'ai bien aussi baptisé la maison de Stéphanas ; du reste je ne sais pas si j'ai baptisé quelqu'un d'autre.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.16",
            "verseOrgIds": [
              "1CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car Christ ne m'a pas envoyé baptiser, mais évangéliser, non point avec sagesse de parole, afin que la croix du Christ ne soit pas rendue vaine ;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.17",
            "verseOrgIds": [
              "1CO.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "car la parole de la croix est folie pour ceux qui périssent, mais à nous qui obtenons le salut elle est la puissance de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.18",
                "verseOrgIds": [
                  "1CO.1.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.18",
            "verseOrgIds": [
              "1CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car il est écrit : « Je détruirai la sagesse des sages et j'annulerai l'intelligence des intelligents »",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.19",
            "verseOrgIds": [
              "1CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Où est le sage ? où est le scribe ? où est le disputeur de ce siècle ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.20",
                "verseOrgIds": [
                  "1CO.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": "n'a-t-il pas fait de la sagesse du monde une folie ?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.20",
            "verseOrgIds": [
              "1CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Car, puisque, dans la sagesse de",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.21",
                "verseOrgIds": [
                  "1CO.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", le monde, par la sagesse, n'a pas connu",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.21",
                "verseOrgIds": [
                  "1CO.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", il a plu à",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "1CO.1.21",
                "verseOrgIds": [
                  "1CO.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", par la folie de la prédication",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "text": ", de sauver ceux qui croient ;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.21",
            "verseOrgIds": [
              "1CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "puisque les Juifs demandent des miracles",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.22",
            "verseOrgIds": [
              "1CO.1.22"
            ]
          }
        },
        {
          "text": "et que les Grecs recherchent la sagesse ;",
          "type": "text",
          "attrs": {
