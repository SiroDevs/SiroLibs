{
  "id": "2SA.23",
  "number": "23",
  "bookId": "2SA",
  "reference": "2 Samuel 23",
  "copyright": "Texte libre de droits",
  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2SA 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Et ce sont ici les dernières paroles de David. David, le fils d'Isaï, a dit",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        },
        {
          "text": ", et l'homme haut placé, l'oint du",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.1",
                "verseOrgIds": [
                  "2SA.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "de Jacob, et le doux psalmiste d'Israël, a dit",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.1",
            "verseOrgIds": [
              "2SA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "L'Esprit de l'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.2",
                "verseOrgIds": [
                  "2SA.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "a parlé en moi, et sa parole a été sur ma langue.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.2",
            "verseOrgIds": [
              "2SA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Le",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.3",
                "verseOrgIds": [
                  "2SA.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "d'Israël a dit, le Rocher d'Israël m'a parlé :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 23:3"
      },
      "items": [
        {
          "text": "Celui qui domine parmi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        },
        {
          "text": "les hommes sera juste, dominant en la crainte de",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Dieu",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.3",
                "verseOrgIds": [
                  "2SA.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.3",
            "verseOrgIds": [
              "2SA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "et il sera comme la lumière du matin, quand le soleil se lève, un matin sans nuages : par sa clarté l'herbe tendre [germe] de la terre après la pluie.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.4",
            "verseOrgIds": [
              "2SA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Quoique ma maison ne soit pas ainsi avec",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "✶Dieu",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.5",
                "verseOrgIds": [
                  "2SA.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", cependant il a établi avec moi une alliance éternelle, à tous égards bien ordonnée et assurée, car c'est là tout mon salut et tout mon plaisir, quoiqu'il ne la fasse pas germer",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.5",
            "verseOrgIds": [
              "2SA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mais [les fils de] Bélial sont tous comme des épines qu'on jette loin, car on ne les prend pas avec la main,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.6",
            "verseOrgIds": [
              "2SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et l'homme qui les touche se munit d'un fer ou d'un bois de lance ; et ils seront entièrement brûlés par le feu sur le lieu même.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.7",
            "verseOrgIds": [
              "2SA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "*Ce sont ici les noms des hommes forts qu'avait David : Josheb-Bashébeth",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "text": ", Thacmonite",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "text": ", chef des principaux capitaines ; c'était Adino, l'Etsnite, qui eut le dessus sur",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        },
        {
          "text": "800 hommes, qu'il tua en une fois.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.8",
            "verseOrgIds": [
              "2SA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et après lui, Éléazar, fils de Dodo, fils d'un Akhokhite",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "text": "; il était l'un des trois hommes forts qui étaient avec David, lorsqu'ils avaient défié les Philistins qui s'étaient assemblés là pour combattre, et que les hommes d'Israël étaient montés.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.9",
            "verseOrgIds": [
              "2SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Il se leva, et frappa les Philistins, jusqu'à ce que sa main fut lasse et que sa main demeura attachée à l'épée ; et l'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.10",
                "verseOrgIds": [
                  "2SA.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "opéra une grande délivrance ce jour-là ; et le peuple revint après [Éléazar], seulement pour piller.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.10",
            "verseOrgIds": [
              "2SA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et après lui, Shamma, fils d'Agué, Hararite : les Philistins s'étaient assemblés en troupe ; et il y avait là une portion de champ pleine de lentilles, et le peuple avait fui devant les Philistins :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.11",
            "verseOrgIds": [
              "2SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "et il se plaça au milieu du champ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        },
        {
          "text": ", et le sauva, et frappa les Philistins ; et l'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.12",
                "verseOrgIds": [
                  "2SA.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": "opéra une grande délivrance.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.12",
            "verseOrgIds": [
              "2SA.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et trois des trente chefs descendirent et vinrent au temps de la moisson vers David, dans la caverne d'Adullam, comme une troupe de Philistins était campée dans la vallée des Rephaïm.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.13",
            "verseOrgIds": [
              "2SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et David était alors dans le lieu fort, et il y avait alors un poste des Philistins à Bethléhem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.14",
            "verseOrgIds": [
              "2SA.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et David convoita, et dit : Qui me fera boire de l'eau du puits de Bethléhem, qui est près de la porte ?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.15",
            "verseOrgIds": [
              "2SA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les trois hommes forts forcèrent le passage à travers le camp des Philistins, et puisèrent de l'eau du puits de Bethléhem, qui est près de la porte, et la prirent et l'apportèrent à David ; et il ne voulut pas la boire, mais il en fit une libation à l'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.16",
                "verseOrgIds": [
                  "2SA.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.16",
            "verseOrgIds": [
              "2SA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et il dit : Loin de moi,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2SA.23.17",
                "verseOrgIds": [
                  "2SA.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", que je fasse cela ! N'est-ce pas le sang des hommes qui sont allés au péril de leur vie ? Et il ne voulut pas la boire. Ces trois hommes forts firent cela.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.17",
            "verseOrgIds": [
              "2SA.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Abishaï, frère de Joab, fils de Tseruïa, était chef de trois ; il leva sa lance contre 300 hommes, qu'il tua. Et il eut un nom parmi les trois.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.18",
            "verseOrgIds": [
              "2SA.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne fut-il pas le plus honoré des trois ? Et il fut leur chef ; mais il n'atteignit pas les trois [premiers].",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.19",
            "verseOrgIds": [
              "2SA.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Benaïa, fils de Jehoïada, fils d'un homme vaillant, de Kabtseël, grand en exploits, lui, frappa deux lions",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "text": "de Moab ; et il descendit, et frappa le lion dans une fosse, par un jour de neige.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.20",
            "verseOrgIds": [
              "2SA.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et c'est lui qui frappa un homme égyptien qui était de grande apparence, et l'Égyptien avait en sa main une lance ; et il descendit vers lui avec un bâton, et arracha la lance de la main de l'Égyptien, et le tua avec sa propre lance.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.21",
            "verseOrgIds": [
              "2SA.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Voilà ce que fit Benaïa, fils de Jehoïada ; et il eut un nom parmi les trois hommes forts :",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.22",
            "verseOrgIds": [
              "2SA.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "il fut plus honoré que les trente, mais il n'atteignit pas les trois [premiers]. Et David lui donna une place dans ses audiences privées.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.23",
            "verseOrgIds": [
              "2SA.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asçaël, frère de Joab, était des trente ; Elkhanan, fils de Dodo, de Bethléhem ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.24",
            "verseOrgIds": [
              "2SA.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamma, le Harodite ; Élika, le Harodite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.25",
            "verseOrgIds": [
              "2SA.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hélets, le Paltite ; Ira, fils d'Ikkesh, le Thekohite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.26",
            "verseOrgIds": [
              "2SA.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiézer, l'Anathothite ; Mebunnaï, le Hushathite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.27",
            "verseOrgIds": [
              "2SA.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsalmon, l'Akhokhite ; Maharaï, le Netophathite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.28",
            "verseOrgIds": [
              "2SA.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Héleb, fils de Baana, le Netophathite ; Itthaï, fils de Ribaï, de Guibha des fils de Benjamin ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.29",
            "verseOrgIds": [
              "2SA.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaïa, le Pirhathonite ; Hiddaï, des torrents de Gaash ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.30",
            "verseOrgIds": [
              "2SA.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abi-Albon, l'Arbathite ; Azmaveth, le Barkhumite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.31",
            "verseOrgIds": [
              "2SA.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Éliakhba, le Shaalbonite ; Bené-Jashen ; Jonathan ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamma, l'Hararite ; Akhiam, fils de Sharar, l'Ararite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.33",
            "verseOrgIds": [
              "2SA.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Éliphéleth, fils d'Akhasbaï, fils d'un Maacathien ; Éliam, fils d'Akhitophel, le Guilonite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hetsraï, le Carmélite ; Paaraï, l'Arbite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.35",
            "verseOrgIds": [
              "2SA.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jighal, fils de Nathan, de Tsoba ; Bani, le Gadite ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.36",
            "verseOrgIds": [
              "2SA.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsélek, l'Ammonite ; Nakharaï, le Beérothien, qui portait les armes de Joab, fils de Tseruïa ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ira, le Jéthrien ; Gareb, le Jéthrien ;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.38",
            "verseOrgIds": [
              "2SA.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
