{
  "id": "1CH.6",
  "number": "6",
  "bookId": "1CH",
  "reference": "1 Chroniques 6",
  "copyright": "Texte libre de droits",
  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Lévi : Guershom, Kehath, et Merari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.1",
            "verseOrgIds": [
              "1CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et ce sont ici les noms des fils de Guershom : Libni et Shimhi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.2",
            "verseOrgIds": [
              "1CH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils de Kehath : Amram, et Jitsehar, et Hébron, et Uziel.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.3",
            "verseOrgIds": [
              "1CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Merari : Makhli et Mushi. – Ce sont là les familles de Lévi, selon leurs pères.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.4",
            "verseOrgIds": [
              "1CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "De Guershom : Libni, son fils ; Jakhath, son fils ; Zimma, son fils ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.5",
            "verseOrgIds": [
              "1CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joakh, son fils ; Iddo, son fils ; Zérakh, son fils ; Jathraï, son fils.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.6",
            "verseOrgIds": [
              "1CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Kehath : Amminadab, son fils ; Coré, son fils ; Assir, son fils ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.7",
            "verseOrgIds": [
              "1CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elkana, son fils ; et Ébiasaph, son fils ; et Assir, son fils ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.8",
            "verseOrgIds": [
              "1CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thakhath, son fils ; Uriel, son fils ; Ozias, son fils ; et Saül, son fils.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.9",
            "verseOrgIds": [
              "1CH.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "– Et les fils d'Elkana : Amasçaï et Akhimoth.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.10",
            "verseOrgIds": [
              "1CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elkana, – les fils d'Elkana : Tsophaï, son fils ; et Nakhath, son fils ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.11",
            "verseOrgIds": [
              "1CH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Éliab, son fils ; Jerokham, son fils ; Elkana, son fils.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.12",
            "verseOrgIds": [
              "1CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils de Samuel : le premier-né, Vashni, et Abija.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.13",
            "verseOrgIds": [
              "1CH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Les fils de Merari : Makhli ; Libni, son fils ; Shimhi, son fils ; Uzza, son fils ;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.14",
            "verseOrgIds": [
              "1CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shimha, son fils ; Hagguija, son fils ; Asçaïa, son fils.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.15",
            "verseOrgIds": [
              "1CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ce sont ici ceux que David établit pour la direction du chant dans la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.16",
            "verseOrgIds": [
              "1CH.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1CH.6.16",
                "verseOrgIds": [
                  "1CH.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", depuis que l'arche fut en repos.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.16",
            "verseOrgIds": [
              "1CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ils faisaient le service devant le tabernacle de la tente d'assignation, pour le chant, jusqu'à ce que Salomon ait bâti la maison de l'",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.17",
            "verseOrgIds": [
              "1CH.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "1CH.6.17",
                "verseOrgIds": [
                  "1CH.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "à Jérusalem ; et ils se tinrent là selon l'ordre établi pour leur service.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.17",
            "verseOrgIds": [
              "1CH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et ce sont ici ceux qui se tenaient là, et leurs fils :",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.18",
            "verseOrgIds": [
              "1CH.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 6:18"
      },
      "items": [
        {
          "text": "Des fils des Kehathites : Héman, le chantre, fils de Joël, fils de Samuel,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.18",
            "verseOrgIds": [
              "1CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils d'Elkana, fils de Jerokham, fils d'Éliel, fils de Thoakh",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.19",
            "verseOrgIds": [
              "1CH.6.19"
            ]
          }
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.19",
            "verseOrgIds": [
              "1CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Tsuph, fils d'Elkana, fils de Makhath, fils d'Amasçaï,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.20",
            "verseOrgIds": [
              "1CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils d'Elkana, fils de Joël, fils d'Azaria, fils de Sophonie",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.21",
            "verseOrgIds": [
              "1CH.6.21"
            ]
          }
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.21",
            "verseOrgIds": [
              "1CH.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Thakhath, fils d'Assir, fils d'Ébiasaph, fils de Coré,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.22",
            "verseOrgIds": [
              "1CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Jitsehar, fils de Kehath, fils de Lévi, fils d'Israël.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.23",
            "verseOrgIds": [
              "1CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et son frère Asaph, qui se tenait à sa droite : Asaph, fils de Bérékia, fils de Shimha,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.24",
            "verseOrgIds": [
              "1CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Micaël, fils de Baascéïa, fils de Malkija,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.25",
            "verseOrgIds": [
              "1CH.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils d'Ethni, fils de Zérakh, fils d'Adaïa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.26",
            "verseOrgIds": [
              "1CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils d'Éthan, fils de Zimma, fils de Shimhi,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.27",
            "verseOrgIds": [
              "1CH.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Jakhath, fils de Guershom, fils de Lévi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.28",
            "verseOrgIds": [
              "1CH.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et les fils de Merari, leurs frères, à la gauche : Éthan, fils de Kishi, fils d'Abdi, fils de Malluc,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.29",
            "verseOrgIds": [
              "1CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Hashabia, fils d'Amatsia, fils de Hilkija,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.30",
            "verseOrgIds": [
              "1CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils d'Amtsi, fils de Bani, fils de Shémer,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.31",
            "verseOrgIds": [
              "1CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "fils de Makhli, fils de Mushi, fils de Merari, fils de Lévi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.32",
            "verseOrgIds": [
              "1CH.6.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et leurs frères, les Lévites, furent donnés pour tout le service du tabernacle de la maison de",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.33",
