          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Et Jéroboam n'eut plus de force durant les jours d'Abija ; et l'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Éternel",
              "type": "text",
              "attrs": {
                "verseId": "2CH.13.20",
                "verseOrgIds": [
                  "2CH.13.20"
                ]
              }
            }
          ]
        },
        {
          "text": "le frappa, et il mourut.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.20",
            "verseOrgIds": [
              "2CH.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
