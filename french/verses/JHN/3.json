          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qui croit au Fils a la vie éternelle ; mais qui désobéit",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        },
        {
          "text": "au Fils ne verra pas la vie, mais la colère de",
          "type": "text",
