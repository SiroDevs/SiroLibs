                "verseOrgIds": [
                  "JHN.3.34"
                ]
              }
            }
          ]
        },
        {
          "text": "a envoyé parle les paroles de",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
