                "verseId": "GEN.1.4",
                "verseOrgIds": [
                  "GEN.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "vit la lumière, qu'elle était bonne ; et",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
          "name": "char",
