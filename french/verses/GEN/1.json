              "attrs": {
                "verseId": "GEN.1.5",
                "verseOrgIds": [
                  "GEN.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "appela la lumière Jour ; et les ténèbres, il les appela Nuit. Et il y eut soir, et il y eut matin : – premier",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        },
        {
          "text": "jour.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.5",
            "verseOrgIds": [
              "GEN.1.5"
            ]
          }
        }
      ]
