                "verseOrgIds": [
                  "GEN.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "appela le sec Terre, et le rassemblement des eaux, il l'appela Mers. Et",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
