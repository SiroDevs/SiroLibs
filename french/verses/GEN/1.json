                "verseId": "GEN.1.1",
                "verseOrgIds": [
                  "GEN.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "créa les cieux et la terre.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.1",
            "verseOrgIds": [
              "GEN.1.1"
            ]
          }
        }
      ]
