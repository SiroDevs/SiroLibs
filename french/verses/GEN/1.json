                ]
              }
            }
          ]
        },
        {
          "text": "dit : Voici, je vous ai donné toute plante portant semence, qui est sur la face de toute la terre, et tout arbre dans lequel il y a un fruit d'arbre, portant semence ; [cela] vous sera pour nourriture ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
