                "verseId": "GEN.1.10",
                "verseOrgIds": [
                  "GEN.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "vit que cela était bon.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.10",
            "verseOrgIds": [
              "GEN.1.10"
            ]
          }
        },
