                "verseId": "GEN.1.7",
                "verseOrgIds": [
                  "GEN.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "fit l'étendue, et sépara les eaux qui sont au-dessous de l'étendue d'avec les eaux qui sont au-dessus de l'étendue. Et il fut ainsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
