                "verseId": "GEN.1.4",
                "verseOrgIds": [
                  "GEN.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sépara la lumière d'avec les ténèbres.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.4",
            "verseOrgIds": [
              "GEN.1.4"
            ]
          }
        },
        {
