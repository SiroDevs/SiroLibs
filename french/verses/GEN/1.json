          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "et qu'ils soient pour luminaires dans l'étendue des cieux pour donner de la lumière sur la terre. Et il fut ainsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.15",
            "verseOrgIds": [
              "GEN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 1:16"
          },
          "items": [
