  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "84",
        "style": "c",
        "sid": "PSA 84"
      },
      "items": [
        {
          "text": "84",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 84",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Gẹ́gẹ́ bí ti gittiti. Ti àwọn ọmọ Kora. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 84:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibùgbé rẹ̀ ti lẹ́wà tó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.1",
                "verseOrgIds": [
                  "PSA.84.2"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 84:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn mi ń ṣàfẹ́rí nítòótọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "ó tilẹ̀ pòǹgbẹ fún àgbàlá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.2",
                "verseOrgIds": [
                  "PSA.84.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "àyà mi àti ara mi ń kọrin ayọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "sí Ọlọ́run alààyè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 84:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ ológoṣẹ́ ri ilé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "ẹyẹ alápáǹdẹ̀dẹ̀ tẹ́ ìtẹ́ fún ara rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "níbi tí yóò máa pa ọmọ rẹ̀ mọ́ sí:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "text": "ibùgbé ní tòsí pẹpẹ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.3",
                "verseOrgIds": [
                  "PSA.84.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, ọba mí àti Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.3",
            "verseOrgIds": [
              "PSA.84.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 84:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ní fún àwọn tí ó ń gbé inú ilé rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:4"
      },
      "items": [
        {
          "text": "wọn ó máa yìn ọ́ títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.4",
            "verseOrgIds": [
              "PSA.84.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 84:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ni fún àwọn tí agbára wọn wà nínú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.5",
            "verseOrgIds": [
              "PSA.84.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:5"
      },
      "items": [
        {
          "text": "àwọn tí wọ́n gbé ọkàn lé bíbẹ ibi mímọ́ wò.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.5",
            "verseOrgIds": [
              "PSA.84.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 84:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ń la àfonífojì omijé lọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:6"
      },
      "items": [
        {
          "text": "wọn sọ ọ́ di kànga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:6"
      },
      "items": [
        {
          "text": "àkọ́rọ̀ òjò sì fi ìbùkún bò ó.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.6",
            "verseOrgIds": [
              "PSA.84.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 84:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n ń lọ láti ipa dé ipá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:7"
      },
      "items": [
        {
          "text": "títí tí ọ̀kọ̀ọ̀kan fi farahàn níwájú Ọlọ́run ní Sioni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.7",
            "verseOrgIds": [
              "PSA.84.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 84:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbọ́ àdúrà mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.8",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Alágbára;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:8"
      },
      "items": [
        {
          "text": "tẹ́tí sí mi, Ọlọ́run Jakọbu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 84:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wo asà wa, Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:9"
      },
      "items": [
        {
          "text": "fi ojú àánú wò àwọn ẹni àmì òróró rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 84:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dídára ní ọjọ́ kan ní ààfin rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "ju ẹgbẹ̀rún (1,000) ọjọ́ lọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "èmi o kúkú máa ṣe aṣọ́nà nínú ilé Ọlọ́run mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:10"
      },
      "items": [
        {
          "text": "jù láti gbé ní àgọ́ àwọn ènìyàn búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.10",
            "verseOrgIds": [
              "PSA.84.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 84:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run jẹ́ òòrùn àti asà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.11",
                "verseOrgIds": [
                  "PSA.84.12"
                ]
              }
            }
          ]
        },
        {
          "text": "fún ni ní ojúrere àti ọlá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "kò sí ohun rere kan tí yóò fàsẹ́yìn",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.11",
            "verseOrgIds": [
              "PSA.84.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:11"
      },
      "items": [
        {
          "text": "fún àwọn tí ó rìn ní àìlábùkù.",
