      "attrs": {
        "style": "q2",
        "vid": "PSA 139:19"
      },
      "items": [
        {
          "text": "nítorí náà kúrò lọ́dọ̀ mi ẹ̀yin ọkùnrin ẹlẹ́jẹ̀.",
