  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "139",
        "style": "c",
        "sid": "PSA 139"
      },
      "items": [
        {
          "text": "139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 139",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti Dafidi. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 139:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.1",
                "verseOrgIds": [
                  "PSA.139.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ tí wádìí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:1"
      },
      "items": [
        {
          "text": "ìwọ sì ti mọ̀ mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.1",
            "verseOrgIds": [
              "PSA.139.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 139:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ mọ̀ ìjókòó mi àti ìdìde mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:2"
      },
      "items": [
        {
          "text": "ìwọ mọ̀ èrò mi ní ọ̀nà jíjìn réré.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.2",
            "verseOrgIds": [
              "PSA.139.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 139:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yí ipa ọ̀nà mi ká àti ìdùbúlẹ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:3"
      },
      "items": [
        {
          "text": "gbogbo ọ̀nà mi sì di mí mọ̀ fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.3",
            "verseOrgIds": [
              "PSA.139.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 139:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí kò sí ọ̀rọ̀ kan ní ahọ́n mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:4"
      },
      "items": [
        {
          "text": "kíyèsi i,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.139.4",
                "verseOrgIds": [
                  "PSA.139.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ mọ̀ ọ́n pátápátá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.4",
            "verseOrgIds": [
              "PSA.139.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 139:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ sé mi mọ́ lẹ́yìn àti níwájú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:5"
      },
      "items": [
        {
          "text": "ìwọ sì fi ọwọ́ rẹ lé mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.5",
            "verseOrgIds": [
              "PSA.139.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 139:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irú ìmọ̀ yìí jẹ ohun ìyanu fún mi jù;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:6"
      },
      "items": [
        {
          "text": "ó ga, èmi kò le mọ̀ ọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.6",
            "verseOrgIds": [
              "PSA.139.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 139:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbo ní èmi yóò gbé lọ kúrò ni ọwọ́ ẹ̀mí rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:7"
      },
      "items": [
        {
          "text": "Tàbí níbo ni èmi yóò sáré kúrò níwájú rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.7",
            "verseOrgIds": [
              "PSA.139.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 139:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí èmi bá gòkè lọ sí ọ̀run, ìwọ wà níbẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "bí èmí ba sì tẹ́ ẹní mi ní ipò òkú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:8"
      },
      "items": [
        {
          "text": "kíyèsi i, ìwọ wà níbẹ̀ pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.8",
            "verseOrgIds": [
              "PSA.139.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 139:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ìbá mú ìyẹ́ apá òwúrọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:9"
      },
      "items": [
        {
          "text": "kí èmi sì lọ jókòó ní ìhà òpin Òkun,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.9",
            "verseOrgIds": [
              "PSA.139.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 139:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "àní, níbẹ̀ náà ni ọwọ́ rẹ̀ yóò fà mí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:10"
      },
      "items": [
        {
          "text": "ọwọ́ ọ̀tún rẹ yóò sì dì mímú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.10",
            "verseOrgIds": [
              "PSA.139.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 139:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo bá wí pé, \"Ǹjẹ́ kí òkùnkùn kí ó bò mí mọ́lẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:11"
      },
      "items": [
        {
          "text": "kí ìmọ́lẹ̀ kí ó di òru yí mi ká.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.11",
            "verseOrgIds": [
              "PSA.139.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 139:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítòótọ́ òkùnkùn kì í ṣú lọ́dọ̀ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n òru tan ìmọ́lẹ̀ bí ọ̀sán;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:12"
      },
      "items": [
        {
          "text": "àti òkùnkùn àti ọ̀sán, méjèèjì bákan náà ní fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.12",
            "verseOrgIds": [
              "PSA.139.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 139:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ ni ó dá ọkàn mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:13"
      },
      "items": [
        {
          "text": "ìwọ ni ó bò mí mọ́lẹ̀ nínú ìyá mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.13",
            "verseOrgIds": [
              "PSA.139.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 139:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò yìn ọ, nítorí tẹ̀rù tẹ̀rù àti tìyanu tìyanu ní a dá mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "ìyanu ní iṣẹ́ rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:14"
      },
      "items": [
        {
          "text": "èyí nì ni ọkàn mi sì mọ̀ dájúdájú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.14",
            "verseOrgIds": [
              "PSA.139.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 139:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀dá ara mi kò pamọ́ kúrò lọ́dọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "nígbà tí a dá mi ní ìkọ̀kọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
            "verseOrgIds": [
              "PSA.139.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
