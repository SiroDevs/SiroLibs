              "type": "text"
            }
          ]
        },
        {
          "text": "Ọlọ́run ìbá jẹ́ pa àwọn ènìyàn búburú nítòótọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.19",
