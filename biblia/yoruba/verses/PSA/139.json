        "vid": "PSA 139:15"
      },
      "items": [
        {
          "text": "Tí a sì ń ṣiṣẹ́ ní àràbarà ní ìhà ìsàlẹ̀ ilẹ̀ ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.139.15",
