          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.135.4",
                "verseOrgIds": [
                  "PSA.135.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti yan Jakọbu fún ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:4"
      },
      "items": [
        {
          "text": "àní Israẹli fún ìṣúra ààyò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.4",
            "verseOrgIds": [
              "PSA.135.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
