      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 135:3"
      },
      "items": [
        {
          "text": "ẹ kọrin ìyìn sí orúkọ rẹ̀; nítorí tí ó dùn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.3",
            "verseOrgIds": [
              "PSA.135.3"
            ]
          }
        }
      ]
    },
