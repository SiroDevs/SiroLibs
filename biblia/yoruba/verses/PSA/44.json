          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí a tẹrí ọkàn wa ba sínú eruku;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
      ]
    },
