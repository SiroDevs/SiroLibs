          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹjẹ́ Ọlọ́run kì yóò rí ìdí rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
            ]
          }
        }
      ]
    },
