          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dìde kí o sì ràn wá lọ́wọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
              "PSA.44.27"
            ]
          }
        }
      ]
