          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 44:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo àwọn nǹkan wọ̀nyí ń ṣẹlẹ̀ sí wa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "síbẹ̀ àwa kò gbàgbé rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:17"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni a kò ṣèké sí májẹ̀mú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.17",
            "verseOrgIds": [
              "PSA.44.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
