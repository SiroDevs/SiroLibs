      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:18"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni ẹsẹ̀ wa kò yẹ̀ kúrò ní ọ̀nà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
