      "attrs": {
        "style": "q2",
        "vid": "PSA 44:26"
      },
      "items": [
        {
          "text": "rà wá padà nítorí ìfẹ́ rẹ tí ó dúró ṣinṣin.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.26",
            "verseOrgIds": [
