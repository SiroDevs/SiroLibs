      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:22"
      },
      "items": [
        {
          "text": "a ń kà wá sí bí àgùntàn fún pípa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
