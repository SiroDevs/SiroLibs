      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:25"
      },
      "items": [
        {
          "text": "ara wa sì dì mọ́ erùpẹ̀ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.25",
            "verseOrgIds": [
              "PSA.44.26"
            ]
          }
        }
      ]
    },
    {
