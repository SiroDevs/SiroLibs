      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 44:19"
      },
      "items": [
        {
          "text": "tí wọn sì fi òkùnkùn biribiri bò wá mọ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
