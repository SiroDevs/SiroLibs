      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:19"
      },
      "items": [
        {
          "text": "ìwọ sì sọ wá di ẹran ọdẹ fún àwọn ẹranko búburú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.19",
            "verseOrgIds": [
              "PSA.44.20"
            ]
          }
        }
      ]
    },
