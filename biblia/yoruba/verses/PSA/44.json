      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:21"
      },
      "items": [
        {
          "text": "níwọ̀n ìgbà tí ó mọ ohun ìkọ̀kọ̀ inú ọkàn?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.21",
            "verseOrgIds": [
              "PSA.44.22"
            ]
          }
        }
      ]
    },
