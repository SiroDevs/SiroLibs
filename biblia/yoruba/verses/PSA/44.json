          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe tí ìwọ ń pa ojú rẹ mọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:24"
      },
      "items": [
        {
          "text": "tí ìwọ sì gbàgbé ìpọ́njú àti ìnira wa?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.24",
            "verseOrgIds": [
              "PSA.44.25"
            ]
          }
        }
      ]
    },
