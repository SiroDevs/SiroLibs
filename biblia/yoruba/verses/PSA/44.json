          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 44:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn wa kò padà sẹ́yìn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.18",
            "verseOrgIds": [
              "PSA.44.19"
            ]
          }
        }
      ]
    },
    {
