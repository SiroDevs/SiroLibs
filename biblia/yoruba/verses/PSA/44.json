          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwa bá ti gbàgbé orúkọ Ọlọ́run wa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
        }
      ]
    },
