          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀, nítorí rẹ̀ àwa da àyà kọ ikú, ní ojoojúmọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.22",
            "verseOrgIds": [
              "PSA.44.23"
            ]
          }
        }
      ]
    },
