      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 44:20"
      },
      "items": [
        {
          "text": "tàbí tí a na ọwọ́ wa sí ọlọ́run àjèjì.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.44.20",
            "verseOrgIds": [
              "PSA.44.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
