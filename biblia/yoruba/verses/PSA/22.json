        "vid": "PSA 22:23"
      },
      "items": [
        {
          "text": "Ẹ dìde fún un tẹ̀rù tẹ̀rù, ẹ̀yin irú-ọmọ Israẹli!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
