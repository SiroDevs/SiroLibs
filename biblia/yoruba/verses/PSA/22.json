      },
      "items": [
        {
          "text": "àní ẹ̀mí mi lọ́wọ́ agbára àwọn ajá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.20",
            "verseOrgIds": [
              "PSA.22.21"
            ]
          }
        }
