          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.10",
                "verseOrgIds": [
                  "PSA.96.10"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ ọba.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "A fi ìdí ayé múlẹ̀, tí kò sì lè yí;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
