      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "ẹni tí yóò fi òtítọ́ ṣe ìdájọ́ ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
