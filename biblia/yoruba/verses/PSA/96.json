          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí àwọn ọ̀run kí ó yọ̀, kí ayé sì pariwo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:11"
      },
      "items": [
        {
          "text": "jẹ́ kí pápá òkun kí ó hó pẹ̀lú ohun gbogbo tí ń bẹ nínú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
