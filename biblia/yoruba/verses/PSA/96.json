      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "nígbà náà ni gbogbo igi igbó yóò máa yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
