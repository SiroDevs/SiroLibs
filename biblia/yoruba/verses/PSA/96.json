          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí oko kún fún ayọ̀, àti ohun gbogbo tí ń bẹ nínú rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
