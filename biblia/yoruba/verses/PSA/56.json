  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "56",
        "style": "c",
        "sid": "PSA 56"
      },
      "items": [
        {
          "text": "56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 56",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti ohùn \"Àdàbà lórí Óákù òkè réré.\" Ti Dafidi. Miktamu. Nígbà tí àwọn ará Filistini ka mọ́ ní Gati.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 56:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣàánú fún mi, Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:1"
      },
      "items": [
        {
          "text": "nítorí àwọn ènìyàn ń fi ìgbónára lépa mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:1"
      },
      "items": [
        {
          "text": "ní gbogbo ọjọ́ ni wọn ń kọjú ìjà sí mi, wọn ń ni mi lára.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.1",
            "verseOrgIds": [
              "PSA.56.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 56:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀tá mi ń lé mi ní gbogbo ọjọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:2"
      },
      "items": [
        {
          "text": "àwọn ènìyàn ń kọjú ìjà sí mi nínú ìgbéraga wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.2",
            "verseOrgIds": [
              "PSA.56.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 56:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ̀rù bà ń bà mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:3"
      },
      "items": [
        {
          "text": "èmi o gbẹ́kẹ̀lé ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.3",
            "verseOrgIds": [
              "PSA.56.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 56:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú Ọlọ́run èmi yóò máa yìn ọ̀rọ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "nínú Ọlọ́run ni ìgbẹ́kẹ̀lé mi; ẹ̀rù kì yóò bà mí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:4"
      },
      "items": [
        {
          "text": "kí ni ẹran-ara lè ṣe sí mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.4",
            "verseOrgIds": [
              "PSA.56.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 56:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn ń yí ọ̀rọ̀ mí ní gbogbo ọjọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:5"
      },
      "items": [
        {
          "text": "wọn ń gbèrò nígbà gbogbo láti ṣe mí níbi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.5",
            "verseOrgIds": [
              "PSA.56.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn kó ara wọn jọ, wọ́n ba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "Wọ́n ń ṣọ́ ìgbésẹ̀ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:6"
      },
      "items": [
        {
          "text": "wọn ń làkàkà láti gba ẹ̀mí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.6",
            "verseOrgIds": [
              "PSA.56.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 56:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "San ẹ̀san iṣẹ́ búburú wọ́n fún wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:7"
      },
      "items": [
        {
          "text": "ní ìbínú rẹ, Ọlọ́run, wọ́ àwọn ènìyàn náà bọ́ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.7",
            "verseOrgIds": [
              "PSA.56.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 56:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ ẹkún mi sílẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "kó omijé mi sí ìgò rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:8"
      },
      "items": [
        {
          "text": "wọ́n kò ha sí nínú ìkọ̀sílẹ̀ rẹ bí?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.8",
            "verseOrgIds": [
              "PSA.56.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 56:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ọ̀tá mi yóò pẹ̀yìndà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "nígbà tí mo bá pè fún ìrànlọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:9"
      },
      "items": [
        {
          "text": "nípa èyí ni mo mọ̀ pé Ọlọ́run ń bẹ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.9",
            "verseOrgIds": [
              "PSA.56.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 56:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú Ọlọ́run, ẹni tí mo yìn ọ̀rọ̀ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:10"
      },
      "items": [
        {
          "text": "nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.56.10",
                "verseOrgIds": [
                  "PSA.56.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí mo yin ọ̀rọ̀ rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.10",
            "verseOrgIds": [
              "PSA.56.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 56:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nínú Ọlọ́run ni ìgbẹ́kẹ̀lé mi:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "ẹ̀rù kì yóò bà mí.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:11"
      },
      "items": [
        {
          "text": "Kí ni ènìyàn lè ṣe sí mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.11",
            "verseOrgIds": [
              "PSA.56.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 56:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo jẹ́ ẹ̀jẹ́ lábẹ́ rẹ Ọlọ́run:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:12"
      },
      "items": [
        {
          "text": "èmi o mú ìyìn mi wá fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.12",
            "verseOrgIds": [
              "PSA.56.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 56:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìwọ tí gbà mí lọ́wọ́ ikú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "àti ẹsẹ̀ mi lọ́wọ́ ìṣubú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "kí èmí lè máa rìn níwájú Ọlọ́run",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
              "PSA.56.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 56:13"
      },
      "items": [
        {
          "text": "ní ìmọ́lẹ̀ àwọn alààyè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.56.13",
            "verseOrgIds": [
