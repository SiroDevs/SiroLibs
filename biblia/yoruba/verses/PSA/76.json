  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "76",
        "style": "c",
        "sid": "PSA 76"
      },
      "items": [
        {
          "text": "76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 76",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Pẹ̀lú ohun èlò orin olókùn. Saamu ti Asafu. Orin.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 76:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní Juda ni a mọ Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:1"
      },
      "items": [
        {
          "text": "orúkọ rẹ̀ sì lágbára ní Israẹli",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.1",
            "verseOrgIds": [
              "PSA.76.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 76:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àgọ́ rẹ̀ wà ní Salẹmu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:2"
      },
      "items": [
        {
          "text": "ibùgbé rẹ̀ ni Sioni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.2",
            "verseOrgIds": [
              "PSA.76.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 76:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbẹ̀ ni ó ṣẹ́ ọfà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:3"
      },
      "items": [
        {
          "text": "asà àti àwọn idà, ohun ìjà ogun.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.3",
            "verseOrgIds": [
              "PSA.76.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.3",
                "verseOrgIds": [
                  "PSA.76.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 76:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ni ògo àti ọlá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:4"
      },
      "items": [
        {
          "text": "ju òkè ńlá ìkógun wọ̀nyí lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.4",
            "verseOrgIds": [
              "PSA.76.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 76:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kó àwọn alágídí ọkàn ní ìkógun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "wọ́n sun oorun ìgbẹ̀yìn wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "kò sí ọ̀kan nínú àwọn akọni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:5"
      },
      "items": [
        {
          "text": "tó lè gbé ọwọ́ rẹ̀ sókè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.5",
            "verseOrgIds": [
              "PSA.76.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 76:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìfibú rẹ, Ọlọ́run Jakọbu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:6"
      },
      "items": [
        {
          "text": "àwọn ẹṣin àti kẹ̀kẹ́ ogun sì dùbúlẹ̀ síbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.6",
            "verseOrgIds": [
              "PSA.76.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 76:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ nìkan ni ó yẹ kí a bẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:7"
      },
      "items": [
        {
          "text": "Ta ló lé dúró níwájú rẹ, nígbà tí ìwọ bá ń bínú?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.7",
            "verseOrgIds": [
              "PSA.76.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 76:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ń ṣe ìdájọ́ láti ọ̀run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:8"
      },
      "items": [
        {
          "text": "ilé ayé bẹ̀rù, ó sì dúró jẹ́ẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.8",
            "verseOrgIds": [
              "PSA.76.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 76:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nígbà tí, ìwọ Ọlọ́run,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:9"
      },
      "items": [
        {
          "text": "bá dìde láti ṣe ìdájọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 76:9"
      },
      "items": [
        {
          "text": "láti gba àwọn ẹni ìnilára ilẹ̀ náà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.9",
            "verseOrgIds": [
              "PSA.76.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.9",
                "verseOrgIds": [
                  "PSA.76.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 76:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòótọ́, ìbínú rẹ sí àwọn ènìyàn ń mú ìyìn wá fún ọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:10"
      },
      "items": [
        {
          "text": "ẹni tí ó yọ nínú ìbínú rẹ ní a dá nígbà tí ìwọ bá fi ìbínú ìyókù di ara rẹ ni àmùrè.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.10",
            "verseOrgIds": [
              "PSA.76.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 76:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ ẹ̀jẹ́ sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.76.11",
                "verseOrgIds": [
                  "PSA.76.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run rẹ kí o sì mú un ṣẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "kí gbogbo àwọn tí ó yí i ká",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:11"
      },
      "items": [
        {
          "text": "mú ẹ̀bùn wá fún ẹni tí ó tọ́ láti bẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.11",
            "verseOrgIds": [
              "PSA.76.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 76:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ké ẹ̀mí àwọn aládé kúrò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 76:12"
      },
      "items": [
        {
          "text": "àwọn ọba ayé sì ń bẹ̀rù rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.76.12",
            "verseOrgIds": [
              "PSA.76.13"
            ]
          }
        }
      ]
    }
  ],
