          "text": "90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "ÌWÉ KẸRIN",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.90-PSA.106"
          },
          "items": [
            {
              "text": "Saamu 90–106",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 90",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Àdúrà Mose ènìyàn Ọlọ́run.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 90:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.90.1",
                "verseOrgIds": [
                  "PSA.90.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ìwọ ti jẹ́ ibùgbé wa ní gbogbo ìran dé ìran.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.1",
            "verseOrgIds": [
              "PSA.90.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 90:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí a tó bí àwọn òkè ńlá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "àti kí ìwọ tó dá ilẹ̀ àti ayé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:2"
      },
      "items": [
        {
          "text": "láti ayérayé dé ayérayé ìwọ ni Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.2",
            "verseOrgIds": [
              "PSA.90.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 90:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yí ènìyàn padà sí erùpẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:3"
      },
      "items": [
        {
          "text": "wí pé, \"Padà sí erùpẹ̀, ìwọ ọmọ ènìyàn.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.3",
            "verseOrgIds": [
              "PSA.90.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 90:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé ìgbà tí ẹgbẹ̀rún (1,000) ọdún bá kọjá lójú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:4"
      },
      "items": [
        {
          "text": "bí àná ni ó rí, bí ìgbà ìṣọ́ kan lóru.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.4",
            "verseOrgIds": [
              "PSA.90.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 90:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ gbá ènìyàn dànù nínú oorun ikú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:5"
      },
      "items": [
        {
          "text": "wọ́n dàbí koríko tuntun ní òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.5",
            "verseOrgIds": [
              "PSA.90.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 90:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lóòtítọ́, ní òwúrọ̀, ó yọ tuntun",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:6"
      },
      "items": [
        {
          "text": "ní àṣálẹ́ ni yóò gbẹ, tí yóò sì rẹ̀ dànù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.6",
            "verseOrgIds": [
              "PSA.90.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 90:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "A pa wá run nípa ìbínú rẹ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:7"
      },
      "items": [
        {
          "text": "nípa ìbínú rẹ ara kò rọ̀ wá.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.7",
            "verseOrgIds": [
              "PSA.90.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 90:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti gbé ẹ̀ṣẹ̀ wa ka iwájú rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:8"
      },
      "items": [
        {
          "text": "àti ohun ìkọ̀kọ̀ wa nínú ìmọ́lẹ̀ iwájú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.8",
            "verseOrgIds": [
              "PSA.90.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 90:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ọjọ́ wa ń kọjá lọ lábẹ́ ìbínú rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:9"
      },
      "items": [
        {
          "text": "àwa ń lo ọjọ́ wa lọ bí àlá tí à ń rọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.9",
            "verseOrgIds": [
              "PSA.90.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 90:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àádọ́rin ọdún ni iye ọjọ́ ọdún wá,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "bi ó sì ṣe pé nípa agbára",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "tí wọn bá tó ọgọ́rin ọdún,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "agbára nínú làálàá pẹ̀lú ìbànújẹ́ ni,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "nítorí pé a kò ní pẹ́ gé e kúrò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:10"
      },
      "items": [
        {
          "text": "àwa a sì fò lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.10",
            "verseOrgIds": [
              "PSA.90.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 90:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ta ni ó mọ agbára ìbínú rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:11"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí ẹ̀rù rẹ, bẹ́ẹ̀ ni ìbínú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.11",
            "verseOrgIds": [
              "PSA.90.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 90:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ́ wa bí a ti ń kaye ọjọ́ wa dáradára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:12"
      },
      "items": [
        {
          "text": "kí àwa ba à lè fi ọkàn wa sípa ọgbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.12",
            "verseOrgIds": [
              "PSA.90.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 90:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yípadà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.90.13",
                "verseOrgIds": [
                  "PSA.90.13"
                ]
              }
            }
          ]
        },
        {
          "text": "! Yóò ti pẹ́ tó?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:13"
      },
      "items": [
        {
          "text": "Ṣàánú fún àwọn ọmọ ọ̀dọ̀ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.13",
            "verseOrgIds": [
              "PSA.90.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 90:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tẹ́ wa lọ́rùn ní òwúrọ̀ nínú ìṣeun ìfẹ́ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 90:14"
      },
      "items": [
        {
          "text": "kí àwa kí ó lè kọrin fún ayọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.90.14",
            "verseOrgIds": [
              "PSA.90.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
