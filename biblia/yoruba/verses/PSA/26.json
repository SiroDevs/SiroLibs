            "sid": "PSA 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣe ìdájọ́ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.1",
                "verseOrgIds": [
                  "PSA.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "nítorí tí mo ti ń rìn nínú ìwà òtítọ́ ọ̀ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "mo sì ti ní ìgbẹ́kẹ̀lé nínú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.1",
                "verseOrgIds": [
                  "PSA.26.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:1"
      },
      "items": [
        {
          "text": "ǹjẹ́ ẹsẹ̀ mi kì yóò yẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.1",
            "verseOrgIds": [
              "PSA.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wádìí mi wò, Ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.2",
                "verseOrgIds": [
                  "PSA.26.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí o sì dán mi wò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:2"
      },
      "items": [
        {
          "text": "dán àyà àti ọkàn mi wò;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.2",
            "verseOrgIds": [
              "PSA.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí ìfẹ́ ẹ̀ rẹ tí ó dúró ṣinṣin ń bẹ níwájú mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:3"
      },
      "items": [
        {
          "text": "èmí sì ti rìn nínú òtítọ́ rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.3",
            "verseOrgIds": [
              "PSA.26.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò jókòó pẹ̀lú aláìṣòótọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:4"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni èmi kì yóò bá àwọn àgàbàgebè wọlé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.4",
            "verseOrgIds": [
              "PSA.26.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti kórìíra àwùjọ àwọn ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:5"
      },
      "items": [
        {
          "text": "èmi kì yóò sì bá àwọn ènìyàn ìkà jókòó.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.5",
            "verseOrgIds": [
              "PSA.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí ó wẹ ọwọ́ mi ní àìlẹ́ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:6"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni èmi yóò sì yí pẹpẹ rẹ ká",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.6",
                "verseOrgIds": [
                  "PSA.26.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.6",
            "verseOrgIds": [
              "PSA.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò kọrin sókè àní orin ọpẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:7"
      },
      "items": [
        {
          "text": "èmi yóò sì máa sọ iṣẹ́ ìyanu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.7",
            "verseOrgIds": [
              "PSA.26.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Háà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.8",
                "verseOrgIds": [
                  "PSA.26.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", èmí ń fẹ́ ilé rẹ níbi tí ìwọ ń gbé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:8"
      },
      "items": [
        {
          "text": "àní níbi tí ògo rẹ̀ wà.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.8",
            "verseOrgIds": [
              "PSA.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe gbá mi dànù pẹ̀lú àwọn ẹlẹ́ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:9"
      },
      "items": [
        {
          "text": "tàbí ẹ̀mí mi pẹ̀lú àwọn ọkùnrin tí òǹgbẹ ẹ̀jẹ̀ ń gbẹ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.9",
            "verseOrgIds": [
              "PSA.26.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn tí ọwọ́ wọn kún fún ìwà ibi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:10"
      },
      "items": [
        {
          "text": "tí ọwọ́ ọ̀tún wọn kún fún àbẹ̀tẹ́lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.10",
            "verseOrgIds": [
              "PSA.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi ó máa rìn nínú ìwà títọ́;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:11"
      },
      "items": [
        {
          "text": "rà mí padà, kí o sì ṣàánú fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.11",
            "verseOrgIds": [
              "PSA.26.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹsẹ̀ mi dúró lórí ilẹ̀ tí ó tẹ́jú;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 26:12"
      },
      "items": [
        {
          "text": "nínú ìjọ ńlá èmi yóò fi ìbùkún fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.26.12",
                "verseOrgIds": [
                  "PSA.26.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.26.12",
            "verseOrgIds": [
              "PSA.26.12"
            ]
          }
        }
      ]
    }
