                "verseId": "PSA.94.14",
                "verseOrgIds": [
                  "PSA.94.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kò ní kọ àwọn ènìyàn rẹ̀ sílẹ̀,",
          "type": "text",
