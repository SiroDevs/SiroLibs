  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "49",
        "style": "c",
        "sid": "PSA 49"
      },
      "items": [
        {
          "text": "49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 49",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Ti àwọn ọmọ Kora. Saamu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 49:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọ́ èyí, gbogbo ènìyàn!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:1"
      },
      "items": [
        {
          "text": "Ẹ fi etí sí i, gbogbo ẹ̀yin aráyé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.1",
            "verseOrgIds": [
              "PSA.49.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 49:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ẹni tí ó ga àti ẹni tí ó kéré",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:2"
      },
      "items": [
        {
          "text": "tálákà àti ọlọ́lá pẹ̀lú!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.2",
            "verseOrgIds": [
              "PSA.49.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 49:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnu mi yóò sọ̀rọ̀ ọgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:3"
      },
      "items": [
        {
          "text": "èrò láti ọkàn mi yóò mú òye wá",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.3",
            "verseOrgIds": [
              "PSA.49.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 49:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "èmi yóò dẹ etí mi sílẹ̀ sí òwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:4"
      },
      "items": [
        {
          "text": "èmi yóò ṣí ọ̀rọ̀ ìkọ̀kọ̀ mi sílẹ̀ lójú okùn dùùrù.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.4",
            "verseOrgIds": [
              "PSA.49.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 49:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èéṣe ti èmi yóò bẹ̀rù nígbà tí ọjọ́ ibi dé?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:5"
      },
      "items": [
        {
          "text": "Nígbà tí ẹ̀ṣẹ̀ àwọn ajinnilẹ́sẹ̀ mi yí mi ká,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.5",
            "verseOrgIds": [
              "PSA.49.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 49:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn tí o gbẹ́kẹ̀lé ọrọ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:6"
      },
      "items": [
        {
          "text": "tí wọn sì ń ṣe ìlérí ni ọ̀pọ̀lọpọ̀ ọrọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.6",
            "verseOrgIds": [
              "PSA.49.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 49:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ọkùnrin tí ó lè ra ẹ̀mí ẹnìkejì rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "padà tàbí san owó ìràpadà fún",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:7"
      },
      "items": [
        {
          "text": "Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.7",
            "verseOrgIds": [
              "PSA.49.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ìràpadà fún ẹni jẹ́ iyebíye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:8"
      },
      "items": [
        {
          "text": "kò sì sí iye owó tó tó fún sísan rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.8",
            "verseOrgIds": [
              "PSA.49.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ní ti kí ó máa wà títí ayé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:9"
      },
      "items": [
        {
          "text": "láìrí isà òkú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.9",
            "verseOrgIds": [
              "PSA.49.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ọ̀pọ̀ ènìyàn rí ọkùnrin ọlọ́gbọ́n tí ó kú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "bẹ́ẹ̀ ni aṣiwèrè àti aláìlọ́gbọ́n pẹ̀lú ṣègbé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:10"
      },
      "items": [
        {
          "text": "wọ́n sì fi ọrọ̀ wọn sílẹ̀ fún ẹlòmíràn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.10",
            "verseOrgIds": [
              "PSA.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibojì wọn ni yóò jẹ́ ilé wọn láéláé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "ibùgbé wọn láti ìrandíran,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:11"
      },
      "items": [
        {
          "text": "wọn sọ orúkọ ilẹ̀ wọn ní orúkọ ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.11",
            "verseOrgIds": [
              "PSA.49.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọkùnrin tí o wà nínú ọlá kò dúró pẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:12"
      },
      "items": [
        {
          "text": "ó sì dàbí ẹranko tí ó ṣègbé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.12",
            "verseOrgIds": [
              "PSA.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni òtítọ́ àwọn ènìyàn tí ó",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "gbàgbọ́ nínú ara wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "àti àwọn tí ń tẹ̀lé wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:13"
      },
      "items": [
        {
          "text": "tí ó gba ọ̀rọ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.13",
            "verseOrgIds": [
              "PSA.49.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela.",
              "type": "text",
              "attrs": {
                "verseId": "PSA.49.13",
                "verseOrgIds": [
                  "PSA.49.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí àgùntàn ni a tẹ́ wọn sínú isà òkú",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "ikú yóò jẹun lórí wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "ẹni tí ó dúró ṣinṣin ni yóò,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "jẹ ọba lórí wọn ní òwúrọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "Ẹwà wọn yóò díbàjẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:14"
      },
      "items": [
        {
          "text": "isà òkú ni ibùgbé ẹwà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.14",
            "verseOrgIds": [
              "PSA.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Ọlọ́run yóò ra ọkàn mi padà",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "kúrò nínú isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 49:15"
      },
      "items": [
        {
          "text": "yóò gbé mi lọ sọ́dọ̀ òun fún rara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.15",
            "verseOrgIds": [
              "PSA.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe bẹ̀rù nígbà tí ẹnìkan bá di ọlọ́rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:16"
      },
      "items": [
        {
          "text": "Nígbà tí ìyìn ilé rẹ̀ ń pọ̀ sí i.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.16",
            "verseOrgIds": [
              "PSA.49.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kì yóò mú ohun kan lọ nígbà tí ó bá kú,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.17",
            "verseOrgIds": [
              "PSA.49.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:17"
      },
      "items": [
        {
          "text": "ògo rẹ̀ kò ní bá a sọ̀kalẹ̀ sí ipò òkú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.17",
            "verseOrgIds": [
              "PSA.49.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PSA 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó wà láyé, ó súre fún ọkàn ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.18",
            "verseOrgIds": [
              "PSA.49.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:18"
      },
      "items": [
        {
          "text": "Àwọn ènìyàn yìn ọ́ nígbà tí ìwọ ṣe rere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.18",
            "verseOrgIds": [
              "PSA.49.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PSA 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun yóò lọ sí ọ̀dọ̀ ìran àwọn baba rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.19",
            "verseOrgIds": [
              "PSA.49.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 49:19"
      },
      "items": [
        {
          "text": "àwọn tí ki yóò ri ìmọ́lẹ̀ ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.49.19",
            "verseOrgIds": [
              "PSA.49.20"
            ]
          }
        }
      ]
