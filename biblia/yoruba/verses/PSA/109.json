                "verseId": "PSA.109.20",
                "verseOrgIds": [
                  "PSA.109.20"
                ]
              }
            }
          ]
        },
        {
          "text": "wá;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.20",
            "verseOrgIds": [
