                "verseId": "PSA.109.21",
                "verseOrgIds": [
                  "PSA.109.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.109.21",
            "verseOrgIds": [
              "PSA.109.21"
            ]
          }
        }
