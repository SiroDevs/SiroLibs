              "attrs": {
                "verseId": "PSA.149.4",
                "verseOrgIds": [
                  "PSA.149.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ní inú dídùn sí àwọn ènìyàn rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
