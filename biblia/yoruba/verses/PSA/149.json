          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí àwọn ènìyàn mímọ́ kí ó yọ̀ nínú ọlá rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
