          "text": "Nítorí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
