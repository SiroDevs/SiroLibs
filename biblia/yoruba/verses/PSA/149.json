      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:7"
      },
      "items": [
        {
          "text": "àti ìjìyà lára àwọn ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
