      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:5"
      },
      "items": [
        {
          "text": "kí wọn kí ó máa kọrin fún ayọ̀ ní orí ibùsùn wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
