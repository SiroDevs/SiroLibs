            "sid": "PSA 149:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jẹ́ kí wọn kí ó fi ijó yin orúkọ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:3"
      },
      "items": [
        {
          "text": "jẹ́ kí wọn kí ó fi ohun èlò orin kọrin ìyìn sí i.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
