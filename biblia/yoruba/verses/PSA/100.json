              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.100.5",
                "verseOrgIds": [
                  "PSA.100.5"
                ]
              }
            }
          ]
        },
        {
          "text": "pọ̀ ní oore",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.5",
            "verseOrgIds": [
              "PSA.100.5"
            ]
          }
        }
      ]
