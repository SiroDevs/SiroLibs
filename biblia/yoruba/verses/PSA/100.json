                "verseOrgIds": [
                  "PSA.100.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbogbo ayé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.1",
            "verseOrgIds": [
