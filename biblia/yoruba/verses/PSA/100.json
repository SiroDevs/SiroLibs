    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "àti àgùntàn pápá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
