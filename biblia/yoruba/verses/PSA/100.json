          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ lọ sí ẹnu-ọ̀nà rẹ̀ pẹ̀lú ọpẹ́",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "àti sí àgbàlá rẹ̀ pẹ̀lú ìyìn;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
