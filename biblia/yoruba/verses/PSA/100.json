      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 100:4"
      },
      "items": [
        {
          "text": "ẹ fi ọpẹ́ àti ìyìn fún orúkọ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.4",
            "verseOrgIds": [
              "PSA.100.4"
            ]
          }
        }
      ]
    },
