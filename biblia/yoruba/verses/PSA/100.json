      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 100:3"
      },
      "items": [
        {
          "text": "tirẹ̀ ni àwa, àwa ní ènìyàn rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.100.3",
            "verseOrgIds": [
              "PSA.100.3"
            ]
          }
