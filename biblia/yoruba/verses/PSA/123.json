              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ní mo gbé ojú mí sókè sí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.1",
            "verseOrgIds": [
              "PSA.123.1"
            ]
