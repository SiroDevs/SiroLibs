      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:2"
      },
      "items": [
        {
          "text": "ìránṣẹ́kùnrin ti máa ń wo ọwọ́ àwọn baba wọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.2",
            "verseOrgIds": [
              "PSA.123.2"
            ]
          }
        }
