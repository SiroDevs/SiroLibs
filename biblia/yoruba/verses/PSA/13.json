  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "PSA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ti pẹ́ tó,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.1",
                "verseOrgIds": [
                  "PSA.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": "? Ìwọ o ha gbàgbé mi títí láé?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:1"
      },
      "items": [
        {
          "text": "Yóò tí pẹ́ tó tí ìwọ yóò máa fi ojú rẹ pamọ́ fún mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò ti pẹ́ tó tí èmi ó máa bá èrò mi jà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "àti ní ojoojúmọ́ ni èmi ń ní ìbànújẹ́ ní ọkàn mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "Yóò ti pẹ́ tó tí àwọn ọ̀tá mi yóò máa borí mi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wò mí kí o sì dá mi lóhùn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.3",
                "verseOrgIds": [
                  "PSA.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:3"
      },
      "items": [
        {
          "text": "Fi ìmọ́lẹ̀ fún ojú mi, kí èmi ó má sún oorun ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀tá mi wí pé, \"Èmi ti ṣẹ́gun rẹ̀,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:4"
      },
      "items": [
        {
          "text": "àwọn ọ̀tá mi yóò yọ̀ tí mo bá ṣubú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n mo gbẹ́kẹ̀lé ìfẹ́ rẹ tí kì í kùnà;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:5"
      },
      "items": [
        {
          "text": "ọkàn mi ń yọ̀ nínú ìgbàlà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ó máa kọrin sí",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.13.6",
                "verseOrgIds": [
                  "PSA.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:6"
      },
      "items": [
        {
          "text": "nítorí ó dára sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    }
  ],
