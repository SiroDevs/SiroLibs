        "number": "41",
        "style": "c",
        "sid": "PSA 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Saamu Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìbùkún ni fún ẹni tí ó ń ro ti aláìní:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.1",
                "verseOrgIds": [
                  "PSA.41.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbà á ní ìgbà ìpọ́njú.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.1",
            "verseOrgIds": [
              "PSA.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.2",
                "verseOrgIds": [
                  "PSA.41.3"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò dáàbò bò ó yóò sì pa ọkàn rẹ̀ mọ́:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "yóò bùkún fún un ní orí ilẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:2"
      },
      "items": [
        {
          "text": "kò sì ní fi sílẹ̀ fún ìfẹ́ àwọn ọ̀tá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.2",
            "verseOrgIds": [
              "PSA.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.3",
                "verseOrgIds": [
                  "PSA.41.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbà á lórí àkéte àìsàn rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:3"
      },
      "items": [
        {
          "text": "yóò sì mú un padà bọ̀ sípò kúrò nínú àìsàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.3",
            "verseOrgIds": [
              "PSA.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti èmi, mo wí pé \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.4",
                "verseOrgIds": [
                  "PSA.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣàánú fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:4"
      },
      "items": [
        {
          "text": "wò mí sàn, nítorí pé mo ti ṣẹ̀ sí ọ\".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.4",
            "verseOrgIds": [
              "PSA.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀tá mi ń sọ̀rọ̀ mi nínú àrankàn, pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:5"
      },
      "items": [
        {
          "text": "\"Nígbà wo ni yóò kú, ti orúkọ rẹ̀ yóò sì run?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.5",
            "verseOrgIds": [
              "PSA.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbàkígbà tí ẹnìkan bá wá wò mí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "wọn ń sọ̀rọ̀ ẹ̀tàn, nígbà tí àyà rẹ̀ bá kó ẹ̀ṣẹ̀ jọ sí ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:6"
      },
      "items": [
        {
          "text": "nígbà tí ó bá jáde lọ yóò sì máa tàn án kálẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.6",
            "verseOrgIds": [
              "PSA.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀tá mi gbìmọ̀ papọ̀ nípa mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:7"
      },
      "items": [
        {
          "text": "èmi ni wọ́n ń gbìmọ̀ ibi sí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.7",
            "verseOrgIds": [
              "PSA.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wọ́n wí pé, \"Ohun búburú ni ó dì mọ́ ọn ṣinṣin",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:8"
      },
      "items": [
        {
          "text": "àti ní ibi tí ó dùbúlẹ̀ sí,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:8"
      },
      "items": [
        {
          "text": "kì yóò dìde mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.8",
            "verseOrgIds": [
              "PSA.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pàápàá, ọ̀rẹ́ mi tímọ́tímọ́, ẹni tí mo gbẹ́kẹ̀lé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "ẹni tí ó ń jẹ nínú oúnjẹ mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:9"
      },
      "items": [
        {
          "text": "tí gbé gìgísẹ̀ rẹ̀ sókè sí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.9",
            "verseOrgIds": [
              "PSA.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.10",
                "verseOrgIds": [
                  "PSA.41.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ṣàánú fún mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:10"
      },
      "items": [
        {
          "text": "gbé mi sókè, kí ń ba lè san fún wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.10",
            "verseOrgIds": [
              "PSA.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi mọ̀ pé inú rẹ̀ dùn sí mi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:11"
      },
      "items": [
        {
          "text": "nítorí ọ̀tá mi kò borí mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.11",
            "verseOrgIds": [
              "PSA.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó ṣe tèmi ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 41:12"
      },
      "items": [
        {
          "text": "ìwọ dì mímú nínú ìwà òtítọ́ mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 41:12"
      },
      "items": [
        {
          "text": "ìwọ sì gbé mi kalẹ̀ níwájú rẹ títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.12",
            "verseOrgIds": [
              "PSA.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olùbùkún ni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.41.13",
            "verseOrgIds": [
              "PSA.41.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.41.13",
                "verseOrgIds": [
                  "PSA.41.14"
                ]
              }
            }
          ]
