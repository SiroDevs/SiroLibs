  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PSA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Saamu 4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Fún adarí orin. Pẹ̀lú ohun èlò orin olókùn. Saamu ti Dafidi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dá mi lóhùn nígbà tí mo bá pè ọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "ìwọ Ọlọ́run òdodo mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "Fún mi ní ìdáǹdè nínú ìpọ́njú mi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:1"
      },
      "items": [
        {
          "text": "ṣàánú fún mi, kí o sì gbọ́ àdúrà mi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.1",
            "verseOrgIds": [
              "PSA.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báwo ni yóò ṣe pẹ́ tó, ẹ̀yin ọmọ ènìyàn, tí ẹ ó ṣe sọ ògo mi di ìtìjú?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:2"
      },
      "items": [
        {
          "text": "Báwo ni yóò ṣe pẹ́ tó, tí ẹ̀yin yóò ṣe fẹ́ràn ìtànjẹ àti tí ẹ̀yin yóò fi máa wá ọlọ́run èké?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.2",
            "verseOrgIds": [
              "PSA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kí ẹ mọ̀ pé,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.3",
                "verseOrgIds": [
                  "PSA.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ti ya ẹni olódodo sọ́tọ̀ fún ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.3",
                "verseOrgIds": [
                  "PSA.4.4"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò gbọ́ nígbà tí mo bá pè é.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.3",
            "verseOrgIds": [
              "PSA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ bínú ẹ má ṣe ṣẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "nígbà tí ẹ bá wà lórí ibùsùn yín,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:4"
      },
      "items": [
        {
          "text": "ẹ bá ọkàn yín sọ̀rọ̀, kí ó sì dákẹ́ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.4",
            "verseOrgIds": [
              "PSA.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ rú ẹbọ òdodo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:5"
      },
      "items": [
        {
          "text": "kí ẹ sì gbẹ́kẹ̀lé",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.5",
                "verseOrgIds": [
                  "PSA.4.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.5",
            "verseOrgIds": [
              "PSA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀lọpọ̀ ló ń béèrè pé, \"Ta ni yóò ṣe rere fún wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:6"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.6",
                "verseOrgIds": [
                  "PSA.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", jẹ́ kí ojú rẹ mọ́lẹ̀ sí wa lára,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.6",
            "verseOrgIds": [
              "PSA.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ ti fi ayọ̀ púpọ̀ kún ọkàn mi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:7"
      },
      "items": [
        {
          "text": "ju ìgbà tí hóró irúgbìn àti wáìnì tuntun wọ́n pọ̀ fún mi lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.7",
            "verseOrgIds": [
              "PSA.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò dùbúlẹ̀, èmi ó sì sùn ní àlàáfíà,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "nítorí ìwọ nìkan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PSA.4.8",
                "verseOrgIds": [
                  "PSA.4.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 4:8"
      },
      "items": [
        {
          "text": "ni o mú mi gbé láìléwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.4.8",
            "verseOrgIds": [
              "PSA.4.9"
            ]
          }
        }
      ]
    }
  ],
