        {
          "text": "Ọ̀pá fìtílà kìkì wúrà, márùn-ún ní apá ọ̀tún àti márùn-ún ní apá òsì, níwájú ibi mímọ́ jùlọ; ìtànná ewéko;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
          }
        }
