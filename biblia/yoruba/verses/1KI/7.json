      "attrs": {
        "style": "li1",
        "vid": "1KI 7:49"
      },
      "items": [
        {
          "text": "fìtílà àti ẹ̀mú wúrà;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.49",
            "verseOrgIds": [
              "1KI.7.49"
            ]
