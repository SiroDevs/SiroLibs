  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbà àjàrà Naboti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe lẹ́yìn nǹkan wọ̀nyí Naboti ará Jesreeli sì ní ọgbà àjàrà kan ní Jesreeli, ní ẹ̀gbẹ́ ààfin Ahabu ọba Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.1",
            "verseOrgIds": [
              "1KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu sì wí fún Naboti pé, \"Fún mi ní ọgbà àjàrà rẹ, kí èmi kí ó fi ṣe ọgbà-ewébẹ̀, nítorí tí ó súnmọ́ tòsí ilé mi, èmi yóò sì fún ọ ní ọgbà àjàrà tí ó sàn jù ú lọ dípò rẹ̀; tàbí bí ó bá sì dára ní ojú rẹ, èmi yóò fi iye owó rẹ̀ fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.2",
            "verseOrgIds": [
              "1KI.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Naboti wí fún Ahabu pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.3",
                "verseOrgIds": [
                  "1KI.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "má jẹ́ kí èmi fi ogún àwọn baba mi fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu sì wá sí ilé rẹ̀, ó wugbọ́, inú rẹ̀ sì bàjẹ́ nítorí ọ̀rọ̀ tí Naboti ará Jesreeli sọ fún un; nítorí tí ó wí pé, \"Èmi kì yóò fún ọ ní ogún àwọn baba mi.\" Ó sì dùbúlẹ̀ lórí ibùsùn rẹ̀, ó sì yí ojú rẹ̀ padà, kò sì fẹ́ jẹun.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.4",
            "verseOrgIds": [
              "1KI.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesebeli aya rẹ̀ sì tọ̀ ọ́ wá, ó sì béèrè lọ́wọ́ rẹ̀ pé, \"Èéṣe tí inú rẹ fi bàjẹ́, èéṣe tí ìwọ kò sì jẹun?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.5",
            "verseOrgIds": [
              "1KI.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dá a lóhùn pé, \"Nítorí tí mo wí fún Naboti ará Jesreeli pé, 'Ta ọgbà àjàrà rẹ fún mi, tàbí bí ó bá wù ọ́, èmi yóò fún ọ ní ọgbà àjàrà mìíràn ní ipò rẹ̀.' Ṣùgbọ́n ó wí pé, 'Èmi kì yóò fún ọ ní ọgbà àjàrà mi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.6",
            "verseOrgIds": [
              "1KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesebeli aya rẹ̀ sì wí pé, \"Ṣé báyìí ni ìwọ yóò ṣe ṣe bí ọba lórí Israẹli? Dìde, jẹun! Kí o sì jẹ́ kí inú rẹ̀ dùn. Èmi yóò sì fún ọ ní ọgbà àjàrà Naboti ará Jesreeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni ó kọ̀wé ní orúkọ Ahabu, ó sì fi èdìdì rẹ̀ dì í, ó sì fi ìwé náà ránṣẹ́ sí àwọn àgbàgbà àti àwọn ọlọ́lá tí ó ń gbé ní ìlú Naboti pẹ̀lú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.8",
            "verseOrgIds": [
              "1KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú àwọn ìwé náà, ó kọ pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 21:9"
      },
      "items": [
        {
          "text": "\"Ẹ kéde àwẹ̀, kí ẹ sì fi Naboti sí ipò ọlá láàrín àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n kí ẹ fi ènìyàn méjì, ẹni búburú síwájú rẹ̀ láti jẹ́rìí sí i wí pé, ó bú Ọlọ́run àti ọba. Nígbà náà ni kí ẹ mú u jáde, kí ẹ sì sọ ọ́ ní òkúta pa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn àgbàgbà àti àwọn ọlọ́lá tí wọ́n ń ṣe ará ìlú Naboti sì ṣe gẹ́gẹ́ bí ìwé tí Jesebeli kọ ránṣẹ́ sí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.11",
            "verseOrgIds": [
              "1KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì kéde àwẹ̀, wọ́n sì fi Naboti sí ipò ọlá láàrín àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.12",
            "verseOrgIds": [
              "1KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni àwọn ọkùnrin méjì sì dé, àwọn ẹni búburú, wọ́n sì jókòó síwájú rẹ̀, wọ́n sì jẹ́rìí lòdì sí Naboti níwájú àwọn ènìyàn wí pé, \"Naboti ti bú Ọlọ́run àti ọba.\" Nígbà náà ni wọ́n mú jáde kúrò ní ìlú, wọ́n sì sọ ọ́ ní òkúta pa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni wọ́n ránṣẹ́ sí Jesebeli wí pé, \"A ti sọ Naboti ní òkúta, ó sì kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí Jesebeli sì ti gbọ́ pé, a ti sọ Naboti ní Òkúta pa, ó sì wí fún Ahabu pé, \"Dìde! Kí o sì jogún ọgbà àjàrà Naboti, ará Jesreeli, tí ó kọ̀ láti tà fún ọ kò sí láààyè mọ́, ó ti kú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Ahabu sì gbọ́ pé Naboti ti kú, ó sì dìde, ó sì sọ̀kalẹ̀ lọ láti jogún ọgbà àjàrà Naboti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.17",
                "verseOrgIds": [
                  "1KI.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Elijah ará Tiṣibi wá wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ̀kalẹ̀ lọ láti lọ pàdé Ahabu ọba Israẹli, tí ó wà ní Samaria. Ó wà ní ọgbà àjàrà Naboti báyìí, níbi tí ó sọ̀kalẹ̀ lọ láti jogún rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ fún un pé, 'Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.19",
                "verseOrgIds": [
                  "1KI.21.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Ǹjẹ́ ìwọ kò ti pa ènìyàn, o sì ti fi agbára gba ogún rẹ̀?' Nígbà náà ni kí o wí fún un pé, 'Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.19",
                "verseOrgIds": [
                  "1KI.21.19"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: Níbi tí ajá gbé lá ẹ̀jẹ̀ Naboti, ni àwọn ajá yóò lá ẹ̀jẹ̀ rẹ, àní tìrẹ!' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu sì wí fún Elijah pé, \"Ìwọ ti rí mi, ìwọ ọ̀tá mi!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 21:20"
      },
      "items": [
        {
          "text": "Ó sì dáhùn wí pé, \"Èmi ti rí ọ, nítorí tí ìwọ ti tan ara rẹ láti ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.20",
                "verseOrgIds": [
                  "1KI.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Èmi yóò mú ibi wá sórí rẹ. Èmi yóò sì mú ìran rẹ kúrò, èmi yóò sì ké kúrò lọ́dọ̀ Ahabu gbogbo ọmọdé ọkùnrin, àti ọmọ ọ̀dọ̀, àti òmìnira ní Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣe ilé rẹ bí ilé Jeroboamu, ọmọ Nebati, àti bí ilé Baaṣa, ọmọ Ahijah, nítorí ìwọ ti mú mi bínú, ìwọ sì ti mú Israẹli ṣẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àti ní ti Jesebeli pẹ̀lú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.23",
                "verseOrgIds": [
                  "1KI.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "wí pé, 'Àwọn ajá yóò jẹ Jesebeli nínú yàrá Jesreeli.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Àwọn ajá yóò jẹ ẹni Ahabu tí ó kú ní ìlú, àwọn ẹyẹ ojú ọ̀run yóò jẹ àwọn ẹni tí ó kú ní igbó.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kò sí ẹnìkan bí Ahabu tí ó ta ara rẹ̀ láti ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.25",
                "verseOrgIds": [
                  "1KI.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", ẹni tí Jesebeli aya rẹ̀ ń tì.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ohun ìríra gidigidi ní tí tọ òrìṣà lẹ́yìn, gẹ́gẹ́ bí gbogbo ohun tí àwọn ará Amori ti ṣe, tí",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.26",
                "verseOrgIds": [
                  "1KI.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "lé jáde níwájú àwọn ọmọ Israẹli.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Ahabu sì gbọ́ àwọn ọ̀rọ̀ wọ̀nyí, ó sì fa aṣọ rẹ̀ ya, ó sì fi aṣọ ọ̀fọ̀ sí ara rẹ̀, ó sì gbààwẹ̀. Ó sì dùbúlẹ̀ nínú aṣọ ọ̀fọ̀, ó sì ń lọ jẹ́ẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.27",
            "verseOrgIds": [
              "1KI.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.21.28",
                "verseOrgIds": [
                  "1KI.21.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Elijah ará Tiṣibi wá wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ ìwọ ti rí bí Ahabu ti rẹ̀ ara rẹ̀ sílẹ̀ níwájú mi? Nítorí tí ó ti rẹ̀ ara rẹ̀ sílẹ̀, èmi kì yóò mú ibi náà wá ní ọjọ́ rẹ, ṣùgbọ́n èmi yóò mú u wá sí ilé rẹ̀ ní ọjọ́ ọmọ rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.29",
            "verseOrgIds": [
              "1KI.21.29"
            ]
          }
        }
      ]
    }
  ],
