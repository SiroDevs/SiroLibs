  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1KI 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.1",
                "verseOrgIds": [
                  "1KI.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Jehu ọmọ Hanani wá sí Baaṣa pé,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.1",
            "verseOrgIds": [
              "1KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èmi ti gbé ọ ga láti inú erùpẹ̀ wá, mo sì fi ọ́ ṣe olórí Israẹli ènìyàn mi, ṣùgbọ́n ìwọ sì rìn ní ọ̀nà Jeroboamu, ó sì mú kí Israẹli ènìyàn mi dẹ́ṣẹ̀, láti mú mi bínú nípa ẹ̀ṣẹ̀ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.2",
            "verseOrgIds": [
              "1KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, èmi yóò mú Baaṣa àti ilé rẹ̀ kúrò, èmi yóò sì ṣe ilé rẹ̀ bí ilé Jeroboamu ọmọ Nebati.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.3",
            "verseOrgIds": [
              "1KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ajá yóò jẹ ẹni Baaṣa tí ó bá kú ní ìlú, ẹyẹ ojú ọ̀run yóò sì jẹ àwọn tí ó kú ní oko.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.4",
            "verseOrgIds": [
              "1KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ìyókù ìṣe Baaṣa, ohun tí ó ṣe àti agbára rẹ̀, a kò ha kọ wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.5",
            "verseOrgIds": [
              "1KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baaṣa sì sùn pẹ̀lú àwọn baba rẹ̀, a sì sin ín ní Tirsa. Ela ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.6",
            "verseOrgIds": [
              "1KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.7",
                "verseOrgIds": [
                  "1KI.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì wá nípa ọwọ́ Jehu wòlíì ọmọ Hanani pẹ̀lú sí Baaṣa àti ilé rẹ̀, nítorí gbogbo búburú tí ó ti ṣe níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.7",
                "verseOrgIds": [
                  "1KI.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ní mímú un bínú nípa ohun tó ti ṣe àti wíwà bí ilé Jeroboamu, àti nítorí tí ó pa á run pẹ̀lú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.7",
            "verseOrgIds": [
              "1KI.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ela ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹrìndínlọ́gbọ̀n Asa ọba Juda, Ela ọmọ Baaṣa bẹ̀rẹ̀ sí ní jẹ ọba ní Israẹli, ó sì jẹ ọba ní Tirsa ní ọdún méjì.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.8",
            "verseOrgIds": [
              "1KI.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simri, ọ̀kan nínú àwọn ìránṣẹ́ rẹ̀, olórí ìdajì kẹ̀kẹ́ rẹ̀, dìtẹ̀ sí i. Ela sì wà ní Tirsa nígbà náà, ó sì mu àmupara ní ilé Arsa, ìríjú ilé rẹ̀ ni Tirsa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.9",
            "verseOrgIds": [
              "1KI.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simri sì wọlé, ó sì kọlù ú, ó sì pa á ní ọdún kẹtàdínlọ́gbọ̀n Asa, ọba Juda, ó sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.10",
            "verseOrgIds": [
              "1KI.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti bẹ̀rẹ̀ sí ní jẹ ọba, bí ó sì ti jókòó lórí ìtẹ́, ó lu gbogbo ilé Baaṣa pa, kò ku ọkùnrin kan sílẹ̀, bóyá ìbátan tàbí ọ̀rẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.11",
            "verseOrgIds": [
              "1KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni Simri pa gbogbo ilé Baaṣa run, gẹ́gẹ́ bí ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.12",
                "verseOrgIds": [
                  "1KI.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ sí Baaṣa nípa ọwọ́ Jehu wòlíì:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.12",
            "verseOrgIds": [
              "1KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí gbogbo ẹ̀ṣẹ̀ tí Baaṣa àti Ela ọmọ rẹ̀ ti ṣẹ̀ àti tí wọ́n ti mú Israẹli ṣẹ̀, tí wọ́n fi mú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.13",
                "verseOrgIds": [
                  "1KI.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli bínú, wọ́n mú u bínú nípa òrìṣà asán wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.13",
            "verseOrgIds": [
              "1KI.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù ìṣe Ela àti gbogbo ohun tí ó ṣe, a kò ha kọ wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.14",
            "verseOrgIds": [
              "1KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Simri ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kẹtàdínlọ́gbọ̀n Asa ọba Juda, ni Simri jẹ ọba ọjọ́ méje ní Tirsa. Àwọn ọmọ-ogun sì dó ti Gibetoni, ìlú àwọn ará Filistini.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ọmọ Israẹli tí ó dó tì gbọ́ wí pé Simri ti dìtẹ̀ sí ọba, ó sì ti pa á, wọ́n kéde Omri, olórí ogun, bí ọba lórí Israẹli ní ọjọ́ náà ní ibùdó.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Omri àti gbogbo Israẹli pẹ̀lú rẹ̀ kúrò ní Gibetoni, wọ́n sì dó ti Tirsa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Simri sì ri pé a ti gba ìlú, ó sì wọ inú ààfin ilé ọba lọ, ó sì tẹ iná bọ ilé ọba lórí ara rẹ̀, ó sì kú,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí àwọn ẹ̀ṣẹ̀ rẹ̀ tí ó ti ṣẹ̀, ní ṣíṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.19",
                "verseOrgIds": [
                  "1KI.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "àti ní rírìn ní ọ̀nà Jeroboamu àti nínú ẹ̀ṣẹ̀ rẹ̀ tí ó ti ṣe àti tí ó ti mú Israẹli ṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.19",
            "verseOrgIds": [
              "1KI.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ti ìyókù ìṣe Simri, àti ọ̀tẹ̀ rẹ̀ tí ó dì, a kò ha kọ wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omri ọba Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ní àwọn ènìyàn Israẹli dá sí méjì; apá kan wọn ń tọ Tibni ọmọ Ginati lẹ́yìn, láti fi í jẹ ọba, apá kan tókù sì ń tọ Omri lẹ́yìn.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ènìyàn tí ń tọ Omri lẹ́yìn borí àwọn tí ń tọ Tibni ọmọ Ginati lẹ́yìn. Bẹ́ẹ̀ ni Tibni kú, Omri sì jẹ ọba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kọkànlélọ́gbọ̀n Asa ọba Juda, Omri bẹ̀rẹ̀ sí ń jẹ ọba lórí Israẹli, ó sì jẹ ọba ní ọdún méjìlá, ọdún mẹ́fà ní Tirsa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.23",
            "verseOrgIds": [
              "1KI.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ra òkè Samaria lọ́wọ́ Ṣemeri ní tálẹ́ǹtì méjì fàdákà, ó sì kọ́ ìlú sórí rẹ̀, ó sì pe ìlú náà ní Samaria, nípa orúkọ Ṣemeri, orúkọ ẹni tí ó kọ́kọ́ ni òkè náà.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.24",
            "verseOrgIds": [
              "1KI.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Omri sì ṣe búburú níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.25",
                "verseOrgIds": [
                  "1KI.16.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ó sì ṣe búburú ju gbogbo àwọn tí ó wà ṣáájú rẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.25",
            "verseOrgIds": [
              "1KI.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó rìn ní gbogbo ọ̀nà Jeroboamu ọmọ Nebati àti nínú ẹ̀ṣẹ̀ rẹ̀, èyí tí ó ti mú Israẹli ṣẹ̀, láti fi ohun asán wọn mú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.26",
                "verseOrgIds": [
                  "1KI.16.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọlọ́run Israẹli bínú.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.26",
            "verseOrgIds": [
              "1KI.16.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyókù ìṣe àti ohun tí Omri ṣe, àti agbára rẹ tí ó fihàn, a kò ha kọ, wọ́n sínú ìwé ọ̀rọ̀ ọjọ́ àwọn ọba Israẹli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omri sì sùn pẹ̀lú àwọn baba rẹ̀ a sì sin ín ní Samaria. Ahabu ọmọ rẹ̀ sì jẹ ọba ní ipò rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahabu Jọba lórí Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdún kejìdínlógójì Asa ọba Juda, Ahabu ọmọ Omri jẹ ọba ní Israẹli, o si jẹ ọba lórí Israẹli ní Samaria ní ọdún méjìlélógún.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.29",
            "verseOrgIds": [
              "1KI.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu ọmọ Omri sì ṣe búburú ní ojú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.30",
                "verseOrgIds": [
                  "1KI.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": "ju gbogbo àwọn tí ó wà ṣáájú rẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.30",
            "verseOrgIds": [
              "1KI.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe bí ẹni pé ó ṣe ohun kékeré fún un láti máa rìn nínú ẹ̀ṣẹ̀ Jeroboamu ọmọ Nebati, ó sì mú Jesebeli, ọmọbìnrin Etibaali, ọba àwọn ará Sidoni ní aya, ó sì bẹ̀rẹ̀ sí ń sin Baali, ó sì bọ ọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.31",
            "verseOrgIds": [
              "1KI.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì tẹ́ pẹpẹ kan fún Baali nínú ilé Baali tí ó kọ́ sí Samaria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.32",
            "verseOrgIds": [
              "1KI.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabu sì túnṣe ère òrìṣà Aṣerah, ó sì ṣe púpọ̀ láti mú",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.33",
                "verseOrgIds": [
                  "1KI.16.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run Israẹli bínú ju èyí tí gbogbo ọba Israẹli tí ó ti wà ṣáájú rẹ̀ ti ṣe lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.33",
            "verseOrgIds": [
              "1KI.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà ayé Ahabu, Hieli ará Beteli kọ́ Jeriko. Ó fi ìpìlẹ̀ rẹ̀ lé ilẹ̀ ní Abiramu, àkọ́bí rẹ, ó sì gbé àwọn ìlẹ̀kùn ibodè rẹ̀ kọ́ ní Segubu àbíkẹ́yìn rẹ̀, gẹ́gẹ́ bí ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1KI.16.34",
                "verseOrgIds": [
                  "1KI.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti ipa Joṣua ọmọ Nuni sọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.34",
            "verseOrgIds": [
              "1KI.16.34"
            ]
          }
        }
      ]
    }
  ],
