              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi mọ̀ iṣẹ́, ìfẹ́, àti ìgbàgbọ́ àti ìsìn àti sùúrù rẹ̀; àti pé iṣẹ́ rẹ̀ ìkẹyìn ju tí ìṣáájú lọ.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.19",
                "verseOrgIds": [
                  "REV.2.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n èyí ni mo rí wí sí ọ, nítorí tí ìwọ fi ààyè sílẹ̀ fún obìnrin Jesebeli tí ó ń pe ara rẹ̀ ní wòlíì. Nípasẹ̀ ẹ̀kọ́ rẹ̀, ó sì ń kọ́ àwọn ìránṣẹ́ mi, ó sì ń tàn wọ́n láti máa ṣe àgbèrè, àti láti máa jẹ ohun tí a pa rú ẹbọ sì òrìṣà.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.20",
                "verseOrgIds": [
                  "REV.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi fi àkókò fún un, láti ronúpìwàdà; ṣùgbọ́n òun kò fẹ́ ronúpìwàdà àgbèrè rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.21",
                "verseOrgIds": [
                  "REV.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.21",
            "verseOrgIds": [
              "REV.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, èmi ó gbé e sọ sí orí àkéte ìpọ́njú, àti àwọn tí ń bá a ṣe panṣágà ni èmi ó fi sínú ìpọ́njú ńlá, bí kò ṣe bí wọ́n bá ronúpìwàdà iṣẹ́ wọn.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.22",
                "verseOrgIds": [
                  "REV.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.22",
            "verseOrgIds": [
              "REV.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi o pa àwọn ọmọ rẹ̀ run; gbogbo ìjọ ni yóò sì mọ̀ pé, èmi ni ẹni tí ń wádìí inú àti ọkàn, èmi ó sì fi fún olúkúlùkù yín gẹ́gẹ́ bí iṣẹ́ rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.23",
                "verseOrgIds": [
                  "REV.2.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
