              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àti sí angẹli ìjọ ní Tiatira kọ̀wé.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.18",
                "verseOrgIds": [
                  "REV.2.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:18"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ni Ọmọ Ọlọ́run wí, ẹni tí ojú rẹ̀ dàbí ọ̀wọ́-iná, tí ẹsẹ̀ rẹ̀ sì dàbí idẹ dáradára.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.18",
                "verseOrgIds": [
                  "REV.2.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
