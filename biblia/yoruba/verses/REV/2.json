          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
