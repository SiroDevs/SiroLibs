          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Òun ó sì máa fi ọ̀pá irin ṣe àkóso wọn; gẹ́gẹ́ bí a ti ń fọ́ ohun èlò amọ̀kòkò ni a ó fọ́ wọn túútúú,' gẹ́gẹ́ bí èmi pẹ̀lú tí gbà àṣẹ láti ọ̀dọ̀ Baba mi.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.27",
                "verseOrgIds": [
                  "REV.2.27"
                ]
              }
            }
          ]
        },
        {
