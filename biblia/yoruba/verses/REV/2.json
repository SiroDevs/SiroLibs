          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n ẹ̀yin ni mò ń sọ fún, ẹ̀yin ìyókù tí ń bẹ ní Tiatira, gbogbo ẹ̀yin tí kò ni ẹ̀kọ́ yìí, ti kò ì tí ì mọ̀ ohun tí wọn pè ni ohun ìjìnlẹ̀ Satani, èmi kò di ẹrù mìíràn rù yín,",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.24",
                "verseOrgIds": [
                  "REV.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
