  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "REV 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sí ìjọ Efesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sí angẹli ìjọ ní Efesu kọ̀wé:",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.1",
                "verseOrgIds": [
                  "REV.2.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ní ẹni tí ó mú ìràwọ̀ méje náà ni ọwọ́ ọ̀tún rẹ̀ wí, ẹni tí ń rìn ní àárín ọ̀pá wúrà fìtílà méje.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.1",
                "verseOrgIds": [
                  "REV.2.1"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi mọ iṣẹ́ rẹ, àti làálàá rẹ, àti ìfaradà rẹ, àti bí ara rẹ kò ti gba àwọn ẹni búburú, àti bí ìwọ sì ti dán àwọn tí ń pe ara wọn ní aposteli, tí wọ́n kì í sì í ṣe bẹ́ẹ̀ wo, tí ìwọ sì rí pé èké ni wọ́n,",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.2",
                "verseOrgIds": [
                  "REV.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.2",
            "verseOrgIds": [
              "REV.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "tí ìwọ sì faradà ìyà, àti nítorí orúkọ mi tí ó sì rọ́jú, tí àárẹ̀ kò sì mú ọ.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.3",
                "verseOrgIds": [
                  "REV.2.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Síbẹ̀ èyí ni mo rí wí sí ọ, pé, ìwọ ti fi ìfẹ́ ìṣáájú rẹ sílẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.4",
                "verseOrgIds": [
                  "REV.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.4",
            "verseOrgIds": [
              "REV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Rántí ibi tí ìwọ ti gbé ṣubú! Ronúpìwàdà, kí ó sì ṣe iṣẹ́ ìṣáájú; bí kò sì ṣe bẹ́ẹ̀, èmi ó sì tọ̀ ọ́ wá, èmi ó sì ṣí ọ̀pá fìtílà rẹ̀ kúrò ní ipò rẹ̀, bí kò ṣe bí ìwọ bá ronúpìwàdà.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.5",
                "verseOrgIds": [
                  "REV.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.5",
            "verseOrgIds": [
              "REV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n èyí ni ìwọ ní, pé ìwọ kórìíra ìṣe àwọn Nikolatani, èyí tí èmi pẹ̀lú sì kórìíra.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.6",
                "verseOrgIds": [
                  "REV.2.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá ní etí kí ó gbọ́ ohun tí Ẹ̀mí ń sọ fún àwọn ìjọ. Ẹni tí ó bá ṣẹ́gun ni èmi yóò fi èso igi ìyè nì fún jẹ, tí ń bẹ láàrín Paradise Ọlọ́run.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.7",
                "verseOrgIds": [
                  "REV.2.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sí Ìjọ ní Smirna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àti sí angẹli ìjọ ní Smirna kọ̀wé.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.8",
                "verseOrgIds": [
                  "REV.2.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ni ẹni tí í ṣe ẹni ìṣáájú àti ẹni ìkẹyìn wí, ẹni tí ó ti kú, tí ó sì tún yè.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.8",
                "verseOrgIds": [
                  "REV.2.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi mọ iṣẹ́ rẹ, àti ìpọ́njú, àti àìní rẹ—ṣùgbọ́n ọlọ́rọ̀ ni ọ́, èmi sì mọ ọ̀rọ̀-òdì tí àwọn tí ń wí pé, Júù ni àwọn tìkára wọn, tí wọn kì sì í ṣe bẹ́ẹ̀, ṣùgbọ́n tí wọ́n jẹ́ Sinagọgu ti Satani.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.9",
                "verseOrgIds": [
                  "REV.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Má ṣe bẹ̀rù ohunkóhun tí ìwọ ń bọ wá jìyà rẹ̀. Kíyèsi i, èṣù yóò gbé nínú yín jù sínú túbú, kí a lè dán yin wò; ẹ̀yin ó sì ní ìpọ́njú ní ọjọ́ mẹ́wàá, ìwọ ṣa ṣe olóòtítọ́ dé ojú ikú, èmi ó sì fi adé ìyè fún ọ.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.10",
                "verseOrgIds": [
                  "REV.2.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá ní etí kí ó gbọ́ ohun tí Ẹ̀mí ń sọ fún àwọn ìjọ. Ẹni tí ó bá ṣẹ́gun kì yóò fi ara pa nínú ikú kejì.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.11",
                "verseOrgIds": [
                  "REV.2.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sí ìjọ ní Pargamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àti sì angẹli ìjọ ni Pargamu kọ̀wé.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.12",
                "verseOrgIds": [
                  "REV.2.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "REV 2:12"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ̀rọ̀ wọ̀nyí ni ẹni tí ó ní idà mímú olójú méjì.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.12",
                "verseOrgIds": [
                  "REV.2.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmí mọ̀ ibi tí ìwọ ń gbé, àní ibi tí ìtẹ́ Satani wà. Síbẹ̀ ìwọ di orúkọ mi mú ṣinṣin. Ìwọ kò sì sẹ́ ìgbàgbọ́ nínú mi, pàápàá jùlọ ni ọjọ́ Antipa ẹlẹ́rìí mi, olóòtítọ́ ènìyàn, ẹni tí wọn pa láàrín yín, níbi tí Satani ń gbé.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.13",
                "verseOrgIds": [
                  "REV.2.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n mo ni nǹkan díẹ̀ wí sí ọ; nítorí tí ìwọ ní àwọn kan tí ó di ẹ̀kọ́ Balaamu mú síbẹ̀, ẹni tí ó kọ́ Balaki láti mú ohun ìkọ̀sẹ̀ wá síwájú àwọn ọmọ Israẹli, láti máa jẹ ohun tí a pa rú ẹbọ sí òrìṣà, àti láti máa ṣe àgbèrè.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.14",
                "verseOrgIds": [
                  "REV.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bẹ́ẹ̀ ni ìwọ sì ní àwọn tí ó gbá ẹ̀kọ́ àwọn Nikolatani pẹ̀lú, ohun tí mo kórìíra.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.15",
                "verseOrgIds": [
                  "REV.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí náà, ronúpìwàdà; bí kò ṣe bẹ́ẹ̀, èmi ó tọ̀ ọ́ wá nísinsin yìí, èmí o sì fi idà ẹnu mi bá wọn jà.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.16",
                "verseOrgIds": [
                  "REV.2.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá létí, kí ó gbọ́ ohun tí Ẹ̀mí ń sọ fún àwọn ìjọ. Ẹni tí o bá ṣẹ́gun ni èmi o fi manna tí ó pamọ́ fún, èmi ó sì fún un ni òkúta funfun kan, àti sára òkúta náà ni a kọ orúkọ tuntun kan, tí ẹnìkan kò mọ̀ bí kò ṣe ẹni tí ó gbà á.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.17",
                "verseOrgIds": [
                  "REV.2.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sí ìjọ ni Tiatira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
