        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá sì ṣẹ́gun, àti tí ó sì ṣe ìfẹ́ mi títí dé òpin, èmi ó fún un láṣẹ lórí àwọn orílẹ̀-èdè:",
              "type": "text",
