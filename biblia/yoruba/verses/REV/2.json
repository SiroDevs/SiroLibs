          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ṣùgbọ́n èyí tí ẹ̀yin ní, ẹ di mú ṣinṣin títí èmi ó fi dé.",
              "type": "text",
              "attrs": {
                "verseId": "REV.2.25",
                "verseOrgIds": [
                  "REV.2.25"
                ]
              }
            }
