  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "AMO 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agbọ̀n èso pípọ́n",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.1",
                "verseOrgIds": [
                  "AMO.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè fihàn mi: agbọ̀n èso pípọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó béèrè pé, \"Amosi kí ni ìwọ rí.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Mo sì dáhùn pé, \"Agbọ̀n èso pípọ́n.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 8:2"
      },
      "items": [
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.2",
                "verseOrgIds": [
                  "AMO.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "wí fún mi pé, \"Àsìkò náà pọ́n tó fún àwọn ènìyàn mi Israẹli; Èmi kì yóò dá wọn sí mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.3",
                "verseOrgIds": [
                  "AMO.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí pé, \"Ní ọjọ́ náà, àwọn orin tẹmpili yóò yí padà sí ohùn réré ẹkún. Ọ̀pọ̀, àní ọ̀pọ̀ ara òkú ni yóò wà ni ibi gbogbo! Àní ni ìdákẹ́ jẹ́ẹ́!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ gbọ́ èyí, ẹ̀yin tí ń tẹ aláìní lórí ba,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:4"
      },
      "items": [
        {
          "text": "tí ẹ sì ń sọ tálákà di ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ẹ ń wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "\"Nígbà wo ni oṣù tuntun yóò parí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kí àwa bá à lè ta ọkà",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kí ọjọ́ ìsinmi kí ó lè dópin",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kí àwa bá à le ta jéró?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "Kí a sì dín ìwọ̀n wa kù",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kí a gbéraga lórí iye tí a ó tà á",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:5"
      },
      "items": [
        {
          "text": "kí a sì fi òsùwọ̀n èké yàn wọ́n jẹ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí àwa lè fi fàdákà ra àwọn tálákà,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "kí a sì fi bàtà ẹsẹ̀ méjèèjì ra aláìní,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:6"
      },
      "items": [
        {
          "text": "kí a sì ta jéró tí a kó mọ́ ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.7",
                "verseOrgIds": [
                  "AMO.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti fi ìgbéraga Jakọbu búra pé, \"Èmi kì yóò gbàgbé ọ̀kan nínú ohun tí wọ́n ṣe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.7",
            "verseOrgIds": [
              "AMO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ǹjẹ́ ilẹ̀ náà kì yóò ha wárìrì fún èyí?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "Àwọn tí ń gbé inú rẹ̀ kì yóò ha ṣọ̀fọ̀?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "Gbogbo ilẹ̀ yóò ru sókè bí omi Naili,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "yóò sì ru ú sókè pátápátá bí ìkún omi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:8"
      },
      "items": [
        {
          "text": "a ó sì tì í jáde, a ó sì tẹ̀ ẹ́ rì gẹ́gẹ́ bí odò Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yóò sì ṣe ní ọjọ́ náà,\" ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.8.9",
                "verseOrgIds": [
                  "AMO.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "\"Èmi yóò mú oòrùn wọ̀ ní ọ̀sán,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:9"
      },
      "items": [
        {
          "text": "Èmi yóò mú kí ayé ṣókùnkùn ní ọ̀sán gangan.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmí yóò yí àsè ẹ̀sìn yín padà sí ọ̀fọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "gbogbo orin yín ni èmi yóò sọ di ẹkún.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Èmi yóò mú kí gbogbo yín wọ aṣọ ọ̀fọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "kí a sì fá orí yín.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "Èmi yóò mú kí ìgbà náà rí bí ìṣọ̀fọ̀ fún ọmọkùnrin",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 8:10"
      },
      "items": [
        {
          "text": "kan ṣoṣo tí a bí àti òpin rẹ̀ bí ọjọ́ kíkorò.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
