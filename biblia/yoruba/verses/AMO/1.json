        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọ̀rọ̀ Amosi, ọ̀kan lára àwọn olùṣọ́-àgùntàn Tekoa; ohun tí o rí nípa Israẹli ní ọdún méjì ṣáájú ilẹ̀-rírì, nígbà tí Ussiah ọba Juda àti Jeroboamu ọmọ Jehoaṣi jẹ́ ọba ní ilẹ̀ Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
