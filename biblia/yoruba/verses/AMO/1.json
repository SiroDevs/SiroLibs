    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "\"Nítorí ẹ̀ṣẹ̀ mẹ́ta Gasa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "àní nítorí mẹ́rin,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Èmi kò ní yí ìpinnu ìjìyà mi padà.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Gẹ́gẹ́ bí í oníṣòwò ẹrú,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "ó kó gbogbo àwọn ènìyàn mi ní ìgbèkùn.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Ó sì tà wọ́n fún Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán iná sí ara odi Gasa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:7"
      },
      "items": [
        {
          "text": "tí yóò jó gbogbo ààfin rẹ̀ run.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ké àwọn olùgbé Aṣdodu kúrò,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "ti ẹni tí ó di ọ̀pá aládé ní Aṣkeloni mú.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "Èmi yóò yí ọwọ́ mi sí Ekroni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "títí tí ìyókù Filistini yóò fi ṣègbé,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.8",
                "verseOrgIds": [
                  "AMO.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
