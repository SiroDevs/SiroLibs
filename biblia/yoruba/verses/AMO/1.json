            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
