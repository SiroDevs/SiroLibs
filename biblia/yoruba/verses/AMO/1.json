      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.2",
                "verseOrgIds": [
                  "AMO.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò bú jáde láti Sioni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "ohùn rẹ̀ yóò sì sán bí àrá láti Jerusalẹmu wá;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "ibùgbé àwọn olùṣọ́-àgùntàn yóò sì ṣọ̀fọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "orí òkè Karmeli yóò sì rọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìdájọ́ àwọn aládùúgbò Israẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.3",
                "verseOrgIds": [
                  "AMO.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "wí:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "\"Nítorí ẹ̀ṣẹ̀ mẹ́ta tí Damasku,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "àní fún mẹ́rin, Èmi kò ní yí ìpinnu ìjìyà mi padà.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Nítorí wọn fi ohun èlò ìpakà pa Gileadi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Pẹ̀lú ohun èlò irin tí ó ní eyín mímú,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò rán iná sí ilé Hasaeli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:4"
      },
      "items": [
        {
          "text": "èyí ti yóò jó àwọn ààfin Beni-Hadadi run.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò ṣẹ́ ọ̀pá ìdábùú Damasku;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Èmi yóò sì pa ọba tí ó wà ní àfonífojì Afeni run",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "àti ẹni tí ó di ọ̀pá aládé mú ní Beti-Edeni.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Àwọn ará a Aramu yóò lọ sí ìgbèkùn sí Kiri,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "AMO.1.5",
                "verseOrgIds": [
                  "AMO.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
