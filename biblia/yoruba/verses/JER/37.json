  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JER 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremiah nínú túbú",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiah ọmọ Josiah sì jẹ ọba ní ipò Jehoiakini ọmọ Jehoiakimu ẹni tí Nebukadnessari ọba Babeli fi jẹ ọba ní ilẹ̀ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àti òun àti àwọn ìránṣẹ́ rẹ̀ àti àwọn ènìyàn ilẹ̀ náà kò fetísí ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.2",
                "verseOrgIds": [
                  "JER.37.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó sọ nípa wòlíì Jeremiah.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiah ọba sì rán Jehukali ọmọ Ṣelemiah àti Sefaniah ọmọ Maaseiah sí Jeremiah wòlíì wí pé, \"Jọ̀wọ́ gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.3",
                "verseOrgIds": [
                  "JER.37.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run wa fún wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà yìí Jeremiah sì ń wọlé, ó sì ń jáde láàrín àwọn ènìyàn nítorí wọ́n ti fi sínú túbú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.4",
            "verseOrgIds": [
              "JER.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ-ogun Farao ti jáde kúrò nílẹ̀ Ejibiti àti nígbà tí àwọn ará Babeli tó ń ṣàtìpó ní Jerusalẹmu gbọ́ ìròyìn nípa wọn, wọ́n kúrò ní Jerusalẹmu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.5",
            "verseOrgIds": [
              "JER.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.6",
                "verseOrgIds": [
                  "JER.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ Jeremiah wòlíì Ọlọ́run wá:",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.6",
            "verseOrgIds": [
              "JER.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni, ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.7",
                "verseOrgIds": [
                  "JER.37.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọlọ́run àwọn Israẹli sọ fún ọba àwọn Juda tó rán ọ láti wádìí nípa mi. 'Àwọn ọmọ-ogun Farao tó jáde láti kún ọ lọ́wọ́ yóò padà sílẹ̀ wọn sí Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.7",
            "verseOrgIds": [
              "JER.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni àwọn ará Babeli yóò padà láti gbógun ti ìlú. Wọn yóò mú wọn nígbèkùn, wọn yóò sì fi iná jó ìlú náà kanlẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.8",
            "verseOrgIds": [
              "JER.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.9",
                "verseOrgIds": [
                  "JER.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wí, ẹ má ṣe tan ara yín jẹ ní èrò wí pé, 'Àwọn ará Babeli yóò fi wá sílẹ̀ pẹ̀lú ìdánilójú.' Wọn kò ní ṣe bẹ́ẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.9",
            "verseOrgIds": [
              "JER.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kódà tó bá ṣe pé wọn yóò ṣẹ́gun àwọn ọmọ-ogun Babeli tí ń gbóguntì yín àti àwọn tí ìjàǹbá ṣe, tí wọ́n ti fi sílẹ̀ ní ibùdó wọn; wọn yóò jáde láti jó ìlú náà kanlẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.10",
            "verseOrgIds": [
              "JER.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn tí àwọn ọmọ-ogun Babeli ti kúrò ní Jerusalẹmu nítorí àwọn ọmọ-ogun Farao.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremiah múra láti fi ìlú náà sílẹ̀, láti lọ sí olú ìlú Benjamini láti gba ẹ̀tọ́ rẹ̀ nínú ohun ìní láàrín àwọn ènìyàn tó wà níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.12",
            "verseOrgIds": [
              "JER.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí wọ́n dé ẹnu ibodè Benjamini, olórí àwọn olùṣọ́ tí orúkọ rẹ ń jẹ́ Irijah ọmọ Ṣelemiah ọmọ Hananiah mú un, ó wí pé, \"Ìwọ ń fi ara mọ́ àwọn ará Babeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.13",
            "verseOrgIds": [
              "JER.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremiah sọ wí pé, \"Èyí kì í ṣe òtítọ́! Èmi kò yapa sí àwọn ará Babeli.\" Ṣùgbọ́n Irijah ko gbọ́ tirẹ̀, dípò èyí a mú Jeremiah, ó sì mú un lọ sí ọ̀dọ̀ àwọn ìjòyè.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.14",
            "verseOrgIds": [
              "JER.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni àwọn ìjòyè ṣe bínú sí Jeremiah, wọ́n jẹ ẹ́ ní yà, wọ́n tún fi sí túbú nílé Jonatani akọ̀wé nítorí wọ́n ti fi èyí ṣe ilé túbú.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.15",
            "verseOrgIds": [
              "JER.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n fi Jeremiah sínú túbú tí ó ṣókùnkùn biribiri; níbi tí ó wà fún ìgbà pípẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọba Sedekiah ránṣẹ́ sí i, tí ó sì pàṣẹ pé kí wọ́n mú wá sí ààfin níbi tí ó ti bi í ní ìkọ̀kọ̀ pé, \"Ǹjẹ́ ọ̀rọ̀ kan wà láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "JER.37.17",
                "verseOrgIds": [
                  "JER.37.17"
                ]
              }
            }
          ]
        },
        {
          "text": "?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 37:17"
      },
      "items": [
        {
          "text": "Jeremiah fèsì pé, \"Bẹ́ẹ̀ ni, wọn ó fi ọ́ lé ọwọ́ ọba Babeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.17",
            "verseOrgIds": [
              "JER.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, Jeremiah sọ fún ọba Sedekiah pé, \"Irú ẹ̀ṣẹ̀ wo ni mo ṣẹ̀ yín, àwọn ìjòyè yín pẹ̀lú àwọn ènìyàn tí ẹ fi sọ mí sínú túbú?",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.18",
            "verseOrgIds": [
              "JER.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Níbo ni àwọn wòlíì yín tí wọ́n ń sọ àsọtẹ́lẹ̀ fún un yín wí pé ọba Babeli kò ní gbóguntì yín wá?",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.19",
            "verseOrgIds": [
              "JER.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ní báyìí, olúwa mi ọba, èmí bẹ̀ ọ. Jẹ́ kí n mú ẹ̀dùn ọkàn mi tọ̀ ọ́ wá; má ṣe rán mi padà sí ilé Jonatani akọ̀wé, àfi kí n kú síbẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.20",
            "verseOrgIds": [
              "JER.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
