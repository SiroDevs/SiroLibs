  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ZEC 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aṣọ mímọ́ fún olórí àlùfáà",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì fi Joṣua olórí àlùfáà hàn mí, ó dúró níwájú angẹli",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.1",
                "verseOrgIds": [
                  "ZEC.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Satani sí dúró lọ́wọ́ ọ̀tún rẹ̀ láti kọjú ìjà sí i.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "si wí fún Satani pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bá ọ wí ìwọ Satani; àní",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.2",
                "verseOrgIds": [
                  "ZEC.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó ti yan Jerusalẹmu, bá ọ wí, igi iná kọ́ ni èyí tí a mú kúrò nínú iná?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sì wọ Joṣua ni aṣọ èérí, ó sì dúró níwájú angẹli náà.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì dáhùn ó wí fún àwọn tí ó dúró níwájú rẹ̀ pé, \"Bọ́ aṣọ èérí nì kúrò ní ara rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 3:4"
      },
      "items": [
        {
          "text": "Ó sì wí fún Joṣua pé, \"Wò ó, mo mú kí àìṣedéédéé rẹ̀ kúrò lọ́dọ̀ rẹ̀, èmi yóò sì wọ̀ ọ́ ní aṣọ ẹ̀yẹ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.4",
            "verseOrgIds": [
              "ZEC.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mó sì wí pé, \"Jẹ kí wọn fi gèlè mímọ́ wé e lórí.\" Wọn sì fi gèlè mímọ́ wé e lórí, wọn sì fi aṣọ wọ̀ ọ́. Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.5",
                "verseOrgIds": [
                  "ZEC.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "sì dúró tì í.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.6",
                "verseOrgIds": [
                  "ZEC.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tẹnumọ́ ọn fún Joṣua pé:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.7",
                "verseOrgIds": [
                  "ZEC.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí: 'Bí ìwọ ọ́ bá rìn ní ọ̀nà mi, bí ìwọ yóò bá sì pa àṣẹ mi mọ́, ìwọ yóò sì ṣe ìdájọ́ ilé mi pẹ̀lú, ìwọ yóò sì ṣe àkóso ààfin mi, èmi yóò fún ọ ní ààyè láti rìn láàrín àwọn tí ó dúró yìí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "text": "'Gbọ́, ìwọ Joṣua olórí àlùfáà, ìwọ, àti àwọn ẹgbẹ́ rẹ tí ó jókòó níwájú rẹ: nítorí ẹni ìyanu ni wọ́n: nítorí kíyèsi i, èmi yóò mú ẹ̀ka náà wá fun ìránṣẹ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí kíyèsi i, òkúta tí mo tí gbé kalẹ̀ níwájú Joṣua; lórí òkúta kan ni ojú méje wà: kíyèsi i, èmi yóò fín àkọlé rẹ̀,' ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.9",
                "verseOrgIds": [
                  "ZEC.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Èmi yóò sì mú ẹ̀bi ilẹ̀ náà kúrò ní ọjọ́ kan.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.3.10",
                "verseOrgIds": [
                  "ZEC.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé, ní ọjọ́ náà ni olúkúlùkù yóò pe ẹnìkejì láti jókòó rẹ̀ sábẹ́ igi àjàrà àti sábẹ́ igi ọ̀pọ̀tọ́.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
      ]
    }
  ],
