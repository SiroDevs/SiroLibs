  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ZEC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Òdodo àti àánú, kì í ṣe àwẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ní ọdún kẹrin Dariusi ọba, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.1",
                "verseOrgIds": [
                  "ZEC.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ́ Sekariah wá ni ọjọ́ kẹrin oṣù Kisleu tí ń ṣe oṣù kẹsànán.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n ènìyàn Beteli rán Ṣareseri àti Regemmeleki, àti àwọn ènìyàn wọn sí ilé Ọlọ́run láti wá ojúrere",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.2",
                "verseOrgIds": [
                  "ZEC.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti láti bá àwọn àlùfáà tí ó wà ní ilé",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.3",
                "verseOrgIds": [
                  "ZEC.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, àti àwọn wòlíì sọ̀rọ̀ wí pé, \"Ṣé kí èmi ó sọkún ní oṣù karùn-ún kí èmi ya ara mi sọ́tọ̀, bí mo ti ń ṣe láti ọdún mélòó wọ̀nyí wá bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.4",
                "verseOrgIds": [
                  "ZEC.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun tọ̀ mí wá pé,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Sọ fún gbogbo àwọn ènìyàn ilẹ̀ náà, àti fún àwọn àlùfáà pé, 'Nígbà tí ẹ̀yin gbààwẹ̀, tí ẹ sì ṣọ̀fọ̀ ní oṣù karùn-ún àti keje, àní fun àádọ́rin ọdún wọ̀nyí, ǹjẹ́ èmi ni ẹ̀yin ha ń gbààwẹ̀ yín fún?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.5",
            "verseOrgIds": [
              "ZEC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ẹ sì jẹ, àti nígbà tí ẹ mu, fún ara yín kọ́ ni ẹ̀yin jẹ, àti fún ara yín kọ́ ni ẹ̀yin mú bí?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ̀nyí kọ́ ni ọ̀rọ̀ ti",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.7",
                "verseOrgIds": [
                  "ZEC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ti kígbe láti ọ̀dọ̀ àwọn wòlíì ìṣáájú wá, nígbà tí a ń gbé Jerusalẹmu, tí ó sì wà ní àlàáfíà, pẹ̀lú àwọn ìlú rẹ̀ tí ó yí i káàkiri, nígbà tí a ń gbé gúúsù àti pẹ̀tẹ́lẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.8",
                "verseOrgIds": [
                  "ZEC.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tọ Sekariah wá, wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.8",
            "verseOrgIds": [
              "ZEC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.9",
                "verseOrgIds": [
                  "ZEC.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí pé, 'Ṣe ìdájọ́ òtítọ́, kí ẹ sì ṣe àánú àti ìyọ́nú olúkúlùkù sí arákùnrin rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má sì ṣe ni opó lára tàbí aláìní baba, àlejò, tàbí tálákà; kí ẹnikẹ́ni nínú yín má ṣe gbèrò ibi ní ọkàn sí arákùnrin rẹ̀.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.10",
            "verseOrgIds": [
              "ZEC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ṣùgbọ́n wọ́n kọ̀ láti gbọ́, wọ́n sì gún èjìká, wọ́n sì pa ẹ̀yìn dà, wọ́n di etí wọn, kí wọn má ba à gbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sé ọkàn wọn bí òkúta líle, kí wọn má ba à gbọ́ òfin, àti ọ̀rọ̀ tí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.12",
                "verseOrgIds": [
                  "ZEC.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun ti fi ẹ̀mí rẹ̀ rán nípa ọwọ́ àwọn wòlíì ìṣáájú wá. Ìbínú ńlá sì dé láti ọ̀dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.12",
                "verseOrgIds": [
                  "ZEC.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ó sì ṣe, gẹ́gẹ́ bí ó ti kígbe, tí wọn kò sì fẹ́ gbọ́, bẹ́ẹ̀ ni wọ́n kígbe, tí èmi kò sì fẹ́ gbọ́,' ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.7.13",
                "verseOrgIds": [
                  "ZEC.7.13"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.13",
            "verseOrgIds": [
              "ZEC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Mo sì fi ìjì tú wọn ká sí gbogbo orílẹ̀-èdè tí wọn kò mọ̀. Ilẹ̀ náà sì dahoro lẹ́yìn wọn, tí ẹnikẹ́ni kò là á kọjá tàbí kí ó padà bọ̀, wọ́n sì sọ ilẹ̀ ààyò náà dahoro.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.14",
            "verseOrgIds": [
              "ZEC.7.14"
            ]
          }
        }
      ]
    }
  ],
