  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ZEC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpè láti padà sí ọ̀dọ̀ Ọlọ́run",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní oṣù kẹjọ ọdún kejì ọba Dariusi, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.1",
                "verseOrgIds": [
                  "ZEC.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ wòlíì Sekariah ọmọ Berekiah, ọmọ Iddo pé:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.2",
                "verseOrgIds": [
                  "ZEC.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ti bínú sí àwọn baba ńlá yín.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà sọ fún àwọn ènìyàn. Èyí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí: 'Ẹ padà sí ọ̀dọ̀ mi,' báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'èmi náà yóò sì padà sí ọ̀dọ̀ yín,' ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má dàbí àwọn baba yín, àwọn tí àwọn wòlíì ìṣáájú ti ké sí wí pé, báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.4",
                "verseOrgIds": [
                  "ZEC.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Ẹ yípadà nísinsin yìí kúrò ní ọ̀nà búburú yín,' àti kúrò nínú ìwà búburú yín; ṣùgbọ́n wọn kò gbọ́, bẹ́ẹ̀ ni wọn kò fetí sí ti èmi, ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.4",
                "verseOrgIds": [
                  "ZEC.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "wí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn baba yín, níbo ni wọ́n wà? Àti àwọn wòlíì, wọ́n ha wà títí ayé?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ọ̀rọ̀ mi àti ìlànà mi, ti mo pa ní àṣẹ fún àwọn ìránṣẹ́ mi wòlíì, kò ha tún bá àwọn baba yín?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:6"
      },
      "items": [
        {
          "text": "\"Wọ́n sì padà wọ́n wí pé, 'Gẹ́gẹ́ bí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.6",
                "verseOrgIds": [
                  "ZEC.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun ti rò láti ṣe sí wa, gẹ́gẹ́ bi ọ̀nà wa, àti gẹ́gẹ́ bí ìṣe wa, bẹ́ẹ̀ ní o ti ṣe sí wa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ènìyàn láàrín àwọn igi miritili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kẹrìnlélógún oṣù kọkànlá, tí ó jẹ́, oṣù Sebati, ní ọdún kejì Dariusi, ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.7",
                "verseOrgIds": [
                  "ZEC.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ wòlíì Sekariah, ọmọ Berekiah ọmọ Iddo wá, pé.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo rí ìran kan ni òru, si wò ó, ọkùnrin kan ń gun ẹṣin pupa kan, òun sì dúró láàrín àwọn igi maritili tí ó wà ní ibi òòji; lẹ́yìn rẹ̀ sì ni ẹṣin pupa, adíkálà, àti funfun gbé wà.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo wí pé, \"Kí ni wọ̀nyí olúwa mi?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:9"
      },
      "items": [
        {
          "text": "Angẹli tí ń ba mi sọ̀rọ̀ sì wí fún mi pé, \"Èmi ó fi ohun tí àwọn wọ̀nyí jẹ́ hàn ọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin tí ó dúró láàrín àwọn igi maritili sì dáhùn ó sì wí pé, \"Wọ̀nyí ní àwọn tí",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.10",
                "verseOrgIds": [
                  "ZEC.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ti rán láti máa rìn sókè sódò ni ayé.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n si dá angẹli",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.11",
                "verseOrgIds": [
                  "ZEC.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "tí ó dúró láàrín àwọn igi maritili náà lóhùn pé, \"Àwa ti rìn sókè sódò já ayé, àwa sí ti rí i pé gbogbo ayé wà ní ìsinmi àti àlàáfíà.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni angẹli",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "náà dáhùn ó sì wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, yóò ti pẹ́ tó tí ìwọ kì yóò fi ṣàánú fún Jerusalẹmu, àti fún àwọn ìlú ńlá Juda, ti ìwọ ti bínú sí ni àádọ́rin ọdún wọ̀nyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.13",
                "verseOrgIds": [
                  "ZEC.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi ọ̀rọ̀ rere àti ọ̀rọ̀ ìtùnú dá angẹli tí ń bá mi sọ̀rọ̀ lóhùn.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Angẹli ti ń bá mi sọ̀rọ̀ sì wí fún mi pé, \"Ìwọ kígbe wí pé, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.14",
                "verseOrgIds": [
                  "ZEC.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'Èmi ń fi ìjowú ńlá jowú fún Jerusalẹmu àti fún Sioni.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi sì bínú púpọ̀púpọ̀ si àwọn orílẹ̀-èdè tí ó rò wí pé òun ní ààbò. Nítorí nígbà tí mo bínú díẹ̀, wọ́n ran ìparun lọ́wọ́ láti tẹ̀síwájú.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nítorí náà, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "wí: 'Mo padà tọ Jerusalẹmu wá pẹ̀lú àánú; ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, a ó kọ́ ilé mi sínú rẹ̀, a o sí ta okùn ìwọ̀n kan jáde sórí Jerusalẹmu.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Máa ké síbẹ̀ pé, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun wí, 'A o máa fi ìre kún ìlú ńlá mi síbẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "yóò sì máa tu Sioni nínú síbẹ̀, yóò sì yan Jerusalẹmu síbẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìwo mẹ́rin àti alágbẹ̀dẹ mẹ́rin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo si gbé ojú sókè, mo sì rí, sì kíyèsi i, ìwo mẹ́rin.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.18",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo sì sọ fún angẹli tí ó ń bá mi sọ̀rọ̀ pé, \"Kí ni nǹkan wọ̀nyí?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:19"
      },
      "items": [
        {
          "text": "Ó si dà mí lóhùn pé, \"Àwọn ìwo wọ̀nyí ni ó tí tú Juda, Israẹli, àti Jerusalẹmu ká.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.20",
                "verseOrgIds": [
                  "ZEC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi alágbẹ̀dẹ mẹ́rin kan hàn mí.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo wí pé, \"Kí ni àwọn wọ̀nyí wá ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:21"
      },
      "items": [
        {
          "text": "O sì sọ wí pé, \"Àwọn wọ̀nyí ni ìwo tí ó ti tú Juda ká, tó bẹ́ẹ̀ tí ẹnikẹ́ni kò fi gbé orí rẹ̀ sókè? Ṣùgbọ́n àwọn wọ̀nyí wá láti dẹ́rùbà wọ́n, láti lé ìwo àwọn orílẹ̀-èdè jáde, ti wọ́n gbé ìwo wọn sórí ilẹ̀ Juda láti tú ènìyàn rẹ̀ ká.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    }
  ],
