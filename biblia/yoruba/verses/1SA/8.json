  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "1SA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israẹli béèrè fún ọba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Samuẹli di arúgbó, ó yan àwọn ọmọ rẹ̀ gẹ́gẹ́ bí adájọ́ fún Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.1",
            "verseOrgIds": [
              "1SA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ àkọ́bí rẹ̀ a máa jẹ́ Joẹli àti orúkọ èkejì a máa jẹ́ Abijah, wọ́n ṣe ìdájọ́ ní Beerṣeba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.2",
            "verseOrgIds": [
              "1SA.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ọmọ rẹ̀, kò rìn ní ọ̀nà rẹ̀. Wọ́n yípadà sí èrè àìṣòótọ́, wọ́n gba àbẹ̀tẹ́lẹ̀, wọ́n sì ń yí ìdájọ́ po.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.3",
            "verseOrgIds": [
              "1SA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni, gbogbo àwọn àgbàgbà ti Israẹli péjọpọ̀, wọ́n sì wá sọ́dọ̀ Samuẹli ní Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.4",
            "verseOrgIds": [
              "1SA.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n wí fún un pé, \"Ìwọ ti di arúgbó, àwọn ọmọ rẹ kò sì rìn ní ọ̀nà rẹ, nísinsin yìí, yan ọba fún wa kí ó lè máa darí wa gẹ́gẹ́ bí i tí gbogbo orílẹ̀-èdè.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.5",
            "verseOrgIds": [
              "1SA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nígbà tí wọ́n wí pé, \"Fún wa ní ọba tí yóò darí wa,\" èyí kò tẹ́ Samuẹli lọ́rùn, ó sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.6",
                "verseOrgIds": [
                  "1SA.8.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.6",
            "verseOrgIds": [
              "1SA.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.7",
                "verseOrgIds": [
                  "1SA.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": "sì sọ fún Samuẹli pé, \"Gbọ́ ohùn àwọn ènìyàn náà, ní gbogbo èyí tí wọ́n sọ fún ọ; nítorí kì í ṣe ìwọ ni wọ́n kọ̀, ṣùgbọ́n èmi ni wọ́n kọ̀ gẹ́gẹ́ bí ọba lórí wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.7",
            "verseOrgIds": [
              "1SA.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí wọ́n ti ṣe ní ọjọ́ tí mo mú wọn jáde wá láti Ejibiti títí di ọjọ́ òní, wọ́n kọ̀ mí sílẹ̀, wọ́n sì ń sin ọlọ́run mìíràn, bẹ́ẹ̀ ni wọ́n ń ṣe sí ọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.8",
            "verseOrgIds": [
              "1SA.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nísinsin yìí, gbọ́ tiwọn; ṣùgbọ́n kìlọ̀ fún wọn dáradára, kí o sì jẹ́ kí wọ́n mọ irú ohun tí ọba tí yóò jẹ́ lórí wọn yóò ṣe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.9",
            "verseOrgIds": [
              "1SA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sọ gbogbo ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.10",
                "verseOrgIds": [
                  "1SA.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sí àwọn ọmọ ènìyàn tí ó ń béèrè fún ọba lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.10",
            "verseOrgIds": [
              "1SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Èyí ni ohun tí ọba tí yóò jẹ lórí yín yóò ṣe. Yóò kó àwọn ọmọkùnrin yín, yóò sì mú wọn ṣiṣẹ́ pẹ̀lú àwọn kẹ̀kẹ́ ogun rẹ̀ àti fún ẹlẹ́ṣin rẹ, wọn yóò sì máa sáré níwájú kẹ̀kẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.11",
            "verseOrgIds": [
              "1SA.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò yan díẹ̀ láti jẹ́ olórí ẹgbẹẹgbẹ̀rún àti olórí àádọ́ta àti àwọn mìíràn. Yóò yan wọ́n láti máa tulẹ̀ oko rẹ̀ àti láti máa kórè rẹ̀ àti àwọn mìíràn láti máa ṣe ohun èlò ogun àti ohun èlò kẹ̀kẹ́ ogun rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.12",
            "verseOrgIds": [
              "1SA.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò mú àwọn ọmọbìnrin yín láti máa ṣe olùṣe ìkunra olóòórùn dídùn àti láti máa ṣe àsè àti láti máa ṣe àkàrà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.13",
            "verseOrgIds": [
              "1SA.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò mú èyí tí ó dára jù nínú oko yín, àti nínú ọgbà àjàrà yín àti nínú igi olifi yín, yóò sì fi wọ́n fún àwọn ọmọ ọ̀dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.14",
            "verseOrgIds": [
              "1SA.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò mú ìdásímẹ́wàá hóró ọkà yín àti àká èso àjàrà yín, yóò sì fi fún àwọn oníṣẹ́ àti ọmọ ọ̀dọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.15",
            "verseOrgIds": [
              "1SA.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ìránṣẹ́kùnrin àti ìránṣẹ́bìnrin yín àti èyí tí ó dára jù nínú ẹran ọ̀sìn àti àwọn kẹ́tẹ́kẹ́tẹ́ yín ni yóò mú fún ìlò ti ara rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.16",
            "verseOrgIds": [
              "1SA.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò sì mú ìdámẹ́wàá nínú àwọn agbo ẹran yín, yóò sì máa ṣe ẹrú u rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.17",
            "verseOrgIds": [
              "1SA.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ọjọ́ náà bá dé, ẹ̀yin yóò kígbe fún ìrànlọ́wọ́ láti ọ̀dọ̀ ọba tí ẹ̀yin ti yàn.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.18",
                "verseOrgIds": [
                  "1SA.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kò sì ní dá a yín lóhùn ní ọjọ́ náà.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.18",
            "verseOrgIds": [
              "1SA.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwọn ènìyàn náà kọ̀ láti tẹ́tí sí Samuẹli wọ́n wí pé, \"Rárá! A bí ìwọ fẹ́ jẹ́ ọba lórí i wa?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.19",
            "verseOrgIds": [
              "1SA.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà àwa yóò dàbí gbogbo àwọn orílẹ̀-èdè mìíràn, pẹ̀lú ọba láti darí i wa àti láti jáde lọ níwájú wa láti ja ogun wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.20",
            "verseOrgIds": [
              "1SA.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Samuẹli gbọ́ gbogbo ohun tí àwọn ènìyàn sọ, ó tún tún un sọ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.21",
                "verseOrgIds": [
                  "1SA.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.21",
            "verseOrgIds": [
              "1SA.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.8.22",
                "verseOrgIds": [
                  "1SA.8.22"
                ]
              }
            }
          ]
        },
        {
          "text": "dáhùn pé, \"Tẹ́tí sí wọn, kí o sì yan ọba fún wọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.8.22",
            "verseOrgIds": [
              "1SA.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 8:22"
      },
      "items": [
        {
          "text": "Nígbà náà, Samuẹli sọ fún àwọn ọkùnrin Israẹli pé, \"Kí olúkúlùkù padà sí ìlú u rẹ̀.\"",
