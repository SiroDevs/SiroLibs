          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli sọ gbogbo rẹ̀ fún un, kò sì fi ohun kankan pamọ́ fún un. Nígbà náà Eli wí pé, \"Òun ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
