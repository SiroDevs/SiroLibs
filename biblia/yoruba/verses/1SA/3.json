              "type": "text"
            }
          ]
        },
        {
          "text": "pe Samuẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli ọmọkùnrin náà ṣe òjíṣẹ́ níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.1",
                "verseOrgIds": [
                  "1SA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ní abẹ́ Eli. Ní ọjọ́ wọ̀n-ọn-nì ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.1",
                "verseOrgIds": [
                  "1SA.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ṣọ̀wọ́n: kò sì sí ìran púpọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.1",
            "verseOrgIds": [
              "1SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní alẹ́ ọjọ́ kan Eli ẹni tí ojú rẹ̀ ti bẹ̀rẹ̀ sí di aláìlágbára, tí kò sì ríran dáradára, ó dùbúlẹ̀ ní ipò rẹ̀ bi ti àtẹ̀yìnwá.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.2",
            "verseOrgIds": [
              "1SA.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí iná kò tí ì kú Samuẹli dùbúlẹ̀ nínú tẹmpili",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.3",
                "verseOrgIds": [
                  "1SA.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", níbi tí àpótí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.3",
                "verseOrgIds": [
                  "1SA.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "gbé wà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.3",
            "verseOrgIds": [
              "1SA.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.4",
                "verseOrgIds": [
                  "1SA.3.4"
                ]
              }
            }
          ]
        },
        {
          "text": "pe Samuẹli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:4"
      },
      "items": [
        {
          "text": "Samuẹli sì dáhùn, \"Èmi nìyí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.4",
            "verseOrgIds": [
              "1SA.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì sáré lọ sí ọ̀dọ̀ Eli ó sì wí pé, \"Èmi nìyí nítorí pé ìwọ pè mí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:5"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n Eli wí fún un pé, \"Èmi kò pè ọ́; padà lọ dùbúlẹ̀.\" Nítorí náà ó lọ ó sì lọ dùbúlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.5",
            "verseOrgIds": [
              "1SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.6",
                "verseOrgIds": [
                  "1SA.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sì tún pè é, \"Samuẹli!\" Samuẹli tún dìde ó tọ Eli lọ, ó sì wí pé, \"Èmi nìyìí, nítorí tí ìwọ pè mí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:6"
      },
      "items": [
        {
          "text": "\"Ọmọ mi, èmi kò pè ọ́, padà lọ dùbúlẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àkókò yìí Samuẹli kò tí ì mọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.7",
                "verseOrgIds": [
                  "1SA.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": ": bẹ́ẹ̀ ni a kò sì tí ì fi ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.7",
                "verseOrgIds": [
                  "1SA.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "hàn án.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.7",
            "verseOrgIds": [
              "1SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.8",
                "verseOrgIds": [
                  "1SA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "pe Samuẹli ní ìgbà kẹta, Samuẹli sì tún dìde, ó sì lọ sọ́dọ̀ Eli ó sì wí pé, \"Èmi nìyìí; nítorí tí ìwọ pè mí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:8"
      },
      "items": [
        {
          "text": "Nígbà náà ni Eli wá mọ̀ pé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.8",
                "verseOrgIds": [
                  "1SA.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ó ń pe ọmọ náà.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
            "verseOrgIds": [
              "1SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Eli sọ fún Samuẹli, \"Lọ kí o lọ dùbúlẹ̀. Tí o bá sì pè ọ́, sọ wí pé, 'Máa wí,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.9",
                "verseOrgIds": [
                  "1SA.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nítorí tí ìránṣẹ́ rẹ ń gbọ́.' \" Bẹ́ẹ̀ ni Samuẹli lọ, ó sì lọ dùbúlẹ̀ ní ààyè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.9",
            "verseOrgIds": [
              "1SA.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.10",
                "verseOrgIds": [
                  "1SA.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "wá, ó sì dúró níbẹ̀, ó pè é bí ó ṣe pè é ní ìgbà tí ó kọjá, \"Samuẹli! Samuẹli!\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 3:10"
      },
      "items": [
        {
          "text": "Nígbà náà ni Samuẹli dáhùn pé, \"Máa wí nítorí tí ìránṣẹ́ rẹ ń gbọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.10",
            "verseOrgIds": [
              "1SA.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.3.11",
                "verseOrgIds": [
                  "1SA.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sọ fún Samuẹli pé, \"Wò ó, èmi ṣetán láti ṣe ohun kan ní Israẹli tí yóò jẹ́ kí etí gbogbo ènìyàn tí ó gbọ́ ọ já gooro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìgbà náà ni èmi yóò mú ohun gbogbo tí mo ti sọ sí ilé Eli ṣẹ láti ìbẹ̀rẹ̀ dé òpin.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí èmi sọ fún un pé, Èmi yóò ṣe ìdájọ́ fún ilé rẹ̀ títí láé nítorí ìwà ẹ̀ṣẹ̀ wọn tí òun mọ̀ nípa rẹ̀ nítorí àwọn ọmọ rẹ̀ sọ ọ̀rọ̀-òdì, òun kò sì dá wọn lẹ́kun.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, mo búra sí ilé Eli, 'Ìwà ẹ̀ṣẹ̀ ilé Eli ni a kì yóò fi ẹbọ tàbí ọrẹ mú kúrò láéláé.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuẹli dùbúlẹ̀ títí di òwúrọ̀ nígbà náà ó sì ṣí ìlẹ̀kùn ilé",
          "type": "text",
          "attrs": {
