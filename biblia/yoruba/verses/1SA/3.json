      "attrs": {
        "style": "p",
        "vid": "1SA 3:16"
      },
      "items": [
        {
          "text": "Samuẹli sì dáhùn pé, \"Èmi nìyìí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        }
