                "verseOrgIds": [
                  "1SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "; jẹ́ kí ó ṣe ohun tí ó dára ní ojú rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.18",
            "verseOrgIds": [
              "1SA.3.18"
            ]
          }
        }
      ]
    },
