  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1SA 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìbí Samuẹli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin kan wà, láti Ramataimu-Sofimu, láti ìlú olókè Efraimu, ẹni tí orúkọ rẹ̀ ń jẹ́ Elkana, ọmọ Jerohamu, ọmọ Elihu, ọmọ Tohu, ọmọ Sufu, ará Efrata.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ní ìyàwó méjì, orúkọ wọn ni Hana àti Penina: Penina ní ọmọ, ṣùgbọ́n Hana kò ní.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọdọọdún, ọkùnrin yìí máa ń gòkè láti ìlú rẹ̀ láti lọ sìn àti láti ṣe ìrúbọ sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.3",
                "verseOrgIds": [
                  "1SA.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun jùlọ ní Ṣilo, níbi tí àwọn ọmọkùnrin Eli méjèèjì, Hofini àti Finehasi ti jẹ́ àlùfáà",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.3",
                "verseOrgIds": [
                  "1SA.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbàkígbà tí ó bá kan Elkana láti ṣe ìrúbọ, òun yóò bù lára ẹran fún aya rẹ̀ Penina àti fún gbogbo àwọn ọmọ ọkùnrin àti obìnrin.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.4",
            "verseOrgIds": [
              "1SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ó máa ń pín ìlọ́po fun Hana nítorí pé ó fẹ́ràn rẹ̀ àti pé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.5",
                "verseOrgIds": [
                  "1SA.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sé e nínú.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.6",
                "verseOrgIds": [
                  "1SA.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ti sé e nínú, orogún rẹ̀ bẹ̀rẹ̀ sí ní fín níràn láti lè mú kí ó bínú.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eléyìí sì máa ń ṣẹlẹ̀ ní ọdọọdún. Nígbàkígbà tí Hana bá gòkè lọ sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.7",
                "verseOrgIds": [
                  "1SA.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", orogún rẹ̀ a máa fín níràn títí tí yóò fi máa sọkún tí kò sì ní lè jẹun.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elkana ọkọ rẹ̀ yóò sọ fún un pé, \"Hana èéṣe tí ìwọ fi ń sọkún? Èéṣe tí ìwọ kò fi jẹun? Èéṣe tí ìwọ fi ń ba ọkàn jẹ́? Èmi kò ha ju ọmọ mẹ́wàá lọ fún ọ bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.8",
            "verseOrgIds": [
              "1SA.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn ìgbà tí wọ́n ti jẹ, tí wọ́n tún mu tán ní Ṣilo, Hana dìde wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.9",
                "verseOrgIds": [
                  "1SA.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nígbà náà, Eli àlùfáà wà lórí àga ní ẹ̀gbẹ́ ẹnu-ọ̀nà ilé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.9",
                "verseOrgIds": [
                  "1SA.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ní ibi tí ó máa ń jókòó.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ẹ̀dùn ọkàn Hana sọkún gidigidi, ó sì gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.10",
                "verseOrgIds": [
                  "1SA.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì jẹ́ ẹ̀jẹ́ wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.11",
                "verseOrgIds": [
                  "1SA.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "àwọn ọmọ-ogun, jùlọ tí ìwọ bá le bojú wo ìránṣẹ́bìnrin rẹ kí ìwọ sì rántí rẹ̀, tí ìwọ kò sì gbàgbé ìránṣẹ́ rẹ ṣùgbọ́n tí ìwọ yóò fún un ní ọmọkùnrin, nígbà náà èmi yóò sì fi fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.11",
                "verseOrgIds": [
                  "1SA.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ní gbogbo ọjọ́ ayé rẹ̀ a kì yóò sì fi abẹ kàn án ní orí.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ṣe ń gbàdúrà sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.12",
                "verseOrgIds": [
                  "1SA.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Eli sì kíyèsi ẹnu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana ń gbàdúrà láti inú ọkàn rẹ̀, ṣùgbọ́n ètè rẹ̀ ni ó ń mì, a kò gbọ́ ohùn rẹ̀. Eli rò wí pé ó ti mu ọtí yó.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.13",
            "verseOrgIds": [
              "1SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli sì wí fún un pé, \"Yóò ti pẹ́ fún ọ tó tí ìwọ yóò máa yó? Mú ọtí wáìnì rẹ̀ kúrò.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.14",
            "verseOrgIds": [
              "1SA.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana dá a lóhùn pé, \"Bẹ́ẹ̀ kọ́,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.15",
                "verseOrgIds": [
                  "1SA.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "mi, èmi ni obìnrin oníròbìnújẹ́. Èmi kò mu ọtí wáìnì tàbí ọtí líle; èmi ń tú ọkàn mi jáde sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.15",
                "verseOrgIds": [
                  "1SA.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe mú ìránṣẹ́ rẹ gẹ́gẹ́ bí obìnrin búburú. Èmi ti ń gbàdúrà níhìn-ín nínú ìrora ọkàn àti ìbànújẹ́ mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.16",
            "verseOrgIds": [
              "1SA.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli dáhùn pé, \"Máa lọ ní àlàáfíà, kí Ọlọ́run Israẹli fi ohun tí ìwọ ti béèrè ní ọwọ́ rẹ̀ fún ọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.17",
            "verseOrgIds": [
              "1SA.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó wí pé, \"Kí ìránṣẹ́bìnrin rẹ rí oore-ọ̀fẹ́ lójú rẹ.\" Bẹ́ẹ̀ ni obìnrin náà bá tirẹ̀ lọ, ó sì jẹun, kò sì fa ojú ro mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.18",
            "verseOrgIds": [
              "1SA.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dìde ni kùtùkùtù òwúrọ̀, wọn wólẹ̀ sìn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.19",
                "verseOrgIds": [
                  "1SA.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", wọn padà wa sí ilé wọn ni Rama: Elkana si mọ Hana aya rẹ̀:",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.19",
                "verseOrgIds": [
                  "1SA.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "sì rántí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.19",
            "verseOrgIds": [
              "1SA.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe, nígbà tí ọjọ́ rẹ̀ pé, lẹ́yìn ìgbà tí Hana lóyún, ó sì bí ọmọkùnrin kan, ó sì pe orúkọ rẹ̀ ní Samuẹli, pé, \"Nítorí tí mo béèrè rẹ̀ lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.20",
                "verseOrgIds": [
                  "1SA.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
            "verseOrgIds": [
              "1SA.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A ya Samuẹli sí mímọ́ fún",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkùnrin náà Elkana, àti gbogbo àwọn ará ilé rẹ̀, gòkè lọ láti rú ẹbọ ọdún sí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.21",
                "verseOrgIds": [
                  "1SA.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", àti láti sán ẹ̀jẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.21",
            "verseOrgIds": [
              "1SA.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Hana kò gòkè lọ; nítorí tí ó sọ fún ọkọ rẹ̀ pé, \"Ó di ìgbà tí mo bá gba ọmú lẹ́nu ọmọ náà, nígbà náà ni èmi yóò mú un lọ, kí òun lè fi ara hàn níwájú",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.22",
                "verseOrgIds": [
                  "1SA.1.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", kí ó sí máa gbé ibẹ̀ títí láé.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elkana ọkọ rẹ̀ sì wí fún un pé, \"Ṣe èyí tí ó tọ́ lójú rẹ. Dúró títí ìwọ yóò fi gba ọmú lẹ́nu rẹ̀; ṣùgbọ́n kí",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.23",
                "verseOrgIds": [
                  "1SA.1.23"
                ]
              }
            }
          ]
        },
        {
          "text": "sá à mú ọ̀rọ̀ rẹ̀ ṣẹ.\" Bẹ́ẹ̀ ni obìnrin náà sì jókòó, ó sì fi ọmú fún ọmọ rẹ̀ títí ó fi gbà á lẹ́nu rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ó sì gba ọmú lẹ́nu rẹ̀, ó sì mú un gòkè lọ pẹ̀lú ara rẹ̀. Pẹ̀lú ẹgbọrọ màlúù mẹ́ta, àti ìyẹ̀fun efa kan, àti ìgò ọtí wáìnì kan, ó sì mú un wá sí ilé",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.24",
                "verseOrgIds": [
                  "1SA.1.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ní Ṣilo: ọmọ náà sì wà ní ọmọdé.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n pa ẹgbọrọ màlúù, wọ́n sì mú ọmọ náà tọ Eli wá.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana sì wí pé, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.26",
                "verseOrgIds": [
                  "1SA.1.26"
                ]
              }
            }
          ]
        },
        {
          "text": "mi, bí ọkàn rẹ ti wà láààyè,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.26",
                "verseOrgIds": [
                  "1SA.1.26"
                ]
              }
            }
          ]
        },
        {
          "text": "mi, èmi ni obìnrin náà tí ó dúró lẹ́bàá ọ̀dọ̀ rẹ níhìn-ín tí ń tọrọ lọ́dọ̀",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.26",
                "verseOrgIds": [
                  "1SA.1.26"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ yìí ni mo ń tọrọ;",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.27",
                "verseOrgIds": [
                  "1SA.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sì fi ìdáhùn ìbéèrè tí mo béèrè lọ́dọ̀ rẹ̀ fún mi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà pẹ̀lú, èmi fi í fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "; ní gbogbo ọjọ́ ayé rẹ̀: nítorí tí mo ti béèrè rẹ̀ fún",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Wọn si wólẹ̀ sin",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "1SA.1.28",
                "verseOrgIds": [
                  "1SA.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "níbẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        }
      ]
    }
