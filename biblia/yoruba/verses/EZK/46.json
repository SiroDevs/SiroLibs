  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "EZK 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí yìí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.1",
                "verseOrgIds": [
                  "EZK.46.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí, ẹnu-ọ̀nà àgbàlá ti inú tí ó dojúkọ ìhà ìlà-oòrùn ni kí a tì pa fún ọjọ́ mẹ́fà tí a fi ń ṣiṣẹ́, ṣùgbọ́n ní ọjọ́ ìsinmi àti ní ọjọ́ oṣù tuntun ni kí a ṣí i.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.1",
            "verseOrgIds": [
              "EZK.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ-aládé ni kí ó wọlé láti ìta tí ó kángun sí àbáwọlé ẹnu-ọ̀nà, kí ó sì dúró ní ẹnu-ọ̀nà. Àwọn àlùfáà ni yóò rú ọrẹ ẹbọ sísun rẹ̀ àti ọrẹ ìdàpọ̀. Òun ni yóò jọ́sìn ní ìloro ilé ní ẹnu-ọ̀nà, lẹ́yìn náà ni wọn yóò jáde, ṣùgbọ́n wọn kò ni ti ìlẹ̀kùn títí ìrọ̀lẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní àwọn ọjọ́ ìsinmi àti àwọn oṣù tuntun ni kí àwọn ènìyàn ilẹ̀ náà jọ́sìn ní iwájú",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.3",
                "verseOrgIds": [
                  "EZK.46.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ní àbáwọlé ẹnu-ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrẹ ẹbọ sísun tí ọmọ-aládé mú wá fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.4",
                "verseOrgIds": [
                  "EZK.46.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ọjọ́ ìsinmi ní láti jẹ́ ọ̀dọ́ àgbò mẹ́fà àti àgbò kan, gbogbo rẹ̀ gbọdọ̀ jẹ́ aláìlábùkù.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrẹ ẹbọ jíjẹ tí a mú papọ̀ mọ́ àgbò gbọdọ̀ jẹ́ efa kan, ọrẹ ẹbọ jíjẹ tí a mú pẹ̀lú àwọn ọ̀dọ́-àgùntàn ni kí ó pò gẹ́gẹ́ bí ó bá ṣe fẹ́, papọ̀ mọ hínì òróró kan pẹ̀lú efa kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti ni ọjọ́ oṣù tuntun, ẹgbọrọ màlúù kan àìlábàwọ́n, àti ọ̀dọ́-àgùntàn mẹ́fà, àti àgbò kan: wọn o wà láìlábàwọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yóò si pèsè ọrẹ ẹbọ jíjẹ efa fun ẹgbọrọ akọ màlúù, àti efa kan fun àgbò kan, àti fun àwọn ọ̀dọ́-àgùntàn gẹ́gẹ́ bi èyí ti ipá rẹ̀ ká, àti hínì òróró kan fún efa kan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọmọ-aládé bá wọlé, ó gbọdọ̀ gbá àbáwọlé ẹnu-ọ̀nà wọ inú, kí ó sì gba ibẹ̀ jáde.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nígbà tí àwọn ènìyàn ilẹ̀ náà bá wá síwájú",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.9",
                "verseOrgIds": [
                  "EZK.46.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ni àwọn àjọ̀dún tí a yàn, ẹnikẹ́ni tí ó bá gba ti ẹnu-ọ̀nà ìhà àríwá wọlé láti jọ́sìn gbọdọ̀ gba ti ẹnu-ọ̀nà ìhà gúúsù jáde; ẹnikẹ́ni tí ó bá gba ti ẹnu-ọ̀nà ìhà gúúsù wọlé yóò gba tí ẹnu-ọ̀nà ìhà àríwá jáde. Kò sí ẹni tí ó gbọdọ̀ gba ibi tí ó bá wọlé jáde, ṣùgbọ́n kí olúkúlùkù gba òdìkejì ẹnu-ọ̀nà tí ó gbà wọlé jáde.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ-aládé gbọdọ̀ wà ní àárín wọn, kí ó wọlé nígbà tí wọn bá wọlé, kí ó sì jáde nígbà tí wọn bá jáde.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Níbi àwọn àjọ̀dún àti àwọn àjọ̀dún tí a yàn, ọrẹ ẹbọ jíjẹ gbọdọ̀ jẹ́ efa kan fún ẹgbọrọ akọ màlúù kan, efa kan fún àgbò kan, àti fún àwọn ọ̀dọ́-àgùntàn gẹ́gẹ́ bí ó bá ti wu onílúlùkù, pẹ̀lú òróró hínì kan fún efa kan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.11",
            "verseOrgIds": [
              "EZK.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí ọmọ-aládé bá pèsè ọrẹ àtinúwá fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.12",
                "verseOrgIds": [
                  "EZK.46.12"
                ]
              }
            }
          ]
        },
        {
          "text": "yálà ọrẹ ẹbọ sísun tàbí ọrẹ ẹbọ ìdàpọ̀ ojú ọ̀nà tí ó dojúkọ ìhà ìlà-oòrùn ni kí ó wà ni ṣíṣí sílẹ̀ fún un. Òun yóò rú ọrẹ ẹbọ sísun rẹ̀ tàbí ọrẹ ẹbọ ìdàpọ̀ gẹ́gẹ́ bí òun ti ṣe ní ọjọ́ ìsinmi. Lẹ́yìn náà, òun yóò jáde, lẹ́yìn ìgbà tí ó bá jáde tán wọn yóò ti ẹnu-ọ̀nà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.12",
            "verseOrgIds": [
              "EZK.46.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ní ojoojúmọ́ ni ìwọ yóò pèsè ọ̀dọ́-àgùntàn ọlọ́dún kan aláìlábùkù fún ọrẹ ẹbọ sísun sí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.13",
                "verseOrgIds": [
                  "EZK.46.13"
                ]
              }
            }
          ]
        },
        {
          "text": "; àràárọ̀ ni ìwọ yóò máa pèsè rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.13",
            "verseOrgIds": [
              "EZK.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìwọ yóò sì máa pèsè ọrẹ ẹbọ jíjẹ pẹ̀lú rẹ̀ ní àràárọ̀, èyí yóò ni ìdámẹ́fà nínú efa àti ìdámẹ́fà nínú òróró hínì láti fi po ìyẹ̀fun. Gbígbé ọrẹ ẹbọ jíjẹ fún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.14",
                "verseOrgIds": [
                  "EZK.46.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ ìlànà tí ó wà títí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.14",
            "verseOrgIds": [
              "EZK.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ọ̀dọ́-àgùntàn àti ọrẹ ẹbọ jíjẹ àti òróró ni wọn yóò pèsè ní àràárọ̀ fún ọrẹ ẹbọ sísun ìgbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.15",
            "verseOrgIds": [
              "EZK.46.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí yìí ni ohun tí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.46.16",
                "verseOrgIds": [
                  "EZK.46.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè sọ, tí ọmọ-aládé bá mú ọrẹ láti inú ogún ìní rẹ̀ fún ọ̀kan lára àwọn ọmọkùnrin rẹ̀, yóò jẹ́ ìní tiwọn nípa ogún jíjẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.16",
            "verseOrgIds": [
              "EZK.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tí ó bá mú ọrẹ láti inú ogún ìní rẹ̀ fún ọ̀kan lára àwọn ọmọ ọ̀dọ̀, ọmọ le pamọ́ títí di ọdún ìdásílẹ̀, lẹ́yìn náà yóò padà sí ọ̀dọ̀ ọmọ-aládé. Ogún ìní rẹ̀ jẹ́ ti àwọn ọmọ rẹ̀ nìkan; ó jẹ́ tiwọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ-aládé kò gbọdọ̀ mú nǹkan kan lára ogún ìní àwọn ènìyàn, tàbí mú wọn kúrò níbi ohun ìní wọn. Ó ní láti fi ogún ìní rẹ̀ láti inú ìní rẹ̀ fún àwọn ọmọ rẹ̀, kí a ma ba à ya nǹkan kan kúrò lára ìní rẹ̀.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lẹ́yìn náà ọkùnrin náà mú mi kọjá ní àbáwọlé tí ó wà lẹ́bàá ẹnu-ọ̀nà, sí àwọn yàrá mímọ́ tí ó kọjú sí ìhà àríwá, èyí tí ó jẹ́ tí àwọn àlùfáà, ó sì fi ibi kan hàn mí ní apá ìwọ̀-oòrùn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.19",
            "verseOrgIds": [
              "EZK.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sọ fún mi pé, \"Èyí yìí ni ibi tí àwọn àlùfáà yóò ti ṣe ọrẹ ẹbọ ìdálẹ́bi àti ọrẹ ẹbọ ẹ̀ṣẹ̀, àti tí wọn yóò ti ṣe ọrẹ ẹbọ jíjẹ, láti má ṣe jẹ́ kí wọn mú wọn wá sí ìta àgbàlá, kí wọn sì ya àwọn ènìyàn sí mímọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì mú mi lọ sí ìta àgbàlá, ó sì mú mi yí igun mẹ́rẹ̀ẹ̀rin rẹ̀ ká, mo sì ri àgbàlá mìíràn ní igun kọ̀ọ̀kan.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní igun mẹ́rẹ̀ẹ̀rin ìta àgbàlá tí ó pẹnu pọ̀, ogójì ìgbọ̀nwọ́ ni gígùn àti ọgbọ̀n ìgbọ̀nwọ́ ní ìbú; àgbàlá kọ̀ọ̀kan ni igun kọ̀ọ̀kan jẹ́ ìwọ̀n kan náà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní agbègbè inú ọ̀kọ̀ọ̀kan nínú àgbàlá náà ni ọwọ́ ilẹ̀ kan wà yíká wọn, a sì ṣe ibi ìdáná si abẹ́ ọwọ́ náà yípo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì wí fún mi pé, \"Ìwọ̀nyí ni àwọn ilé ìdáná níbi tí ó ń ṣiṣẹ́ ìránṣẹ́ nínú tẹmpili yóò ti ṣe ẹbọ fún àwọn ènìyàn.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.24",
            "verseOrgIds": [
              "EZK.46.24"
            ]
          }
        }
      ]
    }
