      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:12"
      },
      "items": [
        {
          "text": "Wọn yóò tú ìgbéraga Ejibiti ká,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.12",
            "verseOrgIds": [
              "EZK.32.12"
            ]
          }
        }
