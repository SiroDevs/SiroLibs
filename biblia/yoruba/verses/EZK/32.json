      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "kì i ṣe ẹsẹ̀ ènìyàn ní yóò tẹ ibẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "ẹsẹ̀ ẹran ọ̀sìn kì yóò sì mú kí ibẹ̀ ni ẹrọ̀fọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
              "EZK.32.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
