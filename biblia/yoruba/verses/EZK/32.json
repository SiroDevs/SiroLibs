      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:13"
      },
      "items": [
        {
          "text": "ní ẹ̀gbẹ́ ọ̀pọ̀lọpọ̀ omi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.13",
            "verseOrgIds": [
