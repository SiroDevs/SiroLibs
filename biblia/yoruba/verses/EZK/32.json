  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EZK 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpohùnréré ẹkún fún Farao",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kìn-ín-ní, oṣù kejìlá, ọdún kejìlá, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.1",
                "verseOrgIds": [
                  "EZK.32.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, ṣe ìpohùnréré ẹkún nítorí Farao ọba Ejibiti kí o sì wí fún un:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "\" 'Ìwọ dàbí kìnnìún láàrín àwọn orílẹ̀-èdè náà;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ìwọ dàbí ohun ẹ̀mí búburú inú àwọn omi okun",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "to ń lọ káàkiri inú àwọn odò rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ìwọ fi ẹsẹ̀ rẹ tẹ omi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "láti mú kí àwọn odò ní ẹrẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Èyí yìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.3",
                "verseOrgIds": [
                  "EZK.32.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "\" 'Pẹ̀lú ọ̀pọ̀ ìpéjọ ènìyàn",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "èmi yóò da àwọ̀n mi bò ọ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "wọn yóò sì fà ọ́ sókè nínú àwọ̀n mi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò jù ọ́ sí orí ilẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "èmi yóò sì fà ọ́ sókè sí orí pápá gbangba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "Èmi yóò jẹ́ kí gbogbo ẹyẹ ojú ọ̀run ṣe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "àtìpó ní orí rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "Gbogbo àwọn ẹranko ayé yóò fi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "ìwọra gbé ara wọn lórí rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò tan ẹran-ara rẹ ká sórí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "àwọn òkè gíga",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "ìyókù ara rẹ ní wọn yóò fi kún",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "àwọn àárín àwọn òkè gíga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀jẹ̀ rẹ ti ń sàn ní èmi yóò sì fi rin ilẹ̀ náà",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "gbogbo ọ̀nà sí orí àwọn òkè gíga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "àwọn àlàfo jíjìn ní wọn yóò kún fún ẹran-ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí mo bá fọ́n ọ jáde, èmi yóò pa ọ̀run dé",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "àwọn ìràwọ̀ wọn yóò sì ṣókùnkùn;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "èmi yóò sì fi ìkùùkuu bo oòrùn",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "òṣùpá kì yóò sì tan ìmọ́lẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbogbo ìmọ́lẹ̀ títàn ní ojú ọ̀run",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "ni èmi yóò mú ṣókùnkùn lórí rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "èmi yóò mú òkùnkùn wá sórí ilẹ̀ rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.8",
                "verseOrgIds": [
                  "EZK.32.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò da ọkàn ọ̀pọ̀ àwọn ènìyàn rú",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "nígbà tí mo bá mú ìparun rẹ wá",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "ní àárín àwọn orílẹ̀-èdè tí ìwọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "kò í tí ì mọ̀.",
          "type": "text",
          "attrs": {
