      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:14"
      },
      "items": [
        {
          "text": "kí àwọn odò rẹ̀ kí o sàn bí epo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.14",
            "verseOrgIds": [
