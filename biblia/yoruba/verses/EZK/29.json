  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "EZK 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àsọtẹ́lẹ̀ òdì sí Ejibiti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ kejìlá, oṣù kẹwàá, ọdún kẹwàá, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.1",
                "verseOrgIds": [
                  "EZK.29.1"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, kọjú sí Farao ọba Ejibiti kí ó sì sọ àsọtẹ́lẹ̀ sí i àti sí gbogbo Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọ̀rọ̀, kí ó sì wí pé, 'Báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.3",
                "verseOrgIds": [
                  "EZK.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "\" 'Èmi lòdì sí ọ, Farao ọba Ejibiti",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "ìwọ ẹ̀mí búburú ńlá inú òkun tí ó dùbúlẹ̀ sí",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "àárín àwọn odò ṣíṣàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "Èyí tí ó sọ wí pé, \"Tèmi ni odò Naili;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:3"
      },
      "items": [
        {
          "text": "èmi ni ó sì ṣe é fún ara mi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n èmi yóò fi ìwọ̀ mú ẹnu rẹ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "èmi yóò sì mú ẹja inú odò rẹ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "gbogbo lẹ̀ mọ́ ìpẹ́ ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "Èmi yóò fà ọ́ síta kúrò láàrín àwọn odò rẹ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:4"
      },
      "items": [
        {
          "text": "àti gbogbo ẹja odò rẹ yóò lẹ̀ mọ́ ìpẹ́ ara rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.4",
            "verseOrgIds": [
              "EZK.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sọ ọ́ nù sí aginjù",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "ìwọ àti gbogbo ẹja inú odò rẹ:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "ìwọ yóò ṣubú sí gbangba oko",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "a kì yóò sì ṣà ọ́ jọ tàbí gbé ọ sókè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "Èmi ti fi ọ ṣe oúnjẹ fún àwọn ẹranko igbó",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 29:5"
      },
      "items": [
        {
          "text": "àti fún àwọn ẹyẹ ojú ọ̀run láti jẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.5",
            "verseOrgIds": [
              "EZK.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà gbogbo àwọn olùgbé ni Ejibiti yóò mọ pé, Èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.6",
                "verseOrgIds": [
                  "EZK.29.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "EZK 29:6"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:6"
      },
      "items": [
        {
          "text": "\" 'Ìwọ ti jẹ́ ọ̀pá ìyè fún ilé Israẹli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.6",
            "verseOrgIds": [
              "EZK.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọn fi ọwọ́ agbára wọn dì ọ́ mú. Ìwọ fọ́, ìwọ sì ya gbogbo èjìká wọn; nígbà tí wọn fi ara tì ọ́, ìwọ sẹ́, ìwọ sì mú gbogbo ẹ̀gbẹ́ wọn gbọ̀n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.7",
            "verseOrgIds": [
              "EZK.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nítorí náà, èyí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.8",
                "verseOrgIds": [
                  "EZK.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Kíyèsi, Èmi yóò mú idà kan wá sórí rẹ tí yóò sì gé ènìyàn àti ẹran kúrò nínú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.8",
            "verseOrgIds": [
              "EZK.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilẹ̀ Ejibiti yóò di aginjù àti ahoro, nígbà náà ní wọn yóò sì mọ̀ wí pé èmi ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.9",
                "verseOrgIds": [
                  "EZK.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 29:9"
      },
      "items": [
        {
          "text": "\" 'Nítorí tí ìwọ wí pé, \"Tèmi ni odò Naili, Èmi ni mo ṣe é,\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.9",
            "verseOrgIds": [
              "EZK.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí náà, mo lòdì sí ọ àti sí àwọn odò rẹ, èmi yóò sì mú kí ilẹ̀ Ejibiti di píparun àti ahoro, pátápátá, láti Migdoli lọ dé Siene, dé ààlà ilẹ̀ Kuṣi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.10",
            "verseOrgIds": [
              "EZK.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò sí ẹsẹ̀ ènìyàn tàbí tí ẹranko tí yóò gba ibẹ̀ kọjá; ẹni kankan kò ní gbé ibẹ̀ fún ogójì ọdún.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.11",
            "verseOrgIds": [
              "EZK.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sọ ilẹ̀ Ejibiti di ọ̀kan ní àárín àwọn ìlú tí ó di ahoro, fún ogójì ọdún, Èmi yóò sì fọ́n àwọn ara Ejibiti ká sáàárín àwọn orílẹ̀-èdè, èmi yóò sì tú wọn ká sáàárín gbogbo ilẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.12",
            "verseOrgIds": [
              "EZK.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ṣùgbọ́n báyìí ní",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.13",
                "verseOrgIds": [
                  "EZK.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Ní òpin ogójì ọdún, èmi yóò ṣa àwọn ará Ejibiti jọ láti ọ̀dọ̀ àwọn ènìyàn níbi tí a fọ́n wọn ká sí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.13",
            "verseOrgIds": [
              "EZK.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi yóò sì tún mú ìgbèkùn Ejibiti padà bọ̀, èmi yóò sì dá wọn padà sí ilẹ̀ Paturosi, ilẹ̀ àwọn baba ńlá wọn. Wọn yóò wà níbẹ̀ bí ìjọba tí a rẹ̀ sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.14",
            "verseOrgIds": [
              "EZK.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibẹ̀ yóò jẹ́ ìjọba tí ó rẹlẹ̀ jùlọ nínú àwọn ìjọba, kì yóò sì gbé ara rẹ̀ ga mọ́ sórí àwọn orílẹ̀-èdè: nítorí èmi ni ó dín wọn kù, tiwọn kì yóò fi ṣe olórí àwọn orílẹ̀-èdè yòókù mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.15",
            "verseOrgIds": [
              "EZK.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejibiti kí yóò sì jẹ orísun ìgbẹ́kẹ̀lé fún ilé Israẹli mọ́ ṣùgbọ́n, yóò jẹ́ ìrántí fún àìṣedéédéé wọn, nígbà tí yóò bá wò wọ́n fún ìrànlọ́wọ́. Nígbà náà, wọn yóò mọ̀ pé èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.16",
                "verseOrgIds": [
                  "EZK.29.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Èrè Nebukadnessari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó sì ṣe ní ọjọ́ kìn-ín-ní, oṣù kìn-ín-ní, ọdún kẹtàdínlọ́gbọ̀n, ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.17",
                "verseOrgIds": [
                  "EZK.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.17",
            "verseOrgIds": [
              "EZK.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọmọ ènìyàn, Nebukadnessari ọba Babeli mú kí ogun rẹ sin ìrú ńlá fún Tire. Gbogbo orí pá, àti gbogbo èjìká bó, síbẹ̀, òun àti àwọn ogun rẹ̀, kò rí owó ọ̀yà gbà láti Tire fún wa, fún ìrú ti a ti sìn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.18",
            "verseOrgIds": [
              "EZK.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, báyìí ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.19",
                "verseOrgIds": [
                  "EZK.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí: Kíyèsi i, Èmi yóò fi Ejibiti fún Nebukadnessari ọba Babeli, òun yóò sì kó ọrọ̀ rẹ̀ lọ. Òun yóò bo ilé, yóò sì ṣe ìkógun ilẹ̀ náà gẹ́gẹ́ bí owó iṣẹ́ tí a san fún ológun rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.19",
            "verseOrgIds": [
              "EZK.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi ti fi Ejibiti fún un gẹ́gẹ́ bí èrè wàhálà rẹ̀ nítorí òun àti àwọn ológun rẹ ṣe é fún mi, ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.29.20",
                "verseOrgIds": [
                  "EZK.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Olódùmarè wí.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ní ọjọ́ náà, èmi yóò mú kí ìwo Israẹli ru jáde, èmi yóò sì fún ọ ní ẹnu ọ̀rọ̀ ní àárín wọn. Nígbà náà ni wọn yóò mọ̀ pé èmi ni",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        },
        {
