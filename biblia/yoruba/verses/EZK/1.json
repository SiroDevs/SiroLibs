          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ẹ̀dá alààyè àti ògo",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ karùn-ún, oṣù kẹrin tí mo di ọmọ ọgbọ̀n ọdún tí mo wà láàrín àwọn ìgbèkùn ní etí odò Kebari, àwọn ọ̀run ṣí sílẹ̀, mo sì rí ìran Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ọjọ́ karùn-ún oṣù—tí ó jẹ́ ọdún karùn-ún ìgbèkùn ọba Jehoiakini—",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ọ̀rọ̀",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.1.3",
                "verseOrgIds": [
                  "EZK.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ àlùfáà Esekiẹli, ọmọ Busii wá, létí odò Kebari ni ilẹ̀ àwọn ará Babeli. Níbẹ̀ ni ọwọ́",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.1.3",
                "verseOrgIds": [
                  "EZK.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ti wà lára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo wò, mo sì rí ìjì tó ń jà bọ̀ láti ìhà àríwá ìkùùkuu tó nípọn pẹ̀lú mọ̀nàmọ́ná ti n bù yẹ̀rì pẹ̀lú ìmọ́lẹ̀ rokoṣo tó yí i ká. Àárín iná náà rí bí ìgbà tí irin bá ń bẹ nínú iná,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti láàrín iná náà ni ohun tó dàbí ẹ̀dá alààyè mẹ́rin wà. Ìrísí wọn jẹ́ ti ènìyàn,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n ẹnìkọ̀ọ̀kan wọn ní ojú mẹ́rin àti ìyẹ́ apá mẹ́rin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹsẹ̀ wọn sì tọ́; àtẹ́lẹsẹ̀ wọn sì rí bí ti ọmọ màlúù, wọ́n sì tàn bí awọ idẹ dídán.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní abẹ́ ìyẹ́ wọn ní ẹ̀gbẹ́ mẹ́rẹ̀ẹ̀rin wọn ní ọwọ́ ènìyàn. Gbogbo àwọn mẹ́rẹ̀ẹ̀rin ní ojú àti àwọn ìyẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìyẹ́ wọn kan ara wọn. Bẹ́ẹ̀ ní ọ̀kọ̀ọ̀kan wọn kò padà lọ́nà ibi tí ó ń lọ; ṣùgbọ́n wọ́n ń lọ tààrà ni.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni ìrísí ojú àwọn ẹ̀dá alààyè yìí: ọ̀kọ̀ọ̀kan wọn ní ojú ènìyàn, ní apá ọ̀tún wọn, wọ́n ní ojú kìnnìún ní ìhà ọ̀tún, wọ́n ní ojú màlúù ní ìhà òsì, ọ̀kọ̀ọ̀kan wọ́n sì tún ní ojú ẹyẹ idì.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Báyìí ni àpèjúwe ojú wọ́n. Ìyẹ́ wọn gbé sókè; ọ̀kọ̀ọ̀kan wọn ní ìyẹ́ méjì, ìyẹ́ ọ̀kan sì kan ti èkejì ni ẹ̀gbẹ̀ẹ̀gbẹ́, ìyẹ́ méjì tó sì tún bo ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olúkúlùkù wọn ń lọ tààrà. Níbikíbi tí èmi bá ń lọ, ni àwọn náà ń lọ, láì wẹ̀yìn bí wọ́n ti ń lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìrísí àwọn ẹ̀dá alààyè yìí dàbí ẹyin iná tí ń jó tàbí bí i iná fìtílà. Iná tó ń jó ń lọ sókè lọ sódò láàrín àwọn ẹ̀dá alààyè; iná yìí mọ́lẹ̀ rokoṣo, ó sì ń bù yẹ̀rì yẹ̀rì jáde lára rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹ̀dá alààyè yìí sì ń sáré lọ sókè lọ sódò bí i ìtànṣán àrá.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí mo ti ń wo àwọn ẹ̀dá alààyè yìí, mo rí kẹ̀kẹ́ ní ilẹ̀ ni ẹ̀gbẹ́ ọ̀kọ̀ọ̀kan àwọn ẹ̀dá alààyè wọ̀nyí pẹ̀lú ojú rẹ̀ mẹ́rẹ̀ẹ̀rin.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àpèjúwe àti ìrísí àwọn kẹ̀kẹ́ náà nìyìí: kẹ̀kẹ́ mẹ́rẹ̀ẹ̀rin rí bákan náà, wọ́n sì ń tàn yinrin yinrin bí i kirisoleti, ọ̀kọ̀ọ̀kan àwọn kẹ̀kẹ́ yìí rí bí i ìgbà tí a fi kẹ̀kẹ́ bọ kẹ̀kẹ́ nínú.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn kẹ̀kẹ́ yìí ń yí bí wọ́n ti ń yí, wọ́n ń lọ tààrà sí ibi tí ọ̀kọ̀ọ̀kan àwọn ẹ̀dá alààyè kọjú sí, kẹ̀kẹ́ wọn kò sì yapa bí àwọn ẹ̀dá náà ti n lọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ríìmù wọ́n ga, wọ́n sì ba ni lẹ́rù, àwọn ríìmù mẹ́rẹ̀ẹ̀rin sì jẹ́ kìkìdá ojú yíká.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ẹ̀dá bá ń rìn, kẹ̀kẹ́ ẹ̀gbẹ́ wọn náà yóò rìn, bí wọ́n fò sókè, kẹ̀kẹ́ náà yóò fò sókè.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibikíbi tí ẹ̀mí bá ń lọ, kẹ̀kẹ́ wọn yóò sì bá wọn lọ, nítorí pé ẹ̀mí àwọn ẹ̀dá alààyè yìí wà nínú kẹ̀kẹ́ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí àwọn ẹ̀dá yìí bá ń lọ, kẹ̀kẹ́ náà yóò lọ; bí wọ́n bá dúró jẹ́ẹ́ kẹ̀kẹ́ náà yóò dúró jẹ́ẹ́, bẹ́ẹ̀ sì ni bí àwọn ẹ̀dá yìí bá dìde nílẹ̀, àwọn kẹ̀kẹ́ yìí yóò dìde pẹ̀lú wọn, nítorí pé ẹ̀mí ẹ̀dá alààyè wọ̀nyí wà nínú àwọn kẹ̀kẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun tí ó dàbí òfúrufú ràn bo orí àwọn ẹ̀dá alààyè wọ̀nyí, ó ń tàn yinrin yinrin bí i yìnyín, ó sì ba ni lẹ́rù.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìyẹ́ wọn sì tọ́ lábẹ́ òfúrufú, èkínní sí èkejì, ọ̀kọ̀ọ̀kan wọn sì ní ìyẹ́ méjì méjì tí ó bo ara wọn.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí àwọn ẹ̀dá náà gbéra, mo gbọ́ ariwo ìyẹ́ wọn tó bolẹ̀ bí i ríru omi, bí i ohùn Olódùmarè, bí i híhó àwọn jagunjagun. Nígbà tí wọ́n dúró jẹ́ẹ́, wọ́n sì rẹ ìyẹ́ wọn sílẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí wọ́n ṣe dúró tí wọ́n sì rẹ ìyẹ́ wọn sílẹ̀, ohùn kan jáde láti inú òfúrufú tó rán bò wọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lókè àwọ̀ òfúrufú tó borí wọn yìí ni ohun tí ó ní ìrísí ìtẹ́. Ìtẹ́ náà dàbí òkúta safire, lókè ní orí ìtẹ́ ní ohun tó dàbí ènìyàn wà.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Láti ibi ìbàdí ènìyàn náà dé òkè, o dàbí irin tí ń kọ yànrànyànràn. O dàbí pe kìkì iná ni, láti ibi ìbàdí rẹ dé ìsàlẹ̀ dàbí iná tó mọ́lẹ̀ yí i ká.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìmọ́lẹ̀ tó yí i ká yìí dàbí ìrísí òṣùmàrè tó yọ nínú àwọsánmọ̀ ní ọjọ́ òjò, bẹ́ẹ̀ ni ìmọ́lẹ̀ tò yí i ká.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 1:28"
      },
      "items": [
        {
          "text": "Báyìí ni ìrísí ògo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "EZK.1.28",
                "verseOrgIds": [
                  "EZK.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nígbà tí mo rí i, mo dojúbolẹ̀, mo sì gbọ́ ohùn ẹnìkan tó ń sọ̀rọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
      ]
    }
