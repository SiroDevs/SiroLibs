                "verseOrgIds": [
                  "EZK.12.21"
                ]
              }
            }
          ]
        },
        {
          "text": "tọ̀ mí wá pé:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
