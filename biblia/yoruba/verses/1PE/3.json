  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1PE 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àwọn aya àti àwọn ọkọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́, ẹ̀yin aya, ẹ máa tẹríba fún àwọn ọkọ yín; pé, bí ẹnikẹ́ni ba tilẹ̀ ń ṣe àìgbọ́ràn sí ọ̀rọ̀ náà, kí a lè jèrè wọn láì sọ̀rọ̀ nípa ìwà àwọn aya wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí wọ́n bá ń wo ìwà rere pẹ̀lú ẹ̀rù yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọ̀ṣọ́ yín má ṣe jẹ́ ọ̀ṣọ́ òde, tí irun dídì, àti wúrà lílò, tàbí ti aṣọ wíwọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ṣùgbọ́n kí ó jẹ́ ẹni tí ó fi ara sin ní ọkàn, nínú ọ̀ṣọ́ àìdíbàjẹ́ ti ẹ̀mí ìrẹ̀lẹ̀ àti ẹ̀mí tútù, èyí tí i ṣe iyebíye níwájú Ọlọ́run.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí báyìí ni àwọn obìnrin mímọ́ ìgbàanì pẹ̀lú, tí wọ́n gbẹ́kẹ̀lé Ọlọ́run, fi ṣe ara wọn lọ́ṣọ̀ọ́, wọn a máa tẹríba fún àwọn ọkọ wọn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gẹ́gẹ́ bí Sara ti gbọ́ ti Abrahamu, tí ó ń pè é ní olúwa rẹ̀. Ọmọbìnrin ẹni tí ẹ̀yin jẹ́, bí ẹ̀yin bá ń ṣe rere, tí ohunkóhun kò sí dẹ́rùbà yín.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ gẹ́gẹ́ ẹ̀yin ọkọ, ẹ máa fi òye ba àwọn aya yín gbé, ẹ máa fi ọlá fún aya, bi ohun èlò ti kò lágbára, àti pẹ̀lú bí àjùmọ̀jogún oore-ọ̀fẹ́ ìyè; kí àdúrà yín má bà á ní ìdènà.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jíjìyà fún ṣíṣe iṣẹ́ rere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lákòótan, kí gbogbo yín jẹ́ onínú kan, ẹ máa bá ara yín kẹ́dùn, ẹ ní ìfẹ́ ará, ẹ máa ṣe ìyọ́nú, ẹ ni ẹ̀mí ìrẹ̀lẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ má ṣe fi búburú san búburú, tàbí fi èébú san èébú: ṣùgbọ́n kàkà bẹ́ẹ̀, ẹ máa súre; nítorí èyí ni a pè yín sí, kí ẹ̀yin lè jogún ìbùkún.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "\"Ẹni tí yóò bá fẹ́ ìyè,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "ti yóò sì rí ọjọ́ rere,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "kí o pa ahọ́n rẹ̀ mọ́ kúrò nínú ibi,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:10"
      },
      "items": [
        {
          "text": "àti ètè rẹ̀ mọ́ kúrò nínú sísọ ọ̀rọ̀ ẹ̀tàn.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ó yà kúrò nínú ibi, kí ó sì máa ṣe rere;",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:11"
      },
      "items": [
        {
          "text": "kí ó máa wá àlàáfíà, kí ó sì máa lépa rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.11",
            "verseOrgIds": [
              "1PE.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ojú Olúwa ń bẹ lára àwọn olódodo,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 3:12"
      },
      "items": [
        {
          "text": "etí rẹ̀ sì ṣí sí ẹ̀bẹ̀ wọn,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 3:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ojú Olúwa korò sí àwọn tí ń ṣe búburú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tá nì yóò sì ṣe yín ní ibi, bí ẹ̀yin bá jẹ́ onítara sí ohun rere?",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n bí ẹ̀yin bá jìyà nítorí òdodo, a ti bùkún yín. \"Ẹ má ṣe bẹ̀rù ìhàlẹ̀ wọn, kí ẹ má sì ṣe kọminú.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ bọ̀wọ̀ fún Kristi bí Olúwa ní ọkàn yín: kí ẹ sì múra tan nígbà gbogbo láti dá olúkúlùkù lóhùn tí ń béèrè ìrètí tí o ń bẹ nínú yín, ṣùgbọ́n pẹ̀lú ọkàn tútù àti ìbẹ̀rù.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ẹ máa ni ẹ̀rí ọkàn rere bí wọ́n ti ń sọ̀rọ̀ yín ní ibi, kí ojú lè ti àwọn tí ń kẹ́gàn ìwà rere yín nínú Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ó sàn, bí ó bá jẹ́ ìfẹ́ Ọlọ́run, kí ẹ jìyà fún ṣíṣe rere ju fún ṣíṣe búburú lọ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí Kristi pẹ̀lú jìyà lẹ́ẹ̀kan nítorí ẹ̀ṣẹ̀ wa, olóòótọ́ fún àwọn aláìṣòótọ́, kí a lè mú wa dé ọ̀dọ̀ Ọlọ́run, ẹni tí a pa nínú ara, ṣùgbọ́n tí a sọ di ààyè nínú ẹ̀mí.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nínú èyí tí ó lọ pẹ̀lú tí ó sì wàásù fún àwọn ẹ̀mí nínú túbú,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "àwọn tí ó ṣe aláìgbọ́ràn nígbà kan, nígbà tí sùúrù Ọlọ́run dúró pẹ́ ní sá à kan ní ọjọ́ Noa, nígbà tí wọ́n fi kan ọkọ̀ nínú èyí tí a gba ọkàn díẹ̀ là nípa omi, èyí ni ẹni mẹ́jọ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àpẹẹrẹ èyí ti ń gbà yín là nísinsin yìí pẹ̀lú, àní ìtẹ̀bọmi, kì í ṣe wíwẹ́ èérí ti ara nù, bí kò ṣe ìdáhùn ẹ̀rí ọkàn rere si Ọlọ́run, nípa àjíǹde Jesu Kristi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó lọ sí ọ̀run, tí ó sì ń bẹ lọ́wọ́ ọ̀tún Ọlọ́run: pẹ̀lú àwọn angẹli, àwọn aláṣẹ, àti àwọn alágbára sì tẹríba lábẹ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
