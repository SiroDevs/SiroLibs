  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JHN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu sọ̀rọ̀ ìtùnú fún àwọn ọmọ-ẹ̀yìn rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ má ṣe jẹ́ kí ọkàn yín kí ó dàrú, ẹ gba Ọlọ́run gbọ́, kí ẹ sì gbà mí gbọ́ pẹ̀lú.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.1",
                "verseOrgIds": [
                  "JHN.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nínú ilé Baba mi ọ̀pọ̀lọpọ̀ ibùgbé ni ó wà, ìbá má ṣe bẹ́ẹ̀, èmi ìbá tí sọ fún yín. Èmi ń lọ láti pèsè ààyè sílẹ̀ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.2",
                "verseOrgIds": [
                  "JHN.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí mo bá sì lọ láti pèsè ààyè sílẹ̀ fún un yín, èmi ó tún padà wá, èmi ó sì mú yín lọ sọ́dọ̀ èmi tìkára mi; pé níbi tí èmi gbé wà, kí ẹ̀yin lè wà níbẹ̀ pẹ̀lú.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.3",
                "verseOrgIds": [
                  "JHN.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin mọ ibi tí èmi gbé ń lọ, ẹ sì mọ ọ̀nà náà.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.4",
                "verseOrgIds": [
                  "JHN.14.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu ni ọnà sí ọ̀dọ̀ Baba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasi wí fún un pé, \"Olúwa, a kò mọ ibi tí ìwọ ń lọ, a ó ha ti ṣe mọ ọ̀nà náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá wọn lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ni ọ̀nà, òtítọ́ àti ìyè, kò sí ẹnikẹ́ni tí ó lè wá sọ́dọ̀ Baba, bí kò ṣe nípasẹ̀ mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.6",
                "verseOrgIds": [
                  "JHN.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìbá ṣe pé ẹ̀yin ti mọ̀ mí, ẹ̀yin ìbá ti mọ Baba mi pẹ̀lú, láti ìsinsin yìí lọ ẹ̀yin mọ̀ ọ́n, ẹ sì ti rí i.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.7",
                "verseOrgIds": [
                  "JHN.14.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipi wí fún un pé, \"Olúwa, fi Baba náà hàn wá, yóò sì tó fún wa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí àkókò tí mo bá yín gbé ti tó yìí, ìwọ, kò sì tí ì mọ̀ mí síbẹ̀ Filipi? Ẹni tí ó bá ti rí mi, ó ti rí Baba. Ìwọ ha ti ṣe wí pé, 'Fi Baba hàn wá!'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.9",
                "verseOrgIds": [
                  "JHN.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìwọ kò ha gbàgbọ́ pé, èmi wà nínú Baba, àti pé Baba wà nínú mi? Ọ̀rọ̀ tí èmi ń sọ fún yín, èmi kò dá a sọ; ṣùgbọ́n Baba ti ó wà nínú mi, òun ní ń ṣe iṣẹ́ rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.10",
                "verseOrgIds": [
                  "JHN.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.10",
            "verseOrgIds": [
              "JHN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ gbà mí gbọ́ pé, èmi wà nínú Baba, Baba sì wà nínú mi, bí kò ṣe bẹ́ẹ̀, ẹ gbà mí gbọ́ nítorí àwọn ẹ̀rí iṣẹ́ náà pàápàá!",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.11",
                "verseOrgIds": [
                  "JHN.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.11",
            "verseOrgIds": [
              "JHN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Lóòótọ́ lóòótọ́ ni mo wí fún yín, ẹni tí ó bá gbà mí gbọ́, iṣẹ́ tí èmi ń ṣe ni òun yóò ṣe pẹ̀lú; iṣẹ́ tí ó tóbi ju wọ̀nyí lọ ni yóò sì ṣe; nítorí tí èmi ń lọ sọ́dọ̀ Baba.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.12",
                "verseOrgIds": [
                  "JHN.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ohunkóhun tí ẹ̀yin bá sì béèrè ní orúkọ mi, òun náà ni èmi ó ṣe, kí a lè yin Baba lógo nínú Ọmọ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.13",
                "verseOrgIds": [
                  "JHN.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹ̀yin bá béèrè ohunkóhun ní orúkọ mi, èmi ó ṣe é.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.14",
                "verseOrgIds": [
                  "JHN.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu ṣe ìlérí Ẹ̀mí Mímọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí ẹ̀yin bá fẹ́ràn mi, ẹ ó pa òfin mi mọ́.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.15",
                "verseOrgIds": [
                  "JHN.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.15",
            "verseOrgIds": [
              "JHN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà náà èmi yóò wá béèrè lọ́wọ́ Baba. Òun yóò sì fún yín ní olùtùnú mìíràn. Olùtùnú náà yóò máa bá yín gbé títí láé.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.16",
                "verseOrgIds": [
                  "JHN.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Òun ni Ẹ̀mí òtítọ́. Ayé kò le gbà á. Nítorí ayé kò mọ̀ ọ́n, bẹ́ẹ̀ ni kò rí i rí. Ẹ̀yin mọ̀ ọn nítorí láti ìgbà tí ẹ ti wà pẹ̀lú mí. Òun náà ti wà pẹ̀lú yín. Ṣùgbọ́n ní ọjọ́ kan yóò wọ inú yín láti máa gbé ibẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.17",
                "verseOrgIds": [
                  "JHN.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.17",
            "verseOrgIds": [
              "JHN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi kò ní fi yín sílẹ̀ láìní Olùtùnú, kí ẹ ma dàbí ọmọ tí kò ní òbí. Rárá o! Mo tún ń tọ̀ yín bọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.18",
                "verseOrgIds": [
                  "JHN.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.18",
            "verseOrgIds": [
              "JHN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nígbà díẹ̀ sí i, ayé kì yóò rí mi mọ́; ṣùgbọ́n ẹ̀yin yóò rí mi, nítorí tí èmi wà láààyè, ẹ̀yin yóò wà láààyè pẹ̀lú.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.19",
                "verseOrgIds": [
                  "JHN.14.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.19",
            "verseOrgIds": [
              "JHN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ní ọjọ́ náà ni ẹ̀yin yóò mọ̀ pé, èmi wà nínú Baba mi, àti ẹ̀yin nínú mi, àti èmi nínú yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.20",
                "verseOrgIds": [
                  "JHN.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.20",
            "verseOrgIds": [
              "JHN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá ní òfin mi, tí ó bá sì ń pa wọ́n mọ́, òun ni ẹni tí ó fẹ́ràn mi, ẹni tí ó bá sì fẹ́ràn mi, a ó fẹ́ràn rẹ̀ láti ọ̀dọ̀ Baba mi, èmi ó sì fẹ́ràn rẹ̀, èmi ó sì fi ara mi hàn fún un.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.21",
                "verseOrgIds": [
                  "JHN.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judasi (kì í ṣe Judasi Iskariotu) wí fún un pé, \"Olúwa, èéha ti ṣe tí ìwọ ó fi ara rẹ hàn fún àwa, tí kì yóò sì ṣe fún aráyé?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.22",
            "verseOrgIds": [
              "JHN.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn ó sì wí fún un pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí ẹnìkan bá fẹ́ràn mi, yóò pa ọ̀rọ̀ mi mọ́. Baba mi yóò sì fẹ́ràn rẹ̀, àwa ó sì tọ̀ ọ́ wá, a ó sì ṣe ibùgbé wa pẹ̀lú rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.23",
                "verseOrgIds": [
                  "JHN.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí kò fẹ́ràn mi ni kò pa ọ̀rọ̀ mi mọ́. Ọ̀rọ̀ tí ẹ̀yin ń gbọ́ kì í ṣe ti èmi, ṣùgbọ́n ti Baba tí ó rán mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.24",
                "verseOrgIds": [
                  "JHN.14.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nǹkan wọ̀nyí ni èmi ti sọ fún yín, nígbà tí mo ń bá yín gbé.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.25",
                "verseOrgIds": [
                  "JHN.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.25",
            "verseOrgIds": [
              "JHN.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n Olùtùnú náà, Ẹ̀mí Mímọ́, ẹni tí Baba yóò rán ní orúkọ mi, òun ni yóò kọ́ yín ní ohun gbogbo, yóò sì rán yín létí ohun gbogbo tí mo ti sọ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.26",
                "verseOrgIds": [
                  "JHN.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.26",
            "verseOrgIds": [
              "JHN.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Àlàáfíà ni mo fi sílẹ̀ fún yín pé, àlàáfíà mi ni mo fi fún yin, kì í ṣe bí ayé ti fi fún ni. Ẹ má ṣe jẹ́ kí ọkàn yín dàrú, ẹ má sì jẹ́ kí ó wárìrì.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.27",
                "verseOrgIds": [
                  "JHN.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ̀yin sá ti gbọ́ bí mo ti wí fún yín pé, 'Èmi ń lọ, èmi ó sì tọ̀ yín wá.' Ìbá ṣe pé ẹ̀yin fẹ́ràn mi, ẹ̀yin ìbá yọ̀ nítorí èmi ń lọ sọ́dọ̀ Baba; nítorí Baba mi tóbi jù mí lọ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.28",
                "verseOrgIds": [
                  "JHN.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.28",
            "verseOrgIds": [
              "JHN.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi sì ti sọ fún yín nísinsin yìí kí ó tó ṣẹ, pé nígbà tí ó bá ṣẹ, kí ẹ lè gbàgbọ́.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.29",
                "verseOrgIds": [
                  "JHN.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi kì yóò bá yín sọ̀rọ̀ púpọ̀, nítorí ọmọ-aládé ayé yí wá, kò sì ní nǹkan kan lòdì sí mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.30",
                "verseOrgIds": [
                  "JHN.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.30",
            "verseOrgIds": [
              "JHN.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n nítorí kí ayé lè mọ̀ pé èmi fẹ́ràn Baba; gẹ́gẹ́ bí Baba sì ti fi àṣẹ fún mi, bẹ́ẹ̀ ni èmi ń ṣe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 14:31"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹ dìde, ẹ jẹ́ kí a lọ kúrò níhìn-ín yìí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
