  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JHN 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wọ́n mú Jesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí Jesu sì ti sọ nǹkan wọ̀nyí tán, ó jáde pẹ̀lú àwọn ọmọ-ẹ̀yìn rẹ̀ lọ sókè odò Kidironi, níbi tí àgbàlá kan wà, nínú èyí tí ó wọ̀, Òun àti àwọn ọmọ-ẹ̀yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.1",
            "verseOrgIds": [
              "JHN.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judasi, ẹni tí ó fihàn, sì mọ ibẹ̀ pẹ̀lú, nítorí nígbà púpọ̀ ni Jesu máa ń lọ síbẹ̀ pẹ̀lú àwọn ọmọ-ẹ̀yìn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.2",
            "verseOrgIds": [
              "JHN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Judasi, lẹ́yìn tí ó ti gba ẹgbẹ́ ọmọ-ogun, àti àwọn oníṣẹ́ láti ọ̀dọ̀ àwọn olórí àlùfáà àti àwọn Farisi wá síbẹ̀ ti àwọn ti fìtílà àti ògùṣọ̀, àti ohun ìjà.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.3",
            "verseOrgIds": [
              "JHN.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà bí Jesu ti mọ ohun gbogbo tí ń bọ̀ wá bá òun, ó jáde lọ, ó sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.4",
            "verseOrgIds": [
              "JHN.18.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ta ni ẹyin ń wá?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.4",
                "verseOrgIds": [
                  "JHN.18.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dá a lóhùn wí pé, \"Jesu ti Nasareti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:5"
      },
      "items": [
        {
          "text": "Jesu sì wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi nìyí.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.5",
                "verseOrgIds": [
                  "JHN.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "(Àti Judasi ọ̀dàlẹ̀, dúró pẹ̀lú wọn).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.5",
            "verseOrgIds": [
              "JHN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà bí ó ti wí fún wọn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi nìyí,\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.6",
                "verseOrgIds": [
                  "JHN.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wọ́n bì sẹ́yìn, wọ́n sì ṣubú lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.6",
            "verseOrgIds": [
              "JHN.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ó tún bi wọ́n léèrè, wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ta ni ẹ ń wá?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.7",
                "verseOrgIds": [
                  "JHN.18.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:7"
      },
      "items": [
        {
          "text": "Wọ́n sì wí pé, \"Jesu ti Nasareti.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.7",
            "verseOrgIds": [
              "JHN.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mo ti wí fún yín pé, èmi nìyí. Ǹjẹ́ bí èmi ni ẹ bá ń wá, ẹ jẹ́ kí àwọn wọ̀nyí máa lọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.8",
                "verseOrgIds": [
                  "JHN.18.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.8",
            "verseOrgIds": [
              "JHN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọ̀rọ̀ nì kí ó lè ṣẹ, èyí tó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.9",
            "verseOrgIds": [
              "JHN.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Àwọn tí ìwọ fi fún mi, èmi kò sọ ọ̀kan nù nínú wọn.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.9",
                "verseOrgIds": [
                  "JHN.18.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni Simoni Peteru ẹni tí ó ní idà, fà á yọ, ó sì ṣá ọmọ ọ̀dọ̀ olórí àlùfáà, ó sì ké etí ọ̀tún rẹ̀ sọnù. Orúkọ ìránṣẹ́ náà a máa jẹ́ Makọọsi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.10",
            "verseOrgIds": [
              "JHN.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Jesu wí fún Peteru pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.11",
            "verseOrgIds": [
              "JHN.18.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tẹ idà rẹ bọ inú àkọ̀ rẹ, ago tí baba ti fi fún mi, èmi ó ṣe aláìmu ún bí?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.11",
                "verseOrgIds": [
                  "JHN.18.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu níwájú Annasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ẹgbẹ́ ọmọ-ogun àti olórí ẹ̀ṣọ́, àti àwọn oníṣẹ́ àwọn Júù mú Jesu, wọ́n sì dè é.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.12",
            "verseOrgIds": [
              "JHN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n kọ́kọ́ fà á lọ sọ́dọ̀ Annasi; nítorí òun ni àna Kaiafa, ẹni tí í ṣe olórí àlùfáà ní ọdún náà.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.13",
            "verseOrgIds": [
              "JHN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaiafa sá à ni ẹni tí ó ti bá àwọn Júù gbìmọ̀ pé, ó ṣàǹfààní kí ènìyàn kan kú fún àwọn ènìyàn.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.14",
            "verseOrgIds": [
              "JHN.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Peteru sẹ́ Jesu ní àkọ́kọ́",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Peteru sì ń tọ Jesu lẹ́yìn, àti ọmọ-ẹ̀yìn mìíràn kan: ọmọ-ẹ̀yìn náà jẹ́ ẹni mí mọ̀ fún olórí àlùfáà, ó sì bá Jesu wọ ààfin olórí àlùfáà lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.15",
            "verseOrgIds": [
              "JHN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Peteru dúró ní ẹnu-ọ̀nà lóde. Nígbà náà ni ọmọ-ẹ̀yìn mìíràn náà tí í ṣe ẹni mí mọ̀ fún olórí àlùfáà jáde, ó sì bá olùṣọ́nà náà sọ̀rọ̀, ó sì mú Peteru wọlé.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.16",
            "verseOrgIds": [
              "JHN.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ọmọbìnrin náà tí ń ṣọ́ ẹnu-ọ̀nà wí fún Peteru pé, \"Ìwọ pẹ̀lú ha ń ṣe ọ̀kan nínú àwọn ọmọ-ẹ̀yìn ọkùnrin yìí bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:17"
      },
      "items": [
        {
          "text": "Ó wí pé, \"Èmi kọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.17",
            "verseOrgIds": [
              "JHN.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ọmọ ọ̀dọ̀ àti àwọn aláṣẹ sì dúró níbẹ̀, àwọn ẹni tí ó ti dáná nítorí ti òtútù mú, wọ́n sì ń yáná, Peteru sì dúró pẹ̀lú wọn, ó ń yáná.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.18",
            "verseOrgIds": [
              "JHN.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alábojútó àlùfáà fi ọ̀rọ̀ wá Jesu lẹ́nu wò",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni olórí àlùfáà bi Jesu léèrè ní ti àwọn ọmọ-ẹ̀yìn rẹ̀, àti ní ti ẹ̀kọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.19",
            "verseOrgIds": [
              "JHN.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá a lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ti sọ̀rọ̀ ní gbangba fún aráyé; nígbà gbogbo ni èmi ń kọ́ni nínú Sinagọgu, àti ní tẹmpili níbi tí gbogbo àwọn Júù ń péjọ sí, èmi kò sì sọ ohun kan ní ìkọ̀kọ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.20",
                "verseOrgIds": [
                  "JHN.18.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.20",
            "verseOrgIds": [
              "JHN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èéṣe tí ìwọ fi ń bi mí léèrè? Béèrè lọ́wọ́ àwọn tí ó ti gbọ́ ọ̀rọ̀ mi, ohun tí mo wí fún wọn: wò ó, àwọn wọ̀nyí mọ ohun tí èmi wí.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.21",
                "verseOrgIds": [
                  "JHN.18.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ó sì ti wí èyí tan, ọ̀kan nínú àwọn aláṣẹ tí ó dúró tì í fi ọwọ́ rẹ̀ lu Jesu, pé, \"Alábojútó àlùfáà ni ìwọ ń dá lóhùn bẹ́ẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.22",
            "verseOrgIds": [
              "JHN.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dá a lóhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí mo bá sọ̀rọ̀ búburú, jẹ́rìí sí búburú náà, ṣùgbọ́n bí rere bá ni, èéṣe tí ìwọ fi ń lù mí?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.23",
                "verseOrgIds": [
                  "JHN.18.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.23",
            "verseOrgIds": [
              "JHN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí Annasi rán an lọ ní dídè sọ́dọ̀ Kaiafa olórí àlùfáà.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.24",
            "verseOrgIds": [
              "JHN.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Peteru sẹ́ Jesu ní ìgbà kejì àti ìgbà kẹta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n Simoni Peteru dúró, ó sì ń yáná. Nígbà náà ni wọ́n wí fún un pé, \"Ìwọ pẹ̀lú ha jẹ́ ọ̀kan nínú àwọn ọmọ-ẹ̀yìn rẹ̀?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:25"
      },
      "items": [
        {
          "text": "Ó sì sẹ́, wí pé, \"Èmi kọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.25",
            "verseOrgIds": [
              "JHN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀kan nínú àwọn ọmọ ọ̀dọ̀ olórí àlùfáà, tí ó jẹ́ ìbátan ẹni tí Peteru gé etí rẹ̀ sọnù, wí pé, \"Èmi ko ha rí ọ pẹ̀lú rẹ̀ ní àgbàlá?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.26",
            "verseOrgIds": [
              "JHN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peteru tún sẹ́: lójúkan náà àkùkọ sì kọ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.27",
            "verseOrgIds": [
              "JHN.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jesu níwájú Pilatu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà, wọ́n fa Jesu láti ọ̀dọ̀ Kaiafa lọ sí ibi gbọ̀ngàn ìdájọ́, ó sì jẹ́ kùtùkùtù òwúrọ̀; àwọn tìkára wọn kò wọ inú gbọ̀ngàn ìdájọ́, kí wọn má ṣe di aláìmọ́, ṣùgbọ́n kí wọn lè jẹ àsè ìrékọjá.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.28",
            "verseOrgIds": [
              "JHN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Pilatu jáde tọ̀ wọ́n lọ, ó sì wí pé, \"Ẹ̀sùn kín ní ẹ̀yin mú wá fun ọkùnrin yìí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.29",
            "verseOrgIds": [
              "JHN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọ́n sì dáhùn wí fún un pé, \"Ìbá má ṣe pé ọkùnrin yìí ń hùwà ibi, a kì bá tí fà á lé ọ lọ́wọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.30",
            "verseOrgIds": [
              "JHN.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà Pilatu wí fún wọn pé, \"Ẹ mú un tìkára yín, kí ẹ sì ṣe ìdájọ́ rẹ̀ gẹ́gẹ́ bí òfin yín.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:31"
      },
      "items": [
        {
          "text": "Nítorí náà ni àwọn Júù wí fún un pé, \"Kò tọ́ fún wa láti pa ẹnikẹ́ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.31",
            "verseOrgIds": [
              "JHN.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kí ọ̀rọ̀ Jesu ba à lè ṣẹ, èyí tí ó sọ tí ó ń ṣàpẹẹrẹ irú ikú tí òun yóò kú.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.32",
            "verseOrgIds": [
              "JHN.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Pilatu tún wọ inú gbọ̀ngàn ìdájọ́ lọ, ó sì pe Jesu, ó sì wí fún un pé, \"Ìwọ ha ni a pè ni ọba àwọn Júù bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.33",
            "verseOrgIds": [
              "JHN.18.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.34",
            "verseOrgIds": [
              "JHN.18.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èrò ti ara rẹ ni èyí, tàbí àwọn ẹlòmíràn sọ ọ́ fún ọ nítorí mi?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.34",
                "verseOrgIds": [
                  "JHN.18.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu dáhùn wí pé, \"Èmi ha jẹ́ Júù bí? Àwọn ọmọ orílẹ̀-èdè rẹ, àti àwọn olórí àlùfáà ni ó fà ọ́ lé èmi lọ́wọ́, kín ní ìwọ ṣe?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.35",
            "verseOrgIds": [
              "JHN.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.36",
            "verseOrgIds": [
              "JHN.18.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìjọba mi kì í ṣe ti ayé yìí. Ìbá ṣe pé ìjọba mi jẹ́ ti ayé yìí, àwọn ìránṣẹ́ mi ìbá jà, kí a má ba à fi mí lé àwọn Júù lọ́wọ́, ṣùgbọ́n nísinsin yìí ìjọba mi kì í ṣe láti ìhín lọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.36",
                "verseOrgIds": [
                  "JHN.18.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà, Pilatu wí fún un pé, \"Ọba ni ọ́ nígbà náà?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 18:37"
      },
      "items": [
        {
          "text": "Jesu dáhùn wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.37",
            "verseOrgIds": [
              "JHN.18.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ìwọ wí pé, ọba ni èmi jẹ́. Nítorí èyí ni a ṣe bí mí, àti nítorí ìdí èyí ni mo sì ṣe wá sí ayé kí n lè jẹ́rìí sí òtítọ́, olúkúlùkù ẹni tí í ṣe ti òtítọ́ ń gbọ́ ohùn mi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.18.37",
                "verseOrgIds": [
                  "JHN.18.37"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu wí fún un pé, \"Kín ni òtítọ́?\" Nígbà tí ó sì ti wí èyí tan, ó tún jáde tọ àwọn Júù lọ, ó sì wí fún wọn pé, \"Èmi kò rí ẹ̀ṣẹ̀ kan lọ́wọ́ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.38",
            "verseOrgIds": [
              "JHN.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ̀yin ní àṣà kan pé, kí èmi dá ọ̀kan sílẹ̀ fún yín nígbà àjọ ìrékọjá, nítorí náà ẹ ó ha fẹ́ kí èmi dá ọba àwọn Júù sílẹ̀ fún yín bí?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.18.39",
            "verseOrgIds": [
              "JHN.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
