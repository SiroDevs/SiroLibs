        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìbá ṣe pé èmi kò ti ṣe iṣẹ́ wọ̀n-ọn-nì láàrín wọn tí ẹlòmíràn kò ṣe rí, wọn kì bá tí ní ẹ̀ṣẹ̀, ṣùgbọ́n nísinsin yìí wọ́n sì rí, wọ́n sì kórìíra èmi àti Baba mi.",
              "type": "text",
              "attrs": {
