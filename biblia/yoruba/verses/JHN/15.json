        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ṣùgbọ́n gbogbo nǹkan wọ̀nyí ni wọ́n yóò ṣe sí yín, nítorí orúkọ mi, nítorí tí wọn kò mọ ẹni tí ó rán mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.21",
                "verseOrgIds": [
                  "JHN.15.21"
                ]
              }
            }
