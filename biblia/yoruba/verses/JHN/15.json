        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ rántí ọ̀rọ̀ tí mo ti sọ fún yín pé, 'Ọmọ ọ̀dọ̀ kò tóbi ju olúwa rẹ̀ lọ.' Bí wọ́n bá ti ṣe inúnibíni sí mi, wọ́n ó ṣe inúnibíni sí yín pẹ̀lú: bí wọ́n bá ti pa ọ̀rọ̀ mi mọ́, wọ́n ó sì pa tiyín mọ́ pẹ̀lú.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.20",
                "verseOrgIds": [
                  "JHN.15.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
