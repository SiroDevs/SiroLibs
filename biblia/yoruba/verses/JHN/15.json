        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìbá ṣe pé èmi kò ti wá kí n sì ti bá wọn sọ̀rọ̀, wọn kì bá tí ní ẹ̀ṣẹ̀, ṣùgbọ́n nísinsin yìí wọ́n di aláìríwí fún ẹ̀ṣẹ̀ wọn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.22",
                "verseOrgIds": [
                  "JHN.15.22"
                ]
              }
            }
