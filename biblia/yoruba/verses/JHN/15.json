  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JHN 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Àjàrà àti ẹ̀ka rẹ̀",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ni àjàrà tòótọ́, Baba mi sì ni olùṣọ́gbà.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.1",
                "verseOrgIds": [
                  "JHN.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.1",
            "verseOrgIds": [
              "JHN.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gbogbo ẹ̀ka nínú mi tí kò bá so èso, òun a mú kúrò, gbogbo ẹ̀ka tí ó bá sì so èso, òun a wẹ̀ ẹ́ mọ́, kí ó lè so èso sí i.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.2",
                "verseOrgIds": [
                  "JHN.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.2",
            "verseOrgIds": [
              "JHN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ̀yin mọ́ nísinsin yìí nítorí ọ̀rọ̀ tí mo ti sọ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.3",
                "verseOrgIds": [
                  "JHN.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.3",
            "verseOrgIds": [
              "JHN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹ máa gbé inú mi, èmi ó sì máa gbé inú yín. Gẹ́gẹ́ bí ẹ̀ka kò ti lè so èso fún ara rẹ̀ bí kò ṣe pé ó ba ń gbé inú àjàrà, bẹ́ẹ̀ ni ẹ̀yin, bí kò ṣe pé ẹ bá ń gbé inú mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.4",
                "verseOrgIds": [
                  "JHN.15.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Èmi ni àjàrà, ẹ̀yin ni ẹ̀ka. Ẹni tí ó ń gbé inú mi, àti èmi nínú rẹ̀, òun ni yóò so èso lọ́pọ̀lọ́pọ̀, nítorí ní yíya ara yín kúrò lọ́dọ̀ mi, ẹ kò lè ṣe ohun kan.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.5",
                "verseOrgIds": [
                  "JHN.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.5",
            "verseOrgIds": [
              "JHN.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹnìkan kò bá gbé inú mi, a gbé e sọnù gẹ́gẹ́ bí ẹ̀ka, a sì gbẹ; wọn a sì kó wọn jọ, wọn a sì sọ wọ́n sínú iná, wọn a sì jóná.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.6",
                "verseOrgIds": [
                  "JHN.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.6",
            "verseOrgIds": [
              "JHN.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹ̀yin bá ń gbé inú mi, tí ọ̀rọ̀ mi bá sì gbé inú yín, ẹ ó béèrè ohunkóhun tí ẹ bá fẹ́, a ó sì ṣe é fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.7",
                "verseOrgIds": [
                  "JHN.15.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.7",
            "verseOrgIds": [
              "JHN.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nínú èyí ní a yìn Baba mi lógo pé, kí ẹ̀yin kí ó máa so èso púpọ̀; ẹ̀yin ó sì jẹ́ ọmọ-ẹ̀yìn mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.8",
                "verseOrgIds": [
                  "JHN.15.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gẹ́gẹ́ bí Baba ti fẹ́ mi, bẹ́ẹ̀ ni èmi sì fẹ́ yín, ẹ dúró nínú ìfẹ́ rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.9",
                "verseOrgIds": [
                  "JHN.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.9",
            "verseOrgIds": [
              "JHN.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bí ẹ̀yin bá pa òfin mi mọ́, ẹ ó dúró nínú ìfẹ́ mi; gẹ́gẹ́ bí èmi ti pa òfin Baba mi mọ́, tí mo sì dúró nínú ìfẹ́ rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.10",
                "verseOrgIds": [
                  "JHN.15.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.10",
            "verseOrgIds": [
              "JHN.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ni mo ti sọ fún yín, kí ayọ̀ mi kí ó lè wà nínú yín, àti kí ayọ̀ yín kí ó lè kún.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.11",
                "verseOrgIds": [
                  "JHN.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.11",
            "verseOrgIds": [
              "JHN.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èyí ni òfin mi, pé kí ẹ̀yin kí ó fẹ́ràn ara yín, gẹ́gẹ́ bí mo ti fẹ́ràn yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.12",
                "verseOrgIds": [
                  "JHN.15.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.12",
            "verseOrgIds": [
              "JHN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kò sí ẹnìkan tí ó ní ìfẹ́ tí ó tóbi ju èyí lọ, pé ẹnìkan fi ẹ̀mí rẹ̀ lélẹ̀ nítorí àwọn ọ̀rẹ́ rẹ̀.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.13",
                "verseOrgIds": [
                  "JHN.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.13",
            "verseOrgIds": [
              "JHN.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ̀rẹ́ mi ni ẹ̀yin ń ṣe, bí ẹ bá ṣe ohun tí èmi pàṣẹ fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.14",
                "verseOrgIds": [
                  "JHN.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.14",
            "verseOrgIds": [
              "JHN.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi kò pè yín ní ọmọ ọ̀dọ̀ mọ́; nítorí ọmọ ọ̀dọ̀ kò mọ ohun tí olúwa rẹ̀ ń ṣe, ṣùgbọ́n èmi pè yín ní ọ̀rẹ́ nítorí ohun gbogbo tí mo ti gbọ́ láti ọ̀dọ̀ Baba mi wá, mo ti fihàn fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.15",
                "verseOrgIds": [
                  "JHN.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.15",
            "verseOrgIds": [
              "JHN.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kì í ṣe ẹ̀yin ni ó yàn mí, ṣùgbọ́n èmi ni ó yàn yín, mo sì fi yín sípò, kí ẹ̀yin kí ó lè lọ, kí ẹ sì so èso, àti kí èso yín lè dúró; kí ohunkóhun tí ẹ bá béèrè lọ́wọ́ Baba ní orúkọ mi, kí ó lè fi í fún yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.16",
                "verseOrgIds": [
                  "JHN.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.16",
            "verseOrgIds": [
              "JHN.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nǹkan wọ̀nyí ni mo pàṣẹ fún yín pé, kí ẹ̀yin kí ó fẹ́ràn ara yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.17",
                "verseOrgIds": [
                  "JHN.15.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayé kórìíra àwọn ọmọ-ẹ̀yìn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí ayé bá kórìíra yín, ẹ mọ̀ pé, ó ti kórìíra mi ṣáájú yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.18",
                "verseOrgIds": [
                  "JHN.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.18",
            "verseOrgIds": [
              "JHN.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ìbá ṣe pé ẹ̀yin ń ṣe ti ayé, ayé ìbá fẹ́ yin bi àwọn tirẹ̀; gẹ́gẹ́ bi o ṣe ri tí ẹ̀yin kì ń ṣe ti ayé, ṣùgbọ́n èmi ti yàn yín kúrò nínú ayé, nítorí èyí ni ayé ṣe kórìíra yín.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.15.19",
                "verseOrgIds": [
                  "JHN.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.15.19",
            "verseOrgIds": [
              "JHN.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
