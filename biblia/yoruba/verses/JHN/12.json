          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nǹkan wọ̀nyí ni Isaiah wí, nítorí ó ti rí ògo rẹ̀, ó sì sọ̀rọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.41",
            "verseOrgIds": [
              "JHN.12.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Síbẹ̀ ọ̀pọ̀ nínú àwọn olórí gbà á gbọ́ pẹ̀lú; ṣùgbọ́n nítorí àwọn Farisi wọn kò jẹ́wọ́ rẹ̀, kí a má ba à yọ wọ́n kúrò nínú Sinagọgu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.42",
            "verseOrgIds": [
              "JHN.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "nítorí wọ́n fẹ́ ìyìn ènìyàn ju ìyìn ti Ọlọ́run lọ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu sì kígbe ó sì wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ẹni tí ó bá gbà mí gbọ́, èmi kọ́ ni ó gbàgbọ́ ṣùgbọ́n ẹni tí ó rán mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.44",
                "verseOrgIds": [
                  "JHN.12.44"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.44",
            "verseOrgIds": [
              "JHN.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá sì rí mi, ó rí ẹni tí ó rán mi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.45",
                "verseOrgIds": [
                  "JHN.12.45"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.45",
            "verseOrgIds": [
              "JHN.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi ni ìmọ́lẹ̀ tí ó wá sí ayé, kí ẹnikẹ́ni tí ó bá gbà mí gbọ́ má ṣe wà nínú òkùnkùn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.46",
                "verseOrgIds": [
                  "JHN.12.46"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bí ẹnikẹ́ni bá sì gbọ́ ọ̀rọ̀ mi, tí kò sì pa wọ́n mọ́, èmi kì yóò ṣe ìdájọ́ rẹ̀ nítorí tí èmi kò wá láti ṣe ìdájọ́ ayé, bí kò ṣe láti gba ayé là.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.47",
                "verseOrgIds": [
                  "JHN.12.47"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.47",
            "verseOrgIds": [
              "JHN.12.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ẹni tí ó bá kọ̀ mí, tí kò sì gba ọ̀rọ̀ mi, ó ní ẹnìkan tí ń ṣe ìdájọ́ rẹ̀; ọ̀rọ̀ tí mo ti sọ, òun náà ni yóò ṣe ìdájọ́ rẹ̀ ní ọjọ́ ìkẹyìn.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.48",
                "verseOrgIds": [
                  "JHN.12.48"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.48",
            "verseOrgIds": [
              "JHN.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nítorí èmi kò dá ọ̀rọ̀ sọ fún ara mi, ṣùgbọ́n Baba tí ó rán mi, ni ó ti fún mi ní àṣẹ, ohun tí èmi ó sọ, àti èyí tí èmi ó wí.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.49",
                "verseOrgIds": [
                  "JHN.12.49"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.49",
            "verseOrgIds": [
              "JHN.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Èmi sì mọ̀ pé ìyè àìnípẹ̀kun ni òfin rẹ̀, nítorí náà, àwọn ohun tí mo bá wí, gẹ́gẹ́ bí Baba ti sọ fún mi, bẹ́ẹ̀ ni mo wí!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.12.50",
                "verseOrgIds": [
                  "JHN.12.50"
                ]
              }
            }
          ]
        }
      ]
