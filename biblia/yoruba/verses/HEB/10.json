  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "HEB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìrúbọ Kristi lẹ́ẹ̀kan ṣoṣo fún gbogbo ènìyàn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí tí òfin jẹ́ òjìji àwọn ohun rere ti ń bọ̀ tí kì í ṣe àwòrán tòótọ́ fún àwọn òtítọ́ náà, wọn kò lè fi ẹbọ kan náà tí wọn ń rú nígbà gbogbo lọ́dọọdún mu àwọn tí ń wá jọ́sìn di pípé.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe bẹ́ẹ̀, a kì ìbá tí dẹ́kun àti máa rú wọn, nítorí àwọn ti ń sìn ki ìbá tí ní ìmọ̀ ẹ̀ṣẹ̀, nígbà tí a bá ti wẹ̀ wọ́n mọ́ lẹ́ẹ̀kan ṣoṣo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n nínú ẹbọ wọ̀nyí ni a ń ṣe ìrántí ẹ̀ṣẹ̀ lọ́dọọdún.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ko ṣe é ṣe fún ẹ̀jẹ̀ akọ màlúù àti ti ewúrẹ́ láti mú ẹ̀ṣẹ̀ kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà nígbà tí Kristi wá sí ayé, ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "\"Ìwọ kò fẹ́ ẹbọ àti ọrẹ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:5"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ara ni ìwọ ti pèsè fún mi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹbọ sísun àti ẹbọ fún ẹ̀ṣẹ̀ ni",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:6"
      },
      "items": [
        {
          "text": "ìwọ kò ní inú dídùn sí.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.6",
            "verseOrgIds": [
              "HEB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni mo wí pé, 'Kíyèsi i (nínú ìwé kíká ni a gbé kọ ọ́ nípa ti èmi)",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:7"
      },
      "items": [
        {
          "text": "mo dé láti ṣe ìfẹ́ rẹ, Ọlọ́run.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.7",
            "verseOrgIds": [
              "HEB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí o wí ni ìṣáájú pé, \"Ìwọ kò fẹ́ ẹbọ àti ọrẹ àti ẹbọ sísun, àti ẹbọ fún ẹ̀ṣẹ̀, bẹ́ẹ̀ ni ìwọ kò ni inú dídùn si wọn\" (àwọn èyí tí a ń rú gẹ́gẹ́ bí òfin).",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.8",
            "verseOrgIds": [
              "HEB.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà náà ni ó wí pé, \"Kíyèsi i, mo de láti ṣe ìfẹ́ rẹ Ọlọ́run.\" Ó mú ti ìṣáájú kúrò, kí a lè fi ìdí èkejì múlẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.9",
            "verseOrgIds": [
              "HEB.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ìfẹ́ náà ni a ti sọ wá di mímọ́ nípa ẹbọ ti Jesu Kristi fi ara rẹ̀ rú lẹ́ẹ̀kan ṣoṣo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.10",
            "verseOrgIds": [
              "HEB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àti olúkúlùkù àlùfáà sì ń dúró lójoojúmọ́ láti ṣiṣẹ́ ìsìn, ó sì ń ṣe ẹbọ kan náà nígbàkígbà, tí kò lè mú ẹ̀ṣẹ̀ kúrò láé.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n òun, lẹ́yìn ìgbà tí o ti rú ẹbọ kan fún ẹ̀ṣẹ̀ títí láé, o jókòó lọ́wọ́ ọ̀tún Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "láti ìgbà náà, ó retí títí a o fi àwọn ọ̀tá rẹ̀ ṣe àpótí ìtìsẹ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí nípa ẹbọ kan a ti mú àwọn tí a sọ di mímọ́ pé títí láé.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀mí Mímọ́ sì ń jẹ́rìí fún wa pẹ̀lú, nítorí lẹ́yìn tí ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Èyí ni májẹ̀mú ti èmi o ba wọn dá",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "lẹ́hìn àwọn ọjọ́ wọ̀nyí, ni Olúwa wí.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "Èmi o fi òfin mi sí wọn ní ọkàn,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:16"
      },
      "items": [
        {
          "text": "inú wọn pẹ̀lú ni èmi o sì kọ wọn sí.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.16",
            "verseOrgIds": [
              "HEB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó tún sọ wí pé:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "\"Ẹ̀ṣẹ̀ wọn àti àìṣedéédéé wọn",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:17"
      },
      "items": [
        {
          "text": "lèmi kì yóò sì rántí mọ́.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.17",
            "verseOrgIds": [
              "HEB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n níbi tí ìmúkúrò ìwọ̀nyí bá gbé wà, ìrúbọ fún ẹ̀ṣẹ̀ kò sí mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.18",
            "verseOrgIds": [
              "HEB.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ìpè sí ìforítì",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ará, ǹjẹ́ bí a ti ní ìgboyà láti wọ inú Ibi Mímọ́ Jùlọ nípasẹ̀ ẹ̀jẹ̀ Jesu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nípa ọ̀nà títún àti ààyè, tí o yà sí mímọ́ fún wa, àti láti kọjá aṣọ ìkélé èyí yìí ní, ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "àti bí a ti ni àlùfáà gíga lórí ilé Ọlọ́run;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ẹ jẹ́ kí a fi òtítọ́ ọkàn súnmọ́ tòsí ni ẹ̀kún ìgbàgbọ́, kí a sì wẹ ọkàn wa mọ́ kúrò nínú ẹ̀rí ọkàn búburú, kí a sì fi omi mímọ́ wẹ ara wa nù.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí a di ìjẹ́wọ́ ìrètí wa mu ṣinṣin ni àìṣiyèméjì, nítorí pé olóòtítọ́ ní ẹni tí o ṣe ìlérí.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ jẹ́ kí a yẹ ara wa wò láti ru ara wa sí ìfẹ́ àti sí iṣẹ́ rere,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kí a ma máa kọ ìpéjọpọ̀ ara wa sílẹ̀, gẹ́gẹ́ bi àṣà àwọn ẹlòmíràn; ṣùgbọ́n kí a máa gba ara ẹni níyànjú pẹ̀lúpẹ̀lú bí ẹ̀yin ti rí i pé ọjọ́ náà ń súnmọ́ etílé.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "HEB 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí bí àwa ba mọ̀ ọ́n mọ̀ dẹ́ṣẹ̀ lẹ́yìn ìgbà tí àwa bá ti gba ìmọ̀ òtítọ́ kò tún sí ẹbọ fún ẹ̀ṣẹ̀ mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "HEB 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí kò ṣe ìrètí ìdájọ́ tí ó ba ni lẹ́rù, àti ti ìbínú ti o múná, tí yóò pa àwọn ọ̀tá run.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
            "verseOrgIds": [
              "HEB.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "HEB 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó ba gan òfin Mose, ó kú láìsí àánú nípa ẹ̀rí ẹni méjì tàbí mẹ́ta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.28",
            "verseOrgIds": [
              "HEB.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "HEB 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mélòó mélòó ni ẹ rò pé a o jẹ ẹni náà ní ìyà kíkan, ẹni tí o tẹ Ọmọ Ọlọ́run mọ́lẹ̀ tí ó sì ti ka ẹ̀jẹ̀ májẹ̀mú ti a fi sọ ọ́ di mímọ́ si ohun àìmọ́, tí ó sì ti kẹ́gàn ẹ̀mí oore-ọ̀fẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.29",
            "verseOrgIds": [
              "HEB.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "HEB 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí àwa mọ ẹni tí o wí pé, Ẹ̀san ni ti èmi, Olúwa wí pé, \"Èmi ó gbẹ̀san.\" Àti pẹ̀lú, \"Olúwa yóò ṣe ìdájọ́ àwọn ènìyàn rẹ̀.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.30",
            "verseOrgIds": [
              "HEB.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "HEB 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohun ẹ̀rù ni láti ṣubú sí ọwọ́ Ọlọ́run alààyè.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.31",
            "verseOrgIds": [
              "HEB.10.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "HEB 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n ẹ rántí ọjọ́ ìṣáájú nínú èyí tí, nígbà tí a ti sí yin lójú, ẹ fi ara da wàhálà ńlá ti ìjìyà;",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.32",
            "verseOrgIds": [
              "HEB.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "HEB 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "lápákan, nígbà tí a sọ yín di ìran wíwò nípa ẹ̀gàn àti ìpọ́njú; àti lápákan, nígbà tí ẹ̀yin di ẹgbẹ́ àwọn tí a ṣe bẹ́ẹ̀ si.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.33",
            "verseOrgIds": [
              "HEB.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "HEB 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀yin bá àwọn tí ó wà nínú ìdè kẹ́dùn, ẹ sì fi ayọ̀ gba ìkólọ ẹrù yin, nítorí ẹ̀yin mọ nínú ara yin pé, ẹ ni ọrọ̀ tí ó wà títí, tí ó sì dára jù bẹ́ẹ̀ lọ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.34",
            "verseOrgIds": [
              "HEB.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "HEB 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ẹ má ṣe gbé ìgboyà yín sọnù, èyí ti o ni èrè ńlá.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.35",
            "verseOrgIds": [
              "HEB.10.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "HEB 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí ẹ̀yin kò le ṣe aláìní sùúrù, nítorí ìgbà tí ẹ̀yin bá ti ṣe ìfẹ́ Ọlọ́run tan kí ẹ̀yin le gba ìlérí náà.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.36",
            "verseOrgIds": [
              "HEB.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "HEB 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "\"Ni ìwọ̀n ìgbà díẹ̀ sí i,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "ẹni náà ti ń bọ̀ yóò dé,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:37"
      },
      "items": [
        {
          "text": "kí yóò sì jáfara.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.37",
            "verseOrgIds": [
              "HEB.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "HEB 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "\"Olódodo ni yóò yè nípa ìgbàgbọ́.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "Ṣùgbọ́n bí o ba fàsẹ́yìn,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 10:38"
      },
      "items": [
        {
          "text": "ọkàn mi kò ní inú dídùn sí i.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.38",
            "verseOrgIds": [
              "HEB.10.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "HEB 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣùgbọ́n àwa kò sí nínú àwọn tí ń fàsẹ́yìn sínú ègbé; bí kò ṣe nínú àwọn tí o gbàgbọ́ sí ìgbàlà ọkàn.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.39",
            "verseOrgIds": [
              "HEB.10.39"
            ]
          }
        }
      ]
    }
  ],
