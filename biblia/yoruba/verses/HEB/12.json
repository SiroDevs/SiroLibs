              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí pé, \"Ọlọ́run wa, iná ti ń jó ni run ni.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.29",
            "verseOrgIds": [
