  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "PRO 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó sì ń ṣorí kunkun lẹ́yìn ọ̀pọ̀lọpọ̀ ìbáwí",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:1"
      },
      "items": [
        {
          "text": "yóò parun lójijì láìsí àtúnṣe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.1",
            "verseOrgIds": [
              "PRO.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà tí olódodo bá ń gbilẹ̀, àwọn ènìyàn a yọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:2"
      },
      "items": [
        {
          "text": "nígbà tí ènìyàn búburú ń ṣàkóso, àwọn ènìyàn ń kórìíra.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.2",
            "verseOrgIds": [
              "PRO.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn tí ó fẹ́ràn ọgbọ́n mú kí baba rẹ̀ láyọ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:3"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ẹni ti ń bá panṣágà kẹ́gbẹ́ ba ọrọ̀ ọ rẹ̀ jẹ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.3",
            "verseOrgIds": [
              "PRO.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nípa ìdájọ́ òdodo ni ọba fi í mú ìlú tòrò nini,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n èyí tí ń ṣe ojúkòkòrò àbẹ̀tẹ́lẹ̀ fà á lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.4",
            "verseOrgIds": [
              "PRO.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnikẹ́ni tí ó bá tan aládùúgbò rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:5"
      },
      "items": [
        {
          "text": "ó ń dẹ àwọ̀n de ẹsẹ̀ ẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.5",
            "verseOrgIds": [
              "PRO.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀ṣẹ̀ ènìyàn ibi ni ó jẹ́ ìdẹ̀kùn rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:6"
      },
      "items": [
        {
          "text": "ṣùgbọ́n olódodo le è kọrin kí ó sì máa yọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.6",
            "verseOrgIds": [
              "PRO.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olódodo ń máa ro ọ̀rọ̀ tálákà,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:7"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ènìyàn búburú kò sú sí i láti rò ó.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.7",
            "verseOrgIds": [
              "PRO.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn ẹlẹ́yà a máa ru ìlú sókè,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:8"
      },
      "items": [
        {
          "text": "ṣùgbọ́n àwọn ọlọ́gbọ́n ènìyàn máa ń mú ìbínú kúrò.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.8",
            "verseOrgIds": [
              "PRO.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọlọ́gbọ́n ènìyàn bá lọ sí ilé ẹjọ́ pẹ̀lú aláìgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:9"
      },
      "items": [
        {
          "text": "aláìgbọ́n a máa bínú a sì máa jà, kò sì ní sí àlàáfíà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.9",
            "verseOrgIds": [
              "PRO.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àwọn tí ó ń tàjẹ̀ sílẹ̀ kò rí ẹni dídúró ṣinṣin",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:10"
      },
      "items": [
        {
          "text": "wọ́n sì ń wá ọ̀nà láti pa olódodo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.10",
            "verseOrgIds": [
              "PRO.29.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aláìgbọ́n ènìyàn fi gbogbo ẹnu rẹ̀ bínú",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:11"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọlọ́gbọ́n ènìyàn a máa kó ìbínú rẹ̀ ní ìjánu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.11",
            "verseOrgIds": [
              "PRO.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí olórí bá fetí sí irọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:12"
      },
      "items": [
        {
          "text": "gbogbo àwọn ìjòyè rẹ̀ a di ènìyàn búburú lójú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.12",
            "verseOrgIds": [
              "PRO.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tálákà ènìyàn àti aninilára jọ ní àbùdá yìí,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:13"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.29.13",
                "verseOrgIds": [
                  "PRO.29.13"
                ]
              }
            }
          ]
        },
        {
          "text": "jẹ́ kí ojú àwọn méjèèjì máa ríran.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.13",
            "verseOrgIds": [
              "PRO.29.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ọba kan bá ń ṣe ìdájọ́ tálákà pẹ̀lú òtítọ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:14"
      },
      "items": [
        {
          "text": "ìtẹ́ ìjọba rẹ yóò fìdímúlẹ̀ nígbà gbogbo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.14",
            "verseOrgIds": [
              "PRO.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pá ìbániwí ń fún ni ní ọgbọ́n",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 29:15"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ọmọ tí a fi sílẹ̀ fúnra rẹ̀ a dójútì ìyá rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.29.15",
            "verseOrgIds": [
              "PRO.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
