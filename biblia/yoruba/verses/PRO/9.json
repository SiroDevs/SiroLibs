  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "PRO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ìpè ti ọgbọ́n àti àìgbọ́n",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọgbọ́n ti kọ́ ilé rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:1"
      },
      "items": [
        {
          "text": "ó ti gbẹ́ òpó o rẹ̀ méjèèjì,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.1",
            "verseOrgIds": [
              "PRO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó ti fi ilé pọn tí, ó ti fọ̀nà rokà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:2"
      },
      "items": [
        {
          "text": "Ó sì ti ṣètò o tábìlì oúnjẹ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.2",
            "verseOrgIds": [
              "PRO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó ti rán àwọn ìránṣẹ́bìnrin rẹ̀ jáde, ó sì ń pè,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:3"
      },
      "items": [
        {
          "text": "láti ibi tí ó ga jù láàrín ìlú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.3",
            "verseOrgIds": [
              "PRO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jẹ́ kí gbogbo àwọn aláìgbọ́n wọ ibí wá!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:4"
      },
      "items": [
        {
          "text": "Ó ń wí fún àwọn tí kò lọ́gbọ́n pé,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.4",
            "verseOrgIds": [
              "PRO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wá, ẹ wá jẹ́ oúnjẹ mi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:5"
      },
      "items": [
        {
          "text": "sì mu wáìnì tí mo ti pò.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.5",
            "verseOrgIds": [
              "PRO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fi ìwà àìmọ̀kan rẹ sílẹ̀ ìwọ yóò sì yè;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:6"
      },
      "items": [
        {
          "text": "rìn ní ọ̀nà òye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.6",
            "verseOrgIds": [
              "PRO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ẹnikẹ́ni tí ó bá bá ẹlẹ́gàn wí, kọ lẹ́tà sí àbùkù",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:7"
      },
      "items": [
        {
          "text": "ẹnikẹ́ni tí ó bá bá ẹni búburú wí kọ lẹ́tà sí èébú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.7",
            "verseOrgIds": [
              "PRO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe bá ẹlẹ́gàn wí, àìṣe bẹ́ẹ̀ yóò kórìíra rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:8"
      },
      "items": [
        {
          "text": "Bá ọlọ́gbọ́n wí yóò sì fẹ́ràn rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.8",
            "verseOrgIds": [
              "PRO.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kọ́ ọlọ́gbọ́n ènìyàn lẹ́kọ̀ọ́, yóò sì gbọ́n sí i",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:9"
      },
      "items": [
        {
          "text": "kọ́ olódodo ènìyàn lẹ́kọ̀ọ́, yóò sì fi kún ìmọ̀ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.9",
            "verseOrgIds": [
              "PRO.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ìbẹ̀rù",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.9.10",
                "verseOrgIds": [
                  "PRO.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ni ìbẹ̀rẹ̀ ọgbọ́n,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:10"
      },
      "items": [
        {
          "text": "ìmọ̀ nípa Ẹni Mímọ́ ni òye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.10",
            "verseOrgIds": [
              "PRO.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí nípasẹ̀ mi ọjọ́ rẹ yóò gùn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:11"
      },
      "items": [
        {
          "text": "ọ̀pọ̀lọpọ̀ ọdún yóò sì kún ọjọ́ ayé rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.11",
            "verseOrgIds": [
              "PRO.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bí ìwọ bá gbọ́n, ọgbọ́n rẹ yóò fún ọ ní èrè:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:12"
      },
      "items": [
        {
          "text": "bí ìwọ bá jẹ́ ẹlẹ́gàn, ìwọ nìkan ni yóò jìyà.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.12",
            "verseOrgIds": [
              "PRO.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òmùgọ̀ obìnrin jẹ́ aláriwo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:13"
      },
      "items": [
        {
          "text": "ó jẹ́ aláìlẹ́kọ̀ọ́ àti aláìní ìmọ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.13",
            "verseOrgIds": [
              "PRO.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó jókòó ní ẹnu-ọ̀nà ilé rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:14"
      },
      "items": [
        {
          "text": "lórí ìjókòó níbi tí ó ga jù láàrín ìlú,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.14",
            "verseOrgIds": [
              "PRO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ó ń pe àwọn tí ó ń kọjá lọ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:15"
      },
      "items": [
        {
          "text": "tí wọn ń lọ tààrà ní ọ̀nà wọn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.15",
            "verseOrgIds": [
              "PRO.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jẹ́ kí gbogbo ẹni tí ó jẹ́ aláìlóye súnmọ́ bí!\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 9:16"
      },
      "items": [
        {
          "text": "Ni ó wí fún ẹni tí òye kù díẹ̀ ká à tó fún.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.16",
            "verseOrgIds": [
              "PRO.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omi tí a jí mu dùn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.9.17",
            "verseOrgIds": [
              "PRO.9.17"
            ]
          }
        }
      ]
    },
    {
