      "attrs": {
        "style": "q2",
        "vid": "PRO 22:19"
      },
      "items": [
        {
          "text": "èmi fihàn ọ́ lónìí, àní fún ọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.19",
            "verseOrgIds": [
              "PRO.22.19"
            ]
          }
        }
      ]
