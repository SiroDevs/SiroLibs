      "attrs": {
        "style": "q2",
        "vid": "PRO 22:17"
      },
      "items": [
        {
          "text": "kí o sì fi àyà rẹ sí ẹ̀kọ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.17",
            "verseOrgIds": [
