          "text": "nítorí kín ni yóò ṣe gba ẹni rẹ kúrò lábẹ́ rẹ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
