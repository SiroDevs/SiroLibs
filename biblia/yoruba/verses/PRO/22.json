              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe wà nínú àwọn tí ń ṣe ìgbọ̀nwọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
