      "attrs": {
        "style": "q2",
        "vid": "PRO 22:28"
      },
      "items": [
        {
          "text": "tí àwọn baba rẹ ti pa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        }
