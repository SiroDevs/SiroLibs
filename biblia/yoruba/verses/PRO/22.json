      "attrs": {
        "style": "q2",
        "vid": "PRO 22:26"
      },
      "items": [
        {
          "text": "tàbí nínú àwọn tí ó dúró fún gbèsè.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.26",
            "verseOrgIds": [
              "PRO.22.26"
            ]
          }
        }
      ]
