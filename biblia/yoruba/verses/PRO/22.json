          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Èmi kò ha ti kọ̀wé ohun dáradára",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.20",
            "verseOrgIds": [
              "PRO.22.20"
