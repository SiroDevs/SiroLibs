          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pẹ̀lú ọ̀rọ̀ dídùn ó sì í lọ́nà;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.21",
            "verseOrgIds": [
              "PRO.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:21"
      },
      "items": [
        {
          "text": "ó tàn án jẹ pẹ̀lú ẹnu dídùn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.21",
            "verseOrgIds": [
              "PRO.7.21"
            ]
          }
        }
      ]
    },
    {
