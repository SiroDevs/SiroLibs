      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:25"
      },
      "items": [
        {
          "text": "tàbí kí ó rìn lọ sí ipa ọ̀nà rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.25",
            "verseOrgIds": [
              "PRO.7.25"
            ]
          }
