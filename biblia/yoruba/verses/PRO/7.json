          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Òun sì tọ̀ ọ́ lọ lẹsẹ̀ kan náà,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
