          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Títí tí ọ̀kọ̀ fi gún un ní ẹ̀dọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
