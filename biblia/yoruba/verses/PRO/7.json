      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:26"
      },
      "items": [
        {
          "text": "Ogunlọ́gọ̀ àwọn alágbára ni ó ti pa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        }
      ]
