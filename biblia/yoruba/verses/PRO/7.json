          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó mú owó púpọ̀ lọ́wọ́",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.20",
            "verseOrgIds": [
              "PRO.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:20"
      },
      "items": [
        {
          "text": "kò sì ní darí dé kí ó tó di ọ̀sán.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.20",
            "verseOrgIds": [
              "PRO.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
