              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilé e rẹ̀ ni ọ̀nà tààrà sí isà òkú,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
