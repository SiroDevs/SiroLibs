          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Má ṣe jẹ́ kí ọkàn rẹ kí ó yà sí ọ̀nà rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.25",
            "verseOrgIds": [
              "PRO.7.25"
            ]
          }
        }
      ]
    },
