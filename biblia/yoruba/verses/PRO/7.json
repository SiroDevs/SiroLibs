        "vid": "PRO 7:27"
      },
      "items": [
        {
          "text": "tí ó lọ tààrà sí àgbàlá ikú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
              "PRO.7.27"
