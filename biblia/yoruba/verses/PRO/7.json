  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PRO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ìkìlọ̀ nítorí àwọn aṣẹ́wó",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọmọ mi, pa ọ̀rọ̀ mi mọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:1"
      },
      "items": [
        {
          "text": "sì fi àwọn òfin mi pamọ́ sínú ọkàn rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa òfin mi mọ́, ìwọ yóò sì yè",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:2"
      },
      "items": [
        {
          "text": "tọ́jú ẹ̀kọ́ mi bí ẹyinlójú rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kọ wọ́n sí ọwọ́ òsì rẹ, má ṣe fi jẹun",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:3"
      },
      "items": [
        {
          "text": "kọ wọ́n sí inú wàláà àyà rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wí fún ọgbọ́n pé, \"Ìwọ ni arábìnrin mi,\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:4"
      },
      "items": [
        {
          "text": "sì pe òye ní ìbátan rẹ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wọn yóò pa ó mọ́ kúrò lọ́wọ́ obìnrin alágbèrè,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:5"
      },
      "items": [
        {
          "text": "kúrò lọ́wọ́ àjèjì obìnrin àti ọ̀rọ̀ ìtànjẹ rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ojú fèrèsé ilé è mi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:6"
      },
      "items": [
        {
          "text": "mo wo ìta láti ojú fèrèsé.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo rí i láàrín àwọn aláìmọ̀kan",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "mo sì kíyèsi láàrín àwọn ọ̀dọ́kùnrin,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:7"
      },
      "items": [
        {
          "text": "ọ̀dọ́ kan tí ó ṣe aláìgbọ́n.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó ń lọ ní pópónà ní tòsí i ilé alágbèrè obìnrin náà,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:8"
      },
      "items": [
        {
          "text": "ó ń rìn lọ sí ọ̀nà ilé e rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ní ìrọ̀lẹ́ bí oòrùn ṣe ń wọ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:9"
      },
      "items": [
        {
          "text": "bí òkùnkùn ṣe ń bo ni lára.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bẹ́ẹ̀ ni obìnrin kan jáde wá láti pàdé rẹ̀,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:10"
      },
      "items": [
        {
          "text": "ó múra bí panṣágà pẹ̀lú ètè búburú.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ó jẹ́ aláriwo àti alágídí,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:11"
      },
      "items": [
        {
          "text": "ìdí rẹ̀ kì í jókòó nílé;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "bí ó ti ń já níhìn-ín ní ó ń já lọ́hùn ún",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:12"
      },
      "items": [
        {
          "text": "gbogbo orígun ni ó ti ń ba ní ibùba.)",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ó dìímú, ó sì fẹnukò ó ní ẹnu",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 7:13"
      },
      "items": [
        {
          "text": "pẹ̀lú ojú díndín ó wí pé,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mo ní ọrẹ àlàáfíà ní ilé;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:14"
      },
      "items": [
        {
          "text": "lónìí ni mo san ẹ̀jẹ́ mi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nítorí náà ni n o ṣe jáde wá pàdé è rẹ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:15"
      },
      "items": [
        {
          "text": "mo wá ọ káàkiri mo sì ti rí ọ!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti tẹ́ ibùsùn mi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:16"
      },
      "items": [
        {
          "text": "pẹ̀lú aṣọ aláràbarà láti ilẹ̀ Ejibiti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mo ti fi nǹkan olóòórùn dídùn sí ibùsùn mi",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:17"
      },
      "items": [
        {
          "text": "bí i òjìá, aloe àti kinamoni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wá, jẹ́ kí a lo ìfẹ́ papọ̀ ní kíkún títí di àárọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.18",
            "verseOrgIds": [
              "PRO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:18"
      },
      "items": [
        {
          "text": "jẹ́ kí a gbádùn ara wa pẹ̀lú ìfẹ́!",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.18",
            "verseOrgIds": [
              "PRO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkọ ọ̀ mi ò sí nílé;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.19",
            "verseOrgIds": [
              "PRO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:19"
      },
      "items": [
        {
          "text": "ó ti lọ sí ìrìnàjò jíjìn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.19",
            "verseOrgIds": [
              "PRO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
