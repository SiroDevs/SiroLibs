          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀pọ̀lọpọ̀ ni àwọn tí ó ti fà lulẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        }
      ]
