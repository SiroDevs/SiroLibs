      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:24"
      },
      "items": [
        {
          "text": "fọkàn sí nǹkan tí mo sọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.24",
            "verseOrgIds": [
              "PRO.7.24"
            ]
          }
        }
      ]
    },
