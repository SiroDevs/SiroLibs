      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:22"
      },
      "items": [
        {
          "text": "bí i màlúù tí ń lọ sí ibi pípa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:22"
      },
      "items": [
        {
          "text": "tàbí bí àgbọ̀nrín tí ń lọ sí ibi okùn ìso.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        }
      ]
    },
    {
