      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:23"
      },
      "items": [
        {
          "text": "bí ẹyẹ ṣe ń fẹ́ wọ inú okùn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
