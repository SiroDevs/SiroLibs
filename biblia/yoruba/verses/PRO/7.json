      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 7:23"
      },
      "items": [
        {
          "text": "láìmọ̀ pé yóò gba ẹ̀mí òun.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        }
      ]
    },
    {
