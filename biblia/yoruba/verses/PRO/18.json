  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "PRO 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ènìyàn tí kò ba ni rẹ́ a máa lépa ìmọ̀ ara rẹ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:1"
      },
      "items": [
        {
          "text": "ó kọjú ìjà sí gbogbo ìdájọ́ òdodo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.1",
            "verseOrgIds": [
              "PRO.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aláìgbọ́n kò rí inú dídùn sí òye",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:2"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ó ní inú dídùn sí sísọ èrò tirẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.2",
            "verseOrgIds": [
              "PRO.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nígbà ti ènìyàn búburú dé ni ẹ̀gàn dé,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:3"
      },
      "items": [
        {
          "text": "nígbà ti ẹ̀gàn dé ni ìtìjú dé.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.3",
            "verseOrgIds": [
              "PRO.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ ẹnu ènìyàn jẹ́ omi jíjìn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:4"
      },
      "items": [
        {
          "text": "ṣùgbọ́n orísun ọgbọ́n jẹ́ odò tí ń sàn.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.4",
            "verseOrgIds": [
              "PRO.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kò dára kí ènìyàn ṣe ojúsàájú fún ènìyàn búburú",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:5"
      },
      "items": [
        {
          "text": "tàbí kí a fi ìdájọ́ òdodo du aláìṣẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.5",
            "verseOrgIds": [
              "PRO.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ètè aláìgbọ́n dá ìjà sílẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:6"
      },
      "items": [
        {
          "text": "ẹnu rẹ̀ sì ń ṣokùnfà ẹgba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.6",
            "verseOrgIds": [
              "PRO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹnu aláìgbọ́n ni ó ba tirẹ̀ jẹ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:7"
      },
      "items": [
        {
          "text": "ètè rẹ̀ sì jẹ́ ìdẹ̀kùn fún ọkàn rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.7",
            "verseOrgIds": [
              "PRO.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ olófòófó dàbí oúnjẹ àdídùn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:8"
      },
      "items": [
        {
          "text": "wọ́n a sì wọ ìsàlẹ̀ inú lọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.8",
            "verseOrgIds": [
              "PRO.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí kò ṣe déédé nínú iṣẹ́ rẹ̀",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:9"
      },
      "items": [
        {
          "text": "arákùnrin ló jẹ́ fún apanirun.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.9",
            "verseOrgIds": [
              "PRO.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orúkọ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Olúwa",
              "type": "text",
              "attrs": {
                "verseId": "PRO.18.10",
                "verseOrgIds": [
                  "PRO.18.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ilé ìṣọ́ agbára ni;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:10"
      },
      "items": [
        {
          "text": "olódodo sá wọ inú rẹ̀, ó sì rí ìgbàlà.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.10",
            "verseOrgIds": [
              "PRO.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ̀rọ̀ olówó ni ìlú olódi wọn;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:11"
      },
      "items": [
        {
          "text": "wọ́n rò ó bí i wí pé odi tí kò ṣe é gùn ni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.11",
            "verseOrgIds": [
              "PRO.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ṣáájú ìṣubú ọkàn ènìyàn a kọ́kọ́ máa gbéraga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:12"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ìrẹ̀lẹ̀ ni ó máa ń ṣáájú ọlá.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.12",
            "verseOrgIds": [
              "PRO.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹni tí ó ń fèsì kí ó tó gbọ́,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:13"
      },
      "items": [
        {
          "text": "èyí ni ìwà òmùgọ̀ àti ìtìjú rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.13",
            "verseOrgIds": [
              "PRO.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn ènìyàn a máa gbé e ró nígbà àìsàn,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:14"
      },
      "items": [
        {
          "text": "ṣùgbọ́n ta ni ó le forí ti ọkàn tí ó rẹ̀wẹ̀sì.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.14",
            "verseOrgIds": [
              "PRO.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkàn olóye ní i gba ìmọ̀;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 18:15"
      },
      "items": [
        {
          "text": "etí ọlọ́gbọ́n ní í ṣe àwárí rẹ̀.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.15",
            "verseOrgIds": [
              "PRO.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ẹ̀bùn máa ń ṣí ọ̀nà fún ẹni tí ń fún ni lẹ́bùn",
          "type": "text",
          "attrs": {
            "verseId": "PRO.18.16",
            "verseOrgIds": [
              "PRO.18.16"
