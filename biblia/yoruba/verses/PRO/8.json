      "attrs": {
        "style": "q2",
        "vid": "PRO 8:32"
      },
      "items": [
        {
          "text": "ìbùkún ni fún àwọn tí ó pa ọ̀nà mi mọ́.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.8.32",
            "verseOrgIds": [
